amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

// --- [SETTINGS] -------------------------------------------------------------------------

exclude = "infra/sdks/**"
fail_fast = false

// --- [STEPS] ----------------------------------------------------------------------------

steps {
  ["grammars"] {
    check = new CommandSpec {
      command = "cd tools/ast-grep/grammars && cmake --workflow --preset default"
      effect = "write"
    }
    stomp = true
  }
  ["ast-grep"] {
    glob = "**/*"
    exclude =
      read("../tests/tools/dylint/.ignore").text
        .split("\n")
        .filter((line) -> line.startsWith("/"))
        .map((line) -> "tests/tools/dylint\(line)")
    depends = "grammars"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "ast-grep",
            "scan",
            "--custom-languages",
            "allow",
            "--report-style",
            "short",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("ast-grep", "scan", "--custom-languages", "allow", "--update-all", "{{files}}")
      }
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["clang-format"] = (Builtins.clang_format) {
    glob = "**/*.{cpp,cppm,ixx,cc,cxx,mm,hpp,hh,hxx,h,ipp,inl,tpp}"
    local style = "--style=file:.config/.clang-format"
    batch = true
    check { command { argv = List("clang-format", style, "--dry-run", "-Werror", "{{files}}") } }
    fix { command { argv = List("clang-format", style, "-i", "{{files}}") } }
  }
  ["dotnet-format"] {
    glob = "**/*.cs"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "dotnet",
            "format",
            "whitespace",
            "--folder",
            "--verify-no-changes",
            "--include",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("dotnet", "format", "whitespace", "--folder", "--include", "{{files}}")
      }
      effect = "write"
    }
  }
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    glob = "**/*.{csproj,fsproj,vbproj,props,targets,slnx,pkl,plist,entitlements}"
    check {
      command {
        argv = List("editorconfig-checker", "-format", "gcc", "-no-color", "{{files}}")
      }
    }
    diagnostic_format = "gcc"
  }
  ["file-names"] {
    glob = "**/*.cs"
    check = new CommandSpec {
      command =
        "for file in {{files}}; do [ \"${file##*/}\" != \"$(basename \"${file%/*}\").cs\" ] || { printf '%s:1:1: error: file named after its folder, name the file for its concept family\\n' \"$file\"; failed=1; }; done; [ -z \"${failed:-}\" ]"
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["gersemi"] {
    glob = List("**/CMakeLists.txt", "**/*.cmake")
    local gersemi =
      List(
        "gersemi",
        "--config",
        ".config/gersemi.yaml",
        "--warnings-as-errors",
        "--cache-dir",
        ".cache/gersemi",
      )
    check_diff = new CommandSpec {
      command = new Command { argv = gersemi + List("--check", "--diff", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = gersemi + List("--in-place", "{{files}}") }
      effect = "write"
    }
  }
  ["google-java-format"] = (Builtins.google_java_format) {
    check {
      command {
        argv =
          List("google-java-format", "--aosp", "--dry-run", "--set-exit-if-changed", "{{files}}")
      }
    }
    check_list_files {
      command { argv = List("google-java-format", "--aosp", "--dry-run", "{{files}}") }
    }
    fix { command { argv = List("google-java-format", "--aosp", "--replace", "{{files}}") } }
  }
  ["hk"] {
    glob = ".config/hk.pkl"
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate", "--deny-warnings") }
      effect = "read"
    }
  }
  ["issue-config"] {
    glob = ".github/ISSUE_TEMPLATE/config.yml"
    check = new CommandSpec {
      command = new Command {
        argv =
          List("check-jsonschema", "--builtin-schema", "vendor.github-issue-config", "{{files}}")
      }
      effect = "read"
    }
  }
  ["issue-forms"] {
    glob = ".github/ISSUE_TEMPLATE/*.yml"
    exclude = ".github/ISSUE_TEMPLATE/config.yml"
    check = new CommandSpec {
      command = new Command {
        argv =
          List("check-jsonschema", "--builtin-schema", "vendor.github-issue-forms", "{{files}}")
      }
      effect = "read"
    }
  }
  ["jactionlint"] = (Builtins.jactionlint) {
    check {
      command { argv = List("jactionlint", "--strict-exit", "--format", "gcc", "{{files}}") }
    }
  }
  ["javac"] {
    glob = "**/*.java"
    local off =
      List(
        "AddNullMarkedToClass", // Fix imports JSpecify, absent from Ghidra's script classpath
        "DefaultPackage", // Ghidra loads scripts from script folders in the default package
        "ImmutableMemberCollection", // Fix takes Guava collections, Gson in Ghidra cannot decode them
        "Java8ApiChecker", // Guards Java 8 API use, scripts build with Ghidra's JDK
        "MissingJavadoc", // Demands doc comments, CLAUDE.md forbids comments
        "RequireExplicitNullMarking", // Fix imports JSpecify, absent from Ghidra's script classpath
        "Var", // Forces `@Var` on reassigned locals, CLAUDE.md checker rule
        "Varifier" // Fix writes `var`, PMD `UseExplicitTypes` refuses it
      )
    local lint = "-path" // Ghidra jar manifests name `Class-Path` jars its release omits
    check = new CommandSpec {
      command =
        "javac -J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -XDcompilePolicy=simple --should-stop=ifError=FLOW -processorpath \"${JAVAC_PLUGINS:?error prone is not installed}\" \"-Xplugin:ErrorProne -XepAllDisabledChecksAsWarnings -XepAllSuggestionsAsWarnings \(off.map((check) -> "-Xep:\(check):OFF").join(" ")) -XepOpt:NullAway:AnnotatedPackages=rasm\" -Xlint:all,\(lint) -Werror -d .cache/javac -cp \"${GHIDRA_CLASSPATH:?ghidra is not installed}\" -sourcepath plugins/shared/tool/skills/ghidra/scripts {{files}}"
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["pmd"] {
    glob = "**/*.java"
    depends = "javac"
    check = new CommandSpec {
      command =
        "pmd check --rulesets .config/pmd.xml --no-cache --no-progress --aux-classpath \".cache/javac:${JAVA_HOME:?}/lib/jrt-fs.jar:${GHIDRA_CLASSPATH:?ghidra is not installed}\" {{files}}"
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["oxlint"] = (Builtins.ox_lint) {
    check {
      command { argv = List("oxlint", "--deny-warnings", "--format", "sarif", "{{files}}") }
    }
    diagnostic_format = "sarif"
  }
  ["oxfmt"] = (Builtins.oxfmt) { depends = List("oxlint", "stylelint") }
  ["pkl-format"] = Builtins.pkl_format
  ["plutil"] {
    glob = "**/*.{plist,entitlements}"
    check = new CommandSpec {
      command = new Command { argv = List("plutil", "-lint", "-s", "{{files}}") }
      effect = "read"
    }
  }
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = (Builtins.ruff_format) { depends = "ruff" }
  ["rustfmt"] = (Builtins.rustfmt) {
    local rustfmt =
      List("rustfmt", "--config-path", ".config/rustfmt.toml", "--config", "skip_children=true")
    batch = true
    check { command { argv = rustfmt + List("--check", "{{files}}") } }
    check_list_files {
      command { argv = rustfmt + List("--check", "--files-with-diff", "{{files}}") }
    }
    fix { command { argv = rustfmt + List("{{files}}") } }
  }
  ["ryl"] = (Builtins.ryl) {
    check { command { argv = List("ryl", "check", "--output-format", "standard", "{{files}}") } }
    diagnostic_format = "stylish"
  }
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["squawk"] {
    glob = "**/*.pgsql"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "squawk",
            "check",
            "--config",
            ".config/squawk.toml",
            "--reporter",
            "gcc",
            "{{files}}",
          )
      }
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["stylelint"] = (Builtins.stylelint) {
    local stylelint =
      List("stylelint", "--config", ".config/stylelint.config.ts", "--max-warnings", "0")
    env { ["NODE_OPTIONS"] = "--throw-deprecation" }
    check { command { argv = stylelint + List("{{files}}") } }
    fix { command { argv = stylelint + List("--fix", "{{files}}") } }
  }
  ["swiftlint"] = (Builtins.swiftlint) {
    local swiftlint = List("swiftlint", "lint", "--quiet", "--config", ".config/swiftlint.yml")
    check { command { argv = swiftlint + List("{{files}}") } }
    fix { command { argv = swiftlint + List("--fix", "{{files}}") } }
    diagnostic_format = "gcc-paren"
  }
  ["swift-format"] {
    glob = "**/*.swift"
    local configured =
      List("--configuration", ".config/swift-format.json", "--parallel", "{{files}}")
    depends = "swiftlint"
    check = new CommandSpec {
      command = new Command { argv = List("swift", "format", "lint", "--strict") + configured }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("swift", "format", "format", "--in-place") + configured }
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["tombi"] = (Builtins.tombi) {
    check {
      command { argv = List("tombi", "lint", "--quiet", "--error-on-warnings", "{{files}}") }
    }
  }
  ["tombi-format"] = Builtins.tombi_format
  ["xcprojformatter"] {
    glob = "**/project.xcproj"
    check_diff = new CommandSpec {
      command = new Command {
        argv = List("hk", "util", "format-diff", "{{files}}", "--", "xcrun", "xcprojformatter")
      }
      effect = "read"
    }
  }
}

// --- [HOOKS] ----------------------------------------------------------------------------

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = new CommandSpec {
          command =
            #"hk util check-conventional-commit --allowed-scopes="$(nx show projects --json | jq -r 'join(",")')" "{{commit_msg_file}}""#
          effect = "read"
        }
      }
    }
  }
  ["pre-commit"] { enabled = false }
}
