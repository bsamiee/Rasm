{
    "$schema": "../node_modules/knip/schema.json",
    "exclude": ["catalog"],
    "treatConfigHintsAsErrors": true,
    "ignoreBinaries": ["rustc", "swift", "uv"],
    "ignoreDependencies": ["@effect/language-service", "adobe", "claude-code", "indesign-uxp-types"],
    "ignoreIssues": {
        "package.json": ["dependencies", "devDependencies", "optionalPeerDependencies"]
    },
    "wrangler": {
        "entry": ["cloudflare.config.ts"]
    },
    "workspaces": {
        ".": {
            "entry": [],
            "project": []
        },
        "products/developer/nx/*": {
            "entry": ["executors/*/executor.ts", "generators/*/generator.ts"]
        },
        "infra": {
            "project": ["**/*.ts", "!sdks/**"]
        }
    }
}
