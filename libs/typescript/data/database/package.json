{
    "name": "@rasm/database",
    "version": "0.0.0",
    "private": true,
    "description": "Databases reconciled to their declared schemas",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/data/database"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./d1": "./d1.ts",
        "./pg": "./pg.ts",
        "./sqlite": "./sqlite.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@pgsql/traverse": "catalog:",
        "@pgsql/types": "catalog:",
        "pgsql-parser": "catalog:"
    },
    "devDependencies": {
        "@effect/sql-d1": "catalog:",
        "@effect/sql-pg": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "@effect/sql-d1": "catalog:peers",
        "@effect/sql-pg": "catalog:peers",
        "effect": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@effect/sql-d1": {
            "optional": true
        },
        "@effect/sql-pg": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./d1": "./dist/d1.js",
            "./pg": "./dist/pg.js",
            "./sqlite": "./dist/sqlite.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
