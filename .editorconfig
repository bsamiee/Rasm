dotnet_diagnostic.RCS1267.severity = error                                    # Interpolation over string.Concat.
dotnet_diagnostic.RCS1268.severity = error                                    # (a - b) compared to 0 reads a compared to b.
dotnet_diagnostic.ROS0003.severity = error                                    # Rule enabled without its roslynator_* option.
dotnet_diagnostic.RCS1001.severity = none                                     # csharp_prefer_braces = false owns braces.
dotnet_diagnostic.RCS1003.severity = none                                     # csharp_prefer_braces = false owns braces.
dotnet_diagnostic.RCS1005.severity = none                                     # IDE0063 owns using declarations.
