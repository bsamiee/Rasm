{
    "name": "@rasm/nx-cmake",
    "version": "0.1.0",
    "description": "Nx plugin inferring CMake projects, targets, and dependency edges from the file API reply of one configured build tree per workflow preset, with clang-tidy checks, CTest runs, and CPack archives",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/cmake"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#package": "./package.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#package": "./package.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": "^24.14.0 || >=25.4.0"
    }
}
