{
    "stryker-config": {
        "test-runner": "mtp",
        "solution": "Workspace.slnx",
        "mutate": ["**/libs/csharp/**/*.cs", "**/tools/**/*.cs", "!**/obj/**", "!**/bin/**", "!**/vendor/**", "!**/Rasm.Contracts/Generated/**"],
        "concurrency": 4,
        "additional-timeout": 5000,
        "thresholds": {
            "high": 90,
            "low": 85,
            "break": 80
        },
        "reporters": ["json", "html", "progress"]
    }
}
