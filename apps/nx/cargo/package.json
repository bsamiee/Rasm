{
    "name": "@rasm/nx-cargo",
    "version": "0.0.0",
    "description": "Nx plugin inferring Cargo workspaces, crates, checks, and releases from cargo's own output",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./release/version-actions": "./version-actions.ts",
        "./executors.json": "./executors.json",
        "./package.json": "./package.json"
    },
    "executors": "./executors.json",
    "dependencies": {
        "@decimalturn/toml-patch": "catalog:",
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:"
    }
}
