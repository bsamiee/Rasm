{
    "name": "@rasm/policy",
    "version": "0.1.0",
    "private": true,
    "description": "Decisions on what an agent attempts by named rule tables, answered as allow, deny, or rewrite, with the hooks that carry them into Claude Code",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/ai/policy"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./policy.ts",
        "./claude": "./claude/hooks.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/policy.js",
            "./claude": "./dist/claude/hooks.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/shell": "workspace:*",
        "sh-syntax": "catalog:"
    },
    "devDependencies": {
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
