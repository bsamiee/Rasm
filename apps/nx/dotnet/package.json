{
    "name": "@rasm/nx-dotnet",
    "version": "0.1.0",
    "description": "Nx plugin inferring MSBuild projects, their restores, builds, checks, tests, fixes, and NuGet releases from one MSBuild evaluation of the workspace",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/dotnet"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#analyzer": "./analyzer/MsbuildAnalyzer.csproj",
        "#analyzer/project": "./analyzer/MsbuildAnalyzer.csproj"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "analyzer/dist", "executors.json", "executors/*/schema.json" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "@xml-tools/ast": "catalog:",
        "@xml-tools/parser": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js",
            "#analyzer": "./analyzer/dist/MsbuildAnalyzer.dll"
        }
    },
    "executors": "./executors.json",
    "nx": {
        "targets": {
            "pack--pnpm": {
                "dependsOn": [ "...", "^build--dotnet" ]
            }
        }
    }
}
