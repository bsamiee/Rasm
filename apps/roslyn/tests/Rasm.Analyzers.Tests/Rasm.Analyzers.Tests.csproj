<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Tests of analyzer rules and their code fixes, one class per analyzer over inline sources</Description>
    </PropertyGroup>

    <ItemGroup Label="Compiler Fixtures">
        <PackageReference Include="LanguageExt.Core" AdditionalReference="true" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" IncludeAssets="compile" AdditionalReference="true" />
        <PackageReference Include="RhinoCommon" IncludeAssets="compile" AdditionalReference="true" />
        <PackageReference Include="SkiaSharp" IncludeAssets="compile" AdditionalReference="true" />
        <PackageReference Include="System.Drawing.Common" IncludeAssets="compile" AdditionalReference="true" />
        <PackageReference Include="System.Reactive" IncludeAssets="compile" AdditionalReference="true" />
        <PackageReference Include="Thinktecture.Runtime.Extensions" AdditionalReference="true" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.SourceGenerator" PrivateAssets="all" ExcludeAssets="analyzers" GeneratePathProperty="true" />
        <Reference Include="$(PkgThinktecture_Runtime_Extensions_SourceGenerator)/analyzers/dotnet/cs/Thinktecture.Runtime.Extensions.SourceGenerator.dll" />
    </ItemGroup>

    <ItemGroup Label="Analyzer Authoring">
        <PackageReference Include="Microsoft.CodeAnalysis.AnalyzerUtilities" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
        <PackageReference Include="QuikGraph" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzer.Testing" />
        <PackageReference Include="Microsoft.CodeAnalysis.CodeFix.Testing" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    </ItemGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../../Rasm.Analyzers/Rasm.Analyzers.csproj" />
        <ProjectReference Include="../../Rasm.Analyzers.CodeFixes/Rasm.Analyzers.CodeFixes.csproj" />
        <ProjectReference Include="../../Rasm.Rhino.Analyzers/Rasm.Rhino.Analyzers.csproj" />
    </ItemGroup>

    <Target Name="StateCompilerFixtures" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolvePackageAssets;ResolveTargetingPackAssets">
        <JoinItems Left="@(ResolvedCompileFileDefinitions)" LeftKey="NuGetPackageId" Right="@(PackageReference->WithMetadataValue('AdditionalReference', 'true'))" ItemSpecToUse="Left">
            <Output TaskParameter="JoinResult" ItemName="_AdditionalReference" />
        </JoinItems>
        <ItemGroup>
            <AssemblyMetadata Include="TargetingPack" Value="@(TargetingPack->WithMetadataValue('Identity', 'Microsoft.NETCore.App')->'%(NuGetPackageId)|%(NuGetPackageVersion)|%(TargetFramework)')" />
            <AssemblyMetadata Include="AdditionalReference.%(_AdditionalReference.Filename)" Value="%(_AdditionalReference.FullPath)" />
        </ItemGroup>
    </Target>
</Project>
