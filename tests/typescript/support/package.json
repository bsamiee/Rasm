{
    "name": "@rasm/testing",
    "version": "0.1.0",
    "private": true,
    "description": "Shared test logic by category: Vitest runner policy, Playwright base and served-task config, and temporary Nx workspaces with packed plugins installed",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "tests/typescript/support"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./conformance": "./conformance.ts",
        "./nx": "./nx.ts",
        "./playwright": "./playwright.ts",
        "./storybook": "./storybook.ts",
        "./vitest": "./vitest.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@axe-core/playwright": "catalog:",
        "@effect/vitest": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:"
    },
    "devDependencies": {
        "@nx/devkit": "catalog:",
        "@playwright/test": "catalog:",
        "@storybook/addon-a11y": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "nx": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@nx/devkit": "catalog:peers",
        "@playwright/test": "catalog:peers",
        "@storybook/addon-a11y": "catalog:peers",
        "effect": "catalog:peers",
        "nx": "catalog:peers",
        "vite": "catalog:peers",
        "vitest": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@nx/devkit": {
            "optional": true
        },
        "@playwright/test": {
            "optional": true
        },
        "@storybook/addon-a11y": {
            "optional": true
        },
        "nx": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "vitest": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            "./conformance": "./dist/conformance.js",
            "./nx": "./dist/nx.js",
            "./playwright": "./dist/playwright.js",
            "./storybook": "./dist/storybook.js",
            "./vitest": "./dist/vitest.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
