{
    "name": "@rasm/hosting",
    "version": "0.0.0",
    "private": true,
    "description": "One web app declared once and served by any provider",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/hosting"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./app": "./app.ts",
        "./browser": "./browser.ts",
        "./cloudflare": "./cloudflare.ts",
        "./head": "./head.ts",
        "./node": "./node.ts",
        "./node-bundle": "./node-bundle.ts",
        "./s3": "./s3.ts",
        "./sites": "./sites.ts",
        "./template": "./template.ts",
        "./vite": "./vite.ts",
        "./worker": "./worker.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "cheerio": "catalog:",
        "partial-content": "catalog:"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@effect/platform-node": "catalog:",
        "@rasm/mark": "workspace:*",
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/web-app-manifest": "catalog:",
        "@vite-pwa/assets-generator": "catalog:",
        "cf": "catalog:",
        "culori": "catalog:",
        "effect": "catalog:",
        "postcss": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "catalog:peers",
        "@effect/platform-node": "catalog:peers",
        "@rasm/mark": "workspace:*",
        "@vite-pwa/assets-generator": "catalog:peers",
        "cf": "catalog:peers",
        "culori": "catalog:peers",
        "effect": "catalog:peers",
        "postcss": "catalog:peers",
        "react": "catalog:peers",
        "react-dom": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-s3": {
            "optional": true
        },
        "@effect/platform-node": {
            "optional": true
        },
        "@rasm/mark": {
            "optional": true
        },
        "@vite-pwa/assets-generator": {
            "optional": true
        },
        "cf": {
            "optional": true
        },
        "culori": {
            "optional": true
        },
        "postcss": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./app": "./dist/app.js",
            "./browser": "./dist/browser.js",
            "./cloudflare": "./dist/cloudflare.js",
            "./head": "./dist/head.js",
            "./node": "./dist/node.js",
            "./node-bundle": "./dist/node-bundle.js",
            "./s3": "./dist/s3.js",
            "./sites": "./dist/sites.js",
            "./template": "./dist/template.js",
            "./vite": "./dist/vite.js",
            "./worker": "./dist/worker.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
