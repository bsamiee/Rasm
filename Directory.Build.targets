<Project>
    <PropertyGroup Label="Test Platform" Condition="'$(IsTestingPlatformApplication)' == 'true'">
        <IsTestProject>true</IsTestProject>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory &quot;$(ArtifactsPath)/TestResults/$(MSBuildProjectName)&quot;</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <ItemGroup Label="Test Analyzers" Condition="'$(ProjectRole)' == 'tests'">
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Label="Global Usings" Condition="'$(ProjectRole)' != 'analyzers'">
        <Using Remove="System.Collections.Generic" />
        <Using Include="System.Collections.Frozen;System.Collections.Immutable" />
        <Using Include="Thinktecture" />
        <Using Include="LanguageExt;LanguageExt.Common;LanguageExt.Traits;LanguageExt.UnsafeValueAccess" />
        <Using Include="LanguageExt.Prelude" Static="true" />
        <Using Include="LanguageExt.Pipes" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Streaming'))" />
        <Using Include="LanguageExt.Sys;LanguageExt.Sys.IO;LanguageExt.Sys.Traits;LanguageExt.Sys.Diag" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Sys'))" />
        <Using Include="LanguageExt.Parsec" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Parsec'))" />
        <Using Include="NodaTime;NodaTime.Extensions" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'NodaTime'))" />
        <Using Include="NodaTime.Duration" Alias="Duration" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'NodaTime'))" />
        <Using Include="UnitsNet.Length" Alias="Length" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'UnitsNet'))" />
        <Using Include="Microsoft.Extensions.Logging" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Logging')) or @(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Logging.Abstractions'))" />
        <Using Include="Xunit" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v2')) or @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.assert'))" />
        <Using Include="CsCheck" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'CsCheck'))" />
        <Using Include="Grasshopper2.Types.Numeric" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Grasshopper2'))" />
    </ItemGroup>

    <ItemGroup Label="Analyzer Configuration">
        <CompilerVisibleProperty Include="ProjectRole" Condition="'$(ProjectRole)' != ''" />
        <CompilerVisibleProperty Include="TargetExt" />
    </ItemGroup>

    <ItemGroup Label="Banned Symbols">
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)tools/roslyn/BannedSymbols.txt" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)tools/roslyn/BannedSymbols.Library.txt" Condition="'$(ProjectRole)' == 'library'" />
    </ItemGroup>

    <ItemGroup Label="Analyzer References" Condition="'$(ProjectRole)' != 'analyzers'">
        <_RoslynComponent Include="$(MSBuildThisFileDirectory)tools/roslyn/*/*.csproj" />
        <ProjectReference Include="@(_RoslynComponent)" Exclude="@(ProjectReference)" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Update="@(_RoslynComponent)" OutputItemType="Analyzer" UndefineProperties="RhinoPlugIn;ArtifactsPivots" />
    </ItemGroup>

    <ItemGroup Label="Publicized References">
        <PackageReference Update="Krafs.Publicizer" PrivateAssets="all" ExcludeAssets="contentfiles" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="AddAccessChecksAttribute" BeforeTargets="CoreCompile" Condition="'@(Publicize)' != ''">
        <Copy SourceFiles="$(PkgKrafs_Publicizer)/contentfiles/cs/any/Publicizer/IgnoresAccessChecksToAttribute.cs" DestinationFiles="$(IntermediateOutputPath)IgnoresAccessChecksToAttribute.g.cs" SkipUnchangedFiles="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)IgnoresAccessChecksToAttribute.g.cs" />
            <FileWrites Include="$(IntermediateOutputPath)IgnoresAccessChecksToAttribute.g.cs" />
        </ItemGroup>
    </Target>

    <PropertyGroup Label="Fetched Files">
        <_FetchedStore>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '.cache', 'fetched'))</_FetchedStore>
    </PropertyGroup>

    <ItemGroup Label="Fetched Files">
        <FetchedResource Update="@(FetchedResource)" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
        <EmbeddedResource Include="@(FetchedResource->'$(_FetchedStore)%(Sha256)')" />
    </ItemGroup>

    <Target Name="FetchResources" BeforeTargets="CoreCompile" Condition="'@(FetchedResource)' != '' and '$(DesignTimeBuild)' != 'true'">
        <DownloadFile SourceUrl="%(FetchedResource.Identity)" DestinationFolder="$(IntermediateOutputPath)" DestinationFileName="%(FetchedResource.Sha256)" Condition="!Exists('$(_FetchedStore)%(FetchedResource.Sha256)')" />
        <VerifyFileHash File="$(IntermediateOutputPath)%(FetchedResource.Sha256)" Hash="%(FetchedResource.Sha256)" Condition="!Exists('$(_FetchedStore)%(FetchedResource.Sha256)')" />
        <Move SourceFiles="$(IntermediateOutputPath)%(FetchedResource.Sha256)" DestinationFiles="$(_FetchedStore)%(FetchedResource.Sha256)" Condition="!Exists('$(_FetchedStore)%(FetchedResource.Sha256)')" />
    </Target>

    <PropertyGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <DefaultItemExcludes Condition="'$(TargetPlatformIdentifier)' == 'Windows'">$(DefaultItemExcludes);**/Mac/**</DefaultItemExcludes>
        <DefaultItemExcludes Condition="'$(TargetPlatformIdentifier)' != 'Windows'">$(DefaultItemExcludes);**/Windows/**</DefaultItemExcludes>
        <_RhinoHostProject>$(MSBuildThisFileDirectory)eng/dotnet/rhino/RhinoHost.proj</_RhinoHostProject>
        <_RhinoHostBuildProperties>Configuration;TargetFramework;RuntimeIdentifier;_CommandLineDefinedRuntimeIdentifier;_IsPublishing;NoBuild;RhinoPlugIn;ArtifactsPivots;ArtifactsPath</_RhinoHostBuildProperties>
        <_IconDir>$(IntermediateOutputPath)Icons/</_IconDir>
        <IconLightStylesheet Condition="'$(IconLightStylesheet)' == ''">$(MSBuildThisFileDirectory)eng/dotnet/rhino/icon-light.css</IconLightStylesheet>
        <IconDarkStylesheet Condition="'$(IconDarkStylesheet)' == ''">$(MSBuildThisFileDirectory)eng/dotnet/rhino/icon-dark.css</IconDarkStylesheet>
    </PropertyGroup>

    <ItemGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <PackageReference Include="RhinoCommon" ExcludeAssets="runtime" />
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="compile" />
        <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" Condition="'$(TargetPlatformIdentifier)' == 'Windows'" />
        <Using Include="Rhino.Geometry" />
        <Using Include="Rhino.Geometry.Interval" Alias="Interval" />
        <EmbeddedResource Include="**/EmbeddedResources/**" Exclude="**/*.svg" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
        <_IconMaster Include="**/EmbeddedResources/**/*.svg" Exclude="$(PlugInIcon)" IconStem="%(Filename)" />
        <_IconMaster Include="$(PlugInIcon)" IconStem="icon" Condition="Exists('$(PlugInIcon)')" />
        <_IconMaster Update="@(_IconMaster)" Master="%(FullPath)" />
        <_ThemedIcon Include="@(_IconMaster->'$(_IconDir)%(IconStem)%(Extension)')" Stylesheet="$(IconLightStylesheet)" />
        <_ThemedIcon Include="@(_IconMaster->'$(_IconDir)%(IconStem)_darkmode%(Extension)')" Stylesheet="$(IconDarkStylesheet)" />
        <EmbeddedResource Include="@(_ThemedIcon)" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
        <FileWrites Include="@(_ThemedIcon)" />
    </ItemGroup>

    <Target Name="PaintIcons" BeforeTargets="CoreCompile" Condition="'@(_ThemedIcon)' != '' and '$(DesignTimeBuild)' != 'true'" Inputs="@(_ThemedIcon->'%(Master)');$(IconLightStylesheet);$(IconDarkStylesheet);$(MSBuildAllProjects)" Outputs="@(_ThemedIcon)">
        <MakeDir Directories="$(_IconDir)" />
        <Exec Command="usvg --stylesheet &quot;%(_ThemedIcon.Stylesheet)&quot; &quot;%(_ThemedIcon.Master)&quot; &quot;%(_ThemedIcon.FullPath)&quot;" LogStandardErrorAsError="true" />
    </Target>

    <Target Name="ResolveRhinoInstallation" AfterTargets="ResolvePackageAssets" Condition="'$(RhinoHost)' != ''">
        <PropertyGroup>
            <_RhinoCommonVersion>@(PackageVersion->WithMetadataValue('Identity', 'RhinoCommon')->'%(Version)')</_RhinoCommonVersion>
            <_RhinoMajorVersion>$(_RhinoCommonVersion.Split('.')[0])</_RhinoMajorVersion>
        </PropertyGroup>
        <MSBuild Projects="$(_RhinoHostProject)" Targets="ReadInstallation" Properties="RhinoMajorVersion=$(_RhinoMajorVersion)" RemoveProperties="$(_RhinoHostBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="_RhinoInstallation" />
        </MSBuild>
        <PropertyGroup>
            <RhinoInstallPath>@(_RhinoInstallation)</RhinoInstallPath>
            <RhinoResourcesDir>@(_RhinoInstallation->'%(ResourcesDir)')</RhinoResourcesDir>
            <RhinoTargetFramework>@(_RhinoInstallation->'%(TargetFramework)')</RhinoTargetFramework>
            <_RhinoMacMinimumVersion>@(_RhinoInstallation->'%(MacMinimumVersion)')</_RhinoMacMinimumVersion>
            <_YakExecutable>@(_RhinoInstallation->'%(YakExecutable)')</_YakExecutable>
        </PropertyGroup>
        <Error Condition="$([MSBuild]::VersionGreaterThan($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), $([MSBuild]::GetTargetFrameworkVersion('$(RhinoTargetFramework)'))))" Text="$(MSBuildProjectName) targets $(TargetFramework), newer than the $(RhinoTargetFramework) runtime Rhino $(_RhinoMajorVersion) loads from $(RhinoResourcesDir)" />
    </Target>

    <Target Name="ResolveRhinoMacHost" BeforeTargets="ResolveAssemblyReferences;GetAssemblyAttributes" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(RhinoHost)' != '' and '$(TargetPlatformIdentifier)' != 'Windows'">
        <ItemGroup>
            <_RhinoMacAssembly Include="System.Drawing.Common;Eto.macOS;Microsoft.macOS" />
            <Reference Include="@(_RhinoMacAssembly->'$(RhinoResourcesDir)%(Identity).dll')" Private="false" />
            <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
                <_Parameter1>macos$(_RhinoMacMinimumVersion)</_Parameter1>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <PropertyGroup Label="Rhino Product" Condition="'$(TargetExt)' == '.rhp' or '$(TargetExt)' == '.rhs'">
        <RhinoProduct>true</RhinoProduct>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <MinVerIgnoreHeight>true</MinVerIgnoreHeight>
        <PlugInIcon Condition="'$(PlugInIcon)' == ''">EmbeddedResources/icon.svg</PlugInIcon>
    </PropertyGroup>

    <ItemGroup Label="Rhino Product" Condition="'$(RhinoProduct)' == 'true'">
        <PackageReference Include="MinVer" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup Label="Rhino Skin" Condition="'$(TargetExt)' == '.rhs'">
        <PublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '.artifacts', 'dotnet', 'skin', '$(MSBuildProjectName)'))</PublishDir>
    </PropertyGroup>

    <ItemGroup Label="Rhino Skin" Condition="'$(TargetExt)' == '.rhs'">
        <None Update="*.rhw" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup Label="Rhino Plug-In" Condition="'$(TargetExt)' == '.rhp'">
        <PlugInIconPlate Condition="'$(PlugInIconPlate)' == ''">#323232</PlugInIconPlate>
        <PlugInIconCorner Condition="'$(PlugInIconCorner)' == ''">0.046875</PlugInIconCorner>
        <PlugInIconInset Condition="'$(PlugInIconInset)' == ''">0.125</PlugInIconInset>
        <_PlugInPackageIcon>icon.png</_PlugInPackageIcon>
        <_PlugInAssetDir>$(IntermediateOutputPath)PlugInAssets/</_PlugInAssetDir>
        <_PlugInIcon>PlugIn.ico</_PlugInIcon>
        <_PlugInIconPngFrame>256</_PlugInIconPngFrame>
        <_PlugInRui>$(IntermediateOutputPath)$(TargetName).rui</_PlugInRui>
        <_PlugInRuiReferences>$(IntermediateOutputPath)$(TargetName).rui.rsp</_PlugInRuiReferences>
        <_PlugInRuiStamp>$(IntermediateOutputPath)$(TargetName).rui.stamp</_PlugInRuiStamp>
        <_YakPackageDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '.artifacts', 'dotnet', 'yak', '$(MSBuildProjectName)'))</_YakPackageDir>
        <_YakPlatform>mac</_YakPlatform>
        <_YakPlatform Condition="'$(TargetPlatformIdentifier)' == 'Windows'">win</_YakPlatform>
    </PropertyGroup>

    <ItemGroup Label="Rhino Plug-In" Condition="'$(TargetExt)' == '.rhp'">
        <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute"><_Parameter1>$(PlugInId)</_Parameter1></AssemblyAttribute>
        <_RhinoLibraryReference Include="@(ProjectReference->WithMetadataValue('Filename', 'Rasm.Rhino'))" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)eng/dotnet/rhino/Rasm.Rui/Rasm.Rui.csproj" ReferenceOutputAssembly="false" Private="false" OutputItemType="_RuiWriter" UndefineProperties="RuntimeIdentifier" Condition="'@(_RhinoLibraryReference)' != ''" />
        <PlugInDescription Include="Organization" Exclude="@(PlugInDescription)" Value="$(Authors)" />
        <PlugInDescription Include="WebSite" Exclude="@(PlugInDescription)" Value="$(PackageProjectUrl)" />
        <_GrasshopperPackage Include="@(PackageReference->WithMetadataValue('Identity', 'Grasshopper2'))" />
    </ItemGroup>

    <ItemGroup Label="Grasshopper 2 Plug-In" Condition="'@(_GrasshopperPackage)' != ''">
        <None Update="Documentation/**;Docs/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <_GrasshopperOnlyMarker Include="$(IntermediateOutputPath)$(TargetName)$(TargetExt).grasshopper-only" Condition="'$(GrasshopperOnly)' == 'true' or ('$(GrasshopperOnly)' == '' and '@(_RhinoLibraryReference)' == '')" />
        <None Include="@(_GrasshopperOnlyMarker)" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <FileWrites Include="@(_GrasshopperOnlyMarker)" />
    </ItemGroup>

    <Target Name="WriteGrasshopperOnlyMarker" BeforeTargets="AssignTargetPaths" Condition="'@(_GrasshopperOnlyMarker)' != '' and '$(DesignTimeBuild)' != 'true'" Inputs="$(MSBuildAllProjects)" Outputs="@(_GrasshopperOnlyMarker)">
        <Touch Files="@(_GrasshopperOnlyMarker)" AlwaysCreate="true" />
    </Target>

    <Target Name="ExcludeRhinoHostAssemblies" AfterTargets="ResolvePackageAssets" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(RhinoProduct)' == 'true' or ('$(RhinoHost)' != '' and '$(EnableDynamicLoading)' == 'true')">
        <MSBuild Projects="$(_RhinoHostProject)" Targets="ReadDeclaredAssemblies" Properties="RhinoMajorVersion=$(_RhinoMajorVersion)" RemoveProperties="$(_RhinoHostBuildProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="_RhinoDeclared" />
        </MSBuild>
        <ItemGroup>
            <_RhinoPlugInAssembly Include="$(RhinoResourcesDir)ManagedPlugIns/*.rhp/*.dll" />
            <_RhinoReference Include="@(ResolvedCompileFileDefinitions)" />
            <_RhinoReference Remove="@(RuntimeCopyLocalItems)" MatchOnMetadata="NuGetPackageId" />
            <_RhinoPackaged Include="@(RuntimeCopyLocalItems);@(_RhinoReference)" HostFile="$(RhinoResourcesDir)%(Filename)%(Extension)" Condition="Exists('$(RhinoResourcesDir)%(Filename)%(Extension)')" />
            <_RhinoPackaged Include="@(_RhinoReference)" HostFile="@(_RhinoPlugInAssembly)" Condition="'%(Filename)' != '' and '@(_RhinoPlugInAssembly)' != ''" />
        </ItemGroup>
        <GetAssemblyIdentity AssemblyFiles="@(_RhinoPackaged)">
            <Output TaskParameter="Assemblies" ItemName="_RhinoPackagedAssembly" />
        </GetAssemblyIdentity>
        <ItemGroup>
            <_RhinoPackagedAssembly PackagedVersion="%(Version)" />
        </ItemGroup>
        <GetAssemblyIdentity AssemblyFiles="@(_RhinoPackagedAssembly->'%(HostFile)')">
            <Output TaskParameter="Assemblies" ItemName="_RhinoSupplied" />
        </GetAssemblyIdentity>
        <ItemGroup>
            <_RhinoSupplied Version="@(_RhinoDeclared->'%(Version)')" Condition="'%(Name)' != '' and '@(_RhinoDeclared)' != ''" />
        </ItemGroup>
        <Error Condition="$([MSBuild]::VersionGreaterThan('%(_RhinoSupplied.PackagedVersion)', '%(_RhinoSupplied.Version)'))" Text="%(_RhinoSupplied.NuGetPackageId) %(_RhinoSupplied.NuGetPackageVersion) ships %(_RhinoSupplied.Name) %(_RhinoSupplied.PackagedVersion), above the %(_RhinoSupplied.Version) Rhino $(_RhinoMajorVersion) loads from $(RhinoResourcesDir)" />
        <ItemGroup>
            <RuntimeCopyLocalItems Remove="@(_RhinoSupplied)" MatchOnMetadata="NuGetPackageId" />
            <NativeCopyLocalItems Remove="@(_RhinoSupplied)" MatchOnMetadata="NuGetPackageId" />
        </ItemGroup>
    </Target>

    <Target Name="AssignPlugInLibraryCopies" BeforeTargets="AssignProjectConfiguration" DependsOnTargets="IncludeTransitiveProjectReferences" Condition="'$(RhinoProduct)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <ProjectReference AdditionalProperties="RhinoPlugIn=$(MSBuildProjectName);ArtifactsPivots=$(MSBuildProjectName)_$(ArtifactsPivots)" />
            <ProjectReference AdditionalProperties="RhinoPlugIn=$(MSBuildProjectName);ArtifactsPivots=$(MSBuildProjectName)_$(Configuration.ToLowerInvariant())" Condition="'%(OutputItemType)' == '_RuiWriter'" />
        </ItemGroup>
    </Target>

    <Target Name="AssignPlugInAssemblyVersion" AfterTargets="MinVer" Condition="'$(RhinoProduct)' == 'true'">
        <PropertyGroup>
            <AssemblyVersion>$(FileVersion)</AssemblyVersion>
        </PropertyGroup>
    </Target>

    <Target Name="AddPlugInDescriptions" AfterTargets="GetAssemblyAttributes" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <AssemblyAttribute Include="@(PlugInDescription->'Rhino.PlugIns.PlugInDescriptionAttribute')" RemoveMetadata="Value">
                <_Parameter1>Rhino.PlugIns.DescriptionType.%(PlugInDescription.Identity)</_Parameter1>
                <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
                <_Parameter2>%(PlugInDescription.Value)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInIcon" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetExt)' == '.rhp' and Exists('$(PlugInIcon)')" Inputs="$(MSBuildAllProjects);$(IconDarkStylesheet);$(PlugInIcon)" Outputs="$(_PlugInAssetDir)$(_PlugInIcon);$(_PlugInAssetDir)$(_PlugInIconPngFrame).png">
        <ItemGroup>
            <_PlugInIconFrame Include="$(_PlugInIconPngFrame);48;32;24;16" />
            <_PlugInRaster Include="@(_PlugInIconFrame->'$(_PlugInAssetDir)%(Identity).png')" />
        </ItemGroup>
        <MakeDir Directories="$(_PlugInAssetDir)" />
        <Exec Command="resvg -w $([System.Math]::Round($([MSBuild]::Multiply(%(_PlugInRaster.Filename), $([MSBuild]::Subtract(1, $([MSBuild]::Multiply(2, $(PlugInIconInset))))))))) --stylesheet &quot;$(IconDarkStylesheet)&quot; &quot;$(PlugInIcon)&quot; &quot;%(_PlugInRaster.FullPath)&quot;" />
        <Exec Command="magick -size %(_PlugInRaster.Filename)x%(_PlugInRaster.Filename) xc:none -fill &quot;$(PlugInIconPlate)&quot; -draw &quot;roundrectangle 0,0,$([MSBuild]::Subtract(%(_PlugInRaster.Filename), 1)),$([MSBuild]::Subtract(%(_PlugInRaster.Filename), 1)),$([MSBuild]::Multiply(%(_PlugInRaster.Filename), $(PlugInIconCorner))),$([MSBuild]::Multiply(%(_PlugInRaster.Filename), $(PlugInIconCorner)))&quot; &quot;%(_PlugInRaster.FullPath)&quot; -gravity center -composite &quot;%(_PlugInRaster.FullPath)&quot;" />
        <Exec Command="magick @(_PlugInRaster->'&quot;%(Filename)%(Extension)&quot;', ' ') -define icon:png-compression-size=$(_PlugInIconPngFrame) &quot;$(_PlugInIcon)&quot;" WorkingDirectory="$(_PlugInAssetDir)" />
        <ItemGroup>
            <None Include="$(_PlugInAssetDir)$(_PlugInIconPngFrame).png" TargetPath="$(_PlugInPackageIcon)" CopyToPublishDirectory="PreserveNewest" />
            <EmbeddedResource Include="$(_PlugInAssetDir)$(_PlugInIcon)" LogicalName="$(_PlugInIcon)" WithCulture="false" />
            <PlugInDescription Include="Icon" Value="$(_PlugInIcon)" />
            <FileWrites Include="$(_PlugInAssetDir)$(_PlugInIcon);@(_PlugInRaster)" />
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInRui" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetExt)' == '.rhp' and '@(_RhinoLibraryReference)' != ''" Inputs="@(IntermediateAssembly);@(ReferenceCopyLocalPaths);@(_RuiWriter)" Outputs="$(_PlugInRuiStamp)">
        <WriteLinesToFile File="$(_PlugInRuiReferences)" Lines="@(ReferenceCopyLocalPaths->WithMetadataValue('Extension', '.dll')->'%(FullPath)');@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(_RuiWriter->'%(FullPath)')&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$(_PlugInRui)&quot; &quot;@$(_PlugInRuiReferences)&quot;" StandardOutputImportance="low" LogStandardErrorAsError="true" />
        <Touch Files="$(_PlugInRuiStamp)" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(_PlugInRui);$(_PlugInRuiReferences);$(_PlugInRuiStamp)" />
        </ItemGroup>
    </Target>

    <Target Name="ListPlugInRui" BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="'$(TargetExt)' == '.rhp' and '@(_RhinoLibraryReference)' != '' and Exists('$(_PlugInRui)')">
        <ItemGroup>
            <ContentWithTargetPath Include="$(_PlugInRui)" TargetPath="$(TargetName).rui" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <Target Name="BuildYakPackage" AfterTargets="Publish" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <_YakOutput Include="$(PublishDir)*.yak;$(PublishDir)manifest.yml;$(_YakPackageDir)*-$(_YakPlatform).yak" />
        </ItemGroup>
        <Delete Files="@(_YakOutput)" />
        <Exec Command="&quot;$(_YakExecutable)&quot; spec --input &quot;$(TargetFileName)&quot;" WorkingDirectory="$(PublishDir)" StandardOutputImportance="low" LogStandardErrorAsError="true" />
        <PropertyGroup>
            <_YakIcon Condition="Exists('$(PlugInIcon)')">$(_PlugInPackageIcon)</_YakIcon>
        </PropertyGroup>
        <Exec Command="yq -i &quot;with(select(strenv(ICON) != \&quot;\&quot;); .icon = strenv(ICON)) | .keywords += ((strenv(TAGS) | split(\&quot;,\&quot;) | map(select(. != \&quot;\&quot;))) + [\&quot;guid:\&quot; + strenv(PLUGIN)])&quot; manifest.yml" EnvironmentVariables="ICON=$(_YakIcon);TAGS=$(PackageTags.Replace(';', ','));PLUGIN=$(PlugInId)" WorkingDirectory="$(PublishDir)" />
        <Exec Command="&quot;$(_YakExecutable)&quot; build --platform $(_YakPlatform)" WorkingDirectory="$(PublishDir)" LogStandardErrorAsError="true" />
        <ItemGroup>
            <_YakBuilt Include="$(PublishDir)*.yak" />
        </ItemGroup>
        <Move SourceFiles="@(_YakBuilt)" DestinationFolder="$(_YakPackageDir)" />
    </Target>

    <Target Name="InstallYakPackage" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhp'">
        <Exec Command="yq .name manifest.yml" WorkingDirectory="$(PublishDir)" ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_YakPackageName" />
        </Exec>
        <ItemGroup>
            <_YakPackage Include="$(_YakPackageDir)*-$(_YakPlatform).yak" />
        </ItemGroup>
        <Exec Command="&quot;$(_YakExecutable)&quot; uninstall &quot;$(_YakPackageName)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="&quot;$(_YakExecutable)&quot; install &quot;%(_YakPackage.FullPath)&quot;" LogStandardErrorAsError="true" />
    </Target>

    <Target Name="PushYakPackage" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <_YakPackage Include="$(_YakPackageDir)*.yak" />
        </ItemGroup>
        <Exec Command="&quot;$(_YakExecutable)&quot; push &quot;%(_YakPackage.FullPath)&quot;" LogStandardErrorAsError="true" />
    </Target>

    <Target Name="InstallRhinoSkin" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhs'">
        <Exec Command="reg add &quot;HKLM\SOFTWARE\McNeel\Rhinoceros\$(_RhinoMajorVersion).0\Scheme: $(MSBuildProjectName)&quot; /v SkinDLLPath /t REG_SZ /d &quot;$([MSBuild]::NormalizePath('$(PublishDir)', '$(TargetFileName)'))&quot; /f" LogStandardErrorAsError="true" />
    </Target>
</Project>
