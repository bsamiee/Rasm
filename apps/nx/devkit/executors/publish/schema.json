{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": 2,
    "type": "object",
    "properties": {
        "dryRun": {
            "type": "boolean",
            "description": "Prints each change and makes none, as NX_DRY_RUN=true does"
        },
        "nxReleaseVersionData": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "newVersion": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [ "newVersion" ],
                "additionalProperties": true
            },
            "description": "Versions nx release set in this run, a project it left unversioned is skipped"
        },
        "commands": {
            "type": "array",
            "description": "Argument lists run in order before the publish, under a dry run too (a pack, a build)",
            "default": [],
            "items": {
                "type": "array",
                "minItems": 1,
                "items": [
                    {
                        "type": "string"
                    }
                ],
                "additionalItems": {
                    "type": "string"
                }
            }
        },
        "publish": {
            "type": "array",
            "minItems": 1,
            "description": "The tool's publish argument list",
            "items": [
                {
                    "type": "string"
                }
            ],
            "additionalItems": {
                "type": "string"
            }
        },
        "preview": {
            "type": "array",
            "minItems": 1,
            "description": "The tool's own dry-run form, run in place of publish under a dry run, absent prints publish and runs nothing",
            "items": [
                {
                    "type": "string"
                }
            ],
            "additionalItems": {
                "type": "string"
            }
        },
        "secrets": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            },
            "description": "Flag to the environment variable holding its value, each set variable appends the pair to publish",
            "default": {}
        },
        "registry": {
            "type": "string",
            "description": "Registry nx release publish passes as --registry, appended to publish and preview after registryFlag"
        },
        "registryFlag": {
            "type": "string",
            "description": "The tool's flag taking a registry (--source, --index), absent ignores registry"
        },
        "args": {
            "type": "array",
            "description": "Arguments appended to publish and to preview",
            "default": [],
            "items": {
                "type": "string"
            }
        },
        "cwd": {
            "type": "string",
            "description": "Folder the commands run in, relative to the workspace root",
            "default": "."
        }
    },
    "required": [ "commands", "publish", "secrets", "args", "cwd" ],
    "additionalProperties": true,
    "title": "Publish",
    "description": "Publishes a project through its tool's own publish command, skipping a project nx release left unversioned; runs through nx release publish"
}
