<Project Sdk="Microsoft.NET.Sdk">
    <!-- [PROPERTIES] ──────────────────────────────────────────────────────────────── -->

    <PropertyGroup Label="Package Metadata">
        <Description>Code fixes that rewrite each analyzer finding into the form its rule requires</Description>
    </PropertyGroup>

    <!-- [ITEMS] ───────────────────────────────────────────────────────────────────── -->

    <ItemGroup Label="Analyzer Authoring">
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="QuikGraph" />
        <TargetPathWithTargetPlatformMoniker Include="$(PkgQuikGraph)/lib/netstandard2.0/QuikGraph.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
</Project>
