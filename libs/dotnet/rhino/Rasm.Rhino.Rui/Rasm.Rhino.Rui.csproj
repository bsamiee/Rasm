<Project Sdk="Microsoft.NET.Sdk">
    <!-- [PROPERTIES] ──────────────────────────────────────────────────────────────── -->

    <PropertyGroup Label="Package Metadata">
        <Description>Build-time writer of Rhino toolbar files from plug-in code</Description>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Label="Application">
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <!-- [ITEMS] ───────────────────────────────────────────────────────────────────── -->

    <ItemGroup Label="Rhino">
        <PackageReference Include="RhinoCommon" />
    </ItemGroup>

    <ItemGroup Label="Functional Programming">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Identifiers and Hashing">
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="SuperLinq" />
    </ItemGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../../runtime/Rasm.Hosting/Rasm.Hosting.csproj" />
        <ProjectReference Include="../../runtime/Rasm.Telemetry.Api/Rasm.Telemetry.Api.csproj" />
        <ProjectReference Include="../Rasm.Rhino/Rasm.Rhino.csproj" />
        <Using Include="Rasm.Telemetry.Api" />
    </ItemGroup>
</Project>
