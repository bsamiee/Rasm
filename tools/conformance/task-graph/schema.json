{
    "$schema": "http://json-schema.org/schema",
    "$id": "task-graph",
    "title": "task-graph rule configuration",
    "type": "object",
    "properties": {
        "folders": {
            "type": "array",
            "description": "Globs over workspace paths a cached output may sit under",
            "items": { "type": "string" },
            "minItems": 1
        },
        "clean": {
            "type": "string",
            "description": "Name of the target removing the outputs of a project's targets"
        }
    },
    "required": ["folders", "clean"],
    "additionalProperties": false
}
