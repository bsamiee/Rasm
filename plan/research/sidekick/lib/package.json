{
  "name": "@indesign-mcp/server",
  "version": "1.0.27",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "indesign-mcp-server": "./dist/index.js",
    "indesign-sidekick": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:silent-server": "node scripts/silent-server.mjs",
    "preview:snapshot-view": "tsx scripts/preview-snapshot-view.ts",
    "pack:mcpb": "node scripts/pack-mcpb.js",
    "pack:impl": "node scripts/pack-impl.js",
    "smoke:bundle": "node scripts/smoke-test-bundle.js",
    "smoke:launcher": "node scripts/smoke-test-launcher.js",
    "smoke:mcpb": "node scripts/smoke-test-mcpb.js",
    "pack:macos": "oclif pack macos",
    "pack:win": "node scripts/patch-oclif-win-installer.js && oclif pack win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@oclif/core": "^4.8.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "detect-port": "^2.1.0",
    "opentype.js": "^1.3.4",
    "semver": "^7.7.3",
    "uuid": "^11.0.3",
    "wasm-vips": "^0.0.18",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@oclif/test": "^4.1.15",
    "@types/estree": "^1.0.8",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.1",
    "@types/opentype.js": "^1.3.8",
    "@types/semver": "^7.7.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.27.1",
    "javascript-obfuscator": "^5.0.1",
    "jsdom": "^29.1.1",
    "oclif": "^4.22.54",
    "vitest": "^2.1.8"
  },
  "oclif": {
    "bin": "indesign-sidekick",
    "dirname": "indesign-sidekick",
    "commands": "./dist/commands",
    "plugins": [],
    "macos": {
      "identifier": "nl.eastpole.indesign-sidekick",
      "sign": "\"Developer ID Installer: Wilfred Springer (47YAXF5AQS)\"",
      "scripts": {
        "postinstall": "scripts/postinstall.sh"
      }
    },
    "windows": {
      "name": "Sidekick for InDesign"
    },
    "update": {
      "s3": {
        "host": "https://releases.sidekick.eastpole.nl",
        "bucket": "indesign-sidekick-releases"
      }
    },
    "targets": [
      "darwin-arm64",
      "darwin-x64",
      "win32-x64"
    ]
  }
}
