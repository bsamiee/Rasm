<Project>
    <ItemGroup Label="Rhino Test Host" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <None Include="$(MSBuildThisFileDirectory)Rasm.Rhino.Testing.Boot.cs" Link="Rasm.Rhino.Testing.Boot.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <Target Name="ResolveRhinoTestHost" BeforeTargets="GenerateBuildRuntimeConfigurationFiles" DependsOnTargets="ResolvePackageAssets" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <PropertyGroup>
            <_RhinoTestHostVersion>@(ResolvedCompileFileDefinitions->WithMetadataValue('NuGetPackageId', 'RhinoCommon')->'%(NuGetPackageVersion)'->Distinct())</_RhinoTestHostVersion>
            <RhinoInstallPath Condition="'$(RhinoInstallPath)' == ''">/Applications/Rhino $(_RhinoTestHostVersion.Split('.')[0]).app</RhinoInstallPath>
            <_RhinoTestHostRuntime>$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'Contents', 'Frameworks', 'RhCore.framework', 'Versions', 'Current', 'Resources', 'dotnet', '$(NETCoreSdkPortableRuntimeIdentifier.Split('-')[1])', 'dotnet'))</_RhinoTestHostRuntime>
        </PropertyGroup>
        <Error Condition="'$(_RhinoTestHostVersion)' == ''" Text="$(MSBuildProjectName) references no RhinoCommon, which names the Rhino its tests run in" />
        <Error Condition="!Exists('$(RhinoInstallPath)/Contents/Info.plist')" Text="No Rhino is installed at '$(RhinoInstallPath)', install it or set RhinoInstallPath" />
        <Error Condition="!Exists('$(_RhinoTestHostRuntime)')" Text="$(RhinoInstallPath) carries no .NET runtime at '$(_RhinoTestHostRuntime)'" />
        <XmlPeek XmlInputPath="$(RhinoInstallPath)/Contents/Info.plist" Query="/plist/dict/key[.='CFBundleExecutable']/following-sibling::*[1]/text()" ProhibitDtd="false">
            <Output TaskParameter="Result" PropertyName="_RhinoTestHostExecutable" />
        </XmlPeek>
        <ItemGroup>
            <RuntimeHostConfigurationOption Include="Rasm.Rhino.Testing.Executable" Value="$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'Contents', 'MacOS', '$(_RhinoTestHostExecutable)'))" />
        </ItemGroup>
    </Target>

    <Target Name="RunOnRhinoRuntime" BeforeTargets="ComputeRunArguments" DependsOnTargets="ResolveRhinoTestHost" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <PropertyGroup>
            <RunCommand>$(_RhinoTestHostRuntime)</RunCommand>
            <RunArguments>exec &quot;$(TargetPath)&quot;$(RunArguments)</RunArguments>
        </PropertyGroup>
    </Target>
</Project>
