{
    "name": "@rasm/hosting",
    "version": "0.0.0",
    "private": true,
    "description": "One web app declared once and hosted by any provider: its bindings, sign-in source, Node bundle and server, Cloudflare projection and deployment, and server-rendered page",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/hosting"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./identity/identity.ts",
        "./app": "./app/app.ts",
        "./cloudflare": "./cloudflare/worker-config.ts",
        "./head": "./rendering/site-head.ts",
        "./hydrate": "./rendering/hydrate.ts",
        "./node": "./node/node-server.ts",
        "./openai-sites": "./identity/openai-sites.ts",
        "./pulumi": "./cloudflare/worker-deploy.ts",
        "./shell": "./rendering/shell.ts",
        "./template": "./rendering/template.ts",
        "./vite": "./node/node-bundle.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@types/web-app-manifest": "catalog:"
    },
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@pulumi/cloudflare": "catalog:",
        "@pulumi/command": "catalog:",
        "@pulumi/pulumi": "catalog:",
