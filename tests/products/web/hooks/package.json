{
    "name": "@rasm/test-hooks",
    "private": true,
    "description": "@rasm/hooks suites over its built Node bundle against a Postgres container, covering accepted, refused, and repeated deliveries and the queue rows they leave",
    "type": "module",
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/sql-pg": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/hosting": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@testcontainers/postgresql": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "get-port": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "implicitDependencies": [
            "@rasm/hooks"
        ],
        "targets": {
            "test--vitest": {
                "dependsOn": [
                    "...",
                    {
                        "projects": [
                            "@rasm/hooks"
                        ],
                        "target": "build--vite"
                    }
                ]
            }
        }
    }
}
