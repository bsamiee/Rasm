{
    "name": "@rasm/nx-pulumi",
    "version": "0.1.0",
    "description": "Nx plugin running Pulumi Automation API inline programs as install and deploy targets of the projects they host",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/pulumi"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./plugin.ts",
        "./stacks": "./executors/stacks.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@pulumi/pulumi": "catalog:",
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "@pulumi/pulumi": "catalog:peers",
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugin.js",
            "./stacks": "./dist/executors/stacks.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    },
    "executors": "./executors.json"
}
