{
    "manifestVersion": 5,
    "id": "app.rasm.atelier.indesign",
    "name": "Atelier InDesign",
    "version": "0.1.0",
    "main": "main.js",
    "host": { "app": "ID", "minVersion": "19.0.0", "data": { "loadEvent": "startup" } },
    "icons": [ { "width": 24, "height": 24, "path": "icons/plugin-light.svg", "scale": [ 1 ], "theme": [ "lightest", "light" ], "species": [ "pluginList" ] }, { "width": 24, "height": 24, "path": "icons/plugin-dark.svg", "scale": [ 1 ], "theme": [ "medium", "dark", "darkest" ], "species": [ "pluginList" ] } ],
    "entrypoints": [
        {
            "id": "typesetting",
            "label": { "default": "Typesetting" },
            "type": "panel",
            "icons": [
                { "width": 23, "height": 23, "path": "icons/typesetting-light.png", "scale": [ 1, 2 ], "theme": [ "lightest", "light" ], "species": [ "toolbar" ] },
                { "width": 23, "height": 23, "path": "icons/typesetting-dark.png", "scale": [ 1, 2 ], "theme": [ "medium", "dark", "darkest" ], "species": [ "toolbar" ] }
            ]
        }
    ],
    "requiredPermissions": { "localFileSystem": "fullAccess", "allowCodeGenerationFromStrings": true }
}
