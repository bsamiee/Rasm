{
    "cacheDirectory": ".cache/nx/cache",
    "maxCacheSize": "8GB",
    "neverConnectToCloud": true,
    "analytics": false,
    "useDaemonProcess": false,
    "plugins": [
        { "plugin": "@nx/dotnet", "options": { "clean": false, "pack": false, "publish": false, "run": false, "watch": false } },
        { "plugin": "@nx/js/typescript", "options": { "typecheck": { "targetName": "typecheck:tsc" } } },
        "@nx/vite/plugin",
        { "plugin": "@nx/vitest", "include": [ "*/**/vitest.config.ts" ], "options": { "testMode": "run" } },
        {
            "plugin": "@rasm/nx",
            "options": {
                "root": {
                    "typecheck:tsc": { "command": "tsc" },
                    "typecheck:swift": { "command": "swift build --disable-automatic-resolution --build-tests", "parallelism": false },
                    "typecheck:clippy": { "command": "cargo clippy --locked --workspace --lib --bins", "inputs": [ "rustWorkspace", "{workspaceRoot}/clippy.toml" ], "parallelism": false },
                    "typecheck:javac": { "command": "rm -rf .cache/javac && fd --hidden --extension java --exec-batch javac -Xlint:all,-path -Werror -d .cache/javac -cp \"$GHIDRA_CLASSPATH\"", "inputs": [ "ghidra" ], "outputs": [ "{workspaceRoot}/.cache/javac" ] },
                    "lint:dotnet-format": { "command": "hk check --glob='**/*' --step=dotnet-format", "inputs": [ "hk", "{workspaceRoot}/global.json", "{workspaceRoot}/**/.editorconfig", "{workspaceRoot}/**/*.cs" ] },
                    "lint:ruff": { "command": "hk check --glob='**/*' --step=ruff --step=ruff-format", "inputs": [ "hk", "{workspaceRoot}/**/*.{py,pyi,pyw,ipynb}", "{workspaceRoot}/**/{pyproject.toml,ruff.toml,.ruff.toml}", { "runtime": "ruff --version" } ] },
                    "lint:biome": {
                        "command": "hk check --glob='**/*' --step=biome",
                        "inputs": [ "hk", "{workspaceRoot}/.editorconfig", "{workspaceRoot}/{pnpm-workspace.yaml,pnpm-lock.yaml}", "{workspaceRoot}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,html,vue,svelte,astro,grit}", { "externalDependencies": [ "@biomejs/biome" ] } ]
                    },
                    "lint:rustfmt": { "command": "cargo fmt --check", "inputs": [ "rustWorkspace", "{workspaceRoot}/rustfmt.toml" ] },
                    "lint:dylint": {
                        "command": "DYLINT_MODULE_LAYOUT=\"$(fd --hidden --extension rs --type f --print0 | LC_ALL=C sort -z | git hash-object --stdin)\" cargo dylint --fail-on-no-libraries --all --workspace -- --locked --lib --bins",
                        "inputs": [ "rustWorkspace", { "runtime": "cargo dylint --version" } ],
                        "parallelism": false
                    },
                    "lint:swift-format": { "command": "hk check --glob='**/*' --step=swift-format", "inputs": [ "hk", "swiftFiles", "{workspaceRoot}/.swift-format", { "runtime": "xcrun swift-format --version" } ] },
                    "lint:swiftlint": { "command": "hk check --glob='**/*' --step=swiftlint", "inputs": [ "hk", "swiftFiles", "{workspaceRoot}/.swiftlint.yml", { "runtime": "swiftlint version" } ] },
                    "lint:periphery": { "command": "periphery scan --config .config/periphery.yml --index-store-path \"$SWIFTPM_BUILD_DIR/out\" --retain-public", "dependsOn": [ "typecheck:swift" ] },
                    "lint:nx": {
                        "command": "nx sync:check",
                        "inputs": [
                            "...",
                            "{workspaceRoot}/tools/nx/sync/*.json",
                            "typescript",
                            "{workspaceRoot}/{Package.swift,Xcode.xcconfig,Directory.Build.props,.swiftlint.yml,.config/mise.toml,.config/mise.lock,.config/hk.pkl,pyproject.toml,biome.json,.editorconfig,.vscode/settings.json,plugins/argus/.lsp.json,sgconfig.yml}",
                            "{workspaceRoot}/**/package.json",
                            "{workspaceRoot}/**/.openai/hosting.json",
                            "{workspaceRoot}/**/*.{ts,tsx}"
                        ]
                    },
                    "lint:xcprojformatter": { "command": "hk check --glob='**/*' --step=xcprojformatter", "inputs": [ "hk", "xcodeTools", "{workspaceRoot}/**/project.xcproj" ] },
                    "lint:plutil": { "command": "hk check --glob='**/*' --step=plutil", "inputs": [ "hk", "{workspaceRoot}/**/*.{plist,entitlements}" ] },
                    "lint:google-java-format": { "command": "hk check --glob='**/*' --step=google-java-format", "inputs": [ "hk", "javaFiles", { "runtime": "google-java-format --version" } ] },
                    "lint:pmd": {
                        "command": "fd --hidden --extension java --exec-batch pmd check --rulesets .config/pmd.xml --no-cache --aux-classpath \".cache/javac:$JAVA_HOME/lib/jrt-fs.jar:$GHIDRA_CLASSPATH\" --no-progress",
                        "dependsOn": [ "typecheck:javac" ],
                        "inputs": [ "ghidra", "{workspaceRoot}/.config/pmd.xml", { "runtime": "mise where github:pmd/pmd" }, { "dependentTasksOutputFiles": "**/*.class" } ]
                    },
                    "lint:tombi": { "command": "hk check --glob='**/*' --step=tombi --step=tombi-lint", "inputs": [ "hk", "{workspaceRoot}/**/*.toml", { "runtime": "tombi --version" } ] },
                    "lint:hk": { "command": "hk validate --deny-warnings", "inputs": [ "hk" ] },
                    "lint:yamllint": { "command": "hk check --glob='**/*' --step=yamllint", "inputs": [ "hk", "python", "{workspaceRoot}/**/*.{yml,yaml}", { "runtime": "yamllint --version" } ] },
                    "lint:jactionlint": {
                        "command": "hk check --glob='**/*' --step=jactionlint",
                        "inputs": [
                            "hk",
                            "{workspaceRoot}/.github/{jactionlint.{yml,yaml},dependabot.{yml,yaml},workflows/*.{yml,yaml},workflows/actions.lock}",
                            "{workspaceRoot}/**/action.{yml,yaml}",
                            "{workspaceRoot}/{.gitmodules,package.json,pnpm-workspace.yaml,pnpm-lock.yaml,pyproject.toml,uv.lock}",
                            { "externalDependencies": [] },
                            "shellcheck",
                            { "runtime": "jactionlint --version" },
                            { "runtime": "ruff --version" }
                        ]
                    },
                    "lint:shellcheck": { "command": "hk check --glob='**/*' --step=shellcheck", "inputs": [ "hk", "shellFiles", "shellcheck" ] },
                    "lint:shfmt": { "command": "hk check --glob='**/*' --step=shfmt", "inputs": [ "hk", "shellFiles", "{workspaceRoot}/**/.editorconfig", { "runtime": "shfmt --version" } ] },
                    "format": { "executor": "nx:run-commands", "options": { "commands": [ { "command": "nx sync", "forwardAllArgs": false }, "hk fix --glob='**/*'" ], "parallel": false }, "dependsOn": [ "format:dotnet-format", { "projects": [ "tag:language:dotnet" ], "target": "format" } ], "parallelism": false },
                    "format:dotnet-format": { "options": { "args": [ "--no-restore" ] }, "dependsOn": [ "restore" ] },
                    "check": { "inputs": [ "{workspaceRoot}/**/*" ] },
                    "upgrade": { "executor": "nx:run-commands", "options": { "commands": [ { "command": "nx sync", "forwardAllArgs": false }, "mise daemons restart" ], "parallel": false }, "dependsOn": [ "upgrade:*", { "projects": [ "tag:build:xcode" ], "target": "upgrade:xcode" } ], "parallelism": false },
                    "upgrade:dotnet": { "command": "dotnet run --no-restore --project eng/dotnet/Rasm.Upgrade --" },
                    "upgrade:python": { "executor": "nx:run-commands", "options": { "commands": [ "pixi update", "python -m eng.python.blender upgrade", "uv lock --upgrade", "pixi run --locked uv sync --locked" ], "parallel": false } },
                    "upgrade:typescript": {
                        "executor": "nx:run-commands",
                        "options": { "commands": [ "ncu --workspaces --target newest --upgrade --install never --reject @typescript/native", "node eng/typescript/upgrade/typescript.ts", "pnpm install", "playwright install --only-shell chromium" ], "parallel": false },
                        "parallelism": false
                    },
                    "upgrade:rust": { "executor": "nx:run-commands", "options": { "commands": [ "cargo upgrade --incompatible", "cargo update", "hk fix --step=tombi Cargo.toml" ], "parallel": false } },
                    "upgrade:swift": { "executor": "nx:run-commands", "options": { "commands": [ "node eng/typescript/upgrade/swift.ts", "swift package update" ], "parallel": false }, "dependsOn": [ { "projects": [ "grammars" ], "target": "grammar:swift" } ], "parallelism": false },
                    "upgrade:actions": { "command": "actions-up --yes --style preserve --min-age 0" },
                    "upgrade:docker": { "command": "colima update && mise daemons restart docker", "dependsOn": [ "docker" ] },
                    "release": { "command": "doppler run --no-fallback --attempts 1 -- node eng/typescript/release.ts", "parallelism": false },
                    "infra": {}
                }
            }
        }
    ],
    "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false, "projectsAffectedByDependencyUpdates": "auto" } },
    "sync": { "globalGenerators": [ "@rasm/nx:build-settings", "@rasm/nx:hosting-bindings" ] },
    "release": {
        "projectsRelationship": "independent",
        "releaseTag": { "pattern": "{releaseGroupName}-{projectName}-v{version}" },
        "version": { "conventionalCommits": true, "versionActions": "./tools/nx/release.ts", "fallbackCurrentVersionResolver": "disk" },
        "conventionalCommits": { "types": { "refactor": { "semverBump": "patch" }, "perf": { "semverBump": "patch" } } },
        "changelog": { "automaticFromRef": true, "projectChangelogs": { "file": false, "createRelease": "github", "entryWhenNoChanges": "{projectName} release with no new commits", "renderOptions": { "authors": false } }, "git": { "commit": false } },
        "groups": { "macos": { "projects": [ "tag:output:appcast" ] }, "rhino": { "projects": [ "tag:output:rhp" ] }, "blender": { "projects": [ "tag:output:extension" ] }, "web": { "projects": [ "tag:output:cloudflare" ] } }
    },
    "namedInputs": {
        "production": [ "{projectRoot}/**/*", "!{projectRoot}/.storybook/**/*" ],
        "dotnet": [
            "{workspaceRoot}/{global.json,NuGet.config,.editorconfig,.config/analyzers.globalconfig,Directory.Build.props,Directory.Build.rsp,Directory.Build.targets,Directory.Packages.props,Directory.Solution.props}",
            "{workspaceRoot}/eng/dotnet/rhino/*.{proj,css}",
            "{workspaceRoot}/tools/roslyn/**/*",
            { "externalDependencies": [] }
        ],
        "python": [ "{workspaceRoot}/**/pyproject.toml", "{workspaceRoot}/uv.lock", "{workspaceRoot}/pixi.lock", { "externalDependencies": [] }, { "runtime": "uv --version" }, { "runtime": "python --version" } ],
        "blender": [ "{workspaceRoot}/eng/python/blender/{__main__,host}.py", "{workspaceRoot}/libs/python/blender/{bpy/**/*.py,records/**/*.py,probe.py}", { "runtime": "ls -lL \"$BLENDER_PATH\"" }, { "env": "MACOSX_DEPLOYMENT_TARGET" } ],
        "version": [ { "runtime": "git rev-parse HEAD && git for-each-ref refs/tags" } ],
        "nodePlatform": [ { "runtime": "node -p \"[process.version, process.platform, process.arch].join('-')\"" } ],
        "typescript": [ "{workspaceRoot}/tsconfig.{base,web}.json", { "json": "{workspaceRoot}/package.json", "fields": [ "type" ] } ],
        "rust": [ "{workspaceRoot}/{Cargo.toml,Cargo.lock,rust-toolchain.toml,.cargo/config.toml}", { "externalDependencies": [] } ],
        "nextest": [ "{workspaceRoot}/.config/nextest.toml", { "runtime": "cargo nextest --version" } ],
        "swift": [ "{workspaceRoot}/{Package.swift,Package.resolved}", "xcodeTools" ],
        "xcodeTools": [ { "externalDependencies": [] }, { "runtime": "xcodebuild -version" } ],
        "periphery": [ "{workspaceRoot}/.config/periphery.{yml,json}", { "runtime": "periphery version" } ],
        "astGrep": [ "{workspaceRoot}/sgconfig.yml", "{workspaceRoot}/**/.{gitignore,ignore}", { "externalDependencies": [] }, { "dependentTasksOutputFiles": "**/*.so", "transitive": true }, { "runtime": "ast-grep --version" } ],
        "pythonFiles": [ "{workspaceRoot}/**/*.{py,pyi}" ],
        "rustWorkspace": [ "rust", "{workspaceRoot}/**/{*.rs,Cargo.toml}" ],
        "swiftFiles": [ "{workspaceRoot}/**/*.swift" ],
        "javaFiles": [ "{workspaceRoot}/**/*.java" ],
        "ghidra": [ "javaFiles", { "externalDependencies": [] }, { "env": "JAVA_HOME" }, { "env": "GHIDRA_INSTALL_DIR" }, { "env": "GHIDRA_CLASSPATH" } ],
        "hk": [ "{workspaceRoot}/.config/hk.pkl", "{workspaceRoot}/**/.{gitignore,ignore}", { "externalDependencies": [] }, { "runtime": "hk --version" } ],
        "shellFiles": [ "{workspaceRoot}/**/*.sh" ],
        "shellcheck": [ "{workspaceRoot}/.shellcheckrc", { "env": "SHELLCHECK_OPTS" }, { "runtime": "shellcheck --version" } ]
    },
    "targetDefaults": {
        "restore{,:*.cs}": { "command": "dotnet restore", "parallelism": false },
        "build{,:*}": [
            { "cache": true },
            { "filter": { "plugin": "@nx/dotnet" }, "dependsOn": [ "...", { "projects": [ "rasm" ], "target": "restore" } ] },
            { "filter": { "projects": [ "tag:language:dotnet" ] }, "cache": false },
            { "filter": { "projects": [ "tag:license:imagesharp" ] }, "command": "doppler run --no-fallback --attempts 1 -- dotnet build", "configurations": { "ci": { "command": "dotnet build" } } },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "{projectRoot}",
                    "commands": [
                        "version=$(minver -v e) && result=\"$NX_WORKSPACE_ROOT/.artifacts/xcode/build/{projectName}.xcresult\" && mkdir -p \"$(dirname \"$result\")\" && rm -rf \"$result\" && xcodebuild -project {projectName}.xcodeproj -scheme {projectName} -destination platform=macOS -derivedDataPath \"$NX_WORKSPACE_ROOT/$XCODE_DERIVED_DATA_PATH\" -disableAutomaticPackageResolution -skipMacroValidation -resultBundlePath \"$result\" build MARKETING_VERSION=\"${version%%-*}\" CURRENT_PROJECT_VERSION=\"$(git rev-list --count --first-parent HEAD)\" COPYRIGHT_YEAR=\" $(git log -1 --format=%cd --date=format:%Y)\" {args}",
                        { "command": "if [ \"${CI:-}\" != true ]; then xcode-build-server config -project {projectName}.xcodeproj -scheme {projectName} --build_root \"$NX_WORKSPACE_ROOT/$XCODE_DERIVED_DATA_PATH\"; fi", "forwardAllArgs": false }
                    ],
                    "parallel": false
                },
                "configurations": { "ci": { "args": [ "CODE_SIGN_STYLE=Manual", "CODE_SIGN_IDENTITY=-", "DEVELOPMENT_TEAM=" ] } },
                "cache": false
            },
            { "filter": { "projects": [ "tag:build:swiftpm" ] }, "dependsOn": [ { "projects": [ "rasm" ], "target": "typecheck:swift" } ] },
            { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo build --locked --package {projectName}", "cache": false, "parallelism": false },
            { "filter": { "plugin": "@nx/vite/plugin" }, "options": { "args": [ "--configLoader", "native" ] }, "inputs": [ "...", "typescript", "nodePlatform" ] },
            { "filter": { "projects": [ "tag:output:cloudflare" ] }, "outputs": [ "...", "{projectRoot}/.cloudflare/output", "{workspaceRoot}/.artifacts/{projectRoot}" ] },
            {
                "filter": { "projects": [ "tag:host:uxp" ] },
                "inputs": [ "...", "{workspaceRoot}/apps/creative-cloud/atelier/macos/Resources/AppIcon.icon/Assets/*.svg", { "env": "LINK_PORT" }, { "runtime": "resvg --version" }, { "runtime": "usvg --version" }, "version" ],
                "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ]
            },
            { "filter": { "projects": [ "tag:host:cep" ] }, "inputs": [ "...", { "env": "LINK_PORT" }, "version" ], "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ] }
        ],
        "assets": [
            {
                "command": "python -m eng.python.blender assets {projectRoot} .artifacts/blender/{projectName}/assets",
                "inputs": [ "{projectRoot}/icons/**/*.svg", "{projectRoot}/**/*.xml", "{projectRoot}/pyproject.toml", "python", "blender", "{workspaceRoot}/eng/python/blender/{assets,icons,theme}.py" ],
                "outputs": [ "{workspaceRoot}/.artifacts/blender/{projectName}/assets" ],
                "cache": true
            }
        ],
        "pack": [
            { "filter": { "projects": [ "tag:output:rhp" ] }, "command": "dotnet publish --no-build --configuration Release", "options": { "cwd": "{projectRoot}" }, "dependsOn": [ "build:release" ] },
            {
                "filter": { "projects": [ "tag:output:extension" ] },
                "command": "version=$(minver -v e) && python -m eng.python.blender pack {projectRoot} .artifacts/blender/{projectName} --version \"$version\"",
                "dependsOn": [ "assets" ],
                "inputs": [ "default", "^default", "python", "blender", "{workspaceRoot}/eng/python/blender/{assembly,assets}.py", "{workspaceRoot}/libs/python/blender/**/*", { "dependentTasksOutputFiles": "**/*" }, { "json": "{workspaceRoot}/package.json", "fields": [ "author", "license" ] }, "version" ],
                "outputs": [ "{workspaceRoot}/.artifacts/blender/{projectName}/archives" ],
                "cache": true
            },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "options": {
                    "commands": [
                        "rm -rf \".artifacts/xcode/{projectRoot}\"",
                        "version=$(minver -v e) && xcodebuild archive -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -configuration Release -destination generic/platform=macOS -derivedDataPath \"$XCODE_DERIVED_DATA_PATH\" -archivePath \".artifacts/xcode/{projectRoot}/{projectName}.xcarchive\" -disableAutomaticPackageResolution -skipMacroValidation MARKETING_VERSION=\"${version%%-*}\" CURRENT_PROJECT_VERSION=\"$(git rev-list --count --first-parent HEAD)\" COPYRIGHT_YEAR=\" $(git log -1 --format=%cd --date=format:%Y)\"",
                        "ditto -c -k --sequesterRsrc --keepParent \".artifacts/xcode/{projectRoot}/{projectName}.xcarchive/Products/Applications/{projectName}.app\" \".artifacts/xcode/{projectRoot}/{projectName}.zip\" && ditto -c -k --keepParent \".artifacts/xcode/{projectRoot}/{projectName}.xcarchive/dSYMs\" \".artifacts/xcode/{projectRoot}/{projectName}.dSYMs.zip\" && rm -rf \".artifacts/xcode/{projectRoot}/{projectName}.xcarchive\""
                    ],
                    "parallel": false
                },
                "outputs": [ "{workspaceRoot}/.artifacts/xcode/{projectRoot}" ],
                "parallelism": false
            },
            { "filter": { "projects": [ "tag:host:uxp" ] }, "command": "cmake -E chdir .artifacts/{projectRoot} cmake -E tar cf \"$NX_WORKSPACE_ROOT/.artifacts/{projectRoot}.ccx\" --format=zip .", "dependsOn": [ "build" ], "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}.ccx" ] },
            {
                "filter": { "projects": [ "tag:host:cep" ] },
                "command": "doppler run --no-fallback --attempts 1 --command 'certificate=$(mktemp) && trap \"rm -f \\\"$certificate\\\"\" EXIT && printf %s \"$ZXP_CERTIFICATE\" | base64 -d > \"$certificate\" && rm -f .artifacts/{projectRoot}.zxp && ZXPSignCmd -sign .artifacts/{projectRoot} .artifacts/{projectRoot}.zxp \"$certificate\" \"$ZXP_CERTIFICATE_PASSWORD\" -tsa http://timestamp.digicert.com && ZXPSignCmd -verify .artifacts/{projectRoot}.zxp -certInfo'",
                "dependsOn": [ "build" ],
                "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}.zxp" ]
            },
            { "filter": { "projects": [ "tag:output:sea" ] }, "inputs": [ "...", "production", "^production", "typescript", "nodePlatform" ] }
        ],
        "pack:windows": { "command": "dotnet publish --no-build --configuration Release", "options": { "cwd": "{projectRoot}" }, "dependsOn": [ "build:windows" ], "parallelism": false },
        "install": [
            { "parallelism": false },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "command": "app=\"/Applications/{projectName}.app\" && agents=\"$app/Contents/Library/LaunchAgents\" && watch-apps quit \"$app\" && if [ -d \"$agents\" ]; then for plist in \"$agents\"/*.plist; do launchctl bootout \"gui/$(id -u)/$(plutil -extract Label raw \"$plist\")\" || [ $? -eq 3 ]; done; fi && rm -rf \"$app\" && ditto -x -k .artifacts/xcode/{projectRoot}/{projectName}.zip /Applications && if [ -d \"$agents\" ]; then executable=$(plutil -extract CFBundleExecutable raw \"$app/Contents/Info.plist\") && \"$app/Contents/MacOS/$executable\" </dev/null; else watch-apps launch \"$app\" --new; fi",
                "dependsOn": [ "...", "pack" ]
            },
            { "filter": { "projects": [ "tag:output:rhp" ] }, "command": "dotnet msbuild -target:InstallYakPackage -property:Configuration=Release", "options": { "cwd": "{projectRoot}" }, "dependsOn": [ "pack" ] },
            { "filter": { "projects": [ "tag:output:extension" ] }, "command": "python -m eng.python.blender install .artifacts/blender/{projectName}/archives", "dependsOn": [ "pack" ] },
            {
                "filter": { "projects": [ "tag:output:command" ] },
                "command": "uv export --frozen --no-hashes --no-emit-local --no-default-groups --quiet --output-file .artifacts/python/{projectName}.constraints.txt && uv tool install --python \"$(mise which python)\" --constraints .artifacts/python/{projectName}.constraints.txt --editable {projectRoot}"
            },
            { "filter": { "projects": [ "tag:host:uxp", "tag:host:cep" ] }, "command": "node eng/typescript/install-adobe-plugins.ts .artifacts/{projectRoot}", "dependsOn": [ "pack" ] },
            {
                "filter": { "projects": [ "tag:language:rust" ] },
                "executor": "nx:run-commands",
                "options": { "commands": [ { "command": "RASM_VERSION=\"$(git describe --always --dirty --exclude '*')\" cargo \"+$(rustc --print sysroot)\" install --locked --profile dist --path {projectRoot}", "forwardAllArgs": false }, "mise daemons restart" ], "parallel": false }
            },
            {
                "filter": { "projects": [ "tag:build:swiftpm" ] },
                "command": "export SWIFTPM_BUILD_DIR=\"$SWIFTPM_BUILD_DIR/install\" && swift build --disable-automatic-resolution -c release --product {projectName} && mkdir -p \"$XDG_CONFIG_HOME/swiftpm/bin\" && install -C -m 755 \"$SWIFTPM_BUILD_DIR/release/{projectName}\" \"$XDG_CONFIG_HOME/swiftpm/bin\""
            }
        ],
        "publish": [
            { "parallelism": false },
            {
                "filter": { "projects": [ "tag:output:rhp" ] },
                "command": "doppler run --no-fallback --attempts 1 --command 'tag=$(git describe --tags --exact-match --match \"$MinVerTagPrefix*\") && gh release upload \"$tag\" \"$NX_WORKSPACE_ROOT\"/.artifacts/dotnet/yak/{projectName}/*.yak --clobber && dotnet msbuild -target:PushYakPackage -property:Configuration=Release'",
                "options": { "cwd": "{projectRoot}" },
                "dependsOn": [ "pack", "pack:windows" ]
            },
            {
                "filter": { "projects": [ "tag:output:appcast" ] },
                "command": "doppler run --no-fallback --attempts 1 --command 'tag=$(git describe --tags --exact-match --match \"$MinVerTagPrefix*\") && feed=.artifacts/xcode/{projectRoot}/appcast && archive=\"$feed/{projectName}-$(git rev-list --count --first-parent HEAD)\" && mkdir -p \"$feed\" && gh release upload \"$tag\" .artifacts/xcode/{projectRoot}/{projectName}.zip .artifacts/xcode/{projectRoot}/{projectName}.dSYMs.zip $(fd --no-ignore --extension ccx --extension zxp . .artifacts/$(dirname {projectRoot})) --clobber && assets=$(gh release view {projectName}-updates --json assets --jq \".assets[].name\") && printf %s \"$assets\" | xargs -I % gh release download {projectName}-updates --dir \"$feed\" --pattern % && cp .artifacts/xcode/{projectRoot}/{projectName}.zip \"$archive.zip\" && gh release view \"$tag\" --json body --jq .body > \"$archive.md\" && printf %s \"$SPARKLE_ED_PRIVATE_KEY\" | \"$XCODE_DERIVED_DATA_PATH/SourcePackages/artifacts/sparkle/Sparkle/bin/generate_appcast\" --ed-key-file - \"$feed\" && fd --no-ignore --max-depth 1 --type f . \"$feed\" --exec-batch gh release upload {projectName}-updates --clobber && fd --no-ignore --type f --full-path /old_updates/ \"$feed\" --exec gh release delete-asset {projectName}-updates {/} --yes'",
                "dependsOn": [ "...", "pack" ]
            },
            {
                "filter": { "projects": [ "tag:output:extension" ] },
                "command": "doppler run --no-fallback --attempts 1 --command 'tag=$(git describe --tags --exact-match --match \"$MinVerTagPrefix*\") && archives=.artifacts/blender/{projectName}/archives && trap \"rm -f \\\"$archives/index.json\\\" \\\"$archives/index.html\\\"\" EXIT && \"$BLENDER_PATH\" --factory-startup --command extension server-generate --repo-dir \"$archives\" --html && gh release upload \"$tag\" \"$archives\"/*.zip --clobber && gh release upload {projectName}-updates \"$archives\"/*.zip \"$archives/index.json\" \"$archives/index.html\" --clobber'",
                "dependsOn": [ "pack" ]
            },
            { "filter": { "projects": [ "tag:output:cloudflare" ] }, "command": "doppler run --no-fallback --attempts 1 -- node infra/main.ts {projectRoot} --apply" }
        ],
        "infra": { "command": "doppler run --no-fallback --attempts 1 -- node infra/main.ts {projectRoot}", "parallelism": false },
        "types": { "command": "cf workers types", "options": { "cwd": "{projectRoot}" }, "inputs": [ "default", "^production", { "externalDependencies": [ "cf" ] } ], "outputs": [ "{projectRoot}/.cloudflare/types" ], "cache": true },
        "typecheck:*": { "cache": true },
        "typecheck:swift": { "cache": false },
        "typecheck:tsc": [
            {
                "options": { "args": [ "--pretty", "false", "--incremental", "--tsBuildInfoFile", "\"$NX_WORKSPACE_ROOT/.cache/tsc/{projectName}/tsconfig.tsbuildinfo\"" ] },
                "inputs": [ "default", "^production", "typescript", { "externalDependencies": [ "@effect/tsgo", "@typescript/native" ] }, { "dependentTasksOutputFiles": "**/*.d.ts" }, { "fileset": "{projectRoot}/.claude-plugin/types/**/*.d.ts", "includeIgnored": true } ]
            },
            { "filter": { "projects": [ "directory:." ] }, "cache": true, "inputs": [ "typescript", "{workspaceRoot}/tsconfig.json", "{workspaceRoot}/**/package.json", "{workspaceRoot}/**/*.{ts,tsx}", { "externalDependencies": [ "@effect/tsgo", "@typescript/native" ] } ] }
        ],
        "typecheck:claude": {
            "command": "tsc --pretty false -p {projectRoot}/tsconfig.claude.json",
            "inputs": [ "typescript", "{projectRoot}/**/*.ts", "{projectRoot}/tsconfig*.json", { "fileset": "{projectRoot}/.claude-plugin/types/**/*.d.ts", "includeIgnored": true }, { "externalDependencies": [ "@effect/tsgo", "@typescript/native" ] } ],
            "cache": true
        },
        "lint:*": { "cache": true },
        "lint:claude": { "command": "claude plugin validate {projectRoot}", "inputs": [ "{projectRoot}/**/*", { "externalDependencies": [] }, { "runtime": "claude --version" } ], "cache": true },
        "lint:periphery": [
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "command": "periphery scan --config .config/periphery.yml --index-store-path \"$XCODE_DERIVED_DATA_PATH/Index.noindex/DataStore\" --report-include '{projectRoot}/**'",
                "dependsOn": [ "build" ],
                "inputs": [ "default", "^default", "swift", "{workspaceRoot}/Xcode.xcconfig", "periphery" ],
                "cache": true
            }
        ],
        "format:*": { "parallelism": false },
        "format:{dotnet-format,*.cs}": { "command": "dotnet format --binarylog .artifacts/dotnet/binlog/{projectName}/format.binlog", "dependsOn": [ "...", { "projects": [ "Rasm.Analyzers.CodeFixes" ], "target": "build" } ], "parallelism": false },
        "test": [
            { "cache": true },
            {
                "filter": { "projects": [ "tag:language:dotnet" ] },
                "options": { "command": "dotnet test --report-trx" },
                "inputs": [ "production", "^production", "dotnet", { "env": "DOTNET_ROLL_FORWARD" }, { "env": "DOTNET_ROLL_FORWARD_TO_PRERELEASE" }, { "runtime": "dotnet --list-runtimes" } ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/test/{projectName}" ]
            },
            { "filter": { "projects": [ "tag:language:python" ] }, "inputs": [ "...", "default", "^default", "python" ] },
            { "filter": { "plugin": "@nx/vitest" }, "inputs": [ "...", "nodePlatform", { "externalDependencies": [ "@vitest/browser-playwright", "playwright", "@storybook/addon-vitest" ] } ], "outputs": [ "{workspaceRoot}/.artifacts/typescript/vitest/{projectRoot}/vitest.config" ] },
            { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo nextest run --locked --package {projectName}", "inputs": [ "default", "^default", "rust", "nextest" ], "parallelism": false },
            { "filter": { "projects": [ "tag:host:dylint" ] }, "inputs": [ "...", { "runtime": "cargo dylint --version" } ] },
            {
                "filter": { "projects": [ "tag:build:swiftpm" ] },
                "command": "rm -rf .artifacts/swift/test/{projectName} && mkdir -p .artifacts/swift/test/{projectName} && swift test --disable-index-store --disable-xctest --disable-automatic-resolution --attachments-path .artifacts/swift/test/{projectName} --event-stream-output-path .artifacts/swift/test/{projectName}/events.jsonl",
                "inputs": [ "...", "default", "^default", "swift" ],
                "outputs": [ "{workspaceRoot}/.artifacts/swift/test/{projectName}" ],
                "parallelism": false
            }
        ],
        "test:integration": [
            { "filter": { "projects": [ "tag:language:typescript" ] }, "inputs": [ "default", "^production", "typescript", "nodePlatform", { "env": "CI" }, { "externalDependencies": [ "vitest" ] } ], "dependsOn": [ { "projects": [ "rasm" ], "target": "docker" } ], "parallelism": false },
            { "filter": { "projects": [ "@rasm/test-database" ] }, "inputs": [ "...", "{workspaceRoot}/.config/squawk.toml", { "runtime": "squawk --version" } ] },
            {
                "filter": { "projects": [ "tag:build:swiftpm" ] },
                "command": "rm -rf .artifacts/swift/test-integration/{projectName} && mkdir -p .artifacts/swift/test-integration/{projectName} && swift test --disable-index-store --disable-xctest --disable-automatic-resolution --attachments-path .artifacts/swift/test-integration/{projectName} --event-stream-output-path .artifacts/swift/test-integration/{projectName}/events.jsonl",
                "inputs": [ "...", "default", "^default", "swift" ],
                "outputs": [ "{workspaceRoot}/.artifacts/swift/test-integration/{projectName}" ],
                "parallelism": false
            }
        ],
        "check": [
            { "dependsOn": [ "...", "typecheck:*", "lint:*" ] },
            { "filter": { "projects": [ "tag:language:dotnet" ] }, "dependsOn": [ "...", { "target": "build", "params": "forward" } ], "inputs": [ "default", "^default", "dotnet", "{workspaceRoot}/Workspace.slnx" ] },
            { "filter": { "projects": [ "tag:platform:windows" ] }, "dependsOn": [ "...", "build:windows" ] },
            { "filter": { "projects": [ "tag:language:swift" ] }, "inputs": [ "...", "default", "^default", "swift" ] },
            { "filter": { "projects": [ "tag:build:xcode" ] }, "inputs": [ "...", "{workspaceRoot}/Xcode.xcconfig", "periphery" ] },
            { "filter": { "projects": [ "tag:bundler:vite" ] }, "dependsOn": [ "...", "build" ] }
        ],
        "upgrade:xcode": { "command": "xcodebuild -resolvePackageDependencies -project \"{projectRoot}/{projectName}.xcodeproj\" -scheme {projectName} -derivedDataPath \"$XCODE_DERIVED_DATA_PATH\"", "dependsOn": [ { "projects": [ "rasm" ], "target": "upgrade:swift" } ] }
    }
}
