{
    "name": "@rasm/claude-code",
    "private": true,
    "description": "Claude Code mods as Effect programs: hooks, declared tools, and agents hosted over platform services and an Engine service built on the engine's own calls, with band rows, notices, model messages, panes, placed rows, the Bash tool's shell, a store over the plugin store, and policy enforcement composed with a mod's own hooks",
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./engine": "./engine/interface.ts",
        "./events": "./engine/events.ts",
        "./ledger": "./engine/ledger.ts",
        "./host": "./engine/host.ts",
        "./skills": "./engine/skills.ts",
        "./bash": "./engine/bash.ts",
        "./enforcement": "./engine/enforcement.ts",
        "./ask": "./ui/ask.ts",
        "./draft": "./ui/draft.ts",
        "./element": "./ui/element.ts",
        "./pane": "./ui/pane.ts",
        "./placed": "./ui/placed.ts",
        "./render": "./ui/render.ts",
        "./theme": "./ui/theme.ts",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@rasm/policy": "workspace:*",
        "@rasm/report": "workspace:*",
        "@rasm/shell": "workspace:*",
        "sh-syntax": "catalog:"
    },
    "devDependencies": {
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "nx": {
        "tags": [
            "host:claude-code"
        ]
    }
}
