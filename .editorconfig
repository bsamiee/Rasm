roslynator_array_creation_type_style = explicit                               # RCS1014: explicit element type.
roslynator_empty_string_style = literal                                       # RCS1078: "" is a constant.
roslynator_enum_flag_value_style = shift_operator                             # RCS1254: 1 << n.
roslynator_infinite_loop_style = while                                        # RCS1252: while (true).
roslynator_doc_comment_summary_style = single_line                            # RCS1253: dense summaries.
roslynator_object_creation_parentheses_style = omit                           # RCS1050: new T { } before an initializer.

# --- [IDE_QUALITY_RULES] ----------------------------------------------------
# Roslyn IDE rules without dedicated style preference keys. Most ship at silent severity by default and are invisible to `dotnet format --severity warn`.
dotnet_diagnostic.IDE0004.severity = error                                    # Remove unnecessary cast expressions.
dotnet_diagnostic.IDE0005.severity = error                                    # Remove unnecessary using directives.
dotnet_diagnostic.IDE0035.severity = error                                    # Remove unreachable code.
dotnet_diagnostic.IDE0051.severity = error                                    # Remove unused private members.
dotnet_diagnostic.IDE0052.severity = error                                    # Remove private members that are written but never read.
dotnet_diagnostic.IDE0060.severity = error                                    # Remove unused parameters; each parameter must affect the operation.
dotnet_diagnostic.IDE0064.severity = error                                    # Make struct fields writable when reassignment is intended.
dotnet_diagnostic.IDE0070.severity = error                                    # Use System.HashCode.Combine for composite hash codes.
dotnet_diagnostic.IDE0076.severity = error                                    # Remove invalid SuppressMessage attribute targets.
dotnet_diagnostic.IDE0077.severity = error                                    # Avoid legacy SuppressMessage target format strings.
dotnet_diagnostic.IDE0079.severity = error                                    # Remove stale suppression attributes/pragmas.
dotnet_diagnostic.IDE0080.severity = error                                    # Remove unnecessary null-suppression (!) operator.
dotnet_diagnostic.IDE0082.severity = error                                    # Prefer nameof over typeof(T).Name.
dotnet_diagnostic.IDE0100.severity = error                                    # Remove redundant equality (x == true → x).
dotnet_diagnostic.IDE0110.severity = error                                    # Remove unnecessary discard pattern arms.
dotnet_diagnostic.IDE0120.severity = error                                    # Simplify chained LINQ expressions.
dotnet_diagnostic.IDE0121.severity = error                                    # Simplify LINQ type check and cast (.OfType<T>()).
dotnet_diagnostic.IDE0220.severity = error                                    # Add explicit cast in foreach loops over non-generic IEnumerable.
dotnet_diagnostic.IDE0240.severity = error                                    # Remove redundant #nullable directives.
dotnet_diagnostic.IDE0241.severity = error                                    # Remove unnecessary #nullable directives.
dotnet_diagnostic.IDE0280.severity = error                                    # Use nameof in attribute arguments where applicable.
dotnet_diagnostic.IDE0330.severity = error                                    # Prefer System.Threading.Lock over object-based locking.
dotnet_diagnostic.IDE0340.severity = error                                    # Use unbound generic types in nameof for generic type names.
dotnet_diagnostic.IDE0360.severity = error                                    # Simplify property accessors to expression-bodied form when trivial.
dotnet_diagnostic.IDE0380.severity = error                                    # Remove unnecessary unsafe modifiers.
dotnet_diagnostic.IDE1005.severity = error                                    # Prefer null-conditional delegate invocation (?.Invoke).

# --- [MAPPERLY_ANALYZERS] ----------------------------------------------------
# Riok.Mapperly ships no separate analyzer; the source generator reports every RMG rule, and none ship disabled.
# Error- and Warning-default rules already error under TreatWarningsAsErrors, so only the Info- and Hidden-default rules earn a row.
dotnet_diagnostic.RMG009.severity = error                                     # Cannot map to a read-only target member; the member is dropped without a diagnostic at any lower severity.
dotnet_diagnostic.RMG010.severity = error                                     # Cannot map from a write-only source member; the value never reaches the target.
dotnet_diagnostic.RMG011.severity = error                                     # Cannot map to a write-only member path; the nested write is dropped.
dotnet_diagnostic.RMG015.severity = error                                     # Cannot map to an init-only member path; the nested value never reaches the constructed target.
dotnet_diagnostic.RMG033.severity = error                                     # Same-type member copied by reference under UseDeepCloning; the clone would share mutable state.
dotnet_diagnostic.RMG083.severity = error                                     # Cannot map to a read-only type; the member is skipped and no other rule reports it.
dotnet_diagnostic.RMG088.severity = error                                     # The naming attribute that spells an enum member is missing; the emitted name is not the domain name.
dotnet_diagnostic.RMG089.severity = error                                     # Nullable source member assigned to a non-nullable target member; MapProperty.SuppressNullMismatchDiagnostic is the per-member escape.
dotnet_diagnostic.RMG090.severity = error                                     # Nullable source type assigned to a non-nullable target type; the null becomes a default or throws.
dotnet_diagnostic.RMG096.severity = error                                     # Hidden by default: an ignored member states no Justification. Raising it above hidden is the documented way to require one.

# --- [THINKTECTURE_ANALYZERS] -----------------------------------------------
# Every TTRESG rule ships enabled at an Error or Warning default and already fails the build; only the Info-default rule earns a row.
dotnet_diagnostic.TTRESG1001.severity = error                                 # Prefer static lambdas in Switch/Map arms; thread captured state through the state parameter.

# --- [GENERATOR_EQUALS_ANALYZERS] --------------------------------------------
# The analyzer ships inside the generator package; Error- and Warning-default GE rules already fail the build, so only the Info-default rules earn a row.
dotnet_diagnostic.GE002.severity = error                                      # A complex member type without [Equatable] falls back to reference equality inside the generated comparer.
dotnet_diagnostic.GE003.severity = error                                      # A complex collection element type without [Equatable] compares by reference; element state never enters the comparison.

# --- [ERRORPRONE_ANALYZERS] --------------------------------------------------
# Warning-default rules (EPC11-13, EPC16-18, EPC20, EPC23-26, EPC30-31, EPC34, EPC41, ERP021-022, ERP031, ERP042) already error under TreatWarningsAsErrors; only Info-default and disabled rules earn a row.
dotnet_diagnostic.EPC15.severity = error                                      # Require ConfigureAwait(false) in assemblies marked with UseConfigureAwaitFalse; no assembly currently declares that attribute. EPC14 remains informational.
dotnet_diagnostic.EPC19.severity = error                                      # CancellationTokenRegistration must be observed and disposed; an unobserved registration on a long-lived token pins the callback and its captures.
dotnet_diagnostic.EPC27.severity = error                                      # async void method declaration; EPC17 covers the delegate form at default warning severity.
dotnet_diagnostic.EPC28.severity = error                                      # [ExcludeFromCodeCoverage] on a partial class splits coverage across the parts.
dotnet_diagnostic.EPC29.severity = error                                      # Require a reason for ExcludeFromCodeCoverage. The .artifacts override below covers generated test entry points.
dotnet_diagnostic.EPC32.severity = error                                      # TaskCompletionSource without TaskCreationOptions.RunContinuationsAsynchronously runs continuations inline on the completing thread.
dotnet_diagnostic.EPC33.severity = error                                      # Thread.Sleep inside an async method; Task.Delay is the awaited form.
dotnet_diagnostic.EPC35.severity = error                                      # Blocking on a task inside an async method: .Result, .Wait(), .GetAwaiter().GetResult().
dotnet_diagnostic.EPC36.severity = error                                      # Async delegate under TaskCreationOptions.LongRunning abandons the dedicated thread at its first await.
dotnet_diagnostic.EPC37.severity = error                                      # Argument validation inside an async method throws at await time, never at the call.
dotnet_diagnostic.ERP041.severity = error                                     # EventSource subclass must be sealed; ERP042 covers the wider EventSource pattern at default warning severity.
dotnet_diagnostic.EPC38.severity = error                                      # Shipped disabled: IEnumerable<Task> enumerated twice starts a second, unrelated set of tasks.
dotnet_diagnostic.EPC39.severity = error                                      # Shipped disabled: one enumerable re-iterated inside a loop.
dotnet_diagnostic.EPC40.severity = error                                      # Shipped disabled: a private method re-enumerating an IEnumerable<T> parameter a caller passes as a deferred query.

# --- [WORKSPACE_SEVERITY_FLOOR] ---------------------------------------------
# Rule severity lives here alone; RASM0002 rejects NoWarn and WarningsNotAsErrors in project files. Root targets hold the IKVM exemptions that analyzer configuration cannot express.
dotnet_diagnostic.CS1591.severity = none                                      # GenerateDocumentationFile ships the XML for tooling; member-level doc prose is not required.
dotnet_diagnostic.CA2225.severity = none                                      # LanguageExt and Thinktecture operators are the public API; named alternatives would duplicate it.

[{libs/dotnet/Rasm,libs/dotnet/Rasm.Rhino,libs/dotnet/Rasm.Grasshopper}/**.cs]
dotnet_diagnostic.CA1416.severity = none                                      # Rhino's bundled System.Drawing.Common implements the Windows-annotated members on macOS; CA1416 reads the NuGet reference assembly, not the host runtime.

[{libs/dotnet/Rasm.Rhino,libs/dotnet/Rasm.Grasshopper}/**.cs]
dotnet_diagnostic.CA1724.severity = none                                      # Microsoft.macOS exposes a Phase namespace colliding with the canonical ComponentUi.Phase enum.

[libs/dotnet/Rasm.AppHost/**.cs]
dotnet_diagnostic.EXTEXP0002.severity = none                                  # Compliance redaction rows (HmacRedactor): experimental-API opt-in.
dotnet_diagnostic.EXTEXP0008.severity = none                                  # Opt in to the experimental resource-monitoring API.

[.artifacts/**.cs]
dotnet_diagnostic.EPC29.severity = none                                       # xunit.v3.msbuildtasks and Microsoft.Testing.Platform.MSBuild generate ExcludeFromCodeCoverage attributes without messages in this directory.

[tests/**/*.cs]
dotnet_diagnostic.VSTHRD111.severity = none                                   # xunit.analyzers suppresses CA2007 in test methods and xUnit1030 forbids ConfigureAwait(false), so VSTHRD111 must not reintroduce the requirement.
dotnet_diagnostic.CA1515.severity = none                                      # xUnit discovery requires public test classes; spec-local generators stay non-public.
dotnet_diagnostic.MA0191.severity = none                                      # Adversarial null-payload tests intentionally use null-forgiving to enter non-nullable production boundaries.

# --- [XUNIT_ANALYZERS] -------------------------------------------------------
# xunit.v3.core includes xunit.analyzers; the rows below promote its informational and hidden rules, while every other xUnit rule already reports an error.
dotnet_diagnostic.xUnit1004.severity = error                                  # Disallow skipped tests; repair the test or remove it only when its behavior is retired or its oracle is invalid.
dotnet_diagnostic.xUnit1033.severity = error                                  # A fixture the class declares but never accepts through its constructor.
dotnet_diagnostic.xUnit1042.severity = error                                  # MemberData over an untyped source; TheoryData<T> types the rows.
dotnet_diagnostic.xUnit1044.severity = error                                  # Theory data that cannot be serialized loses per-row discovery.
dotnet_diagnostic.xUnit1045.severity = error                                  # Theory data whose serializability cannot be proven.
dotnet_diagnostic.xUnit1046.severity = error                                  # TheoryDataRow over an unserializable type.
dotnet_diagnostic.xUnit1047.severity = error                                  # TheoryDataRow whose serializability cannot be proven.
dotnet_diagnostic.xUnit1050.severity = error                                  # Untyped theory data source; the row types are the contract.
dotnet_diagnostic.xUnit2001.severity = error                                  # Hidden default: Assert.Equals over an invalid pair.
dotnet_diagnostic.xUnit2022.severity = error                                  # Boolean assertion over a value that is already a boolean literal.
dotnet_diagnostic.xUnit2023.severity = error                                  # Assert.Collection with one element; Assert.Single reads it.
dotnet_diagnostic.xUnit2024.severity = error                                  # Boolean assertion over a Contains/Any; the collection assertion reads it.
dotnet_diagnostic.xUnit2025.severity = error                                  # Boolean assertion whose value is a constant.
dotnet_diagnostic.xUnit2032.severity = error                                  # Type assertion through IsType where IsAssignableFrom is meant, or the reverse.
dotnet_diagnostic.xUnit2033.severity = error                                  # Info in the shipped binary: Assert.Empty/NotEmpty over a count.

# --- [VERIFY_SNAPSHOTS] ------------------------------------------------------
# VerifyChecks matches this section literal verbatim; keep the brace syntax expected by the tool.
[*.{received,verified}.{txt}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false

[*.{sh,bash}]
switch_case_indent = true
