<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org is the only restore/audit source; repo-local clears block user-level source drift and lock-file contentHash pins package payloads. -->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <!-- The universal pattern binds every id to the single feed; a second feed must then carve explicit patterns or fail NU1100, closing the dependency-confusion path before it opens. -->
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
    <auditSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </auditSources>
</configuration>
