<Project>
    <PropertyGroup Label="Test Coverage" Condition="'$(IsTestingPlatformApplication)' == 'true'">
        <IsTestProject>true</IsTestProject>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <_TestResultsDirectory>$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)', 'coverage', '$(MSBuildProjectName)'))</_TestResultsDirectory>
        <TestingPlatformCommandLineArguments>--coverlet --coverlet-include "[Rasm.*]*" --coverlet-output-format cobertura --results-directory "$(_TestResultsDirectory)"</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <ItemGroup Label="Nested Projects">
        <_NestedProject Include="*/**/*.csproj" />
        <Compile Remove="@(_NestedProject->'%(RelativeDir)**')" />
        <EmbeddedResource Remove="@(_NestedProject->'%(RelativeDir)**')" />
        <None Remove="@(_NestedProject->'%(RelativeDir)**')" />
        <Content Remove="@(_NestedProject->'%(RelativeDir)**')" />
    </ItemGroup>

    <ItemGroup Label="Project Usings">
        <Using Include="System.Collections.Frozen;System.Collections.Immutable" />
        <Using Include="Thinktecture" Condition="'@(PackageReference->WithMetadataValue('Identity', 'Thinktecture.Runtime.Extensions'))' != ''" />
        <Using Include="LanguageExt;LanguageExt.Common;LanguageExt.Traits;LanguageExt.UnsafeValueAccess" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Core'))' != ''" />
        <Using Include="LanguageExt.Prelude" Static="true" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Core'))' != ''" />
        <Using Include="LanguageExt.Pipes" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Streaming'))' != ''" />
        <Using Include="LanguageExt.Sys;LanguageExt.Sys.IO;LanguageExt.Sys.Traits;LanguageExt.Sys.Diag" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Sys'))' != ''" />
        <Using Include="LanguageExt.Parsec" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Parsec'))' != ''" />
        <Using Include="NodaTime;NodaTime.Extensions" Condition="'@(PackageReference->WithMetadataValue('Identity', 'NodaTime'))' != ''" />
        <Using Include="NodaTime.Duration" Alias="Duration" Condition="'@(PackageReference->WithMetadataValue('Identity', 'NodaTime'))' != ''" />
        <Using Include="UnitsNet.Length" Alias="Length" Condition="'@(PackageReference->WithMetadataValue('Identity', 'UnitsNet'))' != ''" />
        <Using Include="Xunit" Condition="'@(PackageReference->WithMetadataValue('Identity', 'xunit.v3.mtp-v2'))' != '' or '@(PackageReference->WithMetadataValue('Identity', 'xunit.v3.assert'))' != ''" />
        <Using Include="CsCheck" Condition="'@(PackageReference->WithMetadataValue('Identity', 'CsCheck'))' != ''" />
        <Using Include="Grasshopper2.Types.Numeric;Grasshopper2.UI" Condition="'@(PackageReference->WithMetadataValue('Identity', 'Grasshopper2'))' != ''" />
    </ItemGroup>

    <ItemGroup Label="Rhino Host Packages" Condition="'$(RhinoHost)' != ''">
        <PackageReference Include="RhinoCommon" ExcludeAssets="runtime" />
        <PackageReference Include="System.Drawing.Common">
            <ExcludeAssets>runtime</ExcludeAssets>
            <ExcludeAssets Condition="'$(TargetPlatformIdentifier)' != 'Windows'">compile;runtime</ExcludeAssets>
        </PackageReference>
        <Using Include="Rhino.Geometry" />
        <Using Include="Rhino.Geometry.Interval" Alias="Interval" />
    </ItemGroup>

    <PropertyGroup Label="Rhino Windows Host" Condition="'$(RhinoHost)' != '' and '$(TargetPlatformIdentifier)' == 'Windows'">
        <DefaultItemExcludes>$(DefaultItemExcludes);**/macOS/**</DefaultItemExcludes>
    </PropertyGroup>

    <Target Name="ResolveRhinoInstallation" DependsOnTargets="ResolvePackageAssets" Condition="'$(RhinoHost)' != ''">
        <GetAssemblyIdentity AssemblyFiles="@(ResolvedCompileFileDefinitions->WithMetadataValue('NuGetPackageId', 'RhinoCommon')->WithMetadataValue('Filename', 'RhinoCommon'))">
            <Output TaskParameter="Assemblies" ItemName="_RhinoAssemblyIdentity" />
        </GetAssemblyIdentity>
        <PropertyGroup>
            <_RhinoMajorVersion>$([System.Version]::Parse('%(_RhinoAssemblyIdentity.Version)').Major)</_RhinoMajorVersion>
            <RhinoInstallPath>$(RHINO_PATH)</RhinoInstallPath>
        </PropertyGroup>
        <Exec Command="osascript -l JavaScript -e &quot;ObjC.import('AppKit'); \$.NSWorkspace.sharedWorkspace.URLForApplicationWithBundleIdentifier('com.mcneel.rhinoceros.$(_RhinoMajorVersion)').path.js&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low" Condition="'$(RhinoInstallPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">
            <Output TaskParameter="ConsoleOutput" PropertyName="RhinoInstallPath" />
        </Exec>
        <PropertyGroup>
            <RhinoInstallPath Condition="'$(RhinoInstallPath)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\McNeel\Rhinoceros\$(_RhinoMajorVersion).0\Install', 'InstallPath'))</RhinoInstallPath>
            <RhinoResourcesDir Condition="$([MSBuild]::IsOSPlatform('OSX'))">$([MSBuild]::NormalizeDirectory('$(RhinoInstallPath)', 'Contents', 'Frameworks', 'RhCore.framework', 'Versions', 'Current', 'Resources'))</RhinoResourcesDir>
            <RhinoResourcesDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::NormalizeDirectory('$(RhinoInstallPath)', 'System'))</RhinoResourcesDir>
            <_YakExecutable Condition="$([MSBuild]::IsOSPlatform('OSX'))">$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'Contents', 'Resources', 'bin', 'yak'))</_YakExecutable>
            <_YakExecutable Condition="$([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'System', 'yak.exe'))</_YakExecutable>
        </PropertyGroup>
        <GetAssemblyIdentity AssemblyFiles="$(RhinoResourcesDir)RhinoCommon.dll">
            <Output TaskParameter="Assemblies" ItemName="_RhinoInstalledIdentity" />
        </GetAssemblyIdentity>
        <PropertyGroup>
            <RhinoVersion>%(_RhinoInstalledIdentity.Version)</RhinoVersion>
        </PropertyGroup>
    </Target>

    <Target Name="ResolveRhinoHostReferences" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(RhinoHost)' != '' and '$(TargetPlatformIdentifier)' != 'Windows'">
        <ItemGroup>
            <_RhinoMacAssembly Include="System.Drawing.Common" />
            <_RhinoMacAssembly Include="Eto.macOS;Microsoft.macOS" Condition="Exists('$(MSBuildProjectDirectory)/UI/macOS/')" />
            <Reference Include="@(_RhinoMacAssembly->'$(RhinoResourcesDir)%(Identity).dll')" Private="false" />
        </ItemGroup>
    </Target>

    <Target Name="AddRhinoMacPlatform" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(RhinoHost)' != '' and '$(TargetPlatformIdentifier)' != 'Windows'">
        <XmlPeek XmlInputPath="$(RhinoInstallPath)/Contents/Info.plist" Query="/plist/dict/key[.='LSMinimumSystemVersion']/following-sibling::*[1]/text()" ProhibitDtd="false">
            <Output TaskParameter="Result" PropertyName="_RhinoMacMinimumVersion" />
        </XmlPeek>
        <ItemGroup>
            <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
                <_Parameter1>macos$(_RhinoMacMinimumVersion)</_Parameter1>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <PropertyGroup Label="Rhino macOS Bindings" Condition="'$(RhinoHost)' != '' and '$(TargetPlatformIdentifier)' != 'Windows' and Exists('$(MSBuildProjectDirectory)/UI/macOS/')">
        <DefineConstants>$(DefineConstants);RHINO_MACOS_BINDINGS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Plug-In" Condition="'$(TargetExt)' == '.rhp'">
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PlugInIcons>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'icons'))</PlugInIcons>
        <PlugInIconSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'icon.svg'))</PlugInIconSource>
        <PlugInPackageIcon Condition="Exists('$(PlugInIconSource)')">icon.png</PlugInPackageIcon>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Plug-In Assets" Condition="'$(TargetExt)' == '.rhp'">
        <_PlugInAssetDir>$(IntermediateOutputPath)PlugInAssets/</_PlugInAssetDir>
        <_PlugInAssetInputsCache>$(_PlugInAssetDir)RasterInputs.cache</_PlugInAssetInputsCache>
        <_PlugInIcon Condition="'$(PlugInPackageIcon)' != ''">PlugIn.ico</_PlugInIcon>
    </PropertyGroup>

    <ItemGroup Label="Rhino Plug-In Files" Condition="'$(TargetExt)' == '.rhp'">
        <PackageReference Include="System.Reflection.MetadataLoadContext" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
        <None Update="$(AssemblyName).rui" CopyToPublishDirectory="PreserveNewest" />
        <_PlugInDescription Include="Organization" Value="$(Authors)" />
        <PlugInGlyph Include="$(PlugInIcons)**/*.svg" Points="$([MSBuild]::ValueOrDefault($([System.IO.Path]::TrimEndingDirectorySeparator('%(RecursiveDir)')), '16'))" />
        <_PlugInMacGlyph Include="@(PlugInGlyph)" Scale="1" />
        <_PlugInMacGlyph Include="@(_PlugInMacGlyph)" Scale="2" />
        <_PlugInMacGlyph Update="@(_PlugInMacGlyph)">
            <Suffix Condition="'%(Scale)' != '1'">@%(Scale)x</Suffix>
            <LogicalName>%(Filename)-%(Points)_mac%(Suffix).png</LogicalName>
            <Pixels>$([MSBuild]::Multiply(24, '%(Scale)'))</Pixels>
        </_PlugInMacGlyph>
        <_PlugInMacGlyphFile Include="@(_PlugInMacGlyph->'$(_PlugInAssetDir)%(LogicalName)')" />
    </ItemGroup>

    <ItemGroup Label="Rhino Plug-In Icon" Condition="'$(_PlugInIcon)' != ''">
        <_PlugInIconFrame Include="16;24;32;48" />
        <_PlugInIconFile Include="$(_PlugInAssetDir)$(_PlugInIcon)" LogicalName="$(_PlugInIcon)" />
        <_PlugInDescription Include="Icon" Value="$(_PlugInIcon)" />
    </ItemGroup>

    <ItemGroup Label="Rhino Plug-In Package Image" Condition="'$(PlugInPackageIcon)' != ''">
        <_PlugInIconFrame Include="256" />
        <_PlugInIconFile Include="@(_PlugInIconFrame->'$(_PlugInAssetDir)%(Identity).png')" />
        <None Include="$(_PlugInAssetDir)256.png" TargetPath="$(PlugInPackageIcon)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Label="Rhino Plug-In Assets" Condition="'$(TargetExt)' == '.rhp'">
        <_PlugInAssetInput Include="$(PlugInIcons)**/*" />
        <EmbeddedResource Include="@(PlugInGlyph)" LogicalName="%(Filename)-%(Points).svg" WithCulture="false" />
        <EmbeddedResource Include="@(_PlugInMacGlyphFile);@(_PlugInIconFile->HasMetadata('LogicalName'))" WithCulture="false" />
        <FileWrites Include="@(_PlugInMacGlyphFile);@(_PlugInIconFile)" />
    </ItemGroup>

    <ItemGroup Label="Rhino Plug-In Parts" Condition="'$(TargetExt)' == '.rhp'">
        <ProjectReference Include="@(_NestedProject)" />
    </ItemGroup>

    <ItemGroup Label="Workspace Policy">
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" Condition="'$(ProjectRole)' == 'tests'" />
    </ItemGroup>

    <Target Name="CreatePlugInAssetInputsCache" Condition="'$(DesignTimeBuild)' != 'true' and '@(_PlugInIconFrame)@(_PlugInMacGlyph)' != ''">
        <ItemGroup>
            <_PlugInAssetTool Include="resvg --version" />
            <_PlugInAssetTool Include="magick -version" Condition="'$(_PlugInIcon)' != ''" />
        </ItemGroup>
        <Exec Command="%(_PlugInAssetTool.Identity)" ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" ItemName="_PlugInAssetToolVersion" />
        </Exec>
        <WriteLinesToFile File="$(_PlugInAssetInputsCache)" Lines="@(_PlugInAssetToolVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <FileWrites Include="$(_PlugInAssetInputsCache)" />
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInMacGlyphs" BeforeTargets="CoreCompile" DependsOnTargets="CreatePlugInAssetInputsCache" Condition="'$(DesignTimeBuild)' != 'true'" Inputs="$(MSBuildAllProjects);@(PlugInGlyph);$(_PlugInAssetInputsCache)" Outputs="@(_PlugInMacGlyphFile)">
        <Exec Command="resvg -w %(_PlugInMacGlyph.Pixels) &quot;%(_PlugInMacGlyph.FullPath)&quot; &quot;%(_PlugInMacGlyph.LogicalName)&quot;" WorkingDirectory="$(_PlugInAssetDir)" StandardOutputImportance="low" />
    </Target>

    <Target Name="BuildPlugInIcon" BeforeTargets="CoreCompile" DependsOnTargets="CreatePlugInAssetInputsCache" Condition="'$(DesignTimeBuild)' != 'true'" Inputs="$(MSBuildAllProjects);$(PlugInIconSource);@(_PlugInAssetInput);$(_PlugInAssetInputsCache)" Outputs="@(_PlugInIconFile)">
        <Exec Command="resvg -w %(_PlugInIconFrame.Identity) &quot;$(PlugInIconSource)&quot; %(_PlugInIconFrame.Identity).png" WorkingDirectory="$(_PlugInAssetDir)" StandardOutputImportance="low" />
        <Exec Command="magick @(_PlugInIconFrame->'%(Identity).png', ' ') -define icon:png-compression-size=256 $(_PlugInIcon)" WorkingDirectory="$(_PlugInAssetDir)" StandardOutputImportance="low" Condition="'$(_PlugInIcon)' != ''" />
    </Target>

    <Target Name="AddPlugInDescriptions" AfterTargets="GetAssemblyAttributes" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <_PlugInDescription Include="WebSite" Value="$(PrivateRepositoryUrl)" />
            <AssemblyAttribute Include="@(_PlugInDescription->'Rhino.PlugIns.PlugInDescriptionAttribute')" RemoveMetadata="Value">
                <_Parameter1>Rhino.PlugIns.DescriptionType.%(_PlugInDescription.Identity)</_Parameter1>
                <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
                <_Parameter2>%(_PlugInDescription.Value)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <Target Name="AssignPlugInLibraryCopies" BeforeTargets="AssignProjectConfiguration" DependsOnTargets="IncludeTransitiveProjectReferences" Condition="'$(TargetExt)' == '.rhp' and '$(RhinoPlugIn)' == '' and '$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <ProjectReference AdditionalProperties="RhinoPlugIn=$(MSBuildProjectName);ArtifactsPivots=$(MSBuildProjectName)_$(ArtifactsPivots)" />
        </ItemGroup>
    </Target>

    <UsingTask TaskName="FindGrasshopperPlugIns" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <PlugIns ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <References ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <Grasshopper ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
            <GrasshopperPlugIns ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Reference Include="$(PkgSystem_Reflection_MetadataLoadContext)/lib/netstandard2.0/System.Reflection.MetadataLoadContext.dll" />
            <Using Namespace="System.Reflection" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                using MetadataLoadContext context = new(new PathAssemblyResolver(References.Concat(PlugIns).Select(static item => item.ItemSpec)));
                HashSet<string> grasshopper = new(Grasshopper.Select(static item => item.GetMetadata("Filename")));
                GrasshopperPlugIns = PlugIns.Where(plugIn => {
                    HashSet<Type> seen = new();
                    bool Derives(Type type) => seen.Add(type) && (grasshopper.Contains(type.Assembly.GetName().Name) || type.GetInterfaces().Concat(type.GenericTypeArguments).Append(type.BaseType).Any(next => next != null && Derives(next)));
                    return context.LoadFromAssemblyPath(plugIn.ItemSpec).GetExportedTypes().Any(Derives);
                }).ToArray();
            ]]></Code>
        </Task>
    </UsingTask>

    <Target Name="BuildYakPackage" AfterTargets="Publish" DependsOnTargets="ResolveRhinoInstallation;ResolveAssemblyReferences" Condition="'$(TargetExt)' == '.rhp'">
        <PropertyGroup>
            <_YakPlatform>mac</_YakPlatform>
            <_YakPlatform Condition="'$(TargetPlatformIdentifier)' == 'Windows'">win</_YakPlatform>
        </PropertyGroup>
        <ItemGroup>
            <_YakOutput Include="$(PublishDir)manifest.yml;$(PublishDir)*.yak;$(PublishDir)*.grasshopper-only" />
            <_YakPlugIn Include="$(PublishDir)*.rhp" />
            <_GrasshopperAssembly Include="@(ReferencePath->WithMetadataValue('NuGetPackageId', 'Grasshopper2'))" />
        </ItemGroup>
        <Delete Files="@(_YakOutput)" />
        <FindGrasshopperPlugIns PlugIns="@(_YakPlugIn)" References="@(ReferencePath)" Grasshopper="@(_GrasshopperAssembly)" Condition="'@(_GrasshopperAssembly)' != ''">
            <Output TaskParameter="GrasshopperPlugIns" ItemName="_GrasshopperPlugIn" />
        </FindGrasshopperPlugIns>
        <Touch Files="@(_GrasshopperPlugIn->'%(FullPath).grasshopper-only')" AlwaysCreate="true" />
        <Exec Command="&quot;$(_YakExecutable)&quot; spec --input &quot;$(TargetFileName)&quot;" WorkingDirectory="$(PublishDir)" StandardOutputImportance="low" />
        <WriteLinesToFile File="$(PublishDir)manifest.yml" Lines="icon: $(PlugInPackageIcon)" Condition="'$(PlugInPackageIcon)' != ''" />
        <Exec Command="&quot;$(_YakExecutable)&quot; build --platform $(_YakPlatform)" WorkingDirectory="$(PublishDir)" StandardOutputImportance="low" />
    </Target>

    <Target Name="InstallYakPackage" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhp'">
        <Exec Command="yq &quot;.name&quot; &quot;$(PublishDir)manifest.yml&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_YakPackageName" />
        </Exec>
        <ItemGroup>
            <_YakPackage Include="$(PublishDir)*.yak" />
        </ItemGroup>
        <Exec Command="&quot;$(_YakExecutable)&quot; uninstall &quot;$(_YakPackageName)&quot;" StandardOutputImportance="low" />
        <Exec Command="&quot;$(_YakExecutable)&quot; install &quot;@(_YakPackage->'%(FullPath)')&quot;" StandardOutputImportance="low" />
    </Target>

    <Target Name="CleanTestResults" BeforeTargets="ComputeRunArguments" Condition="'$(IsTestingPlatformApplication)' == 'true'">
        <RemoveDir Directories="$(_TestResultsDirectory)" />
    </Target>
</Project>
