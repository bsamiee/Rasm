<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="rasm" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Java rules</description>

    <rule ref="category/java/bestpractices.xml">
        <exclude name="UnusedFormalParameter" />
    </rule>
    <rule ref="category/java/bestpractices.xml/UnusedFormalParameter">
        <properties>
            <property name="checkAll" value="true" />
        </properties>
    </rule>

    <rule ref="category/java/codestyle.xml">
        <exclude name="AtLeastOneConstructor" /> <!-- Ghidra instantiates each `GhidraScript` through its implicit constructor -->
        <exclude name="CommentDefaultAccessModifier" /> <!-- Demands comments on package-private members, CLAUDE.md forbids comments -->
        <exclude name="LocalVariableCouldBeFinal" /> <!-- `javac` treats effectively final locals as final -->
        <exclude name="LocalVariableDeclarationShouldBeAtStartOfBlock" /> <!-- Locals bind at first use, data dependency decides order -->
        <exclude name="MethodArgumentCouldBeFinal" /> <!-- `javac` treats effectively final parameters as final -->
        <exclude name="NoPackage" /> <!-- Ghidra loads scripts from script folders in the default package -->
        <exclude name="OnlyOneReturn" /> <!-- `switch` arms and guards return per case -->
        <exclude name="ShortClassName" /> <!-- Names come from their subject (`Row`, `Role`), clean-prose naming -->
        <exclude name="ShortMethodName" /> <!-- Names come from their subject, clean-prose naming -->
        <exclude name="ShortVariable" /> <!-- Names come from their subject, clean-prose naming -->
    </rule>

    <rule ref="category/java/design.xml">
        <exclude name="CouplingBetweenObjects" /> <!-- Type counts push one-caller helper extraction CLAUDE.md forbids -->
        <exclude name="ExcessiveImports" /> <!-- Import counts push one-caller helper extraction CLAUDE.md forbids -->
        <exclude name="LawOfDemeter" /> <!-- Ghidra's API reaches program state through accessor chains -->
        <exclude name="LoosePackageCoupling" /> <!-- Reports a configuration error without a package list to check -->
        <exclude name="SignatureDeclareThrowsException" /> <!-- `GhidraScript.run` declares `throws Exception` -->
        <exclude name="TooManyMethods" /> <!-- Member counts push one-caller helper extraction CLAUDE.md forbids -->
    </rule>

    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidAccessibilityAlteration" />
        <exclude name="AvoidCatchingGenericException" />
        <exclude name="CloseResource" />
        <exclude name="EmptyCatchBlock" />
        <exclude name="NonSerializableClass" />
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidAccessibilityAlteration">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::MethodDeclaration[@Name = 'run'][ancestor::ClassDeclaration[@SimpleName = 'Headers']]" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidCatchingGenericException">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::TryStatement[1]/Block//MethodCall[pmd-java:matchesSig('ghidra.app.script.GhidraScript#runScript(java.lang.String,java.lang.String[],ghidra.app.script.GhidraState)')]" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/CloseResource">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor-or-self::LocalVariableDeclaration[VariableDeclarator/MethodCall[pmd-java:matchesSig('java.nio.channels.ServerSocketChannel#accept()')]]" /> <!-- Accepted channels pass to the connection set and the callbacks closing them, past the accepting method -->
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowExceptionNameRegex" value="^$" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/NonSerializableClass">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::*[pmd-java:nodeIs('TypeDeclaration')][1][self::EnumDeclaration]" />
        </properties>
    </rule>
    <rule name="EmptyStringForAbsence" language="java" message="Empty string stands for an absent value" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Keep absence in `Optional` or an empty collection, and choose the whole text per case with `map` and `orElse`</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//MethodCall[
    pmd-java:matchesSig('java.util.Optional#orElse(_)')
    or pmd-java:matchesSig('java.util.Objects#requireNonNullElse(_,_)')
    or pmd-java:matchesSig('java.util.Objects#toString(_,_)')
][ArgumentList/*[last()][self::StringLiteral][@Empty = true()]]
]]>
                </value>
            </property>
        </properties>
    </rule>
    <rule name="UncheckedOptionalAccess" language="java" message="Optional read with no decision on absence" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Read an `Optional` through `map`, `ifPresent`, `orElseGet`, or `orElseThrow`</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//MethodCall[pmd-java:matchesSig('java.util.Optional#get()')]
]]>
                </value>
            </property>
        </properties>
    </rule>
    <rule name="UncheckedDecompilerOpen" language="java" message="Decompiler program open result unchecked" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>`DecompilerCallback` discards false from `DecompInterface.openProgram`, open program in configurer and fail with `getLastMessage`</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//ExpressionStatement/MethodCall[pmd-java:matchesSig('ghidra.app.decompiler.DecompInterface#openProgram(_)')]
| //ConstructorCall[pmd-java:typeIs('ghidra.app.decompiler.parallel.DecompilerCallback')][not(ArgumentList//MethodCall[pmd-java:matchesSig('ghidra.app.decompiler.DecompInterface#openProgram(_)')])]
]]>
                </value>
            </property>
        </properties>
    </rule>

    <rule ref="category/java/multithreading.xml">
        <exclude name="DoNotUseThreads" /> <!-- Scoped to J2EE containers, scripts run in Ghidra's JVM -->
    </rule>

    <rule ref="category/java/performance.xml" />
    <rule name="RecompiledConstantRegex" language="java" message="Constant regex recompiles on each evaluation" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Reuse a static final Pattern for repeated matching and replacement</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//MethodCall[
    (@MethodName = ('compile', 'matches') and pmd-java:matchesSig('java.util.regex.Pattern#_(_*)'))
    or (@MethodName = ('matches', 'replaceAll', 'replaceFirst')
        and pmd-java:matchesSig('java.lang.String#_(_*)'))
][
    ArgumentList/*[1][@CompileTimeConstant = true()]
][
    not(@MethodName = 'compile') or not(ArgumentList/*[2][@CompileTimeConstant = false()])
][
    ancestor::*[
        pmd-java:nodeIs('ExecutableDeclaration') or self::CompactConstructorDeclaration
        or self::LambdaExpression or self::Initializer or self::FieldDeclaration or self::EnumConstant
    ][1][not(self::Initializer[@Static = true()] or self::FieldDeclaration[@Static = true()] or self::EnumConstant)]
]
]]>
                </value>
            </property>
        </properties>
    </rule>

    <rule ref="category/java/security.xml" />
</ruleset>
