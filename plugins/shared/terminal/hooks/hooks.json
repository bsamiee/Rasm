{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "[ -n \"$CLAUDE_ENV_FILE\" ] && { grep -qsF 'mise hook-env' \"$CLAUDE_ENV_FILE\" || printf '%s\\n' 'eval \"$(mise hook-env -s bash)\"' \"export TMPDIR=/private/tmp/claude-$(id -u)/\" >> \"$CLAUDE_ENV_FILE\"; }; true"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/zellij-agent-resume claude",
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/atuin hook claude-code",
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/atuin hook claude-code",
                        "async": true
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/atuin hook claude-code",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "prompt_input_exit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/zellij-agent-resume claude"
                    }
                ]
            }
        ]
    }
}
