language js(typescript, jsx)

or {
    `Effect.catchAll($self, $handler)` where { $self <: not arrow_function() },
    `Effect.catchAllCause($self, $handler)` where { $self <: not arrow_function() },
    `Effect.catchAllDefect($self, $handler)` where { $self <: not arrow_function() },
    `Effect.catchAll($handler)`,
    `Effect.catchAllCause($handler)`,
    `Effect.catchAllDefect($handler)`
} as $hit where {
    $handler <: arrow_function(body=$body),
    $body <: or {
        `Effect.void`,
        `Effect.succeed($_)`
    },
    register_diagnostic(span=$hit, message="Handler discards every typed failure, recover by tag with Effect.catchTag or Effect.catchTags, state an intentional discard as Effect.ignore or Effect.ignoreLogged where the contract names the reason, and log the cause in a defect handler", severity="error")
}
