# --- [DEPENDENCIES] -----------------------------------------------------------

node_modules/

# --- [BUILD_OUTPUTS] ----------------------------------------------------------

dist/
build/
out/
html/
public/build/
.next/
.nuxt/
.turbo/
.docusaurus/
.rollup.cache/
.genkit/

# --- [TYPESCRIPT_ARTIFACTS] ---------------------------------------------------

*.tsbuildinfo
**/dist/**/*.d.ts
**/dist/**/*.d.ts.map
*.js.map
# Vite's transient config bundle may remain next to vite.config.ts after a crashed run
*.timestamp-*.mjs

# --- [PYTHON_ARTIFACTS] -------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so
# Vendored RID-keyed natives are deliberate LFS assets, exempt from the build-output *.so rule
!**/vendor/runtimes/**/*.so
.Python
*.egg
*.egg-info/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
.uv/
.pytest_cache/
.ruff_cache/
.ty_cache/
# Python test support routes the Hypothesis database to .cache/hypothesis; this catches runs without that configuration
.hypothesis/
.dmypy.json
*.prof
*.lprof

# --- [TEST_COVERAGE] ----------------------------------------------------------

.coverage
coverage.xml
coverage/
htmlcov/
*.lcov
.approval_tests_temp/
.benchmarks/

# Verify
*.received.*
*.received/

# --- [CACHES] -----------------------------------------------------------------

.cache/
.cacheuv/
**/.artifacts/
/.remember/
.nx/*
.parcel-cache/
.pulumi/
.swc/
.vite/
.scannerwork/

# --- [.NET_ARTIFACTS] ---------------------------------------------------------

**/bin/
**/obj/
diagnostics.sarif
*.rsuser
*.user
*.suo
*.lscache
# Rhino writes lock and backup files beside opened .3dm files; the host exposes no relocation option
*.rhl
*.3dmbak
# Grasshopper2.dll extracts embedded resources to the `dotnet build` cwd; root-anchored so the real `apps/grasshopper/` tree stays tracked
/Grasshopper.*

# --- [ENVIRONMENT_VARIABLES] --------------------------------------------------

.env
.env.local
.env.*.local
.env.development
.env.production
.secrets
gha-creds-*.json

# --- [LOGS] -------------------------------------------------------------------

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- [IDE_AND_EDITOR] ---------------------------------------------------------

mise.local.toml
.idea/
.history/
*.swp
*.swo
*.tmp
*.bak
*.orig
*~

# --- [MACOS] ------------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- [TRANSIENT_TREES] ---------------------------------------------------------

.archive/
_archive/
scratch/
.scratch/
_tmp/
.tmp/

# --- [AI_TOOLING] -------------------------------------------------------------

.claude/agent-memory-local/
.claude/skills/**/.cache/
.claude/settings.local.json
.claude/worktrees/
.playwright-mcp/

# --- [SECRETS] ---------------------------------------------------------------

*.pem
*.key
*.secret
*.cert
*.crt
credentials.json
# Stryker.NET mutation working directory: relative to the current directory with no upstream relocation option; reports write to .artifacts/dotnet/stryker
.stryker-tmp/
