{
    "name": "@rasm/atelier",
    "private": true,
    "description": "Background agent control of Adobe applications",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/atelier-protocol": "workspace:*",
        "@rasm/automation": "workspace:*",
        "@rasm/cep": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/process": "workspace:*",
        "@rasm/quran": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/typography": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:",
        "image-size": "catalog:",
        "plist": "catalog:"
    },
    "devDependencies": {
        "@rasm/atelier-extendscript": "workspace:*",
        "@types/node": "catalog:",
        "vite": "catalog:"
    },
    "nx": {
        "targets": {
            "build--vite": {
                "inputs": [ "...", "{projectRoot}/macos/Atelier.xcodeproj/project.xcproj", "{projectRoot}/macos/Atelier.entitlements", "{workspaceRoot}/Xcode.xcconfig" ]
            }
        }
    }
}
