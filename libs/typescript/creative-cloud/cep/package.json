{
    "name": "@rasm/cep",
    "version": "0.1.0",
    "private": true,
    "description": "CEP extension manifest, the panel runtime following the host skin, launching a caller link, and serving an RPC group through the host script, and the Vite builder of CEP extensions",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/cep"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./panel": "./panel.ts",
        "./vite": "./vite.ts"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./panel": "./dist/panel.js",
            "./vite": "./dist/vite.js"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/extendscript": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "cheerio": "catalog:",
        "culori": "catalog:",
        "fast-xml-builder": "catalog:",
        "fast-xml-parser": "catalog:"
    },
    "devDependencies": {
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
