{
    "name": "@rasm/nx-distribution",
    "version": "0.1.0",
    "private": true,
    "description": "Nx plugin inferring host packages from their manifests, one row per kind (Blender extension, Yak package, Adobe UXP .ccx and CEP .zxp, Unreal plug-in): each row builds the package with its host tool, installs it where the host loads it, attaches it to the project's GitHub release, and publishes it to the host store taking uploads",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/distribution"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#vendored": "./executors/extension-build/vendored.py"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json",
        "./generators.json": "./generators.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json", "generators.json", "generators/*/schema.json" ],
    "dependencies": {
        "@decimalturn/toml-patch": "catalog:",
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/process": "workspace:*",
        "@xml-tools/ast": "catalog:",
        "@xml-tools/parser": "catalog:",
        "effect": "catalog:",
        "jsonc-parser": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json",
            "./generators.json": "./generators.json"
        },
        "imports": {
            "#/*": "./dist/*.js",
            "#vendored": "./executors/extension-build/vendored.py"
        }
    },
    "executors": "./executors.json",
    "generators": "./generators.json"
}
