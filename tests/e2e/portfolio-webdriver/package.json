{
    "name": "@rasm/test-portfolio-webdriver",
    "private": true,
    "description": "Portfolio suite in the installed Firefox and, on macOS, Safari, each driven over WebDriver against the built Node bundle with its own database and object storage: the page a visitor sees and the editor its owner sees at each width, by the cases the Chromium suite runs",
    "type": "module",
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/process": "workspace:*",
        "@rasm/test-portfolio": "workspace:*",
        "@types/node": "catalog:",
        "@types/selenium-webdriver": "catalog:",
        "effect": "catalog:",
        "selenium-webdriver": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "tags": [
            "host:browser",
            "os:all"
        ],
        "implicitDependencies": [
            "@rasm/portfolio"
        ],
        "targets": {
            "test--vitest": {
                "dependsOn": [
                    "...",
                    {
                        "projects": [
                            "@rasm/portfolio"
                        ],
                        "target": "build--vite"
                    }
                ]
            }
        }
    }
}
