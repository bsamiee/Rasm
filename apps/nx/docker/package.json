{
    "name": "@rasm/nx-docker",
    "version": "0.0.0",
    "description": "Nx plugin inferring Compose projects, their checks, image builds, and service starts from docker compose's own output; the image build and start of a service join the project of the folder holding its Dockerfile, which a manifest of another plugin names",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/docker"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./plugin.ts",
        "./package.json": "./package.json",
        "./ready-check": "./ready-check.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugin.js",
            "./package.json": "./package.json",
            "./ready-check": "./dist/ready-check.js"
        }
    }
}
