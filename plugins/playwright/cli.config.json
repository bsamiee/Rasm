{
    "browser": {
        "browserName": "chromium",
        "launchOptions": {
            "headless": true,
            "args": ["--enable-features=CDPScreenshotNewSurface,WebMCP"]
        },
        "contextOptions": {
            "bypassCSP": true,
            "ignoreHTTPSErrors": true,
            "permissions": [
                "accelerometer",
                "ambient-light-sensor",
                "background-sync",
                "camera",
                "clipboard-read",
                "clipboard-write",
                "geolocation",
                "gyroscope",
                "local-fonts",
                "local-network-access",
                "magnetometer",
                "microphone",
                "midi",
                "midi-sysex",
                "notifications",
                "payment-handler",
                "screen-wake-lock",
                "storage-access"
            ]
        }
    },
    "console": {
        "level": "debug"
    },
    "allowUnrestrictedFileAccess": true,
    "filePaths": "absolute"
}
