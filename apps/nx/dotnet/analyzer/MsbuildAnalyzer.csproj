<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Evaluates every MSBuild project of a workspace in one process and reports the facts the Nx plugin derives targets from</Description>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RollForward>LatestMajor</RollForward>
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup Label="Build Engine">
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator" />
        <PackageReference Include="NuGet.ProjectModel" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>
</Project>
