{
    "name": "@rasm/uxp",
    "private": true,
    "description": "UXP manifests, plugin and script runtimes, and Vite plugin builds",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./plugin": "./plugin.ts",
        "./vite": "./vite.ts"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@exodus/bytes": "catalog:",
        "@rasm/automation": "workspace:*",
        "@rasm/mark": "workspace:*"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
