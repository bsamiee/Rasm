{
    "name": "@rasm/test-rasad",
    "private": true,
    "description": "@rasm/rasad suites over its built server, driven over MCP against a fake application server, with the official MCP conformance scenarios and Atelier's tool schemas as references",
    "os": [
        "darwin"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "plist": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "implicitDependencies": [
            "@rasm/atelier",
            "@rasm/rasad"
        ],
        "targets": {
            "test--vitest": {
                "dependsOn": [
                    "...",
                    {
                        "projects": [
                            "@rasm/atelier",
                            "@rasm/rasad"
                        ],
                        "target": "build--vite"
                    }
                ],
                "inputs": [
                    "...",
                    "{workspaceRoot}/.config/mise/locks/npm-modelcontextprotocol-conformance/**/*"
                ]
            }
        }
    }
}
