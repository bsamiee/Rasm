{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "cacheDirectory": ".cache/nx/cache",
    "neverConnectToCloud": true,
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": ["default", "!{projectRoot}/**/*.{spec,test,bench}.{ts,tsx,mts,cts}"],
        "sharedGlobals": [
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/mise.toml",
            "{workspaceRoot}/tools/nx/*.ts",
            "{workspaceRoot}/sgconfig.yml",
            "{workspaceRoot}/tools/ast-grep/**/*",
            { "runtime": "ast-grep --version" }
        ],
        "dotnet": [
            "{workspaceRoot}/global.json",
            "{workspaceRoot}/NuGet.config",
            "{workspaceRoot}/Directory.Build.props",
            "{workspaceRoot}/Directory.Build.targets",
            "{workspaceRoot}/Directory.Packages.props",
            "{workspaceRoot}/.editorconfig"
        ],
        "python": ["{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"],
        "typescript": [
            "{workspaceRoot}/biome.json",
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/pnpm-workspace.yaml",
            "{workspaceRoot}/pnpm-lock.yaml",
            "{workspaceRoot}/vite.config.ts",
            "{workspaceRoot}/vitest.config.ts",
            { "runtime": "node --version" }
        ]
    },
    "targetDefaults": {
        "build": [
            { "cache": true },
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "dependsOn": ["^build", { "projects": ["rasm"], "target": "restore" }],
                "inputs": ["...", "dotnet"]
            }
        ],
        "build:release": [
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "dependsOn": ["^build:release", { "projects": ["rasm"], "target": "restore" }],
                "inputs": ["...", "dotnet"]
            }
        ],
        "lint": [
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": ["build", { "projects": ["rasm"], "target": "grammar" }],
                "inputs": ["default", "dotnet"],
                "options": { "commands": [{ "command": "ast-grep scan {projectRoot}", "forwardAllArgs": false }] }
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [{ "projects": ["rasm"], "target": "grammar" }],
                "inputs": ["default", "python"],
                "options": { "commands": ["uv run ruff check --fix {projectRoot}", "ast-grep scan {projectRoot}"], "parallel": false }
            },
            {
                "filter": { "projects": ["tag:language:typescript", "!rasm"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [{ "projects": ["rasm"], "target": "grammar" }],
                "inputs": ["default", "typescript"],
                "options": {
                    "commands": ["biome check --write --error-on-warnings {projectRoot}", "ast-grep scan {projectRoot}"],
                    "parallel": false
                }
            }
        ],
        "format": [
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [{ "projects": ["rasm"], "target": "restore" }],
                "inputs": ["default", "dotnet"],
                "options": { "command": "dotnet format --no-restore", "cwd": "{projectRoot}" }
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "python"],
                "options": { "command": "uv run ruff format {projectRoot}" }
            },
            {
                "filter": { "projects": ["tag:language:typescript", "!rasm"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "typescript"],
                "options": { "command": "biome format --write {projectRoot}" }
            }
        ],
        "typecheck": [
            { "filter": { "projects": ["tag:language:dotnet"] }, "executor": "nx:noop", "dependsOn": ["build"] },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "python"],
                "options": { "commands": ["uv run ty check {projectRoot}", "uv run mypy {projectRoot}"], "parallel": false }
            },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": ["^typecheck"],
                "inputs": ["default", "^production", "typescript", { "externalDependencies": ["typescript"] }],
                "options": { "command": "tsc --build --pretty false", "cwd": "{projectRoot}" },
                "outputs": ["{workspaceRoot}/.cache/typescript/out/{projectRoot}"]
            }
        ],
        "test": [
            { "cache": true },
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "inputs": ["...", "dotnet"],
                "outputs": ["{workspaceRoot}/.artifacts/dotnet/coverage/{projectName}"]
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "inputs": ["default", "python"],
                "outputs": [
                    "{workspaceRoot}/.artifacts/python/coverage/data/.coverage.{projectName}",
                    "{workspaceRoot}/.artifacts/python/benchmarks"
                ],
                "options": {
                    "command": "uv run pytest {projectRoot} --cov",
                    "env": { "COVERAGE_FILE": ".artifacts/python/coverage/data/.coverage.{projectName}" }
                },
                "configurations": { "benchmark": { "command": "uv run pytest -m benchmark {projectRoot}" } }
            },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "outputs": [
                    "{workspaceRoot}/.artifacts/typescript/test-results/{projectName}",
                    "{workspaceRoot}/.artifacts/typescript/test-results/.vitest-reports/{projectName}.json",
                    "{workspaceRoot}/.artifacts/typescript/bench/{projectName}.json",
                    "{workspaceRoot}/.artifacts/typescript/coverage/{projectName}"
                ],
                "configurations": { "benchmark": { "command": "vitest bench" } }
            }
        ],
        "check": [{ "filter": { "projects": ["tag:language:*"] }, "executor": "nx:noop", "dependsOn": ["lint", "format", "typecheck", "test"] }],
        "nx-release-publish": [
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "executor": "nx:run-commands",
                "cache": false,
                "dependsOn": [{ "projects": ["rasm"], "target": "restore" }],
                "options": {
                    "commands": [{ "command": "uv run --only-group eng python -m eng.scripts.publish nuget {projectRoot}", "forwardAllArgs": false }]
                }
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": false,
                "options": {
                    "commands": [{ "command": "uv run --only-group eng python -m eng.scripts.publish pypi {projectRoot}", "forwardAllArgs": false }]
                }
            },
            { "filter": { "projects": ["tag:release:typescript"] }, "options": { "packageRoot": "{projectRoot}/dist" } }
        ]
    },
    "release": {
        "projectsRelationship": "independent",
        "releaseTag": { "pattern": "{projectName}@{version}" },
        "version": {
            "conventionalCommits": true,
            "fallbackCurrentVersionResolver": "disk",
            "updateDependents": "never",
            "logUnchangedProjects": false,
            "versionActions": "tools/nx/version-actions.ts"
        },
        "changelog": { "automaticFromRef": true, "workspaceChangelog": false, "projectChangelogs": { "file": false, "createRelease": "github" } },
        "git": { "commit": false, "tag": true, "push": true },
        "groups": {
            "dotnet": { "projects": ["tag:release:dotnet"] },
            "Rasm.Interop": {
                "projects": ["tag:release:Rasm.Interop"],
                "projectsRelationship": "fixed",
                "releaseTag": { "pattern": "{releaseGroupName}@{version}" }
            },
            "python": { "projects": ["tag:release:python"] },
            "typescript": {
                "projects": ["tag:release:typescript"],
                "version": {
                    "versionActions": "tools/nx/typescript-version-actions.ts",
                    "manifestRootsToUpdate": ["{projectRoot}/dist"],
                    "groupPreVersionCommand": "pnpm exec nx run-many -t build --projects=tag:release:typescript"
                }
            }
        }
    },
    "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false } },
    "plugins": [
        { "plugin": "@nx/vite/plugin", "exclude": ["vite.config.ts"] },
        { "plugin": "@nx/vitest", "exclude": ["vite.config.ts", "vitest.config.ts"] },
        {
            "plugin": "@nx/dotnet",
            "exclude": ["eng/native/**"],
            "options": {
                "clean": false,
                "pack": false,
                "publish": false,
                "restore": false,
                "watch": { "dependsOn": [{ "projects": ["rasm"], "target": "restore" }] }
            }
        },
        { "plugin": "./tools/nx/workspace.ts" }
    ]
}
