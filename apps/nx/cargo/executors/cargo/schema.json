{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": 2,
    "type": "object",
    "properties": {
        "cwd": {
            "type": "string",
            "description": "Cargo workspace root, relative to the Nx workspace root"
        },
        "commands": {
            "type": "array",
            "minItems": 1,
            "description": "Cargo invocations in order, a task stopping at its first failure",
            "items": [
                {
                    "type": "object",
                    "properties": {
                        "args": {
                            "type": "array",
                            "minItems": 1,
                            "description": "Subcommand and its arguments",
                            "items": [
                                {
                                    "type": "string"
                                }
                            ],
                            "additionalItems": {
                                "type": "string"
                            }
                        },
                        "trailing": {
                            "type": "array",
                            "description": "Arguments after --, before the report flags",
                            "items": {
                                "type": "string"
                            }
                        },
                        "report": {
                            "type": "string",
                            "enum": [ "messages", "tests", "status" ],
                            "description": "Output each task is decided from: compiler messages, nextest suite events, or the exit status"
                        },
                        "packages": {
                            "type": "array",
                            "description": "Further packages the command selects",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "root": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    }
                                },
                                "required": [ "root", "name" ],
                                "additionalProperties": true
                            }
                        }
                    },
                    "required": [ "args", "report" ],
                    "additionalProperties": true
                }
            ],
            "additionalItems": {
                "type": "object",
                "properties": {
                    "args": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Subcommand and its arguments",
                        "items": [
                            {
                                "type": "string"
                            }
                        ],
                        "additionalItems": {
                            "type": "string"
                        }
                    },
                    "trailing": {
                        "type": "array",
                        "description": "Arguments after --, before the report flags",
                        "items": {
                            "type": "string"
                        }
                    },
                    "report": {
                        "type": "string",
                        "enum": [ "messages", "tests", "status" ],
                        "description": "Output each task is decided from: compiler messages, nextest suite events, or the exit status"
                    },
                    "packages": {
                        "type": "array",
                        "description": "Further packages the command selects",
                        "items": {
                            "type": "object",
                            "properties": {
                                "root": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            },
                            "required": [ "root", "name" ],
                            "additionalProperties": true
                        }
                    }
                },
                "required": [ "args", "report" ],
                "additionalProperties": true
            }
        },
        "package": {
            "type": "string",
            "description": "Package the task selects, passed to cargo as a package ID spec"
        },
        "args": {
            "type": "array",
            "description": "Arguments appended to every command",
            "items": {
                "type": "string"
            }
        },
        "outputs": {
            "type": "array",
            "description": "Files the commands write, each folder created before the run",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [ "cwd", "commands" ],
    "additionalProperties": true,
    "title": "Cargo",
    "description": "Runs cargo commands from a workspace root, one process per command for every selected package, each task decided by its own package's report"
}
