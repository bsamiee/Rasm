{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Xcode.xcconfig" },
    { "name": "Release", "file": "Xcode.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "../../..",
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.10.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-async-algorithms",
      "version": {
        "up-to-next-major-version": "1.1.7",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-case-paths",
      "version": {
        "up-to-next-major-version": "1.10.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-http-types",
      "version": {
        "up-to-next-major-version": "1.8.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/swiftlang/swift-subprocess",
      "version": {
        "up-to-next-major-version": "1.0.2",
      },
    },
  ],
  "files": [
    { "path": "<PROJECT>/../../../Xcode.xcconfig" },
    {
      "kind": "folder",
      "path": ".",
      "target-membership": [
        "Relay",
      ],
      "membership-exceptions": [
        {
          "target": "Relay",
          "exclusions": [
            "AGENTS.md",
            "CLAUDE.md",
            "Info.plist",
            "buildServer.json",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Relay.app", "id": "DF48A6EC3089FB4E003F171A", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Relay",
      "id": "DF48A6EB3089FB4E003F171A",
      "product": "Products/Relay.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "..",
          "product-name": "CurrentProcess",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Encoding",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Files",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "JSONRPC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Keychain",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Lockfiles",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Processes",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Results",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-async-algorithms",
          "product-name": "AsyncAlgorithms",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-case-paths",
          "product-name": "CasePaths",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-case-paths",
          "product-name": "CasePathsCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-http-types",
          "product-name": "HTTPTypes",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-http-types",
          "product-name": "HTTPTypesFoundation",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-subprocess",
          "product-name": "Subprocess",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.rasm.relay",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
      },
    },
  ],
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
