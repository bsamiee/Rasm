{
    "version": 13,
    "configurePresets": [
        {
            "name": "tree",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.artifacts/cmake/${presetName}",
            "installDir": "${sourceDir}/.artifacts/cmake/${presetName}/prefix",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "warnings": { "author": true, "deprecated": true, "experimental": true, "installAbsoluteDestination": true, "nonTargetDirective": true, "policy": true, "strict": true },
            "errors": { "author": true, "deprecated": true, "experimental": true, "installAbsoluteDestination": true, "nonTargetDirective": true, "policy": true, "strict": true },
            "cacheVariables": { "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/.cache/vcpkg/buildtrees;--x-packages-root=${sourceDir}/.cache/vcpkg/packages" }
        },
        {
            "name": "llvm",
            "hidden": true,
            "inherits": "tree",
            "cacheVariables": { "VCPKG_TARGET_TRIPLET": "llvm", "VCPKG_HOST_TRIPLET": "llvm", "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/.config/cmake/toolchains/llvm.cmake", "VCPKG_MANIFEST_FEATURES": "tests" }
        },
        { "name": "default", "inherits": "llvm", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "release", "inherits": "llvm", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        { "name": "asan", "inherits": "llvm", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "RASM_SANITIZERS": "address;undefined" } },
        { "name": "tsan", "inherits": "llvm", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "RASM_SANITIZERS": "thread" } },
        { "name": "fuzz", "inherits": "llvm", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "RASM_SANITIZERS": "fuzzer-no-link;address;undefined" } },
        { "name": "coverage", "inherits": "llvm", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "RASM_COVERAGE": true } },
        { "name": "lint", "inherits": "llvm", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--experimental-custom-checks", "CMAKE_OBJCXX_CLANG_TIDY": "clang-tidy;--experimental-custom-checks" } },
        {
            "name": "unreal",
            "inherits": "tree",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": false, "VCPKG_TARGET_TRIPLET": "unreal", "VCPKG_HOST_TRIPLET": "unreal", "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/.config/cmake/toolchains/unreal-${hostSystemName}.cmake" }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "tsan", "configurePreset": "tsan" },
        { "name": "fuzz", "configurePreset": "fuzz" },
        { "name": "coverage", "configurePreset": "coverage" },
        { "name": "coverage-report", "configurePreset": "coverage", "targets": [ "coverage" ] },
        { "name": "lint", "configurePreset": "lint" },
        { "name": "unreal", "configurePreset": "unreal" }
    ],
    "testPresets": [
        { "name": "report", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }, "filter": { "exclude": { "label": "benchmark" } } },
        { "name": "default", "inherits": "report", "configurePreset": "default" },
        { "name": "release", "inherits": "report", "configurePreset": "release" },
        {
            "name": "asan",
            "inherits": "report",
            "configurePreset": "asan",
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:check_initialization_order=1:strict_init_order=1:detect_stack_use_after_return=1:$penv{ASAN_OPTIONS}",
                "UBSAN_OPTIONS": "print_stacktrace=1:print_summary=1:halt_on_error=1:$penv{UBSAN_OPTIONS}"
            }
        },
        { "name": "tsan", "inherits": "report", "configurePreset": "tsan", "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:$penv{TSAN_OPTIONS}" } },
        { "name": "fuzz", "configurePreset": "fuzz", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "fuzz" } } },
        { "name": "coverage", "inherits": "report", "configurePreset": "coverage" },
        { "name": "bench", "configurePreset": "release", "output": { "verbosity": "verbose" }, "filter": { "include": { "label": "benchmark" } } }
    ],
    "packagePresets": [ { "name": "release", "configurePreset": "release", "generators": [ "TXZ" ] } ],
    "workflowPresets": [
        { "name": "default", "steps": [ { "type": "configure", "name": "default" }, { "type": "build", "name": "default" }, { "type": "test", "name": "default" } ] },
        { "name": "release", "steps": [ { "type": "configure", "name": "release" }, { "type": "build", "name": "release" }, { "type": "test", "name": "release" } ] },
        { "name": "asan", "steps": [ { "type": "configure", "name": "asan" }, { "type": "build", "name": "asan" }, { "type": "test", "name": "asan" } ] },
        { "name": "tsan", "steps": [ { "type": "configure", "name": "tsan" }, { "type": "build", "name": "tsan" }, { "type": "test", "name": "tsan" } ] },
        { "name": "fuzz", "steps": [ { "type": "configure", "name": "fuzz" }, { "type": "build", "name": "fuzz" }, { "type": "test", "name": "fuzz" } ] },
        { "name": "coverage", "steps": [ { "type": "configure", "name": "coverage" }, { "type": "build", "name": "coverage" }, { "type": "test", "name": "coverage" }, { "type": "build", "name": "coverage-report" } ] },
        { "name": "bench", "steps": [ { "type": "configure", "name": "release" }, { "type": "build", "name": "release" }, { "type": "test", "name": "bench" } ] },
        { "name": "lint", "steps": [ { "type": "configure", "name": "lint" }, { "type": "build", "name": "lint" } ] },
        { "name": "unreal", "steps": [ { "type": "configure", "name": "unreal" }, { "type": "build", "name": "unreal" } ] }
    ]
}
