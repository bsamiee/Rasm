{
    "name": "@rasm/hosting",
    "version": "0.1.0",
    "private": true,
    "description": "Web apps declared once and hosted on Node or Cloudflare Workers, with bindings, request identity, deployment, and streamed server rendering",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/hosting"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./app": "./app/app.ts",
        "./bundle": "./vite/bundle.ts",
        "./deploy": "./deploy/deploy.ts",
        "./head": "./vite/site-head.ts",
        "./hydrate": "./rendering/hydrate.ts",
        "./identity": "./app/identity.ts",
        "./server": {
            "workerd": "./server/workerd.ts",
            "default": "./server/node.ts"
        },
        "./shell": "./rendering/shell.ts",
        "./template": "./rendering/template.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./app": "./dist/app/app.js",
            "./bundle": "./dist/vite/bundle.js",
            "./deploy": "./dist/deploy/deploy.js",
            "./head": "./dist/vite/site-head.js",
            "./hydrate": "./dist/rendering/hydrate.js",
            "./identity": "./dist/app/identity.js",
            "./server": {
                "workerd": "./dist/server/workerd.js",
                "default": "./dist/server/node.js"
            },
            "./shell": "./dist/rendering/shell.js",
            "./template": "./dist/rendering/template.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@types/web-app-manifest": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/build-output-utils": "catalog:",
        "@cloudflare/vite-plugin": "catalog:",
        "@cloudflare/workers-types": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/sql-sqlite-node": "catalog:",
        "@pulumi/cloudflare": "catalog:",
        "@pulumi/command": "catalog:",
        "@pulumi/pulumi": "catalog:",
        "@rasm/database": "workspace:*",
        "@rasm/mark": "workspace:*",
        "@rasm/object-storage": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vite-pwa/assets-generator": "catalog:",
        "cf": "catalog:",
        "cheerio": "catalog:",
        "culori": "catalog:",
        "effect": "catalog:",
        "miniflare": "catalog:",
        "postcss": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "@cloudflare/build-output-utils": "catalog:peers",
        "@cloudflare/vite-plugin": "catalog:peers",
        "@effect/platform-node": "catalog:peers",
        "@effect/sql-sqlite-node": "catalog:peers",
        "@pulumi/cloudflare": "catalog:peers",
        "@pulumi/command": "catalog:peers",
        "@pulumi/pulumi": "catalog:peers",
        "@rasm/database": "workspace:^",
        "@rasm/mark": "workspace:^",
        "@rasm/object-storage": "workspace:^",
        "@rasm/telemetry": "workspace:^",
        "@vite-pwa/assets-generator": "catalog:peers",
        "cf": "catalog:peers",
        "cheerio": "catalog:peers",
        "culori": "catalog:peers",
        "effect": "catalog:peers",
        "miniflare": "catalog:peers",
        "postcss": "catalog:peers",
        "react": "catalog:peers",
        "react-dom": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@cloudflare/build-output-utils": {
            "optional": true
        },
        "@cloudflare/vite-plugin": {
            "optional": true
        },
        "@effect/platform-node": {
            "optional": true
        },
        "@effect/sql-sqlite-node": {
            "optional": true
        },
        "@pulumi/cloudflare": {
            "optional": true
        },
        "@pulumi/command": {
            "optional": true
        },
        "@pulumi/pulumi": {
            "optional": true
        },
        "@rasm/database": {
            "optional": true
        },
        "@rasm/mark": {
            "optional": true
        },
        "@rasm/object-storage": {
            "optional": true
        },
        "@rasm/telemetry": {
            "optional": true
        },
        "@vite-pwa/assets-generator": {
            "optional": true
        },
        "cf": {
            "optional": true
        },
        "cheerio": {
            "optional": true
        },
        "culori": {
            "optional": true
        },
        "miniflare": {
            "optional": true
        },
        "postcss": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
