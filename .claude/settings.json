{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "80",
        "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
        "BASH_DEFAULT_TIMEOUT_MS": "300000"
    },
    "permissions": {
        "deny": [ "mcp__rhino-mcp-platform__run_python", "mcp__rhino-mcp-platform__g1_*", "mcp__blender__*_for_cli", "mcp__binlog__stop", "mcp__binlog__stop_instance", "mcp__roslyn-codelens__load_solution", "mcp__roslyn-codelens__unload_solution", "mcp__roslyn-codelens__set_active_solution" ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [ { "type": "command", "command": "echo 'eval \"$(mise env -s bash)\"' > \"$CLAUDE_ENV_FILE\"" }, { "type": "command", "command": "mise exec -- pitchfork project enter --pid \"$PPID\" && mise daemons start" } ]
            }
        ]
    },
    "enableAllProjectMcpServers": true,
    "disabledMcpjsonServers": [ "greptile", "arena" ],
    "worktree": {
        "bgIsolation": "none"
    },
    "enabledPlugins": {
        "function-hooks@rasm": true,
        "astral@astral-sh": true,
        "rust-analyzer-lsp@claude-plugins-official": true,
        "swift-lsp@claude-plugins-official": true
    },
    "extraKnownMarketplaces": {
        "rasm": {
            "source": {
                "source": "directory",
                "path": "./plugins"
            },
            "autoUpdate": true
        },
        "astral-sh": {
            "source": {
                "source": "github",
                "repo": "astral-sh/agent-plugins"
            },
            "autoUpdate": true
        }
    },
    "effortLevel": "high",
    "showClearContextOnPlanAccept": true,
    "claudeMdExcludes": [ "**/.cache/**/CLAUDE.md", "**/node_modules/**/CLAUDE.md", "**/.venv/**/CLAUDE.md", "**/.artifacts/**/CLAUDE.md" ]
}
