language js(typescript, jsx)

or {
    `return null`,
    `return undefined`,
    arrow_function(body=$body) where {
        $body <: or {
            `null`,
            `undefined`
        }
    }
} as $hit where {
    register_diagnostic(span=$hit, message="Absence sentinel returned from domain flow. Absence is Option: Array.head, Option.fromNullable at the boundary, Option.none in the interior; an arrow whose whole body is the sentinel is the same defect.", severity="error")
}
