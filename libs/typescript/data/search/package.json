{
    "name": "@rasm/search",
    "version": "0.1.0",
    "description": "Name lookup with fuzzy-ranked near matches, and the decimal digits of every Intl numbering system with their fold to ASCII",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/data/search"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./digits": "./digits.ts",
        "./unmatched": "./unmatched.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./digits": "./dist/digits.js",
            "./unmatched": "./dist/unmatched.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@leeoniya/ufuzzy": "catalog:"
    },
    "devDependencies": {
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
