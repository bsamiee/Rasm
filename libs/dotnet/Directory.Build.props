<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!-- [PROPERTIES] ──────────────────────────────────────────────────────────────── -->

    <PropertyGroup Label="Libraries">
        <IsPackable>true</IsPackable>
        <PackageTags>rasm;$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))))</PackageTags>
    </PropertyGroup>
</Project>
