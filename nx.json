{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "cacheDirectory": ".cache/nx/cache",
    "neverConnectToCloud": true,
    "useDaemonProcess": false,
    "namedInputs": {
        "production": ["default", "!{projectRoot}/**/*.{spec,test,bench}.{ts,tsx,mts,cts}"],
        "dotnet": ["{workspaceRoot}/{global.json,NuGet.config,Directory.Build.props,Directory.Build.targets,Directory.Packages.props}", { "externalDependencies": [] }, { "runtime": "dotnet --version" }],
        "rhino": [{ "env": "RHINO_PATH" }, { "runtime": "plutil -extract CFBundleVersion raw \"$RHINO_PATH/Contents/Info.plist\"" }],
        "python": ["{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock", { "externalDependencies": [] }, { "runtime": "uv --version" }, { "runtime": "python --version" }],
        "blender": [{ "env": "BLENDER_PATH" }, { "runtime": "\"$BLENDER_PATH\" --version" }],
        "xcode": [{ "externalDependencies": [] }, { "runtime": "xcodebuild -version" }],
        "typescript": [{ "json": "{workspaceRoot}/package.json", "fields": ["type", "imports"] }, { "runtime": "node --version" }],
        "pythonFiles": ["{workspaceRoot}/**/*.{py,pyi}"],
        "yamlFiles": ["{workspaceRoot}/**/*.{yml,yaml}"],
        "javaFiles": ["{workspaceRoot}/**/*.java"]
    },
    "targetDefaults": {
        "build{,:*}": [
            { "cache": true },
            { "filter": { "projects": ["tag:host:rhino"] }, "inputs": ["...", "rhino"] },
            { "filter": { "projects": ["tag:host:rhino", "!directory:libs/**"] }, "inputs": ["...", "icons"], "options": { "args": ["--no-restore"] }, "configurations": { "debug": { "args": ["--no-restore", "--configuration", "Debug"] }, "release": { "args": ["--no-restore", "--configuration", "Release"] } } },
            { "filter": { "plugin": "@nx/dotnet" }, "dependsOn": ["...", { "projects": ["rasm"], "target": "restore" }] },
            { "filter": { "projects": ["tag:language:dotnet"] }, "command": "dotnet build -bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/build-{}.binlog", "inputs": ["...", "dotnet"] },
            {
                "filter": { "projects": ["tag:language:swift"] },
                "executor": "nx:run-commands",
                "cache": false,
                "inputs": ["default", "xcode", "{workspaceRoot}/Xcode.xcconfig"],
                "options": {
                    "cwd": "{projectRoot}",
                    "commands": [
                        "xcodebuild -scheme {projectName} -destination platform=macOS -derivedDataPath $NX_WORKSPACE_ROOT/.cache/xcode/{projectRoot} -packageCachePath $NX_WORKSPACE_ROOT/.cache/swiftpm/cache -disableAutomaticPackageResolution build",
                        { "command": "xcode-build-server config -scheme {projectName} --build_root $NX_WORKSPACE_ROOT/.cache/xcode/{projectRoot}", "forwardAllArgs": false }
                    ],
                    "parallel": false
                }
            },
            { "filter": { "projects": ["tag:language:typescript"] }, "inputs": ["production", "^production", "typescript"] },
            { "filter": { "projects": ["tag:bundler:vite"] }, "command": "vite build", "options": { "cwd": "{projectRoot}" }, "inputs": ["...", { "externalDependencies": ["vite"] }], "configurations": { "serve": { "command": "vite" } }, "outputs": ["{projectRoot}/dist"] },
            {
                "filter": { "projects": ["tag:host:uxp"] },
                "command": "vite build --config $NX_WORKSPACE_ROOT/vite.config.ts",
                "options": { "cwd": "{projectRoot}" },
                "inputs": ["...", "{workspaceRoot}/vite.config.ts", { "externalDependencies": ["vite", "@effect/platform-node"] }],
                "outputs": ["{workspaceRoot}/.artifacts/{projectRoot}"]
            },
            { "filter": { "projects": ["tag:host:extendscript"] }, "command": "swc {projectRoot} -d .artifacts --out-file-extension jsx --ignore '**/node_modules/**'", "inputs": ["...", { "externalDependencies": ["@swc/core", "@swc/cli"] }], "outputs": ["{workspaceRoot}/.artifacts/{projectRoot}"] }
        ],
        "pack": [
            {
                "filter": { "projects": ["tag:host:rhino"] },
                "cache": true,
                "dependsOn": [{ "projects": ["rasm"], "target": "restore" }],
                "inputs": ["production", "^production", "{workspaceRoot}/.editorconfig", "dotnet", "rhino", "icons", { "runtime": "yak version" }],
                "parallelism": false
            },
            {
                "filter": { "projects": ["tag:host:blender"] },
                "cache": false,
                "inputs": ["...", "production", "python", "blender", "{workspaceRoot}/eng/python/fitout/**/*.py", { "runtime": "pip --version" }]
            }
        ],
        "install": [
            {
                "filter": { "projects": ["tag:language:swift"] },
                "executor": "nx:run-commands",
                "options": {
                    "commands": [
                        "rm -rf .artifacts/{projectRoot}/install",
                        "xcodebuild -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -configuration Release -destination platform=macOS -derivedDataPath .cache/xcode/{projectRoot} -packageCachePath $NX_WORKSPACE_ROOT/.cache/swiftpm/cache -disableAutomaticPackageResolution install DSTROOT=\"$NX_WORKSPACE_ROOT/.artifacts/{projectRoot}/install\"",
                        "sudo ditto .artifacts/{projectRoot}/install /"
                    ],
                    "parallel": false
                },
                "parallelism": false
            },
            { "filter": { "projects": ["tag:host:rhino"] }, "dependsOn": ["pack"], "parallelism": false },
            {
                "filter": { "projects": ["tag:host:blender"] },
                "cache": false,
                "dependsOn": ["pack"],
                "inputs": ["python", "blender", "{workspaceRoot}/eng/python/fitout/**/*.py", { "dependentTasksOutputFiles": "**/extension.zip" }, { "env": "BLENDER_MCP_URL" }],
                "parallelism": false
            }
        ],
        "upgrade": [
            {
                "filter": { "projects": ["tag:language:swift"] },
                "executor": "nx:run-commands",
                "options": {
                    "commands": [
                        "rm -f {projectRoot}/{projectName}.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved .cache/xcode/{projectRoot}/SourcePackages/workspace-state.json",
                        "xcodebuild -resolvePackageDependencies -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -derivedDataPath .cache/xcode/{projectRoot} -packageCachePath $NX_WORKSPACE_ROOT/.cache/swiftpm/cache"
                    ],
                    "parallel": false
                }
            }
        ],
        "lint": [
            {
                "filter": { "projects": ["tag:language:swift"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "xcode", "{workspaceRoot}/.swift-format", "{workspaceRoot}/.swiftlint.yml", { "runtime": "swiftlint version" }],
                "options": { "commands": ["xcrun swift-format lint --strict --parallel --recursive {projectRoot}", "swiftlint lint --quiet {projectRoot}"], "parallel": false }
            }
        ],
        "format": [{ "filter": { "projects": ["tag:language:swift"] }, "executor": "nx:run-commands", "options": { "commands": ["swiftlint lint --fix --quiet {projectRoot}", "xcrun swift-format format --in-place --parallel --recursive {projectRoot}"], "parallel": false } }],
        "typecheck": [
            { "filter": { "projects": ["tag:language:dotnet"] }, "executor": "nx:noop", "dependsOn": ["build"] },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "command": "tsc --build --pretty false",
                "cache": true,
                "inputs": ["default", "^default", "typescript", { "externalDependencies": ["typescript"] }],
                "options": { "cwd": "{projectRoot}" },
                "outputs": ["{workspaceRoot}/.cache/typescript/out/{projectRoot}"]
            }
        ],
        "typecheck:ty{,-*}": { "cache": true, "parallelism": false, "inputs": ["python", "pythonFiles", { "runtime": "ty --version" }] },
        "typecheck:mypy{,-*}": { "cache": true, "inputs": ["python", "pythonFiles", { "runtime": "mypy --version" }] },
        "test": [
            { "cache": true },
            { "filter": { "projects": ["tag:language:dotnet"] }, "inputs": ["...", "dotnet"], "outputs": ["{workspaceRoot}/.artifacts/dotnet/coverage/{projectName}"] },
            {
                "filter": { "projects": ["tag:language:python"] },
                "command": "pytest {projectRoot} --cov",
                "inputs": ["default", "^default", "python"],
                "outputs": ["{workspaceRoot}/.artifacts/python/coverage/data/.coverage.{projectName}"],
                "options": { "env": { "COVERAGE_FILE": ".artifacts/python/coverage/data/.coverage.{projectName}" } }
            },
            {
                "filter": { "projects": ["tag:language:typescript"], "plugin": "@nx/vitest" },
                "inputs": ["...", "typescript", "{workspaceRoot}/vitest.config.ts", { "externalDependencies": ["@effect/platform-node", "@effect/vitest", "yaml"] }],
                "outputs": ["{workspaceRoot}/.artifacts/typescript/coverage/{projectName}"]
            }
        ],
        "check": [{ "filter": { "projects": ["tag:language:*"] }, "executor": "nx:noop", "dependsOn": ["typecheck", "test"] }, { "filter": { "projects": ["tag:language:swift"] }, "dependsOn": [{ "target": "build", "params": "forward" }, "lint"] }]
    },
    "plugins": [{ "plugin": "@nx/vitest", "include": ["**/vitest.config.ts"], "exclude": ["vitest.config.ts"], "options": { "testMode": "run" } }, { "plugin": "@nx/dotnet", "options": { "clean": false, "pack": false, "publish": false, "restore": false, "watch": false } }, { "plugin": "./tools/nx/workspace.ts" }]
}
