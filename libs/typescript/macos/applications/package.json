{
    "name": "@rasm/applications",
    "version": "0.1.0",
    "description": "Wire contract and Node client of a Mac application server watching installed and running apps, with their catalog, interface map, and plug-in description contract",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/macos/applications"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./server/*": "./server/*.ts",
        "./catalog": "./catalog/catalog.ts",
        "./map": "./map/map.ts",
        "./description": "./description/description.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./server/*": "./dist/server/*.js",
            "./catalog": "./dist/catalog/catalog.js",
            "./map": "./dist/map/map.js",
            "./description": "./dist/description/description.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/sql-sqlite-node": "catalog:",
        "@rasm/current-process": "workspace:*",
        "@rasm/database": "workspace:*",
        "@rasm/process": "workspace:*",
        "@rasm/rpc": "workspace:*",
        "@rasm/search": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
