<Project>
    <PropertyGroup Label="Declared Shape">
        <RasmRole Condition="$(MSBuildProjectDirectory.StartsWith('$(RasmLibsRoot)'))">libs</RasmRole>
        <RasmRole Condition="$(MSBuildProjectDirectory.StartsWith('$(RasmToolsRoot)'))">tools</RasmRole>
        <RasmRole Condition="$(MSBuildProjectDirectory.StartsWith('$(RasmTestsRoot)'))">tests</RasmRole>
        <RasmRole Condition="$(MSBuildProjectDirectory.StartsWith('$(RasmAppsRoot)'))">apps</RasmRole>
        <_RasmHostTokens>;$(RasmHost);</_RasmHostTokens>
        <HostGrasshopper Condition="$(_RasmHostTokens.Contains(';grasshopper;')) or '$(RasmPlugin)' == 'grasshopper'">true</HostGrasshopper>
        <HostPlatform Condition="$(_RasmHostTokens.Contains(';platform;'))">true</HostPlatform>
        <HostUi Condition="$(_RasmHostTokens.Contains(';ui;')) or '$(HostPlatform)' == 'true' or '$(HostGrasshopper)' == 'true'">true</HostUi>
        <HostCommon Condition="$(_RasmHostTokens.Contains(';common;')) or '$(HostUi)' == 'true' or '$(RasmPlugin)' != ''">true</HostCommon>
    </PropertyGroup>

    <ItemGroup Label="Project Usings">
        <Using Include="LanguageExt;LanguageExt.Common;LanguageExt.Effects;LanguageExt.Pretty;LanguageExt.Traits;LanguageExt.Traits.Domain" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Core'))' != ''" />
        <Using Include="LanguageExt.Prelude" Static="true" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Core'))' != ''" />
        <Using Include="Thinktecture" Condition="'@(PackageReference->WithMetadataValue('Identity', 'Thinktecture.Runtime.Extensions'))' != ''" />
        <Using Include="Xunit" Condition="'@(PackageReference->WithMetadataValue('Identity', 'xunit.v3.mtp-v2'))' != '' or '@(PackageReference->WithMetadataValue('Identity', 'xunit.v3.assert'))' != ''" />
        <Using Include="CsCheck" Condition="'@(PackageReference->WithMetadataValue('Identity', 'CsCheck'))' != ''" />
    </ItemGroup>

    <ItemGroup Label="Rhino Host Assemblies" Condition="'$(HostCommon)' == 'true'">
        <_RhinoHostAssembly Include="RhinoCommon" />
        <_RhinoHostAssembly Include="Eto;System.Drawing.Common" Condition="'$(HostUi)' == 'true'" />
        <_RhinoHostAssembly Include="Eto.macOS;Microsoft.macOS;Rhino.UI" Condition="'$(HostPlatform)' == 'true'" />
        <Reference Include="@(_RhinoHostAssembly)" HintPath="$(RhinoResourcesPath)%(Identity).dll" Private="false" />
        <Reference Include="Grasshopper2;GrasshopperIO" HintPath="$(Grasshopper2PluginPath)%(Identity).dll" Private="false" Condition="'$(HostGrasshopper)' == 'true'" />
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="runtime" Condition="'$(HostUi)' == 'true'" />
        <Using Include="Rhino.Geometry" />
        <Using Include="Grasshopper2.Types.Numeric;Grasshopper2.UI" Condition="'$(HostGrasshopper)' == 'true'" />
    </ItemGroup>

    <ItemGroup Label="Rhino Plugin Metadata" Condition="'$(RasmPlugin)' != ''">
        <AssemblyAttribute Include="Rhino.PlugIns.PlugInDescriptionAttribute">
            <_Parameter1>Rhino.PlugIns.DescriptionType.Organization</_Parameter1>
            <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
            <_Parameter2>$(Company)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute" Condition="'$(RhinoPluginGuid)' != ''">
            <_Parameter1>$(RhinoPluginGuid)</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <PropertyGroup Label="Test Results" Condition="'$(IsTestProject)' == 'true'">
        <TestingPlatformCommandLineArguments>--results-directory "$(ArtifactsPath)test-results/$(MSBuildProjectName)/"</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <Target Name="VerifyRhinoHostBundle" BeforeTargets="ResolveAssemblyReferences" Condition="'$(HostCommon)' == 'true'">
        <ItemGroup>
            <_MissingRhinoHostFile Include="@(Reference->'%(HintPath)')" Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" />
        </ItemGroup>
        <Error Code="RASM0003" Condition="'@(_MissingRhinoHostFile)' != ''"
               Text="Rhino bundle '$(RhinoAppPath)' lacks @(_MissingRhinoHostFile->'%(Filename)%(Extension)', ', '); set RHINO_APP_PATH to a Rhino 9 bundle." />
    </Target>

    <Target Name="RasmReferenceRoleGuard" BeforeTargets="AssignProjectConfiguration" Condition="'@(ProjectReference)' != '' and '$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <_RasmDeclaredEdge Include="@(ProjectReference->'%(FullPath)')" Condition="'%(ProjectReference.RasmInfra)' != 'true'" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(RasmRole)' == 'libs' and !$([System.String]::Copy('%(Identity)').StartsWith('$(RasmLibsRoot)'))" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(RasmRole)' == 'tools' and !$([System.String]::Copy('%(Identity)').StartsWith('$(RasmLibsRoot)')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(RasmToolsRoot)')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(RasmTestsRoot)dotnet/testkit/')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(RasmTestsRoot)dotnet/scenariokit/'))" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(RasmRole)' == 'tests' and $([System.String]::Copy('%(Identity)').StartsWith('$(RasmAppsRoot)'))" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(RasmRole)' == 'apps' and !$([System.String]::Copy('%(Identity)').StartsWith('$(RasmLibsRoot)')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(MSBuildProjectDirectory)'))" />
        </ItemGroup>
        <Error Code="RASM0001" Condition="'@(_RasmUnlawfulEdge)' != ''"
               Text="Role '$(RasmRole)' project '$(MSBuildProjectName)' references outside its allowed set: @(_RasmUnlawfulEdge->'%(Identity)', '; ')." />
    </Target>

    <Target Name="RasmProjectShapeGuard" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_RasmShapeBreach>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(MSBuildProjectFullPath))), '&lt;(NoWarn|WarningsNotAsErrors|TreatWarningsAsErrors|AnalysisLevel|RunAnalyzers|EnforceCodeStyleInBuild|ArtifactsPath|BaseOutputPath|BaseIntermediateOutputPath|OutputPath|Version|VersionPrefix|VersionSuffix|PackageVersion|InformationalVersion)[ &gt;/]').Value)</_RasmShapeBreach>
            <_RasmShapeBreach Condition="'$(_RasmShapeBreach)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(MSBuildProjectFullPath))), 'PackageReference[^&gt;]*\s(Version|VersionOverride)\s*=').Value)</_RasmShapeBreach>
        </PropertyGroup>
        <Error Code="RASM0002" Condition="'$(_RasmShapeBreach)' != ''"
               Text="Project manifest '$(MSBuildProjectFile)' carries a policy element ('$(_RasmShapeBreach.Trim())…'): versions ride CPM, severities ride .editorconfig, output and analysis posture ride the root project." />
    </Target>

    <Target Name="GetDynamicLoadPayload" DependsOnTargets="Build" Returns="@(_DynamicLoadPayload)">
        <ItemGroup>
            <_DynamicLoadPayload Include="$(TargetPath);$(ProjectDepsFilePath);@(ReferenceCopyLocalPaths)" />
        </ItemGroup>
    </Target>

    <Target Name="GetDynamicLoadEntry" DependsOnTargets="Build" Returns="@(_DynamicLoadEntry)">
        <ItemGroup>
            <_DynamicLoadEntry Include="$(TargetPath);$(ProjectDepsFilePath)" />
        </ItemGroup>
    </Target>

    <Target Name="_CollectPayloadProjects">
        <ItemGroup>
            <_PayloadProject Include="@(ProjectReference)" Condition="'%(ProjectReference.RasmPayload)' != ''" />
        </ItemGroup>
    </Target>

    <Target Name="StageDynamicPayload" AfterTargets="Build" DependsOnTargets="_CollectPayloadProjects" Outputs="%(_PayloadProject.RasmPayload)">
        <PropertyGroup Condition="'@(_PayloadProject)' != ''">
            <_PayloadSlotDirectory>$(TargetDir)payload/%(_PayloadProject.RasmPayload)/</_PayloadSlotDirectory>
            <_PayloadSlotTarget>GetDynamicLoadEntry</_PayloadSlotTarget>
            <_PayloadSlotTarget Condition="'%(_PayloadProject.RasmPayload)' == 'cargo'">GetDynamicLoadPayload</_PayloadSlotTarget>
        </PropertyGroup>
        <MSBuild Projects="@(_PayloadProject)" Targets="$(_PayloadSlotTarget)" BuildInParallel="true">
            <Output TaskParameter="TargetOutputs" ItemName="_PayloadSlotFile" />
        </MSBuild>
        <RemoveDir Directories="$(_PayloadSlotDirectory)" Condition="'$(_PayloadSlotDirectory)' != ''" />
        <Copy SourceFiles="@(_PayloadSlotFile)" DestinationFolder="$(_PayloadSlotDirectory)" Condition="'$(_PayloadSlotDirectory)' != ''">
            <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
        </Copy>
        <ItemGroup>
            <_PayloadSlotFile Remove="@(_PayloadSlotFile)" />
        </ItemGroup>
    </Target>

    <PropertyGroup Label="Yak Packaging" Condition="'$(YakPackageSlug)' != ''">
        <YakManifestDirectory>$(RasmToolsRoot)yak/$(YakPackageSlug)/</YakManifestDirectory>
        <YakPackageDirectory>$(ArtifactsPath)rhino/$(YakPackageSlug)/package/</YakPackageDirectory>
        <YakPushSource Condition="'$(YakPushSource)' == '' and '$(YAK_SOURCE)' != ''">$(YAK_SOURCE)</YakPushSource>
    </PropertyGroup>

    <Target Name="YakStage" DependsOnTargets="GetDynamicLoadPayload" Condition="'$(YakPackageSlug)' != ''">
        <MSBuild Projects="@(YakPayloadProject)" Targets="GetDynamicLoadPayload" BuildInParallel="true">
            <Output TaskParameter="TargetOutputs" ItemName="_YakStagedPayload" />
        </MSBuild>
        <ItemGroup>
            <_YakStagedPayload Include="@(_DynamicLoadPayload);$(YakManifestDirectory)manifest.yml" />
        </ItemGroup>
        <Error Condition="!Exists('$(YakPath)')" Text="Yak executable not found at '$(YakPath)'." />
        <RemoveDir Directories="$(YakPackageDirectory)" />
        <Copy SourceFiles="@(_YakStagedPayload)" DestinationFolder="$(YakPackageDirectory)" />
    </Target>

    <Target Name="YakBuild" DependsOnTargets="YakStage" Condition="'$(YakPackageSlug)' != ''">
        <Exec Command="&quot;$(YakPath)&quot; build --platform mac" WorkingDirectory="$(YakPackageDirectory)" />
        <ItemGroup>
            <_YakPackageFile Include="$(YakPackageDirectory)*.yak" />
        </ItemGroup>
        <Error Condition="'@(_YakPackageFile->Count())' != '1'" Text="Yak build must produce exactly one package under '$(YakPackageDirectory)'." />
    </Target>

    <Target Name="YakInstall" DependsOnTargets="YakBuild" Condition="'$(YakPackageSlug)' != ''">
        <Exec Command="&quot;$(YakPath)&quot; install &quot;@(_YakPackageFile)&quot;" />
    </Target>

    <Target Name="YakPush" DependsOnTargets="YakBuild" Condition="'$(YakPackageSlug)' != ''">
        <Exec Command="&quot;$(YakPath)&quot; push --source &quot;$(YakPushSource)&quot; &quot;@(_YakPackageFile)&quot;" Condition="'$(YakPushSource)' != ''" />
        <Exec Command="&quot;$(YakPath)&quot; push &quot;@(_YakPackageFile)&quot;" Condition="'$(YakPushSource)' == ''" />
    </Target>
</Project>
