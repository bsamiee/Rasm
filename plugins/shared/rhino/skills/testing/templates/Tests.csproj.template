<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="Test Application">
        <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
        <GenerateSelfRegisteredExtensions>true</GenerateSelfRegisteredExtensions>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>Interface;Headless</Configurations>
        <Configuration>Interface</Configuration>
        <TestingPlatformCommandLineArguments>--report-trx --report-trx-filename {asm}_{tfm}_{arch}_{time}.trx --hangdump --hangdump-timeout 10m --hangdump-type Mini --crashdump --crashdump-type Mini --crash-report-if-supported</TestingPlatformCommandLineArguments>
        <RhinoVersion>9.0.26300.9401</RhinoVersion>
        <_RhinoMajor>$(RhinoVersion.Split(`.`)[0])</_RhinoMajor>
        <_RhinoBoot>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_RhinoBoot>
    </PropertyGroup>

    <PropertyGroup Label="Test Host" Condition="'$(_RhinoBoot)' == ''">
        <RhinoApplication>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/Applications/Rhino $(_RhinoMajor).app</RhinoApplication>
        <RhinoApplication Condition="!Exists('$(RhinoApplication)')">/Applications/Rhino $(_RhinoMajor).app</RhinoApplication>
        <IsTestProject Condition="!$([MSBuild]::IsOSPlatform(`OSX`))">false</IsTestProject>
        <IsTestingPlatformApplication Condition="!$([MSBuild]::IsOSPlatform(`OSX`))">false</IsTestingPlatformApplication>
    </PropertyGroup>

    <PropertyGroup Label="Test Host" Condition="'$(_RhinoBoot)' == 'windows'">
        <RhinoApplication>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\McNeel\Rhinoceros\$(_RhinoMajor).0\Install', 'CoreDllPath', '', RegistryView.Registry64))</RhinoApplication>
        <IsTestProject Condition="!$([MSBuild]::IsOSPlatform(`Windows`))">false</IsTestProject>
        <IsTestingPlatformApplication Condition="!$([MSBuild]::IsOSPlatform(`Windows`))">false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup Label="Test Host">
        <ProjectCapability Include="RuntimeEnvironmentVariableSupport" />
        <RuntimeHostConfigurationOption Include="RhinoVersion" Value="$(RhinoVersion)" />
        <RuntimeHostConfigurationOption Include="RhinoMode" Value="$(Configuration)" Condition="'$(Configuration)' == 'Interface'" />
        <PackageReference Include="Microsoft.macOS.Ref.net10.0_27.0" Version="27.0.10742" ExcludeAssets="all" GeneratePathProperty="true" />
        <Reference Include="$(PkgMicrosoft_macOS_Ref_net10_0_27_0)/ref/net$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2))/Microsoft.macOS.dll" Private="false" />
    </ItemGroup>

    <ItemGroup Label="Test Host" Condition="'$(_RhinoBoot)' == ''">
        <Compile Remove="Windows.cs" />
    </ItemGroup>

    <ItemGroup Label="Test Host" Condition="'$(_RhinoBoot)' == 'windows'">
        <Compile Remove="Darwin.cs" />
        <PackageReference Include="Rhino.Inside" Version="9.0.26321.3440-beta" />
    </ItemGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="RhinoCommon" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Grasshopper" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Grasshopper2" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Label="Property Testing">
        <PackageReference Include="CsCheck" Version="5.0.1" />
        <RuntimeEnvironmentVariable Include="CsCheck_Threads" Value="1" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
        <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    </ItemGroup>

    <ItemGroup Label="Subject">
        <ProjectReference Include="../Library/Library.csproj" />
    </ItemGroup>

    <Target Name="ResolveRhinoApplication" AfterTargets="ResolvePackageAssets" BeforeTargets="ComputeRunArguments" DependsOnTargets="ResolvePackageAssets" Condition="'$(IsTestProject)' == 'true'">
        <PropertyGroup>
            <_RhinoArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_RhinoArchitecture>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_RhinoBoot)' == ''">
            <_RhinoResources>$(RhinoApplication)/Contents/Frameworks/RhCore.framework/Resources/</_RhinoResources>
            <RunCommand>$(_RhinoResources)dotnet/$(_RhinoArchitecture)/dotnet</RunCommand>
        </PropertyGroup>
        <ItemGroup Condition="'$(_RhinoBoot)' == ''">
            <RuntimeEnvironmentVariable Include="DYLD_INSERT_LIBRARIES" Value="$(TargetDir)libbackground.dylib" />
        </ItemGroup>
        <PropertyGroup Condition="'$(_RhinoBoot)' == 'windows'">
            <_RhinoResources>$([System.IO.Path]::GetDirectoryName('$(RhinoApplication)'))\netcore\</_RhinoResources>
            <RunCommand>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\dotnet\Setup\InstalledVersions\$(_RhinoArchitecture)', 'InstallLocation', '', RegistryView.Registry32))dotnet.exe</RunCommand>
        </PropertyGroup>
        <PropertyGroup>
            <RunArguments>exec &quot;$(TargetPath)&quot; $(RunArguments)</RunArguments>
        </PropertyGroup>
        <Error Condition="!Exists('$(RhinoApplication)') or !Exists('$(RunCommand)')" Text="$(MSBuildProjectName) builds and runs against Rhino $(_RhinoMajor), absent at '$(RhinoApplication)' with its .NET runtime at '$(RunCommand)'" />
        <ItemGroup>
            <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="Exists('$(_RhinoResources)%(Filename)%(Extension)')" />
        </ItemGroup>
    </Target>

    <Target Name="BuildBackground" BeforeTargets="CopyFilesToOutputDirectory" Inputs="Background.m" Outputs="$(TargetDir)libbackground.dylib" Condition="'$(IsTestProject)' == 'true' and '$(_RhinoBoot)' == ''">
        <Exec Command="xcrun clang -dynamiclib -fobjc-arc -O2 -Wall -Werror -Wno-deprecated-declarations -framework AppKit -framework ApplicationServices -o &quot;$(TargetDir)libbackground.dylib&quot; Background.m" />
        <ItemGroup>
            <FileWrites Include="$(TargetDir)libbackground.dylib" />
        </ItemGroup>
    </Target>
</Project>
