<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>RhinoCommon as typed effects, with plug-ins declared as data</Description>
        <IsPackable>true</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzers</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Microsoft.Win32.SystemEvents" Condition="'$(TargetPlatformIdentifier)' != 'Windows'" />
        <PackageReference Include="RhinoCommon" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.HighPerformance" />
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="LanguageExt.Streaming" />
        <PackageReference Include="Microsoft.VisualStudio.Threading" />
        <PackageReference Include="Mono.Unix" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Json" />
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="MathNet.Numerics" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="QuikGraph" />
        <PackageReference Include="SuperLinq" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Parsing">
        <PackageReference Include="ini-parser-netstandard" />
    </ItemGroup>

    <ItemGroup Label="Observability">
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" />
        <PackageReference Include="OpenTelemetry.Resources.OperatingSystem" />
        <PackageReference Include="OpenTelemetry.Resources.Process" />
        <PackageReference Include="OpenTelemetry.Resources.ProcessRuntime" />
    </ItemGroup>

    <ItemGroup Label="Application Hosting">
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup Label="User Interface">
        <PackageReference Include="CommunityToolkit.Mvvm" />
    </ItemGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../../drawing/Rasm.Drafting/Rasm.Drafting.csproj" />
        <ProjectReference Include="../../runtime/Rasm.Telemetry.Api/Rasm.Telemetry.Api.csproj" />
        <ProjectReference Include="../../runtime/Rasm.Telemetry/Rasm.Telemetry.csproj" />
    </ItemGroup>

    <ItemGroup Label="Package Files">
        <None Include="buildTransitive/*" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>

    <Target Name="PackAnalyzers" DependsOnTargets="ResolveProjectReferences" Condition="'$(TargetFramework)' == '$(RepoTargetFramework)'">
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(Analyzer->HasMetadata('PackagePath'))" />
        </ItemGroup>
    </Target>
</Project>
