{
    "name": "@rasm/cep",
    "private": true,
    "description": "Requests served from a CEP extension through its host's ExtendScript",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./panel": "./panel.ts"
    },
    "dependencies": {
        "@rasm/automation": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:",
        "fast-xml-builder": "catalog:"
    }
}
