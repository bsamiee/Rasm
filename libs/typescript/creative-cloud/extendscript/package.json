{
    "name": "@rasm/extendscript",
    "version": "0.1.0",
    "private": true,
    "description": "ExtendScript host script, reply protocol, ES3 lowering, and Vite builds for scripts Adobe hosts run",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/extendscript"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./completion": "./completion.ts",
        "./host": "./host.ts",
        "./node": "./node.ts",
        "./vite": "./vite.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./completion": "./dist/completion.js",
            "./host": "./dist/host.js",
            "./node": "./dist/node.js",
            "./vite": "./dist/vite.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/object-model": "workspace:*",
        "@rasm/process": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/vite": "workspace:*",
        "@swc/wasm": "catalog:",
        "acorn": "catalog:",
        "acorn-walk": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
