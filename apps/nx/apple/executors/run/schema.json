{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": 2,
    "type": "object",
    "properties": {
        "runs": {
            "type": "array",
            "description": "Invocations the plugin infers, each a program and its arguments",
            "items": {
                "type": "array",
                "minItems": 1,
                "items": [
                    {
                        "type": "string"
                    }
                ],
                "additionalItems": {
                    "type": "string"
                }
            }
        },
        "env": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            },
            "description": "Environment variables every invocation runs with, over the caller's"
        },
        "applications": {
            "type": "array",
            "description": "Application bundles the invocations install, a running one named in the last line as needing a relaunch",
            "items": {
                "type": "string"
            }
        },
        "args": {
            "type": "array",
            "description": "Arguments appended to every invocation",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [ "runs" ],
    "additionalProperties": true,
    "title": "Run",
    "description": "Runs swift and xcodebuild invocations in order with Nx's per-task environment removed, stopping at the first failure"
}
