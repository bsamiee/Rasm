{
    "name": "@rasm/hosting",
    "version": "0.1.0",
    "private": true,
    "description": "One web app declared once and hosted by any provider: its bindings, sign-in source and enrollment, Node bundle, server, and container, Cloudflare Worker configuration and deployment, OpenAI Sites metadata, head assets, and server-rendered page",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/hosting"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./bundle": "./vite/node-bundle.ts",
        "./cloudflare": "./cloudflare/worker-config.ts",
        "./container": "./node/node-container.ts",
        "./deploy": "./cloudflare/worker-deploy.ts",
        "./head": "./vite/site-head.ts",
        "./hydrate": "./rendering/hydrate.ts",
        "./identity": "./app/identity.ts",
        "./node": "./node/node-server.ts",
        "./shell": "./rendering/shell.ts",
        "./template": "./rendering/template.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./bundle": "./dist/vite/node-bundle.js",
            "./cloudflare": "./dist/cloudflare/worker-config.js",
            "./container": "./dist/node/node-container.js",
            "./deploy": "./dist/cloudflare/worker-deploy.js",
            "./head": "./dist/vite/site-head.js",
            "./hydrate": "./dist/rendering/hydrate.js",
            "./identity": "./dist/app/identity.js",
            "./node": "./dist/node/node-server.js",
            "./shell": "./dist/rendering/shell.js",
            "./template": "./dist/rendering/template.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@types/web-app-manifest": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/build-output-utils": "catalog:",
        "@effect/platform-node": "catalog:",
        "@pulumi/cloudflare": "catalog:",
        "@pulumi/command": "catalog:",
        "@pulumi/pulumi": "catalog:",
        "@rasm/mark": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vite-pwa/assets-generator": "catalog:",
        "cf": "catalog:",
        "cheerio": "catalog:",
        "culori": "catalog:",
        "effect": "catalog:",
        "postcss": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "@cloudflare/build-output-utils": "catalog:peers",
        "@effect/platform-node": "catalog:peers",
        "@pulumi/cloudflare": "catalog:peers",
        "@pulumi/command": "catalog:peers",
        "@pulumi/pulumi": "catalog:peers",
        "@rasm/mark": "workspace:^",
        "@rasm/telemetry": "workspace:^",
        "@vite-pwa/assets-generator": "catalog:peers",
        "cf": "catalog:peers",
        "cheerio": "catalog:peers",
        "culori": "catalog:peers",
        "effect": "catalog:peers",
        "postcss": "catalog:peers",
        "react": "catalog:peers",
        "react-dom": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@cloudflare/build-output-utils": {
            "optional": true
        },
        "@effect/platform-node": {
            "optional": true
        },
        "@pulumi/cloudflare": {
            "optional": true
        },
        "@pulumi/command": {
            "optional": true
        },
        "@pulumi/pulumi": {
            "optional": true
        },
        "@rasm/mark": {
            "optional": true
        },
        "@rasm/telemetry": {
            "optional": true
        },
        "@vite-pwa/assets-generator": {
            "optional": true
        },
        "cf": {
            "optional": true
        },
        "cheerio": {
            "optional": true
        },
        "culori": {
            "optional": true
        },
        "postcss": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": "^24.14.0 || >=25.4.0"
    }
}
