<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Foundation for building any Grasshopper 2 plug-in, extending Rasm.Rhino to Grasshopper documents, components, and canvas</Description>
    </PropertyGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Grasshopper2" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="QuikGraph" />
        <PackageReference Include="QuikGraph.Graphviz" />
    </ItemGroup>

    <ItemGroup Label="Solvers">
        <PackageReference Include="Kiwi" />
    </ItemGroup>

    <ItemGroup Label="Workspace Packages">
        <ProjectReference Include="../../graphics/Rasm.Imaging/Rasm.Imaging.csproj" />
        <ProjectReference Include="../Rasm.Rhino/Rasm.Rhino.csproj" />
    </ItemGroup>

    <ItemGroup Label="Workspace Sources">
        <Compile Include="../../ValidationResults.cs" />
    </ItemGroup>
</Project>
