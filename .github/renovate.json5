{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: ['config:best-practices'],
    // Token RENOVATE_TOKEN reads no account email, so Renovate discovers no author of its own
    gitAuthor: 'Renovate <renovate@parametric-arsenal.cloud>',
    lockFileMaintenance: { enabled: true, schedule: ['* 0-3 * * *'] },
    automerge: true,
    // The repository requires no status checks, so Renovate merges after every check passes in place of GitHub auto-merge
    platformAutomerge: false,
    packageRules: [
        // Group blender of a Blender root pins the versions Blender bundles, which a Blender release alone moves
        { matchManagers: ['pep621'], matchJsonata: ["managerData.depGroup = 'blender'"], enabled: false },
        // mise installs conda rows from channel conda-forge, which the conda datasource reads from its registry URL
        { matchManagers: ['mise'], matchDatasources: ['conda'], registryUrls: ['https://api.anaconda.org/package/conda-forge/'] },
        // Renovate keeps the #subdirectory fragment of a pypi git row in the repository address it lists refs of
        { matchManagers: ['mise'], matchPackageNames: ['https://projects.blender.org/lab/blender_mcp.git#subdirectory=mcp'], overridePackageName: 'https://projects.blender.org/lab/blender_mcp.git' },
        // Alias @typescript/native pins the native TypeScript build @effect/tsgo supports, which an @effect/tsgo release alone moves
        { matchDepNames: ['@typescript/native'], enabled: false },
        // SemVer orders build dev57 under tag latest of @duckdb/duckdb-wasm above the later dev114 under tag next, so the row follows next
        { matchDepNames: ['@duckdb/duckdb-wasm'], followTag: 'next' },
    ],
}
