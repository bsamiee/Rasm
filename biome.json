{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "ignoreUnknown": true,
        "includes": [ "**", "!!.venv", "!!.cache", "!!.artifacts", "!**/*.xcassets", "!**/*.icon" ]
    },
    "formatter": { "useEditorconfig": true, "lineWidth": 320 },
    "javascript": { "formatter": { "quoteStyle": "single" }, "resolver": { "experimentalPnpmCatalogs": true } },
    "json": { "formatter": { "expand": "auto", "delimiterSpacing": true } },
    "css": { "parser": { "tailwindDirectives": true } },
    "assist": { "actions": { "source": { "useSortedAttributes": "on", "useSortedPackageJson": "on", "useSortedProperties": "on" } } },
    "linter": {
        "domains": { "project": "all", "react": "none", "test": "all", "types": "all" },
        "rules": {
            "a11y": "error",
            "complexity": "error",
            "correctness": "error",
            "performance": "error",
            "security": "error",
            "style": "error",
            "suspicious": "error",
            "nursery": {
                "noBaseToString": "error",
                "noBunModules": "error",
                "noConditionalExpect": "error",
                "noDuplicateSelectors": "error",
                "noEmptyObjectKeys": "error",
                "noExcessiveNestedCallbacks": { "level": "error", "options": { "max": 3 } },
                "noExtendNative": "error",
                "noFloatingPromises": "error",
                "noIdenticalTestTitle": "error",
                "noImpliedEval": "error",
                "noInlineStyles": "error",
                "noInvalidFileInputAccept": "error",
                "noInvalidPropertyInitValue": "error",
                "noJsonUnsafeValues": "error",
                "noJsxLeakedDollar": "error",
                "noJsxNamespace": "error",
                "noLoopFunc": "error",
                "noMeaninglessVoidOperator": "error",
                "noMisplacedListElements": "error",
                "noMisusedPromises": "error",
                "noNegationInEqualityCheck": "error",
                "noNonScalableViewport": "error",
                "noObsoleteTags": "error",
                "noPlaywrightElementHandle": "error",
                "noPlaywrightEval": "error",
                "noPlaywrightForceOption": "error",
                "noPlaywrightMissingAwait": "error",
                "noPlaywrightNetworkidle": "error",
                "noPlaywrightPagePause": "error",
                "noPlaywrightUselessAwait": "error",
                "noPlaywrightWaitForNavigation": "error",
                "noPlaywrightWaitForSelector": "error",
                "noPlaywrightWaitForTimeout": "error",
                "noReactObjectTypeAsDefaultProp": "error",
                "noReactStringRefs": "error",
                "noRestrictedDependencies": "error",
                "noReturnInFinally": "error",
                "noSelfImport": "error",
                "noTailwindArbitraryValue": "error",
                "noTailwindRawColors": "error",
                "noThisOutsideOfClass": "error",
                "noTopLevelLiterals": "error",
                "noUnmodifiedLoopCondition": "error",
                "noUnnecessaryTemplateExpression": "error",
                "noUnsafeIframeSandbox": "error",
                "noUnsafeTypeAssertion": "error",
                "noUselessTypeConversion": "error",
                "noXorAsExponentiation": "error",
                "useArraySome": "error",
                "useAwaitThenable": "error",
                "useBaseline": { "level": "error", "options": { "available": "newly" } },
                "useBetterDomTraversing": "error",
                "useConsistentFunctionStyle": "error",
                "useConsistentObjectKeys": "error",
                "useControlLabel": "error",
                "useDisposables": "error",
                "useDomNodeTextContent": "error",
                "useDomQuerySelector": "error",
                "useExhaustiveSwitchCases": "error",
                "useFlatMathMinMax": "error",
                "useIframeSandbox": "error",
                "useImportsFirst": "error",
                "useIncludes": "error",
                "useMathMinMax": "error",
                "useModernMathApis": "error",
                "useNamedCaptureGroup": "error",
                "useNamedLayer": "error",
                "useNullishCoalescing": "error",
                "usePlaywrightValidDescribeCallback": "error",
                "usePromiseRejectErrors": "error",
                "useReactCompiler": "error",
                "useReduceTypeParameter": "error",
                "useRegexpExec": "error",
                "useRegexpTest": "error",
                "useSortedClasses": "error",
                "useStringStartsEndsWith": "error",
                "useTestHooksInOrder": "error",
                "useTestHooksOnTop": "error",
                "useThisInClassMethods": { "level": "error", "options": { "ignoreOverrideMethods": true } },
                "useUnicodeRegex": "error",
                "useValidTestTitle": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": [ "**" ],
            "linter": {
                "rules": {
                    "complexity": { "noExcessiveLinesPerFunction": "off", "noForEach": "off" },
                    "correctness": { "noNodejsModules": "off", "noSolidDestructuredProps": "off", "noUndeclaredVariables": "off", "noUnknownFunction": { "level": "error", "options": { "ignore": [ "theme" ] } }, "noUnresolvedImports": "off", "useQwikValidLexicalScope": "off" },
                    "performance": { "noImgElement": "off", "noJsxPropsBind": "off", "useSolidForComponent": "off" },
                    "security": { "noSecrets": "off" },
                    "style": {
                        "noExcessiveClassesPerFile": "off",
                        "noExcessiveLinesPerFile": "off",
                        "noJsxLiterals": "off",
                        "noParameterAssign": { "level": "error", "options": { "propertyAssignment": "deny" } },
                        "noTernary": "off",
                        "useConsistentMemberAccessibility": { "level": "error", "options": { "accessibility": "none" } },
                        "useNamingConvention": "off",
                        "useReadonlyClassProperties": { "level": "error", "options": { "checkAllProperties": true } }
                    },
                    "suspicious": { "noBitwiseOperators": { "level": "error", "options": { "allow": [ "&" ] } }, "noLeakedRender": "off", "noReactSpecificProps": "off", "noShadowRestrictedNames": "off", "noUnknownAttribute": { "level": "error", "options": { "ignore": [ "precedence" ] } } }
                }
            }
        },
        { "includes": [ "**/*.tsx" ], "linter": { "domains": { "react": "all" } } },
        { "includes": [ "**/*.config.ts", "**/worker/index.ts", "**/.storybook/*.{ts,tsx}", "tools/ast-grep/grammars/*/grammar.js" ], "linter": { "rules": { "style": { "noDefaultExport": "off" } } } },
        { "includes": [ "**/*.stories.tsx" ], "linter": { "rules": { "style": { "useComponentExportOnlyModules": "off" } } } },
        { "includes": [ "**/cloudflare.config.ts" ], "linter": { "rules": { "performance": { "noNamespaceImport": "off" } } } },
        { "includes": [ "plugins/function-hooks/**" ], "linter": { "rules": { "correctness": { "noUndeclaredDependencies": "off" } } } }
    ]
}
