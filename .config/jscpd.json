{
    "kind": ["ast"],
    "similarity": 0.8,
    "minNodes": 210,
    "minLines": 1,
    "minTokens": 1,
    "pattern": "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,py,pyi,rs,swift,cs,c,h,cpp,cppm,ixx,cc,cxx,hpp,hh,hxx,java}",
    "format": ["typescript", "tsx", "javascript", "jsx", "python", "rust", "swift", "csharp", "c", "cpp", "cpp-header", "java"],
    "absolute": true,
    "exitCode": 1,
    "reporters": ["xcode"],
    "noTips": true,
    "noColors": true,
    "skipIsolated": [
        [
            "products/developer/nx/apple",
            "products/developer/nx/cargo",
            "products/developer/nx/cmake",
            "products/developer/nx/distribution",
            "products/developer/nx/docker",
            "products/developer/nx/dotnet",
            "products/developer/nx/playwright",
            "products/developer/nx/pulumi",
            "products/developer/nx/storybook",
            "products/developer/nx/typescript",
            "products/developer/nx/uv",
            "products/developer/nx/vite",
            "products/developer/nx/vitest"
        ]
    ]
}
