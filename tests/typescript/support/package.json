{
    "name": "@rasm/testing",
    "version": "0.0.0",
    "private": true,
    "description": "Shared test logic by category: Vitest runner policy, Playwright base and served-task config, and Nx plugin inference workspaces with recorded tool replies",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "tests/typescript/support"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./nx/cli": "./nx/cli.ts",
        "./nx/hashes": "./nx/hashes.ts",
        "./nx/inference": "./nx/inference.ts",
        "./nx/setup": "./nx/setup.ts",
        "./nx/tools": "./nx/tools.ts",
        "./playwright": "./playwright.ts",
        "./storybook": "./storybook.ts",
        "./vitest": "./vitest.ts"
    },
    "files": [ "dist", "!dist/suite", "!dist/*.config.*" ],
    "dependencies": {
        "@axe-core/playwright": "catalog:",
        "@rasm/process": "workspace:*",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:"
    },
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@playwright/test": "catalog:",
        "@storybook/addon-a11y": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "nx": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@nx/devkit": "catalog:peers",
        "@playwright/test": "catalog:peers",
        "@storybook/addon-a11y": "catalog:peers",
        "effect": "catalog:peers",
        "nx": "catalog:peers",
        "vite": "catalog:peers",
        "vitest": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@nx/devkit": {
            "optional": true
        },
        "@playwright/test": {
            "optional": true
        },
        "@storybook/addon-a11y": {
            "optional": true
        },
        "nx": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "vitest": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            "./nx/cli": "./dist/nx/cli.js",
            "./nx/hashes": "./dist/nx/hashes.js",
            "./nx/inference": "./dist/nx/inference.js",
            "./nx/setup": "./dist/nx/setup.js",
            "./nx/tools": "./dist/nx/tools.js",
            "./playwright": "./dist/playwright.js",
            "./storybook": "./dist/storybook.js",
            "./vitest": "./dist/vitest.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
