{
    "name": "@rasm/creative-cloud-desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Adobe applications installed on this Mac, each installation the application server lists joined to the Creative Cloud registry for its product, channel, and build, and the tool names, shortcuts, and help pages each build declares in its shortcut sets, toolbar settings, and curated catalogs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/desktop"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "os": [
        "darwin"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./application": "./application.ts",
        "./tools": "./tools.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./application": "./dist/application.js",
            "./tools": "./dist/tools.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/sql-sqlite-node": "catalog:",
        "@rasm/applications": "workspace:*",
        "ag-psd": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
