{
    "name": "@rasm/mark",
    "version": "0.1.0",
    "private": true,
    "description": "One SVG master painted with a fill color and opacity, and rastered per size, through resvg",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/graphics/mark"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@resvg/resvg-js": "catalog:",
        "cheerio": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": "^24.14.0 || >=25.4.0"
    }
}
