{
    "name": "@rasm/indesign",
    "version": "0.0.0",
    "private": true,
    "description": "InDesign object model for UXP plugins: specifiers, values, find/change kinds, and extents, the Model reading the running host's dictionary, and typesetting settings over it",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/indesign"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./uxp": "./uxp/index.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@rasm/automation": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/typography": "workspace:*",
        "@rasm/uxp": "workspace:*"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "indesign-uxp-types": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./uxp": "./dist/uxp/index.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
