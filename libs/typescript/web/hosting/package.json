{
    "name": "@rasm/hosting",
    "private": true,
    "description": "One web app served the same on edge and server runtimes",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./cloudflare": "./cloudflare.ts",
        "./cloudflare/access": "./cloudflare/access.ts",
        "./content-etag": "./content-etag.ts",
        "./node/server": "./node/server.ts",
        "./node/vite": "./node/vite.ts",
        "./page/hydrate": "./page/hydrate.ts",
        "./page/render": "./page/render.ts",
        "./page/shell": "./page/shell.ts",
        "./storage": "./storage.ts",
        "./unavailable": "./unavailable.ts",
        "./user": "./user.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@aws-sdk/s3-request-presigner": "catalog:",
        "@effect/platform-node": "catalog:",
        "cheerio": "catalog:",
        "effect": "catalog:",
        "partial-content": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/test-support": "workspace:*",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "cf": "catalog:",
        "testcontainers": "catalog:",
        "vitest": "catalog:"
    }
}
