{
    "name": "@rasm/harnesses",
    "private": true,
    "description": "Host proof harnesses running original scripts against recorded cases",
    "type": "module",
    "imports": { "#/*": "./*.ts" },
    "exports": {
        "./indesign/contract": "./indesign/contract.ts",
        "./results": "./results.ts",
        "./values": "./values.ts"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/automation": "workspace:*",
        "@rasm/search": "workspace:*",
        "acorn": "catalog:",
        "acorn-walk": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:"
    },
    "nx": {
        "targets": {
            "blender": {
                "command": "node tools/harnesses/blender/main.ts",
                "options": { "cwd": "{workspaceRoot}" }
            },
            "indesign": {
                "command": "node tools/harnesses/indesign/main.ts",
                "options": { "cwd": "{workspaceRoot}" },
                "dependsOn": [ "@rasm/harnesses-indesign-uxpscript:build" ]
            }
        }
    }
}
