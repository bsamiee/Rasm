{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "version": 2,
    "title": "Run",
    "type": "object",
    "properties": {
        "runs": {
            "type": "array",
            "description": "Invocations run in order, stopping at the first failure",
            "items": {
                "type": "object",
                "properties": {
                    "command": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Program and arguments" },
                    "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Variables set for the program" },
                    "results": { "type": "array", "items": { "type": "string" }, "description": "Result files removed before the run, their folders created" }
                },
                "required": ["command"]
            }
        },
        "args": { "type": "array", "items": { "type": "string" }, "$default": { "$source": "unparsed" }, "description": "Arguments after -- appended to every invocation" }
    },
    "required": ["runs"]
}
