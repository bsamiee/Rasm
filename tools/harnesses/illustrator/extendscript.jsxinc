        var key;
        if (value instanceof Array) {
            var list = [];
            for (var i = 0; i < value.length; i++) { list.push(revive(value[i])); }
            return list;
        }
        if (value === null || typeof value !== "object") { return value; }
        var count = 0;
        for (key in value) { if (value.hasOwnProperty(key)) { count += 1; } }
        if (count === 1 && value.hasOwnProperty("$")) {
            var held = String(value.$);
            var numbers = { "undefined": undefined, "NaN": NaN, "Infinity": Infinity, "-Infinity": -Infinity, "-0": -0 };
            var scaled = /^(-?\d+)p(-?\d+)$/.exec(held);
            if (numbers.hasOwnProperty(held)) { return numbers[held]; }
            if (scaled) { return Number(scaled[1]) * Math.pow(2, Math.ceil(Number(scaled[2]) / 2)) * Math.pow(2, Math.floor(Number(scaled[2]) / 2)); }
            var dated = /^date:(.+)$/.exec(held);
            if (dated) { return parsed(dated[1]); }
            var listed = /^enum:([^.]+)\.(.+)$/.exec(held);
            if (listed) {
                var found = realGlobal[listed[1]] === undefined ? undefined : realGlobal[listed[1]][listed[2]];
