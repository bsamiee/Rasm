{
    "name": "@rasm/harnesses",
    "private": true,
    "description": "Host proof harnesses running original scripts against recorded cases",
    "type": "module",
    "imports": { "#/*": "./*.ts", "#/package.json": "./package.json" },
    "exports": {
        "./cases/values": "./cases/values.ts",
        "./harness-error": "./harness-error.ts",
        "./hosts/adobe/indesign/contract": "./hosts/adobe/indesign/contract.ts"
    },
    "bin": { "harness": "./main.ts" },
    "dependencies": {
        "@ast-grep/napi": "catalog:",
        "@effect/platform-node": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/automation": "workspace:*",
        "@rasm/cep": "workspace:*",
        "@rasm/extendscript": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "acorn": "catalog:",
        "acorn-walk": "catalog:",
        "effect": "catalog:",
        "jsesc": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@types/jsesc": "catalog:",
        "@types/node": "catalog:",
        "types-for-adobe": "catalog:"
    }
}
