{
    "name": "@rasm/object-model",
    "version": "0.1.0",
    "private": true,
    "description": "Object model every scriptable Adobe host shares: specifiers addressing host objects, references to them, class and enumeration declarations, the error of a host call, and the plain JavaScript grammar, walker, reference producer, and value encoder ExtendScript and UXP both run",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/object-model"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./host": "./host.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./host": "./dist/host.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/search": "workspace:*"
    },
    "devDependencies": {
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=26"
    }
}
