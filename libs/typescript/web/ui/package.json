{
    "name": "@rasm/ui",
    "version": "0.1.0",
    "private": true,
    "description": "Accessible React controls, lists, and dialogs for web apps, with schema issue display and Intl formatting",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/ui"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts",
        "#/*.tsx": "./*.tsx"
    },
    "exports": {
        "./choice": "./choice.tsx",
        "./field": "./field.tsx",
        "./format": "./format.ts",
        "./issues": "./issues.tsx",
        "./menu-button": "./menu-button.tsx",
        "./modal-dialog": "./modal-dialog.tsx",
        "./reorderable-list": "./reorderable-list.tsx",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.tsx": "./dist/*.js"
        },
        "exports": {
            "./choice": "./dist/choice.js",
            "./field": "./dist/field.js",
            "./format": "./dist/format.js",
            "./issues": "./dist/issues.js",
            "./menu-button": "./dist/menu-button.js",
            "./modal-dialog": "./dist/modal-dialog.js",
            "./reorderable-list": "./dist/reorderable-list.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "lucide-react": "catalog:"
    },
    "devDependencies": {
        "@rasm/testing": "workspace:*",
        "@storybook/addon-a11y": "catalog:",
        "@storybook/addon-docs": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@storybook/react-vite": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "effect": "catalog:",
        "react": "catalog:",
        "react-aria-components": "catalog:",
        "react-dom": "catalog:",
        "storybook": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "react": "catalog:peers",
        "react-aria-components": "catalog:peers",
        "react-dom": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
