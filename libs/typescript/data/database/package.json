{
    "name": "@rasm/database",
    "version": "0.1.0",
    "private": true,
    "description": "SQLite, D1, PostgreSQL, and ClickHouse databases reconciled to their declared schemas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/data/database"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./clickhouse": "./clickhouse.ts",
        "./d1": "./d1.ts",
        "./pg": "./pg.ts",
        "./sqlite": "./sqlite.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./clickhouse": "./dist/clickhouse.js",
            "./d1": "./dist/d1.js",
            "./pg": "./dist/pg.js",
            "./sqlite": "./dist/sqlite.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@pgsql/traverse": "catalog:",
        "@pgsql/types": "catalog:",
        "pgsql-parser": "catalog:"
    },
    "devDependencies": {
        "@effect/sql-clickhouse": "catalog:",
        "@effect/sql-d1": "catalog:",
        "@effect/sql-pg": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "@effect/sql-clickhouse": "catalog:peers",
        "@effect/sql-d1": "catalog:peers",
        "@effect/sql-pg": "catalog:peers",
        "effect": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@effect/sql-clickhouse": {
            "optional": true
        },
        "@effect/sql-d1": {
            "optional": true
        },
        "@effect/sql-pg": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
