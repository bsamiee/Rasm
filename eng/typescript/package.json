        "dependency-cruiser": "catalog:",
        "nx": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    }
