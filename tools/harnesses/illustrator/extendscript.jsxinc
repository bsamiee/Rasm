        var held = session.preferences;
        var own = {
            removePreference: function (key) {
                if (!held.hasOwnProperty(key) && real.preferenceExists(key)) { session.record.activations.push("removePreference " + key); return; }
                return real.removePreference(key);
            }
        };
        var listed = kinds();
        for (var i = 0; i < listed.length; i++) {
            (function (kind) {
                own["get" + kind + "Preference"] = function (key) {
