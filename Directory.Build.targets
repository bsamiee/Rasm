<Project>
    <PropertyGroup Label="Test Platform" Condition="'$(IsTestingPlatformApplication)' == 'true'">
        <IsTestProject>true</IsTestProject>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup Label="Test Analyzers" Condition="'$(ProjectRole)' == 'tests'">
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Label="Global Usings" Condition="'$(ProjectRole)' != 'analyzers'">
        <Using Remove="System.Collections.Generic" />
        <Using Include="System.Collections.Frozen;System.Collections.Immutable" />
        <Using Include="Thinktecture" />
        <Using Include="LanguageExt;LanguageExt.Common;LanguageExt.Traits;LanguageExt.UnsafeValueAccess" />
        <Using Include="LanguageExt.Prelude" Static="true" />
        <Using Include="LanguageExt.Pipes" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Streaming'))" />
        <Using Include="LanguageExt.Sys;LanguageExt.Sys.IO;LanguageExt.Sys.Traits;LanguageExt.Sys.Diag" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Sys'))" />
        <Using Include="LanguageExt.Parsec" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Parsec'))" />
        <Using Include="NodaTime;NodaTime.Extensions" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'NodaTime'))" />
        <Using Include="NodaTime.Duration" Alias="Duration" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'NodaTime'))" />
        <Using Include="UnitsNet.Length" Alias="Length" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'UnitsNet'))" />
        <Using Include="Microsoft.Extensions.Logging" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Logging')) or @(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Logging.Abstractions'))" />
        <Using Include="Xunit" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.mtp-v2')) or @(PackageReference->AnyHaveMetadataValue('Identity', 'xunit.v3.assert'))" />
        <Using Include="CsCheck" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'CsCheck'))" />
        <Using Include="Grasshopper2.Types.Numeric" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Grasshopper2'))" />
    </ItemGroup>

    <ItemGroup Label="Analyzer Configuration">
        <CompilerVisibleProperty Include="ProjectRole" Condition="'$(ProjectRole)' != ''" />
        <CompilerVisibleProperty Include="TargetExt" />
    </ItemGroup>

    <ItemGroup Label="Banned Symbols">
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)tools/roslyn/BannedSymbols.txt" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)tools/roslyn/BannedSymbols.Library.txt" Condition="'$(ProjectRole)' == 'library'" />
    </ItemGroup>

    <ItemGroup Label="Analyzer References" Condition="'$(ProjectRole)' != 'analyzers'">
        <_RoslynComponent Include="$(MSBuildThisFileDirectory)tools/roslyn/*/*.csproj" />
        <ProjectReference Include="@(_RoslynComponent)" Exclude="@(ProjectReference)" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Update="@(_RoslynComponent)" OutputItemType="Analyzer" UndefineProperties="RhinoPlugIn;ArtifactsPivots" />
    </ItemGroup>

    <ItemGroup Label="Publicized References">
        <PackageReference Update="Krafs.Publicizer" PrivateAssets="all" ExcludeAssets="contentfiles" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="AddAccessChecksAttribute" BeforeTargets="CoreCompile" Condition="'@(Publicize)' != ''">
        <Copy SourceFiles="$(PkgKrafs_Publicizer)/contentfiles/cs/any/Publicizer/IgnoresAccessChecksToAttribute.cs" DestinationFiles="$(IntermediateOutputPath)IgnoresAccessChecksToAttribute.g.cs" SkipUnchangedFiles="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)IgnoresAccessChecksToAttribute.g.cs" />
            <FileWrites Include="$(IntermediateOutputPath)IgnoresAccessChecksToAttribute.g.cs" />
        </ItemGroup>
    </Target>

    <PropertyGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <DefaultItemExcludes Condition="'$(TargetPlatformIdentifier)' == 'Windows'">$(DefaultItemExcludes);**/Mac/**</DefaultItemExcludes>
        <DefaultItemExcludes Condition="'$(TargetPlatformIdentifier)' != 'Windows'">$(DefaultItemExcludes);**/Windows/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <PackageReference Include="RhinoCommon" ExcludeAssets="runtime" />
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="compile" />
        <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" Condition="'$(TargetPlatformIdentifier)' == 'Windows'" />
        <Using Include="Rhino.Geometry" />
        <Using Include="Rhino.Geometry.Interval" Alias="Interval" />
        <EmbeddedResource Include="**/*.ghicon" Exclude="Documentation/**" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
        <_IconMaster Include="**/*.svg" Exclude="Documentation/**" IconStem="%(Filename)" />
    </ItemGroup>

    <PropertyGroup Label="Rhino Host Icons" Condition="'$(RhinoHost)' != ''">
        <_IconInk>#212529</_IconInk>
        <_IconInkDark>#e1e1e1</_IconInkDark>
        <_IconAccent>#74c0fc</_IconAccent>
        <_IconEdgeDark>#000000</_IconEdgeDark>
        <_IconDir>$(IntermediateOutputPath)Icons/</_IconDir>
    </PropertyGroup>

    <Target Name="BuildThemedIcons" BeforeTargets="AssignTargetPaths" Condition="'@(_IconMaster)' != ''" Inputs="$(MSBuildThisFileFullPath);@(_IconMaster)" Outputs="$(_IconDir).stamp">
        <MakeDir Directories="$(_IconDir)" />
        <WriteLinesToFile File="$(_IconDir)%(_IconMaster.IconStem)%(_IconMaster.Extension)" Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_IconMaster.FullPath)').Replace('currentColor', '$(_IconInk)').Replace('var(--accent)', '$(_IconAccent)').Replace('var(--edge)', '$(_IconInk)'))))" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <WriteLinesToFile File="$(_IconDir)%(_IconMaster.IconStem)_darkmode%(_IconMaster.Extension)" Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_IconMaster.FullPath)').Replace('currentColor', '$(_IconInkDark)').Replace('var(--accent)', '$(_IconAccent)').Replace('var(--edge)', '$(_IconEdgeDark)'))))" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Touch Files="$(_IconDir).stamp" AlwaysCreate="true" />
        <ItemGroup>
            <EmbeddedResource Include="$(_IconDir)%(_IconMaster.IconStem)%(_IconMaster.Extension)" LogicalName="%(_IconMaster.IconStem)%(_IconMaster.Extension)" WithCulture="false" />
            <EmbeddedResource Include="$(_IconDir)%(_IconMaster.IconStem)_darkmode%(_IconMaster.Extension)" LogicalName="%(_IconMaster.IconStem)_darkmode%(_IconMaster.Extension)" WithCulture="false" />
            <FileWrites Include="$(_IconDir)%(_IconMaster.IconStem)%(_IconMaster.Extension);$(_IconDir)%(_IconMaster.IconStem)_darkmode%(_IconMaster.Extension);$(_IconDir).stamp" />
        </ItemGroup>
    </Target>

    <UsingTask TaskName="ReadRhinoHost" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Resources ParameterType="System.String" Required="true" />
            <Packages ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <References ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <TargetFramework ParameterType="System.String" Output="true" />
            <Libraries ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
            <Supplied ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Reflection" />
            <Using Namespace="System.Runtime.Serialization.Json" />
            <Using Namespace="System.Xml" />
            <Using Namespace="System.Xml.Linq" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                    XElement Json(string path) => XElement.Load(JsonReaderWriterFactory.CreateJsonReader(File.ReadAllBytes(path), XmlDictionaryReaderQuotas.Max));
                    string runtime = Directory.GetFiles(Resources, "dotnetstart.*.runtimeconfig.json").Single();
                    TargetFramework = Json(runtime).Element("runtimeOptions").Element("tfm").Value;
                    XElement dependencies = Json(runtime.Replace(".runtimeconfig.json", ".deps.json"));
                    ILookup<string, string> declared = dependencies.Descendants("assemblyVersion").ToLookup(version => Path.GetFileName(version.Parent.Attribute("item")?.Value ?? version.Parent.Name.LocalName), version => version.Value);
                    Libraries = dependencies.Element("libraries").Elements()
                        .Select(library => library.Attribute("item").Value.Split('/'))
                        .Select(library => (ITaskItem)new TaskItem(library[0], new Dictionary<string, string> { ["Version"] = library[1] }))
                        .ToArray();
                    string[] api = Directory.GetDirectories(Path.Combine(Resources, "ManagedPlugIns"), "*.rhp").Prepend(Resources).ToArray();
                    Supplied = (Packages ?? Array.Empty<ITaskItem>())
                        .Select(package => (Package: package, Folders: new[] { Resources }))
                        .Concat((References ?? Array.Empty<ITaskItem>()).Select(reference => (Package: reference, Folders: api)))
                        .SelectMany(held => held.Folders
                            .Select(folder => Path.Combine(folder, Path.GetFileName(held.Package.ItemSpec)))
                            .Where(File.Exists)
                            .Take(1)
                            .Select(host => {
                                TaskItem supplied = new TaskItem(held.Package);
                                supplied.SetMetadata("Version", AssemblyName.GetAssemblyName(held.Package.ItemSpec).Version.ToString());
                                supplied.SetMetadata("HostVersion", declared[Path.GetFileName(host)].DefaultIfEmpty(AssemblyName.GetAssemblyName(host).Version.ToString()).First());
                                return (ITaskItem)supplied;
                            }))
                        .ToArray();
                ]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="ResolveRhinoInstallation" AfterTargets="ResolvePackageAssets" Condition="'$(RhinoHost)' != ''">
        <PropertyGroup>
            <_RhinoCommonVersion>@(PackageVersion->WithMetadataValue('Identity', 'RhinoCommon')->'%(Version)')</_RhinoCommonVersion>
            <_RhinoMajorVersion>$([System.Version]::Parse('$(_RhinoCommonVersion)').Major)</_RhinoMajorVersion>
        </PropertyGroup>
        <Exec Command="osascript -l JavaScript -e &quot;ObjC.import('AppKit'); \$.NSWorkspace.sharedWorkspace.URLForApplicationWithBundleIdentifier('com.mcneel.rhinoceros.$(_RhinoMajorVersion)').path?.js ?? ''&quot;" ConsoleToMSBuild="true" Condition="'$(RhinoInstallPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">
            <Output TaskParameter="ConsoleOutput" PropertyName="RhinoInstallPath" />
        </Exec>
        <PropertyGroup>
            <RhinoInstallPath Condition="'$(RhinoInstallPath)' == ''">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\McNeel\Rhinoceros\$(_RhinoMajorVersion).0\Install', 'InstallPath'))</RhinoInstallPath>
            <_RhinoResourcesDir>$([MSBuild]::NormalizeDirectory('$(RhinoInstallPath)', 'Contents', 'Frameworks', 'RhCore.framework', 'Versions', 'Current', 'Resources'))</_RhinoResourcesDir>
            <_YakExecutable Condition="$([MSBuild]::IsOSPlatform('OSX'))">$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'Contents', 'Resources', 'bin', 'yak'))</_YakExecutable>
            <_YakExecutable Condition="$([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'System', 'yak.exe'))</_YakExecutable>
        </PropertyGroup>
        <Error Condition="'$(RhinoInstallPath)' == ''" Text="Rhino $(_RhinoMajorVersion) install not found, install Rhino $(_RhinoMajorVersion) or set RhinoInstallPath" />
        <ItemGroup>
            <_RhinoReference Include="@(ResolvedCompileFileDefinitions)" />
            <_RhinoReference Remove="@(RuntimeCopyLocalItems)" MatchOnMetadata="NuGetPackageId" />
        </ItemGroup>
        <ReadRhinoHost Resources="$(_RhinoResourcesDir)" Packages="@(RuntimeCopyLocalItems)" References="@(_RhinoReference)">
            <Output TaskParameter="TargetFramework" PropertyName="RhinoTargetFramework" />
            <Output TaskParameter="Libraries" ItemName="RhinoHostLibrary" />
            <Output TaskParameter="Supplied" ItemName="_RhinoSupplied" />
        </ReadRhinoHost>
        <Error Condition="$([MSBuild]::VersionGreaterThan($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), $([MSBuild]::GetTargetFrameworkVersion('$(RhinoTargetFramework)'))))" Text="$(MSBuildProjectName) targets $(TargetFramework), newer than the $(RhinoTargetFramework) runtime Rhino $(_RhinoMajorVersion) loads from $(_RhinoResourcesDir)" />
    </Target>

    <Target Name="ResolveRhinoMacHost" BeforeTargets="ResolveAssemblyReferences;GetAssemblyAttributes" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(RhinoHost)' != '' and '$(TargetPlatformIdentifier)' != 'Windows'">
        <XmlPeek XmlInputPath="$(RhinoInstallPath)/Contents/Info.plist" Query="/plist/dict/key[.='LSMinimumSystemVersion']/following-sibling::*[1]/text()" ProhibitDtd="false">
            <Output TaskParameter="Result" PropertyName="_RhinoMacMinimumVersion" />
        </XmlPeek>
        <ItemGroup>
            <_RhinoMacAssembly Include="System.Drawing.Common;Eto.macOS;Microsoft.macOS" />
            <Reference Include="@(_RhinoMacAssembly->'$(_RhinoResourcesDir)%(Identity).dll')" Private="false" />
            <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
                <_Parameter1>macos$(_RhinoMacMinimumVersion)</_Parameter1>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <PropertyGroup Label="Rhino Plug-In" Condition="'$(TargetExt)' == '.rhp'">
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <MinVerTagPrefix>rhino-$(MSBuildProjectName)-v</MinVerTagPrefix>
        <MinVerIgnoreHeight>true</MinVerIgnoreHeight>
        <_PlugInIconSource Condition="'$(_PlugInIconSource)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'EmbeddedResources', 'icon.svg'))</_PlugInIconSource>
        <_PlugInPackageIcon Condition="Exists('$(_PlugInIconSource)')">icon.png</_PlugInPackageIcon>
        <_PlugInPackageIconSize>64</_PlugInPackageIconSize>
        <_PlugInAssetDir>$(IntermediateOutputPath)PlugInAssets/</_PlugInAssetDir>
        <_PlugInIcon>PlugIn.ico</_PlugInIcon>
        <_PlugInIconPngFrame>256</_PlugInIconPngFrame>
        <_PlugInIconPlate>#323232</_PlugInIconPlate>
        <_PlugInIconCorner>0.046875</_PlugInIconCorner>
        <_PlugInIconInset>0.125</_PlugInIconInset>
        <_PlugInIconStylesheet>$(_PlugInAssetDir)icon.css</_PlugInIconStylesheet>
        <_PlugInRui>$(IntermediateOutputPath)$(TargetName).rui</_PlugInRui>
        <_PlugInRuiReferences>$(IntermediateOutputPath)$(TargetName).rui.rsp</_PlugInRuiReferences>
        <_PlugInRuiStamp>$(IntermediateOutputPath)$(TargetName).rui.stamp</_PlugInRuiStamp>
        <_YakPackageName>$(AssemblyTitle.Replace(' ', '-'))</_YakPackageName>
    </PropertyGroup>

    <ItemGroup Label="Rhino Plug-In" Condition="'$(TargetExt)' == '.rhp'">
        <PackageReference Include="MinVer" PrivateAssets="all" />
        <_RhinoLibraryReference Include="@(ProjectReference->WithMetadataValue('Filename', 'Rasm.Rhino'))" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)eng/dotnet/rhino/Rasm.Rui/Rasm.Rui.csproj" ReferenceOutputAssembly="false" Private="false" OutputItemType="_RuiWriter" Condition="'@(_RhinoLibraryReference)' != ''" />
        <_PlugInDescription Include="Organization" Value="$(Authors)" />
        <_PlugInDescription Include="WebSite" Value="$(PackageProjectUrl)" />
        <_GrasshopperPackage Include="@(PackageReference->WithMetadataValue('Identity', 'Grasshopper2'))" />
    </ItemGroup>

    <ItemGroup Label="Grasshopper 2 Plug-In" Condition="'@(_GrasshopperPackage)' != ''">
        <None Update="Documentation/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="ExcludeRhinoHostAssemblies" AfterTargets="ResolvePackageAssets" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhp' or ('$(RhinoHost)' != '' and '$(EnableDynamicLoading)' == 'true')">
        <Error Condition="$([MSBuild]::VersionGreaterThan('%(_RhinoSupplied.Version)', '%(_RhinoSupplied.HostVersion)'))" Text="%(_RhinoSupplied.NuGetPackageId) %(_RhinoSupplied.NuGetPackageVersion) ships %(_RhinoSupplied.Filename) %(_RhinoSupplied.Version), above the %(_RhinoSupplied.HostVersion) Rhino $(_RhinoMajorVersion) loads from $(_RhinoResourcesDir)" />
        <ItemGroup>
            <RuntimeCopyLocalItems Remove="@(_RhinoSupplied)" MatchOnMetadata="NuGetPackageId" />
            <NativeCopyLocalItems Remove="@(_RhinoSupplied)" MatchOnMetadata="NuGetPackageId" />
        </ItemGroup>
    </Target>

    <Target Name="AssignPlugInLibraryCopies" BeforeTargets="AssignProjectConfiguration" DependsOnTargets="IncludeTransitiveProjectReferences" Condition="'$(TargetExt)' == '.rhp' and '$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <ProjectReference AdditionalProperties="RhinoPlugIn=$(MSBuildProjectName);ArtifactsPivots=$(MSBuildProjectName)_$(ArtifactsPivots)" />
        </ItemGroup>
    </Target>

    <Target Name="AssignPlugInAssemblyVersion" AfterTargets="MinVer" Condition="'$(TargetExt)' == '.rhp'">
        <PropertyGroup>
            <AssemblyVersion>$(FileVersion)</AssemblyVersion>
        </PropertyGroup>
    </Target>

    <Target Name="AddPlugInDescriptions" AfterTargets="GetAssemblyAttributes" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <AssemblyAttribute Include="@(_PlugInDescription->'Rhino.PlugIns.PlugInDescriptionAttribute')" RemoveMetadata="Value">
                <_Parameter1>Rhino.PlugIns.DescriptionType.%(_PlugInDescription.Identity)</_Parameter1>
                <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
                <_Parameter2>%(_PlugInDescription.Value)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInIcon" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true' and '$(_PlugInPackageIcon)' != ''" Inputs="$(MSBuildThisFileFullPath);$(_PlugInIconSource)" Outputs="$(_PlugInAssetDir)$(_PlugInIcon);$(_PlugInAssetDir)$(_PlugInPackageIcon)">
        <ItemGroup>
            <_PlugInIconFrame Include="$(_PlugInIconPngFrame);48;32;24;16" />
            <_PlugInRaster Include="$(_PlugInAssetDir)%(_PlugInIconFrame.Identity).png" Size="%(_PlugInIconFrame.Identity)" Frame="true" />
            <_PlugInRaster Include="$(_PlugInAssetDir)$(_PlugInPackageIcon)" Size="$(_PlugInPackageIconSize)" Frame="false" />
        </ItemGroup>
        <MakeDir Directories="$(_PlugInAssetDir)" />
        <WriteLinesToFile File="$(_PlugInIconStylesheet)" Lines="svg { color: $(_IconInkDark) }" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Command="resvg -w $([MSBuild]::Multiply(%(_PlugInRaster.Size), $([MSBuild]::Subtract(1, $([MSBuild]::Multiply(2, $(_PlugInIconInset))))))) --stylesheet &quot;$(_PlugInIconStylesheet)&quot; &quot;$(_PlugInIconSource)&quot; &quot;%(_PlugInRaster.FullPath)&quot;" />
        <Exec Command="magick -size %(_PlugInRaster.Size)x%(_PlugInRaster.Size) xc:none -fill &quot;$(_PlugInIconPlate)&quot; -draw &quot;roundrectangle 0,0,$([MSBuild]::Subtract(%(_PlugInRaster.Size), 1)),$([MSBuild]::Subtract(%(_PlugInRaster.Size), 1)),$([MSBuild]::Multiply(%(_PlugInRaster.Size), $(_PlugInIconCorner))),$([MSBuild]::Multiply(%(_PlugInRaster.Size), $(_PlugInIconCorner)))&quot; &quot;%(_PlugInRaster.FullPath)&quot; -gravity center -composite &quot;%(_PlugInRaster.FullPath)&quot;" />
        <Exec Command="magick @(_PlugInRaster->WithMetadataValue('Frame', 'true')->'&quot;%(Filename)%(Extension)&quot;', ' ') -define icon:png-compression-size=$(_PlugInIconPngFrame) &quot;$(_PlugInIcon)&quot;" WorkingDirectory="$(_PlugInAssetDir)" />
        <ItemGroup>
            <None Include="$(_PlugInAssetDir)$(_PlugInPackageIcon)" TargetPath="$(_PlugInPackageIcon)" CopyToPublishDirectory="PreserveNewest" />
            <EmbeddedResource Include="$(_PlugInAssetDir)$(_PlugInIcon)" LogicalName="$(_PlugInIcon)" WithCulture="false" />
            <_PlugInDescription Include="Icon" Value="$(_PlugInIcon)" />
            <FileWrites Include="$(_PlugInAssetDir)$(_PlugInIcon);$(_PlugInIconStylesheet);@(_PlugInRaster)" />
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInRui" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetExt)' == '.rhp' and '@(_RhinoLibraryReference)' != ''" Inputs="@(IntermediateAssembly);@(ReferenceCopyLocalPaths);@(_RuiWriter)" Outputs="$(_PlugInRuiStamp)">
        <WriteLinesToFile File="$(_PlugInRuiReferences)" Lines="@(ReferenceCopyLocalPaths->WithMetadataValue('Extension', '.dll')->'%(FullPath)');@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(_RuiWriter->'%(FullPath)')&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$(_PlugInRui)&quot; &quot;@$(_PlugInRuiReferences)&quot;" StandardOutputImportance="low" LogStandardErrorAsError="true" />
        <Touch Files="$(_PlugInRuiStamp)" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(_PlugInRui);$(_PlugInRuiReferences);$(_PlugInRuiStamp)" />
        </ItemGroup>
    </Target>

    <Target Name="ListPlugInRui" BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" Condition="'$(TargetExt)' == '.rhp' and '@(_RhinoLibraryReference)' != '' and Exists('$(_PlugInRui)')">
        <ItemGroup>
            <ContentWithTargetPath Include="$(_PlugInRui)" TargetPath="$(TargetName).rui" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <Target Name="BuildYakPackage" AfterTargets="Publish" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhp'">
        <PropertyGroup>
            <_YakPlatform Condition="$(RuntimeIdentifier.StartsWith('osx'))">mac</_YakPlatform>
            <_YakPlatform Condition="$(RuntimeIdentifier.StartsWith('win'))">win</_YakPlatform>
        </PropertyGroup>
        <ItemGroup>
            <_YakOutput Include="$(PublishDir)*.yak;$(PublishDir)manifest.yml" />
        </ItemGroup>
        <Delete Files="@(_YakOutput)" />
        <Exec Command="&quot;$(_YakExecutable)&quot; spec --input $(TargetFileName)" WorkingDirectory="$(PublishDir)" StandardOutputImportance="low" LogStandardErrorAsError="true" />
        <Exec Command="yq -i '.icon = strenv(ICON)' manifest.yml" EnvironmentVariables="ICON=$(_PlugInPackageIcon)" WorkingDirectory="$(PublishDir)" Condition="'$(_PlugInPackageIcon)' != ''" />
        <Exec Command="yq -i '.keywords += [&quot;guid:&quot; + strenv(PLUGIN)]' manifest.yml" EnvironmentVariables="@(AssemblyAttribute->WithMetadataValue('Identity', 'System.Runtime.InteropServices.GuidAttribute')->'PLUGIN=%(_Parameter1)')" WorkingDirectory="$(PublishDir)" />
        <Exec Command="&quot;$(_YakExecutable)&quot; build --platform $(_YakPlatform)" WorkingDirectory="$(PublishDir)" LogStandardErrorAsError="true" />
    </Target>

    <Target Name="ResolveYakPackage" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <_YakPackage Include="$(PublishDir)*.yak" />
        </ItemGroup>
    </Target>

    <Target Name="InstallYakPackage" DependsOnTargets="ResolveYakPackage" Condition="'$(TargetExt)' == '.rhp'">
        <Exec Command="&quot;$(_YakExecutable)&quot; uninstall &quot;$(_YakPackageName)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="&quot;$(_YakExecutable)&quot; install &quot;@(_YakPackage->'%(FullPath)')&quot;" LogStandardErrorAsError="true" />
    </Target>

    <Target Name="PushYakPackage" DependsOnTargets="ResolveYakPackage" Condition="'$(TargetExt)' == '.rhp'">
        <Exec Command="&quot;$(_YakExecutable)&quot; push &quot;@(_YakPackage->'%(FullPath)')&quot;" LogStandardErrorAsError="true" />
    </Target>
</Project>
