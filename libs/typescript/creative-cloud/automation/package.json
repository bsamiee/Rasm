{
    "name": "@rasm/automation",
    "version": "0.0.0",
    "private": true,
    "description": "What every Adobe host plugin shares: the error a host call reports, the object model and specifier reference a host describes, and the Vite bundle layout of a plugin build",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/automation"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./vite": "./vite.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@rasm/search": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./vite": "./dist/vite.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
