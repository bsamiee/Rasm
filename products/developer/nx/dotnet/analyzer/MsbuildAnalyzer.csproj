<Project Sdk="Microsoft.NET.Sdk">
    <!-- [PROPERTIES] ──────────────────────────────────────────────────────────────── -->

    <PropertyGroup Label="Package Metadata">
        <Description>Workspace-wide MSBuild evaluation in one process, reporting the facts the Nx plugin derives targets from, and upgrades of a solution's central package versions to their newest releases</Description>
        <IsPublishable>true</IsPublishable>
    </PropertyGroup>

    <PropertyGroup Label="Application">
        <OutputType>Exe</OutputType>
        <RollForward>LatestMajor</RollForward>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <UseAppHost>false</UseAppHost>
        <PublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'dist'))</PublishDir>
    </PropertyGroup>

    <PropertyGroup Label="Source Checksums">
        <MSBuildProvideImportedProjects>true</MSBuildProvideImportedProjects>
    </PropertyGroup>

    <!-- [ITEMS] ───────────────────────────────────────────────────────────────────── -->

    <ItemGroup Label="Package Management">
        <PackageReference Include="NuGet.Common" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Configuration" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Packaging" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.ProjectModel" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Protocol" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Versioning" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Label="Build Engine">
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator" />
    </ItemGroup>

    <ItemGroup Label="Functional Programming">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Runtime Diagnostics">
        <PackageReference Include="Microsoft.Extensions.DependencyModel" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- [TARGETS] ─────────────────────────────────────────────────────────────────── -->

    <Target Name="PublishSourceChecksums" AfterTargets="ComputeFilesToPublish" DependsOnTargets="SourceFilesProjectOutputGroup">
        <MSBuild Projects="@(ProjectReference)" Targets="SourceFilesProjectOutputGroup">
            <Output TaskParameter="TargetOutputs" ItemName="_SourceChecksum" />
        </MSBuild>
        <ItemGroup>
            <_SourceChecksum Include="@(MSBuildImportedProject);@(SourceFilesProjectOutputGroupOutput);$([MSBuild]::ValueOrDefault('$(NuGetLockFilePath)', 'packages.lock.json'))" />
            <_SourceChecksum Remove="$([MSBuild]::NormalizeDirectory('$(NetCoreRoot)'))**;$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)'))**;$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)'))**" />
            <_SourceChecksum Update="@(_SourceChecksum)" Listed="$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), %(FullPath)))" />
        </ItemGroup>
        <GetFileHash Files="@(_SourceChecksum)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_SourceChecksumHash" />
        </GetFileHash>
        <WriteLinesToFile File="$(IntermediateOutputPath)$(AssemblyName).sha256" Lines="@(_SourceChecksumHash->'%(FileHash)  %(Listed)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <ResolvedFileToPublish Include="$(IntermediateOutputPath)$(AssemblyName).sha256" RelativePath="$(AssemblyName).sha256" CopyToPublishDirectory="PreserveNewest" />
            <FileWrites Include="$(IntermediateOutputPath)$(AssemblyName).sha256" />
        </ItemGroup>
    </Target>
</Project>
