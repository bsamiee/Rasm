{
    // --- [EXPLORER_VISIBILITY] ---------------------------------------------------------
    "explorer.compactFolders": false, // Single-child folder chains render as their own rows
    "files.exclude": {
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.artifacts": true,
        "**/.cache": true,
        "**/.nx": true,
        "**/.venv": true,
        "**/dist": true
    },

    // --- [FILE_NESTING] ----------------------------------------------------------------
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "CLAUDE.md": ".mcp.json, AGENTS.md",
        "README.md": "LICENSE",
        "Directory.Build.props": "Directory.Build.targets, Directory.Packages.props, global.json, NuGet.config, stryker-config.json, Workspace.slnx",
        "*.cs": "${capture}.Tests.cs",
        "*.cts": "${capture}.spec.cts, ${capture}.test.cts",
        "*.mts": "${capture}.spec.mts, ${capture}.test.mts",
        "*.py": "test_${capture}.py, ${capture}_test.py",
        "*.ts": "${capture}.spec.ts, ${capture}.test.ts",
        "*.tsx": "${capture}.spec.tsx, ${capture}.test.tsx",
        ".gitignore": ".gitattributes",
        "buf.gen.yaml": "buf.yaml, buf.lock",
        "pyproject.toml": "uv.lock",
        "nx.json": "mise.toml, sgconfig.yml",
        "package.json": "biome.json, pnpm-workspace.yaml, pnpm-lock.yaml, stryker.config.json, tsconfig.json, vite.config.ts, vitest.config.ts",
        "*.json": "${capture}.schema.json"
    },

    // --- [PYTHON] ----------------------------------------------------------------------
    // The extension finds .venv and the Ruff and ty extensions read the uv.lock copies from it, the mypy extension bundles its own copy by default
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },

    // --- [TYPESCRIPT] ------------------------------------------------------------------
    // The workspace copy of Biome from node_modules formats every file type biome.json covers beside the bundled TS service
    "biome.lsp.bin": {
        "darwin-arm64": "./node_modules/.bin/biome",
        "linux-x64": "./node_modules/.bin/biome",
        "linux-arm64": "./node_modules/.bin/biome",
        "win32-x64": "./node_modules/.bin/biome.cmd"
    },
    "[typescript][typescriptreact][javascript][javascriptreact][json][jsonc][css]": {
        "editor.defaultFormatter": "biomejs.biome"
    },

    // --- [MARKDOWN] --------------------------------------------------------------------
    // SKILL.md and agent files have their own VS Code language ids, the mapping back to markdown restores the formatter
    "files.associations": {
        "SKILL.md": "markdown",
        "**/.claude/agents/*.md": "markdown"
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },

    // --- [DOTNET] ----------------------------------------------------------------------
    "csharp.suppressBuildAssetsNotification": true
}
