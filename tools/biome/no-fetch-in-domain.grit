language js(typescript, jsx)

or {
    `fetch($args)`,
    `globalThis.fetch($args)`
} as $hit where {
    $hit <: not within `Effect.tryPromise($_)` ,
    $hit <: not within `Effect.promise($_)` ,
    $hit <: not within `Effect.tryMapPromise($_)` ,
    register_diagnostic(span=$hit, message="Raw fetch in domain flow. HTTP belongs to HttpClient on the R channel for typed faults, Schedule retry, and traced spans. Platform fetch is allowed only inside Effect.tryPromise at its FFI boundary.", severity="error")
}
