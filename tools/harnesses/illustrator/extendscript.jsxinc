                };
            })(listed[i]);
        }
        return statics({}, real, own);
    }
    function settled(held) {
        var real = realApp.preferences;
        var rows = { writes: [], leaked: [] };
        for (var key in held) {
            if (!held.hasOwnProperty(key)) { continue; }
            var row = held[key];
            var present = real.preferenceExists(key);
            var after = present ? real["get" + row.kind + "Preference"](key) : null;
            try {
                if (row.hasOwnProperty("before")) { real["set" + row.kind + "Preference"](key, row.before); } else if (present) { real.removePreference(key); }
            } catch (error) { rows.leaked.push("preference " + key + ": " + error.message); }
            if (row.touched) { rows.writes.push(row.hasOwnProperty("before") ? { _tag: "Preference", key: key, before: row.before, after: after } : { _tag: "Preference", key: key, after: after }); }
        }
