<Project Sdk="Microsoft.NET.Sdk">
    <!-- [PROPERTIES] ──────────────────────────────────────────────────────────────── -->

    <PropertyGroup Label="Package Metadata">
        <Description>xUnit v3 fixtures that open a resource per test and release it by test result</Description>
    </PropertyGroup>

    <PropertyGroup Label="Test Applications">
        <IsTestProject>false</IsTestProject>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!-- [ITEMS] ───────────────────────────────────────────────────────────────────── -->

    <ItemGroup Label="Functional Programming">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Data Storage">
        <PackageReference Include="HiraokaHyperTools.sqlite-vec" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="SQLitePCLRaw.core" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageReference Include="xunit.v3.extensibility.core" />
    </ItemGroup>
</Project>
