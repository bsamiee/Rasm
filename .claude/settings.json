{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
        "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "80",
        "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
        "BASH_DEFAULT_TIMEOUT_MS": "300000",
        "CLAUDE_CODE_SHELL": "bash",
        "NO_COLOR": "1",
        "FORCE_COLOR": "0"
    },
    "enableAllProjectMcpServers": true,
    "disabledMcpjsonServers": [ "greptile", "arena" ],
    "permissions": {
        "deny": [ "mcp__rhino-mcp-platform__run_python", "mcp__rhino-mcp-platform__g1_*", "mcp__blender__*_for_cli", "EnterWorktree", "Bash(git worktree *)" ]
    },
    "worktree": { "bgIsolation": "none" },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/root-cause.sh",
                        "args": []
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv",
                        "args": [ "run", "${CLAUDE_PROJECT_DIR}/.claude/skills/use-ghidra/scripts/bridges.py" ],
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv",
                        "args": [ "run", "${CLAUDE_PROJECT_DIR}/.claude/skills/use-ghidra/scripts/bridges.py" ],
                        "timeout": 10
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "^(?!fork$)",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/root-cause.sh",
                        "args": []
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "argus@rasm": true,
        "function-hooks@rasm": true,
        "playwright@rasm": true
    },
    "extraKnownMarketplaces": {
        "rasm": {
            "source": {
                "source": "directory",
                "path": "./plugins"
            }
        }
    },
    "effortLevel": "high",
    "showClearContextOnPlanAccept": true,
    "claudeMdExcludes": [ "**/.cache/**/CLAUDE.md", "**/node_modules/**/CLAUDE.md", "**/.venv/**/CLAUDE.md", "**/.artifacts/**/CLAUDE.md" ]
}
