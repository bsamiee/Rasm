{
    "manifestVersion": 5,
    "id": "app.rasm.atelier.illustrator",
    "name": "Atelier Illustrator",
    "version": "0.1.0",
    "main": "main.js",
    "host": { "app": "AI", "data": { "loadEvent": "startup" } },
    "icons": [
        { "width": 24, "height": 24, "path": "icons/plugin-light.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["pluginList"] },
        { "width": 24, "height": 24, "path": "icons/plugin-dark.png", "scale": [1, 2], "theme": ["medium", "dark", "darkest"], "species": ["pluginList"] }
    ],
    "entrypoints": [],
    "requiredPermissions": { "localFileSystem": "fullAccess", "allowCodeGenerationFromStrings": true }
}
