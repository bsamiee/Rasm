{
    "name": "@rasm/nx-dotnet",
    "version": "0.1.0",
    "description": "Nx plugin inferring MSBuild projects, their restores, builds, checks, tests, fixes, and NuGet releases from one MSBuild evaluation of the workspace",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/dotnet"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "analyzer/dist/*.dll",
        "analyzer/dist/*.deps.json",
        "analyzer/dist/*.runtimeconfig.json",
        "executors.json",
        "executors/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.dll": "./*.dll",
        "#/*.json": "./*.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./executors.json": "./executors.json",
        "./executors/*": "./executors/*/executor.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.dll": "./*.dll",
            "#/*.json": "./*.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./executors.json": "./executors.json",
            "./executors/*": "./dist/executors/*/executor.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "@xml-tools/ast": "catalog:",
        "@xml-tools/parser": "catalog:",
        "effect": "catalog:",
        "which": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/which": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "executors": "./executors.json",
    "nx": {
        "targets": {
            "pack--pnpm": {
                "dependsOn": [
                    "...",
                    "^build--*"
                ]
            }
        }
    }
}
