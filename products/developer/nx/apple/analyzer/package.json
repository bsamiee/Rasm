{
    "name": "@rasm/nx-apple-darwin-arm64",
    "version": "0.1.0",
    "description": "macOS arm64 build of the @rasm/nx-apple core reading Xcode projects, workspaces, and schemes",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/apple/analyzer"
    },
    "files": [
        ".build/out/Products/Release/nx-apple-analyzer"
    ],
    "os": [
        "darwin"
    ],
    "cpu": [
        "arm64"
    ],
    "type": "module",
    "exports": {
        "./nx-apple-analyzer": "./.build/out/Products/Release/nx-apple-analyzer",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "executableFiles": [
            "./.build/out/Products/Release/nx-apple-analyzer"
        ]
    },
    "nx": {
        "targets": {
            "build--swift-build": {
                "defaultConfiguration": "release"
            }
        }
    }
}
