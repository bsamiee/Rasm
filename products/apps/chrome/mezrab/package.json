{
    "name": "@rasm/mezrab",
    "private": true,
    "description": "Mezrab Chrome extension: one shortcut copies the current tab's link and confirms it with a toast matching Chrome's own Link copied toast",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.css": "./*.css",
        "#/*.json": "./*.json"
    },
    "dependencies": {
        "@material-symbols/svg-400": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@rasm/vite": "workspace:*",
        "@types/chrome": "catalog:",
        "@types/node": "catalog:",
        "@types/web": "catalog:",
        "vite": "catalog:"
    },
    "config": {
        "brand": "rgb(143 122 249)"
    }
}
