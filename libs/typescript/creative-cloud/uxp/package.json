{
    "name": "@rasm/uxp",
    "private": true,
    "description": "UXP manifest schema, the UXP plugin and script runtime, and the Vite builders of UXP plugins and scripts",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./uxp-manifest.ts",
        "./uxp": "./uxp/index.ts",
        "./vite": "./vite.ts"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@exodus/bytes": "catalog:",
        "@rasm/automation": "workspace:*",
        "@rasm/mark": "workspace:*",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:"
    }
}
