{
    // --- [EXPLORER_VISIBILITY] ---------------------------------------------------------
    "explorer.compactFolders": false, // Single-child folder chains render as their own rows
    "files.exclude": {
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.artifacts": true,
        "**/.cache": true,
        "**/.mypy_cache": true,
        "**/.nx": true,
        "**/.pytest_cache": true,
        "**/.rollup.cache": true,
        "**/.ruff_cache": true,
        "**/.stryker-tmp": true,
        "**/.ty_cache": true,
        "**/.venv": true,
        "**/bin": true,
        "**/coverage": true,
        "**/dist": true,
        "**/obj": true,
        "**/*.tsbuildinfo": true
    },

    // --- [FILE_NESTING] ----------------------------------------------------------------
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "CLAUDE.md": ".mcp.json, AGENTS.md",
        "README.md": "LICENSE",
        "Directory.Build.props": "Directory.Build.targets, Directory.Packages.props, global.json, NuGet.config, stryker-config.json, Workspace.slnx",
        "*.cs": "${capture}.Tests.cs",
        "*.csproj": "packages.lock.json",
        "*.cts": "${capture}.spec.cts, ${capture}.test.cts",
        "*.mts": "${capture}.spec.mts, ${capture}.test.mts",
        "*.py": "test_${capture}.py, ${capture}_test.py",
        "*.ts": "${capture}.spec.ts, ${capture}.test.ts",
        "*.tsx": "${capture}.spec.tsx, ${capture}.test.tsx",
        ".gitignore": ".gitattributes",
        "buf.gen.yaml": "buf.yaml, buf.lock",
        "pyproject.toml": "uv.lock",
        "package.json": "biome.json, nx.json, playwright.config.ts, pnpm-workspace.yaml, pnpm-lock.yaml, stryker.config.json, tsconfig.json, vite.config.ts, vitest.config.ts",
        "*.json": "${capture}.schema.json"
    },

    // --- [PYTHON] ----------------------------------------------------------------------
    // Unlike ruff and ty, mypy needs this pin to run the uv.lock version
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },

    // --- [TYPESCRIPT] ------------------------------------------------------------------
    // Biome from node_modules formats every surface biome.json owns beside the bundled TS service
    "[typescript][typescriptreact][javascript][javascriptreact][json][jsonc][css]": {
        "editor.defaultFormatter": "biomejs.biome"
    },

    // --- [MARKDOWN] --------------------------------------------------------------------
    // Mapping SKILL.md and agent files from their own VS Code language ids back to markdown restores the formatter
    "files.associations": {
        "SKILL.md": "markdown",
        "**/.claude/agents/*.md": "markdown"
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },

    // --- [DOTNET] ----------------------------------------------------------------------
    "csharp.suppressBuildAssetsNotification": true
}
