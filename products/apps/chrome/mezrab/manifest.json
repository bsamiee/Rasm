{
    "manifest_version": 3,
    "key": "",
    "name": "__MSG_name__",
    "version": "0.1.0",
    "description": "__MSG_description__",
    "default_locale": "en",
    "minimum_chrome_version": "157",
    "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
    "action": { "default_title": "__MSG_action__" },
    "background": { "service_worker": "service-worker.js", "type": "module" },
    "commands": { "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U", "linux": "Alt+Shift+U" } } },
    "permissions": ["activeTab", "alarms", "clipboardWrite", "scripting"]
}
