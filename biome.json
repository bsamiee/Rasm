{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/pnpm-lock.yaml",
            "!**/uv.lock",
            "!**/*.html"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 150
    },
    "linter": {
        "domains": {
            "project": "all",
            "react": "all",
            "test": "all",
            "types": "all"
        },
        "rules": {
            "preset": "all",
            "a11y": "error",
            "complexity": "error",
            "correctness": "error",
            "performance": "error",
            "security": "error",
            "style": "error",
            "suspicious": "error",
            "nursery": {
                "noBunModules": "error",
                "noDuplicateSelectors": "error",
                "noEmptyObjectKeys": "error",
                "noExtendNative": "error",
                "noImpliedEval": "error",
                "noInlineStyles": "error",
                "noInvalidFileInputAccept": "error",
                "noInvalidPropertyInitValue": "error",
                "noLoopFunc": "error",
                "noNegationInEqualityCheck": "error",
                "noNonScalableViewport": "error",
                "noRestrictedDependencies": "error",
                "noThisOutsideOfClass": "error",
                "noTopLevelLiterals": "error",
                "noUnmodifiedLoopCondition": "error",
                "noUnnecessaryTemplateExpression": "error",
                "useArraySome": "error",
                "useBaseline": "error",
                "useControlLabel": "error",
                "useDomNodeTextContent": "error",
                "useDomQuerySelector": "error",
                "useExplicitReturnType": "error",
                "useFlatMathMinMax": "error",
                "useIframeSandbox": "error",
                "useImportsFirst": "error",
                "useMathMinMax": "error",
                "useModernMathApis": "error",
                "useNamedCaptureGroup": "error",
                "useNamedLayer": "error",
                "useReduceTypeParameter": "error",
                "useRegexpTest": "error",
                "useSortedClasses": "error",
                "useThisInClassMethods": {
                    "level": "error",
                    "options": {
                        "ignoreOverrideMethods": true
                    }
                },
                "useUnicodeRegex": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        },
        "resolver": {
            "experimentalPnpmCatalogs": true
        }
    },
    "json": {
        "formatter": {
            "enabled": false
        }
    },
    "overrides": [
        {
            "includes": [
                "infra/automation.ts"
            ],
            "linter": {
                "domains": {
                    "qwik": "none"
                },
                "rules": {
                    "correctness": {
                        "noProcessGlobal": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**"
            ],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": {
                            "level": "error",
                            "options": {
                                "maxAllowedComplexity": 30
                            }
                        },
                        "noExcessiveLinesPerFunction": "off",
                        "useLiteralKeys": "off",
                        "useMaxParams": {
                            "level": "error",
                            "options": {
                                "max": 8
                            }
                        }
                    },
                    "suspicious": {
                        "noShadowRestrictedNames": "off"
                    },
                    "style": {
                        "noExcessiveClassesPerFile": "off",
                        "noExcessiveLinesPerFile": "off",
                        "noInferrableTypes": "off",
                        "noParameterAssign": {
                            "level": "error",
                            "options": {
                                "propertyAssignment": "deny"
                            }
                        },
                        "noTernary": "off",
                        "useDefaultSwitchClause": "off",
                        "useReadonlyClassProperties": {
                            "level": "error",
                            "options": {
                                "checkAllProperties": true
                            }
                        }
                    },
                    "security": {
                        "noSecrets": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/libs/typescript/**",
                "**/apps/**",
                "**/tools/**",
                "**/infra/**",
                "!**/*.spec.*",
                "!**/*.test.*",
                "!**/*.bench.*"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noDefaultExport": "error"
                    },
                    "suspicious": {
                        "noConsole": "error"
                    }
                }
            }
        },
        {
            "includes": [
                "**/vitest.config.ts"
            ],
            "linter": {
                "domains": {
                    "qwik": "none"
                },
                "rules": {
                    "correctness": {
                        "noNodejsModules": "off"
                    },
                    "style": {
                        "noDefaultExport": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "tools/nx/*.ts"
            ],
            "linter": {
                "domains": {
                    "qwik": "none"
                },
                "rules": {
                    "correctness": {
                        "noNodejsModules": "off"
                    }
                }
            }
        },
        {
            "includes": [
                ".claude/plugins/**"
            ],
            "linter": {
                "domains": {
                    "qwik": "none"
                },
                "rules": {
                    "correctness": {
                        "noUndeclaredDependencies": "off",
                        "noUnresolvedImports": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "infra/program.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useNamingConvention": {
                            "level": "error",
                            "options": {
                                "conventions": [
                                    {
                                        "selector": {
                                            "kind": "objectLiteralProperty"
                                        },
                                        "formats": [
                                            "camelCase",
                                            "snake_case",
                                            "CONSTANT_CASE"
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    ],
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on",
                "useSortedAttributes": "on",
                "useSortedPackageJson": "on",
                "useSortedProperties": "on"
            }
        }
    }
}
