<Project>
    <PropertyGroup Label="Workspace">
        <RasmRepoRoot>$(MSBuildThisFileDirectory)</RasmRepoRoot>
        <ArtifactsPath>$([MSBuild]::NormalizePath('$(RasmRepoRoot)', '.artifacts', 'dotnet'))</ArtifactsPath>
        <RasmLibsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'libs'))</RasmLibsRoot>
        <RasmToolsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'tools'))</RasmToolsRoot>
        <RasmTestsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'tests'))</RasmTestsRoot>
        <RasmAppsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'apps'))</RasmAppsRoot>
    </PropertyGroup>

    <PropertyGroup Label="Package Metadata">
        <Authors>bsamiee</Authors>
        <Company>bsamiee</Company>
        <Copyright>Copyright © 2025 bsamiee</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Label="Build Defaults">
        <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <ItemGroup Label="Workspace Analyzers">
        <PackageReference Include="ErrorProne.NET.CoreAnalyzers"               PrivateAssets="all" />
        <PackageReference Include="Meziantou.Analyzer"                         PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Roslynator.Analyzers"                       PrivateAssets="all" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Analyzers"  PrivateAssets="all" />
    </ItemGroup>

    <!-- The version comes from the nearest tag of the project's release group, no project file states a version -->
    <ItemGroup Label="Release Version">
        <PackageReference Include="MinVer" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup Label="Rhino Host Bundle">
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and '$(RHINO_APP_PATH)' != ''">$(RHINO_APP_PATH)</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and Exists('/Applications/Rhino 9.app')">/Applications/Rhino 9.app</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and Exists('/Applications/RhinoBETA.app')">/Applications/RhinoBETA.app</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == ''">/Applications/RhinoWIP.app</RhinoAppPath>
        <!-- Separate name for the trailing slash because project XML cannot rewrite a -p:RhinoAppPath global property -->
        <_RhinoAppDir>$([MSBuild]::NormalizeDirectory('$(RhinoAppPath)'))</_RhinoAppDir>
        <RhinoResourcesPath>$(_RhinoAppDir)Contents/Frameworks/RhCore.framework/Versions/Current/Resources/</RhinoResourcesPath>
        <Grasshopper2PluginPath>$(RhinoResourcesPath)ManagedPlugIns/Grasshopper2Plugin.rhp/</Grasshopper2PluginPath>
    </PropertyGroup>
</Project>
