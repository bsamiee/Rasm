{
    "name": "@rasm/uxp",
    "private": true,
    "description": "Effect programs running inside Adobe hosts",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./entrypoints": "./entrypoints.ts",
        "./manifest": "./manifest.ts"
    },
    "dependencies": {
        "@rasm/search": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:"
    }
}
