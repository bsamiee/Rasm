{
    "name": "@rasm/nx-apple",
    "version": "0.1.0",
    "description": "Nx plugin inferring SwiftPM packages, Xcode projects, and Xcode workspaces from the toolchain's own output",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/apple"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "executors.json",
        "executors/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./executors.json": "./executors.json",
        "./executors/*": "./executors/*/executor.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.json": "./*.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./executors.json": "./executors.json",
            "./executors/*": "./dist/executors/*/executor.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "cf": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "optionalDependencies": {
        "@rasm/nx-apple-darwin-arm64": "workspace:*"
    },
    "engines": {
        "node": ">=27"
    },
    "executors": "./executors.json"
}
