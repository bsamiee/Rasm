{
    "name": "@rasm/nx-buf",
    "version": "0.0.0",
    "description": "Nx plugin inferring Protobuf code generation from each buf.gen.yaml",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/buf"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./package.json": "./package.json"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugins/project-graph.js",
            "./package.json": "./package.json"
        }
