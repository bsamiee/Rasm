{
    "name": "@rasm/uxp",
    "version": "0.1.0",
    "private": true,
    "description": "UXP manifests and the hosts that load them, plugin and script runtimes, Spectrum panel controls, and Vite plugin builds",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/uxp"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "icons/*.svg",
        "tsconfig.base.json"
    ],
    "type": "module",
    "sideEffects": [
        "plugin.*"
    ],
    "imports": {
        "#/*": "./*.ts",
        "#/*.svg": "./*.svg"
    },
    "exports": {
        "./manifest": "./manifest.ts",
        "./plugin": "./plugin.ts",
        "./spectrum": "./spectrum.ts",
        "./vite": "./vite.ts",
        "./tsconfig.base.json": "./tsconfig.base.json",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.svg": "./*.svg"
        },
        "exports": {
            "./manifest": "./dist/manifest.js",
            "./plugin": "./dist/plugin.js",
            "./spectrum": "./dist/spectrum.js",
            "./vite": "./dist/vite.js",
            "./tsconfig.base.json": "./tsconfig.base.json",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@exodus/bytes": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/mark": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "@rasm/vite": "workspace:*",
        "core-js": "catalog:",
        "culori": "catalog:",
        "image-size": "catalog:",
        "jsonc-parser": "catalog:"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
