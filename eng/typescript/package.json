{
    "name": "@rasm/eng",
    "private": true,
    "description": "Repository manifest readers, text formats, and command runs the workspace programs share, with the release, install, and upgrade programs",
    "type": "module",
    "imports": {
        "#/*": "./*"
    },
    "exports": {
        ".": "./index.ts"
    },
    "bin": {
