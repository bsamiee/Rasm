{
    "mcpServers": {
        "parallels": {
            "type": "stdio",
            "command": "pdfm-mcp",
            "default_tools_approval_mode": "approve"
        },
        "raycast": {
            "type": "http",
            "url": "http://127.0.0.1:8267/mcp",
            "http_headers_helper": "/usr/bin/plutil -extract codex json -expect dictionary -o - \"$HOME/.config/rasm/raycast-mcp.json\"",
            "headersHelper": "/usr/bin/plutil -extract claude json -expect dictionary -o - \"$HOME/.config/rasm/raycast-mcp.json\""
        },
        "superhuman-mail": {
            "type": "http",
            "url": "https://mcp.mail.superhuman.com/mcp",
            "default_tools_approval_mode": "approve"
        },
        "superhuman-docs": {
            "type": "http",
            "url": "https://docs.superhuman.com/apis/mcp",
            "default_tools_approval_mode": "approve"
        }
    }
}
