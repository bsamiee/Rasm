<Project>
    <!-- RhinoHost lists the Rhino host layers a project compiles against, each layer implies the ones below it -->
    <PropertyGroup Label="Host Classification">
        <_HostTokens>;$(RhinoHost);</_HostTokens>
        <HostGrasshopper Condition="$(_HostTokens.Contains(';grasshopper;'))">true</HostGrasshopper>
        <HostPlatform Condition="$(_HostTokens.Contains(';platform;'))">true</HostPlatform>
        <HostUi Condition="$(_HostTokens.Contains(';ui;')) or '$(HostPlatform)' == 'true' or '$(HostGrasshopper)' == 'true'">true</HostUi>
        <HostCommon Condition="$(_HostTokens.Contains(';common;')) or '$(HostUi)' == 'true'">true</HostCommon>
    </PropertyGroup>

    <!-- RHINO_APP_PATH or -p:RhinoAppPath overrides the installer locations of the host operating system -->
    <PropertyGroup Label="Rhino Host Bundle" Condition="'$(HostCommon)' == 'true'">
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and '$(RHINO_APP_PATH)' != ''">$(RHINO_APP_PATH)</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('/Applications/Rhino 9.app')">/Applications/Rhino 9.app</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and $([MSBuild]::IsOSPlatform('OSX')) and Exists('/Applications/RhinoBETA.app')">/Applications/RhinoBETA.app</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">/Applications/RhinoWIP.app</RhinoAppPath>
        <_RhinoProgramFiles Condition="$([MSBuild]::IsOSPlatform('Windows'))">$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFiles))</_RhinoProgramFiles>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and '$(_RhinoProgramFiles)' != '' and Exists('$(_RhinoProgramFiles)/Rhino 9')">$(_RhinoProgramFiles)/Rhino 9</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and '$(_RhinoProgramFiles)' != ''">$(_RhinoProgramFiles)/Rhino 9 WIP</RhinoAppPath>
        <!-- Private property for the trailing slash, project XML cannot reassign the RhinoAppPath global property -->
        <_RhinoAppDir Condition="'$(RhinoAppPath)' != ''">$([MSBuild]::NormalizeDirectory('$(RhinoAppPath)'))</_RhinoAppDir>
        <!-- System/netcore/ holds the .NET assemblies of a Windows installation, System/ alone holds the .NET Framework set -->
        <RhinoAssemblyDirectory Condition="'$(RhinoAssemblyDirectory)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(_RhinoAppDir)Contents/Frameworks/RhCore.framework/Versions/Current/Resources/</RhinoAssemblyDirectory>
        <RhinoAssemblyDirectory Condition="'$(RhinoAssemblyDirectory)' == '' and Exists('$(_RhinoAppDir)System/netcore/')">$(_RhinoAppDir)System/netcore/</RhinoAssemblyDirectory>
        <RhinoAssemblyDirectory Condition="'$(RhinoAssemblyDirectory)' == ''">$(_RhinoAppDir)System/</RhinoAssemblyDirectory>
        <Grasshopper2PluginPath Condition="'$(Grasshopper2PluginPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(RhinoAssemblyDirectory)ManagedPlugIns/Grasshopper2Plugin.rhp/</Grasshopper2PluginPath>
        <Grasshopper2PluginPath Condition="'$(Grasshopper2PluginPath)' == ''">$(_RhinoAppDir)Plug-ins/Grasshopper2/net48/</Grasshopper2PluginPath>
    </PropertyGroup>

    <!-- Projects released together set one ReleaseGroup, the <ReleaseGroup>@<version> tag versions every project in it -->
    <PropertyGroup Label="Release Version">
        <ReleaseGroup Condition="'$(ReleaseGroup)' == ''">$(MSBuildProjectName)</ReleaseGroup>
        <MinVerTagPrefix>$(ReleaseGroup)@</MinVerTagPrefix>
        <!-- Commits to other projects add no height to this project's version -->
        <MinVerIgnoreHeight>true</MinVerIgnoreHeight>
    </PropertyGroup>

    <PropertyGroup Label="Native Assets">
        <_TorchLibompInstallName>/opt/homebrew/opt/libomp/lib/libomp.dylib</_TorchLibompInstallName>
    </PropertyGroup>

    <!-- The test framework package sets IsTestingPlatformApplication, and IsTestProject makes the Nx plugin infer the test target -->
    <PropertyGroup Label="Test Coverage" Condition="'$(IsTestingPlatformApplication)' == 'true'">
        <IsTestProject>true</IsTestProject>
        <_TestResultsDirectory>$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)', 'coverage', '$(MSBuildProjectName)'))</_TestResultsDirectory>
        <TestingPlatformCommandLineArguments>--coverlet --coverlet-output-format cobertura --results-directory "$(_TestResultsDirectory)"</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <ItemGroup Label="Project Usings">
        <Using Include="System.Collections.Frozen;System.Collections.Immutable" />
        <Using Include="Thinktecture" Condition="'@(PackageReference->WithMetadataValue('Identity', 'Thinktecture.Runtime.Extensions'))' != ''" />
        <Using Include="LanguageExt;LanguageExt.Common;LanguageExt.Effects;LanguageExt.Pretty;LanguageExt.Traits;LanguageExt.Traits.Domain" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Core'))' != ''" />
        <Using Include="LanguageExt.Prelude" Static="true" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Core'))' != ''" />
        <Using Include="LanguageExt.Pipes" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Streaming'))' != ''" />
        <Using Include="LanguageExt.Sys;LanguageExt.Sys.IO;LanguageExt.Sys.Traits;LanguageExt.Sys.Diag" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Sys'))' != ''" />
        <!-- LanguageExt.Parsec exports a static class Char, sources spell the BCL type as the keyword char -->
        <Using Include="LanguageExt.Parsec" Condition="'@(PackageReference->WithMetadataValue('Identity', 'LanguageExt.Parsec'))' != ''" />
        <Using Include="NodaTime;NodaTime.Extensions" Condition="'@(PackageReference->WithMetadataValue('Identity', 'NodaTime'))' != ''" />
        <!-- LanguageExt also exports Duration, sources spell LanguageExt.Duration in full -->
        <Using Include="NodaTime.Duration" Alias="Duration" Condition="'@(PackageReference->WithMetadataValue('Identity', 'NodaTime'))' != ''" />
        <Using Include="Xunit" Condition="'@(PackageReference->WithMetadataValue('Identity', 'xunit.v3.mtp-v2'))' != '' or '@(PackageReference->WithMetadataValue('Identity', 'xunit.v3.assert'))' != ''" />
        <Using Include="CsCheck" Condition="'@(PackageReference->WithMetadataValue('Identity', 'CsCheck'))' != ''" />
    </ItemGroup>

    <ItemGroup Label="Rhino Host Assemblies" Condition="'$(HostCommon)' == 'true'">
        <_RhinoHostAssembly Include="RhinoCommon" />
        <_RhinoHostAssembly Include="Eto" Condition="'$(HostUi)' == 'true'" />
        <_RhinoHostAssembly Include="Eto.macOS;Microsoft.macOS;Rhino.UI" Condition="'$(HostPlatform)' == 'true'" />
        <Reference Include="@(_RhinoHostAssembly)" HintPath="$(RhinoAssemblyDirectory)%(Identity).dll" Private="false" />
        <Reference Include="Grasshopper2;GrasshopperIO" HintPath="$(Grasshopper2PluginPath)%(Identity).dll" Private="false" Condition="'$(HostGrasshopper)' == 'true'" />
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="runtime" Condition="'$(HostUi)' == 'true'" />
        <Using Include="Rhino.Geometry" />
        <Using Include="Grasshopper2.Types.Numeric;Grasshopper2.UI" Condition="'$(HostGrasshopper)' == 'true'" />
        <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute" Condition="'$(HostPlatform)' == 'true'">
            <_Parameter1>macos</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Label="Workspace Policy">
        <ProjectReference Include="$(ToolsRoot)dotnet/Rasm.Policy.Analyzers/Rasm.Policy.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(PluginHost)' == 'true'" />
        <!-- Plugin host libraries opt in with PluginHost=true -->
        <CompilerVisibleProperty Include="PluginHost" />
        <PackageReference Include="xunit.analyzers" PrivateAssets="all" Condition="'$(ProjectRole)' == 'tests'" />
    </ItemGroup>

    <!-- coverlet.MTP names every report by a timestamp, rasm:coverage merges the directory, and a run starts from an empty one -->
    <Target Name="CleanTestResults" BeforeTargets="ComputeRunArguments" Condition="'$(IsTestingPlatformApplication)' == 'true'">
        <RemoveDir Directories="$(_TestResultsDirectory)" />
    </Target>

    <Target Name="VerifyRhinoHostBundle" BeforeTargets="ResolveAssemblyReferences" Condition="'$(HostCommon)' == 'true'">
        <ItemGroup>
            <_MissingRhinoHostFile Include="@(Reference->'%(HintPath)')" Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" />
        </ItemGroup>
        <Error Code="RASM0003" Condition="'@(_MissingRhinoHostFile)' != ''"
               Text="Rhino installation '$(RhinoAppPath)' lacks @(_MissingRhinoHostFile->'%(Filename)%(Extension)', ', '), set RHINO_APP_PATH to a Rhino 9 installation" />
    </Target>

    <Target Name="ValidateProjectPolicy" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_ProjectDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</_ProjectDir>
            <_PackageReferences>;@(PackageReference, ';');</_PackageReferences>
            <!-- A package or project reference satisfies the companion, and the companion project itself is exempt -->
            <_RuntimeInitReferences>;$(MSBuildProjectName);@(PackageReference, ';');@(ProjectReference->'%(Filename)', ';');</_RuntimeInitReferences>
        </PropertyGroup>
        <ItemGroup>
            <!-- ReferenceOutputAssembly=false edges (the analyzer project) sequence the build and are exempt -->
            <_ProjectReference Include="@(ProjectReference->'%(FullPath)')" Condition="'%(ProjectReference.ReferenceOutputAssembly)' != 'false'" />
            <_InvalidProjectReference Include="@(_ProjectReference)" Condition="'$(ProjectRole)' == 'libs' and !$([System.String]::Copy('%(Identity)').StartsWith('$(LibsRoot)'))" />
            <_InvalidProjectReference Include="@(_ProjectReference)" Condition="'$(ProjectRole)' == 'tools' and !$([System.String]::Copy('%(Identity)').StartsWith('$(LibsRoot)')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(ToolsRoot)'))" />
            <_InvalidProjectReference Include="@(_ProjectReference)" Condition="'$(ProjectRole)' == 'tests' and $([System.String]::Copy('%(Identity)').StartsWith('$(AppsRoot)'))" />
            <_InvalidProjectReference Include="@(_ProjectReference)" Condition="'$(ProjectRole)' == 'apps' and !$([System.String]::Copy('%(Identity)').StartsWith('$(LibsRoot)')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(_ProjectDir)'))" />
            <_NativeBinding Include="DuckDB.NET.Data.Full" Native="Rasm.Native.DuckDBExtensions" />
            <_NativeBinding Include="Emgu.CV" Native="Rasm.Native.EmguCv" />
            <_NativeBinding Include="lcms2-dotnet" Native="Rasm.Native.Lcms2" />
            <_NativeBinding Include="FFmpeg.AutoGen" Native="Rasm.Native.FFmpeg" />
            <_NativeBinding Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Native="Rasm.Native.FFmpeg" />
            <_NativeBinding Include="Rasm.Z3" Native="Rasm.Native.Z3" />
            <_NativeBinding Include="Rasm.Gmsh" Native="Rasm.Native.Gmsh" />
            <_NativeBinding Include="PureHDF.Filters.Blosc2" Native="Rasm.Native.Blosc2" />
            <_RuntimeInitBinding Include="Emgu.CV" Companion="Rasm.Interop.OpenCv" />
            <_RuntimeInitBinding Include="EPPlus" Companion="Rasm.Interop.Excel" />
            <!-- iText crypto paths throw NotSupportedException without the Bouncy Castle adapter it discovers at runtime, pdfHTML runs on the same kernel -->
            <_RuntimeInitBinding Include="itext" Companion="itext.bouncy-castle-adapter" />
            <_RuntimeInitBinding Include="itext.pdfhtml" Companion="itext.bouncy-castle-adapter" />
            <_RuntimeInitBinding Include="MaxRev.Gdal.Core" Companion="Rasm.Interop.Gdal" />
            <!-- MigraDoc renders through PDFsharp and needs the same font resolver -->
            <_RuntimeInitBinding Include="PDFsharp" Companion="Rasm.Interop.Pdf" />
            <_RuntimeInitBinding Include="PDFsharp-MigraDoc" Companion="Rasm.Interop.Pdf" />
            <_RuntimeInitBinding Include="PureHDF.Filters.Blosc2" Companion="Rasm.Interop.Hdf5" />
            <_RuntimeInitBinding Include="PureHDF.Filters.BZip2.SharpZipLib" Companion="Rasm.Interop.Hdf5" />
            <_RuntimeInitBinding Include="PureHDF.Filters.Lzf" Companion="Rasm.Interop.Hdf5" />
            <!-- The vec0 loadable does nothing until a connection loads it, the facade holds the per-connection load -->
            <_RuntimeInitBinding Include="Rasm.Native.SqliteVec" Companion="Rasm.Interop.SqliteVec" />
        </ItemGroup>
        <Error Code="RASM0001" Condition="'@(_InvalidProjectReference)' != ''"
               Text="Role '$(ProjectRole)' project '$(MSBuildProjectName)' references outside its allowed set: @(_InvalidProjectReference->'%(Identity)', '; ')" />
        <Error Code="RASM0004"
               Condition="$(_PackageReferences.Contains(';%(_NativeBinding.Identity);')) and !$(_PackageReferences.Contains(';%(_NativeBinding.Native);'))"
               Text="Project '$(MSBuildProjectName)' references %(_NativeBinding.Identity) without %(_NativeBinding.Native), the package that supplies its shared libraries" />
        <Error Code="RASM0005"
               Condition="$(_RuntimeInitReferences.Contains(';%(_RuntimeInitBinding.Identity);')) and !$(_RuntimeInitReferences.Contains(';%(_RuntimeInitBinding.Companion);'))"
               Text="Project '$(MSBuildProjectName)' references %(_RuntimeInitBinding.Identity) without %(_RuntimeInitBinding.Companion), the reference that holds its runtime initialization" />
    </Target>

    <!-- Adds native assets a package holds only in build/, a folder transitive consumers never import -->
    <Target Name="AddMissingNativeAssets" AfterTargets="ResolvePackageAssets" Condition="'@(RuntimeCopyLocalItems)' != ''">
        <PropertyGroup>
            <_HostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_HostArchitecture>
            <_HostArchitecture>$(_HostArchitecture.ToLowerInvariant())</_HostArchitecture>
            <_NuGetPackageRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_NuGetPackageRoot>
            <_ResolvedPackageIds>;@(RuntimeCopyLocalItems->'%(NuGetPackageId)', ';');</_ResolvedPackageIds>
            <_DirectPackageIds>;@(PackageReference, ';');</_DirectPackageIds>
            <_CentralVersions>;@(PackageVersion->'%(Identity)=%(Version)', ';');</_CentralVersions>
        </PropertyGroup>
        <ItemGroup>
            <!-- The package targets link the dylib into the output root of an osx build, Windows resolves runtimes/win-*/ through NuGet and Linux has no native library -->
            <_MissingNativeAsset Include="Melanchall.DryWetMidi" ManagedPackage="Melanchall.DryWetMidi" PackageRelativePath="build/Melanchall_DryWetMidi_Native.dylib" SkipDirectConsumers="true" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
            <!-- The package targets copy every desktop platform folder to runtimes/<platform>/ of a build without an OS-specific target framework -->
            <_WhisperPlatform Include="linux-arm;linux-arm64;linux-x64;macos-arm64;macos-x64;win-arm64;win-x64;win-x86" />
            <_MissingNativeAsset Include="Whisper.net.Runtime" ManagedPackage="Whisper.net" PackageRelativePath="build/%(_WhisperPlatform.Identity)/*" DestinationSubDirectory="runtimes/%(_WhisperPlatform.Identity)/" SkipDirectConsumers="true" />
            <!-- The version-specific RID runtimes/osx.10.14-<arch>/ never resolves under the portable RID model, direct references included, and the other platforms have portable RIDs -->
            <_MissingNativeAsset Include="Microsoft.ML.OnnxRuntime.Extensions" ManagedPackage="Microsoft.ML.OnnxRuntime.Managed" PackageRelativePath="runtimes/osx.10.14-$(_HostArchitecture)/native/libortextensions.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
        </ItemGroup>
        <ItemGroup>
            <!-- SkipDirectConsumers rows reach direct consumers through the package build/ import, the repair covers transitive consumers only -->
            <_NativeAssetSource Include="@(_MissingNativeAsset)" Condition="$(_ResolvedPackageIds.Contains(';%(_MissingNativeAsset.ManagedPackage);')) and ('%(_MissingNativeAsset.SkipDirectConsumers)' == '' or !$(_DirectPackageIds.Contains(';%(_MissingNativeAsset.Identity);')))">
                <ResolvedVersion>$([System.Text.RegularExpressions.Regex]::Match($(_CentralVersions), ';%(_MissingNativeAsset.Identity)=([^;]*)').Groups[1].Value)</ResolvedVersion>
            </_NativeAssetSource>
            <_NativeAssetSource>
                <PackageRoot>$(_NuGetPackageRoot)$([System.String]::Copy('%(_NativeAssetSource.Identity)/%(_NativeAssetSource.ResolvedVersion)/').ToLowerInvariant())</PackageRoot>
            </_NativeAssetSource>
            <_NativeAssetFile Include="%(_NativeAssetSource.PackageRoot)%(_NativeAssetSource.PackageRelativePath)">
                <NuGetPackageId>%(_NativeAssetSource.Identity)</NuGetPackageId>
                <NuGetPackageVersion>%(_NativeAssetSource.ResolvedVersion)</NuGetPackageVersion>
                <PackageRoot>%(_NativeAssetSource.PackageRoot)</PackageRoot>
                <DestinationSubDirectory>%(_NativeAssetSource.DestinationSubDirectory)</DestinationSubDirectory>
                <AssetType>native</AssetType>
                <CopyLocal>true</CopyLocal>
            </_NativeAssetFile>
            <_NativeAssetFile>
                <PathInPackage>$([MSBuild]::MakeRelative('%(_NativeAssetFile.PackageRoot)', '%(_NativeAssetFile.FullPath)'))</PathInPackage>
            </_NativeAssetFile>
            <NativeCopyLocalItems Include="@(_NativeAssetFile)" />
        </ItemGroup>
    </Target>

    <!-- NETSDK1206, the listed packages pin assets to a version- or distribution-specific RID and naming the platform keeps their deps.json entries -->
    <Target Name="RegisterNonPortableRidPlatforms" BeforeTargets="GenerateBuildDependencyFile">
        <ItemGroup>
            <_NonPortableRidPackage Include="Microsoft.ML.OnnxRuntime.Extensions" Platform="osx.10.14" />
            <_NonPortableRidPackage Include="UVtools.Core" Platform="ubuntu" />
        </ItemGroup>
        <PropertyGroup>
            <_NonPortableRidGraphIds>;@(PackageReference, ';');@(RuntimeCopyLocalItems->'%(NuGetPackageId)', ';');@(RuntimeTargetsCopyLocalItems->'%(NuGetPackageId)', ';');</_NonPortableRidGraphIds>
        </PropertyGroup>
        <ItemGroup>
            <_KnownRuntimeIdentiferPlatforms Include="%(_NonPortableRidPackage.Platform)" Condition="$(_NonPortableRidGraphIds.Contains(';%(_NonPortableRidPackage.Identity);'))" />
        </ItemGroup>
    </Target>

    <!-- Retargets libtorch_cpu.dylib in the output from the Homebrew libomp install name to the bundled libomp.dylib and re-signs it -->
    <Target Name="RetargetTorchLibompInstallName" AfterTargets="CopyFilesToOutputDirectory" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <ItemGroup>
            <_TorchCpuDylib Include="$(OutDir)runtimes/*/native/libtorch_cpu.dylib" />
        </ItemGroup>
        <Exec Command="install_name_tool -change $(_TorchLibompInstallName) @loader_path/libomp.dylib '%(_TorchCpuDylib.FullPath)' &amp;&amp; codesign --force --sign - '%(_TorchCpuDylib.FullPath)'"
              Condition="'@(_TorchCpuDylib)' != ''" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    </Target>

    <!-- Publish copies the dylib from the NuGet cache again and needs the same retarget -->
    <Target Name="RetargetTorchLibompInstallNameOnPublish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <ItemGroup>
            <_TorchCpuPublishDylib Include="$(PublishDir)runtimes/*/native/libtorch_cpu.dylib" />
        </ItemGroup>
        <Exec Command="install_name_tool -change $(_TorchLibompInstallName) @loader_path/libomp.dylib '%(_TorchCpuPublishDylib.FullPath)' &amp;&amp; codesign --force --sign - '%(_TorchCpuPublishDylib.FullPath)'"
              Condition="'@(_TorchCpuPublishDylib)' != ''" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    </Target>
</Project>
