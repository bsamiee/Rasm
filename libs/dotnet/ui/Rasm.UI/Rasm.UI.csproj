<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Retained Skia scenes with pure layout, cascading appearances, and input routing for drawn host UI</Description>
    </PropertyGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="LanguageExt.Streaming" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Json" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="System.Numerics.Tensors" />
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
        <PackageReference Include="Wacton.Unicolour.Datasets" />
    </ItemGroup>

    <ItemGroup Label="Desktop UI">
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.HarfBuzz" />
        <PackageReference Include="HarfBuzzSharp" />
        <PackageReference Include="Topten.RichTextKit" />
        <PackageReference Include="Svg.Skia" />
        <PackageReference Include="Svg.Model" />
    </ItemGroup>

    <ItemGroup Label="Workspace Sources">
        <Compile Include="../../Invariant.cs" />
        <Compile Include="../../LanguageJson.cs" />
        <Compile Include="../../ValidationResults.cs" />
    </ItemGroup>

    <ItemGroup Label="Embedded Resources">
        <EmbeddedResource Include="../../../python/blender/bpy/ui/resources/appearances.json" LogicalName="appearances.json" WithCulture="false" />
    </ItemGroup>
</Project>
