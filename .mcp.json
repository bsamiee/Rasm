{
    "mcpServers": {
        "adobe": {
            "type": "http",
            "url": "http://127.0.0.1:7409/"
        },
        "roslyn-codelens": {
            "type": "http",
            "url": "http://127.0.0.1:7401/"
        },
        "binlog": {
            "type": "http",
            "url": "http://127.0.0.1:7403/"
        },
        "nuget": {
            "type": "http",
            "url": "http://127.0.0.1:7402/"
        },
        "ast-grep": {
            "type": "http",
            "url": "http://127.0.0.1:7404/"
        },
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GH_PROJECTS_TOKEN}",
                "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions,git,dependabot,github_support_docs_search",
                "X-MCP-Exclude-Tools": "delete_repository,delete_file,create_repository,fork_repository,push_files,create_or_update_file",
                "X-MCP-Features": "file_blame,issue_dependencies"
            }
        },
        "exa": {
            "type": "http",
            "url": "https://mcp.exa.ai/mcp?tools=web_fetch_exa,web_search_advanced_exa,agent_run",
            "headers": {
                "x-api-key": "${EXA_API_KEY}"
            }
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "Authorization": "Bearer ${CONTEXT7_API_KEY}"
            }
        },
        "deepwiki": {
            "type": "http",
            "url": "https://mcp.deepwiki.com/mcp"
        },
        "greptile": {
            "type": "http",
            "url": "https://api.greptile.com/mcp",
            "headers": {
                "Authorization": "Bearer ${GREPTILE_API_KEY}"
            }
        },
        "openaiDeveloperDocs": {
            "type": "http",
            "url": "https://developers.openai.com/mcp"
        },
        "claudeCodeDocs": {
            "type": "http",
            "url": "https://code.claude.com/docs/mcp"
        },
        "illustrator": {
            "type": "http",
            "url": "http://localhost:18412/v1/mcp",
            "headers": {
                "Authorization": "Bearer ${ILLUSTRATOR_MCP_TOKEN}"
            }
        },
        "arena": {
            "type": "http",
            "url": "https://mcp.are.na/mcp"
        },
        "xcode": {
            "command": "xcrun",
            "args": ["mcpbridge"]
        },
        "lldb": {
            "command": "xcrun",
            "args": ["lldb-mcp"]
        },
        "rhino-mcp-platform": {
            "type": "http",
            "url": "http://127.0.0.1:7406/"
        },
        "blender": {
            "type": "http",
            "url": "http://127.0.0.1:7407/"
        },
        "mcp-for-blender": {
            "type": "http",
            "url": "http://127.0.0.1:7408/"
        }
    }
}
