{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Xcode.xcconfig" },
    { "name": "Release", "file": "Xcode.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "../../../..",
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.10.0",
      },
    },
  ],
  "files": [
    { "path": "<PROJECT>/../../../../Xcode.xcconfig" },
    {
      "kind": "folder",
      "path": ".",
      "target-membership": [
        "Atelier",
      ],
      "membership-exceptions": [
        {
          "target": "Atelier",
          "exclusions": [
            "Info.plist",
            "buildServer.json",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Atelier.app", "id": "DF819D1F3089FBAF00B8A072", "type": "wrapper.application", "index": false },
      ],
    },
    { "kind": "folder", "path": "../../../../.artifacts/apps/creative-cloud/indesign/galley", "target-membership": [ "Atelier" ] },
  ],
  "targets": [
    {
      "name": "Atelier",
      "id": "DF819D1E3089FBAF00B8A072",
      "product": "Products/Atelier.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "..",
          "product-name": "AdobeScripting",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "AppleEvents",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Applications",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "CurrentProcess",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "EffectRPC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Fonts",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "AUTOMATION_APPLE_EVENTS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSBackgroundOnly": "YES",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Atelier runs scripting commands in Adobe apps when an MCP client requests them.",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.rasm.atelier",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    },
  ],
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
