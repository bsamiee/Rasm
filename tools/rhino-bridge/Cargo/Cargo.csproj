<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Collectible-ALC cargo for in-host scenario discovery, capability probes, crash-durable evidence spooling, and GH2 rendering.</Description>
        <AssemblyName>Rasm.Bridge.Cargo</AssemblyName>
        <RootNamespace>Rasm.Bridge.Cargo</RootNamespace>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RasmHost>grasshopper;platform</RasmHost>
    </PropertyGroup>

    <ItemGroup Label="Cargo Packages">
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
    </ItemGroup>

    <ItemGroup Label="Project References">
        <ProjectReference Include="../Contract/Contract.csproj" Private="false" />
        <ProjectReference Include="../../../tests/dotnet/scenariokit/Rasm.ScenarioKit.csproj" />
    </ItemGroup>
</Project>
