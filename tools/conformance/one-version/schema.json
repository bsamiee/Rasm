{
    "$schema": "http://json-schema.org/schema",
    "$id": "one-version",
    "title": "one-version rule configuration",
    "type": "object",
    "properties": {
        "packages": {
            "type": "array",
            "description": "Package name globs whose installed packages share one version",
            "items": { "type": "string" },
            "minItems": 1
        }
    },
    "required": ["packages"],
    "additionalProperties": false
}
