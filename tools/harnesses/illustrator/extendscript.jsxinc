    var codec = shared.codec({ named: enumerator, plain: hosted, located: located, constructed: true });

    // --- [PREFERENCES]
    function kinds() {
        var found = [];
        var methods = realApp.preferences.reflect.methods;
        for (var i = 0; i < methods.length; i++) {
            var parts = PREFERENCE.exec(methods[i].name);
            if (parts) { found.push(parts[1]); }
