<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="Test Application">
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
        <GenerateSelfRegisteredExtensions>true</GenerateSelfRegisteredExtensions>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>Headless;Interface</Configurations>
        <Configuration Condition="$([MSBuild]::IsOSPlatform(`OSX`))">Interface</Configuration>
        <Configuration Condition="!$([MSBuild]::IsOSPlatform(`OSX`))">Headless</Configuration>
        <TestingPlatformCommandLineArguments>--report-trx --hangdump --hangdump-timeout 10m --hangdump-type Mini --crashdump --crashdump-type Mini --crash-report-if-supported</TestingPlatformCommandLineArguments>
        <RhinoVersion>9.0.26300.9401</RhinoVersion>
    </PropertyGroup>

    <PropertyGroup Label="Test Host" Condition="'$(OS)' != 'Windows_NT'">
        <RhinoApplication>$(HOME)/Applications/Rhino $(RhinoVersion.Split(`.`)[0]).app</RhinoApplication>
        <RhinoApplication Condition="!Exists('$(RhinoApplication)')">/Applications/Rhino $(RhinoVersion.Split(`.`)[0]).app</RhinoApplication>
    </PropertyGroup>

    <PropertyGroup Label="Test Host" Condition="'$(OS)' == 'Windows_NT'">
        <TargetFramework>net10.0-windows</TargetFramework>
        <NuGetLockFilePath>packages.windows.lock.json</NuGetLockFilePath>
        <RhinoApplication>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\McNeel\Rhinoceros\$(RhinoVersion.Split(`.`)[0]).0\Install', 'CoreDllPath', '', RegistryView.Registry64))</RhinoApplication>
    </PropertyGroup>

    <PropertyGroup Label="Test Host" Condition="'$(OS)' != 'Windows_NT' and !Exists('$(RhinoApplication)')">
        <IsTestProject>false</IsTestProject>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup Label="Test Host">
        <ProjectCapability Include="RuntimeEnvironmentVariableSupport" />
        <RuntimeHostConfigurationOption Include="RhinoVersion" Value="$(RhinoVersion)" />
        <RuntimeHostConfigurationOption Include="RhinoMode" Value="$(Configuration)" Condition="'$(Configuration)' == 'Interface'" />
    </ItemGroup>

    <ItemGroup Label="Test Host" Condition="'$(OS)' != 'Windows_NT'">
        <Compile Remove="Windows.cs" />
        <RuntimeEnvironmentVariable Include="DYLD_INSERT_LIBRARIES" Value="$(TargetDir)libbackground.dylib" />
        <PackageReference Include="Microsoft.macOS.Ref.net10.0_26.0" Version="26.0.11017" ExcludeAssets="all" GeneratePathProperty="true" />
        <Reference Include="$(PkgMicrosoft_macOS_Ref_net10_0_26_0)/ref/net10.0/Microsoft.macOS.dll" Private="false" />
    </ItemGroup>

    <ItemGroup Label="Test Host" Condition="'$(OS)' == 'Windows_NT'">
        <Compile Remove="Darwin.cs" />
        <PackageReference Include="Rhino.Inside" Version="9.0.26084.13070-beta" />
    </ItemGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="RhinoCommon" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Grasshopper" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
        <PackageReference Include="Grasshopper2" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Label="Property Testing">
        <PackageReference Include="CsCheck" Version="5.0.1" />
        <RuntimeEnvironmentVariable Include="CsCheck_Threads" Value="1" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
        <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    </ItemGroup>

    <ItemGroup Label="Subject">
        <ProjectReference Include="../Library/Library.csproj" />
    </ItemGroup>

    <Target Name="ResolveRhinoApplication" AfterTargets="ResolvePackageAssets" BeforeTargets="ComputeRunArguments" DependsOnTargets="ResolvePackageAssets" Condition="'$(IsTestProject)' == 'true'">
        <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
            <_RhinoResources>$(RhinoApplication)/Contents/Frameworks/RhCore.framework/Resources/</_RhinoResources>
            <RunCommand>$(_RhinoResources)dotnet/$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())/dotnet</RunCommand>
        </PropertyGroup>
        <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
            <_RhinoResources>$([System.IO.Path]::GetDirectoryName('$(RhinoApplication)'))\netcore\</_RhinoResources>
            <RunCommand>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\dotnet\Setup\InstalledVersions\x64', 'InstallLocation', '', RegistryView.Registry32))dotnet.exe</RunCommand>
        </PropertyGroup>
        <PropertyGroup>
            <RunArguments>exec &quot;$(TargetPath)&quot; $(RunArguments)</RunArguments>
        </PropertyGroup>
        <ItemGroup>
            <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="Exists('$(_RhinoResources)%(Filename)%(Extension)')" />
        </ItemGroup>
    </Target>

    <Target Name="RequireRhinoApplication" BeforeTargets="ComputeRunArguments" DependsOnTargets="ResolveRhinoApplication" Condition="'$(IsTestProject)' == 'true'">
        <Error Condition="!Exists('$(RunCommand)')" Text="$(MSBuildProjectName) runs on Rhino $(RhinoVersion), whose .NET runtime is absent at '$(RunCommand)'" />
    </Target>

    <Target Name="BuildBackground" BeforeTargets="CopyFilesToOutputDirectory" Inputs="Background.m" Outputs="$(TargetDir)libbackground.dylib" Condition="'$(IsTestProject)' == 'true' and '$(OS)' != 'Windows_NT'">
        <Exec Command="xcrun clang -dynamiclib -fobjc-arc -O2 -Wall -Werror -Wno-deprecated-declarations -framework AppKit -framework ApplicationServices -o &quot;$(TargetDir)libbackground.dylib&quot; Background.m" />
        <ItemGroup>
            <FileWrites Include="$(TargetDir)libbackground.dylib" />
        </ItemGroup>
    </Target>
</Project>
