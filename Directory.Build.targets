<Project>
    <!-- RasmHost is the body-declared host-surface token set (common | grasshopper | ui | platform), so its derivations live here, after the body evaluates; every reader is an item-pass condition or an execution-time property, which both see these verdicts. Implication chain: grasshopper carries common and ui; platform carries ui. -->
    <PropertyGroup Label="Host Surface">
        <HostGrasshopper Condition="'$(HostGrasshopper)' == '' and ($([System.String]::Copy(';$(RasmHost);').Contains(';grasshopper;')) or '$(RasmPlugin)' == 'grasshopper')">true</HostGrasshopper>
        <HostPlatform Condition="'$(HostPlatform)' == '' and $([System.String]::Copy(';$(RasmHost);').Contains(';platform;'))">true</HostPlatform>
        <HostUi Condition="'$(HostUi)' == '' and ($([System.String]::Copy(';$(RasmHost);').Contains(';ui;')) or '$(HostPlatform)' == 'true' or '$(HostGrasshopper)' == 'true')">true</HostUi>
        <HostCommon Condition="'$(HostCommon)' == '' and ($([System.String]::Copy(';$(RasmHost);').Contains(';common;')) or '$(HostGrasshopper)' == 'true' or '$(RasmPlugin)' == 'rhino')">true</HostCommon>
    </PropertyGroup>

    <!-- Plugin packaging derives from the body-declared RasmPlugin token; plugins additionally declare their own RuntimeIdentifier and EnableDynamicLoading, which evaluate too early to derive here. -->
    <PropertyGroup Label="Plugin Packaging">
        <TargetExt Condition="'$(RasmPlugin)' != ''">.rhp</TargetExt>
        <IncludeSourceRevisionInInformationalVersion Condition="'$(RasmPlugin)' != '' or '$(IsRhinoBridgeProject)' == 'true'">false</IncludeSourceRevisionInInformationalVersion>
        <CspScope Condition="'$(CspScope)' == '' and '$(RasmPlugin)' != ''">Boundary</CspScope>
    </PropertyGroup>

    <!-- UseWorkspaceLibraries is project-body-settable, so props-time derivation freezes UsesThinktecture against the pre-body default and hands a non-consumer the JetBrains.Annotations identity. Every reader is an item-pass condition, which evaluates after this file. -->
    <PropertyGroup Label="Workspace Library Policy">
        <UseWorkspaceLibraries Condition="'$(UseWorkspaceLibraries)' == '' and ('$(RasmPlugin)' != '' or '$(IsRhinoBridgeContractProject)' == 'true' or '$(IsRhinoBridgeShellProject)' == 'true' or '$(RasmGenerated)' == 'true' or '$(IsCspContractsProject)' == 'true')">false</UseWorkspaceLibraries>
        <UseWorkspaceLibraries Condition="'$(UseWorkspaceLibraries)' == ''">true</UseWorkspaceLibraries>
        <!-- Thinktecture consumers bind to one shared public JetBrains.Annotations identity. -->
        <UsesThinktecture Condition="'$(UsesThinktecture)' == '' and '$(IsLocalCSharpAnalyzerProject)' != 'true' and ('$(UseWorkspaceLibraries)' == 'true' or '$(IsRhinoBridgeContractProject)' == 'true' or '$(IsRhinoBridgeShellProject)' == 'true')">true</UsesThinktecture>
        <NeedsSystemDrawingCompilePackage Condition="'$(NeedsSystemDrawingCompilePackage)' == '' and '$(HostUi)' == 'true'">true</NeedsSystemDrawingCompilePackage>
    </PropertyGroup>

    <!-- Reads UsesThinktecture, so it follows that derivation; the generator consumes the value through a CompilerVisibleProperty the editorconfig target resolves at execution. -->
    <PropertyGroup Label="Thinktecture Identity Generators" Condition="'$(UsesThinktecture)' == 'true'">
        <!-- One public JetBrains.Annotations identity avoids Thinktecture-generated internal polyfill collisions. -->
        <ThinktectureRuntimeExtensions_SourceGenerator_GenerateJetBrainsAnnotations>false</ThinktectureRuntimeExtensions_SourceGenerator_GenerateJetBrainsAnnotations>
    </PropertyGroup>

    <!-- Yak properties derive from the project-body YakPackageSlug; props-time evaluation sees an empty slug, so the block lives here. -->
    <PropertyGroup Label="Plugin And Yak Packaging">
        <YakPath Condition="'$(YakPath)' == '' and '$(RHINO_YAK_PATH)' != ''">$(RHINO_YAK_PATH)</YakPath>
        <YakPath Condition="'$(YakPath)' == ''">$(RhinoWipAppPath)/Contents/Resources/bin/yak</YakPath>
        <YakPlatform Condition="'$(YakPlatform)' == ''">mac</YakPlatform>
        <YakPushSource Condition="'$(YakPushSource)' == '' and '$(YAK_SOURCE)' != ''">$(YAK_SOURCE)</YakPushSource>
        <YakManifestDirectory Condition="'$(YakManifestDirectory)' == '' and '$(YakPackageSlug)' != ''">$([MSBuild]::NormalizePath('$(YakPackagesRoot)', '$(YakPackageSlug)'))</YakManifestDirectory>
        <IsYakPackageProject Condition="'$(IsYakPackageProject)' == '' and '$(YakPackageSlug)' != '' and '$(RasmPlugin)' != ''">true</IsYakPackageProject>
        <YakPackageDirectory Condition="'$(YakPackageDirectory)' == '' and '$(YakPackageSlug)' != ''">$([MSBuild]::NormalizePath('$(YakStageRoot)', '$(YakPackageSlug)', 'package'))</YakPackageDirectory>
        <YakPackagePattern Condition="'$(YakPackagePattern)' == '' and '$(YakPackageSlug)' != ''">*-$(Version)-rh9_*-$(YakPlatform).yak</YakPackagePattern>
    </PropertyGroup>

    <!-- AssayTestShell is body-set, so the test verdict settles here and nothing upstream may pre-answer it; a spec-free shell stays a library that solution-scope `dotnet test` never discovers. -->
    <PropertyGroup Label="Test Classification">
        <IsTestProject Condition="'$(IsTestProject)' == '' and '$(AssayTestShell)' == 'true'">false</IsTestProject>
        <IsTestProject Condition="'$(IsTestProject)' == '' and '$(IsTestLaneProject)' == 'true'">true</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Label="Test Runtime Config" Condition="'$(IsTestProject)' == 'true'">
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <_XunitRunnerJsonContent>{"$schema":"https://xunit.net/schema/v3.1/xunit.runner.schema.json","parallelAlgorithm":"conservative","preEnumerateTheories":true,"longRunningTestSeconds":30,"printMaxEnumerableLength":64,"printMaxObjectDepth":4}</_XunitRunnerJsonContent>
    </PropertyGroup>

    <!-- coverlet.MTP is CLI-configured; the coverlet.msbuild Coverlet* property family is inert under the MTP flavor. RasmCoverage=true splices the activation tail into the MTP argument stream per test executable. -->
    <PropertyGroup Label="Coverage" Condition="'$(IsTestProject)' == 'true' and '$(RasmCoverage)' == 'true'">
        <RasmCoverageFormat Condition="'$(RasmCoverageFormat)' == ''">cobertura</RasmCoverageFormat>
        <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet --coverlet-output-format $(RasmCoverageFormat) --coverlet-include "[Rasm*]*,[Csp.*]*" --coverlet-exclude "[*Tests]*,[*TestKit]*" --coverlet-file-prefix $(MSBuildProjectName)</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <!-- MPXJ.Net rides ikvm-maven: JARs resolve from Maven Central and IKVM-compile inside the consumer build. The import task hosts a JVM that dies in the Roslyn LSP's shared MSBuild task host and poisons unrelated project loads; design-time builds empty the Maven chains, real builds keep the full pipeline. -->
    <PropertyGroup Label="Maven Design-Time Guard" Condition="'$(DesignTimeBuild)' == 'true'">
        <GetMavenReferenceItemsDependsOn></GetMavenReferenceItemsDependsOn>
        <GetMavenIkvmReferenceItemsDependsOn></GetMavenIkvmReferenceItemsDependsOn>
    </PropertyGroup>

    <!-- Create the SARIF parent before Roslyn writes ErrorLog. -->
    <Target Name="EnsureCspSarifDir" BeforeTargets="CoreCompile" Condition="'$(CspSarifDir)' != ''">
        <MakeDir Directories="$(CspSarifDir)" />
    </Target>

    <!-- A missing or relocated RhinoWIP.app otherwise fails as opaque reference cascades. -->
    <Target Name="VerifyRhinoHostBundle" BeforeTargets="ResolveAssemblyReferences" Condition="'@(_RhinoRequiredHostFile)' != ''">
        <ItemGroup>
            <_MissingRhinoRequiredHostFile Include="@(_RhinoRequiredHostFile)" Condition="!Exists('%(Identity)')" />
        </ItemGroup>
        <Error Condition="'@(_MissingRhinoRequiredHostFile)' != ''"
               Text="RhinoWIP host bundle missing required assemblies under '$(RhinoWipAppPath)': @(_MissingRhinoRequiredHostFile->'%(Filename)%(Extension)', ', ')." />
    </Target>

    <!-- Remove known root Grasshopper2 resource spillover without touching real app/library folders. -->
    <Target Name="ScrubGrasshopperResourceSpillover" AfterTargets="Build" Condition="'$(ScrubGrasshopperResourceSpillover)' != 'false' and '$(HostGrasshopper)' == 'true'">
        <ItemGroup>
            <_GrasshopperSpillover Include="$(MSBuildThisFileDirectory)Grasshopper.*.dll;$(MSBuildThisFileDirectory)Grasshopper.*.pdb;$(MSBuildThisFileDirectory)Grasshopper.*.deps.json;$(MSBuildThisFileDirectory)Grasshopper.*.runtimeconfig.json;$(MSBuildThisFileDirectory)Grasshopper.*.resources" />
        </ItemGroup>
        <Delete Files="@(_GrasshopperSpillover)" Condition="'@(_GrasshopperSpillover)' != ''" />
        <Message Text="check-build: scrubbed @(_GrasshopperSpillover->Count()) Grasshopper2 resource spillover file(s) from repo root." Importance="normal" Condition="'@(_GrasshopperSpillover)' != ''" />
    </Target>

    <!-- RASM0001: declared reference edges obey the role lattice — libs consume libs alone; tools add the tests kit tier (tests/csharp/_*); tests consume everything but apps; an app consumes libs and its own tree. RasmInfra edges are workspace plumbing, not declarations. -->
    <Target Name="RasmReferenceRoleGuard" BeforeTargets="AssignProjectConfiguration" Condition="'@(ProjectReference)' != '' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_RasmRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</_RasmRepoRoot>
            <_RasmOwnRole Condition="$([System.String]::Copy('$(NormalizedProjectDirectory)').StartsWith('$(_RasmRepoRoot)libs/'))">libs</_RasmOwnRole>
            <_RasmOwnRole Condition="'$(_RasmOwnRole)' == '' and $([System.String]::Copy('$(NormalizedProjectDirectory)').StartsWith('$(_RasmRepoRoot)tools/'))">tools</_RasmOwnRole>
            <_RasmOwnRole Condition="'$(_RasmOwnRole)' == '' and $([System.String]::Copy('$(NormalizedProjectDirectory)').StartsWith('$(_RasmRepoRoot)tests/'))">tests</_RasmOwnRole>
            <_RasmOwnRole Condition="'$(_RasmOwnRole)' == '' and $([System.String]::Copy('$(NormalizedProjectDirectory)').StartsWith('$(_RasmRepoRoot)apps/'))">apps</_RasmOwnRole>
            <_RasmOwnAppRoot Condition="'$(_RasmOwnRole)' == 'apps'">$(_RasmRepoRoot)apps/$([System.String]::Copy('$(NormalizedProjectDirectory)').Substring($([MSBuild]::Add($(_RasmRepoRoot.Length), 5))).Split('/')[0])/</_RasmOwnAppRoot>
        </PropertyGroup>
        <ItemGroup>
            <_RasmDeclaredEdge Include="@(ProjectReference->'%(FullPath)')" Condition="'%(ProjectReference.RasmInfra)' != 'true'" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(_RasmOwnRole)' == 'libs' and !$([System.String]::Copy('%(Identity)').StartsWith('$(_RasmRepoRoot)libs/'))" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(_RasmOwnRole)' == 'tools' and !$([System.String]::Copy('%(Identity)').StartsWith('$(_RasmRepoRoot)libs/')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(_RasmRepoRoot)tools/')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(_RasmRepoRoot)tests/csharp/_'))" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(_RasmOwnRole)' == 'tests' and $([System.String]::Copy('%(Identity)').StartsWith('$(_RasmRepoRoot)apps/'))" />
            <_RasmUnlawfulEdge Include="@(_RasmDeclaredEdge)" Condition="'$(_RasmOwnRole)' == 'apps' and !$([System.String]::Copy('%(Identity)').StartsWith('$(_RasmRepoRoot)libs/')) and !$([System.String]::Copy('%(Identity)').StartsWith('$(_RasmOwnAppRoot)'))" />
        </ItemGroup>
        <Error Code="RASM0001" Condition="'@(_RasmUnlawfulEdge)' != ''"
               Text="Role '$(_RasmOwnRole)' project '$(MSBuildProjectName)' declares reference(s) outside its lattice: @(_RasmUnlawfulEdge->'%(Identity)', '; ')." />
    </Target>

    <!-- RASM0002: a project manifest carries identity alone — versions belong to CPM and MinVer, rule severity to .editorconfig, output routing and analysis posture to the root estate. The scan is the project's own XML, so the refusal names the offending element before anything compiles. -->
    <Target Name="RasmProjectShapeGuard" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_RasmShapeBreach>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(MSBuildProjectFullPath))), '&lt;(NoWarn|WarningsNotAsErrors|MSBuildWarningsNotAsErrors|TreatWarningsAsErrors|AnalysisLevel|RunAnalyzers|EnforceCodeStyleInBuild|ArtifactsPath|BaseOutputPath|BaseIntermediateOutputPath|OutputPath|Version|VersionPrefix|VersionSuffix|PackageVersion)[ &gt;/]').Value)</_RasmShapeBreach>
            <_RasmShapeBreach Condition="'$(_RasmShapeBreach)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText($(MSBuildProjectFullPath))), 'PackageReference[^&gt;]*\s(Version|VersionOverride)\s*=').Value)</_RasmShapeBreach>
        </PropertyGroup>
        <Error Code="RASM0002" Condition="'$(_RasmShapeBreach)' != ''"
               Text="Project manifest '$(MSBuildProjectFile)' carries a policy element ('$(_RasmShapeBreach.Trim())…'): versions ride CPM/MinVer, severities ride .editorconfig, output and analysis posture ride the root estate." />
    </Target>

    <Target Name="ValidateCentralTestProjectAdmission" BeforeTargets="PrepareForBuild"
            Condition="$([System.String]::Copy('$(NormalizedProjectDirectory)').StartsWith('$(TestsRoot)')) and '$(IsTestKitProject)' != 'true' and '$(IsScenarioKitProject)' != 'true' and '$(IsBenchmarkProject)' != 'true' and '$(AssayTestShell)' != 'true' and '$(IsTestProject)' == 'false'">
        <Error Text="tests/csharp projects cannot set IsTestProject=false; use IsTestKitProject, IsScenarioKitProject, IsBenchmarkProject, AssayHostBound, or AssayTestShell for routing." />
    </Target>

    <Target Name="GenerateXunitRunnerJson" BeforeTargets="AssignTargetPaths" Condition="'$(IsTestProject)' == 'true'">
        <PropertyGroup>
            <_XunitRunnerJsonPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'xunit.runner.json'))</_XunitRunnerJsonPath>
        </PropertyGroup>
        <WriteLinesToFile File="$(_XunitRunnerJsonPath)" Lines="$(_XunitRunnerJsonContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <None Include="$(_XunitRunnerJsonPath)" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
            <FileWrites Include="$(_XunitRunnerJsonPath)" />
        </ItemGroup>
    </Target>

    <!-- MTP resolves results against the launcher cwd, so this pin seats them module-adjacent for every entry point (an explicit results-directory argument still outranks it); the pin spells the bootstrap folder verbatim — a differing dir makes MTP relocate the open diagnostic log and dispose its writer mid-hold — and the link lands before AssignTargetPaths so MTP's testconfig ownership scan spares it. -->
    <Target Name="GenerateTestConfigJson" BeforeTargets="AssignTargetPaths" Condition="'$(IsTestProject)' == 'true'">
        <PropertyGroup>
            <_TestConfigJsonPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'testconfig.json'))</_TestConfigJsonPath>
            <_TestConfigResultDirectory>$([System.String]::Copy($([MSBuild]::NormalizePath('$(TargetDir)', 'TestResults'))).Replace('\', '/'))</_TestConfigResultDirectory>
            <_TestConfigJsonContent>{"platformOptions":{"resultDirectory":"$(_TestConfigResultDirectory)"}}</_TestConfigJsonContent>
        </PropertyGroup>
        <WriteLinesToFile File="$(_TestConfigJsonPath)" Lines="$(_TestConfigJsonContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <None Include="$(_TestConfigJsonPath)" Link="$(AssemblyName).testconfig.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
            <FileWrites Include="$(_TestConfigJsonPath)" />
        </ItemGroup>
    </Target>

    <Target Name="EmitBridgeClosure" AfterTargets="Build" Condition="'$(HasBridgeScenarios)' == 'true' and '$(TargetFileName)' != ''">
        <GetAssemblyIdentity AssemblyFiles="$(RhinoCommonReferencePath)" Condition="Exists('$(RhinoCommonReferencePath)')">
            <Output TaskParameter="Assemblies" ItemName="_BridgeRhinoIdentity" />
        </GetAssemblyIdentity>
        <GetAssemblyIdentity AssemblyFiles="$(Grasshopper2ReferencePath)" Condition="Exists('$(Grasshopper2ReferencePath)') and @(Reference->AnyHaveMetadataValue('Identity', 'Grasshopper2'))">
            <Output TaskParameter="Assemblies" ItemName="_BridgeGh2Identity" />
        </GetAssemblyIdentity>
        <ItemGroup>
            <_BridgeClosureDependency Include="@(ReferenceCopyLocalPaths->WithMetadataValue('DestinationSubDirectory','')->WithMetadataValue('Extension','.dll'))" />
            <_BridgeClosureHostDependency Include="@(_BridgeClosureDependency)" Condition="$([System.String]::Copy('$(RhinoHostAssemblyNameSet)').Contains('|%(_BridgeClosureDependency.Filename)|'))" />
            <_BridgeClosureAssembly Include="$(TargetFileName)" />
            <_BridgeClosureAssembly Include="@(_BridgeClosureDependency->'%(Filename)%(Extension)')" Exclude="@(_BridgeClosureHostDependency->'%(Filename)%(Extension)')" />
            <_BridgeHostPlugin Include="8307876d-a461-4daa-bb77-eb3715925513" Condition="'@(_BridgeGh2Identity)' != ''" />
            <_BridgeClosureAssemblyDistinct Include="@(_BridgeClosureAssembly->Distinct())" />
        </ItemGroup>
        <PropertyGroup>
            <_BridgeClosurePath>$([MSBuild]::NormalizePath('$(TargetDir)', 'bridge-closure.json'))</_BridgeClosurePath>
            <_BridgeRuntimeVersion>$([System.String]::Copy('$(TargetFrameworkVersion)').TrimStart('v'))</_BridgeRuntimeVersion>
            <_BridgeBuiltAgainst>{"bundleVersion":"@(_BridgeRhinoIdentity->'%(Version)')","rhinoCommonVersion":"@(_BridgeRhinoIdentity->'%(Version)')","grasshopper2Version":"@(_BridgeGh2Identity->'%(Version)')","runtimeVersion":"$(_BridgeRuntimeVersion)"}</_BridgeBuiltAgainst>
            <_BridgeClosureAssembliesJson>@(_BridgeClosureAssemblyDistinct->'&quot;%(Identity)&quot;', ',')</_BridgeClosureAssembliesJson>
            <_BridgeHostPluginsJson>@(_BridgeHostPlugin->'&quot;%(Identity)&quot;', ',')</_BridgeHostPluginsJson>
            <_BridgeClosureJson>{"assemblies":[$(_BridgeClosureAssembliesJson)],"hostPlugins":[$(_BridgeHostPluginsJson)],"builtAgainst":$(_BridgeBuiltAgainst)}</_BridgeClosureJson>
        </PropertyGroup>
        <WriteLinesToFile File="$(_BridgeClosurePath)" Lines="$(_BridgeClosureJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <FileWrites Include="$(_BridgeClosurePath)" />
        </ItemGroup>
    </Target>
</Project>
