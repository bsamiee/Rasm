{
    "mcpServers": {
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GH_PROJECTS_TOKEN}",
                "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions,git,dependabot,code_security,projects,labels,users,github_support_docs_search",
                "X-MCP-Features": "file_blame,issue_dependencies,csv_output,mcp_apps_disable_form_deferral,duplicate_detection"
            },
            "default_tools_approval_mode": "approve",
            "bearer_token_env_var": "GH_PROJECTS_TOKEN",
            "http_headers": {
                "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions,git,dependabot,code_security,projects,labels,users,github_support_docs_search",
                "X-MCP-Features": "file_blame,issue_dependencies,csv_output,mcp_apps_disable_form_deferral,duplicate_detection"
            }
        },
        "claudeCodeDocs": {
            "type": "http",
            "url": "https://code.claude.com/docs/mcp",
            "default_tools_approval_mode": "approve"
        },
        "openaiDeveloperDocs": {
            "type": "http",
            "url": "https://developers.openai.com/mcp",
            "default_tools_approval_mode": "approve"
        },
        "googleDeveloperDocs": {
            "type": "http",
            "url": "https://developerknowledge.googleapis.com/mcp",
            "headers": {
                "X-Goog-Api-Key": "${GOOGLE_DEVELOPER_KNOWLEDGE_API_KEY}"
            },
            "default_tools_approval_mode": "approve",
            "env_http_headers": {
                "X-Goog-Api-Key": "GOOGLE_DEVELOPER_KNOWLEDGE_API_KEY"
            }
        }
    }
}
