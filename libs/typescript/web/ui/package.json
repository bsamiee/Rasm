{
    "name": "@rasm/ui",
    "version": "0.0.0",
    "private": true,
    "description": "Accessible interface controls for web apps",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/ui"
    },
    "license": "MIT",
    "sideEffects": false,
