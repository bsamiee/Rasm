        for (var i = 0; i < props.length; i++) {
            var name = props[i].name;
            if (name === "__proto__" || name === "parent" || name === "typename") { continue; }
            var held;
            try { held = value[name]; } catch (error) { continue; }
            if (!collected(held)) { row[name] = codec.kept(held, below); }
        }
        return row;
    }
    function hosted(value, path) {
