{
    "name": "@rasm/nx-docker",
    "version": "0.1.0",
    "description": "Nx plugin inferring Compose projects, their checks, image builds, and service starts from docker compose's own output; the image build and start of a service join the project of the folder holding its Dockerfile, which a manifest of another plugin names",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/docker"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#package": "./package.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./package.json": "./package.json",
        "./ready-check": "./ready-check.ts"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#package": "./package.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./package.json": "./package.json",
            "./ready-check": "./dist/ready-check.js"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": "^24.14.0 || >=25.4.0"
    }
}
