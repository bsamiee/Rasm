        if (parts[1] === "Document") { return realApp.documents.getByName(parts[2]); }
        var at = parts[2].lastIndexOf("/");
        if (at >= 0) {
            var head = parts[2].slice(0, at);
            var from = head.lastIndexOf("/");
            return located(head.slice(0, from))[head.slice(from + 1)].getByName(decodeURIComponent(parts[2].slice(at + 1)));
        }
