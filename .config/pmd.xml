<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="rasm" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Java rules for Ghidra scripts</description>

    <!-- [RULES] ───────────────────────────────────────────────────────────────────── -->

    <!-- [BEST_PRACTICES] -->

    <rule ref="category/java/bestpractices.xml">
        <exclude name="UnusedFormalParameter" />
    </rule>
    <rule ref="category/java/bestpractices.xml/UnusedFormalParameter">
        <properties>
            <property name="checkAll" value="true" />
        </properties>
    </rule>

    <!-- [CODE_STYLE] -->

    <rule ref="category/java/codestyle.xml">
        <exclude name="AtLeastOneConstructor" /> <!-- Ghidra can instantiate scripts with Java's default constructor -->
        <exclude name="CommentDefaultAccessModifier" /> <!-- CLAUDE.md excludes comments marking package access -->
        <!-- Java recognizes effectively final locals and parameters without `final` -->
        <exclude name="LocalVariableCouldBeFinal" />
        <exclude name="LocalVariableDeclarationShouldBeAtStartOfBlock" /> <!-- Declare locals at first use in dependency order -->
        <exclude name="MethodArgumentCouldBeFinal" />
        <exclude name="NoPackage" /> <!-- Ghidra loads default-package scripts from script directories -->
        <exclude name="OnlyOneReturn" /> <!-- Return from each `switch` arm or guard clause -->
        <!-- `writing:prose` names classes, methods, and variables for their subjects (`Row`, `Role`) -->
        <exclude name="ShortClassName" />
        <exclude name="ShortMethodName" />
        <exclude name="ShortVariable" />
    </rule>

    <!-- [DESIGN] -->

    <rule ref="category/java/design.xml">
        <!-- CLAUDE.md keeps related logic together when type, import, or method counts encourage single-caller helper extraction -->
        <exclude name="CouplingBetweenObjects" />
        <exclude name="ExcessiveImports" />
        <exclude name="LawOfDemeter" /> <!-- Ghidra exposes program state through accessor chains -->
        <exclude name="LoosePackageCoupling" /> <!-- PMD reports a configuration error when the package list is empty -->
        <exclude name="SignatureDeclareThrowsException" /> <!-- `GhidraScript.run` declares `throws Exception` -->
        <exclude name="TooManyMethods" />
    </rule>

    <!-- [ERROR_PRONE] -->

    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidAccessibilityAlteration" />
        <exclude name="AvoidCatchingGenericException" />
        <exclude name="CloseResource" />
        <exclude name="EmptyCatchBlock" />
        <exclude name="NonSerializableClass" />
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidAccessibilityAlteration">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::MethodDeclaration[@Name = 'run'][ancestor::ClassDeclaration[@SimpleName = 'Headers']]" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidCatchingGenericException">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::TryStatement[1]/Block//MethodCall[pmd-java:matchesSig('ghidra.app.script.GhidraScript#runScript(java.lang.String,java.lang.String[],ghidra.app.script.GhidraState)')]" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/CloseResource">
        <properties>
            <!-- Accepted channels outlive the accepting method in the connection set and close in callbacks -->
            <property name="violationSuppressXPath" value="./ancestor-or-self::LocalVariableDeclaration[VariableDeclarator/MethodCall[pmd-java:matchesSig('java.nio.channels.ServerSocketChannel#accept()')]]" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowExceptionNameRegex" value="^$" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/NonSerializableClass">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::*[pmd-java:nodeIs('TypeDeclaration')][1][self::EnumDeclaration]" />
        </properties>
    </rule>
    <rule name="EmptyStringForAbsence" language="java" message="Empty string fallback hides absence, handle absence explicitly" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Keep absence in an `Optional` or empty collection. Select complete text for each case with `map` and `orElse`</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//MethodCall[
    pmd-java:matchesSig('java.util.Optional#orElse(_)')
    or pmd-java:matchesSig('java.util.Objects#requireNonNullElse(_,_)')
    or pmd-java:matchesSig('java.util.Objects#toString(_,_)')
][ArgumentList/*[last()][self::StringLiteral][@Empty = true()]]
]]>
                </value>
            </property>
        </properties>
    </rule>
    <rule name="UncheckedOptionalAccess" language="java" message="Direct Optional.get() call, choose an operation that handles absence" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Use `map`, `ifPresent`, `orElseGet`, or `orElseThrow` to handle both cases of an `Optional`</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//MethodCall[pmd-java:matchesSig('java.util.Optional#get()')]
]]>
                </value>
            </property>
        </properties>
    </rule>
    <rule name="UncheckedDecompilerOpen" language="java" message="Unchecked decompiler open, check DecompInterface.openProgram()" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>`DecompilerCallback` ignores the `openProgram` result. Check it in the configurer and throw with `getLastMessage` on failure</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//ExpressionStatement/MethodCall[pmd-java:matchesSig('ghidra.app.decompiler.DecompInterface#openProgram(_)')]
| //ConstructorCall[pmd-java:typeIs('ghidra.app.decompiler.parallel.DecompilerCallback')][not(ArgumentList//MethodCall[pmd-java:matchesSig('ghidra.app.decompiler.DecompInterface#openProgram(_)')])]
]]>
                </value>
            </property>
        </properties>
    </rule>

    <!-- [MULTITHREADING] -->

    <rule ref="category/java/multithreading.xml">
        <exclude name="DoNotUseThreads" /> <!-- PMD targets J2EE containers. Ghidra runs scripts in its JVM -->
    </rule>

    <!-- [PERFORMANCE] -->

    <rule ref="category/java/performance.xml" />
    <rule name="RecompiledConstantRegex" language="java" message="Constant regular expression recompiles on each evaluation, reuse a static final Pattern" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Use a `static final Pattern` for repeated matching and replacement</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//MethodCall[
    (@MethodName = ('compile', 'matches') and pmd-java:matchesSig('java.util.regex.Pattern#_(_*)'))
    or (@MethodName = ('matches', 'replaceAll', 'replaceFirst')
        and pmd-java:matchesSig('java.lang.String#_(_*)'))
][
    ArgumentList/*[1][@CompileTimeConstant = true()]
][
    not(@MethodName = 'compile') or not(ArgumentList/*[2][@CompileTimeConstant = false()])
][
    ancestor::*[
        pmd-java:nodeIs('ExecutableDeclaration') or self::CompactConstructorDeclaration
        or self::LambdaExpression or self::Initializer or self::FieldDeclaration or self::EnumConstant
    ][1][not(self::Initializer[@Static = true()] or self::FieldDeclaration[@Static = true()] or self::EnumConstant)]
]
]]>
                </value>
            </property>
        </properties>
    </rule>

    <!-- [SECURITY] -->

    <rule ref="category/java/security.xml" />
</ruleset>
