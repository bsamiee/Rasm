{
    "name": "@rasm/atelier-protocol",
    "version": "0.1.0",
    "private": true,
    "description": "Atelier's cross-app request contract and host session tag, the link identity its plugins dial with, the CEP panel serving that link, and the ExtendScript dispatch of its requests",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/apps/creative-cloud/multi-app/atelier/protocol"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "./panel.ts"
    ],
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./extendscript": "./extendscript.ts",
        "./panel": "./panel.ts",
        "./peer": "./peer.ts"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./extendscript": "./dist/extendscript.js",
            "./panel": "./dist/panel.js",
            "./peer": "./dist/peer.js"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/applications": "workspace:*",
        "@rasm/cep": "workspace:*",
        "@rasm/extendscript": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/rpc": "workspace:*",
        "@rasm/search": "workspace:*",
        "effect": "catalog:"
    }
}
