<Project>
    <PropertyGroup Label="Artifacts Output">
        <ArtifactsPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '.artifacts', 'dotnet'))</ArtifactsPath>
        <ArtifactsPath Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != '$(NETCoreSdkPortableRuntimeIdentifier)'">$(ArtifactsPath)/$(RuntimeIdentifier)</ArtifactsPath>
    </PropertyGroup>

    <PropertyGroup Label="Package Metadata">
        <Authors>Bardia Samiee</Authors>
        <PackageProjectUrl>https://github.com/bsamiee/Rasm</PackageProjectUrl>
    </PropertyGroup>

    <PropertyGroup Label="Project Classification">
        <_RepoRelativeDir>/$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').ToLowerInvariant())/</_RepoRelativeDir>
        <ProjectRole Condition="$(_RepoRelativeDir.StartsWith('/libs/'))">library</ProjectRole>
        <ProjectRole Condition="$(_RepoRelativeDir.StartsWith('/tools/roslyn/'))">analyzers</ProjectRole>
        <RhinoHost Condition="$(_RepoRelativeDir.Contains('/rhino/'))">true</RhinoHost>
        <RoslynHost Condition="$(_RepoRelativeDir.Contains('/tools/roslyn/'))">true</RoslynHost>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Plug-In Library Copies" Condition="'$(RhinoPlugIn)' != ''">
        <AssemblyName>$(RhinoPlugIn).$(MSBuildProjectName)</AssemblyName>
        <RunAnalyzers>false</RunAnalyzers>
    </PropertyGroup>

    <PropertyGroup Label="Build Defaults">
        <RepoTargetFramework>net10.0</RepoTargetFramework>
        <TargetFramework>$(RepoTargetFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild Condition="'$(DesignTimeBuild)' != 'true'">true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <NuGetAudit>false</NuGetAudit>
        <SuppressImplicitGitSourceLink>true</SuppressImplicitGitSourceLink>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <TargetFramework Condition="$([MSBuild]::ValueOrDefault('$(RuntimeIdentifier)', '$(NETCoreSdkPortableRuntimeIdentifier)').StartsWith('win'))">$(RepoTargetFramework)-windows</TargetFramework>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RhinoEnableWindowsFormsTargeting>false</RhinoEnableWindowsFormsTargeting>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <PublishReferencesSymbols>false</PublishReferencesSymbols>
    </PropertyGroup>

    <PropertyGroup Label="Roslyn Components" Condition="'$(ProjectRole)' == 'analyzers'">
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    </PropertyGroup>

    <ItemDefinitionGroup Label="Roslyn Components" Condition="'$(ProjectRole)' == 'analyzers'">
        <PackageReference ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemDefinitionGroup>

    <PropertyGroup Label="Continuous Integration" Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Label="Analyzer Configuration">
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).config/analyzers.globalconfig" />
    </ItemGroup>

    <ItemGroup Label="Workspace Packages" Condition="'$(ProjectRole)' != 'analyzers'">
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
    </ItemGroup>
</Project>
