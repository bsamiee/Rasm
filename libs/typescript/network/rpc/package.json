{
    "name": "@rasm/rpc",
    "version": "0.1.0",
    "private": true,
    "description": "Effect RPC transports over a child process's standard streams and over redialing WebSocket links between peers and a server",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/network/rpc"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./transport.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/transport.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/search": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
