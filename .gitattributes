# Normalize all text to LF; binaries auto-detect as untouched; Verify snapshots require exact LF bytes
* text=auto eol=lf

# Git LFS — hand-authored binary design assets commit as pointers

# Rhino Files
*.3dm filter=lfs diff=lfs merge=lfs -text
*.3dmbak filter=lfs diff=lfs merge=lfs -text

# Grasshopper Files
*.gh filter=lfs diff=lfs merge=lfs -text
*.ghx filter=lfs diff=lfs merge=lfs -text
*.ghdata filter=lfs diff=lfs merge=lfs -text

