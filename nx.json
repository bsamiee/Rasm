{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "cacheDirectory": ".cache/nx/cache",
    "neverConnectToCloud": true,
    "useDaemonProcess": false,
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": ["default", "!{projectRoot}/**/*.{spec,test,bench}.{ts,tsx,mts,cts}"],
        "sharedGlobals": ["{workspaceRoot}/nx.json", "{workspaceRoot}/mise.toml", "{workspaceRoot}/tools/nx/*.ts"],
        "dotnet": [
            "{workspaceRoot}/global.json",
            "{workspaceRoot}/NuGet.config",
            "{workspaceRoot}/Directory.{Build.props,Build.targets,Packages.props}",
            "{workspaceRoot}/.editorconfig",
            { "runtime": "dotnet --version" }
        ],
        "python": ["{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock", { "runtime": "uv --version" }],
        "xcode": [{ "runtime": "xcodebuild -version" }],
        "typescript": [
            "{workspaceRoot}/biome.json",
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/pnpm-workspace.yaml",
            "{workspaceRoot}/pnpm-lock.yaml",
            "{workspaceRoot}/vitest.config.ts",
            { "runtime": "node --version" }
        ]
    },
    "targetDefaults": {
        "build": [
            { "cache": true },
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "dependsOn": ["^build", { "projects": ["rasm"], "target": "restore" }],
                "inputs": ["...", "dotnet"]
            },
            {
                "filter": { "projects": ["tag:language:swift"] },
                "command": "xcodebuild -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -destination 'platform=macOS,arch=arm64' -derivedDataPath .cache/xcode/{projectRoot} -disableAutomaticPackageResolution build",
                "inputs": ["default", "xcode"],
                "outputs": ["{workspaceRoot}/.cache/xcode/{projectRoot}/Build/Products/Debug"]
            },
            { "filter": { "projects": ["tag:language:typescript"] }, "inputs": ["production", "^production", "typescript"] },
            {
                "filter": { "projects": ["tag:host:uxp"] },
                "command": "vite build",
                "options": { "cwd": "{projectRoot}" },
                "inputs": ["...", { "externalDependencies": ["vite", "vite-uxp-plugin"] }],
                "outputs": ["{workspaceRoot}/.artifacts/{projectRoot}"]
            },
            {
                "filter": { "projects": ["tag:host:extendscript"] },
                "command": "swc {projectRoot} -d .artifacts --out-file-extension jsx --ignore '**/node_modules/**,**/illustrator.ts'",
                "inputs": ["...", { "externalDependencies": ["@swc/core", "@swc/cli"] }],
                "outputs": ["{workspaceRoot}/.artifacts/{projectRoot}"]
            }
        ],
        "generate": [
            { "cache": true, "inputs": ["typescript"] },
            {
                "filter": { "projects": ["tag:host:indesign"] },
                "inputs": [
                    "...",
                    "{projectRoot}/automation.ts",
                    "^production",
                    { "runtime": "/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \"$(mdfind \"kMDItemCFBundleIdentifier == 'com.adobe.InDesign'\")/Contents/Info.plist\"" },
                    { "runtime": "sw_vers -productVersion" },
                    { "externalDependencies": ["@adobe-uxp-types/uxp"] }
                ],
                "outputs": ["{workspaceRoot}/apps/creative-cloud/server/indesign/indesign.ts", "{projectRoot}/uxp.ts", "{projectRoot}/enumerations.ts"]
            },
            {
                "filter": { "projects": ["tag:host:photoshop"] },
                "inputs": ["...", "{projectRoot}/automation.ts", "^production", { "externalDependencies": ["@adobe-uxp-types/uxp", "@adobe-uxp-types/photoshop"] }],
                "outputs": ["{projectRoot}/uxp.ts", "{projectRoot}/photoshop.ts"]
            },
            {
                "filter": { "projects": ["@rasm/creative-cloud-server"] },
                "dependsOn": [{ "projects": ["tag:host:extendscript"], "target": "build" }],
                "inputs": [
                    "...",
                    "production",
                    { "dependentTasksOutputFiles": "**/*.jsx" },
                    { "runtime": "/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \"$(mdfind \"kMDItemCFBundleIdentifier == 'com.adobe.illustratorBeta'\")/Contents/Info.plist\"" },
                    { "externalDependencies": ["types-for-adobe"] }
                ],
                "outputs": ["{workspaceRoot}/apps/creative-cloud/illustrator-scripts/illustrator.ts", "{projectRoot}/illustrator/dictionary.ts"]
            }
        ],
        "reconcile": [{ "filter": { "projects": ["tag:host:indesign"] }, "dependsOn": ["generate"], "parallelism": false }],
        "deploy": [{ "filter": { "projects": ["tag:language:typescript"] }, "dependsOn": ["build"], "parallelism": false }],
        "install": [
            {
                "filter": { "projects": ["tag:language:swift"] },
                "command": "xcodebuild -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -configuration Release -destination 'platform=macOS,arch=arm64' -derivedDataPath .cache/xcode/{projectRoot} -disableAutomaticPackageResolution install DSTROOT=/Applications INSTALL_PATH=/",
                "parallelism": false
            }
        ],
        "lint": [
            {
                "filter": { "projects": ["tag:language:swift"] },
                "command": "xcrun swift-format lint --strict --recursive {projectRoot}",
                "cache": true,
                "inputs": ["default", "xcode", "{workspaceRoot}/.swift-format"]
            }
        ],
        "format": [{ "filter": { "projects": ["tag:language:swift"] }, "command": "xcrun swift-format format --in-place --recursive {projectRoot}" }],
        "typecheck": [
            { "filter": { "projects": ["tag:language:dotnet"] }, "executor": "nx:noop", "dependsOn": ["build"] },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "python"],
                "options": { "commands": ["ty check {projectRoot}", "mypy {projectRoot}"], "parallel": false }
            },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": ["^typecheck"],
                "inputs": ["default", { "dependentTasksOutputFiles": "**/*.d.ts", "transitive": true }, "typescript", { "externalDependencies": ["typescript"] }],
                "options": { "command": "tsc --build --pretty false", "cwd": "{projectRoot}" },
                "outputs": ["{workspaceRoot}/.cache/typescript/out/{projectRoot}"]
            },
            { "filter": { "projects": ["tag:host:indesign", "tag:host:photoshop"] }, "dependsOn": ["...", "generate"], "inputs": ["...", { "dependentTasksOutputFiles": "**/*.ts" }] },
            {
                "filter": { "projects": ["tag:host:extendscript"] },
                "dependsOn": ["...", { "projects": ["@rasm/creative-cloud-server"], "target": "generate" }],
                "inputs": ["...", { "dependentTasksOutputFiles": "**/*.ts" }]
            },
            {
                "filter": { "projects": ["@rasm/creative-cloud-server"] },
                "dependsOn": ["...", "generate", { "projects": ["tag:host:indesign"], "target": "generate" }],
                "inputs": ["...", { "dependentTasksOutputFiles": "**/*.ts" }]
            }
        ],
        "test": [
            { "cache": true },
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "inputs": ["...", "dotnet"],
                "outputs": ["{workspaceRoot}/.artifacts/dotnet/coverage/{projectName}"]
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "inputs": ["default", "python"],
                "outputs": ["{workspaceRoot}/.artifacts/python/coverage/data/.coverage.{projectName}"],
                "options": {
                    "command": "pytest {projectRoot} --cov",
                    "env": { "COVERAGE_FILE": ".artifacts/python/coverage/data/.coverage.{projectName}" }
                }
            },
            {
                "filter": { "projects": ["tag:language:typescript"], "plugin": "@nx/vitest" },
                "inputs": ["...", "typescript", "{workspaceRoot}/tests/typescript/support/setup.ts"],
                "outputs": ["{workspaceRoot}/.artifacts/typescript/test-results/{projectName}", "{workspaceRoot}/.artifacts/typescript/coverage/{projectName}"]
            }
        ],
        "check": [
            { "filter": { "projects": ["tag:language:*"] }, "executor": "nx:noop", "dependsOn": ["typecheck", "test"] },
            {
                "filter": { "projects": ["tag:language:swift"] },
                "dependsOn": [{ "target": "build", "params": "forward" }, "lint"]
            }
        ]
    },
    "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false } },
    "plugins": [
        { "plugin": "@nx/vitest", "exclude": ["vitest.config.ts"], "options": { "testMode": "run" } },
        {
            "plugin": "@nx/dotnet",
            "exclude": ["eng/**"],
            "options": { "clean": false, "pack": false, "publish": false, "restore": false }
        },
        { "plugin": "./tools/nx/workspace.ts" }
    ]
}
