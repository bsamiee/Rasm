        for (var i = 0; i < props.length; i++) {
            if (!classed(props[i])) { continue; }
            try {
                var held = parent[props[i].name];
                if (collected(held) && held.getByName(value.name).typename === kind) { homes[above + ">" + kind] = props[i].name; return props[i].name; }
            } catch (error) {}
        }
        return null;
    }
    function specifier(value) {
