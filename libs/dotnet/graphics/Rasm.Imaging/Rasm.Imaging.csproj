<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0-beta.0</Version>
        <Description>Color-managed image processing in scene-linear light</Description>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.HighPerformance" />
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Json" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="System.Numerics.Tensors" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="SuperLinq" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Imaging">
        <PackageReference Include="BitMiracle.LibTiff.NET" />
        <PackageReference Include="Emgu.CV" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="TinyEXR.NET" />
    </ItemGroup>

    <ItemGroup Label="Tables">
        <FetchedResource Include="https://raw.githubusercontent.com/Calinou/free-blue-noise-textures/a64e300dcd96b5f8c42494c5e452c1eb409b0efb/256_256/HDR_RGBA_4.png" Sha256="bf9a2b89b097f441f2aba243a6a99be203109b31cb9ac8644e13bef9b61556d7" />
    </ItemGroup>
</Project>
