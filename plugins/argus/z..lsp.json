{
    "typescript": {
        "command": "mise",
        "args": [ "exec", "--", "effect-tsgo", "tsc", "--lsp", "--stdio" ],
        "extensionToLanguage": { ".ts": "typescript", ".tsx": "typescriptreact", ".js": "javascript" },
        "diagnostics": false,
        "settings": { "js/ts": { "tsserver": { "automaticTypeAcquisition": { "enabled": false } } } }
    },
    "python": {
        "command": "mise",
        "args": [ "exec", "--", "ty", "server" ],
        "extensionToLanguage": { ".py": "python", ".pyi": "python" },
        "diagnostics": false
    },
    "rust": {
        "command": "mise",
        "args": [ "exec", "--", "rust-analyzer" ],
        "extensionToLanguage": { ".rs": "rust" },
        "diagnostics": false,
        "initializationOptions": {
            "cargo": { "extraEnv": { "CARGO_BUILD_TARGET_DIR": "${CLAUDE_PROJECT_DIR}/.artifacts/rust/rust-analyzer", "CARGO_BUILD_BUILD_DIR": "{cargo-cache-home}/build/{workspace-path-hash}/rust-analyzer" } },
            "cachePriming": { "enable": false },
            "checkOnSave": false,
            "rustc": { "source": "discover" }
        }
    },
    "swift": {
        "command": "sourcekit-lsp",
        "extensionToLanguage": { ".swift": "swift" },
        "diagnostics": false,
        "initializationOptions": { "backgroundIndexing": false, "swiftPM": { "scratchPath": "${SWIFTPM_BUILD_DIR}", "forceResolvedVersions": true, "buildSystem": "swiftbuild" } }
    },
    "java": {
        "command": "mise",
        "args": [ "exec", "--", "jdtls", "-data", "${CLAUDE_PROJECT_DIR}/.cache/jdtls/workspace", "--jvm-arg=-Dosgi.configuration.area=${CLAUDE_PROJECT_DIR}/.cache/jdtls/configuration", "--jvm-arg=-Djava.import.generatesMetadataFilesAtProjectRoot=false" ],
        "extensionToLanguage": { ".java": "java" },
        "diagnostics": false,
        "workspaceFolder": ".claude/skills/use-ghidra/scripts",
        "startupTimeout": 120000,
        "initializationOptions": {
            "extendedClientCapabilities": { "classFileContentsSupport": true },
            "settings": {
                "java": {
                    "autobuild": { "enabled": false },
                    "configuration": { "runtimes": [ { "name": "JavaSE-27", "path": "${JAVA_HOME}", "default": true } ] },
                    "project": { "sourcePaths": [ "." ], "referencedLibraries": [ "${GHIDRA_INSTALL_DIR}/Ghidra/**/lib/*.jar" ] }
                }
            }
        }
    },
    "yaml": {
        "command": "yaml-language-server",
        "args": [ "--stdio" ],
        "extensionToLanguage": { ".yaml": "yaml", ".yml": "yaml" },
        "diagnostics": false,
        "settings": {
            "yaml": { "schemas": { "https://www.schemastore.org/github-action.json": ".github/actions/*/action.{yml,yaml}" } }
        }
    },
    "toml": {
        "command": "mise",
        "args": [ "exec", "--", "tombi", "lsp" ],
        "extensionToLanguage": { ".toml": "toml" },
        "diagnostics": false
    },
    "bash": {
        "command": "bash-language-server",
        "args": [ "start" ],
        "extensionToLanguage": { ".sh": "shellscript", ".bash": "shellscript" },
        "diagnostics": false,
        "env": { "BACKGROUND_ANALYSIS_MAX_FILES": "0" }
    }
}
