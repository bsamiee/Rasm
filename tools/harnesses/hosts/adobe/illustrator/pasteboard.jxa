ObjC.import('AppKit');

function run([mode, file]) {
    const board = $.NSPasteboard.generalPasteboard;
    if (mode === 'save') {
        const items = (ObjC.unwrap(board.pasteboardItems) ?? []).map((item) => ObjC.deepUnwrap(item.types).map((type) => [type, ObjC.unwrap(item.dataForType(type).base64EncodedStringWithOptions(0))]));
        $(JSON.stringify(items)).writeToFileAtomicallyEncodingError(file, true, $.NSUTF8StringEncoding, null);
        return String(items.length);
    }
    const items = JSON.parse(ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(file, $.NSUTF8StringEncoding, null))).map((pairs) => {
        const item = $.NSPasteboardItem.alloc.init;
        pairs.forEach(([type, data]) => item.setDataForType($.NSData.alloc.initWithBase64EncodedStringOptions(data, 0), type));
        return item;
    });
    board.clearContents;
    return String(board.writeObjects($(items)));
}
