{
    "name": "@rasm/nx-pnpm",
    "version": "0.0.0",
    "description": "Nx plugin inferring pnpm catalog upgrades and store pruning from each pnpm-workspace.yaml",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/pnpm"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json" ],
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@nx/js": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugins/project-graph.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        }
    },
    "executors": "./executors.json"
}
