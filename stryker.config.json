{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "testRunner": "vitest",
    "plugins": ["@stryker-mutator/vitest-runner"],
    "vitest": {
        "related": false
    },
    "mutate": ["libs/typescript/**/*.{ts,tsx}", "!**/gen/**", "!**/dist/**", "!**/*.{test,spec}.{ts,tsx}", "!**/*.config.{ts,tsx}", "!**/*.d.ts"],
    "ignoreStatic": true,
    "ignorePatterns": ["/.artifacts", "/.cache", "/.venv", "/tsconfig.json"],
    "tempDirName": ".cache/stryker/tmp",
    "cleanTempDir": "always",
    "incremental": true,
    "incrementalFile": ".cache/stryker/incremental.json",
    "reporters": ["html", "json", "progress"],
    "htmlReporter": {
        "fileName": ".artifacts/typescript/stryker/mutation-report.html"
    },
    "jsonReporter": {
        "fileName": ".artifacts/typescript/stryker/mutation-report.json"
    }
}
