{
    "name": "@rasm/object-model",
    "version": "0.1.0",
    "description": "Object model scriptable Adobe hosts share: object specifiers, class pages from vendor declarations, and a script parser and value encoder for ExtendScript and UXP",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/object-model"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./model": "./model.ts",
        "./rpcs": "./rpcs.ts",
        "./host": "./host.ts",
        "./node": "./node.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./model": "./dist/model.js",
            "./rpcs": "./dist/rpcs.js",
            "./host": "./dist/host.js",
            "./node": "./dist/node.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/search": "workspace:*",
        "@typescript/native": "catalog:",
        "fast-xml-parser": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
