{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": 2,
    "type": "object",
    "properties": {
        "commands": {
            "type": "array",
            "minItems": 1,
            "description": "dotnet format subcommands and their switches, run in order, which the plugin infers",
            "items": [
                {
                    "type": "array",
                    "minItems": 1,
                    "items": [
                        {
                            "type": "string"
                        }
                    ],
                    "additionalItems": {
                        "type": "string"
                    }
                }
            ],
            "additionalItems": {
                "type": "array",
                "minItems": 1,
                "items": [
                    {
                        "type": "string"
                    }
                ],
                "additionalItems": {
                    "type": "string"
                }
            }
        },
        "project": {
            "type": "string",
            "description": "Project file the commands run on"
        },
        "args": {
            "type": "array",
            "description": "Arguments appended to every command",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [ "commands", "project" ],
    "additionalProperties": true,
    "title": "Format",
    "description": "Runs dotnet format commands in order on one project, or once each over a solution of every batched project"
}
