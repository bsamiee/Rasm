dotnet_diagnostic.RCS1217.severity = none
dotnet_diagnostic.RCS1238.severity = none
dotnet_diagnostic.RCS1241.severity = none
roslynator_array_creation_type_style = implicit_when_type_is_obvious
roslynator_empty_string_style = literal
roslynator_enum_flag_value_style = shift_operator
roslynator_infinite_loop_style = while
roslynator_doc_comment_summary_style = single_line
roslynator_object_creation_parentheses_style = omit

# --- [IDE_QUALITY_RULES] ----------------------------------------------------------------
dotnet_diagnostic.IDE0001.severity = error
dotnet_diagnostic.IDE0002.severity = error
