<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Dependency-zero Rhino plugin with one reflective activation hop into the shell ALC.</Description>
        <AssemblyName>rasm-bridge</AssemblyName>
        <RootNamespace>Rasm.Bridge.Stub</RootNamespace>
        <TargetExt>.rhp</TargetExt>
        <RasmPlugin>rhino</RasmPlugin>
        <RhinoPluginGuid>23898819-e84f-4fd3-bb2c-85b208718cba</RhinoPluginGuid>
        <YakPackageSlug>rasm-bridge</YakPackageSlug>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup Label="Yak Payload">
        <ProjectReference Include="../Shell/Shell.csproj" ReferenceOutputAssembly="false" RasmInfra="true" />
        <YakPayloadProject Include="../Shell/Shell.csproj" />
    </ItemGroup>
</Project>
