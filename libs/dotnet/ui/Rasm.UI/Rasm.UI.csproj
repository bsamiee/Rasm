<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0-beta.0</Version>
        <Description>Interfaces as pure state transitions, drawn and driven by any host</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.HighPerformance" />
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="System.Numerics.Tensors" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="QuikGraph" />
        <PackageReference Include="RBush.Signed" />
        <PackageReference Include="Singulink.Collections.Weak" />
        <PackageReference Include="SuperLinq" />
    </ItemGroup>

    <ItemGroup Label="Geospatial">
        <PackageReference Include="NetTopologySuite" />
        <PackageReference Include="ProjNET" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
        <PackageReference Include="Wacton.Unicolour.Datasets" />
    </ItemGroup>

    <ItemGroup Label="Typography">
        <PackageReference Include="HarfBuzzSharp" />
        <PackageReference Include="ICU4N" />
        <PackageReference Include="SkiaSharp.HarfBuzz" />
        <PackageReference Include="Topten.RichTextKit" />
        <PackageReference Include="UnicodeInformation" />
    </ItemGroup>

    <ItemGroup Label="Documents">
        <PackageReference Include="Markdig" />
    </ItemGroup>

    <ItemGroup Label="User Interface">
        <PackageReference Include="IconPacks.Lucide" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.Resources" />
        <PackageReference Include="SkiaSharp.Skottie" />
        <PackageReference Include="Svg.Custom" />
        <PackageReference Include="Svg.Model" />
        <PackageReference Include="Svg.Skia" />
    </ItemGroup>
</Project>
