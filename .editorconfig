root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# BuildCheck (`dotnet build -check`): allow uninitialized property reads in conditions shared by .props and .targets files. Both values must match.
[*.csproj]
build_check.BC0201.AllowUninitializedPropertiesInConditions = true
build_check.BC0202.AllowUninitializedPropertiesInConditions = true

[*.cs]
# --- [NAMESPACE_AND_IMPORTS] -----------------------------------------------
csharp_style_namespace_declarations = file_scoped:error                       # File-scoped namespaces.
dotnet_style_namespace_match_folder = true:error                              # Namespace matches the folder path.
dotnet_style_require_accessibility_modifiers = always:error                   # Explicit accessibility modifiers.
csharp_using_directive_placement = outside_namespace:error                    # Using directives outside the namespace.
dotnet_sort_system_directives_first = true                                    # System usings first.
dotnet_separate_import_directive_groups = false                               # No blank lines between using groups.

# --- [TYPE_EXPLICITNESS] ----------------------------------------------------
csharp_style_var_for_built_in_types = false:error                             # No var for built-in types.
csharp_style_var_when_type_is_apparent = false:error                          # No var when the type is apparent.
csharp_style_var_elsewhere = false:error                                      # No var elsewhere.
dotnet_style_predefined_type_for_locals_parameters_members = true:error       # Language keywords (int, string) in declarations.
dotnet_style_predefined_type_for_member_access = true:error                   # Language keywords in member access.
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:error # Fixed modifier order.
dotnet_style_qualification_for_field = false:error                            # No this. on fields.
dotnet_style_qualification_for_property = false:error                         # No this. on properties.
dotnet_style_qualification_for_method = false:error                           # No this. on methods.
dotnet_style_qualification_for_event = false:error                            # No this. on events.
dotnet_style_readonly_field = true:error                                      # readonly on fields that are never reassigned.
csharp_style_prefer_readonly_struct = true:error                              # readonly structs avoid defensive copies.
csharp_style_prefer_readonly_struct_member = true:error                       # readonly struct members where possible.

# --- [CONTROL_FLOW_AND_PATTERNS] --------------------------------------------
csharp_style_pattern_matching_over_is_with_cast_check = true:error            # Pattern matching over is + cast.
csharp_style_pattern_matching_over_as_with_null_check = true:error            # Pattern matching over as + null check.
csharp_style_prefer_pattern_matching = true:error                             # Pattern matching over equivalent checks.
csharp_style_prefer_not_pattern = true:error                                  # is not pattern.
csharp_style_prefer_extended_property_pattern = true:error                    # Extended property patterns for nested members.
csharp_style_prefer_switch_expression = true:error                            # Switch expressions over switch statements.
csharp_style_prefer_null_check_over_type_check = true:error                   # Null check over type check.
dotnet_style_prefer_conditional_expression_over_return = true:error           # Conditional expression over if/else return.
dotnet_style_prefer_conditional_expression_over_assignment = true:error       # Conditional expression over if/else assignment.
dotnet_style_prefer_compound_assignment = true:error                          # Compound assignment.
dotnet_style_prefer_simplified_boolean_expressions = true:error               # Simplified boolean expressions.
dotnet_style_prefer_simplified_interpolation = true:error                     # Simplified string interpolation.
csharp_style_inlined_variable_declaration = true:error                        # Inline out variable declarations.

# --- [MODERN_SYNTAX_AND_CONCISION] ------------------------------------------
csharp_style_prefer_primary_constructors = true:error                         # Primary constructors.
dotnet_style_prefer_collection_expression = when_types_exactly_match:error    # Collection expressions when types match exactly.
csharp_style_implicit_object_creation_when_type_is_apparent = true:error      # Target-typed new when the type is apparent.
dotnet_style_object_initializer = true:error                                  # Object initializers.
dotnet_style_collection_initializer = true:error                              # Collection initializers.
dotnet_style_prefer_inferred_tuple_names = true:error                         # Inferred tuple element names.
dotnet_style_explicit_tuple_names = true:error                                # Tuple element names over ItemN.
dotnet_style_prefer_inferred_anonymous_type_member_names = true:error         # Inferred anonymous type member names.
csharp_style_deconstructed_variable_declaration = true:error                  # Deconstruction for tuple assignment.
csharp_style_prefer_tuple_swap = true:error                                   # Tuple swap.
csharp_style_prefer_index_operator = true:error                               # Index operator (^).
csharp_style_prefer_range_operator = true:error                               # Range operator (..).
csharp_prefer_simple_using_statement = true:error                             # using declarations over using blocks.
csharp_prefer_static_local_function = true:error                              # static local functions when nothing is captured.
csharp_prefer_static_anonymous_function = true:error                          # static lambdas when nothing is captured.
csharp_style_prefer_method_group_conversion = true:error                      # Method groups over equivalent lambdas.
csharp_style_prefer_local_over_anonymous_function = false:error               # Local functions are not required over lambdas.
csharp_style_prefer_top_level_statements = false:error                        # No top-level statements.
csharp_style_prefer_utf8_string_literals = true:error                         # UTF-8 string literals.
csharp_prefer_simple_default_expression = true:error                          # default literal over default(T).
dotnet_style_operator_placement_when_wrapping = beginning_of_line             # Wrapped operators at line start.
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:error # Parentheses in arithmetic operators for clarity.
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:error # Parentheses in relational operators for clarity.
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:error # Parentheses in other binary operators for clarity.
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:error      # No unnecessary parentheses elsewhere.

# --- [NULL_AND_EXPRESSION_SAFETY] -------------------------------------------
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error # is null over ReferenceEquals.
dotnet_style_null_propagation = true:error                                    # Null propagation (?.).
dotnet_style_coalesce_expression = true:error                                 # Null coalescing (??).
csharp_style_conditional_delegate_call = true:error                           # Conditional delegate invocation (?.Invoke).
csharp_style_throw_expression = true:error                                    # Throw expressions.
csharp_style_unused_value_assignment_preference = discard_variable:error      # Discard for unused assignments.
csharp_style_unused_value_expression_statement_preference = discard_variable:error # Discard for unused expression values.

# --- [MEMBER_BODY_STYLE] ----------------------------------------------------
csharp_style_expression_bodied_methods = true:error                           # Expression-bodied methods.
csharp_style_expression_bodied_constructors = true:error                      # Expression-bodied constructors.
csharp_style_expression_bodied_operators = true:error                         # Expression-bodied operators.
csharp_style_expression_bodied_properties = true:error                        # Expression-bodied properties.
csharp_style_expression_bodied_indexers = true:error                          # Expression-bodied indexers.
csharp_style_expression_bodied_accessors = true:error                         # Expression-bodied accessors.
csharp_style_expression_bodied_lambdas = true:error                           # Expression-bodied lambdas.
csharp_style_expression_bodied_local_functions = true:error                   # Expression-bodied local functions.
dotnet_style_prefer_auto_properties = true:error                              # Auto-properties over trivial backing fields.

# --- [FORMATTING_KR] --------------------------------------------------------
csharp_prefer_braces = false:error                                            # No braces on single-statement blocks.
csharp_new_line_before_open_brace = none                                      # Opening brace on the same line.
csharp_new_line_before_else = false                                           # else on the same line as the closing brace.
csharp_new_line_before_catch = false                                          # catch on the same line as the closing brace.
csharp_new_line_before_finally = false                                        # finally on the same line as the closing brace.
csharp_new_line_before_members_in_object_initializers = false                 # No forced newline before object initializer members.
csharp_new_line_before_members_in_anonymous_types = false                     # No forced newline before anonymous type members.
csharp_new_line_between_query_expression_clauses = false                      # No forced newline between query clauses.
dotnet_style_allow_multiple_blank_lines_experimental = false                  # No consecutive blank lines.
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false            # No blank lines between adjacent braces.
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false # No blank line after the constructor initializer colon.
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = true  # Arrow expression body can start on the next line.
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false  # No blank line after conditional-expression tokens.
csharp_preserve_single_line_statements = true                                 # Preserve single-line statements.
csharp_preserve_single_line_blocks = true                                     # Preserve single-line blocks.
csharp_indent_block_contents = true                                           # Indent block contents.
csharp_indent_case_contents = true                                            # Indent case contents.
csharp_indent_case_contents_when_block = true                                 # Indent case block contents.
csharp_indent_switch_labels = true                                            # Indent switch labels.
csharp_indent_labels = one_less_than_current                                  # Labels indented one level less than the current block.
csharp_indent_braces = false                                                  # Do not indent braces.
csharp_space_after_keywords_in_control_flow_statements = true                 # Space after control-flow keywords.
csharp_space_after_cast = false                                               # No space after a cast.
csharp_space_after_comma = true                                               # Space after commas.
csharp_space_before_comma = false                                             # No space before commas.
csharp_space_before_colon_in_inheritance_clause = true                        # Space before the inheritance colon.
csharp_space_after_colon_in_inheritance_clause = true                         # Space after the inheritance colon.
csharp_space_around_binary_operators = before_and_after                       # Spaces around binary operators.
csharp_space_between_method_declaration_parameter_list_parentheses = false    # No spaces inside parameter list parentheses.
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false # No spaces inside empty parameter list parentheses.
csharp_space_between_method_call_parameter_list_parentheses = false           # No spaces inside argument list parentheses.
csharp_space_between_method_call_empty_parameter_list_parentheses = false     # No spaces inside empty argument list parentheses.
csharp_space_between_method_declaration_name_and_open_parenthesis = false     # No space between method name and ( in declarations.
csharp_space_between_method_call_name_and_opening_parenthesis = false         # No space between method name and ( in calls.
csharp_space_after_dot = false                                                # No space after a member-access dot.
csharp_space_before_dot = false                                               # No space before a member-access dot.
csharp_space_after_semicolon_in_for_statement = true                          # Space after semicolons in for statements.
csharp_space_before_semicolon_in_for_statement = false                        # No space before semicolons in for statements.
csharp_space_before_open_square_brackets = false                              # No space before [.
csharp_space_between_empty_square_brackets = false                            # No spaces inside empty [].
csharp_space_between_square_brackets = false                                  # No spaces inside [].
dotnet_diagnostic.IDE0055.severity = error                                    # Formatting violations fail the build.

# --- [QUALITY_ANALYZERS] -----------------------------------------------------
# AnalysisLevel latest-all plus TreatWarningsAsErrors makes every CA rule an error. Only exemptions and rules that latest-all leaves off belong here.
dotnet_diagnostic.CA1034.severity = none                                      # Nested types are part of Thinktecture union declarations.
dotnet_diagnostic.CA1720.severity = none                                      # Grasshopper parameter SmartEnum items are named after the CLR type (Integer, Boolean).
dotnet_diagnostic.MA0008.severity = none                                      # Structs default to StructLayout Sequential; no need to restate it.
dotnet_diagnostic.MA0048.severity = none                                      # Multiple types per file allowed.
dotnet_diagnostic.MA0051.severity = none                                      # No method length limit.
dotnet_diagnostic.CS0169.severity = error                                     # Unused private fields.
dotnet_diagnostic.CA1021.severity = error                                     # Off under latest-all: no out parameters.
dotnet_diagnostic.CA1045.severity = error                                     # Off under latest-all: no ref parameters.
dotnet_diagnostic.CS0649.severity = error                                     # Fields that are never assigned.
dotnet_diagnostic.CA1307.severity = none                                      # Covered by MA0001 and MA0074, which skip expression trees.
dotnet_diagnostic.CA1310.severity = none                                      # Covered by MA0074.

# --- [THREADING_ANALYZERS] ---------------------------------------------------
dotnet_diagnostic.VSTHRD003.severity = none                                   # No host exposes JoinableTaskFactory, the prescribed fix.
dotnet_diagnostic.VSTHRD103.severity = none                                   # Covered by CA1849 and MA0042.
dotnet_diagnostic.VSTHRD102.severity = error                                  # Info by default: implement internal logic asynchronously.
dotnet_diagnostic.VSTHRD111.severity = error                                  # Hidden by default: explicit ConfigureAwait on every await.

# --- [MEZIANTOU_ANALYZERS] ---------------------------------------------------
dotnet_diagnostic.MA0003.severity = error                                     # Named arguments for readability.
dotnet_diagnostic.MA0004.severity = none                                      # Covered by CA2007 and VSTHRD111.
dotnet_diagnostic.MA0007.severity = error                                     # Trailing comma in multi-line initializers.
dotnet_diagnostic.MA0020.severity = error                                     # Collection methods over equivalent LINQ.
dotnet_diagnostic.MA0028.severity = error                                     # Optimize StringBuilder usage.
dotnet_diagnostic.MA0029.severity = error                                     # Merge adjacent LINQ operations.
dotnet_diagnostic.MA0032.severity = error                                     # CancellationToken overloads when available.
dotnet_diagnostic.MA0042.severity = error                                     # No blocking calls in async methods.
dotnet_diagnostic.MA0001.severity = error                                     # Info by default: explicit StringComparison; skips expression trees.
dotnet_diagnostic.MA0043.severity = none                                      # Covered by RCS1015.
dotnet_diagnostic.MA0075.severity = error                                     # Info by default: implicit culture-sensitive ToString.
dotnet_diagnostic.MA0121.severity = error                                     # Off by default: do not reassign parameters.
dotnet_diagnostic.MA0141.severity = error                                     # Off by default: is null over == null.
dotnet_diagnostic.MA0142.severity = error                                     # Off by default: is not null over != null.
dotnet_diagnostic.MA0170.severity = error                                     # Off by default: type check that can never succeed.
dotnet_diagnostic.MA0171.severity = error                                     # Off by default: is null over Nullable<T>.HasValue.
dotnet_diagnostic.MA0172.severity = error                                     # Off by default: identical operands in a binary expression.
dotnet_diagnostic.MA0186.severity = error                                     # Off by default: [NotNullWhen(true)] on the Equals parameter.
dotnet_diagnostic.MA0217.severity = error                                     # Off by default: static lambdas when nothing is captured; overlaps TTRESG1001 with the same fix.
dotnet_diagnostic.MA0031.severity = error                                     # Info by default: Any() or Length over Count().
dotnet_diagnostic.MA0036.severity = error                                     # Info by default: class with only static members is static.
dotnet_diagnostic.MA0057.severity = error                                     # Info by default: attribute class names end with Attribute.
dotnet_diagnostic.MA0058.severity = error                                     # Info by default: exception class names end with Exception.
dotnet_diagnostic.MA0059.severity = error                                     # Info by default: event args class names end with EventArgs.
dotnet_diagnostic.MA0067.severity = error                                     # Info by default: Guid.Empty over new Guid().
dotnet_diagnostic.MA0073.severity = error                                     # Info by default: no comparison to a bool constant.
dotnet_diagnostic.MA0101.severity = error                                     # Info by default: string literal with an implicit newline.
dotnet_diagnostic.MA0107.severity = error                                     # Off by default: no culture-sensitive object.ToString.
dotnet_diagnostic.MA0113.severity = error                                     # Info by default: DateTime.UnixEpoch over the 1970 literal.
dotnet_diagnostic.MA0114.severity = error                                     # Info by default: DateTimeOffset.UnixEpoch over the 1970 literal.
dotnet_diagnostic.MA0127.severity = error                                     # Info by default: string.Equals over an is pattern on strings.
dotnet_diagnostic.MA0128.severity = error                                     # Info by default: is pattern over SequenceEqual on literal spans.
dotnet_diagnostic.MA0133.severity = error                                     # Info by default: no implicit DateTime to DateTimeOffset conversion.
dotnet_diagnostic.MA0136.severity = error                                     # Info by default: raw string literal with an implicit newline.
dotnet_diagnostic.MA0152.severity = error                                     # Info by default: Unwrap over a double await.
dotnet_diagnostic.MA0154.severity = error                                     # Info by default: langword in XML doc comments.
dotnet_diagnostic.MA0173.severity = error                                     # Info by default: LazyInitializer.EnsureInitialized over a manual check.
dotnet_diagnostic.MA0180.severity = error                                     # Off by default: ILogger<T> type argument matches the containing type.
dotnet_diagnostic.MA0184.severity = error                                     # Info by default: interpolated string without holes.
dotnet_diagnostic.MA0188.severity = error                                     # Info by default: TimeProvider over a custom clock.
dotnet_diagnostic.MA0189.severity = error                                     # Info by default: InlineArray over fixed-size buffers.
dotnet_diagnostic.MA0204.severity = error                                     # Info by default: unnecessary partial modifier.
dotnet_diagnostic.MA0205.severity = error                                     # Info by default: ^ over the expanded boolean form.
dotnet_diagnostic.MA0206.severity = error                                     # Info by default: unnecessary braces on a type declaration.
dotnet_diagnostic.MA0212.severity = error                                     # Off by default: MemoryMarshal.GetReference over indexing at zero.
dotnet_diagnostic.MA0216.severity = error                                     # Info by default: unnecessary closed modifier.
dotnet_diagnostic.MA0218.severity = error                                     # Info by default: empty language attribute in XML doc comments.
dotnet_diagnostic.MA0219.severity = error                                     # Info by default: language attribute set in XML doc comments.
dotnet_diagnostic.MA0044.severity = error                                     # Remove redundant ToString calls.
dotnet_diagnostic.MA0050.severity = error                                     # Validate iterator arguments before enumeration.
dotnet_diagnostic.MA0052.severity = error                                     # nameof over enum ToString on a constant.
dotnet_diagnostic.MA0053.severity = error                                     # Seal classes not designed for inheritance.
dotnet_diagnostic.MA0063.severity = error                                     # Where before OrderBy.
dotnet_diagnostic.MA0071.severity = error                                     # Remove redundant else.
dotnet_diagnostic.MA0076.severity = error                                     # Invariant culture in string interpolation.
dotnet_diagnostic.MA0078.severity = error                                     # Cast<T>() over Select casts.
dotnet_diagnostic.MA0079.severity = error                                     # Forward the CancellationToken with WithCancellation.
dotnet_diagnostic.MA0080.severity = error                                     # WithCancellation on async enumeration.
dotnet_diagnostic.MA0089.severity = error                                     # char overloads for single-character strings.
dotnet_diagnostic.MA0090.severity = none                                      # Covered by RCS1259.
dotnet_diagnostic.MA0098.severity = error                                     # Indexers over equivalent LINQ.
dotnet_diagnostic.MA0102.severity = error                                     # readonly members where possible.
dotnet_diagnostic.MA0105.severity = error                                     # Lambda parameters over closure captures.
dotnet_diagnostic.MA0106.severity = error                                     # Factory-argument overloads over closure captures.
dotnet_diagnostic.MA0108.severity = error                                     # Remove redundant argument values.
dotnet_diagnostic.MA0110.severity = error                                     # Regex source generator for constant patterns.
dotnet_diagnostic.MA0111.severity = error                                     # string.Create over FormattableString.
dotnet_diagnostic.MA0134.severity = none                                      # Covered by VSTHRD110.
dotnet_diagnostic.MA0158.severity = none                                      # Covered by IDE0330.
dotnet_diagnostic.MA0159.severity = error                                     # Order() over OrderBy(x => x).
dotnet_diagnostic.MA0160.severity = error                                     # ContainsKey when the TryGetValue value is unused.
dotnet_diagnostic.MA0166.severity = error                                     # Forward TimeProvider to methods that accept one.
dotnet_diagnostic.MA0167.severity = error                                     # TimeProvider overloads when available.
dotnet_diagnostic.MA0168.severity = error                                     # readonly struct for in parameters.
dotnet_diagnostic.MA0178.severity = error                                     # TimeSpan.Zero over new TimeSpan(0).
dotnet_diagnostic.MA0179.severity = error                                     # Attribute.IsDefined for presence checks.
dotnet_diagnostic.MA0185.severity = error                                     # Simplify string.Create with invariant inputs.
dotnet_diagnostic.MA0190.severity = error                                     # Partial properties for source-generated Regex.
dotnet_diagnostic.MA0191.severity = error                                     # No null-forgiving operator.
dotnet_diagnostic.MA0192.severity = error                                     # HasFlag over bitwise enum checks.
dotnet_diagnostic.MA0193.severity = error                                     # Explicit MidpointRounding.
dotnet_diagnostic.MA0194.severity = error                                     # Merge is expressions on the same value.
dotnet_diagnostic.MA0200.severity = error                                     # No empty property pattern on non-nullable value types.
MA0032.allowOverloadsWithOptionalParameters = false                           # CancellationToken overloads required even with optional parameters.
dotnet_code_quality_unused_parameters = all                                   # Unused-parameter analysis on all visibilities.

# --- [ROSLYNATOR_ANALYZERS] --------------------------------------------------
# Warning-default rules already error. Entries here promote Info and Hidden rules, enable disabled rules, and disable duplicates.
dotnet_diagnostic.RCS1002.severity = error                                    # Off by default: no braces on a single-statement block.
dotnet_diagnostic.RCS1004.severity = error                                    # Off by default: no braces on a single-statement if/else.
dotnet_diagnostic.RCS1006.severity = error                                    # Hidden by default: merge else with a nested if.
dotnet_diagnostic.RCS1014.severity = error                                    # Off by default: explicitly typed array creation.
dotnet_diagnostic.RCS1015.severity = error                                    # nameof over a string literal that names a symbol.
dotnet_diagnostic.RCS1020.severity = error                                    # T? over Nullable<T>.
dotnet_diagnostic.RCS1031.severity = error                                    # Hidden by default: remove braces from switch sections.
dotnet_diagnostic.RCS1034.severity = error                                    # Hidden by default: remove sealed from members of a sealed type.
dotnet_diagnostic.RCS1039.severity = error                                    # Hidden by default: remove empty attribute argument list.
dotnet_diagnostic.RCS1042.severity = error                                    # Hidden by default: remove enum : int.
dotnet_diagnostic.RCS1048.severity = error                                    # Lambda over anonymous method.
dotnet_diagnostic.RCS1050.severity = error                                    # Off by default: no parentheses on new T { } with an initializer.
dotnet_diagnostic.RCS1052.severity = error                                    # Off by default: one attribute per bracket pair.
dotnet_diagnostic.RCS1055.severity = error                                    # Hidden by default: remove semicolon after a type declaration.
dotnet_diagnostic.RCS1056.severity = error                                    # Off by default: no using alias directives.
dotnet_diagnostic.RCS1061.severity = error                                    # Hidden by default: merge if with a nested if.
dotnet_diagnostic.RCS1068.severity = error                                    # Simplify logical negation.
dotnet_diagnostic.RCS1069.severity = error                                    # Hidden by default: remove case label beside default.
dotnet_diagnostic.RCS1070.severity = error                                    # Hidden by default: remove default section with only break.
dotnet_diagnostic.RCS1071.severity = error                                    # Hidden by default: remove explicit : base().
dotnet_diagnostic.RCS1073.severity = error                                    # if/else returning constants becomes one return.
dotnet_diagnostic.RCS1074.severity = error                                    # Hidden by default: remove empty parameterless constructor.
dotnet_diagnostic.RCS1077.severity = error                                    # Fold LINQ chains to one operator.
dotnet_diagnostic.RCS1078.severity = error                                    # Off by default: "" over string.Empty.
dotnet_diagnostic.RCS1079.severity = error                                    # Off by default: no NotImplementedException left in code.
dotnet_diagnostic.RCS1081.severity = error                                    # Off by default: one declarator per field or local.
dotnet_diagnostic.RCS1089.severity = error                                    # ++/-- over x = x + 1.
dotnet_diagnostic.RCS1093.severity = error                                    # File without code.
dotnet_diagnostic.RCS1098.severity = error                                    # Constant on the right of a comparison.
dotnet_diagnostic.RCS1099.severity = error                                    # default label last in its switch section.
dotnet_diagnostic.RCS1103.severity = error                                    # if/else assigning a condition becomes one assignment.
dotnet_diagnostic.RCS1105.severity = error                                    # No literal inside an interpolation hole.
dotnet_diagnostic.RCS1107.severity = error                                    # Remove ToCharArray before foreach.
dotnet_diagnostic.RCS1108.severity = error                                    # static on every partial declaration.
dotnet_diagnostic.RCS1112.severity = error                                    # Merge adjacent Where calls.
dotnet_diagnostic.RCS1113.severity = error                                    # string.IsNullOrEmpty over the expanded check.
dotnet_diagnostic.RCS1114.severity = error                                    # M over new EventHandler(M).
dotnet_diagnostic.RCS1118.severity = error                                    # Local assigned a constant becomes const.
dotnet_diagnostic.RCS1124.severity = error                                    # Hidden by default: inline a local used once.
dotnet_diagnostic.RCS1128.severity = error                                    # x ??= y over if (x == null) x = y.
dotnet_diagnostic.RCS1130.severity = error                                    # No bitwise operator on an enum without [Flags].
dotnet_diagnostic.RCS1132.severity = error                                    # Remove override that only calls base.
dotnet_diagnostic.RCS1133.severity = error                                    # Hidden by default: no Dispose inside its own using.
dotnet_diagnostic.RCS1134.severity = error                                    # Hidden by default: remove trailing return, continue, or unreachable statement.
dotnet_diagnostic.RCS1136.severity = error                                    # Hidden by default: merge switch sections with identical bodies.
dotnet_diagnostic.RCS1143.severity = error                                    # Hidden by default: default(T) ?? x.
dotnet_diagnostic.RCS1145.severity = error                                    # Hidden by default: remove as to the operand's own type.
dotnet_diagnostic.RCS1154.severity = error                                    # Enum members sorted by value.
dotnet_diagnostic.RCS1157.severity = error                                    # Composite enum value with an undefined flag.
dotnet_diagnostic.RCS1161.severity = error                                    # Hidden by default: explicit enum member values.
dotnet_diagnostic.RCS1162.severity = error                                    # Off by default: no x = y = z chains.
dotnet_diagnostic.RCS1164.severity = error                                    # Unused type parameter.
dotnet_diagnostic.RCS1165.severity = error                                    # Hidden by default: unconstrained T compared to null.
dotnet_diagnostic.RCS1170.severity = error                                    # { get; } over { get; private set; } that is never set.
dotnet_diagnostic.RCS1173.severity = error                                    # x ?? y over if/else assigning x or y.
dotnet_diagnostic.RCS1174.severity = error                                    # Off by default: no async/await around a single returned task.
dotnet_diagnostic.RCS1175.severity = error                                    # Unused this parameter on an extension method.
dotnet_diagnostic.RCS1179.severity = error                                    # Inline an assignment that only feeds the next return.
dotnet_diagnostic.RCS1182.severity = error                                    # Hidden by default: remove base interface already implied.
dotnet_diagnostic.RCS1189.severity = error                                    # Hidden by default: #endregion carries its region name.
dotnet_diagnostic.RCS1190.severity = error                                    # Join adjacent string literals.
dotnet_diagnostic.RCS1191.severity = error                                    # Composite enum value written as A | B.
dotnet_diagnostic.RCS1192.severity = error                                    # Remove verbatim prefix from a literal without escapes.
dotnet_diagnostic.RCS1196.severity = error                                    # Call extension methods as extensions.
dotnet_diagnostic.RCS1198.severity = error                                    # Off by default: no value type boxed in string concatenation.
dotnet_diagnostic.RCS1199.severity = error                                    # == true over HasValue && Value.
dotnet_diagnostic.RCS1200.severity = error                                    # ThenBy after OrderBy.
dotnet_diagnostic.RCS1201.severity = error                                    # Hidden by default: chain consecutive calls on one receiver.
dotnet_diagnostic.RCS1202.severity = error                                    # FirstOrDefault().Member dereferences null.
dotnet_diagnostic.RCS1204.severity = error                                    # EventArgs.Empty over new EventArgs().
dotnet_diagnostic.RCS1205.severity = error                                    # Named arguments follow parameter order.
dotnet_diagnostic.RCS1208.severity = none                                     # Guard-clause rewrite of a trailing if; not enforced.
dotnet_diagnostic.RCS1209.severity = error                                    # Type-parameter constraints follow declaration order.
dotnet_diagnostic.RCS1218.severity = error                                    # if/else and loops with one live branch.
dotnet_diagnostic.RCS1222.severity = error                                    # Merge adjacent #pragma directives.
dotnet_diagnostic.RCS1224.severity = error                                    # Static method in an Extensions class becomes an extension.
dotnet_diagnostic.RCS1226.severity = error                                    # <para> for multi-paragraph doc summaries.
dotnet_diagnostic.RCS1228.severity = error                                    # Hidden by default: remove empty doc element.
dotnet_diagnostic.RCS1230.severity = error                                    # foreach over an explicit enumerator loop.
dotnet_diagnostic.RCS1231.severity = none                                     # in on every readonly struct hurts small structs; MA0168 covers the reverse.
dotnet_diagnostic.RCS1232.severity = error                                    # Doc elements follow parameter order.
dotnet_diagnostic.RCS1233.severity = error                                    # No & and | on booleans.
dotnet_diagnostic.RCS1234.severity = error                                    # Duplicate enum value.
dotnet_diagnostic.RCS1235.severity = error                                    # CompareOrdinal, Debug.Fail, indexer set over the long form.
dotnet_diagnostic.RCS1236.severity = error                                    # Exception filter over catch-and-rethrow.
dotnet_diagnostic.RCS1239.severity = error                                    # for over a counted while.
dotnet_diagnostic.RCS1240.severity = error                                    # == 0 over Length <= 0.
dotnet_diagnostic.RCS1243.severity = error                                    # Duplicate word in a comment.
dotnet_diagnostic.RCS1247.severity = error                                    # <code> and <c> doc tags match their content.
dotnet_diagnostic.RCS1252.severity = error                                    # Off by default: one infinite-loop form.
dotnet_diagnostic.RCS1253.severity = error                                    # Off by default: one doc summary layout.
dotnet_diagnostic.RCS1254.severity = error                                    # Enum flag values as shifts.
dotnet_diagnostic.RCS1256.severity = error                                    # No null check on a non-nullable argument.
dotnet_diagnostic.RCS1257.severity = error                                    # Enum field by name.
dotnet_diagnostic.RCS1258.severity = error                                    # Flag already implied by another flag.
dotnet_diagnostic.RCS1259.severity = error                                    # Remove empty destructor, else, finally, namespace, initializer, region, or statement.
dotnet_diagnostic.RCS1261.severity = error                                    # await using for IAsyncDisposable.
dotnet_diagnostic.RCS1262.severity = error                                    # No raw string literal without quotes or newlines.
dotnet_diagnostic.RCS1265.severity = error                                    # Remove catch { throw; }.
dotnet_diagnostic.RCS1266.severity = error                                    # Raw string literal over an escaped verbatim literal.
dotnet_diagnostic.RCS1267.severity = error                                    # Interpolation over string.Concat.
dotnet_diagnostic.RCS1268.severity = error                                    # a compared to b over (a - b) compared to 0.
dotnet_diagnostic.ROS0003.severity = error                                    # Rule enabled without its roslynator_* option.
dotnet_diagnostic.RCS1001.severity = none                                     # Covered by csharp_prefer_braces.
