language js(typescript, jsx)

or {
    `fetch($args)`,
    `globalThis.fetch($args)`
} as $hit where {
    $hit <: not within `Effect.tryPromise($_)` ,
    $hit <: not within `Effect.promise($_)` ,
    $hit <: not within `Effect.tryMapPromise($_)` ,
    register_diagnostic(span=$hit, message="Fetch in domain code, require HttpClient from the context for typed errors, Schedule retries, and traced spans, and call platform fetch only inside Effect.tryPromise at the boundary", severity="error")
}
