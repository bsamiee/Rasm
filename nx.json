{
    "cacheDirectory": ".cache/nx/cache",
    "neverConnectToCloud": true,
    "analytics": false,
    "useDaemonProcess": false,
    "plugins": [
        { "plugin": "@nx/vitest", "include": [ "**/vitest.config.ts" ], "exclude": [ "vitest.config.ts" ], "options": { "testMode": "run" } },
        { "plugin": "@nx/playwright/plugin", "options": { "ciTargetName": "" } },
        { "plugin": "@nx/dotnet", "options": { "clean": false, "pack": false, "publish": false, "run": false, "watch": false } },
        {
            "plugin": "./tools/nx/workspace.ts",
            "options": {
                "root": {
                    "restore": {
                        "options": { "args": [ "Workspace.slnx" ] },
                        "outputs": [ "{workspaceRoot}/.artifacts/dotnet/obj/*/project.assets.json", "{workspaceRoot}/.artifacts/dotnet/obj/*/*.nuget.*", "!{workspaceRoot}/.artifacts/dotnet/obj/*.cs/*", "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/restore.binlog" ]
                    },
                    "grammar": {
                        "executor": "nx:run-commands",
                        "options": {
                            "commands": [
                                "tree-sitter build --output .cache/ast-grep/xml.so node_modules/@tree-sitter-grammars/tree-sitter-xml/xml",
                                "tree-sitter generate --output .cache/ast-grep/sql/src tools/ast-grep/grammars/sql/grammar.js",
                                "cp node_modules/tree-sitter-sqlite3/src/scanner.c .cache/ast-grep/sql/src/scanner.c",
                                "tree-sitter build --output .cache/ast-grep/sql.so .cache/ast-grep/sql",
                                "tree-sitter build --output .cache/ast-grep/swift.so node_modules/tree-sitter-swift",
                                "tree-sitter generate --output .cache/ast-grep/csharp/src tools/ast-grep/grammars/csharp/grammar.js",
                                "cp node_modules/tree-sitter-c-sharp/src/scanner.c .cache/ast-grep/csharp/src/scanner.c",
                                "tree-sitter build --output .cache/ast-grep/csharp.so .cache/ast-grep/csharp"
                            ],
                            "parallel": false
                        },
                        "inputs": [ "{workspaceRoot}/tools/ast-grep/grammars/**/grammar.js", { "externalDependencies": [ "@tree-sitter-grammars/tree-sitter-xml", "tree-sitter-sqlite3", "tree-sitter-swift", "tree-sitter-c-sharp" ] }, { "runtime": "tree-sitter --version" }, { "runtime": "node --version" } ],
                        "outputs": [ "{workspaceRoot}/.cache/ast-grep/xml.so", "{workspaceRoot}/.cache/ast-grep/sql.so", "{workspaceRoot}/.cache/ast-grep/swift.so", "{workspaceRoot}/.cache/ast-grep/csharp.so" ],
                        "cache": true
                    },
                    "outline": {
                        "command": "ast-grep outline --custom-languages allow --color never --outline-rules tools/ast-grep/outline/typescript.yml --outline-rules tools/ast-grep/outline/python.yml --outline-rules tools/ast-grep/outline/java.yml --outline-rules tools/ast-grep/outline/bash.yml --outline-rules tools/ast-grep/outline/rust.yml",
                        "dependsOn": [ "grammar" ]
                    },
                    "typecheck:tsc": {},
                    "typecheck:swift": { "command": "swift build --build-tests --disable-automatic-resolution", "parallelism": false },
                    "typecheck:javac": {
                        "command": "fd --hidden --extension java --exec-batch javac -Xlint:all,-path -Werror -d .cache/javac -cp \"$(fd --type f --full-path --glob '**/lib/*.jar' --absolute-path \"$GHIDRA_INSTALL_DIR/Ghidra\" | paste -sd: -)\"",
                        "inputs": [ "javaFiles", { "externalDependencies": [] }, { "env": "JAVA_HOME" }, { "env": "GHIDRA_INSTALL_DIR" } ],
                        "outputs": [ "{workspaceRoot}/.cache/javac" ]
                    },
                    "lint:dotnet-format": { "command": "fd --hidden --extension cs --exec-batch dotnet format whitespace --folder --verify-no-changes --include", "inputs": [ "{workspaceRoot}/global.json", "{workspaceRoot}/**/.editorconfig", "{workspaceRoot}/**/*.cs", { "externalDependencies": [] } ] },
                    "lint:ruff": { "dependsOn": [ { "target": "lint:ruff:*", "params": "forward" } ] },
                    "lint:ruff:check": { "command": "ruff check" },
                    "lint:ruff:format": { "command": "ruff format --check" },
                    "lint:deptry": { "dependsOn": [ { "target": "lint:deptry:*", "params": "forward" } ] },
                    "lint:deptry:blender": { "command": "deptry --config libs/python/blender/pyproject.toml libs/python/blender apps", "inputs": [ "python", "pythonFiles" ] },
                    "lint:deptry:typography": { "command": "deptry --config libs/python/typography/pyproject.toml libs/python/typography", "inputs": [ "python", "pythonFiles" ] },
                    "lint:deptry:foundry": { "command": "deptry --config tools/foundry/pyproject.toml tools/foundry", "inputs": [ "python", "pythonFiles" ] },
                    "lint:biome": {
                        "command": "biome check --error-on-warnings",
                        "inputs": [ "{workspaceRoot}/.editorconfig", "{workspaceRoot}/**/.{gitignore,ignore}", "{workspaceRoot}/pnpm-workspace.yaml", "{workspaceRoot}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,html,vue,svelte,astro,svg,grit}", { "externalDependencies": [ "@biomejs/biome" ] } ]
                    },
                    "lint:rustfmt": { "command": "cargo fmt --check", "inputs": [ "rust", "rustFiles", "{workspaceRoot}/**/Cargo.toml", "{workspaceRoot}/rustfmt.toml" ] },
                    "lint:swift-format": { "command": "fd --hidden --extension swift --exec-batch xcrun swift-format lint --strict --parallel", "inputs": [ "swiftFiles", "{workspaceRoot}/.swift-format", { "externalDependencies": [] }, { "runtime": "xcrun swift-format --version" } ] },
                    "lint:swiftlint": { "command": "fd --hidden --extension swift --exec-batch swiftlint lint --quiet" },
                    "lint:nx": { "command": "nx sync:check", "inputs": [ "{workspaceRoot}/{nx.json,Package.swift,Xcode.xcconfig,.swiftlint.yml}", "{workspaceRoot}/tools/nx/**/*", "{workspaceRoot}/eng/typescript/{manifest,parsed,process}.ts" ] },
                    "lint:xcprojformatter": { "command": "fd --hidden --glob project.xcproj --exec sh -c 'xcrun xcprojformatter \"$0\" | diff -u \"$0\" -' {}", "inputs": [ "{workspaceRoot}/**/project.xcproj", { "externalDependencies": [] }, { "runtime": "xcodebuild -version" } ] },
                    "lint:google-java-format": { "command": "fd --hidden --extension java --exec-batch google-java-format --aosp --dry-run --set-exit-if-changed", "inputs": [ "javaFiles", { "externalDependencies": [] }, { "runtime": "google-java-format --version" } ] },
                    "lint:pmd": {
                        "command": "fd --hidden --extension java --exec-batch pmd check --rulesets .config/pmd.xml --cache .cache/pmd/java --aux-classpath \".cache/javac:$JAVA_HOME/lib/jrt-fs.jar:$(fd --type f --full-path --glob '**/lib/*.jar' --absolute-path \"$GHIDRA_INSTALL_DIR/Ghidra\" | paste -sd: -)\" --no-progress",
                        "dependsOn": [ "typecheck:javac" ],
                        "inputs": [ "javaFiles", "{workspaceRoot}/.config/pmd.xml", { "externalDependencies": [] }, { "runtime": "pmd --version" }, { "env": "GHIDRA_INSTALL_DIR" }, { "env": "JAVA_HOME" } ],
                        "outputs": [ "{workspaceRoot}/.cache/pmd/java" ]
                    },
                    "lint:tombi": { "dependsOn": [ { "target": "lint:tombi:*", "params": "forward" } ] },
                    "lint:tombi:lint": { "command": "tombi lint --error-on-warnings" },
                    "lint:tombi:format": { "command": "tombi format --check" },
                    "lint:yamllint": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamllint --strict", "inputs": [ "python", "yamlFiles" ] },
                    "lint:yamlfmt": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamlfmt -conf .config/yamlfmt.yaml -lint", "inputs": [ "yamlFiles", { "externalDependencies": [] }, { "runtime": "yamlfmt -version" } ] },
                    "lint:actionlint": {
                        "command": "actionlint",
                        "inputs": [ "{workspaceRoot}/.github/actionlint.yaml", "{workspaceRoot}/.github/workflows/*.{yml,yaml}", "{workspaceRoot}/.github/actions/*/action.{yml,yaml}", { "externalDependencies": [] }, { "runtime": "actionlint --version" }, { "runtime": "shellcheck --version" } ]
                    },
                    "lint:shellcheck": { "command": "fd --hidden --extension sh --exec-batch shellcheck --", "inputs": [ "shellFiles", { "externalDependencies": [] }, { "runtime": "shellcheck --version" } ] },
                    "lint:shfmt": { "command": "fd --hidden --extension sh --exec-batch shfmt -d --", "inputs": [ "shellFiles", "{workspaceRoot}/**/.editorconfig", { "externalDependencies": [] }, { "runtime": "shfmt --version" } ] },
                    "format": { "executor": "./:format", "dependsOn": [ "format:dotnet-format", { "projects": [ "tag:language:dotnet" ], "target": "format" } ], "parallelism": false },
                    "format:files": { "executor": "./:format" },
                    "format:dotnet-format": { "options": { "args": [ "Workspace.slnx", "--no-restore" ] }, "dependsOn": [ "restore" ], "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/format-dotnet-format.binlog" ] },
                    "format:ruff": { "executor": "nx:run-commands", "options": { "commands": [ "ruff check --fix", "ruff format" ], "parallel": false }, "metadata": { "extensions": [ ".py", ".pyi", ".pyw", ".ipynb" ] } },
                    "format:biome": { "command": "biome check --write --error-on-warnings --no-errors-on-unmatched", "metadata": { "extensions": [ ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts", ".json", ".jsonc", ".css", ".graphql", ".html", ".vue", ".svelte", ".astro", ".svg", ".grit" ] } },
                    "format:rustfmt": { "command": "cargo fmt", "configurations": { "files": { "command": "rustfmt" } }, "metadata": { "extensions": [ ".rs" ] } },
                    "format:swiftlint": { "command": "fd --hidden --extension swift --exec-batch swiftlint lint --fix --quiet", "configurations": { "files": { "command": "swiftlint lint --fix --quiet" } }, "metadata": { "extensions": [ ".swift" ] } },
                    "format:swift-format": { "command": "fd --hidden --extension swift --exec-batch xcrun swift-format format --in-place --parallel", "configurations": { "files": { "command": "xcrun swift-format format --in-place --parallel" } }, "metadata": { "extensions": [ ".swift" ] } },
                    "format:xcprojformatter": { "command": "fd --hidden --glob project.xcproj --exec xcrun xcprojformatter --update", "configurations": { "files": { "command": "find {args} -exec xcrun xcprojformatter --update {} ';'" } }, "metadata": { "extensions": [ ".xcproj" ] } },
                    "format:google-java-format": { "command": "fd --hidden --extension java --exec-batch google-java-format --aosp --replace", "configurations": { "files": { "command": "google-java-format --aosp --replace" } }, "metadata": { "extensions": [ ".java" ] } },
                    "format:tombi": { "command": "tombi format", "metadata": { "extensions": [ ".toml" ] } },
                    "format:yamlfmt": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamlfmt -conf .config/yamlfmt.yaml", "configurations": { "files": { "command": "yamlfmt -conf .config/yamlfmt.yaml" } }, "metadata": { "extensions": [ ".yaml", ".yml" ] } },
                    "format:shfmt": { "command": "fd --hidden --extension sh --exec-batch shfmt -w --", "configurations": { "files": { "command": "shfmt -w --" } }, "metadata": { "extensions": [ ".sh" ] } },
                    "check": { "dependsOn": [ "typecheck:*", "lint:*", "test" ] },
                    "upgrade": { "command": "node eng/typescript/upgrade/main.ts", "dependsOn": [ "upgrade:*", { "projects": [ "tag:language:rust" ], "target": "upgrade:cargo" }, { "projects": [ "tag:build:swiftpm" ], "target": "upgrade:swiftpm" }, { "projects": [ "tag:build:xcode" ], "target": "upgrade:xcode" } ] },
                    "upgrade:dotnet": { "command": "dotnet run --project eng/dotnet/Rasm.Upgrade -- Directory.Packages.props" },
                    "upgrade:python": { "executor": "nx:run-commands", "options": { "commands": [ "pixi update", "pixi run --locked -e hdf5 pixi run --locked -e default uv sync --upgrade" ], "parallel": false } },
                    "upgrade:typescript": { "executor": "nx:run-commands", "options": { "commands": [ "ncu --workspaces --target newest --upgrade --install never --reject typescript,tree-sitter-swift", "node eng/typescript/upgrade/typescript.ts", "pnpm install" ], "parallel": false }, "parallelism": false },
                    "upgrade:rust": { "executor": "nx:run-commands", "options": { "commands": [ "cargo upgrade --incompatible", "cargo update", "tombi format Cargo.toml" ], "parallel": false } },
                    "upgrade:swift": { "executor": "nx:run-commands", "options": { "commands": [ "node eng/typescript/upgrade/swift.ts", "swift package update" ], "parallel": false }, "dependsOn": [ "grammar" ], "parallelism": false },
                    "upgrade:actions": { "command": "actions-up --yes --style preserve --min-age 0" },
                    "upgrade:docker": { "command": "mise run docker:update" },
                    "release": { "command": "doppler run --project agent-runtime --config dev --only-secrets GITHUB_TOKEN --no-fallback --attempts 1 -- node eng/typescript/release/main.ts", "parallelism": false },
                    "infra": { "command": "doppler run --project agent-runtime --config dev --only-secrets GITHUB_TOKEN --no-fallback --attempts 1 -- node infra/main.ts repository", "configurations": { "preview": { "args": "preview" }, "up": { "args": "up" }, "refresh": { "args": "refresh" } }, "parallelism": false },
                    "docker": { "command": "mise daemons start docker" },
                    "clean": { "command": "node eng/typescript/cleanup/main.ts", "parallelism": false }
                }
            }
        }
    ],
    "sync": { "applyChanges": true },
    "release": {
        "projectsRelationship": "independent",
        "releaseTag": { "pattern": "{releaseGroupName}-{projectName}-v{version}" },
        "version": { "conventionalCommits": true, "versionActions": "./tools/nx/release.ts" },
        "conventionalCommits": { "types": { "refactor": { "semverBump": "patch" }, "perf": { "semverBump": "patch" } } },
        "changelog": { "projectChangelogs": { "file": false, "createRelease": "github", "entryWhenNoChanges": "{projectName} release with no new commits", "renderOptions": { "authors": false } }, "git": { "commit": false } },
        "groups": { "macos": { "projects": [ "tag:output:appcast" ] }, "rhino": { "projects": [ "tag:output:rhp" ] }, "blender": { "projects": [ "tag:output:extension" ] }, "web": { "projects": [ "tag:output:cloudflare" ] } }
    },
    "namedInputs": {
        "production": [ "{projectRoot}/**/*", "!{projectRoot}/.storybook/**/*" ],
        "dotnet": [ "{workspaceRoot}/{global.json,NuGet.config,.editorconfig,.config/analyzers.globalconfig,Directory.Build.props,Directory.Build.rsp,Directory.Build.targets,Directory.Packages.props}", "{workspaceRoot}/tools/roslyn/**/*", { "externalDependencies": [] }, { "env": "NUGET_PACKAGES" } ],
        "python": [ "{workspaceRoot}/**/pyproject.toml", "{workspaceRoot}/uv.lock", "{workspaceRoot}/pixi.lock", { "externalDependencies": [] }, { "runtime": "uv --version" }, { "runtime": "python --version" } ],
        "typescript": [ "{workspaceRoot}/tsconfig.base.json", { "json": "{workspaceRoot}/package.json", "fields": [ "type", "imports" ] }, { "runtime": "node --version" } ],
        "vite": [ "{workspaceRoot}/vite.shared.ts", "{workspaceRoot}/eng/typescript/{manifest,parsed,process}.ts", { "externalDependencies": [ "vite", "effect", "@effect/platform-node", "@vitejs/plugin-react", "@cloudflare/vite-plugin", "@swc/core", "plist", "smol-toml", "yaml" ] } ],
        "rust": [ "{workspaceRoot}/{Cargo.toml,Cargo.lock,rust-toolchain.toml,.cargo/config.toml}", { "externalDependencies": [] } ],
        "nextest": [ "{workspaceRoot}/.config/nextest.toml", { "runtime": "cargo nextest --version" } ],
        "lintLibrary": [ "{projectRoot}/**/*.rs", "!{projectRoot}/examples/**/*", "{projectRoot}/Cargo.toml" ],
        "swift": [ "{workspaceRoot}/{Package.swift,Package.resolved}", { "externalDependencies": [] }, { "runtime": "xcodebuild -version" } ],
        "xcode": [ "{workspaceRoot}/Xcode.xcconfig" ],
        "swiftlint": [ "{workspaceRoot}/.swiftlint.yml", { "runtime": "swiftlint version" } ],
        "pythonFiles": [ "{workspaceRoot}/**/*.{py,pyi}" ],
        "rustFiles": [ "{workspaceRoot}/**/*.rs" ],
        "swiftFiles": [ "{workspaceRoot}/**/*.swift" ],
        "javaFiles": [ "{workspaceRoot}/**/*.java" ],
        "yamlFiles": [ "{workspaceRoot}/**/*.{yml,yaml}", "!{workspaceRoot}/pnpm-lock.yaml" ],
        "shellFiles": [ "{workspaceRoot}/**/*.sh" ]
    },
    "targetDefaults": {
        "restore{,:*.cs}": { "command": "dotnet restore \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$(printf %s \"$NX_TASK_TARGET_TARGET\" | tr : -).binlog\"", "parallelism": false },
        "build{,:*}": [
            { "cache": true },
            { "filter": { "plugin": "@nx/dotnet" }, "dependsOn": [ "...", { "projects": [ "rasm" ], "target": "restore" } ] },
            { "filter": { "projects": [ "tag:host:rhino" ] }, "cache": false },
            {
                "filter": { "projects": [ "tag:output:rhp" ] },
                "options": { "args": [ "--no-restore" ] },
                "configurations": { "debug": { "args": [ "--no-restore", "--configuration", "Debug" ] }, "release": { "args": [ "--no-restore", "--configuration", "Release" ] } },
                "dependsOn": [ { "projects": [ "rasm" ], "target": "restore" } ]
            },
            {
                "filter": { "projects": [ "tag:language:dotnet" ] },
                "command": "dotnet build \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$(printf %s \"$NX_TASK_TARGET_TARGET\" | tr : -).binlog\"",
                "inputs": [ "...", "dotnet", "{workspaceRoot}/.config/sixlabors.lic" ],
                "parallelism": false
            },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "{projectRoot}",
                    "commands": [
                        "version=$(minver -v e) && xcodebuild -project {projectName}.xcodeproj -scheme {projectName} -destination platform=macOS -derivedDataPath \"$NX_WORKSPACE_ROOT/$XCODE_DERIVED_DATA_PATH\" -disableAutomaticPackageResolution -skipMacroValidation build LM_SKIP_METADATA_EXTRACTION=YES MARKETING_VERSION=\"$version\" {args}",
                        { "command": "xcode-build-server config -project {projectName}.xcodeproj -scheme {projectName} --build_root \"$NX_WORKSPACE_ROOT/$XCODE_DERIVED_DATA_PATH\"", "forwardAllArgs": false }
                    ],
                    "parallel": false
                },
                "configurations": { "ci": { "args": [ "CODE_SIGN_STYLE=Manual", "CODE_SIGN_IDENTITY=-", "DEVELOPMENT_TEAM=" ] } },
                "syncGenerators": [ "./tools/nx/generators.json:deployment-target" ],
                "cache": false
            },
            { "filter": { "projects": [ "tag:build:swiftpm" ] }, "command": "swift build --target {projectName} --disable-automatic-resolution", "cache": false, "parallelism": false },
            { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo build --locked --package {projectName}", "cache": false, "parallelism": false },
            { "filter": { "projects": [ "tag:language:typescript" ] }, "inputs": [ "production", "^production", "typescript" ] },
            { "filter": { "projects": [ "tag:bundler:vite" ] }, "command": "vite build --configLoader runner", "options": { "cwd": "{projectRoot}" }, "inputs": [ "...", "vite" ], "outputs": [ "{projectRoot}/dist" ] },
            { "filter": { "projects": [ "tag:output:cloudflare" ] }, "outputs": [ "...", "{projectRoot}/.cloudflare/output" ] },
            {
                "filter": { "projects": [ "tag:host:uxp" ] },
                "command": "vite build --configLoader runner --config uxp.config.ts",
                "options": { "cwd": "{projectRoot}" },
                "inputs": [ "...", "vite", { "runtime": "git rev-parse HEAD && git for-each-ref refs/tags" } ],
                "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ]
            },
            {
                "filter": { "projects": [ "tag:host:cep" ] },
                "command": "vite build --configLoader runner --config cep.config.ts",
                "options": { "cwd": "{projectRoot}" },
                "inputs": [ "production", "^production", "typescript", "vite", { "runtime": "git rev-parse HEAD && git for-each-ref refs/tags" } ],
                "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ]
            },
            { "filter": { "projects": [ "tag:output:script" ] }, "command": "vite build --configLoader runner --config script.config.ts", "options": { "cwd": "{projectRoot}" }, "inputs": [ "...", "vite" ], "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ] },
            { "filter": { "projects": [ "tag:host:extendscript" ] }, "command": "swc {projectRoot} -d .artifacts --out-file-extension jsx --ignore '**/node_modules/**'", "inputs": [ "...", { "externalDependencies": [ "@swc/core", "@swc/cli" ] } ], "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ] }
        ],
        "pack": [
            {
                "filter": { "projects": [ "tag:output:rhp" ] },
                "command": "dotnet publish --no-build --configuration Release \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$(printf %s \"$NX_TASK_TARGET_TARGET\" | tr : -).binlog\"",
                "options": { "cwd": "{projectRoot}" },
                "dependsOn": [ "build:release" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/publish/{projectName}/release*", "{workspaceRoot}/.artifacts/dotnet/obj/{projectName}/release*/PublishOutputs.*.txt", "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/pack.binlog" ]
            },
            {
                "filter": { "projects": [ "tag:output:extension" ] },
                "command": "version=$(minver -v e) && props=$(dotnet msbuild Directory.Build.props -getProperty:Authors -getProperty:PackageProjectUrl) && maintainer=$(printf %s \"$props\" | jq -er .Properties.Authors) && website=$(printf %s \"$props\" | jq -er .Properties.PackageProjectUrl) && python -m eng.python.blender pack {projectRoot} .artifacts/blender/{projectName} --version \"$version\" --maintainer \"$maintainer\" --website \"$website\"",
                "inputs": [ "...", "default", "python", "{workspaceRoot}/eng/python/blender/**/*.py", "{workspaceRoot}/libs/python/blender/records/faults.py", "{workspaceRoot}/Directory.Build.props", { "runtime": "\"$BLENDER_PATH\" --version" }, { "runtime": "git rev-parse HEAD && git for-each-ref refs/tags" } ],
                "outputs": [ "{workspaceRoot}/.artifacts/blender/{projectName}" ],
                "cache": true
            },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "options": {
                    "commands": [
                        "rm -rf \".artifacts/xcode/{projectRoot}\"",
                        "version=$(minver -v e) && xcodebuild archive -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -configuration Release -destination generic/platform=macOS -derivedDataPath \"$XCODE_DERIVED_DATA_PATH/release\" -clonedSourcePackagesDirPath \"$XCODE_DERIVED_DATA_PATH/SourcePackages\" -archivePath \".artifacts/xcode/{projectRoot}/{projectName}.xcarchive\" -disableAutomaticPackageResolution -skipMacroValidation LM_SKIP_METADATA_EXTRACTION=YES MARKETING_VERSION=\"$version\"",
                        "ditto -c -k --sequesterRsrc --keepParent \".artifacts/xcode/{projectRoot}/{projectName}.xcarchive/Products/Applications/{projectName}.app\" \".artifacts/xcode/{projectRoot}/{projectName}.zip\" && rm -rf \".artifacts/xcode/{projectRoot}/{projectName}.xcarchive\""
                    ],
                    "parallel": false
                },
                "outputs": [ "{workspaceRoot}/.artifacts/xcode/{projectRoot}" ],
                "syncGenerators": [ "./tools/nx/generators.json:deployment-target" ],
                "parallelism": false
            },
            { "filter": { "projects": [ "tag:host:uxp" ] }, "command": "rm -f .artifacts/{projectRoot}.ccx && ditto -c -k --norsrc .artifacts/{projectRoot} .artifacts/{projectRoot}.ccx", "dependsOn": [ "build" ], "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}.ccx" ] },
            {
                "filter": { "projects": [ "tag:host:cep" ] },
                "command": "doppler run --project agent-runtime --config dev --only-secrets ZXP_CERTIFICATE,ZXP_CERTIFICATE_PASSWORD --no-fallback --attempts 1 --command 'certificate=$(mktemp) && trap \"rm -f \\\"$certificate\\\"\" EXIT && printf %s \"$ZXP_CERTIFICATE\" | base64 -d > \"$certificate\" && rm -f .artifacts/{projectRoot}.zxp && ZXPSignCmd -sign .artifacts/{projectRoot} .artifacts/{projectRoot}.zxp \"$certificate\" \"$ZXP_CERTIFICATE_PASSWORD\" -tsa http://timestamp.digicert.com && ZXPSignCmd -verify .artifacts/{projectRoot}.zxp -certInfo'",
                "dependsOn": [ "build" ],
                "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}.zxp" ],
                "cache": false
            },
            {
                "filter": { "projects": [ "tag:output:sea" ] },
                "command": "vite build --configLoader runner --config {projectRoot}/sea.config.ts && node --build-sea .artifacts/{projectRoot}/sea.json && codesign --force --sign - --options runtime --entitlements {projectRoot}/server.entitlements \"$(jq -r .output .artifacts/{projectRoot}/sea.json)\""
            }
        ],
        "install": [
            { "filter": { "projects": [ "tag:build:xcode" ] }, "command": "rm -rf \"/Applications/{projectName}.app\" && ditto -x -k .artifacts/xcode/{projectRoot}/{projectName}.zip /Applications", "dependsOn": [ "...", "pack" ], "parallelism": false },
            {
                "filter": { "projects": [ "tag:output:rhp" ] },
                "command": "dotnet msbuild -target:InstallYakPackage -property:Configuration=Release \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$(printf %s \"$NX_TASK_TARGET_TARGET\" | tr : -).binlog\"",
                "options": { "cwd": "{projectRoot}" },
                "dependsOn": [ "pack" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/install.binlog" ],
                "parallelism": false
            },
            { "filter": { "projects": [ "tag:output:extension" ] }, "command": "python -m eng.python.blender install .artifacts/blender/{projectName}/*.zip", "dependsOn": [ "pack" ], "parallelism": false },
            { "filter": { "projects": [ "tag:output:command" ] }, "command": "uv tool install --reinstall --from {projectRoot} {projectName}", "parallelism": false },
            { "filter": { "projects": [ "tag:host:uxp" ] }, "command": "node eng/typescript/uxp/main.ts .artifacts/{projectRoot}", "dependsOn": [ "pack" ], "parallelism": false },
            {
                "filter": { "projects": [ "tag:host:cep" ] },
                "command": "folder=\"$HOME/Library/Application Support/Adobe/CEP/extensions/$(yq .ExtensionManifest.+@ExtensionBundleId .artifacts/{projectRoot}/CSXS/manifest.xml)\" && rm -rf \"$folder\" && ditto -x -k .artifacts/{projectRoot}.zxp \"$folder\"",
                "dependsOn": [ "pack" ],
                "parallelism": false
            },
            { "filter": { "projects": [ "tag:language:rust" ] }, "command": "mise daemons restart", "dependsOn": [ "install:cargo" ] },
            { "filter": { "projects": [ "tag:build:swiftpm" ] }, "command": "rm -f \"$XDG_CONFIG_HOME/swiftpm/bin/{projectName}\" && swift package --disable-automatic-resolution experimental-install --product {projectName}", "parallelism": false }
        ],
        "publish": [
            { "parallelism": false },
            {
                "filter": { "projects": [ "tag:output:rhp" ] },
                "command": "doppler run --project agent-runtime --config dev --only-secrets GITHUB_TOKEN,YAK_TOKEN --no-fallback --attempts 1 --command 'gh release upload {args.tag} \"$NX_WORKSPACE_ROOT\"/.artifacts/dotnet/publish/{projectName}/release/*.yak --clobber && dotnet msbuild -target:PushYakPackage -property:Configuration=Release \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$(printf %s \"$NX_TASK_TARGET_TARGET\" | tr : -).binlog\"'",
                "options": { "cwd": "{projectRoot}" },
                "dependsOn": [ "pack" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/publish.binlog" ]
            },
            {
                "filter": { "projects": [ "tag:output:appcast" ] },
                "command": "doppler run --project agent-runtime --config dev --only-secrets GITHUB_TOKEN,SPARKLE_ED_PRIVATE_KEY --no-fallback --attempts 1 --command 'gh release upload {args.tag} .artifacts/xcode/{projectRoot}/{projectName}.zip $(fd --no-ignore --extension ccx --extension zxp . .artifacts/$(dirname {projectRoot})) --clobber && printf %s \"$SPARKLE_ED_PRIVATE_KEY\" | generate_appcast --ed-key-file - .artifacts/xcode/{projectRoot} && gh release upload {projectName}-updates .artifacts/xcode/{projectRoot}/{projectName}.zip --clobber && gh release upload {projectName}-updates .artifacts/xcode/{projectRoot}/appcast.xml --clobber'",
                "dependsOn": [ "...", "pack" ]
            },
            {
                "filter": { "projects": [ "tag:output:extension" ] },
                "command": "doppler run --project agent-runtime --config dev --only-secrets GITHUB_TOKEN --no-fallback --attempts 1 --command 'gh release upload {args.tag} .artifacts/blender/{projectName}/*.zip --clobber && \"$BLENDER_PATH\" --factory-startup --command extension server-generate --repo-dir .artifacts/blender/{projectName} && gh release upload {projectName}-updates .artifacts/blender/{projectName}/*.zip --clobber && gh release upload {projectName}-updates .artifacts/blender/{projectName}/index.json --clobber'",
                "dependsOn": [ "pack" ]
            }
        ],
        "install:cargo": { "command": "cargo install --locked --profile dist --path {projectRoot}", "parallelism": false },
        "upgrade:cargo": { "executor": "nx:run-commands", "options": { "commands": [ { "command": "cargo install --locked --profile dist --path {projectRoot}", "forwardAllArgs": false }, "mise daemons restart" ], "parallel": false }, "parallelism": false },
        "upgrade:swiftpm": { "command": "rm -f \"$XDG_CONFIG_HOME/swiftpm/bin/{projectName}\" && swift package --disable-automatic-resolution experimental-install --product {projectName}", "dependsOn": [ { "projects": [ "rasm" ], "target": "upgrade:swift" } ], "parallelism": false },
        "serve": [ { "filter": { "projects": [ "tag:bundler:vite" ] }, "command": "vite --configLoader runner", "options": { "cwd": "{projectRoot}" }, "continuous": true } ],
        "hosting": [
            {
                "filter": { "projects": [ "tag:output:cloudflare" ] },
                "command": "doppler run --project agent-runtime --config dev --only-secrets CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID,OWNER_EMAIL --no-exit-on-missing-only-secrets --no-fallback --attempts 1 -- node infra/main.ts hosting {projectRoot}",
                "dependsOn": [ "build" ],
                "parallelism": false
            }
        ],
        "storybook": { "command": "storybook dev --ci", "options": { "cwd": "{projectRoot}" }, "continuous": true },
        "types": { "command": "cf workers types", "options": { "cwd": "{projectRoot}" }, "inputs": [ "{projectRoot}/cloudflare.config.ts", { "externalDependencies": [ "cf" ] } ], "outputs": [ "{projectRoot}/.cloudflare/types" ], "cache": true },
        "run:*.cs": { "command": "dotnet run" },
        "typecheck:*": [ { "cache": true }, { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo clippy --locked --no-deps --profile clippy --package {projectName}", "inputs": [ "default", "^default", "rust", "{workspaceRoot}/clippy.toml" ], "parallelism": false } ],
        "typecheck:tsc": [
            {
                "filter": { "projects": [ "tag:language:typescript", "rasm" ] },
                "command": "tsc --pretty false --incremental --tsBuildInfoFile \"$NX_WORKSPACE_ROOT/.cache/tsc/{projectName}/tsconfig.tsbuildinfo\"",
                "options": { "cwd": "{projectRoot}" },
                "inputs": [ "...", "default", "^default", "typescript", { "externalDependencies": [ "typescript", "@effect/tsgo" ] } ],
                "cache": true
            },
            { "filter": { "projects": [ "rasm" ] }, "inputs": [ "typescript", "{workspaceRoot}/tsconfig.json", "{workspaceRoot}/**/package.json", "{workspaceRoot}/**/*.{ts,tsx}", "!{workspaceRoot}/{docs,infra,tools/nx}/**" ] }
        ],
        "lint:*": { "cache": true },
        "rewrite:*": { "dependsOn": [ "grammar" ], "parallelism": false },
        "lint:ast-grep:*": {
            "dependsOn": [ "grammar" ],
            "inputs": [
                "pythonFiles",
                "rustFiles",
                "swiftFiles",
                "javaFiles",
                "yamlFiles",
                "{workspaceRoot}/**/*.{bash,bats,cgi,command,env,fcgi,ksh,sh,tmux,tool,zsh}",
                "{workspaceRoot}/**/*.cs",
                "{workspaceRoot}/**/*.js",
                "{workspaceRoot}/**/*.{py3,bzl,bazel}",
                "{workspaceRoot}/**/*.{ts,tsx}",
                "{workspaceRoot}/**/*.{xml,csproj,props,targets,slnx}",
                "{workspaceRoot}/**/NuGet.config",
                "{workspaceRoot}/**/*.sql",
                { "externalDependencies": [] },
                { "dependentTasksOutputFiles": "**/*.so" },
                { "runtime": "ast-grep --version" }
            ],
            "cache": true
        },
        "{typecheck:ty,typecheck:mypy,lint:refurb}:*": { "options": { "env": { "TY_UV": "1", "UV_LOCKED": "1" } }, "inputs": [ "python", "pythonFiles" ], "cache": true },
        "lint:ruff:*": { "inputs": [ "python", "pythonFiles", "{workspaceRoot}/**/*.{pyw,ipynb}" ], "cache": true },
        "lint:tombi:*": { "inputs": [ "{workspaceRoot}/**/*.toml", { "externalDependencies": [] }, { "runtime": "tombi --version" } ], "cache": true },
        "lint:squawk": {
            "command": "squawk --config .config/squawk.toml '.artifacts/typescript/vitest/{projectRoot}/**/*.sql'",
            "dependsOn": [ "test" ],
            "inputs": [ "{workspaceRoot}/.config/squawk.toml", { "dependentTasksOutputFiles": "**/*.sql" }, { "externalDependencies": [] }, { "runtime": "squawk --version" } ],
            "cache": true
        },
        "lint:dylint": [
            {
                "filter": { "projects": [ "tag:language:rust" ] },
                "command": "cargo dylint --all --no-deps --package {projectName} -- --locked --profile dylint",
                "inputs": [ "default", "^default", "rust", { "input": "lintLibrary", "projects": "tag:host:dylint" }, { "runtime": "cargo dylint --version" } ],
                "cache": true,
                "parallelism": false
            }
        ],
        "lint:cargo-modules": [ { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo modules orphans --deny --package {projectName}", "inputs": [ "default", "rust", { "runtime": "cargo modules --version" } ], "cache": true, "parallelism": false } ],
        "lint:swiftlint": [
            { "filter": { "projects": [ "rasm" ] }, "syncGenerators": [ "./tools/nx/generators.json:deployment-target" ], "inputs": [ "swiftlint", "swiftFiles", { "externalDependencies": [] } ], "cache": true },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "syncGenerators": [ "./tools/nx/generators.json:deployment-target" ],
                "executor": "nx:run-commands",
                "options": {
                    "commands": [
                        {
                            "command": "set -o pipefail; xcodebuild -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -destination platform=macOS -derivedDataPath \"$XCODE_DERIVED_DATA_PATH\" -disableAutomaticPackageResolution -skipMacroValidation -showBuildSettingsForIndex -json | jq '[.[] | to_entries[] | select(.value.swiftASTCommandArguments) | {file: .key, arguments: .value.swiftASTCommandArguments}]' > \"$XCODE_DERIVED_DATA_PATH/compile_commands.json\"",
                            "forwardAllArgs": false
                        },
                        "swiftlint analyze --quiet --compile-commands \"$XCODE_DERIVED_DATA_PATH/compile_commands.json\" {projectRoot}"
                    ],
                    "parallel": false
                },
                "dependsOn": [ "build" ],
                "inputs": [ "default", "^default", "swift", "xcode", "swiftlint" ],
                "cache": true
            }
        ],
        "lint:periphery": [
            { "filter": { "projects": [ "tag:build:xcode" ] }, "options": { "args": [ "--index-store-path", "\"$XCODE_DERIVED_DATA_PATH/Index.noindex/DataStore\"" ] }, "inputs": [ "xcode" ] },
            { "filter": { "projects": [ "tag:build:swiftpm" ] }, "options": { "args": [ "...", "--index-store-path", "\"$SWIFTPM_BUILD_DIR/out\"", "--retain-public" ] } },
            {
                "filter": { "projects": [ "tag:language:swift" ] },
                "command": "periphery scan --config .config/periphery.yml --report-include '{projectRoot}/**'",
                "dependsOn": [ "build" ],
                "inputs": [ "...", "default", "^default", "swift", "{workspaceRoot}/.config/periphery.{yml,json}", { "runtime": "periphery version" } ],
                "cache": true
            }
        ],
        "format:*": { "parallelism": false },
        "format:{dotnet-format,*.cs}": {
            "command": "dotnet format --binarylog \"$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$(printf %s \"$NX_TASK_TARGET_TARGET\" | tr : -).binlog\"",
            "dependsOn": [ "...", { "projects": [ "directory:tools/roslyn/**" ], "target": "build" } ],
            "parallelism": false
        },
        "test": [
            { "cache": true },
            { "filter": { "projects": [ "tag:language:dotnet" ] }, "inputs": [ "...", "dotnet" ] },
            { "filter": { "projects": [ "tag:language:python" ] }, "inputs": [ "...", "default", "^default", "python", "{workspaceRoot}/tests/python/{conftest.py,support.py}" ] },
            { "filter": { "projects": [ "tag:host:blender" ] }, "inputs": [ "...", "{workspaceRoot}/eng/python/blender/**/*.py", "{workspaceRoot}/libs/python/blender/records/faults.py", { "runtime": "\"$BLENDER_PATH\" --version" } ] },
            {
                "filter": { "projects": [ "tag:language:typescript" ], "plugin": "@nx/vitest" },
                "inputs": [ "...", "typescript", "vite", "{workspaceRoot}/vitest.config.ts", { "externalDependencies": [ "effect", "@effect/platform-node", "@effect/vitest", "yaml", "@vitest/browser-playwright", "playwright", "@storybook/addon-vitest" ] } ],
                "outputs": [ "...", "{workspaceRoot}/.artifacts/typescript/vitest/{projectRoot}" ]
            },
            { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo nextest run --locked --package {projectName}", "inputs": [ "default", "^default", "rust", "nextest" ], "parallelism": false },
            { "filter": { "projects": [ "tag:host:dylint" ] }, "inputs": [ "...", { "runtime": "cargo dylint --version" } ] },
            {
                "filter": { "projects": [ "tag:build:swiftpm" ] },
                "command": "rm -rf .artifacts/swift/test/{projectName} && mkdir -p .artifacts/swift/test/{projectName} && swift test --disable-automatic-resolution --attachments-path .artifacts/swift/test/{projectName} --event-stream-output-path .artifacts/swift/test/{projectName}/events.jsonl",
                "inputs": [ "default", "^default", "swift" ],
                "outputs": [ "{workspaceRoot}/.artifacts/swift/test/{projectName}" ],
                "parallelism": false
            }
        ],
        "test:integration": [
            { "filter": { "projects": [ "tag:language:typescript", "tag:language:rust" ] }, "dependsOn": [ { "projects": [ "rasm" ], "target": "docker" } ], "parallelism": false },
            { "filter": { "projects": [ "tag:language:typescript" ] }, "command": "vitest run", "options": { "cwd": "{projectRoot}" } },
            {
                "filter": { "projects": [ "tag:build:swiftpm" ] },
                "command": "rm -rf .artifacts/swift/test-integration/{projectName} && mkdir -p .artifacts/swift/test-integration/{projectName} && swift test --disable-automatic-resolution --attachments-path .artifacts/swift/test-integration/{projectName} --event-stream-output-path .artifacts/swift/test-integration/{projectName}/events.jsonl",
                "options": { "env": { "SWIFTPM_BUILD_DIR": ".cache/swiftpm/integration" } },
                "outputs": [ "{workspaceRoot}/.artifacts/swift/test-integration/{projectName}" ],
                "cache": false,
                "parallelism": false
            }
        ],
        "e2e": [ { "filter": { "plugin": "@nx/playwright/plugin" }, "configurations": { "ci": { "args": [ "--forbid-only", "--add-reporter=github" ] } }, "cache": false, "parallelism": true } ],
        "coverage": {
            "command": "cargo llvm-cov nextest --locked --package {projectName} --branch --html --output-dir .artifacts/rust/coverage/{projectName}",
            "inputs": [ "default", "^default", "rust", "nextest", { "runtime": "cargo llvm-cov --version" } ],
            "outputs": [ "{workspaceRoot}/.artifacts/rust/coverage/{projectName}" ],
            "cache": true,
            "parallelism": false
        },
        "check": [
            { "filter": { "projects": [ "tag:language:*" ] }, "executor": "nx:noop", "dependsOn": [ "typecheck:*", "lint:*", "test" ] },
            { "filter": { "projects": [ "tag:language:dotnet", "tag:language:swift" ] }, "dependsOn": [ "...", { "target": "build", "params": "forward" } ] },
            { "filter": { "projects": [ "tag:platform:windows" ] }, "dependsOn": [ "...", "build:windows" ] }
        ],
        "upgrade:xcode": [
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "options": {
                    "commands": [
                        "cp Package.resolved \"{projectRoot}/{projectName}.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved\"",
                        "xcodebuild -resolvePackageDependencies -project \"{projectRoot}/{projectName}.xcodeproj\" -clonedSourcePackagesDirPath \"$XCODE_DERIVED_DATA_PATH/SourcePackages\""
                    ],
                    "parallel": false
                },
                "dependsOn": [ { "projects": [ "rasm" ], "target": "upgrade:swift" } ]
            }
        ]
    }
}
