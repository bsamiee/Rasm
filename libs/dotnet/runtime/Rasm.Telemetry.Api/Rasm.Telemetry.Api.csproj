<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0-alpha.0</Version>
        <Description>LanguageExt failures as log records and span status, for libraries that emit through ILogger and ActivitySource</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup Label="Functional Programming">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Application Hosting">
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>
</Project>
