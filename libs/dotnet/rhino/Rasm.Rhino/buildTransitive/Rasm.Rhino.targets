<Project>
    <PropertyGroup Label="Rhino Icons">
        <_IconDir>$(IntermediateOutputPath)Icons/</_IconDir>
    </PropertyGroup>

    <ItemGroup Label="Rhino Icons">
        <_IconTone Include="$(_IconDir)light.css" Color="$(RhinoIconColor)" />
        <_IconTone Include="$(_IconDir)dark.css" Color="$(RhinoIconDarkColor)" />
        <_IconTone Include="$(_IconDir)plugin.css" Color="$(RhinoPlugInIconColor)" Condition="'$(TargetExt)' == '.rhp'" />
        <_IconMaster Include="icons/*.svg" Master="%(FullPath)" />
        <_ThemedIcon Include="@(_IconMaster->'$(_IconDir)%(Filename)%(Extension)')" Stylesheet="$(_IconDir)light.css" />
        <_ThemedIcon Include="@(_IconMaster->'$(_IconDir)%(Filename)_darkmode%(Extension)')" Stylesheet="$(_IconDir)dark.css" />
        <EmbeddedResource Include="@(_ThemedIcon)" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
        <FileWrites Include="@(_ThemedIcon);@(_IconTone)" />
    </ItemGroup>

    <Target Name="WriteIconTones" Condition="'$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_IconParts>@(RhinoIconPart->'.%(Identity) { fill: %(Fill)%3B stroke: %(Stroke) }', ' ')</_IconParts>
        </PropertyGroup>
        <MakeDir Directories="$(_IconDir)" />
        <WriteLinesToFile File="%(_IconTone.FullPath)" Lines="svg { color: %(_IconTone.Color) } $(_IconParts)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    </Target>

    <Target Name="PaintIcons" BeforeTargets="CoreCompile" DependsOnTargets="WriteIconTones" Condition="'@(_ThemedIcon)' != '' and '$(DesignTimeBuild)' != 'true'" Inputs="%(_ThemedIcon.Master);%(_ThemedIcon.Stylesheet)" Outputs="%(_ThemedIcon.FullPath)">
        <Exec Command="usvg --stylesheet &quot;%(_ThemedIcon.Stylesheet)&quot; &quot;%(_ThemedIcon.Master)&quot; &quot;%(_ThemedIcon.FullPath)&quot;" LogStandardErrorAsError="true" />
    </Target>

    <ItemDefinitionGroup Label="Rhino Plug-In Dependencies" Condition="'$(TargetExt)' == '.rhp'">
        <RuntimeCopyLocalItems DestinationSubDirectory="lib/" />
        <NativeCopyLocalItems DestinationSubDirectory="lib/" />
        <ReferenceCopyLocalPaths DestinationSubDirectory="lib/" />
        <ReferencePath DestinationSubDirectory="lib/" />
    </ItemDefinitionGroup>

    <Target Name="PlacePlugInNatives" AfterTargets="ResolvePackageAssets" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(AssetType)' == 'native' and '%(RuntimeIdentifier)' != 'osx-arm64' and '%(RuntimeIdentifier)' != 'win-x64' and '%(RuntimeIdentifier)' != 'win-arm64'" />
            <RuntimeTargetsCopyLocalItems Update="@(RuntimeTargetsCopyLocalItems)" DestinationSubDirectory="lib/" Condition="'%(RuntimeIdentifier)' == 'osx-arm64'" />
            <RuntimeTargetsCopyLocalItems Update="@(RuntimeTargetsCopyLocalItems)" DestinationSubDirectory="lib/%(DestinationSubDirectory)" Condition="'%(RuntimeIdentifier)' != 'osx-arm64'" />
        </ItemGroup>
    </Target>
</Project>
