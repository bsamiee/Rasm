{
    "name": "@rasm/typography",
    "private": true,
    "description": "Fonts as typed faces through to shaped, kerned, and justified text",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./face": "./face.ts",
        "./shaped": "./shaped.ts",
        "./source": "./source.ts",
        "./settings": "./composition/settings.ts",
        "./words": "./text/words.ts",
        "./kerning": "./composition/kerning.ts",
        "./justification": "./composition/justification.ts",
        "./quran": "./text/quran.ts",
        "./symbols": "./text/symbols.ts"
    },
    "dependencies": {
        "@rasm/search": "workspace:*",
        "effect": "catalog:",
        "fontkit": "catalog:",
        "harfbuzzjs": "catalog:",
        "icu": "catalog:"
    },
    "devDependencies": {
        "@types/fontkit": "catalog:",
        "@types/node": "catalog:"
    }
