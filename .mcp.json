{
    "mcpServers": {
        "roslyn-codelens": {
            "type": "stdio",
            "command": "dotnet",
            "args": ["dnx", "RoslynCodeLens.Mcp", "Workspace.slnx"],
            "env": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1" }
        },
        "binlog": {
            "type": "stdio",
            "command": "dotnet",
            "args": ["dnx", "Microsoft.AITools.BinlogMcp"],
            "env": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1" }
        }
    }
}
