# --- [BASE] -----------------------------------------------------------------------------

BasedOnStyle: LLVM
ColumnLimit: 200
IndentWidth: 4
InsertNewlineAtEOF: true
LineEnding: LF
AccessModifierOffset: -4
AllowShortEnumsOnASingleLine: false
BreakBeforeBinaryOperators: NonAssignment
BreakTemplateDeclarations: Yes
EmptyLineBeforeAccessModifier: Always
EnumTrailingComma: Insert
FixNamespaceComments: false
IncludeBlocks: Regroup
IncludeCategories:
    - { Regex: '\.generated\.h"$', Priority: 4 }
    - { Regex: '^<.*\.h(pp)?>$', Priority: 1 }
    - { Regex: '^<.*>$', Priority: 2 }
    - { Regex: '.*', Priority: 3 }
IndentExportBlock: false
InsertBraces: true
PackArguments: { BinPack: OnePerLine }
PackConstructorInitializers: NextLineOnly
PackParameters: { BinPack: OnePerLine }
PointerAlignment: Left
QualifierAlignment: Custom
QualifierOrder: [friend, static, inline, constexpr, const, volatile, type]
StatementMacros: [GENERATED_BODY, UCLASS, UENUM, UFUNCTION, UINTERFACE, UPROPERTY, USTRUCT]
WrapNamespaceBodyWithEmptyLines: Always
---
# --- [OBJC] -----------------------------------------------------------------------------

Language: ObjC
ObjCBinPackProtocolList: Never
ObjCBlockIndentWidth: 4
ObjCSpaceAfterProperty: true
