<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetExt>.rhp</TargetExt>
        <Description>Image formation, effects, review, and render queue for Rhino renders</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup Label="Plug-In Identity">
        <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
            <_Parameter1>b5bac151-510d-4dc3-9f2d-14526e39d793</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.HighPerformance" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Json" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Imaging">
        <PackageReference Include="Emgu.CV" />
        <PackageReference Include="Emgu.CV.runtime.mini.macos" Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="TinyEXR.NET" />
    </ItemGroup>

    <ItemGroup Label="Application Hosting">
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    </ItemGroup>

    <ItemGroup Label="Workspace Packages">
        <ProjectReference Include="../../../libs/dotnet/graphics/Rasm.Imaging/Rasm.Imaging.csproj" />
        <ProjectReference Include="../../../libs/dotnet/rhino/Rasm.Rhino/Rasm.Rhino.csproj" />
        <ProjectReference Include="../../../libs/dotnet/ui/Rasm.UI/Rasm.UI.csproj" />
    </ItemGroup>

    <ItemGroup Label="Embedded Resources">
        <EmbeddedResource Include="EmbeddedResources/Tables/*" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
        <EmbeddedResource Include="EmbeddedResources/darkroom_render.js" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>
</Project>
