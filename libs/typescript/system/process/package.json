{
    "name": "@rasm/process",
    "version": "0.1.0",
    "description": "Child process runs over Effect commands, each joining its caller's trace and failing with its exit code and output or at its deadline, and the process tree read from one ps or lsof run: descendants, ancestors, CPU time, and files held for write",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/system/process"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./child-process.ts",
        "./tree": "./tree.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/child-process.js",
            "./tree": "./dist/tree.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
