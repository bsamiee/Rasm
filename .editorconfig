roslynator_array_creation_type_style = explicit                               # RCS1014: explicit element type.
roslynator_empty_string_style = literal                                       # RCS1078: "" literal.
roslynator_enum_flag_value_style = shift_operator                             # RCS1254: 1 << n.
roslynator_infinite_loop_style = while                                        # RCS1252: while (true).
roslynator_doc_comment_summary_style = single_line                            # RCS1253: single-line summaries.
roslynator_object_creation_parentheses_style = omit                           # RCS1050: new T { } without parentheses.

# --- [IDE_QUALITY_RULES] ----------------------------------------------------
# IDE rules without a style option key. Most default to silent and are invisible to `dotnet format --severity warn`.
dotnet_diagnostic.IDE0004.severity = error                                    # Remove unnecessary casts.
dotnet_diagnostic.IDE0005.severity = error                                    # Remove unnecessary using directives.
dotnet_diagnostic.IDE0035.severity = error                                    # Remove unreachable code.
dotnet_diagnostic.IDE0051.severity = error                                    # Remove unused private members.
dotnet_diagnostic.IDE0052.severity = error                                    # Remove private members that are written but never read.
dotnet_diagnostic.IDE0060.severity = error                                    # Remove unused parameters.
dotnet_diagnostic.IDE0064.severity = error                                    # Make struct fields writable when they are reassigned.
dotnet_diagnostic.IDE0070.severity = error                                    # HashCode.Combine for composite hash codes.
dotnet_diagnostic.IDE0076.severity = error                                    # Remove invalid SuppressMessage targets.
dotnet_diagnostic.IDE0077.severity = error                                    # No legacy SuppressMessage target format.
dotnet_diagnostic.IDE0079.severity = error                                    # Remove stale suppressions.
dotnet_diagnostic.IDE0080.severity = error                                    # Remove unnecessary null-forgiving (!) operator.
dotnet_diagnostic.IDE0082.severity = error                                    # nameof over typeof(T).Name.
dotnet_diagnostic.IDE0100.severity = error                                    # Remove redundant equality (x == true).
dotnet_diagnostic.IDE0110.severity = error                                    # Remove unnecessary discard pattern arms.
dotnet_diagnostic.IDE0120.severity = error                                    # Simplify chained LINQ.
dotnet_diagnostic.IDE0121.severity = error                                    # OfType<T>() over type check and cast.
dotnet_diagnostic.IDE0220.severity = error                                    # Explicit cast in foreach over non-generic IEnumerable.
dotnet_diagnostic.IDE0240.severity = error                                    # Remove redundant #nullable directives.
dotnet_diagnostic.IDE0241.severity = error                                    # Remove unnecessary #nullable directives.
dotnet_diagnostic.IDE0280.severity = error                                    # nameof in attribute arguments.
dotnet_diagnostic.IDE0330.severity = error                                    # System.Threading.Lock over object locks.
dotnet_diagnostic.IDE0340.severity = error                                    # Unbound generic types in nameof.
dotnet_diagnostic.IDE0360.severity = error                                    # Expression-bodied trivial property accessors.
dotnet_diagnostic.IDE0380.severity = error                                    # Remove unnecessary unsafe modifiers.
dotnet_diagnostic.IDE1005.severity = error                                    # ?.Invoke for delegate invocation.

# --- [MAPPERLY_ANALYZERS] ----------------------------------------------------
# The Mapperly source generator reports every RMG rule. Warning-default rules already error; only Info and Hidden rules are listed.
dotnet_diagnostic.RMG009.severity = error                                     # Cannot map to a read-only member; otherwise skipped silently.
dotnet_diagnostic.RMG010.severity = error                                     # Cannot map from a write-only member.
dotnet_diagnostic.RMG011.severity = error                                     # Cannot map to a write-only member path.
dotnet_diagnostic.RMG015.severity = error                                     # Cannot map to an init-only member path.
dotnet_diagnostic.RMG033.severity = error                                     # Same-type member copied by reference under UseDeepCloning.
dotnet_diagnostic.RMG083.severity = error                                     # Cannot map to a read-only type; otherwise skipped silently.
dotnet_diagnostic.RMG088.severity = error                                     # Enum member naming attribute is missing.
dotnet_diagnostic.RMG089.severity = error                                     # Nullable source member to non-nullable target member; suppress per member with SuppressNullMismatchDiagnostic.
dotnet_diagnostic.RMG090.severity = error                                     # Nullable source type to non-nullable target type.
dotnet_diagnostic.RMG096.severity = error                                     # Hidden by default: ignored member without a Justification.

# --- [THINKTECTURE_ANALYZERS] -----------------------------------------------
# Every TTRESG rule defaults to Error or Warning except this one.
dotnet_diagnostic.TTRESG1001.severity = error                                 # Info by default: static lambdas in Switch/Map arms; pass state through the state parameter.

# --- [ERRORPRONE_ANALYZERS] --------------------------------------------------
# Warning-default rules already error. Only Info-default and disabled rules are listed.
dotnet_diagnostic.EPC15.severity = error                                      # ConfigureAwait(false) in assemblies marked UseConfigureAwaitFalse.
dotnet_diagnostic.EPC19.severity = error                                      # Dispose CancellationTokenRegistration; an unobserved one pins the callback.
dotnet_diagnostic.EPC27.severity = error                                      # No async void methods; EPC17 covers delegates.
dotnet_diagnostic.EPC28.severity = error                                      # No [ExcludeFromCodeCoverage] on a partial class.
dotnet_diagnostic.EPC29.severity = error                                      # Justification required on ExcludeFromCodeCoverage; the .artifacts section exempts generated code.
dotnet_diagnostic.EPC32.severity = error                                      # TaskCompletionSource requires RunContinuationsAsynchronously.
dotnet_diagnostic.EPC33.severity = error                                      # Task.Delay over Thread.Sleep in async methods.
dotnet_diagnostic.EPC35.severity = error                                      # No .Result, .Wait(), or .GetAwaiter().GetResult() in async methods.
dotnet_diagnostic.EPC36.severity = error                                      # No async delegate under TaskCreationOptions.LongRunning.
dotnet_diagnostic.EPC37.severity = error                                      # Argument validation in an async method throws at await, not at the call.
dotnet_diagnostic.ERP041.severity = error                                     # Seal EventSource subclasses; ERP042 covers the wider pattern.
dotnet_diagnostic.EPC38.severity = error                                      # Off by default: IEnumerable<Task> enumerated twice starts the tasks twice.
dotnet_diagnostic.EPC39.severity = error                                      # Off by default: enumerable re-enumerated inside a loop.
dotnet_diagnostic.EPC40.severity = error                                      # Off by default: IEnumerable<T> parameter enumerated more than once.

# --- [WORKSPACE_SEVERITY_FLOOR] ---------------------------------------------
# Severity is set here only; RASM0002 rejects NoWarn and WarningsNotAsErrors in project files. IKVM exemptions live in the root targets.
dotnet_diagnostic.CS1591.severity = none                                      # XML docs are generated for tooling; member docs are optional.
dotnet_diagnostic.CA2225.severity = none                                      # Operator overloads from LanguageExt and Thinktecture need no named alternatives.

[{libs/dotnet/Rasm,libs/dotnet/Rasm.Rhino,libs/dotnet/Rasm.Grasshopper}/**.cs]
dotnet_diagnostic.CA1416.severity = none                                      # Rhino's System.Drawing.Common implements the Windows-only members on macOS; CA1416 reads the reference assembly only.

[{libs/dotnet/Rasm.Rhino,libs/dotnet/Rasm.Grasshopper}/**.cs]
dotnet_diagnostic.CA1724.severity = none                                      # Microsoft.macOS Phase namespace collides with the ComponentUi.Phase enum.

[libs/dotnet/Rasm.AppHost/**.cs]
dotnet_diagnostic.EXTEXP0002.severity = none                                  # Experimental API opt-in (HmacRedactor).
dotnet_diagnostic.EXTEXP0008.severity = none                                  # Experimental API opt-in (resource monitoring).

[.artifacts/**.cs]
dotnet_diagnostic.EPC29.severity = none                                       # xunit.v3.msbuildtasks and Microsoft.Testing.Platform.MSBuild generate ExcludeFromCodeCoverage without a Justification.

[tests/**/*.cs]
dotnet_diagnostic.VSTHRD111.severity = none                                   # xUnit1030 forbids ConfigureAwait(false) in tests and xunit.analyzers suppresses CA2007.
dotnet_diagnostic.CA1515.severity = none                                      # xUnit requires public test classes.
dotnet_diagnostic.MA0191.severity = none                                      # Tests pass null into non-nullable parameters with the null-forgiving operator.

# --- [XUNIT_ANALYZERS] -------------------------------------------------------
# xunit.analyzers is included in xunit.v3.core. Only Info and Hidden rules are listed; the rest already error.
dotnet_diagnostic.xUnit1004.severity = error                                  # No skipped tests.
dotnet_diagnostic.xUnit1033.severity = error                                  # Fixture declared on the class but not accepted by its constructor.
dotnet_diagnostic.xUnit1042.severity = error                                  # TheoryData<T> over untyped MemberData.
dotnet_diagnostic.xUnit1044.severity = error                                  # Theory data that cannot be serialized loses per-row discovery.
dotnet_diagnostic.xUnit1045.severity = error                                  # Theory data whose serializability cannot be proven.
dotnet_diagnostic.xUnit1046.severity = error                                  # TheoryDataRow over an unserializable type.
dotnet_diagnostic.xUnit1047.severity = error                                  # TheoryDataRow whose serializability cannot be proven.
dotnet_diagnostic.xUnit1050.severity = error                                  # Untyped theory data source.
dotnet_diagnostic.xUnit2001.severity = error                                  # Hidden by default: invalid equality check.
dotnet_diagnostic.xUnit2022.severity = error                                  # Boolean assertion on a boolean literal.
dotnet_diagnostic.xUnit2023.severity = error                                  # Assert.Single over Assert.Collection with one element.
dotnet_diagnostic.xUnit2024.severity = error                                  # Collection assertion over Assert.True on Contains or Any.
dotnet_diagnostic.xUnit2025.severity = error                                  # Boolean assertion on a constant.
dotnet_diagnostic.xUnit2032.severity = error                                  # IsType where IsAssignableFrom is meant, or the reverse.
dotnet_diagnostic.xUnit2033.severity = error                                  # Info by default: Assert.Empty/NotEmpty over a count check.

# --- [VERIFY_SNAPSHOTS] ------------------------------------------------------
# VerifyChecks matches this section header verbatim. Do not change it.
[*.{received,verified}.{txt}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false

[*.{sh,bash}]
switch_case_indent = true
