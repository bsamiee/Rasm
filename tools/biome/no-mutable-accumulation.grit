language js(typescript, jsx)

or {
    `$collection.push($items)`,
    `$collection.unshift($items)`,
    `$collection.splice($items)`
} as $hit where {
    register_diagnostic(span=$hit, message="Mutable accumulation in domain code, replace the loop with an immutable fold or Array combinator, and accumulate across fibers with Ref", severity="error")
}
