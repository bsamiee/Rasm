{
    "name": "@rasm/test-nx-dotnet",
    "private": true,
    "description": "@rasm/nx-dotnet suites over graphs, targets, and refusals in temporary workspaces, and its build executor over real MSBuild runs",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "devDependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-dotnet": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "nx": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "test--vitest": {
                "inputs": [
                    "...",
                    "{workspaceRoot}/products/developer/nx/dotnet/analyzer/{*.cs,MsbuildAnalyzer.csproj,packages.lock.json}",
                    {
                        "fileset": "{workspaceRoot}/products/developer/nx/dotnet/analyzer/dist/*",
                        "includeIgnored": true
                    }
                ]
            }
        }
    }
}
