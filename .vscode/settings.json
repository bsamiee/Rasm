{
    // --- [FILES] -----------------------------------------------------------------------

    // --- [ASSOCIATIONS]

    "files.associations": {
        "*.aepx": "xml",
        "*.entitlements": "xml",
        "*.ghx": "xml",
        "*.globalconfig": "properties",
        "*.gltf": "json",
        "*.idms": "xml",
        "*.ips": "jsonl",
        "*.rhw": "xml",
        "*.rui": "xml",
        "*.uplugin": "json",
        "*.uproject": "json",
        "*.xcscheme": "xml",
        "*.xfdf": "xml",
        "*.xmp": "xml",
        ".shellcheckrc": "properties",
        ".swift-format": "json",
        "Package.resolved": "json",
        "pixi.lock": "yaml",
        "project.xcproj": "jsonc"
    },

    // --- [ICONS]

    "material-icon-theme.files.associations": {
        "*.entitlements": "xml",
        "*.gh": "3d",
        "*.ghz": "3d",
        "*.globalconfig": "editorconfig",
        "*.ips": "log",
        "*.uasset": "3d",
        "*.umap": "3d",
        "*.xcconfig": "settings",
        "Directory.Build.rsp": "visualstudio",
        "Package.resolved": "lock",
        "project.xcproj": "swift"
    },

    // --- [NESTING]

    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        ".gitignore": ".gitattributes, .gitmodules",
        "Cargo.toml": "Cargo.lock, clippy.toml, rust-analyzer.toml, rust-toolchain.toml, rustfmt.toml",
        "CLAUDE.md": ".mcp.json, AGENTS.md",
        "Directory.Build.props": "Directory.Build.rsp, Directory.Build.targets, Directory.Packages.props, Directory.Solution.props, global.json, NuGet.config, Workspace.slnx",
        "hk.pkl": "analyzers.globalconfig, periphery.json, periphery.yml, pmd.xml, squawk.toml, stubtest.ini, yamllint.yaml",
        "mise.toml": "mise.lock, mise.*.toml, miserc.toml",
        "nx.json": ".editorconfig, .shellcheckrc, sgconfig.yml",
        "package.json": "biome.json, pnpm-lock.yaml, pnpm-workspace.yaml, tsconfig.base.json, tsconfig.json, tsconfig.web.json, vite.shared.ts, vitest.config.ts",
        "Package.swift": ".swift-format, .swiftlint.yml, Package.resolved, Xcode.xcconfig",
        "pyproject.toml": "pixi.lock, uv.lock",
        "README.md": "LICENSE, TODO.md",
        "Sparkle-Info.plist": "Enhanced.entitlements"
    },

    // --- [WATCHING]

    "files.watcherExclude": {
        ".artifacts": true,
        ".cache": true,
        ".cargo/rustc-source": true,
        ".pixi": true,
        ".swiftpm": true,
        ".venv": true,
        "docs/research": true,
        "**/.cloudflare/**": true,
        "**/__pycache__/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/xcuserdata/**": true
    },

    // --- [WORKBENCH] -------------------------------------------------------------------

    // --- [EDITOR]

    "chat.disableAIFeatures": true,
    "problems.showCurrentInStatus": true,

    // --- [SOURCE_CONTROL]

    "git.autoRepositoryDetection": false,

    // --- [VISIBILITY]

    "explorer.compactFolders": false,
    "files.exclude": {
        ".artifacts": true,
        ".cache": true,
        ".cargo/rustc-source": true,
        ".pixi": true,
        ".swiftpm": true,
        ".venv": true,
        "**/.cloudflare": true,
        "**/__pycache__": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/xcuserdata": true
    },
    "search.exclude": { ".codex/skills": true, "docs/research": true },

    // --- [CMAKE] -----------------------------------------------------------------------

    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "cmake.sourceDirectory": "${workspaceFolder}/tools/ast-grep/grammars",

    // --- [DOTNET] ----------------------------------------------------------------------

    "csharp.suppressBuildAssetsNotification": true,
    "dotnet.codeLens.enableReferencesCodeLens": false,
    "dotnet.defaultSolution": "Workspace.slnx",
    "dotnet.diagnostics.reportInformationAsHint": false,
    "dotnet.projects.enableAutomaticRestore": false,
    "dotnet.server.useServerGC": false,

    // --- [JAVA] ------------------------------------------------------------------------

    "java.configuration.runtimes": [ { "default": true, "name": "JavaSE-27", "path": "${JAVA_HOME}" } ],
    "java.import.exclusions": [ "**/.cache/**", "**/.codex/skills", "**/.metadata/**", "**/archetype-resources/**", "**/META-INF/maven/**", "**/node_modules/**" ],
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": false,
    "java.project.referencedLibraries": [ "${GHIDRA_INSTALL_DIR}/Ghidra/**/lib/*.jar" ],
    "java.project.resourceFilters": [ "node_modules", "research", "rustc-source", "\\.(artifacts|build|cache|cloudflare|git|pixi|swiftpm|venv)" ],
    "java.project.sourcePaths": [ ".claude/skills/use-ghidra/scripts" ],

    // --- [JSON] ------------------------------------------------------------------------

    "json.schemas": [ { "fileMatch": [ "/biome.json" ], "url": "./node_modules/@biomejs/biome/configuration_schema.json" }, { "fileMatch": [ "/nx.json" ], "url": "./node_modules/nx/schemas/nx-schema.json" }, { "fileMatch": [ "**/*.xcodeproj/project.xcproj" ], "schema": { "allowTrailingCommas": true } } ],

    // --- [MISE] ------------------------------------------------------------------------

    "mise.enableCodeLens": false,
    "mise.enableConfigDiagnostics": false,
    "mise.notifyDaemonFailures": false,
    "mise.showDaemonsInStatusBar": false,

    // --- [PYTHON] ----------------------------------------------------------------------

    "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
    "python.terminal.activateEnvironment": false,
    "ruff.configurationPreference": "filesystemFirst",
    "ty.experimental.useUv": "on",

    // --- [RUST] ------------------------------------------------------------------------

    "rust-analyzer.cargo.extraEnv": { "CARGO_BUILD_BUILD_DIR": "{cargo-cache-home}/build/{workspace-path-hash}/vscode" },
    "rust-analyzer.cargo.targetDir": ".artifacts/rust/vscode",
    "rust-analyzer.checkOnSave": false,

    // --- [SHELL] -----------------------------------------------------------------------

    "bashIde.backgroundAnalysisIgnore": [ "**/.artifacts/**", "**/.cache/**", "**/.git/**", "**/.pixi/**", "**/.venv/**", "**/node_modules/**", "assets/**", "docs/research/**" ],

    // --- [SWIFT] -----------------------------------------------------------------------

    "swift.autoGenerateLaunchConfigurations": false,
    "swift.buildPath": ".cache/swiftpm/vscode",
    "swift.disableAutoResolve": true,
    "swift.logFileLogLevel": "info",
    "swift.sourcekit-lsp.supported-languages": [ "swift" ],
    "swift.swiftEnvironmentVariables": { "SWIFTPM_BUILD_DIR": ".cache/swiftpm/vscode" },

    // --- [TYPESCRIPT] ------------------------------------------------------------------

    "css.lint.unknownAtRules": "ignore",
    "js/ts.experimental.useTsgo": true,
    "js/ts.trace.server": "off",
    "js/ts.tsdk.path": "./.cache/typescript",
    "js/ts.tsserver.automaticTypeAcquisition.enabled": false,

    // --- [YAML] ------------------------------------------------------------------------

    "yaml.format.enable": false,
    "yaml.schemas": { "https://www.schemastore.org/yamllint.json": "/.config/yamllint.yaml" }
}
