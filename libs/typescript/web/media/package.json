{
    "name": "@rasm/media",
    "private": true,
    "description": "Media inspection, Uppy upload preprocessing, and pdf.js document viewing in the browser, with the Vite copy of pdf.js assets",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./pdf": "./pdf/index.ts",
        "./vite": "./vite.ts"
    },
    "dependencies": {
        "@uppy/core": "catalog:",
        "@use-gesture/react": "catalog:",
        "effect": "catalog:",
        "pdfjs-dist": "catalog:",
        "react": "catalog:",
        "vite": "catalog:",
        "vite-plugin-static-copy": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:"
    }
}
