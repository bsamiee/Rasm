<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Evaluates every MSBuild project of a workspace in one process and reports the facts the Nx plugin derives targets from, or moves the central package versions of a solution to their newest releases</Description>
        <VersionPrefix>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../package.json')), '"version":\s*"(?&lt;version&gt;[^"]+)"').Groups['version'].Value)</VersionPrefix>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <OutputType>Exe</OutputType>
        <RollForward>LatestMajor</RollForward>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <UseAppHost>false</UseAppHost>
        <DebugType>embedded</DebugType>
        <IsPublishable>true</IsPublishable>
        <PublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'dist'))</PublishDir>
    </PropertyGroup>

    <ItemGroup Label="Package Management">
        <PackageReference Include="NuGet.Common" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Configuration" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Packaging" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.ProjectModel" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Protocol" ExcludeAssets="runtime" />
        <PackageReference Include="NuGet.Versioning" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Label="Build Engine">
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator" />
    </ItemGroup>

    <ItemGroup Label="Functional Programming">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Runtime Diagnostics">
        <PackageReference Include="Microsoft.Extensions.DependencyModel" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
