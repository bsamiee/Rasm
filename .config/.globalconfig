dotnet_diagnostic.MA0136.severity = none # `.editorconfig` fixes line endings at `lf`
dotnet_diagnostic.MA0168.severity = none # HyperJet `Vector3D<T>` takes `in` on a non-readonly struct
dotnet_diagnostic.MA0174.severity = none # Opposite of `MA0175`, which `all-errors` enables
dotnet_diagnostic.MA0181.severity = none # Flags every cast, Meziantou's own defaults leave it off
dotnet_diagnostic.MA0214.severity = none # Opposite of `MA0215`, Meziantou enables one, `FixAllProvider.Create` needs the other
