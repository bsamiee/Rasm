{
    "name": "@rasm/atelier-indesign-plugin",
    "private": true,
    "description": "Atelier InDesign",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "dependencies": {
        "@rasm/indesign": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/typography": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:",
        "indesign-uxp-types": "catalog:",
        "vite": "catalog:"
    },
    "nx": {
        "targets": {
            "build--vite": {
                "inputs": [
                    "...",
                    "{workspaceRoot}/products/apps/creative-cloud/multi-app/atelier/macos/Resources/AppIcon.icon/Assets/Atelier.svg"
                ]
            }
        }
    }
}
