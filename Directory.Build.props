<Project>
    <PropertyGroup Label="Artifacts Output">
        <ArtifactsPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '.artifacts', 'dotnet'))</ArtifactsPath>
    </PropertyGroup>

    <PropertyGroup Label="Package Metadata">
        <Authors>Bardia Samiee</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/bsamiee/Rasm</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <PropertyGroup Label="Build Defaults">
        <RepoTargetFramework>net10.0</RepoTargetFramework>
        <TargetFramework>$(RepoTargetFramework)</TargetFramework>
        <RollForward>Major</RollForward>
        <SixLaborsLicenseFile>$(MSBuildThisFileDirectory).config/licenses/sixlabors.lic</SixLaborsLicenseFile>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <MeziantouAnalysisMode>all-errors</MeziantouAnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <NoWarn>$(NoWarn);NU5104</NoWarn> <!-- Stable packages pin prerelease dependencies such as LanguageExt.Core -->
    </PropertyGroup>

    <ItemGroup Label="Analyzer Configuration">
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).config/.globalconfig" />
    </ItemGroup>

    <PropertyGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <RhinoTargetFramework>net10.0</RhinoTargetFramework>
        <TargetFramework>$(RhinoTargetFramework)</TargetFramework>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <PublishReferencesSymbols>false</PublishReferencesSymbols>
    </PropertyGroup>

    <Import Project="libs/dotnet/rhino/Rasm.Rhino/buildTransitive/Rasm.Rhino.props" Condition="'$(RhinoHost)' != ''" />

    <PropertyGroup Label="Continuous Integration" Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <RestoreLockedMode>true</RestoreLockedMode>
    </PropertyGroup>
</Project>
