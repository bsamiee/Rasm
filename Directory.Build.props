<Project>
    <PropertyGroup Label="Workspace">
        <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
        <ArtifactsPath>$([MSBuild]::NormalizePath('$(RepoRoot)', '.artifacts', 'dotnet'))</ArtifactsPath>
        <LibsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'libs'))</LibsRoot>
        <ToolsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'tools'))</ToolsRoot>
        <TestsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'tests'))</TestsRoot>
        <AppsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'apps'))</AppsRoot>
    </PropertyGroup>

    <PropertyGroup Label="Project Classification">
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(LibsRoot)'))">libs</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(ToolsRoot)'))">tools</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(TestsRoot)'))">tests</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(AppsRoot)'))">apps</ProjectRole>
    </PropertyGroup>

    <PropertyGroup Label="Package Metadata">
        <Authors>bsamiee</Authors>
        <Company>bsamiee</Company>
        <Copyright>Copyright © 2025 bsamiee</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable Condition="'$(ProjectRole)' != 'libs'">false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Label="Build Defaults">
        <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <!-- Every hosted runner exports CI=true -->
    <PropertyGroup Label="Continuous Integration" Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Label="Workspace Analyzers">
        <PackageReference Include="ErrorProne.NET.CoreAnalyzers"               PrivateAssets="all" />
        <PackageReference Include="Meziantou.Analyzer"                         PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Roslynator.Analyzers"                       PrivateAssets="all" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Analyzers"  PrivateAssets="all" />
    </ItemGroup>

    <!-- Tests and tools never publish, and every MinVer run costs one dotnet and three git processes per project -->
    <ItemGroup Label="Release Version" Condition="'$(ProjectRole)' == 'libs' or '$(ProjectRole)' == 'apps'">
        <PackageReference Include="MinVer" PrivateAssets="all" />
    </ItemGroup>
</Project>
