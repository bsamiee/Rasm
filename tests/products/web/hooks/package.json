{
    "name": "@rasm/test-hooks",
    "private": true,
    "description": "Webhook receiver suite over the built Node bundle on an allocated port against a Postgres container: a signed delivery per sender accepted, changed, stale, unsigned, and unrouted deliveries refused, refusal before the body parses, and a repeated delivery accepted again",
    "type": "module",
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/hosting": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@testcontainers/postgresql": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "implicitDependencies": [
            "@rasm/hooks"
        ],
        "targets": {
            "test--vitest": {
                "dependsOn": [
                    "...",
                    {
                        "projects": [
                            "@rasm/hooks"
                        ],
                        "target": "build--vite"
                    }
                ]
            }
        }
    }
}
