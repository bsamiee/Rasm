<Project>
    <!-- Group packages by domain and keep each package family together -->
    <PropertyGroup Label="Central Package Management">
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>

    <ItemGroup Label="Analyzers">
        <PackageVersion Include="ErrorProne.NET.CoreAnalyzers"                            Version="0.9.0-beta.4" />          <!-- Roslyn analyzers for correctness and performance defects -->
        <PackageVersion Include="Meziantou.Analyzer"                                      Version="3.0.190" />               <!-- Roslyn analyzers enforcing C# design, usage, security, and performance rules -->
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers"              Version="18.7.23" />               <!-- Roslyn analyzers flagging async deadlocks and threading hazards -->
        <PackageVersion Include="Roslynator.Analyzers"                                    Version="5.0.0" />                 <!-- C# code quality analyzers, refactorings, and code fixes -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.Analyzers"               Version="10.5.0" />                <!-- Analyzers validating smart enum, value object, and union declarations -->
    </ItemGroup>

    <ItemGroup Label="Versioning">
        <PackageVersion Include="MinVer"                                                  Version="7.0.0" />                 <!-- Assembly and package version from the nearest git tag -->
    </ItemGroup>

    <ItemGroup Label="Rhino">
        <PackageVersion Include="System.Drawing.Common"                                   Version="10.0.11" />               <!-- GDI+ based drawing, imaging, and text rendering API -->
        <PackageVersion Include="Rhino3dm"                                                Version="8.35.0-beta1" />          <!-- openNURBS geometry access for reading and writing 3dm files -->
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageVersion Include="CommunityToolkit.HighPerformance"                        Version="8.4.2" />                 <!-- Helpers for spans, buffers, and memory in performance-critical code -->
        <PackageVersion Include="LanguageExt.Core"                                        Version="5.0.0-beta-77" />         <!-- Functional programming base: option, either, immutable collections, and effects -->
        <PackageVersion Include="LanguageExt.Parsec"                                      Version="5.0.0-beta-77" />         <!-- Parser combinators ported from Haskell -->
        <PackageVersion Include="LanguageExt.Streaming"                                   Version="5.0.0-beta-77" />         <!-- Compositional streaming with pipes, sources, sinks, and conduits -->
        <PackageVersion Include="LanguageExt.Sys"                                         Version="5.0.0-beta-77" />         <!-- Effect wrappers for console, file system, time, and environment -->
        <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream"                     Version="4.0.1-preview" />         <!-- Pooled memory stream allocator reducing garbage collection pressure -->
        <PackageVersion Include="NodaTime"                                                Version="3.3.3" />                 <!-- Date and time types with explicit calendars, instants, and zones -->
        <PackageVersion Include="NodaTime.Serialization.Protobuf"                         Version="2.0.2" />                 <!-- Protobuf well-known type conversions for instants and durations -->
        <PackageVersion Include="NodaTime.Serialization.SystemTextJson"                   Version="1.4.0" />                 <!-- JSON converters for instants, durations, zones, and calendar dates -->
        <PackageVersion Include="Riok.Mapperly"                                           Version="5.0.0-next.10" />         <!-- Source-generated object mapper with compile-time diagnostics -->
        <PackageVersion Include="System.IO.Hashing"                                       Version="11.0.0-preview.7.26381.103" /> <!-- Non-cryptographic hash algorithms including CRC and xxHash -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions"                         Version="10.5.0" />                <!-- Source-generated smart enums, value objects, and discriminated unions -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.EntityFrameworkCore10"   Version="10.5.0" />                <!-- Value converters for smart enums and value objects -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.Json"                    Version="10.5.0" />                <!-- JSON serialization for smart enums and value objects -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.MessagePack"             Version="10.5.0" />                <!-- Formatter resolvers for smart enums and value objects -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.Serilog"                 Version="10.5.0" />                <!-- Log event destructuring for smart enums, value objects, and unions -->
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageVersion Include="NodaMoney"                                               Version="2.7.0" />                 <!-- Money value type with currency handling and formatting -->
        <PackageVersion Include="NodaMoney.DependencyInjection"                           Version="2.7.0" />                 <!-- Dependency injection registration extensions for money services -->
        <PackageVersion Include="UnitsNet"                                                Version="6.0.0-pre103" />          <!-- Physical quantities and units with conversion and arithmetic -->
        <PackageVersion Include="UnitsNet.Serialization.SystemTextJson"                   Version="6.0.0-pre103" />          <!-- JSON serialization helpers for physical quantity types -->
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageVersion Include="AngouriMath"                                             Version="2.4.0" />                 <!-- Symbolic algebra: simplification, calculus, equation solving, LaTeX output -->
        <PackageVersion Include="CSparse"                                                 Version="4.4.1" />                 <!-- Sparse LU, Cholesky, and QR factorization for real and complex systems -->
        <PackageVersion Include="HyperJet"                                                Version="0.3.0" />                 <!-- Automatic differentiation computing gradients and Hessians with SIMD acceleration -->
        <PackageVersion Include="MatFlat"                                                 Version="0.8.3" />                 <!-- BLAS and LAPACK style routines in pure C#: LU, Cholesky, QR, SVD, eigen -->
        <PackageVersion Include="MathNet.Numerics"                                        Version="6.0.0-beta2" />           <!-- Numerical methods: linear algebra, statistics, interpolation, special functions -->
        <PackageVersion Include="MathNet.Numerics.Data.Matlab"                            Version="6.0.0-beta2" />           <!-- MAT-file reading and writing for matrices -->
        <PackageVersion Include="MathNet.Numerics.Data.Text"                              Version="6.0.0-beta2" />           <!-- Delimited text and MatrixMarket matrix input and output -->
        <PackageVersion Include="Meta.Numerics"                                           Version="4.2.0" />                 <!-- Statistics, matrix algebra, special functions, and extended precision numerics -->
        <PackageVersion Include="Microsoft.ML.Probabilistic"                              Version="0.4.2504.701" />          <!-- Bayesian inference framework for probabilistic graphical models -->
        <PackageVersion Include="Microsoft.ML.Probabilistic.Compiler"                     Version="0.4.2504.701" />          <!-- Inference engine compiling probabilistic models into efficient code -->
        <PackageVersion Include="Microsoft.ML.Probabilistic.Learners"                     Version="0.4.2504.701" />          <!-- Bayesian classifier and recommender learners with training and evaluation -->
        <PackageVersion Include="PeterO.Numbers"                                          Version="1.8.2" />                 <!-- Arbitrary-precision binary, decimal, and rational number arithmetic -->
        <PackageVersion Include="System.Numerics.Tensors"                                 Version="11.0.0-preview.7.26381.103" /> <!-- Tensor primitives with SIMD-accelerated span operations -->
        <PackageVersion Include="TYoshimura.DoubleDouble"                                 Version="5.0.8" />                 <!-- Double-double arithmetic with 106-bit mantissa and special functions -->
        <PackageVersion Include="TYoshimura.DoubleDouble.Complex"                         Version="2.0.1" />                 <!-- Complex number arithmetic over double-double precision values -->
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageVersion Include="AhoCorasick"                                             Version="2.0.279" />               <!-- Aho-Corasick multi-pattern string search with custom character comparison -->
        <PackageVersion Include="Akade.IndexedSet"                                        Version="1.5.0" />                 <!-- In-memory collection with unique, range, fuzzy, spatial, and vector indexes -->
        <PackageVersion Include="BitFaster.Caching"                                       Version="2.6.1" />                 <!-- Bounded concurrent caches with LRU, W-TinyLFU, and time-based eviction -->
        <PackageVersion Include="CardinalityEstimation"                                   Version="1.15.0" />                <!-- HyperLogLog cardinality estimator with sparse representation and lossless merging -->
        <PackageVersion Include="Cloud.Unum.USearch"                                      Version="2.26.2" />                <!-- Vector similarity search and clustering engine using HNSW indexes -->
        <PackageVersion Include="DotNext"                                                 Version="6.7.0" />                 <!-- Base class library extensions: value delegates, buffers, reflection helpers -->
        <PackageVersion Include="DotNext.IO"                                              Version="6.7.0" />                 <!-- Stream and pipe decoding and encoding helpers -->
        <PackageVersion Include="DotNext.Threading"                                       Version="6.7.0" />                 <!-- Async synchronization primitives: locks, events, barriers, and triggers -->
        <PackageVersion Include="DotNext.Unsafe"                                          Version="6.7.0" />                 <!-- Type-safe unmanaged memory allocators and pointer abstractions -->
        <PackageVersion Include="F23.StringSimilarity"                                    Version="7.0.1" />                 <!-- Edit distance, Jaro-Winkler, n-gram, cosine, and Jaccard string similarity metrics -->
        <PackageVersion Include="Fastenshtein"                                            Version="1.0.12" />                <!-- Allocation-free Levenshtein distance over strings and spans -->
        <PackageVersion Include="HNSW.Net"                                                Version="0.1.4" />                 <!-- Managed HNSW graph index with serialization and filtered search -->
        <PackageVersion Include="Jamarino.IntervalTree"                                   Version="1.2.2" />                 <!-- Augmented and centered interval trees for overlap and stabbing queries -->
        <PackageVersion Include="KTrie"                                                   Version="3.0.1" />                 <!-- Trie and trie dictionary with prefix, pattern, and longest-prefix lookup -->
        <PackageVersion Include="Levenshtypo"                                             Version="1.8.0" />                 <!-- Levenshtein automata over a trie for typo-tolerant dictionary lookup -->
        <PackageVersion Include="LoroCs"                                                  Version="1.13.9" />                <!-- CRDT collaborative document and data structure bindings -->
        <PackageVersion Include="Meziantou.Framework.BloomFilters"                        Version="2.0.3" />                 <!-- Bloom and counting Bloom filters with xxHash and CRC hashing -->
        <PackageVersion Include="OmniCollections.Probabilistic"                           Version="3.0.0" />                 <!-- Count-min sketch, HyperLogLog, and t-digest quantile estimators -->
        <PackageVersion Include="QuikGraph"                                               Version="2.5.0" />                 <!-- Graph data structures and algorithms: traversal, shortest paths, flows -->
        <PackageVersion Include="QuikGraph.Graphviz"                                      Version="2.5.0" />                 <!-- DOT serialization for graph structures -->
        <PackageVersion Include="QuikGraph.Petri"                                         Version="2.5.0" />                 <!-- Petri net construction and simulation -->
        <PackageVersion Include="QuikGraph.Serialization"                                 Version="2.5.0" />                 <!-- Graph structure serialization including GraphML -->
        <PackageVersion Include="RBush"                                                   Version="4.0.0" />                 <!-- Dynamic 2D R-tree spatial index with bulk loading and rectangle queries -->
        <PackageVersion Include="Roaring.Net"                                             Version="1.4.1" />                 <!-- Compressed bitmap integer sets with set algebra and portable serialization -->
        <PackageVersion Include="Supercluster.KDTree.Net"                                 Version="1.0.22" />                <!-- Immutable k-d tree for nearest-neighbor searches -->
        <PackageVersion Include="SuperLinq"                                               Version="6.4.1" />                 <!-- Sequence operators: windows, permutations, batching, scans, ranking, and tree traversal -->
        <PackageVersion Include="SuperLinq.Async"                                         Version="6.4.1" />                 <!-- Asynchronous sequence operators over async enumerables -->
        <PackageVersion Include="SwiftCollections.Lean"                                   Version="7.0.0" />                 <!-- Low-allocation collections, sparse sets, handle buckets, and BVH, octree, spatial hash queries -->
        <PackageVersion Include="Ulid"                                                    Version="1.4.1" />                 <!-- ULID struct with monotonic generation, span parsing, and binary formatting -->
        <PackageVersion Include="YDotNet"                                                 Version="0.6.0" />                 <!-- Yrs CRDT bindings with shared types, state vectors, and update exchange -->
        <PackageVersion Include="YDotNet.Native.Linux"                                    Version="0.6.0" />                 <!-- Linux native binaries for the Yrs runtime -->
        <PackageVersion Include="YDotNet.Native.MacOS"                                    Version="0.6.0" />                 <!-- macOS native binaries for the Yrs runtime -->
        <PackageVersion Include="YDotNet.Native.Win32"                                    Version="0.6.0" />                 <!-- Windows native binaries for the Yrs runtime -->
        <PackageVersion Include="ZLinq"                                                   Version="1.5.6" />                 <!-- Zero-allocation LINQ over spans and trees with SIMD-vectorized aggregates -->
        <PackageVersion Include="ZLinq.DropInGenerator"                                   Version="1.5.6" />                 <!-- Source generator routing standard LINQ calls through zero-allocation operators -->
    </ItemGroup>

    <ItemGroup Label="Solvers">
        <PackageVersion Include="BepuPhysics"                                             Version="2.5.0-beta.29" />         <!-- SIMD rigid body dynamics with constraint solver, collision detection, and sweeps -->
        <PackageVersion Include="Ceres"                                                   Version="0.9.51" />                <!-- Nonlinear least squares with automatic differentiation, robust losses, and sparse solvers -->
        <PackageVersion Include="GeneticSharp"                                            Version="3.1.4" />                 <!-- Multithreaded genetic algorithm library with extensible operators -->
        <PackageVersion Include="Google.OrTools"                                          Version="9.15.6755" />             <!-- Operations research toolkit: linear, constraint, and vehicle routing solvers -->
        <PackageVersion Include="Highs.Native"                                            Version="1.15.1" />                <!-- Simplex, interior-point, and branch-and-cut solver for linear, mixed-integer, and convex quadratic programs -->
        <PackageVersion Include="JClement.NLoptNet"                                       Version="2.10.1" />                <!-- Local and global nonlinear optimization with bound, equality, and inequality constraints -->
        <PackageVersion Include="Kiwi"                                                    Version="3.0.0" />                 <!-- Cassowary incremental linear constraint solving with strengths and edit variables -->
        <PackageVersion Include="OPTANO.Modeling"                                         Version="3.30.0.683" />            <!-- Algebraic modeling layer for linear and mixed-integer programs with solver adapters -->
        <PackageVersion Include="Pagmo.NET"                                               Version="1.0.0" />                 <!-- Metaheuristic and gradient-based optimization with multithreaded parallel evolution -->
        <PackageVersion Include="Pagmo.NET.Ipopt"                                         Version="1.0.0" />                 <!-- Interior-point nonlinear solver plugin -->
        <PackageVersion Include="Rasm.Native.Z3"                                          Version="5.0.0" />                 <!-- SMT solver shared library staged per runtime identifier -->
        <PackageVersion Include="Rasm.Z3"                                                 Version="5.0.0" />                 <!-- SMT solver managed bindings built from pinned sources -->
        <PackageVersion Include="SolveSpace"                                              Version="3.2.1-preview" />         <!-- Parametric 2D and 3D geometric constraint solving over sketch entities -->
    </ItemGroup>

    <ItemGroup Label="Geometry">
        <PackageVersion Include="CavalierContours"                                        Version="2.0.0" />                 <!-- 2D polyline offsetting and boolean operations with arc support -->
        <PackageVersion Include="CDT.NET"                                                 Version="1.1.0" />                 <!-- Constrained and conforming Delaunay triangulation with hole detection -->
        <PackageVersion Include="Clipper2"                                                Version="2.0.0" />                 <!-- Polygon boolean operations and offsetting -->
        <PackageVersion Include="Delaunator"                                              Version="1.0.11" />                <!-- Delaunay triangulation of 2D points -->
        <PackageVersion Include="Evergine.Bindings.MeshOptimizer"                         Version="2026.8.3.18" />           <!-- Bindings for vertex cache optimization, simplification, and mesh compression -->
        <PackageVersion Include="GeometRi"                                                Version="1.5.0.8" />               <!-- 3D geometry primitives with transformations, distances, and intersections -->
        <PackageVersion Include="ManifoldRust"                                            Version="0.5.0" />                 <!-- Mesh boolean kernel bindings over the Rust port -->
        <PackageVersion Include="MeshLib"                                                 Version="3.1.3.429" />             <!-- 3D mesh processing: booleans, repair, offsetting, simplification, triangulation -->
        <PackageVersion Include="MIConvexHull"                                            Version="1.1.19.1019" />           <!-- Convex hull, Delaunay triangulation, and Voronoi computation in arbitrary dimensions -->
        <PackageVersion Include="PicoGK"                                                  Version="2.3.0" />                 <!-- Compact voxel-based geometry kernel for computational engineering -->
        <PackageVersion Include="Rasm.Gmsh"                                               Version="4.15.2" />                <!-- Finite element mesh generator bindings generated from the pinned API definition -->
        <PackageVersion Include="Rasm.Native.Gmsh"                                        Version="4.15.2" />                <!-- Finite element mesh generator shared library staged per runtime identifier -->
        <PackageVersion Include="RectangleBinPack.CSharp"                                 Version="1.0.4" />                 <!-- Rectangle bin packing with MaxRects, Skyline, Guillotine, and Shelf heuristics -->
        <PackageVersion Include="SharpVoronoiLib"                                         Version="1.2.0" />                 <!-- Fortune's algorithm Voronoi tessellation with border closure and relaxation -->
    </ItemGroup>

    <ItemGroup Label="Point Clouds">
        <PackageVersion Include="Aardvark.Data.E57"                                       Version="5.6.3" />                 <!-- E57 point cloud file format parser -->
        <PackageVersion Include="Aardvark.Data.Points.Base"                               Version="5.6.3" />                 <!-- Shared chunked import infrastructure for point cloud formats -->
        <PackageVersion Include="Aardvark.Geometry.Normals"                               Version="5.6.3" />                 <!-- Normal estimation for point clouds via k-d tree neighborhoods -->
        <PackageVersion Include="Aardvark.Geometry.PointSet"                              Version="5.6.3" />                 <!-- Out-of-core point cloud data structure and queries -->
        <PackageVersion Include="Aardvark.Geometry.PointTree"                             Version="5.6.3" />                 <!-- Spatial k-d tree structure for closest-point queries on point sets -->
        <PackageVersion Include="Altemiq.IO.Las"                                          Version="1.5.0" />                 <!-- Low-allocation reading and writing of LAS point streams -->
        <PackageVersion Include="Altemiq.IO.Las.Arrow"                                    Version="1.5.0" />                 <!-- Apache Arrow record batch conversion for LAS point clouds -->
        <PackageVersion Include="Altemiq.IO.Las.Cloud"                                    Version="1.5.0" />                 <!-- Cloud-optimized point cloud COPC hierarchy support -->
        <PackageVersion Include="Altemiq.IO.Las.Compression"                              Version="1.5.0" />                 <!-- LAZ compressed point cloud reading and writing -->
        <PackageVersion Include="Altemiq.IO.Las.Geodesy"                                  Version="1.5.0" />                 <!-- Coordinate reference system records via proj database lookup -->
        <PackageVersion Include="Altemiq.IO.Las.Indexing"                                 Version="1.5.0" />                 <!-- Spatial indexing of point cloud files for windowed reads -->
        <PackageVersion Include="Altemiq.IO.Las.S3"                                       Version="1.5.0" />                 <!-- Streaming point cloud reads from Amazon object storage -->
        <PackageVersion Include="Ply.Net"                                                 Version="5.6.3" />                 <!-- Polygon File Format mesh and point cloud parser -->
        <PackageVersion Include="Unofficial.laszip.netstandard"                           Version="5.6.3" />                 <!-- Compressed LiDAR codec ported to C# -->
    </ItemGroup>

    <ItemGroup Label="Geospatial">
        <PackageVersion Include="Azure.Analytics.PlanetaryComputer"                       Version="1.0.0" />                 <!-- STAC catalog search, ingestion, and tiling client for Planetary Computer -->
        <PackageVersion Include="bertt.CityJSON"                                          Version="2.5.0" />                 <!-- CityJSON city model file reading and writing -->
        <PackageVersion Include="CdIts.NetTopologySuite.IO.GeoPackage.Features"           Version="3.4.2" />                 <!-- GeoPackage feature layer reading and writing as OGC features -->
        <PackageVersion Include="CesiumLanguageWriter"                                    Version="3.3.0" />                 <!-- CZML scene description writing for globe visualization -->
        <PackageVersion Include="CoordinateSharp"                                         Version="3.5.1.1" />               <!-- Coordinate parsing, UTM, MGRS, ECEF, and Web Mercator conversion with sun and moon times -->
        <PackageVersion Include="CosineKitty.AstronomyEngine"                             Version="2.1.19" />                <!-- Sun, Moon, and planet positions with rise, set, phase, and eclipse prediction -->
        <PackageVersion Include="DEM.Net.Core"                                            Version="8.0.1" />                 <!-- Digital elevation model retrieval, elevation queries, and terrain meshes -->
        <PackageVersion Include="DEM.Net.glTF"                                            Version="8.0.1" />                 <!-- Terrain model export from elevation data -->
        <PackageVersion Include="FlatGeobuf"                                              Version="3.26.0" />                <!-- Binary geographic feature format encoding based on flatbuffers -->
        <PackageVersion Include="Geo"                                                     Version="3.0.0" />                 <!-- Geographic geometry, GPS file formats, geodetic and geomagnetic calculations -->
        <PackageVersion Include="Geo.ArcGIS"                                              Version="3.0.0-alpha.4" />         <!-- Address candidate search and geocoding through the ArcGIS API -->
        <PackageVersion Include="Geo.Core"                                                Version="3.0.0-alpha.4" />         <!-- Provider-neutral geocoding client abstractions with dependency injection registration -->
        <PackageVersion Include="Geo.Google"                                              Version="3.0.0-alpha.4" />         <!-- Geocoding, places, and autocomplete through the Google API -->
        <PackageVersion Include="Geo.Here"                                                Version="3.0.0-alpha.4" />         <!-- Geocoding, discover, browse, and lookup through the HERE API -->
        <PackageVersion Include="Geo.MapBox"                                              Version="3.0.0-alpha.4" />         <!-- Forward and reverse geocoding through the Mapbox API -->
        <PackageVersion Include="Geo.OpenRouteService"                                    Version="3.0.0-alpha.4" />         <!-- Forward and reverse geocoding through the openrouteservice API -->
        <PackageVersion Include="GeographicLib.NET"                                       Version="2.3.2" />                 <!-- Geodesics, projections, UTM and MGRS conversion, geoid, gravity, and magnetic models -->
        <PackageVersion Include="geohash-dotnet"                                          Version="3.0.0" />                 <!-- Geohash encoding, decoding, and neighbor computation -->
        <PackageVersion Include="GeoTimeZone"                                             Version="6.1.0" />                 <!-- IANA time zone lookup from latitude and longitude -->
        <PackageVersion Include="GISBlox.IO.GeoParquet"                                   Version="1.1.1" />                 <!-- GeoParquet columnar geospatial file reading and writing -->
        <PackageVersion Include="Gml4Net"                                                 Version="0.3.0" />                 <!-- GML 2 to 3.3 parsing with WFS, WCS, and OWS response models and streaming -->
        <PackageVersion Include="Gml4Net.IO"                                              Version="0.3.0" />                 <!-- File and HTTP streaming input for GML documents -->
        <PackageVersion Include="GoogleMapsApi"                                           Version="2.6.0" />                 <!-- Google Maps web service clients: geocoding, routes, elevation, time zone, solar, places -->
        <PackageVersion Include="GribSharp.Core"                                          Version="1.0.16" />                <!-- GRIB2 decoding with simple, complex, and IEEE packing templates and validation -->
        <PackageVersion Include="GribSharp.Jpeg2000"                                      Version="1.0.16" />                <!-- JPEG 2000 packed field decoding for GRIB2 -->
        <PackageVersion Include="mapbox-vector-tile"                                      Version="5.3.1" />                 <!-- Vector tile encoding and decoding for map features -->
        <PackageVersion Include="MaxRev.Gdal.CLI.linux-x64"                               Version="3.13.3.557" />            <!-- GDAL command-line tools for Linux x64 with library and data path setup -->
        <PackageVersion Include="MaxRev.Gdal.CLI.osx-arm64"                               Version="3.13.3.557" />            <!-- GDAL command-line tools for Apple silicon with library and data path setup -->
        <PackageVersion Include="MaxRev.Gdal.CLI.win-x64"                                 Version="3.13.3.557" />            <!-- GDAL command-line tools for Windows x64 with library and data path setup -->
        <PackageVersion Include="MaxRev.Gdal.Core"                                        Version="3.13.3.557" />            <!-- GDAL raster, OGR vector, and OSR coordinate reference bindings -->
        <PackageVersion Include="MaxRev.Gdal.LinuxRuntime.Minimal"                        Version="3.13.3.557" />            <!-- Native GDAL, PROJ, and GEOS libraries for Linux runtimes -->
        <PackageVersion Include="MaxRev.Gdal.MacosRuntime.Minimal.arm64"                  Version="3.13.3.557" />            <!-- Native GDAL, PROJ, and GEOS libraries for Apple silicon -->
        <PackageVersion Include="MaxRev.Gdal.WindowsRuntime.Minimal"                      Version="3.13.3.557" />            <!-- Native GDAL, PROJ, and GEOS libraries for Windows x64 -->
        <PackageVersion Include="NetTopologySuite"                                        Version="2.6.0" />                 <!-- Planar geometry model with OGC simple features operations -->
        <PackageVersion Include="NetTopologySuite.IO.Esri.Shapefile"                      Version="1.2.0" />                 <!-- Forward-only shapefile readers and writers -->
        <PackageVersion Include="NetTopologySuite.IO.GeoJSON4STJ"                         Version="4.0.0" />                 <!-- GeoJSON serialization of geometries and features -->
        <PackageVersion Include="NetTopologySuite.IO.VectorTiles"                         Version="1.1.0" />                 <!-- Vector tile writing for geometries and features -->
        <PackageVersion Include="NetTopologySuite.IO.VectorTiles.GeoJson"                 Version="1.1.0" />                 <!-- Tile output of features as GeoJSON documents -->
        <PackageVersion Include="NetTopologySuite.IO.VectorTiles.Mapbox"                  Version="1.1.0" />                 <!-- Protobuf vector tile encoding -->
        <PackageVersion Include="Nominatim.API"                                           Version="2.1.0" />                 <!-- Forward and reverse geocoding client for OpenStreetMap services -->
        <PackageVersion Include="OgcApi.Net"                                              Version="3.0.1" />                 <!-- OGC API Features, Tiles, Schemas, and Styles server for ASP.NET Core -->
        <PackageVersion Include="OgcApi.Net.MbTiles"                                      Version="3.0.1" />                 <!-- MBTiles vector tile provider for the OGC API server -->
        <PackageVersion Include="OgcApi.Net.PostGis"                                      Version="3.0.1" />                 <!-- PostGIS feature provider for the OGC API server -->
        <PackageVersion Include="OgcApi.Net.SpatiaLite"                                   Version="3.0.1" />                 <!-- SpatiaLite feature provider for the OGC API server -->
        <PackageVersion Include="OsmSharp"                                                Version="7.0.0-pre027" />          <!-- OpenStreetMap data reading, writing, and filtering across PBF and XML -->
        <PackageVersion Include="OsmSharp.Geo"                                            Version="7.0.0-pre027" />          <!-- OpenStreetMap feature conversion into OGC geometries -->
        <PackageVersion Include="OsmSharp.IO.API"                                         Version="1.0.5" />                 <!-- OpenStreetMap API client for reading and editing map data with OAuth2 -->
        <PackageVersion Include="pocketken.H3"                                            Version="4.5.0.1" />               <!-- Hexagonal hierarchical geospatial indexing with polygon support -->
        <PackageVersion Include="ProjNET"                                                 Version="2.1.0" />                 <!-- Coordinate transformations between geodetic and projected reference systems -->
        <PackageVersion Include="quantized-mesh-tile"                                     Version="0.5.0" />                 <!-- Terrain height mesh tile decoding and encoding -->
        <PackageVersion Include="SharpKml.Core"                                           Version="6.1.0" />                 <!-- KML and KMZ file reading and writing -->
        <PackageVersion Include="tilebelt"                                                Version="2.0.1" />                 <!-- Map tile utilities: bounding boxes, parents, children, quadkeys -->
    </ItemGroup>

    <ItemGroup Label="Digital Fabrication">
        <PackageVersion Include="DSTV.Net"                                                Version="1.3.0" />                 <!-- Steel part NC file parsing with SVG visualization -->
        <PackageVersion Include="Motus.Core"                                              Version="0.13.2" />                <!-- Host-agnostic motion planning core: models, planners, retiming, and export -->
        <PackageVersion Include="Motus.Geometry"                                          Version="0.13.2" />                <!-- Serial-chain kinematics, sphere collision, and Cartesian motion planners -->
        <PackageVersion Include="Motus.Native"                                            Version="0.13.2" />                <!-- Native interop bindings for OMPL planning and FCL collision -->
        <PackageVersion Include="Motus.OMPL.Native"                                       Version="0.13.2" />                <!-- C ABI stub library for optional native sampling planners -->
        <PackageVersion Include="Motus.OMPL.NET"                                          Version="0.13.2" />                <!-- Sampling-based motion planner adapter with managed fallback -->
        <PackageVersion Include="Motus.Presets"                                           Version="0.13.2" />                <!-- JSON robot presets and URDF loading with bundled defaults -->
        <PackageVersion Include="MTConnect.NET-Common"                                    Version="7.0.0.2-prerelease" />    <!-- Core machine tool protocol data models -->
        <PackageVersion Include="MTConnect.NET-DeviceFinder"                              Version="7.0.0.2-prerelease" />    <!-- Network discovery of machine tool protocol devices -->
        <PackageVersion Include="MTConnect.NET-HTTP"                                      Version="7.0.0.2-prerelease" />    <!-- HTTP transport for agents and clients -->
        <PackageVersion Include="MTConnect.NET-JSON"                                      Version="7.0.0.2-prerelease" />    <!-- JSON document format for protocol data -->
        <PackageVersion Include="MTConnect.NET-MQTT"                                      Version="7.0.0.2-prerelease" />    <!-- MQTT transport for agents and clients -->
