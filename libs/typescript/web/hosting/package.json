{
    "name": "@rasm/hosting",
    "private": true,
    "description": "One web app served the same on edge and server runtimes",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./authentication": "./authentication/index.ts",
        "./client": "./client/index.ts",
        "./cloudflare": "./cloudflare/worker.ts",
        "./node": "./node/index.ts",
        "./worker-config": "./worker-config.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@aws-sdk/s3-request-presigner": "catalog:",
        "@effect/platform-node": "catalog:",
        "cheerio": "catalog:",
        "effect": "catalog:",
        "jose": "catalog:",
        "partial-content": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:",
        "@effect/vitest": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "cf": "catalog:",
        "testcontainers": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "test": {
                "options": {
                    "args": [ "--project=!s3" ]
                }
            },
            "test:integration": {
                "options": {
                    "args": [ "--project=s3" ]
                }
            }
        }
    }
}
