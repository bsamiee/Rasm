{
    "name": "rasm",
    "private": true,
    "description": "Repository Node tooling",
    "repository": "https://github.com/bsamiee/Rasm",
    "license": "MIT",
    "author": "Bardia Samiee",
    "type": "module",
    "imports": { "#/*": "./*" },
    "scripts": {
        "postinstall": "node --input-type=module --eval \"import { mkdirSync, rmSync, symlinkSync } from 'node:fs'; import { dirname } from 'node:path'; import getExePath from '@effect/tsgo/lib/getExePath'; const sdk = dirname(getExePath()); const link = '.cache/typescript'; mkdirSync(dirname(link), { recursive: true }); rmSync(link, { force: true }); symlinkSync(sdk, link, 'junction');\""
    },
    "devDependencies": {
        "@ast-grep/napi": "catalog:",
        "@aws-sdk/client-s3": "catalog:",
        "@biomejs/biome": "catalog:",
        "@cloudflare/vitest-plugin": "catalog:",
        "@effect/atom-react": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/sql-d1": "catalog:",
        "@effect/sql-pg": "catalog:",
        "@effect/sql-sqlite-node": "catalog:",
        "@effect/tsgo": "catalog:",
        "@effect/vitest": "catalog:",
        "@nx/dotnet": "catalog:",
        "@playwright/test": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/database": "workspace:*",
        "@rasm/eng": "workspace:*",
        "@rasm/hosting": "workspace:*",
        "@rasm/test-support": "workspace:*",
        "@rasm/ui": "workspace:*",
        "@storybook/addon-docs": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@testcontainers/postgresql": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/browser": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "actions-up": "catalog:",
        "axe-core": "catalog:",
        "bootstrap-icons": "catalog:",
        "cf": "catalog:",
        "dependency-cruiser": "catalog:",
        "effect": "catalog:",
        "json5": "catalog:",
        "jszip": "catalog:",
        "npm-check-updates": "catalog:",
        "nx": "catalog:",
        "partial-content": "catalog:",
        "playwright": "catalog:",
        "react": "catalog:",
        "react-aria-components": "catalog:",
        "react-dom": "catalog:",
        "sharp": "catalog:",
        "storybook": "catalog:",
        "testcontainers": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-react": "catalog:"
    },
    "packageManager": "pnpm@12.18.0"
}
