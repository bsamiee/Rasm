{
    "name": "@rasm/applications",
    "private": true,
    "description": "Client of a Mac application server, its wire schemas in the root entry, and the build of a Node helper a Mac application embeds",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./node": "./node.ts",
        "./vite": "./vite.ts"
    },
    "dependencies": {
        "@rasm/search": "workspace:*",
        "effect": "catalog:",
        "plist": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@effect/vitest": "catalog:",
        "@types/node": "catalog:",
        "vitest": "catalog:"
    }
}
