<Project>
    <PropertyGroup Label="Artifacts Output">
        <ArtifactsPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '.artifacts', 'dotnet'))</ArtifactsPath>
    </PropertyGroup>

    <PropertyGroup Label="Package Metadata">
        <Authors>Bardia Samiee</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/bsamiee/Rasm</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IsPackable>false</IsPackable>
        <IsPublishable>false</IsPublishable>
        <DeterministicTimestamp>2000-01-01T00:00:00Z</DeterministicTimestamp> <!-- One instant for every entry of a package: NuGet otherwise stamps each entry with its file time, and two packs of one input differ -->
    </PropertyGroup>

    <PropertyGroup Label="Source Control">
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion> <!-- Compiled output follows its hashed inputs, a commit alone recompiles nothing -->
        <EnableSourceLink>false</EnableSourceLink>
        <EmbedAllSources>true</EmbedAllSources> <!-- Debuggers read sources from the PDB in place of commit-pinned SourceLink URLs -->
    </PropertyGroup>

    <PropertyGroup Label="Package Licenses">
        <SixLaborsLicenseFile>$(MSBuildThisFileDirectory).config/licenses/sixlabors.lic</SixLaborsLicenseFile>
    </PropertyGroup>

    <PropertyGroup Label="Target Framework">
        <RepoTargetFramework>net10.0</RepoTargetFramework> <!-- Runtime Rhino 9 ships, which every library a Rhino product loads targets -->
        <TargetFramework>$(RepoTargetFramework)</TargetFramework>
        <RollForward>Major</RollForward>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <PropertyGroup Label="Compiler">
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Label="Diagnostics">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <MeziantouAnalysisMode>all-errors</MeziantouAnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup Label="Diagnostics">
        <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory).config/.globalconfig" />
    </ItemGroup>

    <PropertyGroup Label="Configurations">
        <Configurations>Release</Configurations>
        <Configuration>Release</Configuration>
    </PropertyGroup>

    <PropertyGroup Label="Restore">
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <DisableImplicitAssetTargetFallback>true</DisableImplicitAssetTargetFallback>
    </PropertyGroup>

    <PropertyGroup Label="Build Output">
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
    </PropertyGroup>

    <Import Project="libs/dotnet/rhino/Rasm.Rhino/buildTransitive/Rasm.Rhino.props" Condition="'$(RhinoHost)' != ''" />

    <PropertyGroup Label="Continuous Integration" Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <RestoreLockedMode>true</RestoreLockedMode>
        <UseSharedCompilation>false</UseSharedCompilation>
    </PropertyGroup>
</Project>
