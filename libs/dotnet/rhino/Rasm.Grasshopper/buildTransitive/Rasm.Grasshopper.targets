<Project>
    <PropertyGroup Label="Grasshopper Plug-In">
        <_GrasshopperShell>$(IntermediateOutputPath)$(TargetName).Grasshopper$(TargetExt)</_GrasshopperShell>
        <_GrasshopperShellAttributes>$(IntermediateOutputPath)$(TargetName).Grasshopper.AssemblyInfo.cs</_GrasshopperShellAttributes>
    </PropertyGroup>

    <ItemGroup Label="Grasshopper Icons">
        <EmbeddedResource Include="icons/*.ghicon" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="BuildGrasshopperShell" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '@(ReferencePath->WithMetadataValue('Filename', 'Rasm.Grasshopper'))' != ''" Inputs="@(IntermediateAssembly);@(ReferencePath);@(Analyzer);@(EditorConfigFiles);$(MSBuildThisFileDirectory)PluginInfo.cs;$(MSBuildAllProjects)" Outputs="$(_GrasshopperShell)">
        <ItemGroup>
            <_PlugInIdentity Include="@(AssemblyAttribute->WithMetadataValue('Identity', 'System.Runtime.InteropServices.GuidAttribute')->Metadata('_Parameter1'))" />
        </ItemGroup>
        <PropertyGroup>
            <_GrasshopperShellHash>$([MSBuild]::StableStringHash(`@(_PlugInIdentity)`, 'Sha256'))</_GrasshopperShellHash>
            <_GrasshopperShellId>$(_GrasshopperShellHash.Substring(0, 8))-$(_GrasshopperShellHash.Substring(8, 4))-$(_GrasshopperShellHash.Substring(12, 4))-$(_GrasshopperShellHash.Substring(16, 4))-$(_GrasshopperShellHash.Substring(20, 12))</_GrasshopperShellId>
        </PropertyGroup>
        <ItemGroup>
            <_GrasshopperShellConfig Include="@(EditorConfigFiles);$([MSBuild]::GetPathOfFileAbove('.editorconfig', '$(MSBuildThisFileDirectory)'))" />
            <_GrasshopperShellAttribute Include="@(AssemblyAttribute)" Exclude="System.Runtime.InteropServices.GuidAttribute;Rhino.PlugIns.PlugInDescriptionAttribute" />
            <_GrasshopperShellAttribute Include="System.Runtime.InteropServices.GuidAttribute"><_Parameter1>$(_GrasshopperShellId)</_Parameter1></_GrasshopperShellAttribute>
        </ItemGroup>
        <WriteCodeFragment Language="C#" AssemblyAttributes="@(_GrasshopperShellAttribute)" OutputFile="$(_GrasshopperShellAttributes)" />
        <Csc Sources="$(MSBuildThisFileDirectory)PluginInfo.cs;$(_GrasshopperShellAttributes);$(TargetFrameworkMonikerAssemblyAttributesPath)" References="@(ReferencePath);@(IntermediateAssembly)" Analyzers="@(Analyzer)" AnalyzerConfigFiles="@(_GrasshopperShellConfig->Distinct())" OutputAssembly="$(_GrasshopperShell)" TargetType="Library" LangVersion="$(LangVersion)" Nullable="$(Nullable)" Deterministic="true" Optimize="true" NoConfig="true" NoStandardLib="true" NoLogo="true" DisabledWarnings="$(NoWarn)" TreatWarningsAsErrors="$(TreatWarningsAsErrors)" ToolExe="$(CscToolExe)" ToolPath="$(CscToolPath)" UseSharedCompilation="$(UseSharedCompilation)" />
        <ItemGroup>
            <FileWrites Include="$(_GrasshopperShell);$(_GrasshopperShellAttributes)" />
            <ContentWithTargetPath Include="$(_GrasshopperShell)" TargetPath="$(TargetName).Grasshopper$(TargetExt)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>
</Project>
