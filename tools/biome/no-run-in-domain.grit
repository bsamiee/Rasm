language js(typescript, jsx)

or {
    `Effect.runSync($_)`,
    `Effect.runSyncExit($_)`,
    `Effect.runPromise($_)`,
    `Effect.runPromiseExit($_)`,
    `Effect.runFork($_)`,
    `Effect.runCallback($_)`
} as $hit where {
    register_diagnostic(span=$hit, message="Effect executed inside library code. Libraries return effects and Layers on the R channel. The app entry owns the run call.", severity="error")
}
