# --- [DIAGNOSTIC_SEVERITY] --------------------------------------------------------------

dotnet_analyzer_diagnostic.severity = error
dotnet_diagnostic.CS8524.severity = none # Fix adds a catch-all arm, `RASM3002` and `RASM3004` refuse it
dotnet_diagnostic.CS9236.severity = error

# --- [DOTNET_ANALYZERS] -----------------------------------------------------------------

# --- [SEVERITY]

dotnet_diagnostic.CA1000.severity = none # Moves factories off their generic type, CLAUDE.md keeps them with it
dotnet_diagnostic.CA1021.severity = error
dotnet_diagnostic.CA1034.severity = none # Flags Thinktecture union cases, nested in their type
dotnet_diagnostic.CA1045.severity = error
dotnet_diagnostic.CA1062.severity = none # Nullable reference types state validated arguments
dotnet_diagnostic.CA1516.severity = error
dotnet_diagnostic.CA1715.severity = none # Type parameters follow LanguageExt naming (`A`, `RT`)
dotnet_diagnostic.CA1716.severity = none # Guards keywords of other CLR languages, solution is C# alone
dotnet_diagnostic.CA1720.severity = none # Names (`Int`, `Object`) tag host value kinds
dotnet_diagnostic.CA1724.severity = none # Flags names other packages' namespaces hold, renames coin names

# --- [OPTIONS]

dotnet_code_quality.CA1003.api_surface = all
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_constructor = true
dotnet_code_quality.CA2241.additional_string_formatting_methods = M:Rasm.Rhino.LocalText.Of(System.String,System.ReadOnlySpan{System.Object})

# --- [IDE_ANALYZERS] --------------------------------------------------------------------

dotnet_diagnostic.IDE0055.severity = none # hk step `dotnet-format` checks whitespace file by file
dotnet_diagnostic.IDE0058.severity = none # Fix assigns each unused expression value to `_`, a discard the code never writes
dotnet_diagnostic.IDE0072.severity = none # Demands a `_` arm on exhaustive switches, `RASM3002` refuses it

