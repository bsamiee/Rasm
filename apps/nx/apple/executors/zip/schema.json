{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": 2,
    "type": "object",
    "properties": {
        "exports": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "archive": {
                        "type": "string"
                    },
                    "folder": {
                        "type": "string"
                    },
                    "method": {
                        "type": "string"
                    }
                },
                "required": [ "archive", "folder" ],
                "additionalProperties": true
            }
        },
        "products": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "package": {
                        "type": "string"
                    },
                    "product": {
                        "type": "string"
                    },
                    "folder": {
                        "type": "string"
                    },
                    "manifest": {
                        "type": "string"
                    }
                },
                "required": [ "package", "product", "folder", "manifest" ],
                "additionalProperties": true
            }
        },
        "profile": {
            "type": "string",
            "description": "notarytool keychain profile from the plugin's notaryProfile option, required by archives with a method"
        },
        "args": {
            "type": "array",
            "description": "Arguments appended to notarytool submit, else to ditto",
            "items": {
                "type": "string"
            }
        }
    },
    "additionalProperties": true,
    "title": "Zip",
    "description": "Zips each archived app and each SwiftPM executable product's release build with ditto; an archive with a method is exported with it first, notarized with notarytool, stapled, and zipped again"
}
