        }
        var left = differences(rows);
        for (var j = 0; j < left.length; j++) { leaked.push("app." + left[j].member + " reads " + codec.json(left[j].after)); }
        return leaked;
    }
    function keyOf(doc) { return String(doc.fullName); }
    function keys() {
        var list = [];
        for (var i = 0; i < realApp.documents.length; i++) { list.push(keyOf(realApp.documents[i])); }
        return list;
    }

    // --- [APP]
    function fakeDocuments(session, refresh) {
        var real = realApp.documents;
        function made(doc) {
            session.documents.push(doc);
            refresh();
            return doc;
        }
        var list = {
            typename: real.typename,
            parent: real.parent,
            add: function () { return made(real.add.apply(real, arguments)); },
            addDocument: function (preset, settings) { return made(real.addDocument(preset, settings, false)); },
            addDocumentWithDialogOption: function (preset) { return made(real.addDocumentWithDialogOption(preset, false)); },
            getByName: function (name) { return real.getByName(name); },
