{
    "name": "@rasm/nx-cmake",
    "version": "0.0.0",
    "description": "Nx plugin inferring CMake projects, targets, and dependency edges from the file API reply of one configured build tree per workflow preset, with clang-tidy checks, CTest runs, and CPack archives",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/cmake"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json" ],
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    },
    "executors": "./executors.json"
}
