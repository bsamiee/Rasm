// --- [XCODE] ---------------------------------------------------------------------------

// --- [COMPILATION_CACHE]

COMPILATION_CACHE_ENABLE_CACHING = YES

// --- [OPTIMIZATION]

SWIFT_OPTIMIZATION_LEVEL[config=Release] = -Osize

// --- [APP_INTENTS_METADATA]

LM_SKIP_METADATA_EXTRACTION = YES

// --- [DEPLOYMENT]

MACOSX_DEPLOYMENT_TARGET = 27.0

// --- [TESTING]

TREAT_MISSING_BASELINES_AS_TEST_FAILURES = YES
