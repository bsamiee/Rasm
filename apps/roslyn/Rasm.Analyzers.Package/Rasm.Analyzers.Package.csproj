<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Roslyn analyzers and code fixes holding C# to functional form over LanguageExt, Thinktecture, RhinoCommon, Eto, and Microsoft.Extensions.Logging, every rule an error</Description>
        <PackageId>Rasm.Analyzers</PackageId>
        <PackageTags>roslyn;analyzers;languageext;thinktecture;rhinocommon;eto</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssemblies</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../Rasm.Analyzers.Diagnostics/Rasm.Analyzers.Diagnostics.csproj;../Rasm.Analyzers.CodeFixes/Rasm.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" OutputItemType="AnalyzerAssembly" />
    </ItemGroup>

    <ItemGroup Label="Package Files">
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="build/*.props" Pack="true" PackagePath="build/" />
    </ItemGroup>

    <Target Name="GetAnalyzerAssemblies" BeforeTargets="GetTargetPath" DependsOnTargets="ResolveProjectReferences;GetTargetPathWithTargetPlatformMoniker">
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker Remove="@(TargetPathWithTargetPlatformMoniker)" />
            <TargetPathWithTargetPlatformMoniker Include="@(AnalyzerAssembly)" />
        </ItemGroup>
    </Target>

    <Target Name="PackAnalyzerAssemblies" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(AnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>
</Project>
