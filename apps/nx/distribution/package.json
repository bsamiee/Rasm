{
    "name": "@rasm/nx-distribution",
    "version": "0.0.0",
    "description": "Nx plugin installing and publishing host packages (Blender extensions, Yak packages, Adobe UXP and CEP plug-ins) through each host's own channel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/distribution"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugins/project-graph.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    },
    "executors": "./executors.json"
}
