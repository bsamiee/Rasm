    { "path": "../../../../.artifacts/apps/creative-cloud/atelier/swc.darwin-arm64.node", "target-membership": [ { "build-phase": "Atelier/copy/Embed Server Addons", "code-sign-on-copy": true } ] },
    { "path": "../../../../.artifacts/apps/creative-cloud/atelier/LaunchAgents", "target-membership": [ "Atelier/copy/Embed Server Agent" ] },
    { "path": "<PROJECT>/../../../../Xcode.xcconfig" },
    {
      "kind": "folder",
      "path": ".",
      "target-membership": [
        "Atelier",
      ],
      "membership-exceptions": [
        {
          "target": "Atelier",
          "exclusions": [
            "Info.plist",
            "buildServer.json",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Atelier.app", "id": "DF819D1F3089FBAF00B8A072", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Atelier",
      "id": "DF819D1E3089FBAF00B8A072",
      "product": "Products/Atelier.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Server",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        }, {
          "kind": "copy",
          "name": "Embed Server Addons",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Server Agent",
          "bundle-base-path": "contents-directory",
          "relative-path": "Library",
        },
      ],
      "package-product-members": [
        {
          "package": "..",
          "product-name": "AppleEvents",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Applications",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "CurrentProcess",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Encoding",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "JSONRPC",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "..",
          "product-name": "Results",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "AUTOMATION_APPLE_EVENTS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSBackgroundOnly": "YES",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Atelier runs scripting commands in Adobe apps when an MCP client requests them.",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.rasm.atelier",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    },
  ],
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
