{
    "name": "@rasm/typography",
    "private": true,
    "description": "OpenType typesetting, from font faces to composed text",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./shaping": "./shaping/index.ts"
    },
    "dependencies": {
        "@rasm/search": "workspace:*",
        "fontkit": "catalog:",
        "harfbuzzjs": "catalog:",
        "icu": "catalog:"
    },
    "devDependencies": {
        "@types/fontkit": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    }
}
