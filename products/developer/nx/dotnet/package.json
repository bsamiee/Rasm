{
    "name": "@rasm/nx-dotnet",
    "version": "0.1.0",
    "description": "Nx plugin inferring MSBuild projects, their restores, builds, checks, tests, fixes, and NuGet releases from one MSBuild evaluation of the workspace",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/dotnet"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "analyzer/dist",
        "executors.json",
        "executors/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#analyzer": "./analyzer/dist/MsbuildAnalyzer.dll",
        "#package": "./package.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#analyzer": "./analyzer/dist/MsbuildAnalyzer.dll",
            "#package": "./package.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "@xml-tools/ast": "catalog:",
        "@xml-tools/parser": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": "^24.14.0 || >=25.4.0"
    },
    "executors": "./executors.json",
    "nx": {
        "implicitDependencies": [
            "MsbuildAnalyzer"
        ],
        "targets": {
            "pack--pnpm": {
                "dependsOn": [
                    "...",
                    "^build--dotnet"
                ]
            }
        }
    }
}
