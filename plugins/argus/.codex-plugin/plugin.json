{
    "name": "argus",
    "version": "1.0.0",
    "description": "MCP tools for .lsp.json language servers, with diagnostics after patch and shell edits",
    "mcpServers": {
        "argus": {
            "type": "http",
            "url": "http://127.0.0.1:7410/"
        }
    },
    "hooks": {
        "hooks": {
            "PreToolUse": [
                {
                    "matcher": "^Bash$",
                    "hooks": [
                        {
                            "type": "mcp_tool",
                            "server": "argus",
                            "tool": "shell",
                            "input": { "event": "${hook_event_name}", "toolUseId": "${tool_use_id}" },
                            "timeout": 150,
                            "statusMessage": "Recording filesystem snapshot"
                        }
                    ]
                }
            ],
            "PostToolUse": [
                {
                    "matcher": "^apply_patch$",
                    "hooks": [
                        {
                            "type": "mcp_tool",
                            "server": "argus",
                            "tool": "patched",
                            "input": { "patch": "${tool_input.command}" },
                            "timeout": 150,
                            "statusMessage": "Reading diagnostics"
                        }
                    ]
                },
                {
                    "matcher": "^Bash$",
                    "hooks": [
                        {
                            "type": "mcp_tool",
                            "server": "argus",
                            "tool": "shell",
                            "input": { "event": "${hook_event_name}", "toolUseId": "${tool_use_id}" },
                            "timeout": 150,
                            "statusMessage": "Reading diagnostics"
                        }
                    ]
                }
            ]
        }
    },
    "interface": {
        "displayName": "Argus"
    }
}
