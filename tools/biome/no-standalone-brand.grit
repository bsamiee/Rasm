language js(typescript, jsx)

`const $name = $init` where {
    or {
        $init <: contains `Schema.brand($_)`,
        $init <: contains `S.brand($_)`,
        $init <: contains `Brand.nominal($_)`,
        $init <: contains `Brand.nominal<$_>($_)`,
        $init <: contains `Brand.refined($_)`,
        $init <: contains `Brand.refined<$_>($_)`
    },
    register_diagnostic(span=$name, message="Standalone brand declaration, declare the brand as a field refinement inside its owning Schema class and expose it through that class", severity="error")
}
