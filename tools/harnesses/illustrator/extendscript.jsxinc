// --- [OPERATIONS] ----------------------------------------------------------------------

var harness = (function () {
    var realApp = app;
    var realGlobal = $.global;
    var realDollar = $;
    var RealFile = File;
    var RealFolder = Folder;
    var RealWindow = Window;
    var RealBridgeTalk = BridgeTalk;
    var ENUMERATOR = /^([A-Za-z_$][\w$]*)\.([A-Za-z_$][\w$]*)$/;
    var REFERENCE = /^([A-Za-z]+):(.+)$/;
    var PREFERENCE = /^set(\w+)Preference$/;
    var ACTION_SET = /\/name\s*\[\s*\d+\s+([0-9A-Fa-f]+)\s*\]/;
    var EXTENSION = /\.[^.]*$/;
    var LIVE = ["activeDocument", "selection"];
    var homes = {};
    var read = shared.read, append = shared.append, quote = shared.quote, tag = shared.tag, number = shared.number, iso = shared.iso, literal = shared.literal;
    var run = shared.run, descendants = shared.descendants, nameOf = shared.nameOf, match = shared.match, fill = shared.fill, tree = shared.tree;
    var patched = shared.patched, globals = shared.globals, released = shared.released, thrown = shared.thrown, attempt = shared.attempt;

    // --- [FILES]
    function stem(file) { return decodeURI(file.name).replace(EXTENSION, ""); }
    function offsets(logs) {
        var at = {};
        for (var i = 0; i < logs.length; i++) {
            var file = new RealFile(logs[i]);
            at[logs[i]] = file.exists ? file.length : 0;
        }
        return at;
    }
    function logged(logs, from) {
        var rows = [];
        for (var i = 0; i < logs.length; i++) {
            var file = new RealFile(logs[i]);
            if (!file.exists || file.length <= from[logs[i]]) { continue; }
            file.encoding = "UTF-8";
            if (!file.open("r")) { continue; }
            file.seek(from[logs[i]], 0);
            var lines = file.read().split(/\r?\n/);
            file.close();
            for (var l = 0; l < lines.length; l++) { if (lines[l] !== "") { rows.push({ file: decodeURI(file.name), line: lines[l] }); } }
        }
        return rows;
    }

    // --- [CODEC]
    function enumerator(value) {
        var parts = ENUMERATOR.exec(String(value));
        if (!parts) { return null; }
        var owner = realGlobal[parts[1]];
        try { return owner !== undefined && owner !== null && owner[parts[2]] === value ? "enum:" + parts[1] + "." + parts[2] : null; } catch (error) { return null; }
    }
    function kindOf(value) {
        try { return typeof value.typename === "string" ? value.typename : null; } catch (error) { return null; }
    }
    function reflects(value, name) {
        try { return !!value.reflect.find(name); } catch (error) { return false; }
    }
    function collected(value) {
        try { return typeof value.getByName === "function" && typeof value.length === "number"; } catch (error) { return false; }
