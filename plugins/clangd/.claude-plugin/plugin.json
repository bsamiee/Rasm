{
    "name": "clangd",
    "version": "1.0.0",
    "description": "C++ and Objective-C++ language server of the LLVM release mise installs, reading named modules through its own module builds",
    "author": {
        "name": "Bardia Samiee"
    },
    "lspServers": {
        "clangd": {
            "command": "clangd",
            "args": [ "--background-index", "--experimental-modules-support" ],
            "extensionToLanguage": {
                ".h": "cpp",
                ".hh": "cpp",
                ".hpp": "cpp",
                ".hxx": "cpp",
                ".cc": "cpp",
                ".cpp": "cpp",
                ".cxx": "cpp",
                ".cppm": "cpp",
                ".mm": "objective-cpp",
                ".ixx": "cpp",
                ".ipp": "cpp",
                ".inl": "cpp",
                ".tpp": "cpp"
            }
        }
    }
}
