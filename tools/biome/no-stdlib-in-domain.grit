language js(typescript, jsx)

or {
    `new Map($_)`,
    `new Map<$_>($_)`,
    `new Set($_)`,
    `new Set<$_>($_)`,
    `new WeakMap($_)`,
    `new WeakSet($_)`,
    `new Promise($_)`,
    `new Promise<$_>($_)`,
    `Promise.all($_)`,
    `Promise.allSettled($_)`,
    `Promise.race($_)`,
    `Promise.any($_)`,
    `Promise.resolve($_)`,
    `Promise.reject($_)`,
    `Promise.withResolvers($_)`,
    `new Date($_)`,
    `Date.now()`,
    `Date.parse($_)`,
    `Math.random()`,
    `performance.now()`,
    `queueMicrotask($_)`,
    `setTimeout($_)`,
    `setInterval($_)`
} as $hit where {
    register_diagnostic(span=$hit, message="Standard library primitive in domain code, use the Effect equivalent (HashMap and HashSet for collections, Effect for async, Clock and DateTime for time, Random for entropy, Effect.sleep and Schedule for timers, Effect.yieldNow for scheduling)", severity="error")
}
