{
    "name": "@rasm/cep",
    "private": true,
    "description": "CEP extension manifest, the panel serving requests through its host ExtendScript, and the Vite builder of CEP extensions",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./panel": "./panel.ts",
        "./vite": "./vite.ts"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/automation": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "@swc/core": "catalog:",
        "cheerio": "catalog:",
        "effect": "catalog:",
        "fast-xml-builder": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:"
    }
}
