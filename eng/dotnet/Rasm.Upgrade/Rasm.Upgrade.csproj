<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Central package upgrades constrained by the projects and Rhino runtime that use them</Description>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup Label="Package Management">
        <PackageReference Include="NuGet.Common" />
        <PackageReference Include="NuGet.Configuration" />
        <PackageReference Include="NuGet.Frameworks" />
        <PackageReference Include="NuGet.Packaging" />
        <PackageReference Include="NuGet.ProjectModel" />
        <PackageReference Include="NuGet.Protocol" />
        <PackageReference Include="NuGet.Versioning" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CliWrap" />
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Runtime Diagnostics">
        <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    </ItemGroup>

    <ItemGroup Label="Application Hosting">
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>
</Project>
