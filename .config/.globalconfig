dotnet_diagnostic.MA0018.severity = none # Deprecated for `CA1000`
dotnet_diagnostic.MA0038.severity = none # Deprecated for `CA1822`
dotnet_diagnostic.MA0045.severity = none # Converts sync Roslyn and Rhino callbacks to async, `MA0042` covers blocking
dotnet_diagnostic.MA0048.severity = none # One file per type contradicts CLAUDE.md concept files
dotnet_diagnostic.MA0051.severity = none # Fix extracts methods, CLAUDE.md forbids helper extraction
dotnet_diagnostic.MA0104.severity = none # Flags names other namespaces hold, renames coin names
dotnet_diagnostic.MA0109.severity = none # Asks for added overloads, CLAUDE.md forbids speculative code
