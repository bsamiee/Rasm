{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "cacheDirectory": ".cache/nx/workspace-data/cache",
    "useDaemonProcess": false,
    "analytics": false,
    "neverConnectToCloud": true,
    "sync": {
        "applyChanges": true,
        "globalGenerators": [ "@rasm/nx-distribution:executor-schemas" ]
    },
    "plugins": [
        {
            "plugin": "@rasm/nx-distribution",
            "options": {
                "outputPath": ".artifacts/distribution/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-apple",
            "options": {
                "trustPackages": true,
                "outputPath": ".artifacts/apple/{projectName}",
                "coveragePath": ".artifacts/coverage/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-cargo",
            "options": {
                "outputPath": ".artifacts/nextest/{projectName}",
                "coveragePath": ".artifacts/coverage/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-cmake",
            "exclude": [ "tools/ast-grep/grammars/**" ],
            "options": {
                "outputPath": ".artifacts/cmake/projects/{projectName}",
                "coveragePath": ".artifacts/coverage/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-uv",
            "exclude": [ ".config/mise/locks/**" ],
            "options": {
                "outputPath": ".artifacts/uv/{projectName}",
                "coveragePath": ".artifacts/coverage/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-dotnet",
            "options": {
                "coveragePath": ".artifacts/coverage/{projectName}"
            }
        },
        "@rasm/nx-docker",
        {
            "plugin": "@rasm/nx-pulumi",
            "options": {
                "configurations": {
                    "deploy": {
                        "release": [ "--production" ]
                    }
                }
            }
        },
        {
            "plugin": "@rasm/nx-typescript",
            "options": {
                "compilerPackages": [ "@typescript/native", "@effect/tsgo" ],
                "outputPath": ".artifacts/pnpm/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-vite",
            "options": {
                "outputPath": ".artifacts/vite/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-vitest",
            "options": {
                "outputPath": ".artifacts/vitest/{projectName}",
                "coveragePath": ".artifacts/coverage/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-playwright",
            "options": {
                "outputPath": ".artifacts/playwright/{projectName}"
            }
        },
        {
            "plugin": "@rasm/nx-storybook",
            "options": {
                "outputPath": ".artifacts/storybook/{projectName}"
            }
        }
    ],
    "targetDefaults": {
        "@nx/js:release-publish": {
            "executor": "@rasm/nx-distribution:publish",
            "dependsOn": [ "build--*" ],
            "inputs": [ "default", "^default", { "externalDependencies": [] } ],
            "options": {
                "publish": [ "pnpm", "publish", "--recursive", "--filter", "{projectName}", "--no-git-checks" ],
                "preview": [ "--dry-run" ],
                "credential": "NODE_AUTH_TOKEN"
            }
        }
    },
    "pluginsConfig": {
        "@nx/js": {
            "analyzeSourceFiles": false,
            "projectsAffectedByDependencyUpdates": "auto"
        }
    },
    "release": {
        "projects": [ "tag:release" ],
        "projectsRelationship": "independent",
        "version": {
            "conventionalCommits": true,
            "fallbackCurrentVersionResolver": "disk"
        },
        "changelog": {
            "automaticFromRef": true,
            "projectChangelogs": {
                "createRelease": "github",
                "file": false
            }
        },
        "git": {
            "commitMessage": "chore: publish"
        }
    }
}
