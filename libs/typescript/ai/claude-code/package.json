{
    "name": "@rasm/claude-code",
    "private": true,
    "description": "Claude Code mods as Effect programs: hooks, declared tools, and agents hosted over platform services and an Engine service built on the engine's own calls, with band rows, notices, model messages, panes, placed rows, tmux run watches, the repository's other local sessions, a store over the plugin store, and policy enforcement composed with a mod's own hooks",
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./engine": "./engine/interface.ts",
        "./events": "./engine/events.ts",
        "./ledger": "./engine/ledger.ts",
        "./peers": "./engine/peers.ts",
        "./host": "./engine/host.ts",
        "./skills": "./engine/skills.ts",
        "./ask": "./ui/ask.ts",
        "./draft": "./prompt/draft.ts",
        "./element": "./ui/element.ts",
        "./pane": "./ui/pane.ts",
        "./placed": "./ui/placed.ts",
        "./render": "./ui/render.ts",
        "./theme": "./ui/theme.ts",
        "./watch": "./terminal/watch.ts",
        "./enforcement": "./policy/enforcement.ts",
        "./session": "./policy/session.ts",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@rasm/policy": "workspace:*",
        "@rasm/process": "workspace:*",
        "@rasm/report": "workspace:*",
        "@rasm/shell": "workspace:*",
        "sh-syntax": "catalog:"
    },
    "devDependencies": {
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "nx": {
        "tags": [
            "host:claude-code"
        ]
    }
}
