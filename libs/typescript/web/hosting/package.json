{
    "name": "@rasm/hosting",
    "private": true,
    "description": "One web app served the same on edge and server runtimes",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*"
    },
    "exports": {
        ".": "./index.ts",
        "./browser": "./browser.ts",
        "./cloudflare": "./cloudflare.ts",
        "./head": "./head.ts",
        "./node": "./node.ts",
        "./node-bundle": "./node-bundle.ts",
        "./template": "./template.ts",
        "./vite": "./vite.ts",
        "./worker": "./worker.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@cloudflare/vite-plugin": "catalog:",
        "@effect/platform-node": "catalog:",
        "@rasm/mark": "workspace:*",
        "@vite-pwa/assets-generator": "catalog:",
        "cf": "catalog:",
        "cheerio": "catalog:",
        "culori": "catalog:",
        "effect": "catalog:",
        "partial-content": "catalog:",
        "postcss": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/web-app-manifest": "catalog:"
    }
}
