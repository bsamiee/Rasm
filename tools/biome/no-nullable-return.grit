language js(typescript, jsx)

or {
    `return null`,
    `return undefined`,
    arrow_function(body=$body) where {
        $body <: or {
            `null`,
            `undefined`
        }
    }
} as $hit where {
    register_diagnostic(span=$hit, message="Null or undefined returned from domain code (an arrow body of only the sentinel included), represent absence with Option through Array.head, Option.fromNullable at the boundary, and Option.none inside", severity="error")
}
