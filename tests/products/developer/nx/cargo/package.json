{
    "name": "@rasm/test-nx-cargo",
    "private": true,
    "description": "@rasm/nx-cargo suites over Cargo workspaces in temporary folders and their inferred targets",
    "type": "module",
    "devDependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-cargo": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "fast-check": "catalog:",
        "nx": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "test--vitest": {
                "inputs": [
                    "...",
                    "{workspaceRoot}/rust-toolchain.toml",
                    {
                        "runtime": "rustc -vV"
                    },
                    {
                        "runtime": "cargo nextest --version"
                    },
                    {
                        "env": "RUSTUP_TOOLCHAIN"
                    }
                ]
            }
        }
    }
}
