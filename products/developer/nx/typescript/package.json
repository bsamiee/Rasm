{
    "name": "@rasm/nx-typescript",
    "version": "0.1.0",
    "description": "Nx plugin inferring TypeScript checks and builds per tsconfig.json, package checks and tarballs, and workspace jscpd, knip, and upgrade targets",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/typescript"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "executors.json",
        "executors/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./executors.json": "./executors.json",
        "./executors/*": "./executors/*/executor.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.json": "./*.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./executors.json": "./executors.json",
            "./executors/*": "./dist/executors/*/executor.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "effect": "catalog:",
        "npm-package-arg": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/config": "catalog:",
        "@types/node": "catalog:",
        "@types/npm-package-arg": "catalog:",
        "@typescript/native": "catalog:",
        "eslint": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "executors": "./executors.json"
}
