{
    "name": "@rasm/nx-typescript",
    "version": "0.1.0",
    "description": "Nx plugin inferring a TypeScript check or build per tsconfig.json read through the native compiler API, a publint package check, an eslint check per project a flat config governs, Worker binding types per cloudflare.config.ts, a package manager tarball per package stating a version, and the jscpd duplicate check, knip unused code check, stylelint check of every style file Git lists, and package manager upgrade of the workspace root",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/typescript"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "executors.json",
        "executors/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#/*.json": "./*.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./executors.json": "./executors.json",
        "./executors/*": "./executors/*/executor.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*.json": "./*.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./executors.json": "./executors.json",
            "./executors/*": "./dist/executors/*/executor.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@nx/js": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "effect": "catalog:",
        "npm-package-arg": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/config": "catalog:",
        "@types/node": "catalog:",
        "@types/npm-package-arg": "catalog:",
        "@typescript/native": "catalog:",
        "eslint": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "executors": "./executors.json"
}
