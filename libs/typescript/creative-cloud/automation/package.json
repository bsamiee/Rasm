{
    "name": "@rasm/automation",
    "private": true,
    "description": "Drives Adobe applications through a Swift helper without changing frontmost application",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts"
    },
    "dependencies": {
        "@rasm/search": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:"
    }
}
