{
    "name": "@rasm/nx-typescript",
    "version": "0.1.0",
    "private": true,
    "description": "Nx plugin inferring a TypeScript check or build per tsconfig.json read through the native compiler API, a publint package check, and a pnpm pack tarball per package stating a version",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/typescript"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./plugin.ts",
        "./package.json": "./package.json"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/config": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/plugin.js",
            "./package.json": "./package.json"
        }
    }
}
