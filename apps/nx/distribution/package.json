{
    "name": "@rasm/nx-distribution",
    "version": "0.0.0",
    "description": "Nx plugin building Blender extensions and Unreal plug-ins, and installing and publishing host packages (Blender extensions, Yak packages, Adobe UXP and CEP plug-ins and Unreal plug-ins) through each host's own channel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/distribution"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#blender": "./executors/extension-build/blender.py",
        "#vendored": "./executors/extension-build/vendored.py"
    },
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json", "executors/extension-build/blender.py", "executors/extension-build/vendored.py", "executors/extension-build/vendored.py.lock" ],
    "dependencies": {
        "@decimalturn/toml-patch": "catalog:",
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:",
        "jsonc-parser": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugins/project-graph.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js",
            "#blender": "./executors/extension-build/blender.py",
            "#vendored": "./executors/extension-build/vendored.py"
        }
    },
    "executors": "./executors.json"
}
