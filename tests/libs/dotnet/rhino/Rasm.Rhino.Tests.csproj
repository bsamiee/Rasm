<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Tests of Rasm.Rhino, Rasm.Rhino.Modeling, and Rasm.Grasshopper against the installed Rhino and Grasshopper 2, booted once inside the test process</Description>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Test Host">
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
        <GenerateSelfRegisteredExtensions>true</GenerateSelfRegisteredExtensions>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>Headless;Interface</Configurations>
        <Configuration Condition="$([MSBuild]::IsOSPlatform(`OSX`))">Interface</Configuration>
        <Configuration Condition="!$([MSBuild]::IsOSPlatform(`OSX`))">Headless</Configuration>
        <TestingPlatformCommandLineArguments>--report-trx --hangdump --hangdump-type Mini --hangdump-timeout 10m --crash-report-if-supported --xunit-diagnostics on --long-running 60 --show-slowest-tests 10</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Test Host" Condition="'$(OS)' != 'Windows_NT'">
        <RhinoApplication>$(HOME)/Applications/Rhino $(RhinoVersion.Split(`.`)[0]).app</RhinoApplication>
        <RhinoApplication Condition="!Exists('$(RhinoApplication)')">/Applications/Rhino $(RhinoVersion.Split(`.`)[0]).app</RhinoApplication>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Test Host" Condition="'$(OS)' == 'Windows_NT'">
        <TargetFramework>$(RhinoTargetFramework)-windows</TargetFramework>
        <NuGetLockFilePath>packages.windows.lock.json</NuGetLockFilePath>
        <RhinoApplication>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\McNeel\Rhinoceros\$(RhinoVersion.Split(`.`)[0]).0\Install', 'CoreDllPath', '', RegistryView.Registry64))</RhinoApplication>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Test Host" Condition="'$(OS)' != 'Windows_NT' and !Exists('$(RhinoApplication)')">
        <IsTestProject>false</IsTestProject>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup Label="Rhino Test Host">
        <ProjectCapability Include="RuntimeEnvironmentVariableSupport" />
        <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
            <_Parameter1>5f0c9b8e-3d2a-4c61-9a7e-2b1d6e4f8a03</_Parameter1>
        </AssemblyAttribute>
        <RuntimeHostConfigurationOption Include="RhinoVersion" Value="$(RhinoVersion)" />
        <RuntimeHostConfigurationOption Include="RhinoMode" Value="$(Configuration)" />
    </ItemGroup>

    <ItemGroup Label="Rhino Test Host" Condition="'$(OS)' != 'Windows_NT'">
        <Compile Remove="Host/Windows.cs" />
        <UpToDateCheckInput Include="$(RhinoApplication)/Contents/Info.plist" />
        <RuntimeEnvironmentVariable Include="DYLD_INSERT_LIBRARIES" Value="$(TargetDir)libbackground.dylib" />
    </ItemGroup>

    <ItemGroup Label="Rhino Test Host" Condition="'$(OS)' == 'Windows_NT'">
        <Compile Remove="Host/Darwin.cs" />
        <UpToDateCheckInput Include="$(RhinoApplication)" />
        <PackageReference Include="Rhino.Inside" />
    </ItemGroup>

    <ItemGroup Label="Rhino Test Host">
        <Using Include="Rasm.Rhino.Tests.Host" />
    </ItemGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Grasshopper2" />
        <PackageReference Include="RhinoCommon" />
    </ItemGroup>

    <ItemGroup Label="Functional Programming">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Property Testing">
        <PackageReference Include="CsCheck" />
        <RuntimeEnvironmentVariable Include="CsCheck_Threads" Value="1" /> <!-- RhinoCommon and its documents run on one thread, so samples run one at a time -->
    </ItemGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../../../support/dotnet/Rasm.Testing/Rasm.Testing.csproj" />
        <ProjectReference Include="../../../../libs/dotnet/rhino/Rasm.Grasshopper/Rasm.Grasshopper.csproj" />
        <ProjectReference Include="../../../../libs/dotnet/rhino/Rasm.Rhino.Modeling/Rasm.Rhino.Modeling.csproj" />
        <ProjectReference Include="../../../../libs/dotnet/rhino/Rasm.Rhino/Rasm.Rhino.csproj" />
    </ItemGroup>

    <Target Name="ResolveRhinoApplication" AfterTargets="ResolvePackageAssets" BeforeTargets="ComputeRunArguments" DependsOnTargets="ResolvePackageAssets" Condition="'$(IsTestProject)' == 'true'">
        <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
            <_RhinoResources>$(RhinoApplication)/Contents/Frameworks/RhCore.framework/Resources/</_RhinoResources>
            <RunCommand>$(_RhinoResources)dotnet/$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())/dotnet</RunCommand>
        </PropertyGroup>
        <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
            <_RhinoResources>$([System.IO.Path]::GetDirectoryName('$(RhinoApplication)'))\netcore\</_RhinoResources>
            <RunCommand>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\dotnet\Setup\InstalledVersions\x64', 'InstallLocation', '', RegistryView.Registry32))dotnet.exe</RunCommand>
        </PropertyGroup>
        <PropertyGroup>
            <RunArguments>exec &quot;$(TargetPath)&quot; $(RunArguments)</RunArguments>
        </PropertyGroup>
        <ItemGroup>
            <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="Exists('$(_RhinoResources)%(Filename)%(Extension)')" />
        </ItemGroup>
    </Target>

    <Target Name="RequireRhinoApplication" BeforeTargets="ComputeRunArguments" DependsOnTargets="ResolveRhinoApplication" Condition="'$(IsTestProject)' == 'true'">
        <Error Condition="!Exists('$(RunCommand)')" Text="$(MSBuildProjectName) runs on Rhino $(RhinoVersion), whose .NET runtime is absent at '$(RunCommand)'" />
    </Target>

    <Target Name="BuildBackground" BeforeTargets="CopyFilesToOutputDirectory" Inputs="Host/Background.m" Outputs="$(TargetDir)libbackground.dylib" Condition="'$(IsTestProject)' == 'true' and '$(OS)' != 'Windows_NT'">
        <Exec Command="xcrun clang -dynamiclib -fobjc-arc -O2 -Wall -Werror -Wno-deprecated-declarations -framework AppKit -framework ApplicationServices -o &quot;$(TargetDir)libbackground.dylib&quot; Host/Background.m" />
        <ItemGroup>
            <FileWrites Include="$(TargetDir)libbackground.dylib" />
        </ItemGroup>
    </Target>
</Project>
