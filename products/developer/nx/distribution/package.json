{
    "name": "@rasm/nx-distribution",
    "version": "0.1.0",
    "description": "Nx plugin inferring build, install, attach, and publish targets of host packages (Blender, Yak, UXP, Chrome, Unreal) from their manifests, and the clean, attach, and publish executors every plugin names",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/distribution"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "executors.json",
        "executors/*/schema.json",
        "executors/*/vendored.py*",
        "generators.json",
        "generators/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json",
        "#/*.py": "./*.py"
    },
    "exports": {
        ".": "./plugin.ts",
        "./inference": "./inference.ts",
        "./executor": "./executor.ts",
        "./release/version-actions": "./version-actions.ts",
        "./executors.json": "./executors.json",
        "./generators.json": "./generators.json",
        "./executors/*": "./executors/*/executor.ts",
        "./generators/*": "./generators/*/generator.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.json": "./*.json",
            "#/*.py": "./*.py"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./inference": "./dist/inference.js",
            "./executor": "./dist/executor.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./executors.json": "./executors.json",
            "./generators.json": "./generators.json",
            "./executors/*": "./dist/executors/*/executor.js",
            "./generators/*": "./dist/generators/*/generator.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@decimalturn/toml-patch": "catalog:",
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@nx/js": "catalog:",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:",
        "jsonc-parser": "catalog:",
        "minimatch": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "executors": "./executors.json",
    "generators": "./generators.json"
}
