                members(value, path + name + ".", kinds.concat([kindOf(value)]), rows, unread);
            }
        }
        return rows;
    }
    function snapshot(unread) { return members(realApp, "", ["Application"], [], unread || []); }
    function ownerAt(path) {
        var owner = realApp;
        var steps = path.split(".");
        for (var i = 0; i < steps.length - 1; i++) { owner = owner[steps[i]]; }
        return owner;
    }
    function plain(rows) {
        var object = {};
        for (var i = 0; i < rows.length; i++) { object[rows[i].path + rows[i].key] = eval("(" + rows[i].text + ")"); }
        return object;
    }
    function differences(rows) {
        var found = [];
        for (var i = 0; i < rows.length; i++) {
            var now = codec.json(ownerAt(rows[i].path)[rows[i].key]);
            if (now !== rows[i].text) { found.push({ row: rows[i], member: rows[i].path + rows[i].key, before: eval("(" + rows[i].text + ")"), after: eval("(" + now + ")") }); }
        }
        return found;
    }
    function restored(rows) {
        var leaked = [];
        var changed = differences(rows);
        for (var i = 0; i < changed.length; i++) {
