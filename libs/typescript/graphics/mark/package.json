{
    "name": "@rasm/mark",
    "version": "0.1.0",
    "private": true,
    "description": "One SVG master painted with a fill color and opacity, and rastered per size, through resvg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/graphics/mark"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./paint": "./paint.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@resvg/resvg-js": "catalog:",
        "cheerio": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./paint": "./dist/paint.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
