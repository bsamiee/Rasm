{
    "name": "@rasm/test-store",
    "version": "0.0.0",
    "private": true,
    "description": "Store service suites and their client: sessions, stores, and templates of the rasm.store gRPC contract as the options each catalog driver takes",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "tests/typescript/integration/store"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./client.ts"
    },
    "files": [ "dist", "!dist/suite", "!dist/*.config.*" ],
    "dependencies": {
        "@bufbuild/protobuf": "catalog:",
        "@connectrpc/connect": "catalog:",
        "@connectrpc/connect-node": "catalog:"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@bufbuild/protoc-gen-es": "catalog:",
        "@effect/sql-clickhouse": "catalog:",
        "@effect/sql-pg": "catalog:",
        "@effect/vitest": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "nx": "catalog:",
        "redis": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "catalog:peers",
        "@effect/sql-clickhouse": "catalog:peers",
        "@effect/sql-pg": "catalog:peers",
        "effect": "catalog:peers",
        "redis": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-s3": {
            "optional": true
        },
        "@effect/sql-clickhouse": {
            "optional": true
        },
        "@effect/sql-pg": {
            "optional": true
        },
        "redis": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/client.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    },
    "nx": {
        "implicitDependencies": [ "rasm-store" ]
    }
}
