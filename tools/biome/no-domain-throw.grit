language js(typescript, jsx)

`throw $error` where {
    $error <: not within `Effect.try($_)` ,
    $error <: not within `Effect.tryPromise($_)` ,
    register_diagnostic(span=$error, message="Throw in domain code, fail through the typed error channel with Effect.fail and a tagged error, or wrap the throwing call in Effect.try or Effect.tryPromise", severity="error")
}
