# --- [CHECKS] ---------------------------------------------------------------------------

Checks:
    - bugprone-*
    - cert-*
    - clang-analyzer-*
    - concurrency-*
    - cppcoreguidelines-*
    - custom-*
    - misc-*
    - modernize-*
    - objc-*
    - performance-*
    - portability-*
    - readability-*
    # Operands of a binary numeric operation share one type by definition
    - -bugprone-easily-swappable-parameters
    # Reads `#include` lines alone and reports each name `import std` supplies
    - -misc-include-cleaner
    # Engines of a test take a literal seed so each run draws one sequence
    - -bugprone-random-generator-seed
    - -cert-msc32-c
    - -cert-msc51-cpp
    # Expected values of a case and coefficients of a formula are literals
    - -cppcoreguidelines-avoid-magic-numbers
    - -readability-magic-numbers
    # Headers open with `#pragma once`, which each compiler a host builds with accepts
    - -portability-avoid-pragma-once
    # libc++ hardening checks the index of each `operator[]` call
    - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
    # `std::errc{}` is the value `std::from_chars` and `std::to_chars` report success with
    - -bugprone-invalid-enum-default-initialization
    # Fuzz targets view their input bytes in place as text
    - -cppcoreguidelines-pro-type-reinterpret-cast
WarningsAsErrors: '*'

# --- [SCOPE] ----------------------------------------------------------------------------

HeaderFilterRegex: '/(apps|libs)/'
ExcludeHeaderFilterRegex: '/\.artifacts/'
SystemHeaders: false
FormatStyle: file

# --- [OPTIONS] --------------------------------------------------------------------------

CheckOptions:
    bugprone-unused-return-value.CheckedReturnTypes: '^::std::error_code$;^::std::error_condition$;^::std::errc$;^::std::expected$'
    misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
    modernize-use-trailing-return-type.TransformLambdas: none
    readability-identifier-length.MinimumVariableNameLength: 2
    readability-identifier-length.MinimumParameterNameLength: 2
    readability-identifier-naming.ClassCase: CamelCase
    readability-identifier-naming.StructCase: CamelCase
    readability-identifier-naming.UnionCase: CamelCase
    readability-identifier-naming.EnumCase: CamelCase
    readability-identifier-naming.EnumConstantCase: CamelCase
    readability-identifier-naming.ConceptCase: CamelCase
    readability-identifier-naming.TypeAliasCase: CamelCase
    readability-identifier-naming.TemplateParameterCase: CamelCase
    readability-identifier-naming.NamespaceCase: lower_case
    readability-identifier-naming.FunctionCase: lower_case
    readability-identifier-naming.FunctionIgnoredRegexp: '^LLVMFuzzerTestOneInput$'
    readability-identifier-naming.VariableCase: lower_case
    readability-identifier-naming.ParameterCase: lower_case
    readability-identifier-naming.MemberCase: lower_case
    readability-identifier-naming.PrivateMemberSuffix: _
    readability-identifier-naming.MacroDefinitionCase: UPPER_CASE

# --- [HOUSE_RULES] ----------------------------------------------------------------------

CustomChecks:
    - Name: member-visit
      Query: |
          match callExpr(callee(functionDecl(hasName("::std::visit")))).bind("call")
      Diagnostic:
          - BindName: call
            Message: call member `visit` of the variant in place of `std::visit`
            Level: Warning
