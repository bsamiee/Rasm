{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "ignoreUnknown": true,
        "includes": [ "**", "!!.venv", "!!.cache", "!!.artifacts", "!**/*.xcassets", "!**/*.icon" ]
    },
    "formatter": { "useEditorconfig": true, "lineWidth": 320 },
    "javascript": { "formatter": { "quoteStyle": "single" }, "resolver": { "experimentalPnpmCatalogs": true } },
    "json": { "formatter": { "expand": "auto", "delimiterSpacing": true } },
    "css": { "parser": { "tailwindDirectives": true } },
    "assist": { "actions": { "source": { "useSortedAttributes": "on", "useSortedPackageJson": "on", "useSortedProperties": "on" } } },
    "linter": {
        "domains": { "project": "all", "react": "all", "test": "all", "types": "all" },
        "rules": {
            "a11y": "error",
            "complexity": "error",
            "correctness": "error",
            "performance": "error",
            "security": "error",
            "style": "error",
            "suspicious": "error",
            "nursery": {
                "noBunModules": "error",
                "noDuplicateSelectors": "error",
                "noEmptyObjectKeys": "error",
                "noExtendNative": "error",
                "noImpliedEval": "error",
                "noInlineStyles": "error",
                "noInvalidFileInputAccept": "error",
                "noInvalidPropertyInitValue": "error",
                "noLoopFunc": "error",
                "noNegationInEqualityCheck": "error",
                "noNonScalableViewport": "error",
                "noObsoleteTags": "error",
                "noRestrictedDependencies": "error",
                "noReturnInFinally": "error",
                "noThisOutsideOfClass": "error",
                "noTopLevelLiterals": "error",
                "noUnmodifiedLoopCondition": "error",
                "noUnnecessaryTemplateExpression": "error",
                "noUnsafeTypeAssertion": "error",
                "noUselessTypeConversion": "error",
                "useArraySome": "error",
                "useBaseline": { "level": "error", "options": { "available": "newly" } },
                "useConsistentObjectKeys": "error",
                "useControlLabel": "error",
                "useDomNodeTextContent": "error",
                "useDomQuerySelector": "error",
                "useExplicitReturnType": "error",
                "useFlatMathMinMax": "error",
                "useIframeSandbox": "error",
                "useImportsFirst": "error",
                "useIncludes": "error",
                "useMathMinMax": "error",
                "useModernMathApis": "error",
                "useNamedCaptureGroup": "error",
                "useNamedLayer": "error",
                "useNullishCoalescing": "error",
                "useReduceTypeParameter": "error",
                "useRegexpExec": "error",
                "useRegexpTest": "error",
                "useSortedClasses": "error",
                "useStringStartsEndsWith": "error",
                "useThisInClassMethods": { "level": "error", "options": { "ignoreOverrideMethods": true } },
                "useUnicodeRegex": "error",
                "useValidTestTitle": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": [ "**" ],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off",
                        "noExcessiveLinesPerFunction": "off",
                        "noForEach": "off",
                        "useMaxParams": { "level": "error", "options": { "max": 8 } }
                    },
                    "correctness": { "noNodejsModules": "off", "noSolidDestructuredProps": "off", "noUndeclaredVariables": "off", "noUnresolvedImports": "off", "useQwikValidLexicalScope": "off" },
                    "performance": { "noImgElement": "off", "noJsxPropsBind": "off", "useSolidForComponent": "off" },
                    "security": { "noSecrets": "off" },
                    "style": {
                        "noExcessiveClassesPerFile": "off",
                        "noExcessiveLinesPerFile": "off",
                        "noJsxLiterals": "off",
                        "noParameterAssign": { "level": "error", "options": { "propertyAssignment": "deny" } },
                        "noTernary": "off",
                        "useConsistentMemberAccessibility": { "level": "error", "options": { "accessibility": "none" } },
                        "useNamingConvention": "off",
                        "useReadonlyClassProperties": { "level": "error", "options": { "checkAllProperties": true } }
                    },
                    "suspicious": { "noBitwiseOperators": { "level": "error", "options": { "allow": [ "&" ] } }, "noLeakedRender": "off", "noReactSpecificProps": "off", "noShadowRestrictedNames": "off" }
                }
            }
        },
        { "includes": [ "package.json" ], "linter": { "rules": { "nursery": { "noRestrictedDependencies": "off" } } } },
        { "includes": [ "**/*.config.ts" ], "linter": { "rules": { "style": { "noDefaultExport": "off" } } } },
        { "includes": [ "plugins/function-hooks/**" ], "linter": { "rules": { "correctness": { "noUndeclaredDependencies": "off" } } } },
        { "includes": [ "plugins/argus/main.ts" ], "linter": { "rules": { "style": { "noProcessEnv": "off" } } } }
    ]
}
