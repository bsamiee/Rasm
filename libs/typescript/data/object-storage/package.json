{
    "name": "@rasm/object-storage",
    "version": "0.1.0",
    "private": true,
    "description": "Objects in an R2 or S3 bucket served with ranges and preconditions and written through SigV4 presigned S3 requests",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/data/object-storage"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./r2": "./r2.ts",
        "./s3": "./s3.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./r2": "./dist/r2.js",
            "./s3": "./dist/s3.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "aws4fetch": "catalog:",
        "partial-content": "catalog:"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@cloudflare/workers-types": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "catalog:peers",
        "effect": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-s3": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=26"
    }
}
