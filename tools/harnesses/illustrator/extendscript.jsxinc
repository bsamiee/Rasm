    function added(opened, before, label) {
        if (opened === null || opened === undefined || opened.typename !== "Document" || realApp.documents.length <= before) { throw new Error(label + " left documents.length at " + realApp.documents.length); }
        return opened;
    }
    function unlisted(rows) {
        var options = new OpenOptions();
        options.addToRecentFiles = false;
        var given = revive(rows);
        for (var key in given) { if (given.hasOwnProperty(key)) { options[key] = given[key]; } }
        return options;
    }
    function created(session, row, title, made) {
        var preset = realApp.getPresetSettings(row.preset);
        var settings = revive(row.settings);
        for (var key in settings) { if (settings.hasOwnProperty(key)) { preset[key] = settings[key]; } }
        preset.title = title;
        var before = realApp.documents.length;
        var doc = added(realApp.documents.addDocument(row.preset, preset, false), before, "addDocument " + row.preset);
        session.documents.push(doc);
        var i;
        for (i = 0; i < row.writes.length; i++) { assign(session, row.writes[i][0], row.writes[i][1], doc, made); }
        var wrong = [];
        for (i = 0; i < row.expects.length; i++) {
            var now = json(evaluated(session, row.expects[i][0], doc, made));
            var wanted = json(revive(row.expects[i][1]));
            if (now !== wanted) { wrong.push(title + " " + row.expects[i][0] + " reads " + now + " where the precondition asks " + wanted); }
        }
        if (wrong.length) { throw new Error(wrong.join(", ")); }
        return doc;
    }
    function opened(session, item, batch, index, made) {
        var condition = item.precondition;
        var docs = [];
        var i;
        for (i = 0; i < condition.documents.length; i++) {
            var row = condition.documents[i];
            var before = realApp.documents.length;
            if (row.open === undefined) {
                docs.push(created(session, row, batch.label + "-" + index + "-" + i, made));
            } else {
                docs.push(added(realApp.open(new RealFile(row.open), row.colorSpace === undefined ? undefined : revive(row.colorSpace), unlisted(row.options)), before, "open " + row.open));
                session.documents.push(docs[i]);
            }
        }
        var missing = [];
        var fonts = condition.fonts || [];
        for (i = 0; i < fonts.length; i++) {
            try { realApp.textFonts.getByName(fonts[i]); } catch (error) { missing.push(fonts[i]); }
        }
        if (missing.length) { throw new Error("fonts not installed: " + missing.join(", ")); }
        if (docs.length > 1) { realApp.activeDocument = docs[0]; }
        return docs;
    }
    function prepare(session, doc, condition, made) {
        var i;
        var sets = condition.set || [];
        for (i = 0; i < sets.length; i++) { assign(session, sets[i][0], sets[i][1], doc, made); }
        var adds = condition.add || [];
        for (i = 0; i < adds.length; i++) {
            var row = adds[i];
            var collection = evaluated(session, row.to, doc, made)[row.kind];
            var method = row.method === undefined ? "add" : row.method;
            if (typeof collection[method] !== "function") { throw new Error(row.to + "." + row.kind + " holds no method " + method); }
            var args = [];
            for (var a = 0; a < (row.args || []).length; a++) { args.push(evaluated(session, row.args[a], doc, made)); }
            var item = collection[method].apply(collection, args);
            var properties = revive(row.properties || {});
            for (var key in properties) { if (properties.hasOwnProperty(key)) { item[key] = properties[key]; } }
            made[row.as] = item;
        }
        var steps = condition.steps || [];
        for (i = 0; i < steps.length; i++) { evaluated(session, steps[i], doc, made, true); }
        var picks = condition.select || [];
        for (i = 0; i < picks.length; i++) {
            var picked = evaluated(session, picks[i], doc, made);
            if (reflects(picked, "select")) { picked.select(i > 0); } else { picked.selected = true; }
        }
        session.refresh();
    }
    function reads(session, docs, wanted, made) {
        var values = {};
        var failed = {};
        for (var key in wanted) {
            if (!wanted.hasOwnProperty(key)) { continue; }
            try {
                var rows = spread(session, key, wanted[key], docs[0], made);
                for (var r = 0; r < rows.length; r++) {
                    try { values[rows[r][0]] = rows[r][1](); } catch (inner) { failed[rows[r][0]] = String(inner.message); }
                }
            } catch (error) { failed[key] = String(error.message); }
        }
        return { state: kept(values, []), failed: failed };
    }

    // --- [RUN]
    function body(item) {
        if (item._tag === "Probe") { return "(function (doc, made) { return (" + item.evaluate + "); }).apply(this, arguments);"; }
        if (item._tag === "Call") { return (item.source === undefined ? "" : item.source.code) + "\n;(" + item.call + ").apply(this, arguments);"; }
        return item.source.code;
    }
    function sessionFor(item) {
        return { palettes: [], created: [], documents: [], loaded: [], windowShown: 0, preferences: {}, windowAnswers: item.windows || [], confirms: (item.confirms || []).slice(0), prompts: (item.prompts || []).slice(0), files: (item.files || []).slice(0), record: { alerts: [], confirms: [], prompts: [], windows: [], files: [], activations: [], console: [], writes: [], opened: [] } };
    }
    function ran(session, item, extra, result) {
        try {
            var value = session.evaluate(body(item), extra);
            for (var p = 0; p < session.palettes.length; p++) { answered(session, session.palettes[p].window, session.palettes[p].answer); }
            if (item._tag !== "Run") { result.value = kept(value, []); }
            return { _tag: "Ran" };
        } catch (error) {
            return thrown(error);
        }
    }
    function outcome(item, batch, index) {
        var session = sessionFor(item);
        var result = { name: item.name, completion: { _tag: "Failed", reason: "case did not finish" } };
        var leaked = [];
        var known = keys();
        var global = globals();
        var release = function () {};
        var made = {};
        var base = snapshot();
        var start = base;
        var from = offsets(batch.logs);
        var docs = [];
        try {
            var shadows = shadowsFor(session, item);
            session.app = shadows.app;
            session.evaluate = function (code, extra) { return scoped(shadows.Window, shadows.alert, shadows.confirm, shadows.prompt, shadows.app, shadows.$, shadows.BridgeTalk, shadows.global, code, extra); };
            release = patched(session);
            realApp.coordinateSystem = revive(item.precondition.coordinates);
            realApp.userInteractionLevel = revive(item.precondition.interaction);
            if (item.precondition.colorSettings !== undefined) {
                session.colored = true;
                realApp.loadColorSettings(new RealFile(item.precondition.colorSettings));
            }
            var rows = item.precondition.preferences || [];
            for (var r = 0; r < rows.length; r++) {
                remember(session.preferences, rows[r].key, rows[r].kind, false);
                realApp.preferences["set" + rows[r].kind + "Preference"](rows[r].key, rows[r].value);
            }
            docs = opened(session, item, batch, index, made);
            for (var s = 0; s < docs.length; s++) { session.record.opened.push(expanded(docs[s], [])); }
            session.refresh();
            if (docs.length) { prepare(session, docs[0], item.precondition, made); }
            start = snapshot();
            result.before = reads(session, docs, item.read, made).state;
            result.completion = ran(session, item, item._tag === "Probe" ? [docs[0], made] : revive(item.args), result);
            var after = reads(session, docs, item.read, made);
            result.read = after.state;
            result.readFailed = after.failed;
        } catch (outer) {
            result.completion = { _tag: "Failed", reason: String(outer.message) + (outer.line ? " at line " + outer.line : "") };
        }
        attempt(leaked, "prototypes", release);
        attempt(leaked, "globals", function () { leaked = leaked.concat(released(global)); });
        for (var w = 0; w < session.created.length; w++) { attempt(leaked, "window", (function (made) { return function () { made.close(); }; })(session.created[w])); }
        for (var a = 0; a < session.loaded.length; a++) { attempt(leaked, "action", (function (set) { return function () { realApp.unloadAction(set, ""); }; })(session.loaded[a])); }
        if (session.tool !== undefined) { attempt(leaked, "tool", function () { realApp.selectTool(session.tool); }); }
        if (session.colored === true) { attempt(leaked, "color settings", function () { realApp.loadColorSettings(new RealFile(batch.colorSettings)); }); }
        var mine = [];
        for (var c = 0; c < session.documents.length; c++) {
            attempt(leaked, "close", (function (open) { return function () { mine.push(keyOf(open)); if (holds(keys(), keyOf(open))) { open.close(SaveOptions.DONOTSAVECHANGES); } }; })(session.documents[c]));
        }
        attempt(leaked, "documents", function () {
            for (var o = realApp.documents.length - 1; o >= 0; o--) {
                var doc = realApp.documents[o];
                if (!holds(known, keyOf(doc)) && !holds(mine, keyOf(doc))) {
                    leaked.push("document " + doc.name + " opened outside the case");
                    doc.close(SaveOptions.DONOTSAVECHANGES);
                }
            }
        });
        attempt(leaked, "preferences", function () {
            var rows = settled(session.preferences);
            session.record.writes = session.record.writes.concat(rows.writes);
            leaked = leaked.concat(rows.leaked);
        });
        attempt(leaked, "application", function () {
            var changed = differences(start);
            for (var d = 0; d < changed.length; d++) { session.record.writes.push({ _tag: "Application", member: changed[d].member, before: changed[d].before, after: changed[d].after }); }
            leaked = leaked.concat(restored(base));
        });
        var record = session.record;
        result.alerts = record.alerts; result.confirms = record.confirms; result.prompts = record.prompts; result.windows = record.windows; result.files = record.files;
        result.activations = record.activations; result.console = record.console; result.writes = kept(record.writes, []); result.opened = record.opened; result.logs = logged(batch.logs, from); result.written = []; result.answered = []; result.leaked = leaked;
        return result;
    }
    function closing(folders, label) {
        for (var i = realApp.documents.length - 1; i >= 0; i--) {
            var doc = realApp.documents[i];
            var stale = label !== undefined && doc.name.indexOf(label + "-") === 0;
            for (var f = 0; f < folders.length && !stale; f++) { stale = keyOf(doc).indexOf(new RealFolder(folders[f]).fullName + "/") === 0; }
            if (stale) { doc.close(SaveOptions.DONOTSAVECHANGES); }
        }
    }
    function surveyed(types) {
        var names = realApp.startupPresetsList;
        var presets = {};
        var application = {};
        var methods = [];
        var i;
        for (i = 0; i < names.length; i++) { presets[names[i]] = { types: [], settings: expanded(realApp.getPresetSettings(names[i]), []) }; }
        for (i = 0; i < types.length; i++) {
            var file = realApp.getPresetFileOfType(DocumentPresetType[types[i]]);
            var name = file === null || file === undefined ? "" : stem(file);
            if (presets.hasOwnProperty(name)) { presets[name].types.push(types[i]); }
        }
        var props = realApp.reflect.properties;
        for (i = 0; i < props.length; i++) {
            if (props[i].type !== "readonly" || props[i].name === "typename" || props[i].name === "parent") { continue; }
            var value;
            try { value = realApp[props[i].name]; } catch (error) { continue; }
            if (kindOf(value) === null && !collected(value)) { application[props[i].name] = kept(value, []); }
        }
        for (i = 0; i < realApp.reflect.methods.length; i++) { methods.push(realApp.reflect.methods[i].name); }
        return { presets: presets, application: application, methods: methods, options: expanded(new OpenOptions(), []) };
    }
    return function (text) {
        var batch = eval("(" + text + ")");
        var level = realApp.userInteractionLevel;
        var unread = [];
        var answer = { application: realApp.name, version: realApp.version, state: { documents: realApp.documents.length, application: plain(snapshot(unread)), unread: unread } };
        realApp.userInteractionLevel = UserInteractionLevel.DONTDISPLAYALERTS;
        try {
            if (batch._tag === "Survey") {
                answer.survey = surveyed(batch.enumerations.DocumentPresetType || []);
                return json(answer);
            }
            if (batch._tag === "Closed") {
                closing(batch.folders);
                return json(answer);
            }
            var folders = [];
            for (var f = 0; f < batch.cases.length; f++) { folders.push(batch.cases[f].folder); }
            closing(folders, batch.label);
            for (var i = 0; i < batch.cases.length; i++) {
                append(batch.records, json({ _tag: "Started", index: i }) + "\n");
                append(batch.records, json({ _tag: "Finished", outcome: outcome(batch.cases[i], batch, i) }) + "\n");
            }
            return json(answer);
        } catch (error) {
            return json({ failed: String(error.message) + (error.line ? " at line " + error.line : "") });
        } finally {
            realApp.userInteractionLevel = level;
        }
    };
})();
