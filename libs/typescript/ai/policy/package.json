{
    "name": "@rasm/policy",
    "version": "0.1.0",
    "private": true,
    "description": "Decisions on what an agent attempts by named rule tables, answered as allow, deny, or rewrite",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/ai/policy"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./policy": "./policy.ts",
        "./action": "./decision/action.ts",
        "./git": "./rules/git.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./policy": "./dist/policy.js",
            "./action": "./dist/decision/action.js",
            "./git": "./dist/rules/git.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/report": "workspace:*",
        "@rasm/shell": "workspace:*"
    },
    "devDependencies": {
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
