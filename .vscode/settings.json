{
    // --- [EXPLORER_VISIBILITY] ---------------------------------------------------------
    "explorer.compactFolders": false,
    "files.exclude": {
        "**/node_modules": true,
        "**/.artifacts": true,
        "**/.cache": true,
        "**/.venv": true,
        "**/__pycache__": true
    },

    // --- [FILE_WATCHING] ---------------------------------------------------------------
    "files.watcherExclude": {
        "**/.artifacts/**": true,
        "**/.cache/**": true,
        "**/.venv/**": true,
        "**/node_modules/**": true
    },

    // --- [FILE_NESTING] ----------------------------------------------------------------
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "CLAUDE.md": ".mcp.json, AGENTS.md",
        "README.md": "LICENSE",
        "Directory.Build.props": "Directory.Build.targets, Directory.Packages.props, Directory.Build.rsp, global.json, NuGet.config, Workspace.slnx",
        "*.cts": "${capture}.spec.cts, ${capture}.test.cts",
        "*.mts": "${capture}.spec.mts, ${capture}.test.mts",
        "*.ts": "${capture}.spec.ts, ${capture}.test.ts",
        "*.tsx": "${capture}.spec.tsx, ${capture}.test.tsx",
        ".gitignore": ".gitattributes",
        "pyproject.toml": "uv.lock",
        "Cargo.toml": "rust-toolchain.toml, rustfmt.toml, clippy.toml, Cargo.lock",
        "nx.json": ".editorconfig, .lldbinit, .swift-format, .swiftlint.yml, .yamlfmt, .yamllint.yaml, mise.toml, pmd.xml, sgconfig.yml, Xcode.xcconfig",
        "package.json": "biome.json, pnpm-workspace.yaml, pnpm-lock.yaml, tsconfig.base.json, tsconfig.json, vite.config.ts, vitest.config.ts"
    },

    // --- [PYTHON] ----------------------------------------------------------------------
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "python.terminal.activateEnvironment": false,
    "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },

    // --- [TYPESCRIPT] ------------------------------------------------------------------
    "js/ts.experimental.useTsgo": true,
    "js/ts.tsdk.path": "./node_modules/typescript",
    "[typescript][typescriptreact][javascript][javascriptreact][json][jsonc][css]": { "editor.defaultFormatter": "biomejs.biome" },

    // --- [DOTNET] ----------------------------------------------------------------------
    "csharp.suppressBuildAssetsNotification": true,
    "dotnet.defaultSolution": "Workspace.slnx",
    "dotnet.projects.enableAutomaticRestore": false,

    // --- [RUST] ------------------------------------------------------------------------
    "rust-analyzer.cargo.extraEnv": { "CARGO_BUILD_TARGET_DIR": "${workspaceFolder}/.artifacts/rust/rust-analyzer", "CARGO_BUILD_BUILD_DIR": "${workspaceFolder}/.cache/rust/rust-analyzer" },
    "rust-analyzer.check.overrideCommand": [ "cargo", "clippy", "--workspace", "--lib", "--bins", "--tests", "--message-format=json-diagnostic-rendered-ansi", "--keep-going" ],
    "rust-analyzer.rustc.source": "discover",

    // --- [SWIFT] -----------------------------------------------------------------------
    "swift.buildPath": "${workspaceFolder}/.cache/swiftpm/vscode",
    "swift.searchSubfoldersForPackages": true,

    // --- [JAVA] ------------------------------------------------------------------------
    "java.jdt.ls.java.home": "~/.local/share/mise/installs/java/latest",
    "java.project.sourcePaths": [ ".claude/skills/use-ghidra/scripts" ],
    "java.project.referencedLibraries": [ "/opt/homebrew/opt/ghidra/libexec/Ghidra/**/lib/*.jar" ],
    "java.format.settings.google.extra": "--aosp",
    "[java]": { "editor.defaultFormatter": "josevseb.google-java-format-for-vs-code" },

    // --- [TOML] ------------------------------------------------------------------------
    "[toml]": { "editor.defaultFormatter": "tombi-toml.tombi" }
}
