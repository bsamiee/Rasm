{
    "name": "@rasm/test-nx",
    "private": true,
    "description": "Nx suites over this workspace: graph structure and stability, cache replay, affected reach, task graph and scheduling, sync and executor schemas, release configuration, and the contract every plugin row of nx.json meets",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/process": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "ajv": "catalog:",
        "effect": "catalog:",
        "minimatch": "catalog:",
        "nx": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "tags": [ "os:all" ],
        "implicitDependencies": [ "@rasm/nx-*" ],
        "targets": {
            "test--vitest": {
                "inputs": [
                    "...",
                    {
                        "runtime": "node -p process.platform+process.arch"
                    }
                ]
            }
        }
    }
}
