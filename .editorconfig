dotnet_diagnostic.RCS1199.severity = error                                    # HasValue && Value reads == true.
dotnet_diagnostic.RCS1200.severity = error                                    # ThenBy after OrderBy.
dotnet_diagnostic.RCS1201.severity = error                                    # Hidden default: consecutive calls on one receiver chain.
dotnet_diagnostic.RCS1202.severity = error                                    # FirstOrDefault().Member dereferences null.
dotnet_diagnostic.RCS1204.severity = error                                    # EventArgs.Empty over new EventArgs().
dotnet_diagnostic.RCS1205.severity = error                                    # Named arguments follow parameter order.
dotnet_diagnostic.RCS1208.severity = none                                     # Rewrites a trailing if into a guard return; density owns the shape.
dotnet_diagnostic.RCS1209.severity = error                                    # Type-parameter constraints follow declaration order.
dotnet_diagnostic.RCS1218.severity = error                                    # if/else and loop shapes with one live branch.
dotnet_diagnostic.RCS1222.severity = error                                    # Adjacent #pragma directives merge.
