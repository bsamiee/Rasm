{
    "name": "@rasm/typography",
    "version": "0.1.0",
    "private": true,
    "description": "OpenType typesetting from font faces to composed text, with Arabic-script joining, kashida, kerning, verse, and Quran text with the signs a face draws",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/graphics/typography"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./error": "./error.ts",
        "./settings": "./settings.ts",
        "./source": "./source.ts",
        "./arabic/joining": "./arabic/joining.ts",
        "./arabic/kashida": "./arabic/kashida.ts",
        "./arabic/kerning": "./arabic/kerning.ts",
        "./arabic/quran/symbols": "./arabic/quran/symbols.ts",
        "./arabic/quran/text": "./arabic/quran/text.ts",
        "./arabic/verse": "./arabic/verse.ts",
        "./shaping/face": "./shaping/face.ts",
        "./shaping/justification": "./shaping/justification.ts",
        "./shaping/shaped-text": "./shaping/shaped-text.ts",
        "./shaping/text-column": "./shaping/text-column.ts",
        "./shaping/word": "./shaping/word.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./error": "./dist/error.js",
            "./settings": "./dist/settings.js",
            "./source": "./dist/source.js",
            "./arabic/joining": "./dist/arabic/joining.js",
            "./arabic/kashida": "./dist/arabic/kashida.js",
            "./arabic/kerning": "./dist/arabic/kerning.js",
            "./arabic/quran/symbols": "./dist/arabic/quran/symbols.js",
            "./arabic/quran/text": "./dist/arabic/quran/text.js",
            "./arabic/verse": "./dist/arabic/verse.js",
            "./shaping/face": "./dist/shaping/face.js",
            "./shaping/justification": "./dist/shaping/justification.js",
            "./shaping/shaped-text": "./dist/shaping/shaped-text.js",
            "./shaping/text-column": "./dist/shaping/text-column.js",
            "./shaping/word": "./dist/shaping/word.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@noble/hashes": "catalog:",
        "@quran.ws/text": "catalog:",
        "@rasm/search": "workspace:*",
        "fontkit": "catalog:",
        "harfbuzzjs": "catalog:",
        "icu": "catalog:",
        "quran-meta": "catalog:"
    },
    "devDependencies": {
        "@types/fontkit": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
