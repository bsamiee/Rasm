{
    "name": "@rasm/media",
    "version": "0.1.0",
    "private": true,
    "description": "Media inspection, Uppy upload preprocessing, and pdf.js document viewing in the browser, with the Vite copy of pdf.js assets",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/media"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./pdf-document": "./pdf-document.ts",
        "./pdf-viewer": "./pdf-viewer.tsx",
        "./vite": "./vite.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@use-gesture/react": "catalog:",
        "vite-plugin-static-copy": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@uppy/core": "catalog:",
        "effect": "catalog:",
        "pdfjs-dist": "catalog:",
        "react": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "@uppy/core": "catalog:peers",
        "effect": "catalog:peers",
        "pdfjs-dist": "catalog:peers",
        "react": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./pdf-document": "./dist/pdf-document.js",
            "./pdf-viewer": "./dist/pdf-viewer.js",
            "./vite": "./dist/vite.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
