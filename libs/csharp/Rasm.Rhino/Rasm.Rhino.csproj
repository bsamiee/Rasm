<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Rhino 9 host boundary for Rasm: document, commands, blocks, viewport, display, exchange, native Eto UI, and Rhino.UI shell.</Description>
        <CspScope>Boundary</CspScope>
    </PropertyGroup>

    <ItemGroup Label="Project References">
        <ProjectReference Include="../Rasm/Rasm.csproj" />
    </ItemGroup>

    <ItemGroup Label="Core Substrate">
        <PackageReference Include="CommunityToolkit.HighPerformance" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="QuikGraph" />
        <PackageReference Include="Riok.Mapperly" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Label="Observability">
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
    </ItemGroup>

    <ItemGroup Label="Wire Codegen">
        <PackageReference Include="Google.Protobuf" />
    </ItemGroup>

    <ItemGroup Label="Rhino Usings">
        <Using Include="Rhino" />
        <Using Include="Rhino.Commands" />
        <Using Include="Rhino.Display" />
        <Using Include="Rhino.DocObjects" />
        <Using Include="Rhino.FileIO" />
        <Using Include="Rhino.Geometry" />
        <Using Include="Rhino.Input" />
        <Using Include="Rhino.Input.Custom" />
        <Using Include="Rhino.PlugIns" />
        <Using Include="Rhino.UI" />
        <Using Include="Rhino.UI.Gumball" />
        <Using Include="Rhino.DocObjects.Font" Alias="Font" />
        <Using Include="Rhino.Render.ChangeQueue" Alias="Cq" />
    </ItemGroup>

    <ItemGroup Label="Eto Usings">
        <Using Include="Eto.Drawing" />
        <Using Include="Eto.Forms" />
        <Using Include="Eto.Drawing.Matrix" Alias="Matrix" />
    </ItemGroup>

    <ItemGroup Label="Domain Usings">
        <Using Include="Rasm.Domain" />
        <Using Include="Rasm.Rhino.Document.Fact&lt;Rasm.Rhino.Annotation.DraftSlot, Rasm.Rhino.Annotation.DraftBody&gt;" Alias="DraftFact" />
        <Using Include="Rasm.Rhino.Document.FactStream&lt;Rasm.Rhino.Annotation.DraftSlot, Rasm.Rhino.Annotation.DraftBody&gt;" Alias="DraftReceipt" />
        <Using Include="Rasm.Rhino.Document.Fact&lt;Rasm.Rhino.Blocks.BlockSlot, Rasm.Rhino.Blocks.BlockBody&gt;" Alias="BlockFact" />
        <Using Include="Rasm.Rhino.Document.FactStream&lt;Rasm.Rhino.Blocks.BlockSlot, Rasm.Rhino.Blocks.BlockBody&gt;" Alias="BlockReceipt" />
        <Using Include="Rasm.Rhino.Document.Fact&lt;Rasm.Rhino.Objects.LightSlot, Rasm.Rhino.Objects.LightBody&gt;" Alias="LightFact" />
        <Using Include="Rasm.Rhino.Document.FactStream&lt;Rasm.Rhino.Objects.LightSlot, Rasm.Rhino.Objects.LightBody&gt;" Alias="LightReceipt" />
        <Using Include="Rasm.Rhino.Document.Fact&lt;Rasm.Rhino.Objects.MaterialSlot, Rasm.Rhino.Objects.MaterialBody&gt;" Alias="MaterialFact" />
        <Using Include="Rasm.Rhino.Document.FactStream&lt;Rasm.Rhino.Objects.MaterialSlot, Rasm.Rhino.Objects.MaterialBody&gt;" Alias="MaterialReceipt" />
        <Using Include="Rasm.Rhino.Document.Fact&lt;Rasm.Rhino.Objects.HistorySlot, Rasm.Rhino.Objects.HistoryBody&gt;" Alias="HistoryFact" />
        <Using Include="Rasm.Rhino.Document.FactStream&lt;Rasm.Rhino.Objects.HistorySlot, Rasm.Rhino.Objects.HistoryBody&gt;" Alias="HistoryReceipt" />
    </ItemGroup>
</Project>
