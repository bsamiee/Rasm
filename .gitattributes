# Text normalizes to LF and binaries auto-detect, Verify snapshots need exact LF bytes
* text=auto eol=lf

# Binary design assets commit as Git LFS pointers

# --- [RHINO] ------------------------------------------------------------------
*.3dm filter=lfs diff=lfs merge=lfs -text
