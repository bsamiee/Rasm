{
    "name": "@rasm/vite",
    "version": "0.1.0",
    "description": "Vite plugins and configs for Rasm builds, failing a build on Rolldown warnings that break output, building Chrome extensions from manifest.json, and bundling agent harness plugins from hooks/hooks.json, package.json bin programs, and package.json files",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/vite"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./checks": "./checks.ts",
        "./chrome": "./chrome.ts",
        "./claude": "./claude.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./checks": "./dist/checks.js",
            "./chrome": "./dist/chrome.js",
            "./claude": "./dist/claude.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/mark": "workspace:*"
    },
    "devDependencies": {
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "culori": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "culori": "catalog:peers",
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "culori": {
            "optional": true
        },
        "effect": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
