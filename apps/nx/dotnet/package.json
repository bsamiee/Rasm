{
    "name": "@rasm/nx-dotnet",
    "version": "0.0.0",
    "description": "Nx plugin inferring MSBuild projects, their restores, builds, checks, tests, fixes, and NuGet releases from one MSBuild evaluation of the workspace",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/dotnet"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#analyzer": "./analyzer/dist/MsbuildAnalyzer.dll"
    },
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "analyzer/dist", "executors.json", "executors/*/schema.json" ],
    "scripts": {
        "prepare": "dotnet build analyzer --configuration Release"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:",
        "verkit": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugins/project-graph.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js",
            "#analyzer": "./analyzer/dist/MsbuildAnalyzer.dll"
        }
    },
    "executors": "./executors.json",
    "nx": {
        "includedScripts": []
    }
}
