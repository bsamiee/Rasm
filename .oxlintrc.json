{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "react", "jsx-a11y"],
    "categories": { "correctness": "error", "suspicious": "error", "pedantic": "error", "perf": "error", "style": "error", "restriction": "error", "nursery": "error" },
    "options": { "typeAware": true, "reportUnusedDisableDirectives": "error" },
    "ignorePatterns": [".claude/workflows/**"],
    "rules": {
        "func-names": "off",
        "id-length": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "new-cap": "off",
        "no-implicit-coercion": "off",
        "no-magic-numbers": "off",
        "no-redeclare": "off",
        "no-ternary": "off",
        "no-undef": "off",
        "no-undefined": "off",
        "no-underscore-dangle": "off",
        "no-use-before-define": "off",
        "one-var": "off",
        "sort-imports": "off",
        "sort-keys": "off",
        "class-methods-use-this": ["error", { "ignoreOverrideMethods": true }],
        "max-classes-per-file": "off",
        "max-nested-callbacks": ["error", { "max": 3 }],
        "max-params": ["error", { "max": 10 }],
        "no-bitwise": ["error", { "allow": ["&"] }],
        "no-param-reassign": ["error", { "props": true }],
        "no-restricted-globals": [
            "error",
            { "name": "Buffer", "message": "Import `Buffer` from `node:buffer`, so the load graph sees the host module" },
            { "name": "clearImmediate", "message": "Import `clearImmediate` from `node:timers`, so the load graph sees the host module" },
            { "name": "global", "message": "Use `globalThis`" },
            { "name": "setImmediate", "message": "Import `setImmediate` from `node:timers`, so the load graph sees the host module" }
        ],
        "no-restricted-imports": [
            "error",
            {
                "paths": [
                    { "name": "@effect/platform-node", "message": "Import the module subpath (`@effect/platform-node/NodeRuntime`), the package entry evaluates every Node service module" },
                    { "name": "smol-toml", "message": "Parse TOML through `Toml.parse` from `effect/encoding`" },
                    { "name": "yaml", "importNames": ["parse"], "message": "Parse YAML through `Yaml.parse` from `effect/encoding`" }
                ],
                "patterns": [{ "group": ["./**", "../**", ".", ".."], "message": "Import the package's own modules through `#/` and other packages through their `@rasm/<lib>` entries" }]
            }
        ],
        "no-unused-vars": ["error", { "args": "all", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        "import/consistent-type-specifier-style": "off",
        "import/default": "off",
        "import/max-dependencies": "off",
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "pdfjs-dist"] }],
        "import/no-named-export": "off",
        "import/no-nodejs-modules": "off",
        "import/no-relative-parent-imports": "off",
        "import/prefer-default-export": "off",
        "node/no-sync": "off",
        "node/no-top-level-await": "off",
        "oxc/no-async-await": "off",
        "oxc/no-map-spread": "off",
        "oxc/no-optional-chaining": "off",
        "oxc/no-rest-spread-properties": "off",
        "promise/prefer-await-to-callbacks": "off",
        "promise/prefer-await-to-then": "off",
        "promise/valid-params": "off",
        "jsx-a11y/no-autofocus": ["error", { "ignoreNonDOM": true }],
        "react/capitalized-calls": "off",
        "react/forbid-component-props": "off",
        "react/function-component-definition": ["error", { "namedComponents": "arrow-function", "unnamedComponents": "arrow-function" }],
        "react/jsx-filename-extension": ["error", { "extensions": ["tsx"] }],
        "react/jsx-max-depth": "off",
        "react/jsx-no-literals": "off",
        "react/jsx-props-no-spreading": "off",
        "react/no-multi-comp": "off",
        "react/no-unstable-nested-components": "off",
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "off",
        "typescript/consistent-indexed-object-style": "off",
        "typescript/consistent-type-exports": ["error", { "fixMixedExportsWithInlineTypeSpecifier": true }],
        "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
        "typescript/explicit-function-return-type": "off",
        "typescript/explicit-member-accessibility": ["error", { "accessibility": "no-public" }],
        "typescript/explicit-module-boundary-types": "off",
        "typescript/no-generated-empty-object-type": "off",
        "typescript/no-invalid-void-type": "off",
        "typescript/no-misused-spread": "off",
        "typescript/no-unnecessary-type-arguments": "off",
        "typescript/unbound-method": "off",
        "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
        "typescript/prefer-readonly-parameter-types": "off",
        "typescript/promise-function-async": "off",
        "typescript/strict-void-return": "off",
        "unicorn/import-style": ["error", { "styles": { "node:path": { "named": true, "default": false } } }],
        "unicorn/max-nested-calls": "off",
        "unicorn/no-array-callback-reference": "off",
        "unicorn/no-array-for-each": "off",
        "unicorn/no-array-method-this-argument": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/no-null": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/number-literal-case": "off",
        "unicorn/prefer-dom-node-text-content": "off",
        "unicorn/prefer-number-properties": "off",
        "unicorn/prefer-prototype-methods": "off",
        "unicorn/prefer-query-selector": "off",
        "unicorn/prefer-spread": "off",
        "unicorn/require-post-message-target-origin": "off",
        "unicorn/text-encoding-identifier-case": "off",
        "unicorn/throw-new-error": "off"
    },
    "overrides": [
        {
            "files": ["**/*.config.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            { "name": "@effect/platform-node", "message": "Import the module subpath (`@effect/platform-node/NodeRuntime`), the package entry evaluates every Node service module" },
                            { "name": "smol-toml", "message": "Parse TOML through `Toml.parse` from `effect/encoding`" },
                            { "name": "yaml", "importNames": ["parse"], "message": "Parse YAML through `Yaml.parse` from `effect/encoding`" }
                        ],
                        "patterns": [
                            { "group": ["**/package.json", "#/package.json"], "message": "Build helpers read the project manifest from the directory they take" },
                            { "group": ["./**", "../**", "!../**/nx.json", ".", ".."], "message": "Import the package's own modules through `#/` and other packages through their `@rasm/<lib>` entries, and nx.json by its relative path" }
                        ]
                    }
                ]
            }
        },
        { "files": ["**/*.config.ts", "**/server/worker.ts", "**/version-actions.ts", "**/.storybook/*.{ts,tsx}", "**/extendscript.ts", "tools/ast-grep/grammars/*/grammar.js"], "rules": { "import/no-default-export": "off" } },
        {
            "files": ["**/extendscript/**", "**/extendscript.ts"],
            "rules": {
                "guard-for-in": "off",
                "prefer-named-capture-group": "off",
                "prefer-object-has-own": "off",
                "require-unicode-regexp": "off",
                "typescript/only-throw-error": "off",
                "typescript/prefer-string-starts-ends-with": "off",
                "unicorn/prefer-at": "off",
                "unicorn/prefer-code-point": "off",
                "unicorn/prefer-string-replace-all": "off"
            }
        },
        { "files": ["**/*.tsx"], "rules": { "react/rules-of-hooks": "error" } },
        { "files": ["plugins/*/hooks/**"], "rules": { "node/callback-return": "off", "promise/no-callback-in-promise": "off", "unicorn/catch-error-name": "off" } },
        {
            "files": ["**/*.test.ts", "**/*.test.tsx"],
            "excludeFiles": ["plugins/*/hooks/*.test.ts"],
            "plugins": ["vitest"],
            "rules": {
                "vitest/consistent-test-it": ["error", { "fn": "it" }],
                "vitest/no-importing-vitest-globals": "off",
                "vitest/prefer-expect-assertions": "off",
                "vitest/require-hook": "off",
                "vitest/require-test-timeout": "off",
                "vitest/require-top-level-describe": "off"
            }
        },
        {
            "files": ["libs/python/blender/rendering/rasm_rendering/_batch/rasm_render.js", "apps/rhino/Darkroom/EmbeddedResources/darkroom_render.js"],
            "rules": {
                "import/unambiguous": "off",
                "typescript/no-unsafe-argument": "off",
                "typescript/no-unsafe-assignment": "off",
                "typescript/no-unsafe-call": "off",
                "typescript/no-unsafe-member-access": "off",
                "typescript/no-unsafe-return": "off",
                "unicorn/filename-case": "off"
            }
        },
        {
            "files": ["libs/typescript/graphics/typography/**"],
            "rules": {
                "typescript/no-unsafe-argument": "off",
                "typescript/no-unsafe-assignment": "off",
                "typescript/no-unsafe-call": "off",
                "typescript/no-unsafe-member-access": "off",
                "typescript/no-unsafe-return": "off"
            }
        },
        {
            "files": ["tools/ast-grep/grammars/**"],
            "rules": {
                "typescript/no-unsafe-argument": "off",
                "typescript/no-unsafe-assignment": "off",
                "typescript/no-unsafe-call": "off",
                "typescript/no-unsafe-member-access": "off",
                "typescript/no-unsafe-return": "off",
                "typescript/prefer-nullish-coalescing": "off",
                "typescript/strict-boolean-expressions": "off"
            }
        }
    ]
}
