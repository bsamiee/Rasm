{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "cacheDirectory": ".cache/nx/cache",
    "maxCacheSize": "8GB",
    "useDaemonProcess": false,
    "analytics": false,
    "neverConnectToCloud": true,
    "sync": { "globalGenerators": [ "@rasm/nx-devkit:executor-schemas" ] },
    "plugins": [
        { "plugin": "@rasm/nx-apple", "options": { "trustPackages": true } },
        "@rasm/nx-cargo",
        { "plugin": "@rasm/nx-uv", "exclude": [ ".config/mise/locks/**" ] },
        { "plugin": "@rasm/nx-dotnet", "options": { "apiKey": "NUGET_API_KEY" } },
        "@rasm/nx-docker",
        "@rasm/nx-pulumi",
        "@rasm/nx-buf",
        { "plugin": "@rasm/nx-typescript", "options": { "targets": { "{build,check}--tsc": { "dependsOn": [ "...", "build--buf", "^build--buf", "build--cf" ], "inputs": [ "...", { "dependentTasksOutputFiles": "**/*", "transitive": true }, { "externalDependencies": [ "@effect/tsgo" ] } ] } } } },
        { "plugin": "@rasm/nx-vite", "options": { "targets": { "{build,serve}--vite": { "dependsOn": [ "...", "build--buf", "^build--buf" ], "inputs": [ "...", { "dependentTasksOutputFiles": "**/*", "transitive": true } ] } } } },
        { "plugin": "@rasm/nx-vitest", "options": { "targets": { "test--vitest": { "dependsOn": [ "...", "build--buf", "^build--buf" ], "inputs": [ "...", { "dependentTasksOutputFiles": "**/*", "transitive": true } ] } } } },
        "@rasm/nx-storybook",
        "@rasm/nx-cloudflare",
        "@rasm/nx-playwright",
        "@rasm/nx-distribution"
    ],
    "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false, "projectsAffectedByDependencyUpdates": "auto" }, "@rasm/nx-devkit": { "outputPath": ".artifacts", "tags": { "os": "os:{os}", "host": "host:{host}", "release": "release" } } },
    "release": {
        "projects": [ "tag:npm:public", "tag:release" ],
        "projectsRelationship": "independent",
        "releaseTag": { "pattern": "{projectName}@{version}" },
        "version": { "conventionalCommits": true, "fallbackCurrentVersionResolver": "disk" },
        "conventionalCommits": { "useCommitScope": false, "types": { "refactor": { "semverBump": "patch" }, "perf": { "semverBump": "patch" } } },
        "changelog": { "automaticFromRef": true, "projectChangelogs": { "file": false, "createRelease": "github", "entryWhenNoChanges": "{projectName} release with no new commits", "renderOptions": { "authors": false } } }
    }
}
