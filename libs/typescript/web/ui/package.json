        "@storybook/addon-docs": "catalog:",
        "@storybook/addon-vitest": "catalog:",
        "@storybook/react-vite": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "effect": "catalog:",
        "react": "catalog:",
        "react-aria-components": "catalog:",
        "react-dom": "catalog:",
        "storybook": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@effect/atom-react": "catalog:peers",
        "effect": "catalog:peers",
        "react": "catalog:peers",
        "react-aria-components": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js"
        },
