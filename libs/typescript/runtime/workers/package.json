{
    "name": "@rasm/workers",
    "version": "0.1.0",
    "private": true,
    "description": "Cloudflare Workers entry module of an Effect program: one layer built once per isolate and projected into fetch, scheduled, and queue handlers, and a hosted App served as a Worker with its bindings decoded",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/runtime/workers"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./runtime/worker.ts",
        "./execution": "./runtime/execution.ts",
        "./serve": "./runtime/serve.ts"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/runtime/worker.js",
            "./execution": "./dist/runtime/execution.js",
            "./serve": "./dist/runtime/serve.js"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/telemetry": "workspace:*"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:",
        "@rasm/hosting": "workspace:*",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "@rasm/hosting": "workspace:*",
        "effect": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@rasm/hosting": {
            "optional": true
        }
    }
}
