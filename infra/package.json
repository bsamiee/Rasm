{
    "name": "@rasm/infra",
    "private": true,
    "description": "Pulumi programs for the repository, machines, and app hosting",
    "bin": "./stacks.ts",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@playwright/test": "catalog:",
        "@pulumi/aws": "catalog:",
        "@pulumi/cloudflare": "catalog:",
        "@pulumi/command": "catalog:",
        "@pulumi/docker": "catalog:",
        "@pulumi/docker-build": "catalog:",
        "@pulumi/gcp": "catalog:",
        "@pulumi/github": "catalog:",
        "@pulumi/hostinger": "file:sdks/hostinger",
        "@pulumi/minio": "file:sdks/minio",
        "@pulumi/pulumi": "catalog:",
        "@pulumi/tailscale": "catalog:",
        "@pulumiverse/doppler": "catalog:",
        "@rasm/hosting": "workspace:*",
        "@rasm/process": "workspace:*",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:"
    },
    "nx": {
        "namedInputs": {
            "deployed": [
                {
                    "json": "{workspaceRoot}/package.json",
                    "fields": [
                        "name",
                        "description",
                        "repository"
                    ]
                },
                "{workspaceRoot}/.config/sparkle.xcconfig",
                {
                    "json": "{workspaceRoot}/**/*.uproject",
                    "fields": [
                        "EngineAssociation"
                    ]
                },
                "{workspaceRoot}/.github/ISSUE_TEMPLATE/!(config).yml",
                "{workspaceRoot}/.config/mise/conf.d/remote.toml",
                "{workspaceRoot}/.config/mise.machine.toml",
                "{workspaceRoot}/.config/mise.runner.toml"
            ]
        },
        "targets": {
            "deploy--pulumi": {
                "inputs": [
                    "...",
                    "deployed"
                ]
            },
            "dry-run--pulumi": {
                "inputs": [
                    "...",
                    "deployed"
                ]
            }
        }
    }
}
