{
    "name": "@rasm/illustrator",
    "version": "0.1.0",
    "private": true,
    "description": "Illustrator DOM: the alert-suppressing script host for do javascript, and for UXP plugins its containment table, alert suppression, script evaluation, and a document, artboard, or page item rendered as PNG through a temporary artboard",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/illustrator"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./script.ts",
        "./uxp": "./uxp.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/script.js",
            "./uxp": "./dist/uxp.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/extendscript": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/uxp": "workspace:*"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
