{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "zellij-agent-resume claude",
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "atuin hook claude-code",
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "atuin hook claude-code",
                        "async": true
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "atuin hook claude-code",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "matcher": "prompt_input_exit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "zellij-agent-resume claude"
                    }
                ]
            }
        ]
    }
}
