{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "cacheDirectory": ".cache/nx/cache",
    "neverConnectToCloud": true,
    "workspaceLayout": {
        "appsDir": "apps",
        "libsDir": "libs/typescript"
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/**/*.{spec,test,bench}.{ts,tsx,mts,cts}",
            "!{projectRoot}/**/*.{pw,k6}.ts",
            "!{projectRoot}/dist/**/*"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/.gitignore",
            "{workspaceRoot}/biome.json",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/playwright.config.ts",
            "{workspaceRoot}/pnpm-lock.yaml",
            "{workspaceRoot}/pnpm-workspace.yaml",
            "{workspaceRoot}/stryker.config.json",
            "{workspaceRoot}/tests/containers.json",
            "{workspaceRoot}/tools/biome/*.grit",
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/tsconfig.json",
            "{workspaceRoot}/tsconfig.node.json",
            "{workspaceRoot}/tsconfig.tools.json",
            "{workspaceRoot}/vite.config.ts",
            "{workspaceRoot}/vitest.config.ts"
        ]
    },
    "targetDefaults": {
        "build": {
            "cache": true,
            "inputs": ["...", "production", "^production"]
        },
        "typecheck": {
            "cache": true,
            "command": "tsc --build --pretty false",
            "options": {
                "cwd": "{projectRoot}"
            },
            "dependsOn": ["^typecheck"],
            "inputs": [
                "default",
                "^production",
                {
                    "externalDependencies": ["typescript"]
                }
            ],
            "outputs": ["{projectRoot}/dist"]
        },
        "e2e": {
            "cache": true,
            "inputs": ["...", "^production"]
        },
        "test": {
            "cache": true,
            "inputs": [
                "...",
                "^production",
                {
                    "externalDependencies": ["vitest"]
                }
            ]
        }
    },
    "pluginsConfig": {
        "@nx/js": {
            "analyzeSourceFiles": false
        }
    },
    "plugins": [
        {
            "plugin": "@nx/vite/plugin",
            "options": {
                "compiler": "tsc",
                "typecheckTargetName": "typecheck"
            }
        },
        {
            "plugin": "@nx/vitest",
            "options": {
                "testTargetName": "test",
                "discoverTestFiles": "glob"
            }
        },
        {
            "plugin": "@nx/playwright/plugin",
            "options": {
                "ciTargetName": "e2e-ci",
                "targetName": "e2e"
            }
        },
        {
            "plugin": "@nx/dotnet",
            "options": {
                "clean": false,
                "pack": false,
                "publish": false,
                "restore": false,
                "test": false
            }
        }
    ],
    "sync": {
        "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
    },
    "tui": {
        "enabled": true
    }
}
