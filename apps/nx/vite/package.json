{
    "name": "@rasm/nx-vite",
    "version": "0.0.0",
    "description": "Nx plugin inferring Vite builds, and the development and preview servers of configs holding its readySignal() plugin or stating a server, from Vite's own resolved configuration",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/vite"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./plugin.ts",
        "./ready-signal": "./ready-signal.ts",
        "./package.json": "./package.json"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@nx/js": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers",
        "vite": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugin.js",
            "./ready-signal": "./dist/ready-signal.js",
            "./package.json": "./package.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
