{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": 2,
    "type": "object",
    "properties": {
        "exports": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "archive": {
                        "type": "string"
                    },
                    "folder": {
                        "type": "string"
                    },
                    "run": {
                        "type": "array",
                        "minItems": 1,
                        "description": "The xcodebuild archive invocation that writes the archive",
                        "items": [
                            {
                                "type": "string"
                            }
                        ],
                        "additionalItems": {
                            "type": "string"
                        }
                    }
                },
                "required": [ "archive", "folder", "run" ],
                "additionalProperties": true
            }
        },
        "products": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "package": {
                        "type": "string"
                    },
                    "product": {
                        "type": "string"
                    },
                    "folder": {
                        "type": "string"
                    }
                },
                "required": [ "package", "product", "folder" ],
                "additionalProperties": true
            }
        },
        "notary": {
            "type": "object",
            "properties": {
                "key": {
                    "type": "string",
                    "description": "Variable holding the App Store Connect .p8 key"
                },
                "keyId": {
                    "type": "string",
                    "description": "Variable holding the App Store Connect key id"
                },
                "issuer": {
                    "type": "string",
                    "description": "Variable holding the App Store Connect issuer id"
                }
            },
            "required": [ "key", "keyId", "issuer" ],
            "additionalProperties": true,
            "description": "Variables naming the App Store Connect key that notarizes a disk image, absent zipping each app alone"
        },
        "__unparsed__": {
            "type": "array",
            "description": "Words after -- of the run, appended after the configured arguments",
            "$default": {
                "$source": "unparsed"
            },
            "hidden": true,
            "x-priority": "internal",
            "items": {
                "type": "string"
            }
        }
    },
    "additionalProperties": true,
    "title": "Package",
    "description": "Archives each app with its xcodebuild invocation and builds each SwiftPM executable product in release, then zips each under its bundle or product name with ditto; where the variables notary names are set, exports each archive under the Developer ID Application identity into a disk image in place of the zip, signs it, notarizes it with that App Store Connect key, and staples the ticket"
}
