{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/zellij-agent-resume codex",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/atuin hook codex",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "command": "/Users/bardiasamiee/.git-ai/bin/git-ai checkpoint codex --hook-input stdin",
                        "type": "command"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "^Bash$",
                "hooks": [
                    {
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/atuin hook codex",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "command": "/Users/bardiasamiee/.git-ai/bin/git-ai checkpoint codex --hook-input stdin",
                        "type": "command"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "command": "/Users/bardiasamiee/.git-ai/bin/git-ai checkpoint codex --hook-input stdin",
                        "type": "command"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "command": "/etc/profiles/per-user/bardiasamiee/bin/zellij-agent-resume codex",
                        "timeout": 3,
                        "type": "command"
                    }
                ]
            }
        ]
    }
}
