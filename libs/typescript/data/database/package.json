{
    "name": "@rasm/database",
    "private": true,
    "description": "Databases reconciled to their declared schemas",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./pg": "./pg.ts"
    },
    "dependencies": {
        "@effect/sql-d1": "catalog:",
        "@effect/sql-pg": "catalog:",
        "@effect/sql-pglite": "catalog:",
        "@pgsql/traverse": "catalog:",
        "@pgsql/types": "catalog:",
        "effect": "catalog:",
        "pgsql-parser": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/sql-sqlite-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@electric-sql/pglite": "catalog:",
        "@rasm/test-support": "workspace:*",
        "@testcontainers/postgresql": "catalog:",
        "@types/node": "catalog:",
        "cf": "catalog:",
        "testcontainers": "catalog:",
        "vitest": "catalog:"
    }
}
