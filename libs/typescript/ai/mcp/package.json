{
    "name": "@rasm/mcp",
    "version": "0.1.0",
    "private": true,
    "description": "Effect programs exposed to agents as tools and resources, and a client that opens a new session after its server restarts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/ai/mcp"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./node": "./node.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/search": "workspace:*",
        "@rasm/telemetry": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./node": "./dist/node.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
