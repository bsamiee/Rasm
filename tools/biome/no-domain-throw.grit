language js(typescript, jsx)

`throw $err` where {
    $err <: not within `Effect.try($_)` ,
    $err <: not within `Effect.tryPromise($_)` ,
    register_diagnostic(span=$err, message="Raw throw in domain flow. Fail through the typed error channel: Effect.fail with a tagged error, or wrap the throwing call in Effect.try/Effect.tryPromise.", severity="error")
}
