<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Description>Throw-away lab that compiles every code block of the functional C# corpus under the repo analyzers.</Description>
    </PropertyGroup>

    <ItemGroup Label="Core Substrate">
        <PackageReference Include="CsCheck" />
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="LanguageExt.Streaming" />
        <PackageReference Include="LanguageExt.Sys" />
    </ItemGroup>

    <ItemGroup Label="Thinktecture">
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Json" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Serilog" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Sinks.Console" />
    </ItemGroup>

    <ItemGroup Label="System Usings">
        <Using Include="System.Globalization" />
        <Using Include="Serilog;Serilog.Core" />
    </ItemGroup>
</Project>
