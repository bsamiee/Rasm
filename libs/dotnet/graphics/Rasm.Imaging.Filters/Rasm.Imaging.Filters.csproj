<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Image effects and generators over Rasm.Imaging frames</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.HighPerformance" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="PeterO.Numbers" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Imaging">
        <PackageReference Include="Emgu.CV" />
        <PackageReference Include="Emgu.CV.runtime.mini.macos" />
        <PackageReference Include="SixLabors.ImageSharp" />
    </ItemGroup>

    <ItemGroup Label="Workspace Packages">
        <ProjectReference Include="../Rasm.Imaging/Rasm.Imaging.csproj" />
    </ItemGroup>

    <ItemGroup Label="Workspace Sources">
        <Compile Include="../../ValidationResults.cs" />
    </ItemGroup>
</Project>
