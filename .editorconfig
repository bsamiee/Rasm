root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
# --- [NAMESPACE_AND_IMPORTS] ------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error                       # File-scoped namespaces
dotnet_style_namespace_match_folder = true:error                              # Namespace matches the folder path
dotnet_style_require_accessibility_modifiers = always:error                   # Explicit accessibility modifiers
csharp_using_directive_placement = outside_namespace:error                    # Using directives outside the namespace

# --- [TYPE_EXPLICITNESS] ----------------------------------------------------------------
csharp_style_var_for_built_in_types = false:error                             # No var for built-in types
csharp_style_var_when_type_is_apparent = false:error                          # No var when the type is apparent
csharp_style_var_elsewhere = false:error                                      # No var elsewhere
dotnet_style_predefined_type_for_locals_parameters_members = true:error       # Language keywords (int, string) in declarations
dotnet_style_predefined_type_for_member_access = true:error                   # Language keywords in member access
dotnet_style_qualification_for_field = false:error                            # No this. on fields
dotnet_style_qualification_for_property = false:error                         # No this. on properties
dotnet_style_qualification_for_method = false:error                           # No this. on methods
dotnet_style_qualification_for_event = false:error                            # No this. on events
dotnet_style_readonly_field = true:error                                      # readonly on fields that are never reassigned
csharp_style_prefer_readonly_struct = true:error                              # readonly structs avoid defensive copies
csharp_style_prefer_readonly_struct_member = true:error                       # readonly struct members where possible

# --- [CONTROL_FLOW_AND_PATTERNS] --------------------------------------------------------
csharp_style_pattern_matching_over_is_with_cast_check = true:error            # Pattern matching over is + cast
csharp_style_pattern_matching_over_as_with_null_check = true:error            # Pattern matching over as + null check
csharp_style_prefer_pattern_matching = true:error                             # Pattern matching over equivalent checks
csharp_style_prefer_not_pattern = true:error                                  # is not pattern
csharp_style_prefer_extended_property_pattern = true:error                    # Extended property patterns for nested members
csharp_style_prefer_switch_expression = true:error                            # Switch expressions over switch statements
csharp_style_prefer_null_check_over_type_check = true:error                   # Null check over type check
dotnet_style_prefer_conditional_expression_over_return = true:error           # Conditional expression over if/else return
dotnet_style_prefer_conditional_expression_over_assignment = true:error       # Conditional expression over if/else assignment
dotnet_style_prefer_compound_assignment = true:error                          # Compound assignment
dotnet_style_prefer_simplified_boolean_expressions = true:error               # Simplified boolean expressions
dotnet_style_prefer_simplified_interpolation = true:error                     # Simplified string interpolation
csharp_style_inlined_variable_declaration = true:error                        # Inline out variable declarations

# --- [SYNTAX_AND_CONCISION] -------------------------------------------------------------
csharp_style_prefer_primary_constructors = true:error                         # Primary constructors
dotnet_style_prefer_collection_expression = when_types_loosely_match:error    # Collection expressions for interface targets too
csharp_style_implicit_object_creation_when_type_is_apparent = true:error      # Target-typed new when the type is apparent
dotnet_style_object_initializer = true:error                                  # Object initializers
dotnet_style_collection_initializer = true:error                              # Collection initializers
dotnet_style_prefer_inferred_tuple_names = true:error                         # Inferred tuple element names
dotnet_style_explicit_tuple_names = true:error                                # Tuple element names over ItemN
dotnet_style_prefer_inferred_anonymous_type_member_names = true:error         # Inferred anonymous type member names
csharp_style_deconstructed_variable_declaration = true:error                  # Deconstruction for tuple assignment
csharp_style_prefer_tuple_swap = true:error                                   # Tuple swap
csharp_style_prefer_index_operator = true:error                               # Index operator (^)
csharp_style_prefer_range_operator = true:error                               # Range operator (..)
csharp_prefer_simple_using_statement = true:error                             # using declarations over using blocks
csharp_prefer_static_local_function = true:error                              # static local functions when nothing is captured
csharp_prefer_static_anonymous_function = true:error                          # static lambdas when nothing is captured
csharp_style_prefer_method_group_conversion = true:error                      # Method groups over equivalent lambdas
csharp_style_prefer_local_over_anonymous_function = false:error               # Lambdas allowed over local functions
csharp_style_prefer_top_level_statements = false:error                        # No top-level statements
csharp_style_prefer_utf8_string_literals = true:error                         # UTF-8 string literals
csharp_prefer_simple_default_expression = true:error                          # default literal over default(T)
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:error # Parentheses in arithmetic operators for clarity
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:error # Parentheses in relational operators for clarity
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:error # Parentheses in other binary operators for clarity
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:error      # No unnecessary parentheses elsewhere

# --- [NULL_AND_EXPRESSION_SAFETY] -------------------------------------------------------
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error # is null over ReferenceEquals
dotnet_style_null_propagation = true:error                                    # Null propagation (?.)
dotnet_style_coalesce_expression = true:error                                 # Null coalescing (??)
csharp_style_conditional_delegate_call = true:error                           # Conditional delegate invocation (?.Invoke)
csharp_style_throw_expression = true:error                                    # Throw expressions
csharp_style_unused_value_assignment_preference = discard_variable:error      # Discard for unused assignments
csharp_style_unused_value_expression_statement_preference = discard_variable:error # Discard for unused expression values

# --- [MEMBER_BODY_STYLE] ----------------------------------------------------------------
csharp_style_expression_bodied_methods = true:error                           # Expression-bodied methods
csharp_style_expression_bodied_constructors = true:error                      # Expression-bodied constructors
csharp_style_expression_bodied_operators = true:error                         # Expression-bodied operators
csharp_style_expression_bodied_properties = true:error                        # Expression-bodied properties
csharp_style_expression_bodied_indexers = true:error                          # Expression-bodied indexers
csharp_style_expression_bodied_accessors = true:error                         # Expression-bodied accessors
csharp_style_expression_bodied_lambdas = true:error                           # Expression-bodied lambdas
csharp_style_expression_bodied_local_functions = true:error                   # Expression-bodied local functions
dotnet_style_prefer_auto_properties = true:error                              # Auto-properties over trivial backing fields

# --- [FORMATTING_KR] --------------------------------------------------------------------
csharp_prefer_braces = false:error                                            # No braces on single-statement blocks
csharp_new_line_before_open_brace = none                                      # Opening brace on the same line
csharp_new_line_before_else = false                                           # else on the same line as the closing brace
csharp_new_line_before_catch = false                                          # catch on the same line as the closing brace
csharp_new_line_before_finally = false                                        # finally on the same line as the closing brace
csharp_new_line_before_members_in_object_initializers = false                 # No forced newline before object initializer members
csharp_new_line_before_members_in_anonymous_types = false                     # No forced newline before anonymous type members
csharp_new_line_between_query_expression_clauses = false                      # No forced newline between query clauses
dotnet_style_allow_multiple_blank_lines_experimental = false                  # No consecutive blank lines
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false            # No blank lines between adjacent braces
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false # No blank line after the constructor initializer colon
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false  # No blank line after conditional-expression tokens
dotnet_diagnostic.IDE0055.severity = error                                    # Formatting violations fail the build

# --- [QUALITY_ANALYZERS] ----------------------------------------------------------------
dotnet_diagnostic.CA1000.severity = none                                      # Static generic factories construct their owning type directly
dotnet_diagnostic.CA1034.severity = none                                      # Union cases and closed Expected error hierarchies nest in their owner
dotnet_diagnostic.CA1711.severity = error                                     # No reserved type suffix (Collection, EventHandler, Ex, New) on a name
dotnet_diagnostic.CA1715.severity = none                                      # Functional type parameters keep documented symbols without prefixes
dotnet_diagnostic.CA1716.severity = none                                      # Libraries serve C# alone, host names keep host spelling
dotnet_diagnostic.CA1720.severity = none                                      # Union cases take host value type names (Integer, Double, String)
dotnet_diagnostic.CA1724.severity = none                                      # Unrelated namespace names impose no type naming constraint
dotnet_diagnostic.MA0008.severity = none                                      # Structs lay out sequentially by default, the attribute restates it
dotnet_diagnostic.MA0018.severity = none                                      # Deprecated CA1000 duplicate, generic factories belong to owning type
dotnet_diagnostic.MA0038.severity = none                                      # Deprecated static-method checker; CA1822 owns the policy
dotnet_diagnostic.MA0041.severity = none                                      # Deprecated static-property checker; CA1822 owns the policy
dotnet_diagnostic.MA0048.severity = none                                      # Files group a concern's types, one type per file splits a concern
dotnet_diagnostic.MA0051.severity = none                                      # Length caps force extracted helpers, one operation stays in one body
dotnet_diagnostic.MA0136.severity = none                                      # .gitattributes checks out every file with eol=lf, raw strings hold LF
dotnet_diagnostic.CA2249.severity = none                                      # no-index-sentinel-comparison owns string IndexOf tests, < 0 and is forms included
dotnet_diagnostic.CA1021.severity = error                                     # Off under latest-all: no out parameters
dotnet_diagnostic.CA1045.severity = error                                     # Off under latest-all: no ref parameters
dotnet_diagnostic.CA1062.severity = none                                      # Nullable annotations state null contract, guards are junk validation
dotnet_diagnostic.CA1516.severity = error                                     # Off under latest-all: cross-platform intrinsics over x86 or Arm ones
dotnet_diagnostic.CA1307.severity = error                                     # Explicit StringComparison on string comparison overloads
dotnet_diagnostic.CA1310.severity = error                                     # Explicit StringComparison on culture-sensitive comparisons
dotnet_code_quality.CA1003.api_surface = all                                  # EventHandler<T> over event-shaped delegates at every accessibility

# --- [THREADING_ANALYZERS] --------------------------------------------------------------
dotnet_diagnostic.VSTHRD003.severity = error                                  # No await on a task started outside the current context
dotnet_diagnostic.VSTHRD103.severity = error                                  # Async overloads inside async methods
dotnet_diagnostic.VSTHRD102.severity = error                                  # Info by default: implement internal logic asynchronously
dotnet_diagnostic.VSTHRD111.severity = error                                  # Hidden by default: explicit ConfigureAwait on every await

# --- [MEZIANTOU_ANALYZERS] --------------------------------------------------------------
dotnet_diagnostic.MA0009.severity = none                                      # Regex timeouts are not required
dotnet_diagnostic.MA0127.severity = none                                      # String constant patterns compare ordinally, string.Equals chains restate them
dotnet_diagnostic.MA0032.severity = error                                     # CancellationToken overloads when available
dotnet_diagnostic.MA0121.severity = error                                     # Off by default: no parameter reassignment
dotnet_diagnostic.MA0141.severity = error                                     # Off by default: is not null over != null
dotnet_diagnostic.MA0142.severity = error                                     # Off by default: is null over == null
dotnet_diagnostic.MA0148.severity = error                                     # Off by default: constant pattern over == on a discrete constant
dotnet_diagnostic.MA0149.severity = error                                     # Off by default: not pattern over != on a discrete constant
dotnet_diagnostic.MA0170.severity = error                                     # Off by default: no type an attribute argument cannot hold
dotnet_diagnostic.MA0171.severity = error                                     # Off by default: is null over Nullable<T>.HasValue
dotnet_diagnostic.MA0172.severity = error                                     # Off by default: identical operands in a binary expression
dotnet_diagnostic.MA0186.severity = error                                     # Off by default: [NotNullWhen(true)] on the Equals parameter
dotnet_diagnostic.MA0175.severity = error                                     # Off by default: record without the class keyword it implies
dotnet_diagnostic.MA0217.severity = error                                     # Off by default: static lambdas capturing nothing, as TTRESG1001 fixes
dotnet_diagnostic.MA0227.severity = error                                     # Off by default: set lookup over Enumerable.Contains on a set
dotnet_diagnostic.MA0239.severity = error                                     # Off by default: typeof over GetType() on a sealed type
dotnet_diagnostic.MA0107.severity = error                                     # Off by default: no culture-sensitive object.ToString
dotnet_diagnostic.MA0161.severity = error                                     # Off by default: explicit UseShellExecute, its default varies by host
dotnet_diagnostic.MA0162.severity = error                                     # Off by default: ProcessStartInfo overloads, string ones cannot set it
dotnet_diagnostic.MA0180.severity = error                                     # Off by default: ILogger<T> type argument matches the containing type
dotnet_diagnostic.MA0080.severity = error                                     # WithCancellation on async enumeration
dotnet_diagnostic.MA0167.severity = error                                     # TimeProvider overloads when available
dotnet_diagnostic.MA0168.severity = error                                     # readonly struct for in parameters
dotnet_diagnostic.MA0191.severity = error                                     # No null-forgiving operator
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_constructor = true   # Constructor argument passes disposal to the constructed object
dotnet_diagnostic.MA0221.severity = error                                     # Off by default: [MaybeNullWhen(false)] on a TryGetValue out value
dotnet_diagnostic.MA0222.severity = error                                     # Off by default: JsonSourceGenerationOptions rejects null for non-nullable members
dotnet_diagnostic.MA0223.severity = error                                     # Off by default: JsonSourceGenerationOptions requires required constructor parameters
dotnet_diagnostic.MA0224.severity = error                                     # Off by default: JsonSerializerOptions rejects null for non-nullable members
dotnet_diagnostic.MA0225.severity = error                                     # Off by default: JsonSerializerOptions requires required constructor parameters
dotnet_diagnostic.MA0226.severity = error                                     # Off by default: sealed EventSource
dotnet_diagnostic.MA0228.severity = error                                     # Off by default: EventSource event ids above zero
dotnet_diagnostic.MA0229.severity = error                                     # Off by default: unique EventSource event ids
dotnet_diagnostic.MA0230.severity = error                                     # Off by default: unique EventSource event names
dotnet_diagnostic.MA0231.severity = error                                     # Off by default: instance EventSource event methods
dotnet_diagnostic.MA0232.severity = error                                     # Off by default: no explicit interface EventSource event methods
dotnet_diagnostic.MA0233.severity = error                                     # Off by default: no event methods on an abstract EventSource
dotnet_diagnostic.MA0234.severity = error                                     # Off by default: written event id matches its [Event] attribute
dotnet_diagnostic.MA0235.severity = error                                     # Off by default: written payload matches the event parameters
dotnet_diagnostic.MA0236.severity = error                                     # Off by default: written payload keeps the parameter order
dotnet_diagnostic.MA0237.severity = error                                     # Off by default: related activity id as the first event parameter
dotnet_diagnostic.MA0238.severity = error                                     # Off by default: event parameter types EventSource writes

# --- [ROSLYNATOR_ANALYZERS] -------------------------------------------------------------
dotnet_diagnostic.RCS1002.severity = error                                    # Off by default: no braces on a single-statement block
dotnet_diagnostic.RCS1004.severity = error                                    # Off by default: no braces on a single-statement if/else
dotnet_diagnostic.RCS1014.severity = error                                    # Off by default: array creation type style
dotnet_diagnostic.RCS1050.severity = error                                    # Off by default: no parentheses on new T { } with an initializer
dotnet_diagnostic.RCS1052.severity = error                                    # Off by default: one attribute per bracket pair
dotnet_diagnostic.RCS1056.severity = none                                     # Directness permits aliases that resolve namespace and type collisions
dotnet_diagnostic.RCS1161.severity = none                                     # Ordinals follow declaration order, explicit values state contracts
dotnet_diagnostic.RCS1078.severity = error                                    # Off by default: "" over string.Empty
dotnet_diagnostic.RCS1079.severity = error                                    # Off by default: no NotImplementedException left in code
dotnet_diagnostic.RCS1081.severity = error                                    # Off by default: one declarator per field or local
dotnet_diagnostic.RCS1162.severity = error                                    # Off by default: no x = y = z chains
dotnet_diagnostic.RCS1174.severity = error                                    # Off by default: no async/await around a single returned task
dotnet_diagnostic.RCS1198.severity = error                                    # Off by default: no value type boxed in string concatenation
dotnet_diagnostic.RCS1208.severity = error                                    # Reduce if nesting
dotnet_diagnostic.RCS1231.severity = none                                     # in on small readonly structs costs more than a copy, MA0168 owns in
dotnet_diagnostic.RCS1252.severity = error                                    # Off by default: one infinite-loop form
dotnet_diagnostic.RCS1253.severity = error                                    # Off by default: one doc summary layout
dotnet_diagnostic.ROS0003.severity = error                                    # Rule enabled without its roslynator_* option
dotnet_diagnostic.RCS1001.severity = none                                     # Contradicts csharp_prefer_braces = false at error
dotnet_diagnostic.RCS1003.severity = none                                     # Contradicts csharp_prefer_braces = false at error
dotnet_diagnostic.RCS1021.severity = none                                     # Assignment lambda expression bodies rebind IO.lift(Action) to Func<A>
dotnet_diagnostic.RCS1181.severity = none                                     # Section dividers file organization requires stay line comments
dotnet_diagnostic.RCS1217.severity = none                                     # Contradicts RCS1267 at error, interpolation over concatenation
dotnet_diagnostic.RCS1238.severity = none                                     # Value-choosing branches are conditional expressions, nesting included
dotnet_diagnostic.RCS1241.severity = none                                     # Non-generic comparers forward to generic ones, a forward is a defect
roslynator_array_creation_type_style = implicit_when_type_is_obvious          # RCS1014: new[] or [] where a declaration or elements state the type
roslynator_empty_string_style = literal                                       # RCS1078: "" literal
roslynator_enum_flag_value_style = shift_operator                             # RCS1254: 1 << n
roslynator_infinite_loop_style = while                                        # RCS1252: while (true)
roslynator_doc_comment_summary_style = single_line                            # RCS1253: single-line summaries
roslynator_object_creation_parentheses_style = omit                           # RCS1050: new T { } without parentheses

# --- [IDE_QUALITY_RULES] ----------------------------------------------------------------
dotnet_diagnostic.IDE0001.severity = error                                    # Simplify qualified names
dotnet_diagnostic.IDE0002.severity = error                                    # Simplify qualified member access
dotnet_diagnostic.IDE0004.severity = error                                    # Remove unnecessary casts
dotnet_diagnostic.IDE0005.severity = error                                    # Remove unnecessary using directives
dotnet_diagnostic.IDE0051.severity = error                                    # Remove unused private members
dotnet_diagnostic.IDE0052.severity = error                                    # Remove private members that are written but never read
dotnet_diagnostic.IDE0060.severity = error                                    # Remove unused parameters
dotnet_diagnostic.IDE0064.severity = error                                    # Make struct fields writable when they are reassigned
dotnet_diagnostic.IDE0070.severity = error                                    # HashCode.Combine for composite hash codes
dotnet_diagnostic.IDE0072.severity = none                                     # Its discard arm on enum switches hides missing members from CS8509
dotnet_diagnostic.IDE0076.severity = error                                    # Remove invalid SuppressMessage targets
dotnet_diagnostic.IDE0077.severity = error                                    # SuppressMessage targets in the Roslyn format
dotnet_diagnostic.IDE0079.severity = none                                     # Never on build and unread by dotnet format, an IDE-only error
dotnet_diagnostic.IDE0080.severity = error                                    # Remove unnecessary null-forgiving (!) operator
dotnet_diagnostic.IDE0082.severity = error                                    # nameof over typeof(T).Name
dotnet_diagnostic.IDE0100.severity = error                                    # Remove redundant equality (x == true)
dotnet_diagnostic.IDE0110.severity = error                                    # Remove unnecessary discard pattern arms
dotnet_diagnostic.IDE0120.severity = error                                    # Simplify chained LINQ
dotnet_diagnostic.IDE0121.severity = error                                    # OfType<T>() over type check and cast
dotnet_diagnostic.IDE0220.severity = error                                    # Explicit cast in foreach over non-generic IEnumerable
dotnet_diagnostic.IDE0240.severity = error                                    # Remove redundant #nullable directives
dotnet_diagnostic.IDE0241.severity = error                                    # Remove unnecessary #nullable directives
dotnet_diagnostic.IDE0280.severity = error                                    # nameof in attribute arguments
dotnet_diagnostic.IDE0330.severity = error                                    # System.Threading.Lock over object locks
dotnet_diagnostic.IDE0340.severity = error                                    # Unbound generic types in nameof
dotnet_diagnostic.IDE0360.severity = error                                    # Expression-bodied trivial property accessors
dotnet_diagnostic.IDE0380.severity = error                                    # Remove unnecessary unsafe modifiers
dotnet_diagnostic.IDE1005.severity = error                                    # ?.Invoke for delegate invocation

# --- [MAPPERLY_ANALYZERS] ---------------------------------------------------------------
dotnet_diagnostic.RMG009.severity = error                                     # Report read-only member targets instead of silent skips
dotnet_diagnostic.RMG010.severity = error                                     # Cannot map from a write-only member
dotnet_diagnostic.RMG011.severity = error                                     # Cannot map to a write-only member path
dotnet_diagnostic.RMG015.severity = error                                     # Cannot map to an init-only member path
dotnet_diagnostic.RMG033.severity = error                                     # Same-type member copied by reference under UseDeepCloning
dotnet_diagnostic.RMG083.severity = error                                     # Report read-only type targets instead of silent skips
dotnet_diagnostic.RMG088.severity = error                                     # Enum member naming attribute is missing
dotnet_diagnostic.RMG089.severity = error                                     # Nullable source to non-null member, decided per member
dotnet_diagnostic.RMG090.severity = error                                     # Nullable source type to non-nullable target type
dotnet_diagnostic.RMG096.severity = error                                     # Hidden by default: ignored member without a Justification

# --- [LOGGING_ANALYZERS] ----------------------------------------------------------------
dotnet_diagnostic.SYSLIB1006.severity = error                                 # Info by default: one event id per [LoggerMessage] method in a class
dotnet_diagnostic.SYSLIB1027.severity = error                                 # Info by default: no field shadowing a primary-constructor ILogger

# --- [MESSAGEPACK_ANALYZERS] ------------------------------------------------------------
dotnet_diagnostic.MsgPack001.severity = error                                 # Disabled by default: explicit options, defaults read a mutable static
dotnet_diagnostic.MsgPack002.severity = error                                 # Disabled by default: constant serializer options over a mutable static

# --- [ERRORPRONE_ANALYZERS] -------------------------------------------------------------
dotnet_diagnostic.EPC38.severity = error                                      # Off by default: enumerating IEnumerable<Task> twice starts tasks twice
dotnet_diagnostic.EPC39.severity = error                                      # Off by default: enumerable re-enumerated inside a loop
dotnet_diagnostic.EPC40.severity = error                                      # Off by default: IEnumerable<T> parameter enumerated more than once

# --- [WORKSPACE_SEVERITY_FLOOR] ---------------------------------------------------------
dotnet_analyzer_diagnostic.severity = error
dotnet_diagnostic.CS1591.severity = none                                      # Comments are section dividers alone, member docs stay optional
dotnet_diagnostic.CA2225.severity = error                                     # Named alternates for operator overloads
dotnet_diagnostic.CS8524.severity = none                                      # Its discard arm for unnamed enum values is a rejected widened arm

[.artifacts/**.cs]
dotnet_diagnostic.EPC29.severity = none                                       # Test SDK generators emit ExcludeFromCodeCoverage without Justification

[tests/**/*.cs]
dotnet_diagnostic.VSTHRD111.severity = none                                   # xUnit1030 at error forbids ConfigureAwait(false) in tests
dotnet_diagnostic.CA1515.severity = none                                      # xUnit requires public test classes

[tools/roslyn/**/*.cs]
dotnet_diagnostic.RS2008.severity = none                                      # Analyzers publish no package, release tracking files record no release
