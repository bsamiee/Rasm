{
    "name": "@rasm/atelier-protocol",
    "version": "0.0.0",
    "private": true,
    "description": "Atelier's request contracts, the link its plugins dial, the CEP wire to their ExtendScript, the CEP panel serving that link, and the Vite plugin compiling the link into a plugin build",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/creative-cloud/atelier/protocol"
    },
    "license": "MIT",
    "sideEffects": [ "./panel.ts" ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./indesign": "./indesign.ts",
        "./panel": "./panel.ts",
        "./peer": "./peer.ts",
        "./vite": "./vite.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@rasm/applications": "workspace:*",
        "@rasm/automation": "workspace:*",
        "@rasm/cep": "workspace:*",
        "@rasm/indesign": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/typography": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:",
        "jsonc-parser": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./indesign": "./dist/indesign.js",
            "./panel": "./dist/panel.js",
            "./peer": "./dist/peer.js",
            "./vite": "./dist/vite.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
