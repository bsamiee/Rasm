{
    "typescript": {
        "command": "mise",
        "args": [ "exec", "--", "tsc", "--lsp", "--stdio" ],
        "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".mts": "typescript",
            ".cts": "typescript",
            ".js": "javascript",
            ".jsx": "javascriptreact",
            ".mjs": "javascript",
            ".cjs": "javascript"
        },
        "diagnostics": false,
        "settings": { "js/ts": { "tsserver": { "automaticTypeAcquisition": { "enabled": false } } } }
    },
    "python": {
        "command": "mise",
        "args": [ "exec", "--", "ty", "server" ],
        "extensionToLanguage": { ".py": "python", ".pyi": "python" },
        "diagnostics": false
    },
    "rust": {
        "command": "mise",
        "args": [ "exec", "--", "rust-analyzer" ],
        "extensionToLanguage": { ".rs": "rust" },
        "diagnostics": false,
        "initializationOptions": {
            "check": { "overrideCommand": [ "cargo", "clippy", "--workspace", "--lib", "--bins", "--tests", "--message-format=json", "--keep-going" ] },
            "rustc": { "source": "discover" }
        }
    },
    "swift": {
        "command": "sourcekit-lsp",
        "args": [ "--scratch-path", "${CLAUDE_PROJECT_DIR}/.cache/swiftpm/index" ],
        "extensionToLanguage": { ".swift": "swift" },
        "diagnostics": false
    },
    "java": {
        "command": "jdtls",
        "args": [ "-data", "${CLAUDE_PROJECT_DIR}/.cache/jdtls/workspace", "--jvm-arg=-Dosgi.configuration.area=${CLAUDE_PROJECT_DIR}/.cache/jdtls/configuration" ],
        "extensionToLanguage": { ".java": "java" },
        "diagnostics": false,
        "workspaceFolder": "${CLAUDE_PROJECT_DIR}/.claude/skills/use-ghidra/scripts",
        "startupTimeout": 120000,
        "initializationOptions": {
            "settings": { "java": { "autobuild": { "enabled": false } } }
        },
        "settings": {
            "java": {
                "configuration": {
                    "runtimes": [ { "name": "JavaSE-27", "path": "${JAVA_HOME}", "default": true } ]
                },
                "project": {
                    "referencedLibraries": [ "${GHIDRA_INSTALL_DIR}/Ghidra/**/lib/*.jar" ]
                },
                "diagnostic": { "filter": [ "**/.cache/**" ] }
            }
        }
    },
    "yaml": {
        "command": "yaml-language-server",
        "args": [ "--stdio" ],
        "extensionToLanguage": { ".yaml": "yaml", ".yml": "yaml" },
        "diagnostics": false,
        "settings": {
            "yaml": { "schemas": { "https://www.schemastore.org/github-action.json": ".github/actions/*/action.{yml,yaml}" } }
        }
    },
    "toml": {
        "command": "mise",
        "args": [ "exec", "--", "tombi", "lsp" ],
        "extensionToLanguage": { ".toml": "toml" },
        "diagnostics": false
    },
    "bash": {
        "command": "bash-language-server",
        "args": [ "start" ],
        "extensionToLanguage": { ".sh": "shellscript", ".bash": "shellscript" },
        "diagnostics": false
    }
}
