{
    "name": "@rasm/galley",
    "version": "1.0.0",
    "private": true,
    "description": "InDesign UXP plugin serving InDesign through Atelier as MCP tools",
    "type": "module",
    "main": "panel.ts",
    "dependencies": {
        "@rasm/indesign": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:",
        "indesign-uxp-types": "catalog:",
        "vite": "catalog:"
    },
    "nx": {
        "targets": {
            "build": {
                "inputs": [ "...", { "env": "ATELIER_URL" } ]
            }
        }
    }
}
