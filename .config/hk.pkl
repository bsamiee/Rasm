amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"
import "pkl:platform"

// --- [SETTINGS] -------------------------------------------------------------------------

exclude = "infra/sdks/**"
fail_fast = false
recheck_after_fix = true

// --- [STEPS] ----------------------------------------------------------------------------

steps {
  // --- [CROSS_PLATFORM]

  ["ast-grep"] {
    glob = "**/*"
    check = new CommandSpec {
      command = new Command {
        argv = List("ast-grep", "scan", "--report-style", "short", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("ast-grep", "scan", "--update-all", "{{files}}")
      }
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["check-symlinks"] = Builtins.check_symlinks
  ["clang-format"] = (Builtins.clang_format) {
    depends = "ast-grep"
    profiles = List("!ci") // CI runners hold no LLVM, whose 12 GB install the hosted Linux disk cannot spare
    glob = "**/*.{c,cpp,cppm,ixx,cc,cxx,m,mm,hpp,hh,hxx,h,ipp,inl,tpp}"
    local style = "--style=file:.config/.clang-format"
    batch = true
    check { command { argv = List("clang-format", style, "--dry-run", "-Werror", "{{files}}") } }
    fix { command { argv = List("clang-format", style, "-i", "{{files}}") } }
  }
  ["dotnet-format"] {
    glob = "**/*.cs"
    depends = "ast-grep"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "dotnet",
            "format",
            "whitespace",
            "--folder",
            "--verify-no-changes",
            "--include",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("dotnet", "format", "whitespace", "--folder", "--include", "{{files}}")
      }
      effect = "write"
    }
  }
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    glob = "**/*.{csproj,fsproj,vbproj,props,targets,slnx,pkl,plist,entitlements}"
    local checker = List("editorconfig-checker", "-format", "gcc", "-no-color")
    depends = "ast-grep"
    check { command { argv = checker + List("{{files}}") } }
    fix { command { argv = checker + List("-fix", "{{files}}") } }
    diagnostic_format = "gcc"
  }
  ["file-names"] {
    glob = "**/*.cs"
    check = new CommandSpec {
      command =
        "for file in {{files}}; do [ \"${file##*/}\" != \"$(basename \"${file%/*}\").cs\" ] || { printf '%s:1:1: error: file name matches folder name, rename it for its contents\\n' \"$file\"; failed=1; }; done; [ -z \"${failed:-}\" ]"
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["gersemi"] {
    glob = List("**/CMakeLists.txt", "**/*.cmake")
    local gersemi =
      List(
        "gersemi",
        "--config",
        ".config/gersemi.yaml",
        "--warnings-as-errors",
        "--cache-dir",
        ".cache/gersemi",
      )
    depends = "ast-grep"
    check_diff = new CommandSpec {
      command = new Command { argv = gersemi + List("--check", "--diff", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = gersemi + List("--in-place", "{{files}}") }
      effect = "write"
    }
  }
  ["google-java-format"] = (Builtins.google_java_format) {
    depends = "ast-grep"
    check {
      command {
        argv =
          List("google-java-format", "--aosp", "--dry-run", "--set-exit-if-changed", "{{files}}")
      }
    }
    check_list_files {
      command { argv = List("google-java-format", "--aosp", "--dry-run", "{{files}}") }
    }
    fix { command { argv = List("google-java-format", "--aosp", "--replace", "{{files}}") } }
  }
  ["hk"] = Builtins.hk_validate
  ["jactionlint"] = (Builtins.jactionlint) {
    local jactionlint = List("jactionlint", "--strict-exit")
    depends = "ast-grep"
    check { command { argv = jactionlint + List("--format", "gcc", "{{files}}") } }
    check_diff {
      command {
        argv =
          List("hk", "util", "sarif-diff", "--")
            + jactionlint
            + List("--format", "sarif", "{{files}}")
      }
    }
    fix { command { argv = jactionlint + List("--fix", "{{files}}") } }
  }
  ["javac"] {
    glob = "**/*.java"
    local off =
      List(
        "AddNullMarkedToClass", // Both null-marking fixes import JSpecify, absent from Ghidra's script classpath
        "DefaultPackage", // Ghidra loads scripts in the default package from script folders
        "ImmutableMemberCollection", // Fix uses Guava collections that Ghidra's Gson cannot decode
        "Java8ApiChecker", // Java 8 API restrictions conflict with scripts targeting Ghidra's JDK
        "MissingJavadoc", // Ghidra scripts use section dividers and need no Javadoc
        "RequireExplicitNullMarking",
        "Var", // CLAUDE.md disallows checks that require `@Var` on reassigned locals
        "Varifier" // PMD's `UseExplicitTypes` rejects `var` added by fix
      )
    local lint = "-path" // Ghidra's release omits JARs its manifests list in `Class-Path`
    check = new CommandSpec {
      command =
        "javac -J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -XDcompilePolicy=simple --should-stop=ifError=FLOW -processorpath \"${JAVAC_PLUGINS:?javac plugin classpath missing, run mise install}\" \"-Xplugin:ErrorProne -XepAllDisabledChecksAsWarnings -XepAllSuggestionsAsWarnings \(off.map((check) -> "-Xep:\(check):OFF").join(" ")) -XepOpt:NullAway:AnnotatedPackages=[^.]+$,headless\" -Xlint:all,\(lint) -Werror -d .cache/javac -cp \"${GHIDRA_CLASSPATH:?Ghidra classpath missing, run mise install}\" -sourcepath plugins/shared/tool/skills/ghidra/scripts {{files}}"
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  for (environment in List(null, "ci", "ci-linux")) {
    [List("mise-lock", environment).filterNonNull().join("-")] {
      glob =
        List(
          ".config/mise*.toml",
          ".config/mise*.lock",
          ".config/mise/locks/**",
          "rust-toolchain.toml",
        )
      check = new CommandSpec {
        command = new Command {
          argv =
            List("mise")
              + (if (environment == null) List() else List("--env", environment))
              + List("lock", "--check")
        }
        effect = "read"
      }
    }
  }
  ["pmd"] {
    glob = "**/*.java"
    depends = "javac"
    check = new CommandSpec {
      command =
        "pmd check --rulesets .config/pmd.xml --no-cache --no-progress --aux-classpath \".cache/javac:${JAVA_HOME:?}/lib/jrt-fs.jar:${GHIDRA_CLASSPATH:?Ghidra classpath missing, run mise install}\" {{files}}"
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  local claudeCode = List("libs/typescript/ai/claude-code", "plugins/claude")
  ["oxlint"] = (Builtins.ox_lint) {
    depends = "ast-grep"
    exclude = claudeCode
  }
  ["oxlint-claude-code"] = (Builtins.ox_lint) {
    depends = "ast-grep"
    glob =
      claudeCode.flatMap((folder) ->
        (Builtins.ox_lint.glob as List<String>).map((files) -> "\(folder)/\(files)")
      )
    profiles = List("!ci") // CI runners hold no Claude Code engine declarations, which these programs list in `files`
  }
  ["oxfmt"] = (Builtins.oxfmt) {
    depends = List("oxlint", "oxlint-claude-code", "ryl", "stylelint")
  }
  ["pkl-format"] = (Builtins.pkl_format) { depends = "editorconfig-checker" }
  ["ruff"] = (Builtins.ruff) { depends = "ast-grep" }
  ["ruff-format"] = (Builtins.ruff_format) { depends = "ruff" }
  ["rustfmt"] = (Builtins.rustfmt) {
    depends = "ast-grep"
    local rustfmt =
      List("rustfmt", "--config-path", ".config/rustfmt.toml", "--config", "skip_children=true")
    batch = true
    check { command { argv = rustfmt + List("--check", "{{files}}") } }
    check_list_files {
      command { argv = rustfmt + List("--check", "--files-with-diff", "{{files}}") }
    }
    fix { command { argv = rustfmt + List("{{files}}") } }
  }
  ["ryl"] = (Builtins.ryl) {
    local ryl = List("ryl", "check", "--output-format", "standard")
    depends = "jactionlint"
    check { command { argv = ryl + List("{{files}}") } }
    fix { command { argv = ryl + List("--fix", "{{files}}") } }
    diagnostic_format = "stylish"
  }
  ["shellcheck"] = (Builtins.shellcheck) { depends = "ast-grep" }
  ["shfmt"] = (Builtins.shfmt) { depends = "shellcheck" }
  ["stylelint"] = (Builtins.stylelint) {
    depends = "ast-grep"
    local stylelint =
      List("stylelint", "--config", ".config/stylelint.config.ts", "--max-warnings", "0")
    env { ["NODE_OPTIONS"] = "--throw-deprecation" }
    check { command { argv = stylelint + List("{{files}}") } }
    fix { command { argv = stylelint + List("--fix", "{{files}}") } }
  }
  ["tombi"] = (Builtins.tombi) {
    check {
      command { argv = List("tombi", "lint", "--quiet", "--error-on-warnings", "{{files}}") }
    }
  }
  ["tombi-format"] = (Builtins.tombi_format) { depends = "ast-grep" }
  ["vulture"] {
    glob = "**/*.py"
    workspace_indicator = "pyproject.toml"
    depends = "ruff-format"
    check = new CommandSpec {
      command = #"vulture {% if workspace == "." %}{{files}}{% else %}{{workspace}}{% endif %}"#
      effect = "read"
    }
  }

  // --- [MACOS]

  when (platform.current.operatingSystem.name == "macOS") {
    ["plutil"] {
      glob = "**/*.{plist,entitlements}"
      check = new CommandSpec {
        command = new Command { argv = List("plutil", "-lint", "-s", "{{files}}") }
        effect = "read"
      }
    }
    ["swiftlint"] = (Builtins.swiftlint) {
      depends = "ast-grep"
      local swiftlint = List("swiftlint", "lint", "--quiet", "--config", ".config/swiftlint.yml")
      check { command { argv = swiftlint + List("{{files}}") } }
      fix { command { argv = swiftlint + List("--fix", "{{files}}") } }
      diagnostic_format = "gcc-paren"
    }
    ["swift-format"] {
      glob = "**/*.swift"
      local configured =
        List("--configuration", ".config/swift-format.json", "--parallel", "{{files}}")
      depends = "swiftlint"
      check = new CommandSpec {
        command = new Command { argv = List("swift", "format", "lint", "--strict") + configured }
        effect = "read"
      }
      fix = new CommandSpec {
        command = new Command {
          argv = List("swift", "format", "format", "--in-place") + configured
        }
        effect = "write"
      }
      diagnostic_format = "gcc"
    }
    ["xcprojformatter"] {
      glob = "**/project.xcproj"
      depends = "ast-grep"
      check_diff = new CommandSpec {
        command = new Command {
          argv = List("hk", "util", "format-diff", "{{files}}", "--", "xcrun", "xcprojformatter")
        }
        effect = "read"
      }
    }
  }
}

// --- [HOOKS] ----------------------------------------------------------------------------

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = new CommandSpec {
          command =
            #"hk util check-conventional-commit --allowed-scopes="$(jq -r '.nodes | keys | join(",")' "$NX_WORKSPACE_DATA_DIRECTORY/project-graph.json")" "{{commit_msg_file}}""#
          effect = "read"
        }
      }
    }
  }
  ["pre-commit"] { enabled = false }
}
