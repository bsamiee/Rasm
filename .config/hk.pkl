amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

// --- [SETTINGS] -------------------------------------------------------------------------

fail_fast = false

// --- [STEPS] ----------------------------------------------------------------------------

local environment = List("pixi", "run", "--locked", "-e", "cpp")

steps {
  ["grammars"] {
    check = new CommandSpec {
      command =
        "cmake -S tools/ast-grep/grammars --preset default && cmake --build --presets-file tools/ast-grep/grammars/CMakePresets.json --preset default"
      effect = "write"
    }
    stomp = true
  }
  ["ast-grep"] {
    glob = "**/*"
    exclude =
      read("../tools/dylint/.ignore").text
        .split("\n")
        .filter((line) -> line.startsWith("/"))
        .map((line) -> "tools/dylint\(line)")
    depends = "grammars"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "ast-grep",
            "scan",
            "--custom-languages",
            "allow",
            "--report-style",
            "short",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("ast-grep", "scan", "--custom-languages", "allow", "--update-all", "{{files}}")
      }
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["biome"] = (Builtins.biome) {
    glob = "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,html,vue,svelte,astro,grit}"
    check {
      command {
        argv =
          List("biome", "check", "--error-on-warnings", "--no-errors-on-unmatched", "{{files}}")
      }
    }
    fix {
      command {
        argv =
          List(
            "biome",
            "check",
            "--write",
            "--error-on-warnings",
            "--no-errors-on-unmatched",
            "{{files}}",
          )
      }
    }
  }
  ["clang-format"] = (Builtins.clang_format) {
    glob = "**/*.{cpp,cppm,ixx,cc,cxx,hpp,hh,hxx,h,ipp,inl,tpp}"
    prefix = environment
  }
  ["compose"] {
    glob = "**/compose*.{yaml,yml}"
    check = new CommandSpec {
      command =
        "for file in {{files}}; do docker compose --profile '*' --file \"$file\" config --quiet || failed=1; done; [ -z \"${failed:-}\" ]"
      effect = "read"
    }
  }
  ["dotnet-format"] {
    glob = "**/*.cs"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "dotnet",
            "format",
            "whitespace",
            "--folder",
            "--verify-no-changes",
            "--include",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("dotnet", "format", "whitespace", "--folder", "--include", "{{files}}")
      }
      effect = "write"
    }
  }
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    glob = "**/*.{csproj,fsproj,vbproj,props,targets,slnx,pkl,plist,entitlements}"
  }
  ["file-names"] {
    glob = "**/*.cs"
    check = new CommandSpec {
      command =
        "for file in {{files}}; do [ \"${file##*/}\" != \"$(basename \"${file%/*}\").cs\" ] || { printf '%s:1:1: error: file named after its folder, name the file for its concept family\\n' \"$file\"; failed=1; }; done; [ -z \"${failed:-}\" ]"
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["gersemi"] {
    glob = List("**/CMakeLists.txt", "**/*.cmake")
    local gersemi = List("gersemi", "--warnings-as-errors", "--cache-dir", ".cache/gersemi")
    prefix = environment
    check = new CommandSpec {
      command = new Command { argv = gersemi + List("--check", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = gersemi + List("--in-place", "{{files}}") }
      effect = "write"
    }
  }
  ["google-java-format"] = (Builtins.google_java_format) {
    check {
      command {
        argv =
          List("google-java-format", "--aosp", "--dry-run", "--set-exit-if-changed", "{{files}}")
      }
    }
    check_list_files {
      command { argv = List("google-java-format", "--aosp", "--dry-run", "{{files}}") }
    }
    fix { command { argv = List("google-java-format", "--aosp", "--replace", "{{files}}") } }
  }
  ["jactionlint"] = (Builtins.jactionlint) {
    check {
      command { argv = List("jactionlint", "--strict-exit", "--format", "gcc", "{{files}}") }
    }
  }
  ["jscpd"] {
    glob =
      "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,py,pyi,rs,swift,cs,c,h,cpp,cppm,ixx,cc,cxx,hpp,hh,hxx,java}"
    check = new CommandSpec {
      command = new Command { argv = List("jscpd", "--config", ".config/jscpd.json", ".") }
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["javac"] {
    glob = "**/*.java"
    check = new CommandSpec {
      command =
        "javac -J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -XDcompilePolicy=simple --should-stop=ifError=FLOW -processorpath \"${JAVAC_PLUGINS:?error prone is not installed}\" \"-Xplugin:ErrorProne -XepAllSuggestionsAsWarnings -Xep:DefaultPackage:OFF -Xep:RequireExplicitNullMarking:OFF -XepOpt:NullAway:AnnotatedPackages=rasm\" -Xlint:all,-path -Werror -d .cache/javac -cp \"${GHIDRA_CLASSPATH:?ghidra is not installed}\" -sourcepath .claude/skills/use-ghidra/scripts {{files}}"
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["pmd"] {
    glob = "**/*.java"
    depends = "javac"
    check = new CommandSpec {
      command =
        "pmd check --rulesets .config/pmd.xml --no-cache --no-progress --aux-classpath \".cache/javac:${JAVA_HOME:?}/lib/jrt-fs.jar:${GHIDRA_CLASSPATH:?ghidra is not installed}\" {{files}}"
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["hk"] {
    glob = ".config/hk.pkl"
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate", "--deny-warnings") }
      effect = "read"
    }
  }
  ["knip"] = (Builtins.knip) {
    glob =
      List(
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/package.json",
        "knip.json",
        "pnpm-workspace.yaml",
      )
    types = List()
    workspace_indicator = null
    check { command = "knip --no-progress" }
    fix = null
  }
  ["pkl-format"] = Builtins.pkl_format
  ["plutil"] {
    glob = "**/*.{plist,entitlements}"
    check = new CommandSpec {
      command = new Command { argv = List("plutil", "-lint", "-s", "{{files}}") }
      effect = "read"
    }
  }
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = (Builtins.ruff_format) { depends = "ruff" }
  ["rustfmt"] = (Builtins.rustfmt) {
    local rustfmt =
      List("rustfmt", "--config-path", ".config/rustfmt.toml", "--config", "skip_children=true")
    batch = true
    check { command { argv = rustfmt + List("--check", "{{files}}") } }
    check_list_files {
      command { argv = rustfmt + List("--check", "--files-with-diff", "{{files}}") }
    }
    fix { command { argv = rustfmt + List("{{files}}") } }
  }
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["squawk"] {
    glob = "**/*.pgsql"
    check = new CommandSpec {
      command = new Command {
        argv = List("squawk", "--config", ".config/squawk.toml", "--reporter", "gcc", "{{files}}")
      }
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["swiftlint"] = (Builtins.swiftlint) {
    local swiftlint = List("swiftlint", "lint", "--quiet", "--config", ".config/swiftlint.yml")
    check { command { argv = swiftlint + List("{{files}}") } }
    fix { command { argv = swiftlint + List("--fix", "{{files}}") } }
    diagnostic_format = "gcc-paren"
  }
  ["swift-format"] {
    glob = "**/*.swift"
    local configured =
      List("--configuration", ".config/swift-format.json", "--parallel", "{{files}}")
    depends = "swiftlint"
    check = new CommandSpec {
      command = new Command { argv = List("swift", "format", "lint", "--strict") + configured }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("swift", "format", "format", "--in-place") + configured }
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["tombi"] = (Builtins.tombi) {
    check {
      command { argv = List("tombi", "lint", "--quiet", "--error-on-warnings", "{{files}}") }
    }
  }
  ["tombi-format"] = Builtins.tombi_format
  ["xcprojformatter"] {
    glob = "**/project.xcproj"
    check_diff = new CommandSpec {
      command = new Command {
        argv = List("hk", "util", "format-diff", "{{files}}", "--", "xcrun", "xcprojformatter")
      }
      effect = "read"
    }
  }
  ["yamllint"] = (Builtins.yamllint) {
    batch = true
    check {
      command {
        argv =
          List(
            "yamllint",
            "--config-file",
            ".config/yamllint.yaml",
            "--strict",
            "--format",
            "standard",
            "{{files}}",
          )
      }
    }
    diagnostic_format = "stylish"
  }
}

// --- [HOOKS] ----------------------------------------------------------------------------

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = new CommandSpec {
          command =
            #"""
            projects=$(nx show projects --no-json)
            hk util check-conventional-commit --allowed-scopes="$(printf '%s' "$projects" | tr '\n' ',')" "{{commit_msg_file}}"
            """#
          effect = "read"
        }
      }
    }
  }
  ["pre-commit"] { enabled = false }
}
