{
    "name": "@rasm/test-nx-distribution",
    "private": true,
    "description": "@rasm/nx-distribution suites over host manifests in temporary workspaces and each executor, with gh and store APIs replaced",
    "type": "module",
    "devDependencies": {
        "@effect/vitest": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx": "workspace:*",
        "@rasm/nx-distribution": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "nx": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "test--vitest": {
                "inputs": [
                    "...",
                    "{workspaceRoot}/products/developer/nx/**/*",
                    "{workspaceRoot}/nx.json"
                ]
            }
        }
    }
}
