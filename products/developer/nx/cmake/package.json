{
    "name": "@rasm/nx-cmake",
    "version": "0.1.0",
    "description": "Nx plugin inferring CMake projects, targets, and dependencies from each presets tree's workflow presets and list files without configuring, with clang-tidy, CTest, and CPack targets",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/cmake"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "compiler.cmake",
        "coverage.cmake"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json",
        "#/*.cmake": "./*.cmake"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.json": "./*.json",
            "#/*.cmake": "./*.cmake"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
