{
    "name": "@rasm/test-nx",
    "private": true,
    "description": "Nx suites over this workspace: graph structure and stability, cache replay, affected reach, task graph and scheduling, sync and executor schemas, release configuration, and the contract every plugin row of nx.json meets",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "ajv": "catalog:",
        "effect": "catalog:",
        "minimatch": "catalog:",
        "nx": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "tags": [ "os:all" ],
        "implicitDependencies": [ "@rasm/nx-*" ],
        "targets": {
            "test--vitest": {
                "inputs": [
                    "...",
                    "{workspaceRoot}/.config/mise.toml",
                    "{workspaceRoot}/.config/mise.*.toml",
                    "{workspaceRoot}/pnpm-lock.yaml",
                    "{workspaceRoot}/pnpm-workspace.yaml",
                    "{workspaceRoot}/**/Cargo.lock",
                    "{workspaceRoot}/**/Package.resolved",
                    "{workspaceRoot}/{**/blender_manifest.toml,**/manifest.yml,**/manifest.json,**/manifest.xml,**/*.uproject,**/*.uplugin}",
                    "{workspaceRoot}/{**/Package.swift,**/Info.plist,**/Package@swift-*.swift,**/*.xcodeproj/project.xcproj,**/*.xcworkspace/contents.xcworkspacedata,**/*.xcscheme,**/*.xcconfig,**/*.xcodeproj/project.pbxproj,**/*.xctestplan,**/*.entitlements,**/*.plist}",
                    "{workspaceRoot}/{**/Cargo.toml,**/.cargo/config.toml,**/.cargo/config,**/rust-toolchain.toml,**/rust-toolchain,**/clippy.toml,**/.clippy.toml,**/.config/nextest.toml,**/{,.}deny{,.exceptions}.toml}",
                    "{workspaceRoot}/{**/CMakePresets.json,**/CMakeLists.txt,**/.clang-tidy}",
                    "{workspaceRoot}/{**/uv.lock,**/uv.toml,**/.python-version,**/ty.toml,**/pyproject.toml,**/mypy.ini,**/.mypy.ini,**/setup.cfg,**/pytest.toml,**/.pytest.toml,**/pytest.ini,**/.pytest.ini,**/tox.ini,**/pixi.toml}",
                    "{workspaceRoot}/{**/*{.csproj,.fsproj,.vbproj,.slnx,.sln,.props,.targets,.globalconfig},**/global.json,**/Directory.Build.rsp,**/nuget.config,**/NuGet.config,**/NuGet.Config,**/.editorconfig}",
                    "{workspaceRoot}/**/{compose,docker-compose}{,.override}.{yaml,yml}",
                    "{workspaceRoot}/**/{tsconfig.json,package.json,cloudflare.config.ts}",
                    "{workspaceRoot}/**/{vite,vitest}.config.{js,mjs,ts,cjs,mts,cts}",
                    "{workspaceRoot}/**/.storybook/main.{js,ts,jsx,tsx,mjs,mts,cjs,cts}",
                    {
                        "runtime": "node -p process.platform+process.arch"
                    }
                ]
            }
        }
    }
}
