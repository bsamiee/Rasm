{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "40000",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_SHELL": "bash",
    "NO_COLOR": "1",
    "FORCE_COLOR": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(mise *)",
      "Bash(pnpm *)",
      "Bash(nx *)",
      "Bash(ncu *)",
      "Bash(biome *)",
      "Bash(tsc *)",
      "Bash(vitest *)",
      "Bash(playwright *)",
      "Bash(uv *)",
      "Bash(ruff *)",
      "Bash(ty *)",
      "Bash(mypy *)",
      "Bash(pytest *)",
      "Bash(dotnet *)",
      "Bash(ast-grep *)",
      "Bash(tree-sitter *)",
      "Bash(tree *)",
      "Bash(loc *)",
      "Bash(fd *)",
      "Bash(rg *)",
      "Bash(sd *)",
      "Bash(difft *)",
      "Bash(hyperfine *)",
      "Bash(duckdb *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(yamllint *)",
      "Bash(yamlfmt *)",
      "Bash(actionlint *)",
      "Bash(doppler *)",
      "Bash(pulumi *)",
      "Bash(claude *)",
      "Bash(tvly *)",
      "Bash(curl *)",
      "Bash(tar *)",
      "mcp__roslyn-codelens__*",
      "mcp__binlog__*",
      "mcp__ast-grep__*",
      "mcp__context7__*",
      "mcp__deepwiki__*",
      "mcp__exa__*",
      "mcp__github__*",
      "mcp__nuget__*",
      "mcp__openaiDeveloperDocs__*",
      "mcp__claudeCodeDocs__*",
      "mcp__playwright__*",
      "mcp__playwright-test__*",
      "mcp__computer-use__*"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "enableAllProjectMcpServers": true,
  "disabledMcpjsonServers": [
    "greptile",
    "hostinger"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise env -s bash > \"$CLAUDE_ENV_FILE\"",
            "timeout": 30,
            "statusMessage": "mise-env"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise env -s bash > \"$CLAUDE_ENV_FILE\"",
            "timeout": 30,
            "statusMessage": "mise-env"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "mise.toml|global.json",
        "hooks": [
          {
            "type": "command",
            "command": "mise env -s bash > \"$CLAUDE_ENV_FILE\"",
            "timeout": 30,
            "statusMessage": "mise-env"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@rasm": true,
    "function-hooks@rasm": true
  },
  "extraKnownMarketplaces": {
    "rasm": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins"
      }
    }
  },
  "effortLevel": "high",
  "claudeMdExcludes": [
    "**/.cache/**/CLAUDE.md",
    "**/node_modules/**/CLAUDE.md",
    "**/bin/**/CLAUDE.md",
    "**/obj/**/CLAUDE.md",
    "**/.artifacts/**/CLAUDE.md"
  ]
}
