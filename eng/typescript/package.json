        "rasm-release": "./release.ts",
        "rasm-upgrade-typescript": "./upgrade/typescript.ts"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/automation": "workspace:*",
