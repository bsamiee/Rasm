{
    "name": "@rasm/nx-apple",
    "version": "0.1.0",
    "description": "Nx plugin inferring SwiftPM packages, Xcode projects, and Xcode workspaces from the toolchain's own output",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/apple"
    },
    "files": [
        "dist",
        "executors.json",
        "executors/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#package": "./package.json",
        "#/*": "./*.ts",
        "#analyzer": "@rasm/nx-apple-darwin-arm64/nx-apple-analyzer"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "publishConfig": {
        "imports": {
            "#package": "./package.json",
            "#/*": "./dist/*.js",
            "#analyzer": "@rasm/nx-apple-darwin-arm64/nx-apple-analyzer"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "cf": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "optionalDependencies": {
        "@rasm/nx-apple-darwin-arm64": "workspace:*"
    },
    "executors": "./executors.json"
}
