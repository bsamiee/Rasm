{
    "name": "@rasm/nx-devkit",
    "version": "0.0.0",
    "description": "Parts every @rasm/nx-* plugin shares: a child-process runner bound to the host's exit, the tool error, verb aggregates, plugin identity, the plugin cache, the child config reader, and the TypeScript configuration reader",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/devkit"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./inference": "./inference.ts",
        "./process": "./process.ts",
        "./reader": "./reader.ts",
        "./reply": "./reply.ts",
        "./typescript": "./typescript.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:",
        "signal-exit": "catalog:"
    },
    "devDependencies": {
        "@nx/js": "catalog:",
        "@types/node": "catalog:",
        "@typescript/native": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "@nx/js": "catalog:",
        "@typescript/native": "catalog:peers",
        "nx": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@nx/js": {
            "optional": true
        },
        "@typescript/native": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            "./inference": "./dist/inference.js",
            "./process": "./dist/process.js",
            "./reader": "./dist/reader.js",
            "./reply": "./dist/reply.js",
            "./typescript": "./dist/typescript.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    },
    "executors": "./executors.json"
}
