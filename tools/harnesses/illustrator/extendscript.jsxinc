        }
        var info = { name: String(value.name), type: String(value.type), dataType: String(value.dataType), isCollection: value.isCollection === true, defaultValue: value.defaultValue === undefined ? null : String(value.defaultValue), arguments: [] };
        for (var a = 0; String(value.type) === "method" && a < value.arguments.length; a++) { info.arguments.push(reflected(value.arguments[a])); }
        return info;
    }
    function home(value, above, kind) {
        var parent = value.parent;
        var known = homes[above + ">" + kind];
