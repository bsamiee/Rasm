    <PropertyGroup>
        <Description>Rhino document handles, tables, layers, queries, mutations, events, and undo records as IO effects over RhinoCommon</Description>
    </PropertyGroup>

    <PropertyGroup Label="Mapperly">
        <MapperlyAbstractionsScope>runtime</MapperlyAbstractionsScope>
    </PropertyGroup>

    <ItemGroup Label="Rhino Dependencies">
        <PackageReference Include="System.Drawing.Common" />
