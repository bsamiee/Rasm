# --- [CLANG_TIDY] -----------------------------------------------------------------------

# --- [CHECKS]

Checks:
    - bugprone-*
    # Other CERT checks alias enabled checks with equal or narrower options
    - cert-err33-c
    - clang-analyzer-*
    - concurrency-*
    - cppcoreguidelines-*
    - custom-*
    - misc-*
    - modernize-*
    - objc-*
    - performance-*
    - portability-*
    - readability-*
    # Binary numeric functions can require matching operand types
    - -bugprone-easily-swappable-parameters
    # Include cleaner flags `import std` names as missing includes
    - -misc-include-cleaner
    # Test expectations and formula coefficients use literals
    - -cppcoreguidelines-avoid-magic-numbers
    - -readability-magic-numbers
    # Supported compilers accept headers starting with `#pragma once`
    - -portability-avoid-pragma-once
    # libc++ hardening checks container subscript bounds
    - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
    # `std::from_chars` and `std::to_chars` report success with `std::errc{}`
    - -bugprone-invalid-enum-default-initialization
WarningsAsErrors: '*'

# --- [HEADER_FILTERS]

HeaderFilterRegex: '/(products|libs|tests)/'
ExcludeHeaderFilterRegex: '/\.artifacts/'

# --- [CHECK_OPTIONS]

CheckOptions:
    bugprone-unhandled-self-assignment.WarnOnlyIfThisHasSuspiciousField: false
    misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
    modernize-use-trailing-return-type.TransformLambdas: none
    readability-function-size.NestingThreshold: 4
    readability-identifier-length.MinimumVariableNameLength: 2
    readability-identifier-length.MinimumParameterNameLength: 2
    readability-identifier-naming.ClassCase: CamelCase
    readability-identifier-naming.StructCase: CamelCase
    readability-identifier-naming.UnionCase: CamelCase
    readability-identifier-naming.EnumCase: CamelCase
    readability-identifier-naming.EnumConstantCase: CamelCase
    readability-identifier-naming.ConceptCase: CamelCase
    readability-identifier-naming.TypeAliasCase: CamelCase
    readability-identifier-naming.TemplateParameterCase: CamelCase
    readability-identifier-naming.NamespaceCase: lower_case
    readability-identifier-naming.FunctionCase: lower_case
    readability-identifier-naming.VariableCase: lower_case
    readability-identifier-naming.ParameterCase: lower_case
    readability-identifier-naming.MemberCase: lower_case
    readability-identifier-naming.PrivateMemberSuffix: _
    readability-identifier-naming.MacroDefinitionCase: UPPER_CASE

# --- [CUSTOM_CHECKS]

CustomChecks:
    - Name: member-visit
      Query: |
          match callExpr(callee(functionDecl(hasName("::std::visit")))).bind("call")
      Diagnostic:
          - BindName: call
            Message: "Call to `std::visit`, use the variant's `visit` member"
            Level: Warning
