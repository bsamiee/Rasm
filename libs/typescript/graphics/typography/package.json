{
    "name": "@rasm/typography",
    "private": true,
    "description": "OpenType typesetting, from font faces to composed text",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./face": "./face.ts",
        "./justification": "./justification.ts",
        "./kerning": "./kerning.ts",
        "./quran": "./quran.ts",
