{
    "name": "@rasm/cep",
    "private": true,
    "description": "CEP extension manifest, the panel following the host skin and serving requests through its host ExtendScript, the swc lowering of ExtendScript, and the Vite builders of CEP extensions and ExtendScript engines",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./node": "./node.ts",
        "./panel": "./panel.ts",
        "./vite": "./vite.ts"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/automation": "workspace:*",
        "@rasm/mark": "workspace:*",
        "@rasm/search": "workspace:*",
        "@swc/wasm": "catalog:",
        "acorn": "catalog:",
        "acorn-walk": "catalog:",
        "cheerio": "catalog:",
        "culori": "catalog:",
        "fast-xml-builder": "catalog:",
        "fast-xml-parser": "catalog:"
    },
    "devDependencies": {
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
