amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

fail_fast = false

// --- [STEPS] ---------------------------------------------------------------------------

steps {
    ["biome"] = (Builtins.biome) {
        glob = "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,html,vue,svelte,astro,grit}"
        check { command { argv = List("biome", "check", "--error-on-warnings", "--no-errors-on-unmatched", "{{files}}") } }
        fix { command { argv = List("biome", "check", "--write", "--error-on-warnings", "--no-errors-on-unmatched", "{{files}}") } }
    }
    ["google-java-format"] = (Builtins.google_java_format) {
        check { command { argv = List("google-java-format", "--aosp", "--dry-run", "--set-exit-if-changed", "{{files}}") } }
        check_list_files { command { argv = List("google-java-format", "--aosp", "--dry-run", "{{files}}") } }
        fix { command { argv = List("google-java-format", "--aosp", "--replace", "{{files}}") } }
    }
    ["jactionlint"] = (Builtins.jactionlint) {
        check { command { argv = List("jactionlint", "--strict-exit", "--ruff=ruff", "--format", "gcc", "{{files}}") } }
        check_diff { command { argv = List("hk", "util", "sarif-diff", "--", "jactionlint", "--ruff=ruff", "--format", "sarif", "{{files}}") } }
        fix { command { argv = List("jactionlint", "--ruff=ruff", "--fix", "{{files}}") } }
    }
    ["ruff"] = Builtins.ruff
    ["ruff-format"] = (Builtins.ruff_format) { depends = "ruff" }
    ["rustfmt"] { glob = "**/*.rs"; fix = "rustfmt --config skip_children=true {{files}}" }
    ["shfmt"] = (Builtins.shfmt) { glob = "**/*.sh"; match_any = null }
    ["swiftlint"] = (Builtins.swiftlint) {
        check { command { argv = List("swiftlint", "lint", "--quiet", "{{files}}") } }
        fix { command { argv = List("swiftlint", "lint", "--fix", "--quiet", "{{files}}") } }
    }
    ["swift-format"] {
        glob = "**/*.swift"
        depends = "swiftlint"
        check = "xcrun swift-format lint --strict --parallel {{files}}"
        fix = "xcrun swift-format format --in-place --parallel {{files}}"
    }
    ["tombi"] = Builtins.tombi_format
    ["xcprojformatter"] {
        glob = "**/project.xcproj"
        check_diff = "hk util format-diff {{files}} -- xcrun xcprojformatter"
    }
}

// --- [HOOKS] ---------------------------------------------------------------------------

hooks {
    ["check"] {
        steps {
            ["plutil"] { glob = "**/*.{plist,entitlements}"; check = "plutil -lint {{files}}" }
            ["shellcheck"] = (Builtins.shellcheck) { match_any = null; glob = "**/*.sh" }
            ["tombi-lint"] = (Builtins.tombi) { check { command { argv = super.argv + List("--error-on-warnings") } } }
            ["yamllint"] = (Builtins.yamllint) {
                batch = true
                check { command { argv = List("yamllint", "--strict", "-c", ".config/yamllint.yaml", "{{files}}") } }
            }
        }
    }
    ["commit-msg"] { steps { ["conventional-commit"] = Builtins.check_conventional_commit; ["release-scope"] { check = "rasm-release scope {{commit_msg_file}}" } } }
    ["pre-commit"] { enabled = false }
}
