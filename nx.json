{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "cacheDirectory": ".cache/nx/cache",
    "neverConnectToCloud": true,
    "workspaceLayout": {
        "appsDir": "apps",
        "libsDir": "libs/typescript"
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": ["default", "!{projectRoot}/**/*.{spec,test,bench}.{ts,tsx,mts,cts}"],
        "sharedGlobals": ["{workspaceRoot}/nx.json", "{workspaceRoot}/mise.toml"],
        "python": ["{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"],
        "typescript": [
            "{workspaceRoot}/biome.json",
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/pnpm-workspace.yaml",
            "{workspaceRoot}/pnpm-lock.yaml",
            "{workspaceRoot}/vite.config.ts",
            "{workspaceRoot}/vitest.config.ts"
        ]
    },
    "targetDefaults": {
        "build": [
            {
                "cache": true
            },
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "dependsOn": ["^build", { "projects": ["rasm-workspace"], "target": "restore" }],
                "inputs": ["...", "{workspaceRoot}/global.json", "{workspaceRoot}/NuGet.config"]
            }
        ],
        "lint": [
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "executor": "nx:noop",
                "dependsOn": ["build"]
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "python"],
                "options": { "command": "uv run ruff check {projectRoot}" },
                "configurations": { "check": {}, "write": { "command": "uv run ruff check --fix {projectRoot}" } },
                "defaultConfiguration": "check"
            },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "typescript"],
                "options": { "command": "biome check {projectRoot}" },
                "configurations": { "check": {}, "write": { "command": "biome check --write {projectRoot}" } },
                "defaultConfiguration": "check"
            }
        ],
        "format": [
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": [{ "projects": ["rasm-workspace"], "target": "restore" }],
                "inputs": [
                    "default",
                    "{workspaceRoot}/.editorconfig",
                    "{workspaceRoot}/Directory.Build.props",
                    "{workspaceRoot}/Directory.Build.targets",
                    "{workspaceRoot}/Directory.Packages.props",
                    "{workspaceRoot}/global.json",
                    "{workspaceRoot}/NuGet.config"
                ],
                "options": { "command": "dotnet format --no-restore --verify-no-changes", "cwd": "{projectRoot}" },
                "configurations": { "check": {}, "write": { "command": "dotnet format --no-restore" } },
                "defaultConfiguration": "check"
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "python"],
                "options": { "command": "uv run ruff format --check {projectRoot}" },
                "configurations": { "check": {}, "write": { "command": "uv run ruff format {projectRoot}" } },
                "defaultConfiguration": "check"
            },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "typescript"],
                "options": { "command": "biome format {projectRoot}" },
                "configurations": { "check": {}, "write": { "command": "biome format --write {projectRoot}" } },
                "defaultConfiguration": "check"
            }
        ],
        "typecheck": [
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "executor": "nx:noop",
                "dependsOn": ["build"]
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": ["default", "python"],
                "options": { "commands": ["uv run ty check {projectRoot}", "uv run mypy {projectRoot}"], "parallel": false }
            },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": ["^typecheck"],
                "inputs": ["default", "^production", "typescript", { "externalDependencies": ["typescript"] }],
                "options": { "command": "tsc --build --pretty false", "cwd": "{projectRoot}" },
                "outputs": ["{workspaceRoot}/.cache/typescript/out/{projectRoot}"]
            }
        ],
        "test": [
            {
                "cache": true
            },
            {
                "filter": { "projects": ["tag:language:python"] },
                "executor": "nx:run-commands",
                "inputs": ["default", "python"],
                "outputs": [
                    "{workspaceRoot}/.artifacts/python/coverage/data/.coverage.{projectName}",
                    "{workspaceRoot}/.artifacts/python/benchmarks"
                ],
                "options": {
                    "command": "uv run pytest {projectRoot} --cov",
                    "env": { "COVERAGE_FILE": ".artifacts/python/coverage/data/.coverage.{projectName}" }
                },
                "configurations": { "benchmark": { "command": "uv run pytest -m benchmark {projectRoot}" } }
            },
            {
                "filter": { "projects": ["tag:language:dotnet"] },
                "inputs": ["...", "{workspaceRoot}/global.json", "{workspaceRoot}/NuGet.config"]
            },
            {
                "filter": { "projects": ["tag:language:typescript"] },
                "outputs": [
                    "{workspaceRoot}/.artifacts/typescript/test-results/{projectName}",
                    "{workspaceRoot}/.artifacts/typescript/test-results/.vitest-reports/{projectName}.json",
                    "{workspaceRoot}/.artifacts/typescript/bench/{projectName}.json",
                    "{workspaceRoot}/.artifacts/typescript/coverage/{projectName}"
                ]
            }
        ],
        "check": [
            {
                "filter": { "projects": ["tag:language:*"] },
                "executor": "nx:noop",
                "dependsOn": ["lint", "format", "typecheck", "test"]
            }
        ]
    },
    "pluginsConfig": {
        "@nx/js": {
            "analyzeSourceFiles": false
        }
    },
    "plugins": [
        {
            "plugin": "@nx/vite/plugin",
            "exclude": ["vite.config.ts"],
            "options": {
                "compiler": "tsc",
                "typecheckTargetName": "typecheck"
            }
        },
        {
            "plugin": "@nx/vitest",
            "exclude": ["vite.config.ts", "vitest.config.ts"],
            "options": {
                "testTargetName": "test",
                "discoverTestFiles": "glob"
            }
        },
        {
            "plugin": "@nx/dotnet",
            "exclude": ["eng/native/**"],
            "options": {
                "clean": false,
                "pack": false,
                "publish": false,
                "restore": false,
                "test": {}
            }
        },
        {
            "plugin": "./tools/nx/workspace.ts"
        }
    ]
}
