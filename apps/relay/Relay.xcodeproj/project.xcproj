{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Xcode.xcconfig" },
    { "name": "Release", "file": "Xcode.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/swiftlang/swift-subprocess",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    },
  ],
  "files": [
    { "path": "<PROJECT>/../../Xcode.xcconfig" },
    {
      "kind": "folder",
      "path": ".",
      "target-membership": [
        "Relay",
      ],
      "membership-exceptions": [
        {
          "target": "Relay",
          "exclusions": [
            "AGENTS.md",
            "CLAUDE.md",
            "LICENSE",
            "buildServer.json",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Relay.app", "id": "4A817EDECF31418AABA61701", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Relay",
      "id": "4A817EDECF31418AABA61709",
      "product": "Products/Relay.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "swift-subprocess",
          "product-name": "Subprocess",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.rasm.relay",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
      },
    },
  ],
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
