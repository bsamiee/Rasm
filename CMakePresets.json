{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 13,
    "configurePresets": [
        {
            "name": "policy",
            "hidden": true,
            "generator": "Ninja",
            "installDir": "$env{CONDA_PREFIX}",
            "warnings": { "author": true, "deprecated": true, "experimental": true, "installAbsoluteDestination": true, "nonTargetDirective": true, "policy": true, "strict": true },
            "errors": { "author": true, "deprecated": true, "experimental": true, "installAbsoluteDestination": true, "nonTargetDirective": true, "policy": true, "strict": true },
            "cacheVariables": {
                "CMAKE_CXX_EXTENSIONS": false,
                "CMAKE_CXX_SCAN_FOR_MODULES": true,
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wshadow -Wnon-virtual-dtor -Wold-style-cast -Wcast-align -Wcast-qual -Wunused -Woverloaded-virtual -Wconversion -Wsign-conversion -Wnull-dereference -Wdouble-promotion -Wformat=2 -Wimplicit-fallthrough -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE -D_GLIBCXX_ASSERTIONS",
                "CMAKE_COMPILE_WARNING_AS_ERROR": true,
                "CMAKE_LINK_LIBRARIES_ONLY_TARGETS": true,
                "CMAKE_LINKER_TYPE": "LLD",
                "CMAKE_VERIFY_INTERFACE_HEADER_SETS": true,
                "CMAKE_VERIFY_PRIVATE_HEADER_SETS": true,
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_COLOR_DIAGNOSTICS": true,
                "CMAKE_CATCH_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
            }
        },
        { "name": "default", "inherits": "policy", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "release", "inherits": "policy", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        {
            "name": "asan",
            "inherits": "policy",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Asan",
                "CMAKE_CXX_FLAGS_ASAN": "-g -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS_ASAN": "-fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS_ASAN": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "tsan",
            "inherits": "policy",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Tsan",
                "CMAKE_CXX_FLAGS_TSAN": "-g -O1 -fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS_TSAN": "-fsanitize=thread",
                "CMAKE_SHARED_LINKER_FLAGS_TSAN": "-fsanitize=thread"
            }
        }
    ],
    "buildPresets": [ { "name": "default", "configurePreset": "default" }, { "name": "release", "configurePreset": "release" }, { "name": "asan", "configurePreset": "asan" }, { "name": "tsan", "configurePreset": "tsan" } ],
    "testPresets": [
        { "name": "report", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
        { "name": "default", "inherits": "report", "configurePreset": "default" },
        { "name": "release", "inherits": "report", "configurePreset": "release" },
        { "name": "asan", "inherits": "report", "configurePreset": "asan", "environment": { "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1", "UBSAN_OPTIONS": "print_stacktrace=1" } },
        { "name": "tsan", "inherits": "report", "configurePreset": "tsan", "environment": { "TSAN_OPTIONS": "halt_on_error=1" } }
    ],
    "packagePresets": [ { "name": "release", "configurePreset": "release", "generators": [ "TXZ" ] } ],
    "workflowPresets": [
        { "name": "default", "steps": [ { "type": "configure", "name": "default" }, { "type": "build", "name": "default" }, { "type": "test", "name": "default" } ] },
        { "name": "release", "steps": [ { "type": "configure", "name": "release" }, { "type": "build", "name": "release" }, { "type": "test", "name": "release" }, { "type": "package", "name": "release" } ] },
        { "name": "asan", "steps": [ { "type": "configure", "name": "asan" }, { "type": "build", "name": "asan" }, { "type": "test", "name": "asan" } ] },
        { "name": "tsan", "steps": [ { "type": "configure", "name": "tsan" }, { "type": "build", "name": "tsan" }, { "type": "test", "name": "tsan" } ] }
    ]
}
