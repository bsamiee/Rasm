<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Rhino and Grasshopper 2 cases loaded into the host for one batch</Description>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Grasshopper2" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="Namotion.Reflection" />
    </ItemGroup>

    <ItemGroup Label="Batch">
        <Compile Include="$(HarnessCases)" Condition="'$(HarnessCases)' != ''" />
    </ItemGroup>

    <ItemGroup Label="Plug-In" Condition="'$(HarnessPlugIn)' != ''">
        <Reference Include="$(HarnessPlugIn)" Private="false" />
        <PackageReference Include="Krafs.Publicizer" />
        <Publicize Include="$([System.IO.Path]::GetFileNameWithoutExtension('$(HarnessPlugIn)'))" />
    </ItemGroup>

    <Target Name="ReferencePlugInDependencies" AfterTargets="ResolveAssemblyReferences" Condition="'$(HarnessPlugIn)' != ''">
        <ItemGroup>
            <ReferencePath Include="@(ReferenceDependencyPaths->WithMetadataValue('OriginalItemSpec', '$(HarnessPlugIn)'))" />
        </ItemGroup>
    </Target>

    <Target Name="ReferenceRhinoInstall" AfterTargets="ResolveLockFileReferences" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(TargetPlatformIdentifier)' != 'Windows'">
        <ItemGroup>
            <_PackageRhino Include="@(Reference->WithMetadataValue('NuGetPackageId', 'RhinoCommon'))" />
            <Reference Remove="@(_PackageRhino)" />
            <Reference Include="@(_PackageRhino->'$(_RhinoResourcesDir)%(Filename)%(Extension)');$(_RhinoResourcesDir)Rhino.Runtime.Code.dll;$(_RhinoResourcesDir)RhinoCodePlatform.Rhino3D.dll" HintPath="" Private="false" />
        </ItemGroup>
    </Target>
</Project>
