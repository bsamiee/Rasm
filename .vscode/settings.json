{
    // --- [EXPLORER_VISIBILITY] ---------------------------------------------------------
    "explorer.compactFolders": false,
    "files.exclude": {
        ".cargo/rustc-source": true,
        ".swiftpm": true,
        "**/.artifacts": true,
        "**/.cloudflare": true,
        "**/.pixi": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/xcuserdata": true
    },

    // --- [FILE_WATCHING] ---------------------------------------------------------------
    "files.watcherExclude": {
        ".cargo/rustc-source/**": true,
        "**/.artifacts/**": true,
        "**/.cloudflare/**": true,
        "**/.pixi/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/dist/**": true,
        "**/docs/research/**": true,
        "**/node_modules/**": true
    },

    // --- [FILE_NESTING] ----------------------------------------------------------------
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        ".gitignore": ".gitattributes",
        "Cargo.toml": "Cargo.lock, clippy.toml, rust-toolchain.toml, rustfmt.toml",
        "CLAUDE.md": ".mcp.json, AGENTS.md",
        "Directory.Build.props": "Directory.Build.rsp, Directory.Build.targets, Directory.Packages.props, global.json, NuGet.config, Workspace.slnx",
        "nx.json": ".editorconfig, mise.toml, sgconfig.yml",
        "package.json": "biome.json, pnpm-lock.yaml, pnpm-workspace.yaml, tsconfig.base.json, tsconfig.json, vite.shared.ts, vitest.config.ts",
        "Package.swift": ".swift-format, .swiftlint.yml, Package.resolved, Xcode.xcconfig",
        "pyproject.toml": "pixi.lock, uv.lock",
        "README.md": "LICENSE"
    },

    // --- [PYTHON] ----------------------------------------------------------------------
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": false,
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "mypy-type-checker.ignorePatterns": [ "libs/python/blender/*", "apps/blender/*", "tests/python/libs/blender/bpy/background/*" ],
    "ty.experimental.useUv": "on",
    "ty.diagnosticMode": "workspace",
    "ty.configuration": { "overrides": [ { "include": [ "libs/python/blender/**", "apps/blender/**", "tests/python/libs/blender/bpy/background/**" ], "rules": { "all": "ignore" } } ] },
    "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },

    // --- [TYPESCRIPT] ------------------------------------------------------------------
    "js/ts.experimental.useTsgo": true,
    "js/ts.tsdk.path": "./node_modules/typescript",
    "json.schemas": [ { "fileMatch": [ "biome.json" ], "url": "./node_modules/@biomejs/biome/configuration_schema.json" }, { "fileMatch": [ "nx.json" ], "url": "./node_modules/nx/schemas/nx-schema.json" } ],
    "css.validate": false,
    "[typescript][typescriptreact][javascript][javascriptreact][json][jsonc][css]": { "editor.defaultFormatter": "biomejs.biome" },

    // --- [DOTNET] ----------------------------------------------------------------------
    "csharp.suppressBuildAssetsNotification": true,
    "dotnet.defaultSolution": "Workspace.slnx",
    "dotnet.projects.enableAutomaticRestore": false,
    "dotnet.server.useServerGC": false,

    // --- [RUST] ------------------------------------------------------------------------
    "rust-analyzer.cargo.extraEnv": { "CARGO_BUILD_BUILD_DIR": "{cargo-cache-home}/build/{workspace-path-hash}/rust-analyzer", "CARGO_BUILD_TARGET_DIR": "${workspaceFolder}/.artifacts/rust/rust-analyzer" },
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.check.workspace": false,
    "rust-analyzer.check.allTargets": false,
    "rust-analyzer.check.extraArgs": [ "--locked" ],
    "rust-analyzer.rustc.source": ".cargo/rustc-source/Cargo.toml",

    // --- [SWIFT] -----------------------------------------------------------------------
    "swift.autoGenerateLaunchConfigurations": false,
    "swift.disableAutoResolve": true,

    // --- [JAVA] ------------------------------------------------------------------------
    "java.configuration.runtimes": [ { "default": true, "name": "JavaSE-27", "path": "${JAVA_HOME}" } ],
    "java.import.exclusions": [ "**/.metadata/**", "**/archetype-resources/**", "**/META-INF/maven/**", "**/node_modules/**" ],
    "java.import.maven.enabled": false,
    "java.import.gradle.enabled": false,
    "java.project.sourcePaths": [ ".claude/skills/use-ghidra/scripts" ],
    "java.project.referencedLibraries": [ "${GHIDRA_INSTALL_DIR}/Ghidra/**/lib/*.jar" ],

    // --- [YAML] ------------------------------------------------------------------------
    "yaml.format.enable": false,

    // --- [SHELL] -----------------------------------------------------------------------
    "[shellscript]": { "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode" },

    // --- [TOML] ------------------------------------------------------------------------
    "[toml]": { "editor.defaultFormatter": "tombi-toml.tombi" },

    // --- [MISE] ------------------------------------------------------------------------
    "mise.enableConfigDiagnostics": false
}
