        return statics(BridgeTalk, RealBridgeTalk, { launch: refusing(session, "BridgeTalk.launch"), bringToFront: refusing(session, "BridgeTalk.bringToFront"), ping: refusing(session, "BridgeTalk.ping") });
    }

    // --- [PREFERENCES]
    function kinds() {
        var found = [];
        var methods = realApp.preferences.reflect.methods;
        for (var i = 0; i < methods.length; i++) {
            var parts = PREFERENCE.exec(methods[i].name);
            if (parts) { found.push(parts[1]); }
