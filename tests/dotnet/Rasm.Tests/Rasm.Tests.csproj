<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Geometry, layout, and image behavior against independent native calculations</Description>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.HighPerformance" />
        <PackageReference Include="NodaTime" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="HyperJet" PrivateAssets="contentfiles;analyzers;build;buildtransitive" />
        <PackageReference Include="MathNet.Numerics" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
        <PackageReference Include="Wacton.Unicolour.Datasets" />
    </ItemGroup>

    <ItemGroup Label="Imaging">
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="TinyEXR.NET" />
    </ItemGroup>

    <ItemGroup Label="User Interface">
        <PackageReference Include="SkiaSharp" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageReference Include="CsCheck" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../../../libs/dotnet/bim/Rasm.Drafting/Rasm.Drafting.csproj" />
        <ProjectReference Include="../../../libs/dotnet/geometry/Rasm.Spatial/Rasm.Spatial.csproj" />
        <ProjectReference Include="../../../libs/dotnet/graphics/Rasm.Imaging/Rasm.Imaging.csproj" />
        <ProjectReference Include="../../../libs/dotnet/ui/Rasm.UI/Rasm.UI.csproj" />
        <ProjectReference Include="../Rasm.TestSupport/Rasm.TestSupport.csproj" />
    </ItemGroup>
</Project>
