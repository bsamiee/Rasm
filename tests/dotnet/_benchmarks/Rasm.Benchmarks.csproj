<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Optimize>true</Optimize>
    </PropertyGroup>
    <ItemGroup Label="Benchmark Packages">
        <PackageReference Include="BenchmarkDotNet" />
    </ItemGroup>

    <ItemGroup Label="Corpus Manifest">
        <ProjectReference Include="$(TestKitRoot)Rasm.TestKit.csproj" />
    </ItemGroup>

    <ItemGroup Label="Assembly Visibility">
        <InternalsVisibleTo Include="Rasm.Architecture.Tests" />
    </ItemGroup>

    <ItemGroup Label="Assembly Metadata">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>RasmWorkspaceRoot</_Parameter1>
            <_Parameter2>$(SolutionDir)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
