<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>RhinoCommon as typed effects, with plug-ins declared as data</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup Label="Global Usings">
        <Using Include="UnitsNet.Temperature" Alias="Temperature" />
    </ItemGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Microsoft.Win32.SystemEvents" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="LanguageExt.Streaming" />
        <PackageReference Include="Microsoft.VisualStudio.Threading" />
        <PackageReference Include="Mono.Unix" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="Riok.Mapperly" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Json" />
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="HyperJet" PrivateAssets="contentfiles;analyzers;build;buildtransitive" />
        <PackageReference Include="MathNet.Numerics" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="QuikGraph" />
        <PackageReference Include="SuperLinq" />
    </ItemGroup>

    <ItemGroup Label="Geospatial">
        <PackageReference Include="NetTopologySuite" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Application Hosting">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup Label="User Interface">
        <PackageReference Include="CommunityToolkit.Mvvm" />
    </ItemGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../../bim/Rasm.Drafting/Rasm.Drafting.csproj" />
        <ProjectReference Include="../../geometry/Rasm.Spatial/Rasm.Spatial.csproj" />
    </ItemGroup>
</Project>
