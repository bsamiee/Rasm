{
    "name": "@rasm/media",
    "version": "0.1.0",
    "private": true,
    "description": "Browser media for web apps: file inspection with resized image renditions and their srcset, Uppy upload preprocessing and transient-failure retry for XHR uploads, pdf.js documents and a page viewer with navigation, fit, zoom, pan, rotation, and find, a zoom-and-pan image viewer, and the Vite copy of pdf.js assets",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/web/media"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts",
        "#/*.tsx": "./*.tsx"
    },
    "exports": {
        ".": "./index.ts",
        "./pdf-document": "./pdf-document.ts",
        "./pdf-viewer": "./pdf-viewer.tsx",
        "./vite": "./vite.ts",
        "./zoom-viewer": "./zoom-viewer.tsx",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.tsx": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./pdf-document": "./dist/pdf-document.js",
            "./pdf-viewer": "./dist/pdf-viewer.js",
            "./vite": "./dist/vite.js",
            "./zoom-viewer": "./dist/zoom-viewer.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@use-gesture/react": "catalog:",
        "lucide-react": "catalog:",
        "vite-plugin-static-copy": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@uppy/core": "catalog:",
        "effect": "catalog:",
        "pdfjs-dist": "catalog:",
        "react": "catalog:",
        "react-aria-components": "catalog:",
        "react-zoom-pan-pinch": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "@uppy/core": "catalog:peers",
        "effect": "catalog:peers",
        "pdfjs-dist": "catalog:peers",
        "react": "catalog:peers",
        "react-aria-components": "catalog:peers",
        "react-zoom-pan-pinch": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "react-zoom-pan-pinch": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
