{
    "name": "@rasm/atelier",
    "private": true,
    "description": "MCP server driving installed Adobe applications through six universal tools, applications, view, inspect, act, execute_script, and diagnostics, with their events in every result, and serving the tools each linked Adobe extension adds",
    "os": [
        "darwin"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/cep": "workspace:*",
        "@rasm/creative-cloud-desktop": "workspace:*",
        "@rasm/extendscript": "workspace:*",
        "@rasm/indesign": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/quran": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "@rasm/typography": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "vite": "catalog:"
    },
    "nx": {
        "targets": {
            "build--vite": {
                "inputs": [
                    "...",
                    "{projectRoot}/macos/Atelier.xcodeproj/project.xcproj",
                    "{projectRoot}/macos/Atelier.entitlements",
                    "{workspaceRoot}/Xcode.xcconfig"
                ]
            }
        }
    }
}
