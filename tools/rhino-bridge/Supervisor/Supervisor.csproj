<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Workstation session owner for bridge verbs, session state, policy rows, and terminal envelope folding.</Description>
        <OutputType>Exe</OutputType>
        <AssemblyName>Rasm.Bridge.Supervisor</AssemblyName>
        <RootNamespace>Rasm.Bridge.Supervisor</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup Label="Assembly Visibility">
        <InternalsVisibleTo Include="Rasm.Bridge.Supervisor.Gate" />
        <InternalsVisibleTo Include="Rasm.Bridge.Supervisor.Tests" />
    </ItemGroup>
    <ItemGroup Label="Supervisor Packages">
        <PackageReference Include="StreamJsonRpc" />
        <PackageReference Include="System.IO.Hashing" />
    </ItemGroup>

    <ItemGroup Label="Project References">
        <ProjectReference Include="../Contract/Contract.csproj" />
        <ProjectReference Include="../Cargo/Cargo.csproj" RasmInfra="true" />
        <ProjectReference Include="../Stub/Stub.csproj" ReferenceOutputAssembly="false" RasmInfra="true" />
        <ProjectReference Include="../../../tests/dotnet/scenarios/Rasm.Scenarios.csproj" RasmInfra="true" />
    </ItemGroup>
</Project>
