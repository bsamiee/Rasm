amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// --- [SETTINGS] -------------------------------------------------------------------------

fail_fast = false

// --- [STEPS] ----------------------------------------------------------------------------

steps {
  ["grammars"] {
    check = new CommandSpec {
      command =
        "cmake -S tools/ast-grep/grammars --preset default && cmake --build --presets-file tools/ast-grep/grammars/CMakePresets.json --preset default"
      effect = "write"
    }
    stomp = true
  }
  ["ast-grep"] {
    glob = "**/*"
    depends = "grammars"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "ast-grep",
            "scan",
            "--custom-languages",
            "allow",
            "--report-style",
            "short",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("ast-grep", "scan", "--custom-languages", "allow", "--update-all", "{{files}}")
      }
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["biome"] = (Builtins.biome) {
    glob = "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,html,vue,svelte,astro,grit}"
    check {
      command {
        argv =
          List("biome", "check", "--error-on-warnings", "--no-errors-on-unmatched", "{{files}}")
      }
    }
    fix {
      command {
        argv =
          List(
            "biome",
            "check",
            "--write",
            "--error-on-warnings",
            "--no-errors-on-unmatched",
            "{{files}}",
          )
      }
    }
  }
  ["compose"] {
    glob = "**/compose*.{yaml,yml}"
    check = new CommandSpec {
      command = new Command {
        argv =
          List("docker", "compose", "--profile", "*", "--file", "{{files}}", "config", "--quiet")
      }
      effect = "read"
    }
  }
  ["dotnet-format"] {
    glob = "**/*.cs"
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "dotnet",
            "format",
            "whitespace",
            "--folder",
            "--verify-no-changes",
            "--include",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("dotnet", "format", "whitespace", "--folder", "--include", "{{files}}")
      }
      effect = "write"
    }
  }
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    glob = "**/*.{csproj,fsproj,vbproj,props,targets,slnx,pkl,plist,entitlements}"
  }
  ["google-java-format"] = (Builtins.google_java_format) {
    check {
      command {
        argv =
          List("google-java-format", "--aosp", "--dry-run", "--set-exit-if-changed", "{{files}}")
      }
    }
    check_list_files {
      command { argv = List("google-java-format", "--aosp", "--dry-run", "{{files}}") }
    }
    fix { command { argv = List("google-java-format", "--aosp", "--replace", "{{files}}") } }
  }
  ["jactionlint"] = (Builtins.jactionlint) {
    check {
      command { argv = List("jactionlint", "--strict-exit", "--format", "gcc", "{{files}}") }
    }
    diagnostic_format = "gcc"
  }
  ["javac"] {
    glob = "**/*.java"
    check = new CommandSpec {
      command =
        "javac -J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED -J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED -XDcompilePolicy=simple --should-stop=ifError=FLOW -processorpath \"${JAVAC_PLUGINS:?error prone is not installed}\" \"-Xplugin:ErrorProne -XepAllSuggestionsAsWarnings -Xep:DefaultPackage:OFF -Xep:RequireExplicitNullMarking:OFF -XepOpt:NullAway:AnnotatedPackages=rasm\" -Xlint:all,-path -Werror -d .cache/javac -cp \"${GHIDRA_CLASSPATH:?ghidra is not installed}\" -sourcepath .claude/skills/use-ghidra/scripts {{files}}"
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["pmd"] {
    glob = "**/*.java"
    depends = "javac"
    check = new CommandSpec {
      command =
        "pmd check --rulesets .config/pmd.xml --no-cache --no-progress --aux-classpath \".cache/javac:${JAVA_HOME:?}/lib/jrt-fs.jar:${GHIDRA_CLASSPATH:?ghidra is not installed}\" {{files}}"
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["hk"] {
    glob = ".config/hk.pkl"
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate", "--deny-warnings") }
      effect = "read"
    }
  }
  ["pkl-format"] = Builtins.pkl_format
  ["plutil"] {
    glob = "**/*.{plist,entitlements}"
    check = new CommandSpec {
      command = new Command { argv = List("plutil", "-lint", "-s", "{{files}}") }
      effect = "read"
    }
  }
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = (Builtins.ruff_format) { depends = "ruff" }
  ["rustfmt"] = (Builtins.rustfmt) {
    batch = true
    check {
      command { argv = List("rustfmt", "--check", "--config", "skip_children=true", "{{files}}") }
    }
    check_list_files {
      command {
        argv =
          List(
            "rustfmt",
            "--check",
            "--files-with-diff",
            "--config",
            "skip_children=true",
            "{{files}}",
          )
      }
    }
    fix { command { argv = List("rustfmt", "--config", "skip_children=true", "{{files}}") } }
  }
  ["squawk"] {
    glob = "**/*.pgsql"
    check = new CommandSpec {
      command = new Command { argv = List("squawk", "--reporter", "gcc", "{{files}}") }
      effect = "read"
    }
    diagnostic_format = "gcc"
  }
  ["swiftlint"] = (Builtins.swiftlint) {
    check { command { argv = List("swiftlint", "lint", "--quiet", "{{files}}") } }
    fix { command { argv = List("swiftlint", "lint", "--fix", "--quiet", "{{files}}") } }
    diagnostic_format = "gcc-paren"
  }
  ["swift-format"] {
    glob = "**/*.swift"
    depends = "swiftlint"
    check = new CommandSpec {
      command = new Command {
        argv = List("swift", "format", "lint", "--strict", "--parallel", "{{files}}")
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("swift", "format", "format", "--in-place", "--parallel", "{{files}}")
      }
      effect = "write"
    }
    diagnostic_format = "gcc"
  }
  ["tombi"] = (Builtins.tombi) {
    check {
      command { argv = List("tombi", "lint", "--quiet", "--error-on-warnings", "{{files}}") }
    }
  }
  ["tombi-format"] = Builtins.tombi_format
  ["xcprojformatter"] {
    glob = "**/project.xcproj"
    check_diff = new CommandSpec {
      command = new Command {
        argv = List("hk", "util", "format-diff", "{{files}}", "--", "xcrun", "xcprojformatter")
      }
      effect = "read"
    }
  }
  ["yamllint"] = (Builtins.yamllint) {
    batch = true
    check { command { argv = List("yamllint", "--strict", "--format", "standard", "{{files}}") } }
    diagnostic_format = "stylish"
  }
}

// --- [HOOKS] ----------------------------------------------------------------------------

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
      ["commit-scope"] {
        check = new CommandSpec {
          command =
            #"""
            scope=$(sed -n '/^#/d;s/^[a-z]\{1,\}(\([^)]*\))!\{0,1\}: .*/\1/p;q' "{{commit_msg_file}}")
            [ -z "$scope" ] && exit 0
            projects=$(nx show projects --no-json) || exit
            printf '%s\n' "$projects" | grep -Fqx -- "$scope" && exit 0
            echo "Commit scope '$scope' is no Nx project, use one nx show projects lists or drop it" >&2
            exit 1
            """#
          effect = "read"
        }
      }
    }
  }
  ["pre-commit"] { enabled = false }
}
