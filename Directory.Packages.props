<Project>
    <!-- Group packages by domain and keep each package family together -->
    <PropertyGroup Label="Central Package Management">
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>

    <ItemGroup Label="Analyzers">
        <PackageVersion Include="ErrorProne.NET.CoreAnalyzers"                            Version="0.9.0-beta.4" />          <!-- Roslyn analyzers detecting common correctness and performance coding issues -->
        <PackageVersion Include="Meziantou.Analyzer"                                      Version="3.0.190" />               <!-- Roslyn analyzers enforcing C# design, usage, security, and performance rules -->
        <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers"              Version="18.7.23" />               <!-- Roslyn analyzers flagging async and threading hazards such as deadlocks -->
        <PackageVersion Include="Roslynator.Analyzers"                                    Version="5.0.0" />                 <!-- Several hundred C# code quality analyzers, refactorings, and fixes -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.Analyzers"               Version="10.5.0" />                <!-- Analyzers validating smart enum, value object, and union declarations -->
    </ItemGroup>

    <ItemGroup Label="Rhino">
        <PackageVersion Include="System.Drawing.Common"                                   Version="10.0.11" />               <!-- GDI+ based drawing, imaging, and text rendering API -->
        <PackageVersion Include="Rhino3dm"                                                Version="8.35.0-beta1" />          <!-- openNURBS geometry access for reading and writing 3dm files -->
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageVersion Include="CommunityToolkit.HighPerformance"                        Version="8.4.2" />                 <!-- Helpers for spans, buffers, and memory in performance-critical code -->
        <PackageVersion Include="LanguageExt.Core"                                        Version="5.0.0-beta-77" />         <!-- Functional programming base: option, either, immutable collections, and effects -->
        <PackageVersion Include="LanguageExt.Parsec"                                      Version="5.0.0-beta-77" />         <!-- Parser combinators ported from Haskell Parsec -->
        <PackageVersion Include="LanguageExt.Streaming"                                   Version="5.0.0-beta-77" />         <!-- Compositional streaming with pipes, sources, sinks, and conduits -->
        <PackageVersion Include="LanguageExt.Sys"                                         Version="5.0.0-beta-77" />         <!-- Effect wrappers for console, file system, time, and environment -->
        <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream"                     Version="4.0.1-preview" />         <!-- Pooled memory stream allocator reducing garbage collection pressure -->
        <PackageVersion Include="NodaTime"                                                Version="3.3.3" />                 <!-- Date and time types with explicit calendars, instants, and zones -->
        <PackageVersion Include="NodaTime.Serialization.Protobuf"                         Version="2.0.2" />                 <!-- Protobuf well-known type conversions for instants and durations -->
        <PackageVersion Include="NodaTime.Serialization.SystemTextJson"                   Version="1.4.0" />                 <!-- JSON converters for instants, durations, zones, and calendar dates -->
        <PackageVersion Include="Riok.Mapperly"                                           Version="5.0.0-next.10" />         <!-- Source-generated object mapper with compile-time diagnostics -->
        <PackageVersion Include="System.IO.Hashing"                                       Version="11.0.0-preview.7.26381.103" /> <!-- Non-cryptographic hash algorithms including CRC and xxHash -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions"                         Version="10.5.0" />                <!-- Source-generated smart enums, value objects, and discriminated unions -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.EntityFrameworkCore10"   Version="10.5.0" />                <!-- Entity Framework Core value converters for smart enums and value objects -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.Json"                    Version="10.5.0" />                <!-- JSON serialization for smart enums and value objects -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.MessagePack"             Version="10.5.0" />                <!-- MessagePack serialization for smart enums and value objects -->
        <PackageVersion Include="Thinktecture.Runtime.Extensions.Serilog"                 Version="10.5.0" />                <!-- Serilog destructuring for smart enums, value objects, and unions -->
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageVersion Include="NodaMoney"                                               Version="2.7.0" />                 <!-- Money value type with currency handling and formatting -->
        <PackageVersion Include="NodaMoney.DependencyInjection"                           Version="2.7.0" />                 <!-- Dependency injection registration extensions for money services -->
        <PackageVersion Include="UnitsNet"                                                Version="6.0.0-pre103" />          <!-- Physical quantities and units with conversion and arithmetic -->
        <PackageVersion Include="UnitsNet.Serialization.SystemTextJson"                   Version="6.0.0-pre103" />          <!-- JSON serialization helpers for physical quantity types -->
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageVersion Include="AngouriMath"                                             Version="2.4.0" />                 <!-- Symbolic algebra: simplification, calculus, equation solving, LaTeX output -->
        <PackageVersion Include="CSparse"                                                 Version="4.4.1" />                 <!-- Sparse LU, Cholesky, and QR factorization for real and complex systems -->
        <PackageVersion Include="HyperJet"                                                Version="0.3.0" />                 <!-- Automatic differentiation computing gradients and Hessians with SIMD acceleration -->
        <PackageVersion Include="MatFlat"                                                 Version="0.8.3" />                 <!-- Matrix decomposition routines implemented in pure C# -->
        <PackageVersion Include="MathNet.Numerics"                                        Version="6.0.0-beta2" />           <!-- Numerical methods: linear algebra, statistics, interpolation, special functions -->
        <PackageVersion Include="MathNet.Numerics.Data.Matlab"                            Version="6.0.0-beta2" />           <!-- MATLAB data file reading and writing for matrices -->
        <PackageVersion Include="MathNet.Numerics.Data.Text"                              Version="6.0.0-beta2" />           <!-- Delimited text and MatrixMarket matrix input and output -->
        <PackageVersion Include="Meta.Numerics"                                           Version="4.2.0" />                 <!-- Advanced numerics: statistics, matrix algebra, special functions, extended precision -->
        <PackageVersion Include="Microsoft.ML.Probabilistic"                              Version="0.4.2504.701" />          <!-- Bayesian inference framework for probabilistic graphical models -->
        <PackageVersion Include="Microsoft.ML.Probabilistic.Compiler"                     Version="0.4.2504.701" />          <!-- Inference engine compiling probabilistic models into efficient code -->
        <PackageVersion Include="Microsoft.ML.Probabilistic.Learners"                     Version="0.4.2504.701" />          <!-- Complete Bayesian classifier and recommender learning applications -->
        <PackageVersion Include="PeterO.Numbers"                                          Version="1.8.2" />                 <!-- Arbitrary-precision binary, decimal, and rational number arithmetic -->
        <PackageVersion Include="System.Numerics.Tensors"                                 Version="11.0.0-preview.7.26381.103" /> <!-- Tensor primitives with SIMD-accelerated span operations -->
        <PackageVersion Include="TYoshimura.DoubleDouble"                                 Version="5.0.8" />                 <!-- Double-double arithmetic with 106-bit mantissa and special functions -->
        <PackageVersion Include="TYoshimura.DoubleDouble.Complex"                         Version="2.0.1" />                 <!-- Complex number arithmetic over double-double precision values -->
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageVersion Include="Akade.IndexedSet"                                        Version="1.5.0" />                 <!-- In-memory collection with unique, range, fuzzy, and spatial indexes -->
        <PackageVersion Include="Cloud.Unum.USearch"                                      Version="2.26.2" />                <!-- Single-file vector similarity search and clustering engine using HNSW -->
        <PackageVersion Include="DotNext"                                                 Version="6.7.0" />                 <!-- Base class library extensions: value delegates, buffers, reflection helpers -->
        <PackageVersion Include="DotNext.IO"                                              Version="6.7.0" />                 <!-- Stream and pipe decoding and encoding helpers -->
        <PackageVersion Include="DotNext.Threading"                                       Version="6.7.0" />                 <!-- Async synchronization primitives: locks, events, barriers, and triggers -->
        <PackageVersion Include="FastCDC.Net"                                             Version="1.0.1" />                 <!-- FastCDC content-defined chunking for deduplication -->
        <PackageVersion Include="LoroCs"                                                  Version="1.13.9" />                <!-- CRDT collaborative document and data structure bindings -->
        <PackageVersion Include="QuikGraph"                                               Version="2.5.0" />                 <!-- Graph data structures and algorithms: traversal, shortest paths, flows -->
        <PackageVersion Include="QuikGraph.Graphviz"                                      Version="2.5.0" />                 <!-- Graphviz DOT serialization for graph structures -->
        <PackageVersion Include="QuikGraph.Petri"                                         Version="2.5.0" />                 <!-- Petri net construction and simulation -->
        <PackageVersion Include="QuikGraph.Serialization"                                 Version="2.5.0" />                 <!-- Graph structure serialization including GraphML -->
        <PackageVersion Include="Supercluster.KDTree.Net"                                 Version="1.0.22" />                <!-- Immutable k-d tree for fast nearest-neighbor searches -->
        <PackageVersion Include="SwiftCollections.Lean"                                   Version="7.0.0" />                 <!-- Low-allocation collections, sparse sets, and spatial query structures -->
    </ItemGroup>

    <ItemGroup Label="Solvers">
        <PackageVersion Include="GeneticSharp"                                            Version="3.1.4" />                 <!-- Multithreaded genetic algorithm library with extensible operators -->
        <PackageVersion Include="Google.OrTools"                                          Version="9.15.6755" />             <!-- Operations research toolkit: linear, constraint, and vehicle routing solvers -->
        <PackageVersion Include="Kiwi"                                                    Version="3.0.0" />                 <!-- C# port of the Cassowary constraint-solving algorithm -->
        <PackageVersion Include="Pagmo.NET"                                               Version="1.0.0" />                 <!-- Metaheuristic and gradient-based optimization with parallel island evolution -->
        <PackageVersion Include="Pagmo.NET.Ipopt"                                         Version="1.0.0" />                 <!-- Interior-point nonlinear solver plugin packaging Ipopt -->
        <PackageVersion Include="Rasm.Native.Z3"                                          Version="5.0.0" />                 <!-- Z3 theorem prover shared library staged per runtime identifier -->
        <PackageVersion Include="Rasm.Z3"                                                 Version="5.0.0" />                 <!-- Z3 theorem prover managed bindings built from pinned sources -->
    </ItemGroup>

    <ItemGroup Label="Geometry">
        <PackageVersion Include="CavalierContours"                                        Version="2.0.0" />                 <!-- 2D polyline offsetting and boolean operations with arc support -->
        <PackageVersion Include="CDT.NET"                                                 Version="1.1.0" />                 <!-- Constrained and conforming Delaunay triangulation with hole detection -->
        <PackageVersion Include="Clipper2"                                                Version="2.0.0" />                 <!-- Polygon boolean operations and offsetting -->
        <PackageVersion Include="Delaunator"                                              Version="1.0.11" />                <!-- Fast Delaunay triangulation of 2D points -->
        <PackageVersion Include="Evergine.Bindings.MeshOptimizer"                         Version="2026.8.3.18" />           <!-- Low-level bindings for mesh rendering optimization and simplification -->
        <PackageVersion Include="GeometRi"                                                Version="1.5.0.8" />               <!-- 3D geometry primitives with transformations, distances, and intersections -->
        <PackageVersion Include="ManifoldRust"                                            Version="0.5.0" />                 <!-- Bindings for the Rust port of the Manifold mesh boolean kernel -->
        <PackageVersion Include="MeshLib"                                                 Version="3.1.3.429" />             <!-- 3D mesh processing: booleans, repair, offsetting, simplification, triangulation -->
        <PackageVersion Include="MIConvexHull"                                            Version="1.1.19.1019" />           <!-- Convex hull, Delaunay triangulation, and Voronoi computation in arbitrary dimensions -->
        <PackageVersion Include="PicoGK"                                                  Version="2.3.0" />                 <!-- Compact voxel-based geometry kernel for computational engineering -->
        <PackageVersion Include="Rasm.Gmsh"                                               Version="4.15.2" />                <!-- Gmsh mesh generator bindings generated from the pinned API definition -->
        <PackageVersion Include="Rasm.Native.Gmsh"                                        Version="4.15.2" />                <!-- Gmsh finite element mesh generator shared library staged per runtime identifier -->
        <PackageVersion Include="RectangleBinPack.CSharp"                                 Version="1.0.4" />                 <!-- Rectangle bin packing with MaxRects, Skyline, Guillotine, and Shelf heuristics -->
        <PackageVersion Include="SharpVoronoiLib"                                         Version="1.2.0" />                 <!-- Fortune's algorithm Voronoi tessellation with border closure and relaxation -->
    </ItemGroup>

    <ItemGroup Label="Point Clouds">
        <PackageVersion Include="Aardvark.Data.E57"                                       Version="5.6.3" />                 <!-- E57 point cloud file format parser -->
        <PackageVersion Include="Aardvark.Data.Points.Base"                               Version="5.6.3" />                 <!-- Shared chunked import infrastructure for point cloud formats -->
        <PackageVersion Include="Aardvark.Geometry.Normals"                               Version="5.6.3" />                 <!-- Normal estimation for point clouds via k-d tree neighborhoods -->
        <PackageVersion Include="Aardvark.Geometry.PointSet"                              Version="5.6.3" />                 <!-- Out-of-core point cloud data structure and queries -->
        <PackageVersion Include="Aardvark.Geometry.PointTree"                             Version="5.6.3" />                 <!-- Spatial k-d tree structure for closest-point queries on point sets -->
        <PackageVersion Include="Altemiq.IO.Las"                                          Version="1.5.0" />                 <!-- Low-allocation reading and writing of LAS point streams -->
        <PackageVersion Include="Altemiq.IO.Las.Arrow"                                    Version="1.5.0" />                 <!-- Apache Arrow record batch conversion for LAS point clouds -->
        <PackageVersion Include="Altemiq.IO.Las.Cloud"                                    Version="1.5.0" />                 <!-- Cloud-optimized point cloud COPC hierarchy support -->
        <PackageVersion Include="Altemiq.IO.Las.Compression"                              Version="1.5.0" />                 <!-- LAZ compressed point cloud reading and writing -->
        <PackageVersion Include="Altemiq.IO.Las.Geodesy"                                  Version="1.5.0" />                 <!-- Coordinate reference system records via proj database lookup -->
        <PackageVersion Include="Altemiq.IO.Las.Indexing"                                 Version="1.5.0" />                 <!-- Spatial indexing of point cloud files for windowed reads -->
        <PackageVersion Include="Altemiq.IO.Las.S3"                                       Version="1.5.0" />                 <!-- Streaming point cloud reads from Amazon S3 storage -->
        <PackageVersion Include="Ply.Net"                                                 Version="5.6.3" />                 <!-- PLY point cloud data parser -->
        <PackageVersion Include="Unofficial.laszip.netstandard"                           Version="5.6.3" />                 <!-- LASzip compressed LiDAR codec ported to C# -->
    </ItemGroup>

    <ItemGroup Label="Geospatial">
        <PackageVersion Include="bertt.CityJSON"                                          Version="2.5.0" />                 <!-- CityJSON city model file reading and writing -->
        <PackageVersion Include="CesiumLanguageWriter"                                    Version="3.3.0" />                 <!-- CZML scene description writing for Cesium visualization -->
        <PackageVersion Include="DEM.Net.Core"                                            Version="8.0.1" />                 <!-- Digital elevation model retrieval, elevation queries, and terrain meshes -->
        <PackageVersion Include="DEM.Net.glTF"                                            Version="8.0.1" />                 <!-- glTF terrain model export from elevation data -->
        <PackageVersion Include="FlatGeobuf"                                              Version="3.26.0" />                <!-- Binary geographic feature format encoding based on flatbuffers -->
        <PackageVersion Include="Geo"                                                     Version="3.0.0" />                 <!-- Geographic geometry, GPS file formats, and geodetic calculations -->
        <PackageVersion Include="GeographicLib.NET"                                       Version="2.3.2" />                 <!-- Geodesic distance, azimuth, and geodetic problem solutions -->
        <PackageVersion Include="geohash-dotnet"                                          Version="3.0.0" />                 <!-- Geohash encoding, decoding, and neighbor computation -->
        <PackageVersion Include="GeoTimeZone"                                             Version="6.1.0" />                 <!-- IANA time zone lookup from latitude and longitude -->
        <PackageVersion Include="GISBlox.IO.GeoParquet"                                   Version="1.1.1" />                 <!-- GeoParquet columnar geospatial file reading and writing -->
        <PackageVersion Include="mapbox-vector-tile"                                      Version="5.3.1" />                 <!-- Vector tile encoding and decoding for map features -->
        <PackageVersion Include="MaxRev.Gdal.Core"                                        Version="3.13.3.557" />            <!-- GDAL bindings for raster and vector geospatial formats -->
        <PackageVersion Include="MaxRev.Gdal.LinuxRuntime.Minimal"                        Version="3.13.3.557" />            <!-- Native GDAL, PROJ, and GEOS libraries for Linux runtimes -->
        <PackageVersion Include="MaxRev.Gdal.MacosRuntime.Minimal.arm64"                  Version="3.13.3.557" />            <!-- Native GDAL, PROJ, and GEOS libraries for Apple silicon -->
        <PackageVersion Include="MaxRev.Gdal.WindowsRuntime.Minimal"                      Version="3.13.3.557" />            <!-- Native GDAL, PROJ, and GEOS libraries for Windows x64 -->
        <PackageVersion Include="NetTopologySuite"                                        Version="2.6.0" />                 <!-- Planar geometry model with OGC simple features operations -->
        <PackageVersion Include="NetTopologySuite.IO.Esri.Shapefile"                      Version="1.2.0" />                 <!-- Forward-only Esri shapefile readers and writers -->
        <PackageVersion Include="NetTopologySuite.IO.GeoJSON4STJ"                         Version="4.0.0" />                 <!-- GeoJSON serialization of geometries and features -->
        <PackageVersion Include="NetTopologySuite.IO.VectorTiles"                         Version="1.1.0" />                 <!-- Vector tile writing for geometries and features -->
        <PackageVersion Include="NetTopologySuite.IO.VectorTiles.GeoJson"                 Version="1.1.0" />                 <!-- Tile output of features as GeoJSON documents -->
        <PackageVersion Include="NetTopologySuite.IO.VectorTiles.Mapbox"                  Version="1.1.0" />                 <!-- Mapbox protobuf vector tile encoding -->
        <PackageVersion Include="Nominatim.API"                                           Version="2.1.0" />                 <!-- Forward and reverse geocoding client for Nominatim services -->
        <PackageVersion Include="OsmSharp"                                                Version="7.0.0-pre027" />          <!-- OpenStreetMap data reading, writing, and filtering across PBF and XML -->
        <PackageVersion Include="OsmSharp.Geo"                                            Version="7.0.0-pre027" />          <!-- OpenStreetMap feature conversion into OGC geometries -->
        <PackageVersion Include="pocketken.H3"                                            Version="4.5.0.1" />               <!-- Hexagonal hierarchical geospatial indexing with polygon support -->
        <PackageVersion Include="ProjNET"                                                 Version="2.1.0" />                 <!-- Coordinate transformations between geodetic and projected reference systems -->
        <PackageVersion Include="quantized-mesh-tile"                                     Version="0.5.0" />                 <!-- Quantized-mesh terrain tile decoding and encoding -->
        <PackageVersion Include="SharpKml.Core"                                           Version="6.1.0" />                 <!-- KML and KMZ file reading and writing -->
        <PackageVersion Include="tilebelt"                                                Version="2.0.1" />                 <!-- Map tile utilities: bounding boxes, parents, children, quadkeys -->
    </ItemGroup>

    <ItemGroup Label="Digital Fabrication">
        <PackageVersion Include="DSTV.Net"                                                Version="1.3.0" />                 <!-- DSTV steel part file parsing with SVG visualization -->
        <PackageVersion Include="Motus.Core"                                              Version="0.13.2" />                <!-- Host-agnostic motion planning core: models, planners, retiming, and export -->
        <PackageVersion Include="Motus.Geometry"                                          Version="0.13.2" />                <!-- Serial-chain kinematics, sphere collision, and Cartesian motion planners -->
        <PackageVersion Include="Motus.Native"                                            Version="0.13.2" />                <!-- Native interop bindings for OMPL planning and FCL collision -->
        <PackageVersion Include="Motus.OMPL.Native"                                       Version="0.13.2" />                <!-- C ABI stub library for optional native sampling planners -->
        <PackageVersion Include="Motus.OMPL.NET"                                          Version="0.13.2" />                <!-- Sampling-based motion planner adapter with managed fallback -->
        <PackageVersion Include="Motus.Presets"                                           Version="0.13.2" />                <!-- JSON robot presets and URDF loading with bundled defaults -->
        <PackageVersion Include="MTConnect.NET-Common"                                    Version="7.0.0.2-prerelease" />    <!-- Core MTConnect machine tool protocol data models -->
        <PackageVersion Include="MTConnect.NET-DeviceFinder"                              Version="7.0.0.2-prerelease" />    <!-- Network discovery of MTConnect devices -->
        <PackageVersion Include="MTConnect.NET-HTTP"                                      Version="7.0.0.2-prerelease" />    <!-- HTTP protocol transport for MTConnect agents and clients -->
        <PackageVersion Include="MTConnect.NET-JSON"                                      Version="7.0.0.2-prerelease" />    <!-- JSON document format for MTConnect data -->
        <PackageVersion Include="MTConnect.NET-MQTT"                                      Version="7.0.0.2-prerelease" />    <!-- MQTT protocol transport for MTConnect agents and clients -->
        <PackageVersion Include="MTConnect.NET-SHDR"                                      Version="7.0.0.2-prerelease" />    <!-- SHDR adapter protocol implementation for MTConnect -->
        <PackageVersion Include="MTConnect.NET-XML"                                       Version="7.0.0.2-prerelease" />    <!-- XML document format for MTConnect data -->
        <PackageVersion Include="Robots"                                                  Version="2.3.0" />                 <!-- Robot program creation and simulation for ABB, KUKA, UR, and others -->
        <PackageVersion Include="UNesting"                                                Version="0.9.0" />                 <!-- 2D polygon nesting and 3D bin packing engine bindings -->
        <PackageVersion Include="UVtools.Core"                                            Version="6.2.0" />                 <!-- MSLA resin print file analysis, repair, and conversion -->
    </ItemGroup>

    <ItemGroup Label="Energy Simulation">
        <PackageVersion Include="DragonflySchema"                                         Version="2.202.0" />               <!-- Urban-scale building energy model schema objects -->
        <PackageVersion Include="HoneybeeSchema"                                          Version="2.102.0" />               <!-- Building energy model data schema objects -->
        <PackageVersion Include="LadybugDisplaySchema"                                    Version="0.708.3" />               <!-- Display and visualization schema objects for environmental design geometry -->
        <PackageVersion Include="NREL.OpenStudio.macOS-arm64"                             Version="3.11.0" />                <!-- OpenStudio energy simulation bindings with native Apple silicon runtime -->
        <PackageVersion Include="PollinationSDK"                                          Version="1.10.0" />                <!-- API client SDK for the Pollination simulation platform -->
    </ItemGroup>

    <ItemGroup Label="Structural Engineering">
        <PackageVersion Include="VividOrange.Cases"                                       Version="0.1.0" />                 <!-- Load cases and combinations for structural engineering -->
        <PackageVersion Include="VividOrange.Countries"                                   Version="0.1.0" />                 <!-- Definitions of country names worldwide -->
        <PackageVersion Include="VividOrange.ForceMomentInteraction"                      Version="0.2.1" />                 <!-- Axial force and biaxial moment capacity interaction handling -->
        <PackageVersion Include="VividOrange.Geometry"                                    Version="1.8.0" />                 <!-- Basic geometric operations for structural engineering -->
        <PackageVersion Include="VividOrange.ICartesianBase"                              Version="1.8.0" />                 <!-- Cartesian base interfaces for structural geometry types -->
        <PackageVersion Include="VividOrange.ICases"                                      Version="0.1.0" />                 <!-- Interfaces defining load cases and combinations -->
        <PackageVersion Include="VividOrange.IForceMomentInteraction"                     Version="0.2.1" />                 <!-- Interfaces for force-moment interaction diagrams -->
        <PackageVersion Include="VividOrange.IGeometry"                                   Version="1.8.0" />                 <!-- Interfaces for structural geometry operations -->
        <PackageVersion Include="VividOrange.ILoads"                                      Version="0.1.0" />                 <!-- Interfaces defining structural load types -->
        <PackageVersion Include="VividOrange.IMaterials"                                  Version="0.1.0" />                 <!-- Interfaces defining structural material properties -->
        <PackageVersion Include="VividOrange.InteractionDiagram"                          Version="0.2.1" />                 <!-- 3D diagram construction for force-moment capacity surfaces -->
        <PackageVersion Include="VividOrange.IProfiles"                                   Version="0.1.0" />                 <!-- Interfaces for cross-section profile definitions -->
        <PackageVersion Include="VividOrange.ISections"                                   Version="0.1.0" />                 <!-- Interfaces for material and profile cross-sections -->
        <PackageVersion Include="VividOrange.ISerialization"                              Version="0.1.0" />                 <!-- Serialization interfaces for structural taxonomy types -->
        <PackageVersion Include="VividOrange.IStages"                                     Version="0.1.0" />                 <!-- Interfaces for design stage definitions -->
        <PackageVersion Include="VividOrange.IStandards"                                  Version="0.1.0" />                 <!-- Interfaces for design codes and standards -->
        <PackageVersion Include="VividOrange.IUncertainties"                              Version="0.2.0" />                 <!-- Interfaces for numbers with uncertainty models -->
        <PackageVersion Include="VividOrange.Loads"                                       Version="0.1.0" />                 <!-- Load definitions for structural engineering analysis -->
        <PackageVersion Include="VividOrange.Materials"                                   Version="0.1.0" />                 <!-- Material definitions for structural design and analysis -->
        <PackageVersion Include="VividOrange.Profiles"                                    Version="0.1.0" />                 <!-- Cross-section profile shapes for structural design -->
        <PackageVersion Include="VividOrange.Profiles.Catalogue"                          Version="0.1.0" />                 <!-- Standard steel catalog profile definitions -->
        <PackageVersion Include="VividOrange.Profiles.Perimeter"                          Version="0.1.0" />                 <!-- Cross-section profiles defined geometrically by a perimeter -->
        <PackageVersion Include="VividOrange.Sections"                                    Version="0.1.0" />                 <!-- Cross-sections combining materials and profiles -->
        <PackageVersion Include="VividOrange.Sections.ISectionProperties"                 Version="0.1.0" />                 <!-- Interfaces for section property calculations -->
        <PackageVersion Include="VividOrange.Sections.SectionProperties"                  Version="0.1.0" />                 <!-- Section property calculations for structural analysis -->
        <PackageVersion Include="VividOrange.Serialization"                               Version="0.1.0" />                 <!-- Serialization for structural taxonomy types -->
        <PackageVersion Include="VividOrange.Stages"                                      Version="0.1.0" />                 <!-- Design stage definitions such as RIBA stages -->
        <PackageVersion Include="VividOrange.Standards"                                   Version="0.1.0" />                 <!-- Design codes and standards definitions such as Eurocodes -->
        <PackageVersion Include="VividOrange.Uncertainties"                               Version="0.2.0" />                 <!-- Arithmetic with uncertain numbers: absolute, relative, interval, distribution models -->
        <PackageVersion Include="VividOrange.Uncertainties.Quantities"                    Version="0.2.0" />                 <!-- Uncertainty arithmetic over physical quantities with units -->
    </ItemGroup>

    <ItemGroup Label="Machine Learning">
        <PackageVersion Include="libtorch-cpu"                                            Version="2.10.0" />                <!-- Native LibTorch CPU runtime binaries -->
        <PackageVersion Include="Microsoft.ML"                                            Version="5.0.0" />                 <!-- Machine learning framework with data pipelines, trainers, and inference -->
        <PackageVersion Include="Microsoft.ML.AutoML"                                     Version="0.23.0" />                <!-- Automated pipeline, model, and hyperparameter search -->
        <PackageVersion Include="Microsoft.ML.FastTree"                                   Version="5.0.0" />                 <!-- Gradient boosted decision tree trainers -->
        <PackageVersion Include="Microsoft.ML.OnnxRuntime"                                Version="1.29.0" />                <!-- ONNX model inference engine with hardware acceleration -->
        <PackageVersion Include="Microsoft.ML.OnnxRuntime.Extensions"                     Version="0.15.2-dev-20251214-1129-7387a4eb" /> <!-- Custom operators for ONNX model pre- and post-processing -->
        <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI"                           Version="0.15.2" />                <!-- Generative model inference loop with tokenization, sampling, and KV caching -->
        <PackageVersion Include="Microsoft.ML.Tokenizers"                                 Version="3.0.0-preview.26160.2" /> <!-- Text tokenizers including BPE, SentencePiece, and tiktoken -->
        <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase"                 Version="3.0.0-preview.26160.2" /> <!-- Tiktoken vocabulary data for cl100k_base models -->
        <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase"                  Version="3.0.0-preview.26160.2" /> <!-- Tiktoken vocabulary data for o200k_base models -->
        <PackageVersion Include="TorchAudio"                                              Version="0.107.0" />               <!-- Audio processing bindings over LibTorch -->
        <PackageVersion Include="TorchSharp"                                              Version="0.107.0" />               <!-- Tensor computation and deep learning bindings over LibTorch -->
        <PackageVersion Include="TorchVision"                                             Version="0.107.0" />               <!-- Vision transforms and model bindings over LibTorch -->
        <PackageVersion Include="Whisper.net"                                             Version="1.9.2-preview1" />        <!-- Cross-platform bindings for Whisper speech recognition models -->
        <PackageVersion Include="Whisper.net.Runtime"                                     Version="1.9.2-preview1" />        <!-- Whisper.cpp native runtime binaries with Metal acceleration -->
    </ItemGroup>

    <ItemGroup Label="AI">
        <PackageVersion Include="Anthropic"                                               Version="12.45.0" />               <!-- Client library for the Anthropic API -->
        <PackageVersion Include="Microsoft.Extensions.AI"                                 Version="10.9.0" />                <!-- Telemetry, caching, and tool-invocation middleware for AI chat clients -->
