{
    "$schema": "../node_modules/knip/schema.json",
    "exclude": ["catalog"],
    "treatConfigHintsAsErrors": true,
    "ignoreDependencies": ["@effect/language-service", "@rasm/process", "adobe", "claude-code", "indesign-uxp-types"],
    "ignoreExportsUsedInFile": true,
    "ignoreIssues": {
        "package.json": ["dependencies", "devDependencies", "optionalPeerDependencies"],
        "products/developer/nx/apple/targets.ts": ["unresolved"]
    },
    "wrangler": {
        "entry": ["cloudflare.config.ts"]
    },
    "workspaces": {
        ".": {
            "entry": [],
            "project": []
        },
        "infra": {
            "project": ["**/*.ts", "!sdks/**"]
        },
        "products/apps/creative-cloud/*/atelier": {
            "entry": ["main.ts"]
        },
        "products/developer/nx/*": {
            "entry": ["executors/*/executor.ts"]
        },
        "products/web/*": {
            "entry": ["server/main.ts"]
        }
    }
}
