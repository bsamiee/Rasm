root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# BuildCheck (`dotnet build -check`): these properties allow condition reads shared by .props and .targets files. Both values must match or MSBuild rejects the project.
[*.csproj]
build_check.BC0201.AllowUninitializedPropertiesInConditions = true
build_check.BC0202.AllowUninitializedPropertiesInConditions = true

[*.cs]
# --- [NAMESPACE_AND_IMPORTS] -----------------------------------------------
csharp_style_namespace_declarations = file_scoped:error                       # Keep namespace declarations concise and modern.
dotnet_style_namespace_match_folder = true:error                              # Enforce namespace-path alignment.
dotnet_style_require_accessibility_modifiers = always:error                   # Require explicit member accessibility.
csharp_using_directive_placement = outside_namespace:error                    # Keep using directives outside namespace blocks.
dotnet_sort_system_directives_first = true                                    # Keep System usings ordered first.
dotnet_separate_import_directive_groups = false                               # Avoid blank-line grouping in imports.

# --- [TYPE_EXPLICITNESS] ----------------------------------------------------
csharp_style_var_for_built_in_types = false:error                             # Use explicit built-in types instead of var.
csharp_style_var_when_type_is_apparent = false:error                          # Keep explicit types even when obvious.
csharp_style_var_elsewhere = false:error                                      # Disallow var in all remaining contexts.
dotnet_style_predefined_type_for_locals_parameters_members = true:error       # Prefer C# aliases (int/string) in declarations.
dotnet_style_predefined_type_for_member_access = true:error                   # Prefer C# aliases in member access expressions.
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:error # Keep modifier ordering deterministic.
dotnet_style_qualification_for_field = false:error                            # Avoid unnecessary this./Me. qualification on fields.
dotnet_style_qualification_for_property = false:error                         # Avoid unnecessary this./Me. qualification on properties.
dotnet_style_qualification_for_method = false:error                           # Avoid unnecessary this./Me. qualification on methods.
dotnet_style_qualification_for_event = false:error                            # Avoid unnecessary this./Me. qualification on events.
dotnet_style_readonly_field = true:error                                      # Prefer readonly fields for immutability.
csharp_style_prefer_readonly_struct = true:error                              # Prefer readonly structs to avoid defensive copies.
csharp_style_prefer_readonly_struct_member = true:error                       # Prefer readonly struct members where possible.

# --- [CONTROL_FLOW_AND_PATTERNS] --------------------------------------------
csharp_style_pattern_matching_over_is_with_cast_check = true:error            # Prefer pattern matching over is+cast sequences.
csharp_style_pattern_matching_over_as_with_null_check = true:error            # Prefer pattern matching over as+null checks.
csharp_style_prefer_pattern_matching = true:error                             # Use pattern syntax in place of older idioms.
csharp_style_prefer_not_pattern = true:error                                  # Prefer is not pattern syntax.
csharp_style_prefer_extended_property_pattern = true:error                    # Prefer extended property patterns for nested checks.
csharp_style_prefer_switch_expression = true:error                            # Prefer switch expressions over switch statements.
csharp_style_prefer_null_check_over_type_check = true:error                   # Prefer direct null checks over type checks.
dotnet_style_prefer_conditional_expression_over_return = true:error           # Prefer conditional expressions over branching returns.
dotnet_style_prefer_conditional_expression_over_assignment = true:error       # Prefer conditional expressions over branching assignments.
dotnet_style_prefer_compound_assignment = true:error                          # Prefer compound assignments where equivalent.
dotnet_style_prefer_simplified_boolean_expressions = true:error               # Simplify boolean expressions to minimal form.
dotnet_style_prefer_simplified_interpolation = true:error                     # Simplify interpolation when format is unnecessary.
csharp_style_inlined_variable_declaration = true:error                        # Inline out variable declarations when possible.

# --- [MODERN_SYNTAX_AND_CONCISION] ------------------------------------------
csharp_style_prefer_primary_constructors = true:error                         # Prefer primary constructors when applicable.
dotnet_style_prefer_collection_expression = when_types_exactly_match:error    # Prefer collection expressions with type-safe matches.
csharp_style_implicit_object_creation_when_type_is_apparent = true:error      # Prefer target-typed new for concise object creation.
dotnet_style_object_initializer = true:error                                  # Prefer object initializers over post-construction assignments.
dotnet_style_collection_initializer = true:error                              # Prefer collection initializers over repeated Add calls.
dotnet_style_prefer_inferred_tuple_names = true:error                         # Infer tuple names to reduce duplication.
dotnet_style_explicit_tuple_names = true:error                                # Use declared tuple element names instead of ItemN access.
dotnet_style_prefer_inferred_anonymous_type_member_names = true:error         # Infer anonymous member names from locals.
csharp_style_deconstructed_variable_declaration = true:error                  # Prefer deconstruction for tuple assignment.
csharp_style_prefer_tuple_swap = true:error                                   # Prefer tuple swap idiom for value swapping.
csharp_style_prefer_index_operator = true:error                               # Prefer index operator (^) over manual offsets.
csharp_style_prefer_range_operator = true:error                               # Prefer range operator (..) over slicing boilerplate.
csharp_prefer_simple_using_statement = true:error                             # Prefer using declarations for tighter scope control.
csharp_prefer_static_local_function = true:error                              # Prefer static local functions to avoid captures.
csharp_prefer_static_anonymous_function = true:error                          # Prefer static lambdas when captures are unnecessary.
csharp_style_prefer_method_group_conversion = true:error                      # Prefer method groups over equivalent lambdas.
csharp_style_prefer_local_over_anonymous_function = false:error               # Lambdas stay first-class values; local functions are not forced.
csharp_style_prefer_top_level_statements = false:error                        # Keep explicit program entry points.
csharp_style_prefer_utf8_string_literals = true:error                         # Prefer UTF-8 literals for efficient encoding.
csharp_prefer_simple_default_expression = true:error                          # Prefer default literal form over explicit type.
dotnet_style_operator_placement_when_wrapping = beginning_of_line             # Keep wrapped operators consistently at line start.
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:error # Require clarity parentheses in arithmetic expressions.
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:error # Require clarity parentheses in relational expressions.
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:error # Require clarity parentheses in other binary expressions.
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:error      # Avoid unnecessary parentheses for non-binary operators.

# --- [NULL_AND_EXPRESSION_SAFETY] -------------------------------------------
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error # Prefer is null over ReferenceEquals null checks.
dotnet_style_null_propagation = true:error                                    # Prefer null-propagation for concise null safety.
dotnet_style_coalesce_expression = true:error                                 # Prefer null-coalescing expression patterns.
csharp_style_conditional_delegate_call = true:error                           # Prefer conditional delegate invocation.
csharp_style_throw_expression = true:error                                    # Prefer throw expressions in expression contexts.
csharp_style_unused_value_assignment_preference = discard_variable:error      # Force discard for intentionally unused assignments.
csharp_style_unused_value_expression_statement_preference = discard_variable:error # Force discard for unused expression values.

# --- [MEMBER_BODY_STYLE] ----------------------------------------------------
csharp_style_expression_bodied_methods = true:error                           # Expression-bodied methods, single or multi-line.
csharp_style_expression_bodied_constructors = true:error                      # Expression-bodied constructors.
csharp_style_expression_bodied_operators = true:error                         # Expression-bodied operators.
csharp_style_expression_bodied_properties = true:error                        # Expression-bodied properties.
csharp_style_expression_bodied_indexers = true:error                          # Expression-bodied indexers.
csharp_style_expression_bodied_accessors = true:error                         # Expression-bodied accessors.
csharp_style_expression_bodied_lambdas = true:error                           # Expression-bodied lambdas.
csharp_style_expression_bodied_local_functions = true:error                   # Expression-bodied local functions.
dotnet_style_prefer_auto_properties = true:error                              # Prefer auto-properties over trivial backing fields.

# --- [FORMATTING_KR] --------------------------------------------------------
csharp_prefer_braces = false:error                                            # Prefer unbraced control-flow blocks when unavoidable.
csharp_new_line_before_open_brace = none                                      # Enforce K&R brace placement.
csharp_new_line_before_else = false                                           # Keep else on the same line as closing brace.
csharp_new_line_before_catch = false                                          # Keep catch on the same line as closing brace.
csharp_new_line_before_finally = false                                        # Keep finally on the same line as closing brace.
csharp_new_line_before_members_in_object_initializers = false                 # Keep object initializers compact unless wrapped by length.
csharp_new_line_before_members_in_anonymous_types = false                     # Keep anonymous type initializers compact.
csharp_new_line_between_query_expression_clauses = false                      # Keep query clauses compact unless forced to wrap.
dotnet_style_allow_multiple_blank_lines_experimental = false                  # Disallow consecutive blank lines for denser deterministic files.
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false            # Disallow blank lines between adjacent brace blocks.
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false # Disallow blank lines after constructor initializer colon.
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = true  # Allow wrapping arrow expression body to next line for long pipelines.
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false  # Disallow blank lines after conditional-expression tokens.
csharp_preserve_single_line_statements = true                                 # Preserve compact single-line statements.
csharp_preserve_single_line_blocks = true                                     # Preserve compact single-line block bodies.
csharp_indent_block_contents = true                                           # Indent block contents consistently.
csharp_indent_case_contents = true                                            # Indent switch case contents consistently.
csharp_indent_case_contents_when_block = true                                 # Indent case block contents consistently.
csharp_indent_switch_labels = true                                            # Indent switch labels under switch blocks.
csharp_indent_labels = one_less_than_current                                  # Keep labels aligned deterministically relative to surrounding scope.
csharp_indent_braces = false                                                  # Keep braces aligned to K&R-aligned block indentation.
csharp_space_after_keywords_in_control_flow_statements = true                 # Require space after control-flow keywords.
csharp_space_after_cast = false                                               # Avoid trailing space after cast parentheses.
csharp_space_after_comma = true                                               # Require a space after commas.
csharp_space_before_comma = false                                             # Disallow a space before commas.
csharp_space_before_colon_in_inheritance_clause = true                        # Require spacing before inheritance colons.
csharp_space_after_colon_in_inheritance_clause = true                         # Require spacing after inheritance colons.
csharp_space_around_binary_operators = before_and_after                       # Require spaces around binary operators.
csharp_space_between_method_declaration_parameter_list_parentheses = false    # Disallow inner spaces in method declaration parentheses.
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false # Disallow inner spaces in empty method declaration parentheses.
csharp_space_between_method_call_parameter_list_parentheses = false           # Disallow inner spaces in method call parentheses.
csharp_space_between_method_call_empty_parameter_list_parentheses = false     # Disallow inner spaces in empty method call parentheses.
csharp_space_between_method_declaration_name_and_open_parenthesis = false     # Disallow spaces between method names and opening parentheses.
csharp_space_between_method_call_name_and_opening_parenthesis = false         # Disallow spaces between invocation name and opening parentheses.
csharp_space_after_dot = false                                                # Disallow spaces after member-access dots.
csharp_space_before_dot = false                                               # Disallow spaces before member-access dots.
csharp_space_after_semicolon_in_for_statement = true                          # Require spacing after semicolons in for statements.
csharp_space_before_semicolon_in_for_statement = false                        # Disallow spacing before semicolons in for statements.
csharp_space_before_open_square_brackets = false                              # Disallow spaces before opening indexer brackets.
csharp_space_between_empty_square_brackets = false                            # Disallow spaces inside empty square brackets.
csharp_space_between_square_brackets = false                                  # Disallow spaces inside square brackets.
dotnet_diagnostic.IDE0055.severity = error                                    # Enforce formatter compliance in CI/build.

# --- [QUALITY_ANALYZERS] -----------------------------------------------------
# AnalysisLevel latest-all enables every CA rule as a warning and TreatWarningsAsErrors promotes it; only explicit exemptions and rules omitted by latest-all belong here.
dotnet_diagnostic.CA1034.severity = none                                      # Nested types are intentional for Thinktecture regular unions.
dotnet_diagnostic.CA1720.severity = none                                      # Grasshopper parameter SmartEnum items are named after the CLR type they adapt (Integer, Boolean); the name is the mapping.
dotnet_diagnostic.MA0008.severity = none                                      # Roslyn already emits Sequential for structs, and host interop needs Sequential; restating the layout per type is noise.
dotnet_diagnostic.MA0048.severity = none                                      # Allow intentionally consolidated domain/type modules.
dotnet_diagnostic.MA0051.severity = none                                      # Allow dense expression-based dispatch; repository standards govern method complexity.
dotnet_diagnostic.CS0169.severity = error                                     # Remove private fields that are never used.
dotnet_diagnostic.CA1021.severity = error                                     # Left off by latest-all: return results instead of using out parameters.
dotnet_diagnostic.CA1045.severity = error                                     # Left off by latest-all: ref parameters; changing context returns as a value.
dotnet_diagnostic.CS0649.severity = error                                     # Assign every field through validated construction.
dotnet_diagnostic.CA1307.severity = none                                      # MA0001/MA0074 own StringComparison and exempt expression trees.
dotnet_diagnostic.CA1310.severity = none                                      # MA0074 owns culture-sensitive string comparison.

# --- [THREADING_ANALYZERS] ---------------------------------------------------
dotnet_diagnostic.VSTHRD003.severity = none                                   # No host exposes JoinableTaskFactory, so its prescribed replacement is unavailable for externally supplied tasks.
dotnet_diagnostic.VSTHRD103.severity = none                                   # Covered by CA1849 and MA0042 to avoid duplicate async-flow diagnostics.
dotnet_diagnostic.VSTHRD102.severity = error                                  # Info default: a private synchronous body under an async public member breaks the async chain.
dotnet_diagnostic.VSTHRD111.severity = error                                  # Hidden default: require explicit ConfigureAwait intent on awaits.

# --- [MEZIANTOU_ANALYZERS] ---------------------------------------------------
dotnet_diagnostic.MA0003.severity = error                                     # Require parameter names to clarify arguments.
dotnet_diagnostic.MA0004.severity = none                                      # CA2007 and VSTHRD111 already enforce ConfigureAwait usage.
dotnet_diagnostic.MA0007.severity = error                                     # Require a trailing comma after the last value in multi-line initializers.
dotnet_diagnostic.MA0020.severity = error                                     # Prefer direct collection APIs over equivalent LINQ.
dotnet_diagnostic.MA0028.severity = error                                     # Optimize StringBuilder append patterns.
dotnet_diagnostic.MA0029.severity = error                                     # Combine adjacent LINQ operations.
dotnet_diagnostic.MA0032.severity = error                                     # Require using overloads with CancellationToken when available.
dotnet_diagnostic.MA0042.severity = error                                     # Ban blocking calls in async-capable methods.
dotnet_diagnostic.MA0001.severity = error                                     # Info default: MA0001/MA0074 own StringComparison; they skip EF Core expression trees.
dotnet_diagnostic.MA0043.severity = none                                      # RCS1015 owns nameof over name literals.
dotnet_diagnostic.MA0075.severity = error                                     # Info default: implicit culture-sensitive ToString.
dotnet_diagnostic.MA0121.severity = error                                     # Shipped disabled: a parameter is never reassigned; changing context is a returned value.
dotnet_diagnostic.MA0141.severity = error                                     # Shipped disabled: absence is matched with `is null`.
dotnet_diagnostic.MA0142.severity = error                                     # Shipped disabled: presence is matched with `is not null`.
dotnet_diagnostic.MA0170.severity = error                                     # Shipped disabled: a type comparison against a type it can never be.
dotnet_diagnostic.MA0171.severity = error                                     # Shipped disabled: `is null` over Nullable<T>.HasValue.
dotnet_diagnostic.MA0172.severity = error                                     # Shipped disabled: identical operands on both sides of a binary operator.
dotnet_diagnostic.MA0186.severity = error                                     # Shipped disabled: [NotNullWhen(true)] on the Equals parameter.
dotnet_diagnostic.MA0217.severity = error                                     # Shipped disabled: require static lambdas when nothing is captured; overlaps TTRESG1001 on non-capturing Thinktecture arms, and both name the same fix.
dotnet_diagnostic.MA0031.severity = error                                     # Info default: Enumerable.Count() where Any() or Length answers.
dotnet_diagnostic.MA0036.severity = error                                     # Info default: a class with only static members is static.
dotnet_diagnostic.MA0057.severity = error                                     # Info default: attribute class names end with Attribute.
dotnet_diagnostic.MA0058.severity = error                                     # Info default: exception class names end with Exception.
dotnet_diagnostic.MA0059.severity = error                                     # Info default: event-args class names end with EventArgs.
dotnet_diagnostic.MA0067.severity = error                                     # Info default: Guid.Empty over new Guid().
dotnet_diagnostic.MA0073.severity = error                                     # Info default: no comparison against a bool constant.
dotnet_diagnostic.MA0101.severity = error                                     # Info default: a string literal carrying an implicit end of line.
dotnet_diagnostic.MA0107.severity = error                                     # Shipped disabled: object.ToString rendering; the boundary renders, the interior does not.
dotnet_diagnostic.MA0113.severity = error                                     # Info default: DateTime.UnixEpoch over the 1970 literal.
dotnet_diagnostic.MA0114.severity = error                                     # Info default: DateTimeOffset.UnixEpoch over the 1970 literal.
dotnet_diagnostic.MA0127.severity = error                                     # Info default: String.Equals over an `is` pattern on strings.
dotnet_diagnostic.MA0128.severity = error                                     # Info default: `is` over SequenceEqual on spans of literals.
dotnet_diagnostic.MA0133.severity = error                                     # Info default: DateTimeOffset spelled, never the implicit DateTime conversion.
dotnet_diagnostic.MA0136.severity = error                                     # Info default: a raw string literal carrying an implicit end of line.
dotnet_diagnostic.MA0152.severity = error                                     # Info default: Unwrap over a double await.
dotnet_diagnostic.MA0154.severity = error                                     # Info default: langword in XML comments.
dotnet_diagnostic.MA0173.severity = error                                     # Info default: LazyInitializer.EnsureInitialized over a hand-rolled check.
dotnet_diagnostic.MA0180.severity = error                                     # Shipped disabled: ILogger<T> type parameter matches the containing type.
dotnet_diagnostic.MA0184.severity = error                                     # Info default: an interpolated string without holes.
dotnet_diagnostic.MA0188.severity = error                                     # Info default: System.TimeProvider over a custom clock abstraction.
dotnet_diagnostic.MA0189.severity = error                                     # Info default: InlineArray over fixed-size buffers.
dotnet_diagnostic.MA0204.severity = error                                     # Info default: an unnecessary partial modifier.
dotnet_diagnostic.MA0205.severity = error                                     # Info default: exclusive-or over the expanded boolean form.
dotnet_diagnostic.MA0206.severity = error                                     # Info default: unnecessary braces on a type declaration.
dotnet_diagnostic.MA0212.severity = error                                     # Shipped disabled: MemoryMarshal.GetReference over indexing at zero.
dotnet_diagnostic.MA0216.severity = error                                     # Info default: an unnecessary closed modifier.
dotnet_diagnostic.MA0218.severity = error                                     # Info default: an empty language attribute in XML comments.
dotnet_diagnostic.MA0219.severity = error                                     # Info default: the language attribute set in XML comments.
dotnet_diagnostic.MA0044.severity = error                                     # Remove redundant ToString calls.
dotnet_diagnostic.MA0050.severity = error                                     # Validate iterator arguments before enumeration.
dotnet_diagnostic.MA0052.severity = error                                     # Prefer nameof over constant enum ToString.
dotnet_diagnostic.MA0053.severity = error                                     # Seal classes and records not designed for inheritance.
dotnet_diagnostic.MA0063.severity = error                                     # Filter sequences before ordering.
dotnet_diagnostic.MA0071.severity = error                                     # Remove redundant else branches.
dotnet_diagnostic.MA0076.severity = error                                     # Thread CultureInfo.InvariantCulture through interpolation; ban implicit culture-sensitive ToString.
dotnet_diagnostic.MA0078.severity = error                                     # Prefer Cast over Select casts.
dotnet_diagnostic.MA0079.severity = error                                     # Forward cancellation through WithCancellation.
dotnet_diagnostic.MA0080.severity = error                                     # Require WithCancellation in async enumeration flows.
dotnet_diagnostic.MA0089.severity = error                                     # Prefer char overloads for single-character string operations.
dotnet_diagnostic.MA0090.severity = none                                      # RCS1259 owns empty syntax.
dotnet_diagnostic.MA0098.severity = error                                     # Prefer indexers over equivalent LINQ access.
dotnet_diagnostic.MA0102.severity = error                                     # Prefer readonly members where possible.
dotnet_diagnostic.MA0105.severity = error                                     # Avoid closure captures by using lambda parameters.
dotnet_diagnostic.MA0106.severity = error                                     # Prefer factory-argument overloads to avoid captures.
dotnet_diagnostic.MA0108.severity = error                                     # Remove redundant explicit argument values.
dotnet_diagnostic.MA0110.severity = error                                     # Prefer Regex source generator for constant patterns.
dotnet_diagnostic.MA0111.severity = error                                     # Prefer string.Create over FormattableString.
dotnet_diagnostic.MA0134.severity = none                                      # Covered by VSTHRD110 to avoid duplicate async-observation diagnostics.
dotnet_diagnostic.MA0158.severity = none                                      # Covered by IDE0330 to avoid duplicate System.Threading.Lock diagnostics.
dotnet_diagnostic.MA0159.severity = error                                     # Prefer Order over identity OrderBy.
dotnet_diagnostic.MA0160.severity = error                                     # Prefer ContainsKey when TryGetValue output is unused.
dotnet_diagnostic.MA0166.severity = error                                     # Forward TimeProvider when overloads support it.
dotnet_diagnostic.MA0167.severity = error                                     # Use TimeProvider overloads when available.
dotnet_diagnostic.MA0168.severity = error                                     # Prefer readonly structs for by-ref read-only parameters.
dotnet_diagnostic.MA0178.severity = error                                     # Prefer TimeSpan.Zero for zero durations.
dotnet_diagnostic.MA0179.severity = error                                     # Prefer Attribute.IsDefined for presence checks.
dotnet_diagnostic.MA0185.severity = error                                     # Simplify string.Create when inputs are culture invariant.
dotnet_diagnostic.MA0190.severity = error                                     # Prefer partial properties for source-generated Regex accessors.
dotnet_diagnostic.MA0191.severity = error                                     # Ban null-forgiving operators.
dotnet_diagnostic.MA0192.severity = error                                     # Prefer HasFlag over (value & flag) == flag bitwise enum checks.
dotnet_diagnostic.MA0193.severity = error                                     # Require explicit midpoint rounding semantics.
dotnet_diagnostic.MA0194.severity = error                                     # Merge is expressions over the same value.
dotnet_diagnostic.MA0200.severity = error                                     # Avoid empty property patterns on non-nullable value types.
MA0032.allowOverloadsWithOptionalParameters = false                           # Require token-aware overload usage even when optional params exist.
dotnet_code_quality_unused_parameters = all                                   # Enforce unused-parameter analysis for all member visibilities.

# --- [ROSLYNATOR_ANALYZERS] --------------------------------------------------
# Warning defaults already error; rows promote Info/Hidden rules, enable shipped-off rules, and name one owner per overlap.
dotnet_diagnostic.RCS1002.severity = error                                    # Shipped disabled: remove braces from a single-statement block.
dotnet_diagnostic.RCS1004.severity = error                                    # Shipped disabled: remove braces from a single-statement if-else.
dotnet_diagnostic.RCS1006.severity = error                                    # Hidden default: merge else with a nested if.
dotnet_diagnostic.RCS1014.severity = error                                    # Shipped disabled: explicitly typed array creation.
dotnet_diagnostic.RCS1015.severity = error                                    # nameof over a literal that spells a symbol name.
dotnet_diagnostic.RCS1020.severity = error                                    # Nullable<T> spelled T?.
dotnet_diagnostic.RCS1031.severity = error                                    # Hidden default: braces on a switch section.
dotnet_diagnostic.RCS1034.severity = error                                    # Hidden default: sealed on a member of a sealed type.
dotnet_diagnostic.RCS1039.severity = error                                    # Hidden default: empty attribute argument list.
dotnet_diagnostic.RCS1042.severity = error                                    # Hidden default: enum : int.
dotnet_diagnostic.RCS1048.severity = error                                    # Lambda over anonymous method.
dotnet_diagnostic.RCS1050.severity = error                                    # Shipped disabled: object-creation parentheses before an initializer.
dotnet_diagnostic.RCS1052.severity = error                                    # Shipped disabled: one attribute per bracket pair.
dotnet_diagnostic.RCS1055.severity = error                                    # Hidden default: semicolon after a type declaration.
dotnet_diagnostic.RCS1056.severity = error                                    # Shipped disabled: using alias directives; one-hop resolution.
dotnet_diagnostic.RCS1061.severity = error                                    # Hidden default: merge if with a nested if.
dotnet_diagnostic.RCS1068.severity = error                                    # Simplify logical negation; !Any(!p) reads All(p).
dotnet_diagnostic.RCS1069.severity = error                                    # Hidden default: case label beside default.
dotnet_diagnostic.RCS1070.severity = error                                    # Hidden default: default section with only break.
dotnet_diagnostic.RCS1071.severity = error                                    # Hidden default: explicit : base().
dotnet_diagnostic.RCS1073.severity = error                                    # if/else returning constants reads as one return.
dotnet_diagnostic.RCS1074.severity = error                                    # Hidden default: empty parameterless constructor.
dotnet_diagnostic.RCS1077.severity = error                                    # LINQ chains fold to one operator.
dotnet_diagnostic.RCS1078.severity = error                                    # Shipped disabled: "" over string.Empty.
dotnet_diagnostic.RCS1079.severity = error                                    # Shipped disabled: NotImplementedException left in code.
dotnet_diagnostic.RCS1081.severity = error                                    # Shipped disabled: one declarator per field or local.
dotnet_diagnostic.RCS1089.severity = error                                    # ++/-- over x = x + 1.
dotnet_diagnostic.RCS1093.severity = error                                    # File without code.
dotnet_diagnostic.RCS1098.severity = error                                    # Constant on the right of a comparison.
dotnet_diagnostic.RCS1099.severity = error                                    # default label last in its section.
dotnet_diagnostic.RCS1103.severity = error                                    # if/else assigning a condition reads as one assignment.
dotnet_diagnostic.RCS1105.severity = error                                    # Literal inside an interpolation hole.
dotnet_diagnostic.RCS1107.severity = error                                    # ToCharArray before foreach.
dotnet_diagnostic.RCS1108.severity = error                                    # static on every partial declaration.
dotnet_diagnostic.RCS1112.severity = error                                    # Adjacent Where calls merge.
dotnet_diagnostic.RCS1113.severity = error                                    # string.IsNullOrEmpty over the expanded check.
dotnet_diagnostic.RCS1114.severity = error                                    # new EventHandler(M) reads M.
dotnet_diagnostic.RCS1118.severity = error                                    # Local assigned a constant is const.
dotnet_diagnostic.RCS1124.severity = error                                    # Hidden default: local used once inlines.
dotnet_diagnostic.RCS1128.severity = error                                    # if (x == null) x = y reads x ??= y.
