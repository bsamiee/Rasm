{
    "name": "@rasm/nx-uv",
    "version": "0.1.0",
    "description": "Nx plugin inferring uv workspace members, their checkers, tests, builds, and releases from uv's own workspace metadata",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/uv"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#package": "./package.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#package": "./package.json"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@decimalturn/toml-patch": "catalog:",
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "@renovatebot/pep440": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    }
}
