<Project>
    <PropertyGroup Label="Workspace">
        <RasmRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</RasmRepoRoot>
        <ArtifactsPath>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', '.artifacts', 'dotnet'))</ArtifactsPath>
        <RasmLibsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'libs'))</RasmLibsRoot>
        <RasmToolsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'tools'))</RasmToolsRoot>
        <RasmTestsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'tests'))</RasmTestsRoot>
        <RasmAppsRoot>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', 'apps'))</RasmAppsRoot>
    </PropertyGroup>

    <PropertyGroup Label="Package Metadata">
        <Authors>bsamiee</Authors>
        <Company>bsamiee</Company>
        <Copyright>Copyright © 2025 bsamiee</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Label="SDK Defaults">
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Label="Restore">
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <PropertyGroup Label="Analysis">
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Template for an IKVM consumer: the condition names the project, project-body opt-in properties are invisible at .props evaluation time
    <PropertyGroup Label="IKVM Build" Condition="'$(MSBuildProjectName)' == '{IkvmConsumerProject}'">
        <IkvmCacheDir>$([MSBuild]::NormalizeDirectory('$(RasmRepoRoot)', '.cache', 'ikvm'))</IkvmCacheDir>
        <IkvmExportCacheDir>$([MSBuild]::NormalizeDirectory('$(IkvmCacheDir)', 'expcache'))</IkvmExportCacheDir>
        <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);IKVM0100;IKVM0101;IKVM0109</MSBuildWarningsNotAsErrors>
    </PropertyGroup>
    -->

    <!-- Routes IKVM image files through @(None): buildTransitive imports IKVM.Image.targets into every consumer, the SDK drops transitive copies by TargetPath -->
    <PropertyGroup Label="IKVM Image">
        <IkvmImageItemToNone>true</IkvmImageItemToNone>
    </PropertyGroup>

    <ItemGroup Label="Workspace Analyzers">
        <PackageReference Include="ErrorProne.NET.CoreAnalyzers"               PrivateAssets="all" />
        <PackageReference Include="Meziantou.Analyzer"                         PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Roslynator.Analyzers"                       PrivateAssets="all" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Analyzers"  PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup Label="Rhino Host Bundle">
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and '$(RHINO_APP_PATH)' != ''">$(RHINO_APP_PATH)</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and Exists('/Applications/Rhino 9.app')">/Applications/Rhino 9.app</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == '' and Exists('/Applications/RhinoBETA.app')">/Applications/RhinoBETA.app</RhinoAppPath>
        <RhinoAppPath Condition="'$(RhinoAppPath)' == ''">/Applications/RhinoWIP.app</RhinoAppPath>
        <!-- Derived, never assigned back: project XML cannot rewrite a -p:RhinoAppPath global property, the trailing slash needs a separate name -->
        <_RhinoAppDir>$([MSBuild]::NormalizeDirectory('$(RhinoAppPath)'))</_RhinoAppDir>
        <RhinoResourcesPath>$(_RhinoAppDir)Contents/Frameworks/RhCore.framework/Versions/Current/Resources/</RhinoResourcesPath>
        <Grasshopper2PluginPath>$(RhinoResourcesPath)ManagedPlugIns/Grasshopper2Plugin.rhp/</Grasshopper2PluginPath>
    </PropertyGroup>
</Project>
