        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vite-pwa/assets-generator": "catalog:",
        "cf": "catalog:",
        "cheerio": "catalog:",
        "culori": "catalog:",
        "effect": "catalog:",
        "postcss": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "@effect/platform-node": "catalog:peers",
        "@pulumi/cloudflare": "catalog:peers",
        "@pulumi/command": "catalog:peers",
        "@pulumi/pulumi": "catalog:peers",
        "@rasm/mark": "workspace:*",
        "@rasm/workers": "workspace:*",
        "@vite-pwa/assets-generator": "catalog:peers",
        "cf": "catalog:peers",
        "cheerio": "catalog:peers",
        "culori": "catalog:peers",
        "effect": "catalog:peers",
        "postcss": "catalog:peers",
        "react": "catalog:peers",
        "react-dom": "catalog:peers",
        "vite": "catalog:peers"
