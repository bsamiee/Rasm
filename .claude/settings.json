{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "40000",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "NO_COLOR": "1",
    "FORCE_COLOR": "0",
    "SHELL": "bash"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git push *)",
      "Bash(git worktree *)",
      "Bash(git lfs *)",
      "Bash(git ls-remote *)",
      "Bash(git clone *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checkout *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh secret list *)",
      "Bash(gh api *)",
      "Bash(mise ls *)",
      "Bash(mise which *)",
      "Bash(mise env *)",
      "Bash(mise install *)",
      "Bash(mise upgrade *)",
      "Bash(pnpm install *)",
      "Bash(pnpm why *)",
      "Bash(pnpm list *)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm view *)",
      "Bash(pnpm exec nx *)",
      "Bash(nx *)",
      "Bash(pnpm exec biome *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec stryker *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(uv python *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run ty *)",
      "Bash(uv run mypy *)",
      "Bash(uv run --only-group eng *)",
      "Bash(uv run --frozen *)",
      "Bash(uv pip install --dry-run *)",
      "Bash(dotnet --version)",
      "Bash(dotnet --info)",
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet clean *)",
      "Bash(dotnet test *)",
      "Bash(dotnet run *)",
      "Bash(dotnet format *)",
      "Bash(dotnet msbuild *)",
      "Bash(dotnet pack *)",
      "Bash(dotnet publish *)",
      "Bash(dotnet list *)",
      "Bash(dotnet sln *)",
      "Bash(dotnet new *)",
      "Bash(dotnet dnx dotnet-outdated-tool *)",
      "Bash(dotnet dnx ilspycmd *)",
      "Bash(ast-grep *)",
      "Bash(tree-sitter *)",
      "Bash(buf *)",
      "Bash(tree *)",
      "Bash(loc *)",
      "Bash(fd *)",
      "Bash(rg *)",
      "Bash(sd *)",
      "Bash(difft *)",
      "Bash(hyperfine *)",
      "Bash(duckdb *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(typos *)",
      "Bash(yamllint *)",
      "Bash(yamlfmt *)",
      "Bash(sqlfluff *)",
      "Bash(pg-formatter *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(act *)",
      "Bash(actionlint *)",
      "Bash(zizmor *)",
      "Bash(doppler configure *)",
      "Bash(doppler secrets *)",
      "Bash(pulumi preview *)",
      "Bash(pulumi stack *)",
      "Bash(claude plugin *)",
      "Bash(tvly *)",
      "Bash(curl *)",
      "Bash(tar *)",
      "mcp__roslyn-codelens__*",
      "mcp__binlog__*",
      "mcp__ast-grep__*",
      "mcp__context7__*",
      "mcp__deepwiki__*",
      "mcp__exa__*",
      "mcp__github__*",
      "mcp__greptile__*",
      "mcp__hostinger__*",
      "mcp__nuget__*",
      "mcp__openaiDeveloperDocs__*",
      "mcp__claudeCodeDocs__*",
      "mcp__playwright__*",
      "mcp__rhino-mcp-platform__*",
      "mcp__computer-use__*"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "enableAllProjectMcpServers": true,
  "disabledMcpjsonServers": ["greptile", "hostinger"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise env -s bash > \"$CLAUDE_ENV_FILE\"",
            "timeout": 30,
            "statusMessage": "mise-env"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise env -s bash > \"$CLAUDE_ENV_FILE\"",
            "timeout": 30,
            "statusMessage": "mise-env"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "function-hooks@rasm": true
  },
  "extraKnownMarketplaces": {
    "rasm": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/.cache/**/CLAUDE.md",
    "**/node_modules/**/CLAUDE.md",
    "**/bin/**/CLAUDE.md",
    "**/obj/**/CLAUDE.md",
    "**/.artifacts/**/CLAUDE.md"
  ]
}
