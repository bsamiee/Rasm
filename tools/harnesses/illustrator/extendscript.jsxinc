        return fake;
    }
    function refusing(session, name) {
        return function () {
            var parts = [name];
            for (var i = 0; i < arguments.length; i++) { parts.push(String(arguments[i])); }
            session.record.activations.push(parts.join(" "));
        };
    }
    function windows(session) {
