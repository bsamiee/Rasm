{
    "name": "@rasm/atelier",
    "private": true,
    "description": "MCP server driving installed Adobe applications through six universal tools, applications, view, inspect, act, execute_script, and diagnostics, with their events in every result, and serving the tools each linked Adobe extension and each application's own MCP server adds",
    "os": [
        "darwin"
    ],
    "type": "module",
    "imports": {
        "#/*.ts": "./*.ts",
        "#/*": "./*"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/creative-cloud-desktop": "workspace:*",
        "@rasm/extendscript": "workspace:*",
        "@rasm/illustrator": "workspace:*",
        "@rasm/indesign": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "@rasm/typography": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:",
        "es5-shim": "catalog:"
    },
    "devDependencies": {
        "@adobe/cc-ext-uxp-types": "catalog:",
        "@adobe/premierepro": "catalog:",
        "@rasm/process": "workspace:*",
        "@rasm/vite": "workspace:*",
        "@types/node": "catalog:",
        "@types/photoshop": "catalog:",
        "@typescript/native": "catalog:",
        "indesign-uxp-types": "catalog:",
        "uxp-after-effects": "catalog:",
        "vite": "catalog:"
    },
    "nx": {
        "targets": {
            "build--vite": {
                "inputs": [
                    "...",
                    "{projectRoot}/macos/Atelier.xcodeproj/project.xcproj",
                    "{projectRoot}/macos/Atelier.entitlements",
                    "{workspaceRoot}/Xcode.xcconfig"
                ]
            }
        }
    }
}
