{
    "name": "@rasm/applications",
    "version": "0.1.0",
    "private": true,
    "description": "Wire contract and Node client of a Mac application server watching installed and running apps, the six MCP tools over it, and the Node helper build a Mac app embeds",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/macos/applications"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./client": "./client.ts",
        "./tools": "./tools.ts",
        "./vite": "./vite.ts",
        "./workspace": "./workspace.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./client": "./dist/client.js",
            "./tools": "./dist/tools.js",
            "./vite": "./dist/vite.js",
            "./workspace": "./dist/workspace.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/database": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/process": "workspace:*",
        "@rasm/rpc": "workspace:*",
        "@rasm/search": "workspace:*",
        "plist": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
