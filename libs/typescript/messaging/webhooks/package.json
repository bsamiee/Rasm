{
    "name": "@rasm/webhooks",
    "version": "0.1.0",
    "private": true,
    "description": "Webhook receiving and sending over Effect HTTP: signature schemes as rows (Standard Webhooks, Svix, Tailscale, Stripe, GitHub), raw-body verification, timestamp tolerance, queued deliveries keyed by delivery id, and signed delivery retrying transient failures on a caller schedule",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/messaging/webhooks"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./tailscale": "./tailscale.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./tailscale": "./dist/tailscale.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
