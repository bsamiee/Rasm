            "optional": true
        },
        "@pulumi/command": {
            "optional": true
        },
        "@pulumi/pulumi": {
            "optional": true
        },
        "@rasm/mark": {
            "optional": true
        },
        "@rasm/workers": {
            "optional": true
        },
        "@vite-pwa/assets-generator": {
            "optional": true
        },
        "cf": {
            "optional": true
        },
        "cheerio": {
            "optional": true
        },
        "culori": {
            "optional": true
        },
        "postcss": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
