{
    "name": "@rasm/mark",
    "version": "0.1.0",
    "private": true,
    "description": "SVG drawings of one mark painted in a tone over currentColor and part classes, each raster width taking the drawing whose grid it holds at a whole scale, artwork placed on its canvas or framed inside a padding, and written by the resvg and usvg command-line tools",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/graphics/mark"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/process": "workspace:*",
        "image-size": "catalog:"
    },
    "devDependencies": {
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "culori": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "culori": "catalog:peers",
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
