{
    "name": "@rasm/test-portfolio-webdriver",
    "private": true,
    "description": "@rasm/portfolio suites in Firefox over WebDriver against its built Node bundle",
    "type": "module",
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/test-portfolio": "workspace:*",
        "@types/node": "catalog:",
        "@types/selenium-webdriver": "catalog:",
        "effect": "catalog:",
        "selenium-webdriver": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "tags": [
            "host:browser"
        ],
        "implicitDependencies": [
            "@rasm/portfolio"
        ],
        "targets": {
            "test--vitest": {
                "dependsOn": [
                    "...",
                    {
                        "projects": [
                            "@rasm/portfolio"
                        ],
                        "target": "build--vite"
                    }
                ]
            }
        }
    }
}
