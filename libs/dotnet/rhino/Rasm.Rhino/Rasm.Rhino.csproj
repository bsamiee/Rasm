<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Description>Rhino documents, viewports, persistence, blocks, objects, annotation, modeling, commands, display, UI, rendering, and plug-in definitions as IO effects over RhinoCommon</Description>
    </PropertyGroup>

    <PropertyGroup Label="Mapperly">
        <MapperlyAbstractionsScope>runtime</MapperlyAbstractionsScope>
    </PropertyGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Microsoft.Win32.SystemEvents" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CliWrap" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="LanguageExt.Core" />
        <PackageReference Include="LanguageExt.Streaming" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="Riok.Mapperly" PrivateAssets="compile;contentfiles;analyzers;build" />
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="PeterO.Numbers" />
        <PackageReference Include="QuikGraph" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Image Rendering">
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="Svg.Model" />
        <PackageReference Include="Svg.Skia" />
    </ItemGroup>

    <ItemGroup Label="Workspace Packages">
        <ProjectReference Include="../../Rasm.Drafting/Rasm.Drafting.csproj" />
        <ProjectReference Include="../../Rasm.Imaging/Rasm.Imaging.csproj" />
    </ItemGroup>

    <ItemGroup Label="Render Queue">
        <EmbeddedResource Include="Render/Queue/rasm_rhino_render.js" LogicalName="Rasm.Rhino.Render.Queue.rasm_rhino_render.js" />
    </ItemGroup>
</Project>
