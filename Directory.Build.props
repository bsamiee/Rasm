<Project>
    <PropertyGroup Label="Workspace">
        <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
        <ArtifactsPath>$([MSBuild]::NormalizePath('$(RepoRoot)', '.artifacts', 'dotnet'))</ArtifactsPath>
        <IncludeProjectNameInArtifactsPaths>true</IncludeProjectNameInArtifactsPaths>
        <TestsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'tests'))</TestsRoot>
        <AppsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'apps'))</AppsRoot>
    </PropertyGroup>

    <PropertyGroup Label="Project Classification">
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(TestsRoot)'))">tests</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(AppsRoot)'))">apps</ProjectRole>
        <_RepoRelativeDir>/$([MSBuild]::MakeRelative('$(RepoRoot)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</_RepoRelativeDir>
        <RhinoHost Condition="$(_RepoRelativeDir.Contains('/rhino/'))">true</RhinoHost>
        <AssemblyName Condition="'$(RhinoPlugIn)' != ''">$(RhinoPlugIn).$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <_RhinoTargetPlatform>windows</_RhinoTargetPlatform>
        <_RhinoTargetPlatform Condition="$(RuntimeIdentifier.StartsWith('osx-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">macos</_RhinoTargetPlatform>
        <ArtifactsProjectName>$(MSBuildProjectName)_$(_RhinoTargetPlatform)</ArtifactsProjectName>
        <RhinoEnableWindowsFormsTargeting>false</RhinoEnableWindowsFormsTargeting>
        <RhinoInstallPath>$(RHINO_PATH)</RhinoInstallPath>
        <DefaultItemExcludes Condition="'$(_RhinoTargetPlatform)' != 'macos'">$(DefaultItemExcludes);**/macOS/**</DefaultItemExcludes>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Plug-In" Condition="'$(ProjectRole)' == 'apps' and '$(RhinoHost)' != ''">
        <TargetExt>.rhp</TargetExt>
        <Authors>Bardia Samiee</Authors>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishReferencesSymbols>false</PublishReferencesSymbols>
        <UseCurrentRuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX')) or $([MSBuild]::IsOSPlatform('Windows'))">true</UseCurrentRuntimeIdentifier>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <PlugInIcons>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'icons'))</PlugInIcons>
        <PlugInIconSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'icon.svg'))</PlugInIconSource>
        <PlugInPackageIcon Condition="Exists('$(PlugInIconSource)')">icon.png</PlugInPackageIcon>
    </PropertyGroup>

    <PropertyGroup Label="Build Defaults">
        <RepoTargetFramework>net10.0</RepoTargetFramework>
        <TargetFramework>$(RepoTargetFramework)</TargetFramework>
        <TargetFramework Condition="'$(RhinoHost)' != '' and '$(_RhinoTargetPlatform)' == 'windows'">$(RepoTargetFramework)-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <NuGetAudit>false</NuGetAudit>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Label="Mapperly">
        <MapperlyEnumMappingStrategy>ByName</MapperlyEnumMappingStrategy>
        <MapperlyAutoUserMappings>false</MapperlyAutoUserMappings>
        <MapperlyRequiredMappingStrategy>Target</MapperlyRequiredMappingStrategy>
        <MapperlyThrowOnPropertyMappingNullMismatch>true</MapperlyThrowOnPropertyMappingNullMismatch>
        <MapperlyEnabledConversions>Queryable, Enumerable, Dictionary, Span, Memory, EnumToEnum</MapperlyEnabledConversions>
    </PropertyGroup>

    <PropertyGroup Label="Continuous Integration" Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Label="Workspace Analyzers">
        <PackageReference Include="ErrorProne.NET.CoreAnalyzers"               PrivateAssets="all" />
        <PackageReference Include="Meziantou.Analyzer"                         PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Roslynator.Analyzers"                       PrivateAssets="all" />
    </ItemGroup>
</Project>
