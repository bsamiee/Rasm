{
    "name": "@rasm/claude-code",
    "private": true,
    "description": "Claude Code mods as Effect programs: hooks hosted over platform services and an Engine service built on the engine's own calls, with band rows, notices, and model messages, and policy enforcement over tool calls",
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./engine": "./engine/interface.ts",
        "./host": "./engine/host.ts",
        "./ask": "./ui/ask.ts",
        "./draft": "./prompt/draft.ts",
        "./element": "./ui/element.ts",
        "./theme": "./ui/theme.ts",
        "./enforcement": "./policy/enforcement.ts",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@rasm/policy": "workspace:*",
        "@rasm/report": "workspace:*",
        "@rasm/shell": "workspace:*",
        "sh-syntax": "catalog:"
    },
    "devDependencies": {
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "nx": {
        "tags": [
            "host:claude-code"
        ]
    }
}
