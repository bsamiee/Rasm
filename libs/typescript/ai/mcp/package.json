{
    "name": "@rasm/mcp",
    "version": "0.1.0",
    "description": "MCP servers over Effect programs, serving tools and resources over Streamable HTTP or stdio with per-agent state and proxied upstream servers",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/ai/mcp"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./link": "./link.ts",
        "./resource": "./resource.ts",
        "./server": "./server.ts",
        "./toolkit": "./toolkit.ts",
        "./upstream": "./upstream.ts",
        "./cli": "./cli.ts",
        "./handles": "./handles.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./link": "./dist/link.js",
            "./resource": "./dist/resource.js",
            "./server": "./dist/server.js",
            "./toolkit": "./dist/toolkit.js",
            "./upstream": "./dist/upstream.js",
            "./cli": "./dist/cli.js",
            "./handles": "./dist/handles.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/sql-sqlite-node": "catalog:",
        "@opentelemetry/semantic-conventions": "catalog:",
        "@rasm/database": "workspace:*",
        "@rasm/report": "workspace:*",
        "@rasm/rpc": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "env-paths": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
