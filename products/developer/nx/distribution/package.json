{
    "name": "@rasm/nx-distribution",
    "version": "0.1.0",
    "description": "Nx plugin inferring host packages from their manifests, one row per kind (Blender extension, Yak package, Adobe UXP .ccx, Chrome extension, Unreal plug-in): each row builds the package with its host tool, installs it where the host loads it, attaches it to the project's GitHub release, and publishes it to the host store taking uploads; it holds the clean, attach, and publish executors every plugin names by package, the sync generator writing each plugin's executor schemas, and the upgrade target moving every GitHub Actions reference in the workflows to its newest release through jactionlint",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/distribution"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "executors.json",
        "executors/*/schema.json",
        "executors/*/vendored.py*",
        "generators.json",
        "generators/*/schema.json"
    ],
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#/*.json": "./*.json",
        "#/*.py": "./*.py"
    },
    "exports": {
        ".": "./plugin.ts",
        "./inference": "./inference.ts",
        "./release/version-actions": "./version-actions.ts",
        "./executors.json": "./executors.json",
        "./generators.json": "./generators.json",
        "./executors/*": "./executors/*/executor.ts",
        "./generators/*": "./generators/*/generator.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js",
            "#/*.json": "./*.json",
            "#/*.py": "./*.py"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./inference": "./dist/inference.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./executors.json": "./executors.json",
            "./generators.json": "./generators.json",
            "./executors/*": "./dist/executors/*/executor.js",
            "./generators/*": "./dist/generators/*/generator.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@decimalturn/toml-patch": "catalog:",
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@nx/js": "catalog:",
        "@rasm/uxp": "workspace:*",
        "effect": "catalog:",
        "jsonc-parser": "catalog:",
        "minimatch": "catalog:",
        "which": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/which": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    },
    "executors": "./executors.json",
    "generators": "./generators.json"
}
