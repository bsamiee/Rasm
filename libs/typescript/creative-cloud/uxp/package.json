{
    "name": "@rasm/uxp",
    "version": "0.0.0",
    "private": true,
    "description": "UXP manifests, plugin and script runtimes, and Vite plugin builds",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/uxp"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./plugin": "./plugin.ts",
        "./vite": "./vite.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@exodus/bytes": "catalog:",
        "@rasm/automation": "workspace:*",
        "@rasm/mark": "workspace:*"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./plugin": "./dist/plugin.js",
            "./vite": "./dist/vite.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
