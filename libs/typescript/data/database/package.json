{
    "name": "@rasm/database",
    "private": true,
    "description": "D1, SQLite, and PostgreSQL stores reconciling live databases to Effect Schema tables, with atomic batches",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./pg": "./pg.ts"
    },
    "dependencies": {
        "@effect/sql-d1": "catalog:",
        "@effect/sql-pg": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/sql-pglite": "catalog:",
        "@effect/sql-sqlite-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@electric-sql/pglite": "catalog:",
        "@testcontainers/postgresql": "catalog:",
        "@types/node": "catalog:",
        "cf": "catalog:",
        "testcontainers": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "test": {
                "options": {
                    "args": [ "--project=!postgres" ]
                },
                "outputs": [ "...", "{workspaceRoot}/.artifacts/sql/postgres" ]
            },
            "test:integration": {
                "options": {
                    "args": [ "--project=postgres" ]
                }
            },
            "lint:squawk": {
                "command": "squawk --config .config/squawk.toml '.artifacts/sql/postgres/*.sql'",
                "dependsOn": [ "test" ],
                "inputs": [
                    "{workspaceRoot}/.config/squawk.toml",
                    {
                        "dependentTasksOutputFiles": "**/*.sql"
                    },
                    {
                        "runtime": "squawk --version"
                    }
                ]
            }
        }
    }
}
