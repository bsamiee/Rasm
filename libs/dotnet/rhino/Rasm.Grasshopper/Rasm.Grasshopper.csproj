<Project Sdk="Microsoft.NET.Sdk">
    <!-- [PROPERTIES] ──────────────────────────────────────────────────────────────── -->

    <PropertyGroup Label="Package Metadata">
        <Version>0.1.0-alpha.0</Version>
        <Description>Grasshopper 2 as typed effects, with plug-ins declared as data</Description>
    </PropertyGroup>

    <!-- [ITEMS] ───────────────────────────────────────────────────────────────────── -->

    <ItemGroup Label="Rhino">
        <PackageReference Include="Grasshopper2" />
        <PackageReference Include="RhinoCommon" />
    </ItemGroup>

    <ItemGroup Label="Functional Programming">
        <PackageReference Include="LanguageExt.Core" />
    </ItemGroup>

    <ItemGroup Label="Domain Modeling">
        <PackageReference Include="Thinktecture.Runtime.Extensions" />
    </ItemGroup>

    <ItemGroup Label="Identifiers and Hashing">
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="GraphShape" />
        <PackageReference Include="QuikGraph" />
        <PackageReference Include="QuikGraph.Graphviz" />
        <PackageReference Include="SuperLinq" />
    </ItemGroup>

    <ItemGroup Label="Solvers">
        <PackageReference Include="Kiwi" />
    </ItemGroup>

    <ItemGroup Label="Workspace Projects">
        <ProjectReference Include="../Rasm.Rhino/Rasm.Rhino.csproj" />
    </ItemGroup>

    <ItemGroup Label="Package Files">
        <Compile Remove="buildTransitive/**" />
        <None Include="buildTransitive/*" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>
</Project>
