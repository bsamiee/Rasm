{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|Monitor",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.py",
                        "args": [],
                        "timeout": 5,
                        "statusMessage": "git-guard"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mise-env.py",
                        "args": [],
                        "timeout": 30,
                        "statusMessage": "mise-env"
                    }
                ]
            }
        ],
        "CwdChanged": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mise-env.py",
                        "args": [],
                        "timeout": 30,
                        "statusMessage": "mise-env"
                    }
                ]
            }
        ]
    },
    "effortLevel": "high",
    "env": {
        "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000"
    },
    "claudeMdExcludes": [
        "**/.cache/**/CLAUDE.md",
        "**/node_modules/**/CLAUDE.md",
        "**/bin/**/CLAUDE.md",
        "**/obj/**/CLAUDE.md",
        "**/.artifacts/**/CLAUDE.md"
    ],
    "permissions": {
        "allow": [
            "Bash(git *)",
            "Bash(node *)",
            "Bash(uv *)",
            "Bash(rg *)",
            "Bash(fd *)",
            "Bash(ls *)",
            "Bash(tree *)",
            "Bash(loc *)",
            "Bash(cat *)",
            "Bash(mkdir *)",
            "Bash(mv *)"
        ],
        "deny": ["Bash(mise x *)", "Bash(mise exec *)", "Bash(* mise x *)", "Bash(* mise exec *)", "Bash(*--dry-run*)", "Bash(*--dryRun*)"],
        "defaultMode": "auto"
    },
    "outputStyle": "clean-prose",
    "skipDangerousModePermissionPrompt": true,
    "enableAllProjectMcpServers": true
}
