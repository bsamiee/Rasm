{
    "mcpServers": {
        "roslyn-codelens": {
            "type": "stdio",
            "command": "dotnet",
            "args": ["dnx", "RoslynCodeLens.Mcp", "Workspace.slnx"]
        },
        "binlog": {
            "type": "stdio",
            "command": "dotnet",
            "args": ["dnx", "Microsoft.AITools.BinlogMcp"]
        },
        "nuget": {
            "type": "stdio",
            "command": "dotnet",
            "args": ["dnx", "NuGet.Mcp.Server"]
        },
        "ast-grep": {
            "type": "stdio",
            "command": "mise",
            "args": ["exec", "--", "ast-grep-server"],
            "env": {
                "AST_GREP_CONFIG": "${CLAUDE_PROJECT_DIR:-.}/sgconfig.yml"
            }
        },
        "hostinger": {
            "type": "stdio",
            "command": "mise",
            "args": ["exec", "--", "hostinger-api-mcp"],
            "env": {
                "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
            }
        },
        "playwright": {
            "type": "stdio",
            "command": "mise",
            "args": ["exec", "--", "playwright-mcp", "--isolated", "--browser", "chromium", "--caps=vision,pdf,devtools"]
        },
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${GH_PROJECTS_TOKEN}",
                "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions,github_support_docs_search"
            }
        },
        "exa": {
            "type": "http",
            "url": "https://mcp.exa.ai/mcp",
            "headers": {
                "x-api-key": "${EXA_API_KEY}"
            }
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "Authorization": "Bearer ${CONTEXT7_API_KEY}"
            }
        },
        "greptile": {
            "type": "http",
            "url": "https://api.greptile.com/mcp",
            "headers": {
                "Authorization": "Bearer ${GREPTILE_API_KEY}"
            }
        },
        "openaiDeveloperDocs": {
            "type": "http",
            "url": "https://developers.openai.com/mcp"
        },
        "claudeCodeDocs": {
            "type": "http",
            "url": "https://code.claude.com/docs/mcp"
        }
    }
}
