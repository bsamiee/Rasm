language js(typescript, jsx)

or {
    `Effect.runSync($_)`,
    `Effect.runSyncExit($_)`,
    `Effect.runPromise($_)`,
    `Effect.runPromiseExit($_)`,
    `Effect.runFork($_)`,
    `Effect.runCallback($_)`
} as $hit where {
    register_diagnostic(span=$hit, message="Effect run inside library code, return the effect or a Layer and leave the run call to the application entry point", severity="error")
}
