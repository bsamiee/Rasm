            return held;
        }
        var Kind = typeof value.typename === "string" ? realGlobal[value.typename] : undefined;
        var constructed = typeof Kind === "function";
        var object = constructed ? new Kind() : {};
        for (key in value) { if (value.hasOwnProperty(key) && !(constructed && key === "typename")) { object[key] = revive(value[key]); } }
        return object;
    }

    // --- [SCRIPTUI]
    function cancelling(root) {
