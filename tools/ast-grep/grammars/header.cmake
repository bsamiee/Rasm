# --- [COMPOSITION] ----------------------------------------------------------------------

file(READ "${GRAMMAR}" grammar)
string(JSON name GET "${grammar}" name)
string(JSON dialect ERROR_VARIABLE standalone GET "${grammar}" inherits)
string(JSON externals LENGTH "${grammar}" externals)
string(JSON constants ERROR_VARIABLE constantless GET "${grammar}" rules _constants members)
set(rows "")
if(NOT constantless)
    string(JSON count LENGTH "${constants}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last} 2)
        math(EXPR value_at "${index} + 1")
        string(JSON constant GET "${constants}" ${index} value)
        string(JSON value GET "${constants}" ${value_at} value)
        string(APPEND rows "#define ${constant} ${value}\n")
    endforeach()
endif()
if(NOT standalone AND NOT name STREQUAL dialect)
    math(EXPR hole "${externals} - 1")
    foreach(function IN ITEMS create destroy serialize deserialize)
        string(APPEND rows "#define tree_sitter_${dialect}_external_scanner_${function} tree_sitter_${name}_external_scanner_${function}\n")
    endforeach()
    string(APPEND rows "#define tree_sitter_${dialect}_external_scanner_scan dialect_scan\n#define COMPOSITE_SCAN tree_sitter_${name}_external_scanner_scan\n#define HOLE_SYMBOL ${hole}\n")
endif()
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${rows}" @ONLY)
