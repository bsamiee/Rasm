{
    "name": "@rasm/photoshop-plugin",
    "private": true,
    "type": "module",
    "dependencies": {
        "@adobe-uxp-types/photoshop": "catalog:",
        "@adobe-uxp-types/uxp": "catalog:",
        "@effect/platform-node": "catalog:",
        "@rasm/creative-cloud-server": "workspace:*",
        "effect": "catalog:",
        "vite": "catalog:",
        "vite-uxp-plugin": "catalog:"
    },
    "nx": {
        "targets": {
            "build": { "options": { "command": "vite build", "cwd": "{projectRoot}" }, "outputs": ["{workspaceRoot}/.artifacts/creative-cloud/photoshop-plugin"] },
            "deploy": {
                "executor": "nx:run-commands",
                "cache": false,
                "parallelism": false,
                "dependsOn": ["build"],
                "options": { "command": "node automation.ts deploy", "cwd": "{projectRoot}" }
            }
        }
    }
}
