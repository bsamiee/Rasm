{
    "name": "@rasm/quran",
    "version": "0.1.0",
    "private": true,
    "description": "Quran text from CSV or a mushaf, selected by surah or division a riwayah counts, ayah marks set against a face, and Quranic sign sets a face draws",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/data/quran"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@quran.ws/text": "catalog:",
        "@rasm/search": "workspace:*",
        "@rasm/typography": "workspace:*",
        "quran-meta": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
