{
    "name": "@rasm/ssh",
    "version": "0.1.0",
    "private": true,
    "description": "Commands, copies, and forwards over OpenSSH hosts by config, with connections shared across processes",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/network/ssh"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./client": "./client.ts",
        "./forward": "./forward.ts",
        "./host": "./host.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./client": "./dist/client.js",
            "./forward": "./dist/forward.js",
            "./host": "./dist/host.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/process": "workspace:*",
        "ssh-config": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
