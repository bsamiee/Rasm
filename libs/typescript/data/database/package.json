{
    "name": "@rasm/database",
    "private": true,
    "description": "Databases reconciled to their declared schemas",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./catalog": "./catalog.ts",
        "./column": "./column.ts",
        "./finding": "./finding.ts",
        "./pg": "./pg.ts",
        "./relation": "./relation.ts",
        "./transaction": "./transaction.ts"
    },
    "dependencies": {
        "@effect/sql-d1": "catalog:",
        "@effect/sql-pg": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/sql-pglite": "catalog:",
        "@effect/sql-sqlite-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@electric-sql/pglite": "catalog:",
        "@testcontainers/postgresql": "catalog:",
        "@types/node": "catalog:",
        "cf": "catalog:",
        "testcontainers": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "targets": {
            "test": {
                "options": {
                    "args": [ "--project=!postgres" ]
                },
                "outputs": [ "...", "{workspaceRoot}/.artifacts/sql/postgres" ]
            },
            "test:integration": {
                "options": {
                    "args": [ "--project=postgres" ]
                }
            },
            "lint:squawk": {
                "command": "squawk --config .config/squawk.toml '.artifacts/sql/postgres/*.sql'",
                "dependsOn": [ "test" ],
                "inputs": [
                    "{workspaceRoot}/.config/squawk.toml",
                    {
                        "dependentTasksOutputFiles": "**/*.sql"
                    },
                    {
                        "externalDependencies": []
                    },
                    {
                        "runtime": "squawk --version"
                    }
                ]
            }
        }
    }
}
