        var rows = descendants(root);
        for (var i = 0; i < rows.length; i++) {
            if (rows[i].type === "button" && (nameOf(rows[i]).toLowerCase() === "cancel" || String(rows[i].text).toLowerCase() === "cancel")) { return rows[i]; }
        }
        return null;
    }
    function press(root, key) {
        var control = match(root, key);
        control.notify("onClick");
        return control === cancelling(root) ? 2 : 1;
    }
    function answered(session, root, answer) {
        var result = answer.answer === undefined ? 1 : answer.answer;
        if (answer.fields) { fill(root, answer.fields); }
        var presses = answer.presses || [];
        for (var i = 0; i < presses.length; i++) { result = press(root, presses[i]); }
        session.record.windows[session.record.windows.length - 1].filled = tree(root);
        return result;
    }
    function shown(session, root) {
        var answer = session.windowAnswers[session.windowShown] || {};
        session.windowShown++;
        root.layout.layout(true);
        session.record.windows.push({ title: root.text, type: root.type, tree: tree(root) });
        run(root.onShow, root);
        if (root.type === "palette") {
            session.palettes.push({ window: root, answer: answer });
            return 0;
        }
        return answered(session, root, answer);
    }

    // --- [STAND_INS]
    function statics(fake, real, own) {
