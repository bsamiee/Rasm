    "nx": {
        "tags": ["language:typescript"],
        "targets": {
            "restore": {
                "command": "dotnet restore Workspace.slnx",
                "cache": true,
                "inputs": ["{workspaceRoot}/Workspace.slnx", "{workspaceRoot}/{apps,libs,tests,tools}/**/*.csproj", "dotnet"],
                "outputs": ["{workspaceRoot}/.artifacts/dotnet/obj/*/project.assets.json", "{workspaceRoot}/.artifacts/dotnet/obj/*/*.nuget.*"]
            },
            "browsers": {
                "command": "playwright install chromium --no-shell",
                "parallelism": false
            },
            "grammar": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [
                    {
                        "externalDependencies": ["@tree-sitter-grammars/tree-sitter-xml", "@derekstride/tree-sitter-sql"]
                    },
                    {
                        "runtime": "tree-sitter --version"
                    }
                ],
                "outputs": ["{workspaceRoot}/.cache/ast-grep/xml.so", "{workspaceRoot}/.cache/ast-grep/sql.so"],
                "options": {
                    "commands": [
                        "tree-sitter build --output .cache/ast-grep/xml.so node_modules/@tree-sitter-grammars/tree-sitter-xml/xml",
                        "tree-sitter build --output .cache/ast-grep/sql.so node_modules/@derekstride/tree-sitter-sql"
                    ],
                    "parallel": true
                }
            },
            "rewrite": {
                "command": "ast-grep scan -U --no-ignore hidden",
                "parallelism": false,
                "dependsOn": ["grammar"]
            },
            "outline": {
                "command": "ast-grep outline --outline-rules tools/ast-grep/outline/typescript.yml --outline-rules tools/ast-grep/outline/python.yml --outline-rules tools/ast-grep/outline/swift.yml --outline-rules tools/ast-grep/outline/java.yml",
                "dependsOn": ["grammar"]
            },
            "lint": {
                "executor": "nx:run-commands",
                "cache": true,
                "dependsOn": ["grammar"],
                "inputs": [
                    "{workspaceRoot}/**/*",
                    {
                        "dependentTasksOutputFiles": "**/*.so"
                    },
                    {
                        "runtime": "ast-grep --version"
                    },
                    {
                        "runtime": "ruff --version"
                    },
                    {
                        "runtime": "biome --version"
                    },
                    {
                        "runtime": "yamllint --version"
                    },
                    {
                        "runtime": "actionlint --version"
                    },
                    {
                        "runtime": "shellcheck --version"
                    },
                    {
                        "runtime": "google-java-format --version"
                    },
                    {
                        "runtime": "pmd --version"
                    }
                ],
                "options": {
                    "commands": [
                        "ast-grep scan --no-ignore hidden",
                        "biome check --error-on-warnings",
                        "ruff check",
                        "yamllint .",
                        "actionlint",
                        "fd --hidden --extension java --exec-batch google-java-format --aosp --dry-run --set-exit-if-changed",
                        "fd --hidden --extension java --exec-batch pmd check --rulesets pmd.xml --use-version java-27 --cache .cache/pmd/java --no-progress"
                    ],
                    "parallel": true
                }
            },
            "format": {
                "executor": "nx:run-commands",
                "dependsOn": ["restore"],
                "options": {
                    "commands": [
                        "biome check --write --error-on-warnings",
                        "ruff check --fix",
                        "ruff format",
                        "yamlfmt .",
                        "fd --hidden --extension java --exec-batch google-java-format --aosp --replace",
                        "dotnet format Workspace.slnx --no-restore"
                    ],
                    "parallel": false
                }
            },
            "typecheck": {
                "inputs": [
                    "typescript",
                    "{workspaceRoot}/tsconfig.json",
                    "{workspaceRoot}/*.config.ts",
                    "{workspaceRoot}/{infra,tools/nx,tools/yak}/*.ts",
                    {
                        "externalDependencies": ["typescript"]
                    }
                ],
                "outputs": ["{workspaceRoot}/.cache/typescript/out/root"]
            },
            "check": {
                "dependsOn": ["lint", "typecheck"]
            },
            "up": {
                "command": "doppler run --project rasm --config dev_repo -- node infra/cli.ts up",
                "parallelism": false
            },
            "refresh": {
                "command": "doppler run --project rasm --config dev_repo -- node infra/cli.ts refresh",
                "parallelism": false
            },
            "upgrade": {
                "executor": "nx:run-commands",
                "parallelism": false,
                "options": {
                    "commands": [
                        "uv sync --upgrade",
                        "ncu --workspaces --target newest --upgrade --install always",
                        "dotnet dnx dotnet-outdated-tool -- --upgrade --pre-release Always --no-restore eng/dotnet/Rasm.Catalog/Rasm.Catalog.csproj",
                        "mise upgrade"
                    ],
                    "parallel": false
                },
                "configurations": {
                    "python": {
                        "commands": ["uv sync --upgrade"]
                    },
                    "typescript": {
                        "commands": ["ncu --workspaces --target newest --upgrade --install always"]
                    },
                    "dotnet": {
                        "commands": ["dotnet dnx dotnet-outdated-tool -- --upgrade --pre-release Always --no-restore eng/dotnet/Rasm.Catalog/Rasm.Catalog.csproj"]
                    },
                    "tools": {
                        "commands": ["mise upgrade"]
                    },
                    "rhino": {
                        "commands": ["node tools/yak/rhino-mcp-platform.ts"]
                    }
                }
            }
        }
    }
