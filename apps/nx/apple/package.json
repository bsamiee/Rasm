{
    "name": "@rasm/nx-apple",
    "version": "0.0.0",
    "description": "Nx plugin inferring SwiftPM packages, Xcode projects, and Xcode workspaces from the toolchain's own output",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/apple"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts",
        "#analyzer": "./.build/release/nx-apple-analyzer"
    },
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./release/version-actions": "./version-actions.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json" ],
    "scripts": {
        "prepare": "swift build -c release --product nx-apple-analyzer"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugins/project-graph.js",
            "./release/version-actions": "./dist/version-actions.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    },
    "executors": "./executors.json"
}
