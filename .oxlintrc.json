{
    // --- [CONFIGURATION] ---------------------------------------------------------------

    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "react", "jsx-a11y"],
    "categories": { "correctness": "error", "suspicious": "error", "pedantic": "error", "perf": "error", "style": "error", "restriction": "error", "nursery": "error" },
    "options": { "typeAware": true, "reportUnusedDisableDirectives": "error" },

    // --- [RULES] -----------------------------------------------------------------------

    "rules": {
        // --- [ESLINT]

        "class-methods-use-this": ["error", { "ignoreOverrideMethods": true }],
        "func-names": ["error", "as-needed", { "generators": "never" }],
        "id-length": "off", // Grammar `$`, `_` that `no-unused-vars` requires, Effect type parameters
        "max-classes-per-file": "off", // Schema classes of one concept share a file, CLAUDE.md file organization
        "max-lines": "off", // Counts push one-caller helper extraction CLAUDE.md forbids
        "max-lines-per-function": "off", // Counts push one-caller helper extraction CLAUDE.md forbids
        "max-nested-callbacks": ["error", { "max": 3 }],
        "max-params": ["error", { "max": 10 }],
        "max-statements": "off", // Counts push one-caller helper extraction CLAUDE.md forbids
        "new-cap": ["error", { "capIsNew": false }],
        "no-bitwise": ["error", { "allow": ["&"] }],
        "no-magic-numbers": "off", // Constants stay only where they remove logic, CLAUDE.md
        "no-param-reassign": ["error", { "props": true }],
        "no-redeclare": "off", // Flags value and type pairs of one name, `tsc` reports redeclarations
        "no-restricted-globals": [
            "error",
            { "name": "Buffer", "message": "Import `Buffer` from `node:buffer`, so the load graph sees the host module" },
            { "name": "chrome", "message": "Call extension APIs through `browser`, which Chrome 148 and later define beside `chrome`" },
            { "name": "clearImmediate", "message": "Import `clearImmediate` from `node:timers`, so the load graph sees the host module" },
            { "name": "setImmediate", "message": "Import `setImmediate` from `node:timers`, so the load graph sees the host module" }
        ],
        "no-restricted-imports": [
            "error",
            {
                "paths": [
                    { "name": "@effect/platform-node", "message": "Import the module subpath (`@effect/platform-node/NodeRuntime`), the package entry evaluates every Node service module" },
                    { "name": "smol-toml", "message": "Parse TOML through `Toml.parse` from `effect/encoding`" },
                    { "name": "yaml", "importNames": ["parse"], "message": "Parse YAML through `Yaml.parse` from `effect/encoding`" }
                ],
                "patterns": [{ "group": ["./**", "../**", ".", ".."], "message": "Import the package's own modules through `#/` and other packages by name" }]
            }
        ],
        "no-ternary": "off", // Domain logic stays expression-oriented, CLAUDE.md
        "no-undef": "off", // `tsc` owns undefined names, oxlint documents the overlap
        "no-undefined": "off", // `no-shadow-restricted-names` owns the shadowing defect
        "no-underscore-dangle": ["error", { "allow": ["__unparsed__", "_meta", "_path", "_tag"] }],
        "no-unused-vars": ["error", { "args": "all", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        "no-use-before-define": ["error", { "functions": false, "classes": false, "variables": false }],
        "one-var": ["error", "never"],
        "sort-imports": "off", // `oxfmt` `sortImports` owns import order
        "sort-keys": "off", // Members follow domain order, CLAUDE.md file organization

        // --- [IMPORT]

        "import/consistent-type-specifier-style": "off", // Contradicts `typescript/consistent-type-imports` `inline-type-imports`
        "import/default": "off", // Flags Vite `?inline` and UXP `indesign` imports, `tsc` reports TS1192
        "import/extensions": [
            "error",
            "never",
            {
                "checkTypeImports": true,
                "tsx": "always",
                "json": "always",
                "css": "always",
                "svg": "always",
                "pathGroupOverrides": [
                    { "pattern": "#/**", "action": "enforce" },
                    { "pattern": "**", "action": "ignore" }
                ]
            }
        ],
        "import/max-dependencies": "off", // Counts push one-caller helper extraction CLAUDE.md forbids
        "import/no-named-export": "off", // With `import/no-default-export` no export remains
        "import/no-namespace": "error",
        "import/no-nodejs-modules": "off", // Scoped to browser code, `no-restricted-globals` requires `node:` imports
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "pdfjs-dist", "core-js/modules/*"] }],
        "import/prefer-default-export": "off", // Contradicts `import/no-default-export`

        // --- [JSX_A11Y]

        "jsx-a11y/media-has-caption": "off", // Demands a `<track>`, where open captions burned into the frames, which WCAG 1.2.2 accepts, carry none
        "jsx-a11y/no-autofocus": ["error", { "ignoreNonDOM": true }],

        // --- [NODE]

        "node/no-sync": "off", // Tests read fixtures synchronously
        "node/no-top-level-await": "off", // Guards `require(esm)` loading Vitest never uses

        // --- [OXC]

        "oxc/no-async-await": "off", // Effect `asyncFunction` owns `async` outside tests
        "oxc/no-map-spread": "off", // Fix mutates objects in place, CLAUDE.md functional rule
        "oxc/no-optional-chaining": "off", // Guards engines older than the `esnext` target
        "oxc/no-rest-spread-properties": "off", // Guards engines older than the `esnext` target

        // --- [PROMISE]

        "promise/avoid-new": "off", // Effect `newPromise` owns the defect
        "promise/prefer-await-to-callbacks": "off", // Pushes toward `async`, which Effect `asyncFunction` refuses
        "promise/prefer-await-to-then": "off", // Pushes toward `async`, which Effect `asyncFunction` refuses
        "promise/valid-params": "off", // Reads `Effect.catch(effect, handler)` as `Promise#catch`

        // --- [REACT]

        "react/capitalized-calls": "off", // Flags non-component constructors (`PdfDocument`)
        "react/forbid-component-props": "off", // react-aria components take `className` and `style`
        "react/function-component-definition": ["error", { "namedComponents": "arrow-function", "unnamedComponents": "arrow-function" }],
        "react/jsx-filename-extension": ["error", { "extensions": ["tsx"] }],
        "react/jsx-max-depth": "off", // Counts push one-caller helper extraction CLAUDE.md forbids
        "react/jsx-no-literals": "off", // Guards translation layers no project holds
        "react/jsx-props-no-spreading": "off", // Components forward props to their react-aria component, `exceptions` lists each by hand
        "react/no-multi-comp": ["error", { "ignoreStateless": true }],
        "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
        "react/react-in-jsx-scope": "off", // `jsx: react-jsx` imports the JSX runtime
        "react/rules-of-hooks": "off", // Reads Effect and Playwright `use` calls as hooks, `**/*.tsx` enables it

        // --- [TYPESCRIPT]

        "typescript/consistent-type-exports": ["error", { "fixMixedExportsWithInlineTypeSpecifier": true }],
        "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
        "typescript/explicit-function-return-type": "off", // Forces declarations inference states, CLAUDE.md checker rule
        "typescript/explicit-member-accessibility": ["error", { "accessibility": "no-public" }],
        "typescript/explicit-module-boundary-types": "off", // Forces declarations inference states, CLAUDE.md checker rule
        "typescript/no-base-to-string": ["error", { "checkUnknown": true }],
        "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
        "typescript/no-deprecated": ["error", { "allow": [{ "from": "package", "package": "@opentelemetry/semantic-conventions", "name": ["ATTR_GEN_AI_OPERATION_NAME", "ATTR_GEN_AI_PROMPT_NAME", "ATTR_GEN_AI_TOOL_NAME", "ATTR_MCP_METHOD_NAME", "ATTR_MCP_RESOURCE_URI", "METRIC_MCP_SERVER_OPERATION_DURATION"] }] }], // GenAI and MCP names moved to a repository publishing no package, values unchanged
        "typescript/no-generated-empty-object-type": "off", // `Record<never, never>` is the empty case of `Data.TaggedEnum`
        "typescript/no-invalid-void-type": "off", // Effect signatures take `void` type arguments (`Effect.callback<void>`)
        "typescript/no-misused-spread": "off", // Flags class spreads (`{ ...this }`, `{ ...Pg }`), `allow` lists each class by hand
        "typescript/no-unnecessary-type-arguments": "off", // Flags `Effect.context<never>()`, and omitting it widens `R` to `any` in `Effect.all`
        "typescript/no-unnecessary-type-parameters": "off", // Counts a class parameter whose one use is its base type argument (`Data.Class<{ env: E }>`) as unused, the shape of every generic data class
        "typescript/prefer-readonly-parameter-types": "off", // Forces declarations inference states, CLAUDE.md checker rule
        "typescript/promise-function-async": "off", // Pushes toward `async`, which Effect `asyncFunction` refuses
        "typescript/strict-boolean-expressions": "off", // Effect `strictBooleanExpressions` owns the defect
        "typescript/unbound-method": "off", // Flags `Intl` getters `lib.d.ts` types as methods, and `import.meta.resolve`

        // --- [UNICORN]

        "unicorn/import-style": ["error", { "styles": { "node:path": { "named": true, "default": false } }, "checkDynamicImport": false }],
        "unicorn/max-nested-calls": "off", // Counts push one-caller helper extraction CLAUDE.md forbids
        "unicorn/no-array-callback-reference": "off", // Point-free calls, CLAUDE.md functional rule
        "unicorn/no-array-for-each": "off", // Fix writes a `for...of` loop, ast-grep `no-statement-loop-tsx` refuses it
        "unicorn/no-array-method-this-argument": "off", // Reads the function of `Effect.forEach` and `Record.map` as `thisArg`
        "unicorn/no-array-reduce": "off", // Fix writes a `for` loop, CLAUDE.md keeps imperative code at boundaries
        "unicorn/no-instanceof-builtins": ["error", { "useErrorIsError": true }],
        "unicorn/no-null": "off", // Host APIs take `null` (`combineOptionsForExecutor`)
        "unicorn/no-useless-undefined": ["error", { "checkArguments": false, "checkArrowFunctionBody": false }],
        "unicorn/number-literal-case": "off", // `oxfmt` writes hex literal case the other way
        "unicorn/prefer-number-coercion": "off", // Fix reads CSS lengths (`80px`) through `Number`, which returns `NaN`
        "unicorn/prefer-query-selector": "off", // Contradicts ast-grep `no-id-query-by-selector`
        "unicorn/text-encoding-identifier-case": ["error", { "withDash": true }],
        "unicorn/throw-new-error": "off" // Flags `Schema.TaggedError<X>()(...)` class heritage calls
    },

    // --- [OVERRIDES] -------------------------------------------------------------------

    "overrides": [
        {
            "files": ["**/*.config.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            { "name": "@effect/platform-node", "message": "Import the module subpath (`@effect/platform-node/NodeRuntime`), the package entry evaluates every Node service module" },
                            { "name": "smol-toml", "message": "Parse TOML through `Toml.parse` from `effect/encoding`" },
                            { "name": "yaml", "importNames": ["parse"], "message": "Parse YAML through `Yaml.parse` from `effect/encoding`" }
                        ],
                        "patterns": [
                            { "group": ["**/package.json", "#/package.json"], "message": "Build helpers read the project manifest from the directory they take" },
                            { "group": ["./**", "../**", ".", ".."], "message": "Import the package's own modules through `#/` and other packages through their `@rasm/<lib>` entries" }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["**/*.config.ts", "**/server/main.ts", "**/version-actions.ts", "**/.storybook/*.{ts,tsx}", "tools/ast-grep/grammars/*/grammar.js", "tools/conformance/*/rule.ts"],
            "rules": {
                "import/no-default-export": "off" // Loaders read default exports
            }
        },
        {
            "files": ["**/creative-cloud/*/host.ts"], // ExtendScript runs ES3, swc lowers syntax alone
            "rules": {
                "complexity": "off",
                "guard-for-in": "off",
                "no-nested-ternary": "off",
                "no-param-reassign": ["error", { "props": false }], // ES3 has no `Reflect.set`, a host object takes each key by assignment
                "prefer-named-capture-group": "off",
                "prefer-object-has-own": "off",
                "require-unicode-regexp": "off",
                "typescript/no-base-to-string": "off",
                "typescript/no-unsafe-type-assertion": "off", // ES3 has no `Reflect.set`, and host interfaces hold no index signature an assignment writes through
                "typescript/only-throw-error": "off",
                "typescript/prefer-string-starts-ends-with": "off",
                "unicorn/no-nested-ternary": "off",
                "unicorn/prefer-at": "off",
                "unicorn/prefer-code-point": "off",
                "unicorn/prefer-number-properties": "off",
                "unicorn/prefer-spread": "off", // Spread lowers to `Array.from` helpers ES3 lacks
                "unicorn/prefer-string-replace-all": "off"
            }
        },
        { "files": ["products/developer/nx/**"], "rules": { "unicorn/require-post-message-target-origin": "off" } }, // Worker `postMessage` takes no `targetOrigin`
        { "files": ["**/*.tsx"], "rules": { "react/rules-of-hooks": "error" } },
        {
            "files": ["plugins/*/*/hooks/**"],
            "rules": {
                "node/callback-return": "off", // Hooks await `next`, a `claude-code` continuation
                "promise/no-callback-in-promise": "off", // Hooks await `next`, a `claude-code` continuation
                "typescript/no-unsafe-assignment": "off", // Hooks modules import `claude-code` alone, so no decoder types the `JSON.parse` of a server reply
                "unicorn/catch-error-name": "off" // Reads the engine `$` a `claude-code` `on(...).catch` handler takes first as a rejection value
            }
        },
        {
            "files": ["**/creative-cloud/*/plugin.ts"], // UXP plugin runtime, its `execute_script` evaluates caller source
            "rules": { "typescript/no-implied-eval": "off", "typescript/no-unsafe-call": "off" }
        },
        {
            "files": ["tests/**/*.test.{ts,tsx}"],
            "plugins": ["vitest"],
            "rules": {
                "no-empty-pattern": ["error", { "allowObjectPatternsAsParameters": true }],
                "vitest/consistent-test-it": ["error", { "fn": "it" }],
                "vitest/no-importing-vitest-globals": "off", // Contradicts `prefer-importing-vitest-globals`
                "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["it", "it.each", "it.for"] }],
                "vitest/prefer-called-times": "off", // Contradicts `vitest/prefer-called-once`
                "vitest/prefer-expect-assertions": ["error", { "onlyFunctionsWithExpectInLoop": true, "onlyFunctionsWithExpectInCallback": true }], // Tests asserting in a loop or callback alone, where a skipped callback leaves the test vacuous
                "vitest/prefer-lowercase-title": ["error", { "ignore": ["describe"] }],
                "vitest/prefer-to-be-falsy": "off", // Contradicts `prefer-strict-boolean-matchers`
                "vitest/prefer-to-be-truthy": "off", // Contradicts `prefer-strict-boolean-matchers`
                "vitest/require-hook": "off", // Shared suites register cases by a top-level call
                "vitest/require-test-timeout": "off", // Configuration states departures from defaults
                "vitest/require-top-level-describe": "off", // Forces a `describe` restating the file subject
                "vitest/valid-title": ["error", { "ignoreTypeOfDescribeName": true }] // `vitest/prefer-describe-function-title` names a `describe` by the function it tests
            }
        },
        { "files": ["tests/support/typescript/*.ts"], "rules": { "no-empty-pattern": ["error", { "allowObjectPatternsAsParameters": true }] } },
        {
            "files": ["libs/python/blender/rendering/rasm/rendering/_batch/rasm-render.js", "products/apps/rhino/Darkroom/Queue/darkroom-render.js"],
            "rules": {
                "import/unambiguous": "off", // Classic scripts, no modules
                "typescript/no-unsafe-assignment": "off", // Scripts read untyped host globals (`job`)
                "typescript/no-unsafe-call": "off", // Scripts read untyped host globals (`job`)
                "typescript/no-unsafe-member-access": "off", // Scripts read untyped host globals (`job`)
                "typescript/no-unsafe-return": "off" // Scripts read untyped host globals (`job`)
            }
        },
        {
            "files": ["tools/ast-grep/grammars/**"],
            "rules": {
                "no-underscore-dangle": "off", // Grammars name hidden rules `_x`
                "typescript/no-unsafe-argument": "off", // Grammar DSL is untyped
                "typescript/no-unsafe-assignment": "off", // Grammar DSL is untyped
                "typescript/no-unsafe-call": "off", // Grammar DSL is untyped
                "typescript/no-unsafe-member-access": "off", // Grammar DSL is untyped
                "typescript/no-unsafe-return": "off", // Grammar DSL is untyped
                "typescript/prefer-nullish-coalescing": "off" // Grammar DSL is untyped
            }
        }
    ]
}
