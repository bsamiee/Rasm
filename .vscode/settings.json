{
    // --- [EXPLORER_VISIBILITY] ---------------------------------------------------------
    "explorer.compactFolders": false,
    "files.exclude": {
        ".cargo/rustc-source": true,
        "**/node_modules": true,
        "**/.artifacts": true,
        "**/.cache": true,
        "**/.cloudflare": true,
        "**/dist": true,
        "**/.pixi": true,
        "**/.venv": true,
        "**/.vs": true,
        "**/xcuserdata": true,
        "**/__pycache__": true
    },

    // --- [FILE_WATCHING] ---------------------------------------------------------------
    "files.watcherExclude": {
        ".cargo/rustc-source/**": true,
        "**/.artifacts/**": true,
        "**/.cache/**": true,
        "**/.cloudflare/**": true,
        "**/.pixi/**": true,
        "**/.venv/**": true,
        "**/.vs/**": true,
        "**/__pycache__/**": true,
        "**/dist/**": true,
        "**/docs/research/**": true,
        "**/node_modules/**": true
    },

    // --- [FILE_NESTING] ----------------------------------------------------------------
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "CLAUDE.md": ".mcp.json, AGENTS.md",
        "README.md": "LICENSE",
        "Directory.Build.props": "Directory.Build.targets, Directory.Packages.props, Directory.Build.rsp, global.json, NuGet.config, Workspace.slnx",
        ".gitignore": ".gitattributes",
        "pyproject.toml": "uv.lock, pixi.lock",
        "Cargo.toml": "rust-toolchain.toml, rustfmt.toml, clippy.toml, Cargo.lock",
        "nx.json": ".editorconfig, .periphery.yml, .swift-format, .swiftlint.yml, .yamlfmt.yaml, .yamllint.yaml, mise.toml, pmd.xml, sgconfig.yml, Xcode.xcconfig",
        "package.json": "biome.json, pnpm-workspace.yaml, pnpm-lock.yaml, tsconfig.base.json, tsconfig.json, vite.config.ts, vitest.config.ts"
    },

    // --- [PYTHON] ----------------------------------------------------------------------
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "python.terminal.activateEnvironment": false,
    "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },

    // --- [TYPESCRIPT] ------------------------------------------------------------------
    "js/ts.experimental.useTsgo": true,
    "js/ts.tsdk.path": "./node_modules/typescript",
    "js/ts.trace.server": "off",
    "[typescript][typescriptreact][javascript][javascriptreact][json][jsonc][css]": { "editor.defaultFormatter": "biomejs.biome" },

    // --- [DOTNET] ----------------------------------------------------------------------
    "csharp.suppressBuildAssetsNotification": true,
    "dotnet.defaultSolution": "Workspace.slnx",
    "dotnet.projects.enableAutomaticRestore": false,

    // --- [RUST] ------------------------------------------------------------------------
    "rust-analyzer.cargo.extraEnv": { "CARGO_BUILD_TARGET_DIR": "${workspaceFolder}/.artifacts/rust/rust-analyzer", "CARGO_BUILD_BUILD_DIR": "${workspaceFolder}/.cache/rust/rust-analyzer" },
    "rust-analyzer.check.overrideCommand": [ "cargo", "clippy", "--locked", "--workspace", "--lib", "--bins", "--tests", "--message-format=json-diagnostic-rendered-ansi", "--keep-going", "--", "-D", "warnings" ],
    "rust-analyzer.rustc.source": ".cargo/rustc-source/Cargo.toml",

    // --- [SWIFT] -----------------------------------------------------------------------
    "swift.buildPath": "${workspaceFolder}/.cache/swiftpm/vscode",
    "swift.searchSubfoldersForPackages": true,
    "swift.ignoreSearchingForPackagesInSubfolders": [ ".", ".build", "Packages", "out", "bazel-out", "bazel-bin", "research" ],

    // --- [JAVA] ------------------------------------------------------------------------
    "java.configuration.runtimes": [ { "name": "JavaSE-27", "path": "${JAVA_HOME}", "default": true } ],
    "java.import.exclusions": [ "**/node_modules/**", "**/.metadata/**", "**/archetype-resources/**", "**/META-INF/maven/**", "**/.cache/**" ],
    "java.import.maven.enabled": false,
    "java.import.gradle.enabled": false,
    "java.project.sourcePaths": [ ".claude/skills/use-ghidra/scripts" ],
    "java.project.referencedLibraries": [ "${GHIDRA_INSTALL_DIR}/Ghidra/**/lib/*.jar" ],
    "java.format.settings.google.extra": "--aosp",
    "[java]": { "editor.defaultFormatter": "josevseb.google-java-format-for-vs-code" },

    // --- [YAML] ------------------------------------------------------------------------
    "yaml.format.enable": false,

    // --- [SHELL] -----------------------------------------------------------------------
    "[shellscript]": { "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode" },

    // --- [TOML] ------------------------------------------------------------------------
    "[toml]": { "editor.defaultFormatter": "tombi-toml.tombi" }
}
