// --- [OPERATIONS] ----------------------------------------------------------------------

(function () {
    var realApp = app;
    var realGlobal = $.global;
    var RealFile = File;
    var RealFolder = Folder;
    var RealFunction = Function;
    var realExecute = executeAction;
    var realOpen = File.prototype.open;
    var ENGINE = new File($.fileName).fsName;
    var ENUMERATOR = /^([A-Za-z]\w*)\.([A-Z][A-Z0-9_]*)$/;
    var PATHED = /^[\/~]/;
    var SPECIFIER = /^\/document\[@id=(\d+)\](?:\/layer\[@id=(\d+)\])?$/;
    var LOGGED = /^\d{4}:\d\d:\d\d \d\d:\d\d:\d\d : (.*?) : (.*?) : (.*)$/;
    var REFUSED = ["bringToFront", "showColorPicker", "system", "togglePalettes", "batch"];
    var PROGRESS = ["doProgress", "doForcedProgress", "doProgressTask", "doProgressSegmentTask", "doProgressSubTask"];
    var OPTIONS = ["putCustomOptions", "eraseCustomOptions"];
    var HELD = ["displayDialogs", "playbackDisplayDialogs", "notifiersEnabled"];
    var EVENTS = ["openViewlessDocument", "systemCall", "quit"];
    var PARTS = [["guide", "numberOfGuides"], ["channel", "numberOfChannels"], ["path", "numberOfPaths"]];
    var GRID = 65536;
    function has(owner, key) { return Object.prototype.hasOwnProperty.call(owner, key); }
    function id(name) { return stringIDToTypeID(name); }

    // --- [FILES]
    function tail(path, from) {
        var file = new RealFile(path);
        file.encoding = "UTF-8";
        if (!file.exists || !file.open("r")) { return ""; }
        file.seek(from);
        var text = file.read();
        file.close();
        return text;
    }
    function ensured(folder) {
        if (folder !== null && !folder.exists) { ensured(folder.parent); folder.create(); }
    }

    // --- [DESCRIPTORS]
    function parsedJson(text) { return eval("(" + text + ")"); }
    function converted(value) {
        var descriptor = new ActionDescriptor();
        descriptor.putObject(id("object"), id("object"), value);
        return realExecute(id("convertJSONdescriptor"), descriptor, DialogModes.NO).getString(id("json"));
    }
    function action(value) {
        var kind = value.typename;
        if (kind === "ActionDescriptor") { return parsedJson(converted(value)); }
        if (kind !== "ActionList" && kind !== "ActionReference") { return null; }
        var wrapper = new ActionDescriptor();
        if (kind === "ActionList") { wrapper.putList(id("list"), value); } else { wrapper.putReference(id("null"), value); }
        var whole = parsedJson(converted(wrapper));
        return kind === "ActionList" ? whole.list : whole["null"];
    }

    // --- [CODEC]
    function enumerator(value) {
        var parts = ENUMERATOR.exec(String(value));
        return parts && realGlobal[parts[1]] !== undefined && realGlobal[parts[1]] !== null && realGlobal[parts[1]][parts[2]] == value ? "enum:" + parts[1] + "." + parts[2] : null;
    }
    function specifier(value) {
        try {
            if (value.typename === "Document") { return "object:/document[@id=" + value.id + "]"; }
            if (value.typename !== "ArtLayer" && value.typename !== "LayerSet") { return null; }
            var owner = value.parent;
            while (owner.typename !== "Document") { owner = owner.parent; }
            return "object:/document[@id=" + owner.id + "]/layer[@id=" + value.id + "]";
        } catch (error) { return "unreadable:" + error.message; }
    }
    function resolve(path) {
        var parts = SPECIFIER.exec(path);
        if (!parts) { throw new Error("object:" + path + " names no document or layer"); }
        var doc = null;
        for (var i = 0; i < realApp.documents.length && doc === null; i++) { if (realApp.documents[i].id === Number(parts[1])) { doc = realApp.documents[i]; } }
        if (doc === null || parts[2] === undefined || parts[2] === "") { return doc; }
        function found(list) {
            for (var j = 0; j < list.length; j++) {
                if (list[j].id === Number(parts[2])) { return list[j]; }
                if (list[j].typename === "LayerSet") { var inner = found(list[j].layers); if (inner !== null) { return inner; } }
            }
            return null;
        }
        return found(doc.layers);
    }
    var codec = shared.codec({
        named: function (value) { return enumerator(value) || specifier(value); },
        plain: function (value) { return value instanceof UnitValue ? { value: value.value, type: value.type } : action(value); },
        located: resolve
    });

    // --- [SHADOWS]
    function moved(session, Kind, path) {
        var made = arguments.length < 3 ? new Kind() : new Kind(path);
        var name = made.fsName;
        if (made.exists || name === session.folder || name.indexOf(session.folder + "/") === 0) { return made; }
        var inside = new Kind(session.folder + "/outside" + name);
        ensured(inside.parent);
        return inside;
    }
    function rooted(session, Kind) {
        function Shadow(path) { return arguments.length ? moved(session, Kind, path) : moved(session, Kind); }
        Shadow.prototype = Kind.prototype;
        shared.statics(Shadow, Kind, {}, false);
        if (Kind === RealFolder) { Shadow.watch("current", function (key, previous, next) { RealFolder.current = next; return RealFolder.current; }); }
        return Shadow;
    }
    function acted(session) {
        return function (event, descriptor, mode) {
            var name = typeIDToStringID(event);
            if (shared.holds(EVENTS, name)) { session.record.activations.push("executeAction " + name); return new ActionDescriptor(); }
            if (mode !== undefined && mode !== DialogModes.NO) { session.record.activations.push("executeAction " + name + " " + String(mode) + " sent as DialogModes.NO"); }
            var result = realExecute(event, descriptor === undefined ? new ActionDescriptor() : descriptor, DialogModes.NO);
            session.refresh();
            return result;
        };
    }
    function built(session) {
        function Shadow() {
            var names = [];
            for (var i = 0; i < arguments.length - 1; i++) { names.push(arguments[i]); }
            return session.evaluate("(function (" + names.join(",") + ") {\n" + (arguments.length ? arguments[arguments.length - 1] : "") + "\n})");
        }
        Shadow.prototype = RealFunction.prototype;
        return Shadow;
    }
    function fakeDocuments(session, real) {
        var list = { typename: real.typename, parent: real.parent };
        function sync() {
            for (var i = 0; i < list.length; i++) { delete list[i]; }
            list.length = real.length;
            for (var j = 0; j < real.length; j++) { list[j] = real[j]; }
        }
        list.add = function () { var made = real.add.apply(real, arguments); session.refresh(); return made; };
        list.getByName = function (name) { return real.getByName(name); };
        list.sync = sync;
        sync();
        return list;
    }
    function custom(key) {
        try { return realApp.getCustomOptions(key); } catch (absent) { return null; }
    }
    function optioned(session, method) {
        return function (key, descriptor, persistent) {
            if (!has(session.options, key)) { session.options[key] = { prior: custom(key), persistent: false }; }
            if (persistent === true) { session.options[key].persistent = true; }
            return realApp[method].apply(realApp, arguments);
        };
    }
    function fakeApp(session, found, executed) {
        var fake = {};
        var writable = [];
        var documents = fakeDocuments(session, realApp.documents);
        function held(key, previous, next) {
            session.record.writes.push({ member: key, before: codec.kept(previous), after: codec.kept(next) });
            session.record.activations.push(key + " " + String(next) + " held at " + String(previous));
            return previous;
        }
        function forwarded(key, previous, next) {
            realApp[key] = next;
            session.refresh(key);
            return realApp[key];
        }
        function refresh(except) {
            for (var i = 0; i < writable.length; i++) {
                if (writable[i] === except) { continue; }
                fake.unwatch(writable[i]);
                try { fake[writable[i]] = realApp[writable[i]]; } catch (error) { delete fake[writable[i]]; }
                fake.watch(writable[i], shared.holds(HELD, writable[i]) ? held : forwarded);
            }
            documents.sync();
        }
        function progressing(name) {
            return function () {
                session.record.activations.push(name);
                return session.evaluate(String(arguments[arguments.length - 1]));
            };
        }
        var own = {
            documents: documents,
            executeAction: executed,
            open: function () { var made = realApp.open.apply(realApp, arguments); refresh(); return made; },
            openDialog: function () { return shared.picked(session, "open", RealFile, true); },
            updateProgress: function () { return true; },
            changeProgressText: function () {}
        };
        var r;
        for (r = 0; r < REFUSED.length; r++) { if (has(found.methods, REFUSED[r])) { own[REFUSED[r]] = shared.refusing(session, REFUSED[r]); } }
        for (r = 0; r < PROGRESS.length; r++) { if (has(found.methods, PROGRESS[r])) { own[PROGRESS[r]] = progressing(PROGRESS[r]); } }
        for (r = 0; r < OPTIONS.length; r++) { if (has(found.methods, OPTIONS[r])) { own[OPTIONS[r]] = optioned(session, OPTIONS[r]); } }
        for (var name in found.properties) {
            if (!has(found.properties, name) || name === "__proto__" || has(own, name)) { continue; }
            if (found.properties[name] === "readwrite") { writable.push(name); continue; }
            try { fake[name] = realApp[name]; } catch (error) { continue; }
        }
        for (var method in found.methods) {
            if (!has(found.methods, method) || has(own, method)) { continue; }
            fake[method] = (function (called) { return function () { var result = realApp[called].apply(realApp, arguments); refresh(); return result; }; })(method);
        }
        for (var key in own) { if (has(own, key)) { fake[key] = own[key]; } }
        session.refresh = refresh;
        refresh();
        return fake;
    }
    function scope(session, found, item) {
        var executed = acted(session);
        var Fake = shared.windows(session, shared.notified);
        var shadows = { Window: Fake, alert: Fake.alert, confirm: Fake.confirm, prompt: Fake.prompt, BridgeTalk: shared.bridgeTalk(session), executeAction: executed, Function: built(session), File: rooted(session, RealFile), Folder: rooted(session, RealFolder) };
        shadows.app = fakeApp(session, found, executed);
        var global = shared.scope(session, item, shadows);
        var names = [];
        var values = [];
        for (var key in shadows) {
            if (!has(shadows, key)) { continue; }
            names.push(key);
            values.push(shadows[key]);
        }
        var scoped = RealFunction.apply(null, names.concat(["doc", "made", "harnessCase", "harnessSource", "return eval(harnessSource);"]));
        var context = [undefined, {}, null];
        session.shadows = shadows;
        session.evaluate = function (code, doc, made, held) {
            if (arguments.length > 1) { context = [doc, made, held]; }
            return scoped.apply(global, values.concat(context, [code]));
        };
    }
    function redirected(session) {
        function opening(mode) {
            var name = this.fsName;
            if (/^[wae]/.test(String(mode)) && name.indexOf(session.folder + "/") !== 0) {
                this.changePath(session.folder + "/outside" + name);
                ensured(this.parent);
            }
            return realOpen.apply(this, arguments);
        }
        var release = shared.patched(session);
        RealFile.prototype.open = opening;
        return function () { RealFile.prototype.open = realOpen; release(); };
    }

    // --- [STATE]
    function wholeOf(descriptor, whole) {
        var text = {};
        for (var key in whole) { if (has(whole, key) && key !== "_obj") { text[key] = codec.json(whole[key]); } }
        return { descriptor: descriptor, whole: whole, text: text };
    }
    function described(reference) {
        var descriptor = executeActionGet(reference);
        return wholeOf(descriptor, parsedJson(converted(descriptor)));
    }
    function application() {
        var reference = new ActionReference();
        reference.putEnumerated(id("application"), id("ordinal"), id("targetEnum"));
        return described(reference);
    }
    function treeOf(doc) {
        var reference = new ActionReference();
        reference.putProperty(id("property"), id("json"));
        reference.putIdentifier(id("document"), doc);
        var descriptor = new ActionDescriptor();
        descriptor.putReference(id("null"), reference);
        descriptor.putBoolean(id("getPathData"), true);
        var answer = realExecute(id("get"), descriptor, DialogModes.NO);
        return wholeOf(answer, parsedJson(answer.getString(id("json"))));
    }
    function layersOf(doc) {
        var ids = [];
        function walk(list) {
            for (var i = 0; i < list.length; i++) {
                ids.push(list[i].id);
                if (list[i].typename === "LayerSet") { walk(list[i].layers); }
            }
        }
        walk(doc.layers);
        return ids;
    }
    function targets(ids) {
        var rows = {};
        for (var i = 0; i < ids.length; i++) {
            var doc = resolve("/document[@id=" + ids[i] + "]");
            if (doc === null) { continue; }
            var prefix = "object:/document[@id=" + ids[i] + "]";
            var reference = new ActionReference();
            reference.putIdentifier(id("document"), ids[i]);
            rows[prefix] = described(reference);
            rows[prefix + "/json"] = treeOf(ids[i]);
            for (var p = 0; p < PARTS.length; p++) {
                var count = rows[prefix].whole[PARTS[p][1]] || 0;
                for (var n = 1; n <= count; n++) {
                    var part = new ActionReference();
                    part.putIndex(id(PARTS[p][0]), n);
                    part.putIdentifier(id("document"), ids[i]);
                    rows[prefix + "/" + PARTS[p][0] + "[" + n + "]"] = described(part);
                }
            }
            var layers = layersOf(doc);
            for (var j = 0; j < layers.length; j++) {
                var layer = new ActionReference();
                layer.putIdentifier(id("layer"), layers[j]);
                layer.putIdentifier(id("document"), ids[i]);
                rows[prefix + "/layer[@id=" + layers[j] + "]"] = described(layer);
            }
        }
        return rows;
    }
    function differing(before, after, shifting) {
        var keys = {};
        var rows = [];
        var key;
        for (key in before.text) { if (has(before.text, key)) { keys[key] = true; } }
        for (key in after.text) { if (has(after.text, key)) { keys[key] = true; } }
        for (key in keys) { if (has(keys, key) && !has(shifting, key) && before.text[key] !== after.text[key]) { rows.push(key); } }
        return rows;
    }
    function changed(before, after, shifting, target) {
        var rows = [];
        var keys = differing(before, after, shifting);
        for (var i = 0; i < keys.length; i++) {
            var row = target === undefined ? {} : { target: target };
            row.member = keys[i];
            if (has(before.whole, keys[i])) { row.before = before.whole[keys[i]]; }
            row.after = has(after.whole, keys[i]) ? after.whole[keys[i]] : { $: "undefined" };
            rows.push(row);
        }
        return rows;
    }
    function edited(before, after, saving) {
        var rows = [];
        var key;
        for (key in before) { if (has(before, key)) { rows = rows.concat(has(after, key) ? changed(before[key], after[key], saving, key) : [{ target: key, member: String(before[key].whole._obj), before: before[key].whole, after: { $: "undefined" } }]); } }
        for (key in after) { if (has(after, key) && !has(before, key)) { rows.push({ target: key, member: String(after[key].whole._obj), after: after[key].whole }); } }
        return rows;
    }
    function restorable(snapshot, key) {
        var typed = key.charAt(0) === "$" ? charIDToTypeID(key.slice(1)) : id(key);
        return snapshot.descriptor.hasKey(typed) && snapshot.descriptor.getType(typed) === DescValueType.OBJECTTYPE ? typed : null;
    }
    function restored(initial, shifting) {
        var keys = differing(initial, application(), shifting);
        var refusals = {};
        for (var i = 0; i < keys.length; i++) {
            var key = restorable(initial, keys[i]);
            if (key === null) { continue; }
            var reference = new ActionReference();
            reference.putProperty(id("property"), key);
            reference.putEnumerated(id("application"), id("ordinal"), id("targetEnum"));
            var target = new ActionDescriptor();
            target.putReference(id("null"), reference);
            target.putObject(id("to"), initial.descriptor.getObjectType(key), initial.descriptor.getObjectValue(key));
            try { realExecute(id("set"), target, DialogModes.NO); } catch (refused) { refusals[keys[i]] = String(refused.message); }
        }
        var left = differing(initial, application(), shifting);
        var leaked = [];
        for (var j = 0; j < left.length; j++) { if (restorable(initial, left[j]) !== null) { leaked.push(has(refusals, left[j]) ? left[j] + ": " + refusals[left[j]] : left[j]); } }
        return leaked;
    }
    function optionsRestored(session) {
        for (var key in session.options) {
            if (!has(session.options, key)) { continue; }
            var held = session.options[key];
            var after = custom(key);
            var row = { target: "customOptions", member: key };
            if (held.prior !== null) { row.before = action(held.prior); }
            row.after = after === null ? { $: "undefined" } : action(after);
            session.record.writes.push(row);
            if (held.prior !== null) { realApp.putCustomOptions(key, held.prior, held.persistent); } else if (after !== null) { realApp.eraseCustomOptions(key); }
        }
    }
    function open() {
        var ids = {};
        for (var i = 0; i < realApp.documents.length; i++) { ids[realApp.documents[i].id] = realApp.documents[i]; }
        return ids;
    }
    function logged(text) {
        var entries = [];
        var lines = text.split(/\r\n|\r|\n/);
        var entry = null;
        for (var i = 0; i < lines.length; i++) {
            var parts = LOGGED.exec(lines[i]);
            if (!parts) { continue; }
            if (parts[1] === "Version") {
                entry = { version: parts[3], id: "", code: "", message: "", frames: [] };
                entries.push(entry);
            } else if (entry !== null && parts[1] === "Stack") {
                var stack = parsedJson(parts[3]);
                for (var j = 0; j < stack.offsets.length; j++) {
                    for (var module in stack.offsets[j]) {
                        if (!has(stack.offsets[j], module)) { continue; }
                        for (var k = 0; k < stack.offsets[j][module].length; k++) { entry.frames.push(module + " +0x" + stack.offsets[j][module][k].toString(16)); }
                    }
                }
            } else if (entry !== null) {
                entry.id = parts[1];
                entry.code = parts[2];
                entry.message = parts[3];
            }
        }
        return entries;
    }

    // --- [PRECONDITION]
    function evaluated(session, expression, doc, made, statement) { return session.evaluate(statement ? expression : "(" + expression + "\n)", doc, made, null); }
    function agrees(read, asked) {
        if (typeof asked === "number") { return Math.abs(Number(read) - asked) * GRID <= Math.max(1, Math.abs(asked)); }
        var parts = ENUMERATOR.exec(String(asked));
        return parts ? String(read).split(".").pop() === parts[2] : String(read) === String(asked);
    }
    function newDocument(row, name, at) {
        var asked = codec.revive(row.arguments);
        var doc = realApp.documents.add(asked.width, asked.height, asked.resolution, name, asked.mode, asked.initialFill, asked.pixelAspectRatio, asked.bitsPerChannel, asked.colorProfileName);
        for (var key in asked) {
            if (has(asked, key) && key in doc && !agrees(doc[key], asked[key])) { throw new Error("documents[" + at + "] " + key + " reads " + String(doc[key]) + ", asked " + String(asked[key])); }
        }
        return doc;
    }
    function opened(item, batch, index) {
        var condition = item.precondition;
        var docs = [];
        var flags = condition.features || {};
        var fonts = condition.fonts || [];
        var missing = [];
        for (var flag in flags) { if (has(flags, flag) && realApp.featureEnabled(flag) !== flags[flag]) { throw new Error("feature " + flag + " reads " + !flags[flag]); } }
        for (var f = 0; f < fonts.length; f++) { try { realApp.fonts.getByName(fonts[f]); } catch (absent) { missing.push(fonts[f]); } }
        if (missing.length) { throw new Error("fonts not installed: " + missing.join(", ")); }
        for (var i = 0; i < condition.documents.length; i++) {
            var row = condition.documents[i];
            docs.push(row._tag === "Opened" ? realApp.open(new RealFile(row.open)) : newDocument(row, batch.label + "-" + index + "-" + i, i));
        }
        if (docs.length > 1) { realApp.activeDocument = docs[0]; }
        return docs;
    }
    function selected(doc, chosen, evaluate) {
        var layers = chosen.layers || [];
        if (layers.length) {
            var reference = new ActionReference();
            for (var i = 0; i < layers.length; i++) { reference.putIdentifier(id("layer"), evaluate(layers[i]).id); }
            var target = new ActionDescriptor();
            target.putReference(id("null"), reference);
            target.putBoolean(id("makeVisible"), false);
            realExecute(id("select"), target, DialogModes.NO);
        }
        if (chosen.region !== undefined) { doc.selection.select(chosen.region); }
    }
    function prepare(session, doc, condition, made) {
        function evaluate(expression) { return evaluated(session, expression, doc, made); }
        shared.prepared([
            ["set", condition.set, function (row) { shared.assign(row[0], row[1], evaluate, codec.revive); }],
            ["add", condition.add, function (row) {
                var item = evaluate(row.to)[row.kind].add();
                var properties = codec.revive(row.properties || {});
                for (var key in properties) { if (has(properties, key)) { item[key] = properties[key]; } }
                made[row.as] = item;
            }],
            ["steps", condition.steps, function (step) { evaluated(session, step, doc, made, true); }],
            ["select", condition.select === undefined ? [] : [condition.select], function (chosen) { selected(doc, chosen, evaluate); }]
        ]);
        session.refresh();
    }
    function histories(docs) {
        var counts = {};
        for (var i = 0; i < docs.length; i++) { counts[docs[i].id] = docs[i].historyStates.length; }
        return counts;
    }
    function added(counts) {
        var names = [];
        for (var key in counts) {
            if (!has(counts, key)) { continue; }
            var doc = resolve("/document[@id=" + key + "]");
            if (doc === null) { continue; }
            for (var i = doc.historyStates.length - 1; i >= counts[key]; i--) { names.push(doc.historyStates[i].name); }
        }
        return names;
    }

    // --- [RUN]
    function located(error, item) {
        var completion = shared.thrown(error);
        var file = error !== null && typeof error === "object" && typeof error.fileName === "string" && PATHED.test(error.fileName) ? new RealFile(error.fileName).fsName : "";
        var loaded = item._tag !== "Probe" && item.source !== undefined ? item.source.script : "";
        var at = file !== "" && file !== ENGINE ? file : loaded;
        if (at === "") { delete completion.line; } else if (has(completion, "line")) { completion.file = at; }
        return completion;
    }
    function ran(session, item, docs, made, result) {
        var folder = RealFolder.current;
        try {
            var value;
            if (item._tag === "Probe") {
                value = evaluated(session, item.evaluate, docs[0], made);
            } else {
                var script = item.source === undefined ? null : new RealFile(item.source.script);
                if (script !== null && !script.exists) { throw new Error("no script " + item.source.script); }
                if (script !== null) { session.shadows.Folder.current = script.parent; }
                var code = (script === null ? "" : item.source.code) + (item._tag === "Call" ? "\n;(" + item.call + "\n).apply(undefined, harnessCase.args)" : "");
                value = session.evaluate(code, docs[0], made, { script: script, args: codec.revive(item._tag === "Call" ? item.args : []) });
            }
            shared.palettes(session);
            if (item._tag !== "Run") { result.value = codec.kept(value); }
            return { _tag: "Ran" };
        } catch (error) {
            return located(error, item);
        } finally {
            session.shadows.Folder.current = folder;
        }
    }
    function outcome(item, batch, index, found, shift) {
        var session = shared.session(item, ["history", "errors"]);
        var result = shared.started(item);
        var leaked = [];
        var known = open();
        var held = { ruler: realApp.preferences.rulerUnits, type: realApp.preferences.typeUnits, colorSettings: realApp.colorSettings };
        var log = new RealFile(realApp.preferencesFolder.fsName + "/PSErrorLog.txt");
        var offset = Math.max(log.length, 0);
        var global = shared.globals();
        var initial = application();
        var release = function () {};
        var made = {};
        session.refresh = function () {};
        session.options = {};
        session.folder = new RealFolder(item.folder).fsName;
        try {
            scope(session, found, item);
            realApp.displayDialogs = DialogModes.NO;
