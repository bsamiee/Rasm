{
    "name": "@rasm/workers",
    "version": "0.1.0",
    "private": true,
    "description": "Cloudflare Workers entry module of an Effect program: one layer built once per isolate and projected into fetch, scheduled, and queue handlers, and a hosted app served as a Worker from its HOSTING binding, each binding it names decoded",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/runtime/workers"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./execution": "./execution.ts",
        "./serve": "./serve.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./execution": "./dist/execution.js",
            "./serve": "./dist/serve.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/telemetry": "workspace:*"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:",
        "@rasm/hosting": "workspace:*",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "@rasm/hosting": "workspace:^",
        "effect": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "@rasm/hosting": {
            "optional": true
        }
    },
    "engines": {
        "node": "^24.14.0 || >=25.4.0"
    }
}
