    "executors": "./eng/typescript/format/executors.json",
    "nx": {
        "targets": {
            "restore": {
                "options": { "args": [ "Workspace.slnx" ] },
                "inputs": [ "{workspaceRoot}/Workspace.slnx", "{workspaceRoot}/**/*.csproj", "dotnet" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/obj/*/project.assets.json", "{workspaceRoot}/.artifacts/dotnet/obj/*/*.nuget.*", "!{workspaceRoot}/.artifacts/dotnet/obj/*.cs/*", "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/restore.binlog" ]
            },
            "grammar": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [ "{workspaceRoot}/tools/ast-grep/grammars/**/grammar.js", { "externalDependencies": [ "@tree-sitter-grammars/tree-sitter-xml", "tree-sitter-sqlite3", "tree-sitter-swift" ] }, { "runtime": "tree-sitter --version" }, { "runtime": "node --version" } ],
                "outputs": [ "{workspaceRoot}/.cache/ast-grep/xml.so", "{workspaceRoot}/.cache/ast-grep/sql", "{workspaceRoot}/.cache/ast-grep/sql.so", "{workspaceRoot}/.cache/ast-grep/swift.so" ],
                "options": {
                    "commands": [
                        "tree-sitter build --output .cache/ast-grep/xml.so node_modules/@tree-sitter-grammars/tree-sitter-xml/xml",
                        "tree-sitter generate --output .cache/ast-grep/sql/src tools/ast-grep/grammars/sql/grammar.js",
                        "cp node_modules/tree-sitter-sqlite3/src/scanner.c .cache/ast-grep/sql/src/scanner.c",
                        "tree-sitter build --output .cache/ast-grep/sql.so .cache/ast-grep/sql",
                        "tree-sitter build --output .cache/ast-grep/swift.so node_modules/tree-sitter-swift"
                    ],
                    "parallel": false
                }
            },
            "rewrite": { "dependsOn": [ "grammar" ], "parallelism": false },
            "outline": {
                "command": "ast-grep outline --custom-languages allow --color never --outline-rules tools/ast-grep/outline/typescript.yml --outline-rules tools/ast-grep/outline/python.yml --outline-rules tools/ast-grep/outline/java.yml --outline-rules tools/ast-grep/outline/bash.yml --outline-rules tools/ast-grep/outline/rust.yml",
                "dependsOn": [ "grammar" ]
            },
            "lint:ast-grep": {
                "dependsOn": [ "grammar" ],
                "inputs": [
                    "pythonFiles",
                    "yamlFiles",
                    "javaFiles",
                    "rustFiles",
                    "{workspaceRoot}/**/*.{bash,bats,cgi,command,env,fcgi,ksh,sh,tmux,tool,zsh}",
                    "{workspaceRoot}/**/*.cs",
                    "{workspaceRoot}/**/*.{cjs,js,mjs,jsx}",
                    "{workspaceRoot}/**/*.{html,htm,xhtml}",
                    "{workspaceRoot}/**/*.{py3,bzl,bazel}",
                    "{workspaceRoot}/**/*.swift",
                    "{workspaceRoot}/**/*.{ts,tsx}",
                    "{workspaceRoot}/**/*.{xml,csproj,props,targets,slnx}",
                    "{workspaceRoot}/**/NuGet.config",
                    "{workspaceRoot}/**/*.sql",
                    { "externalDependencies": [] },
                    { "dependentTasksOutputFiles": "**/*.so" },
                    { "runtime": "ast-grep --version" }
                ]
            },
            "lint:biome": {
                "command": "biome check --error-on-warnings",
                "inputs": [ "{workspaceRoot}/.editorconfig", "{workspaceRoot}/**/.{gitignore,ignore}", "{workspaceRoot}/pnpm-workspace.yaml", "{workspaceRoot}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,html,vue,svelte,astro,svg,grit}", { "externalDependencies": [] }, { "runtime": "biome --version" } ]
            },
            "lint:ruff": {
                "executor": "nx:run-commands",
                "inputs": [ "pythonFiles", "{workspaceRoot}/**/*.{pyw,ipynb}", "{workspaceRoot}/**/pyproject.toml", { "externalDependencies": [] }, { "runtime": "ruff --version" } ],
                "options": { "commands": [ "ruff check", "ruff format --check" ] }
            },
            "lint:refurb": { "inputs": [ "python", "pythonFiles" ] },
            "lint:deptry": { "command": "deptry libs/python apps", "inputs": [ "python", "pythonFiles" ] },
            "lint:yamllint": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamllint --strict", "inputs": [ "yamlFiles", { "externalDependencies": [] }, { "runtime": "yamllint --version" } ] },
            "lint:yamlfmt": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamlfmt -lint", "inputs": [ "yamlFiles", { "externalDependencies": [] }, { "runtime": "yamlfmt -version" } ] },
            "lint:tombi": {
                "executor": "nx:run-commands",
                "inputs": [ "{workspaceRoot}/**/*.toml", { "externalDependencies": [] }, { "runtime": "tombi --version" } ],
                "options": { "commands": [ "tombi lint --error-on-warnings", "tombi format --check" ], "parallel": false }
            },
            "lint:actionlint": {
                "command": "actionlint",
                "inputs": [ "{workspaceRoot}/.github/actionlint.yaml", "{workspaceRoot}/.github/workflows/*.{yml,yaml}", "{workspaceRoot}/.github/actions/*/action.{yml,yaml}", { "externalDependencies": [] }, { "runtime": "actionlint --version" }, { "runtime": "shellcheck --version" } ]
            },
            "lint:google-java-format": { "command": "fd --hidden --extension java --exec-batch google-java-format --aosp --dry-run --set-exit-if-changed", "inputs": [ "javaFiles", { "externalDependencies": [] }, { "runtime": "google-java-format --version" } ] },
            "lint:pmd": {
                "executor": "nx:run-commands",
                "inputs": [ "javaFiles", "{workspaceRoot}/**/*.{py,swift}", "{workspaceRoot}/pmd.xml", { "externalDependencies": [] }, { "runtime": "pmd --version" }, { "env": "GHIDRA_INSTALL_DIR" } ],
                "outputs": [ "{workspaceRoot}/.cache/pmd/java" ],
                "options": {
                    "commands": [
                        {
                            "command": "fd --hidden --extension java --exec-batch pmd check --rulesets pmd.xml --cache .cache/pmd/java --aux-classpath \"$JAVA_HOME/lib/jrt-fs.jar:$(fd --type f --full-path --glob '**/lib/*.jar' --absolute-path \"$GHIDRA_INSTALL_DIR/Ghidra\" | paste -sd: -)\" --no-progress",
                            "forwardAllArgs": false
                        },
                        "fd --hidden --extension java --exec-batch pmd cpd --language java",
                        "fd --hidden --extension py --exec-batch pmd cpd --language python",
                        "fd --hidden --extension swift --exec-batch pmd cpd --language swift"
                    ],
                    "args": [ "--minimum-tokens", "100" ]
                }
            },
            "lint:rustfmt": { "command": "cargo fmt --check", "inputs": [ "rustFiles", "{workspaceRoot}/**/Cargo.toml", "{workspaceRoot}/rustfmt.toml", "{workspaceRoot}/rust-toolchain.toml", { "externalDependencies": [] } ] },
            "lint:shfmt": { "command": "fd --hidden --extension sh --exec-batch shfmt -d --", "inputs": [ "{workspaceRoot}/**/*.sh", "{workspaceRoot}/**/.editorconfig", { "externalDependencies": [] }, { "runtime": "shfmt --version" } ] },
            "lint:shellcheck": { "command": "fd --hidden --extension sh --exec-batch shellcheck --", "inputs": [ "{workspaceRoot}/**/*.sh", { "externalDependencies": [] }, { "runtime": "shellcheck --version" } ] },
            "lint:swift-format": { "command": "fd --hidden --extension swift --exec-batch xcrun swift-format lint --strict --parallel", "inputs": [ "{workspaceRoot}/**/*.swift", "{workspaceRoot}/.swift-format", { "externalDependencies": [] }, { "runtime": "xcrun swift-format --version" } ] },
            "lint:swiftlint": { "command": "fd --hidden --extension swift --exec-batch swiftlint lint --quiet", "inputs": [ "{workspaceRoot}/**/*.swift", "{workspaceRoot}/.swiftlint.yml", { "externalDependencies": [] }, { "runtime": "swiftlint version" } ] },
            "lint:dotnet-format": {
                "options": { "args": [ "Workspace.slnx", "--no-restore", "--verify-no-changes" ] },
                "dependsOn": [ "...", "restore" ],
                "inputs": [ "dotnet", "{workspaceRoot}/.editorconfig", "{workspaceRoot}/Workspace.slnx", "{workspaceRoot}/**/*.{cs,csproj}" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/lint-dotnet-format.binlog" ]
            },
            "lint": { "dependsOn": [ "lint:*" ] },
            "format": { "executor": "./:format", "parallelism": false, "dependsOn": [ "format:dotnet-format", { "projects": [ "tag:language:dotnet" ], "target": "format" } ] },
            "format:files": { "executor": "./:format" },
            "format:biome": { "command": "biome check --write --error-on-warnings --no-errors-on-unmatched", "metadata": { "extensions": null } },
            "format:ruff": { "executor": "nx:run-commands", "options": { "commands": [ "ruff check --fix", "ruff format" ], "parallel": false }, "metadata": { "extensions": [ ".py", ".pyi", ".pyw", ".ipynb" ] } },
            "format:yamlfmt": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamlfmt", "configurations": { "files": { "command": "yamlfmt" } }, "metadata": { "extensions": [ ".yaml", ".yml" ] } },
            "format:tombi": { "command": "tombi format", "metadata": { "extensions": [ ".toml" ] } },
            "format:google-java-format": { "command": "fd --hidden --extension java --exec-batch google-java-format --aosp --replace", "configurations": { "files": { "command": "google-java-format --aosp --replace" } }, "metadata": { "extensions": [ ".java" ] } },
            "format:swiftlint": { "command": "fd --hidden --extension swift --exec-batch swiftlint lint --fix --quiet", "configurations": { "files": { "command": "swiftlint lint --fix --quiet" } }, "metadata": { "extensions": [ ".swift" ] } },
            "format:swift-format": { "command": "fd --hidden --extension swift --exec-batch xcrun swift-format format --in-place --parallel", "configurations": { "files": { "command": "xcrun swift-format format --in-place --parallel" } }, "metadata": { "extensions": [ ".swift" ] } },
            "format:xcprojformatter": { "command": "fd --hidden --glob project.xcproj --exec xcrun xcprojformatter --update", "configurations": { "files": { "command": "find {args} -exec xcrun xcprojformatter --update {} ';'" } }, "metadata": { "extensions": [ ".xcproj" ] } },
            "format:shfmt": { "command": "fd --hidden --extension sh --exec-batch shfmt -w --", "configurations": { "files": { "command": "shfmt -w --" } }, "metadata": { "extensions": [ ".sh" ] } },
            "format:rustfmt": { "command": "cargo fmt", "configurations": { "files": { "command": "rustfmt" } }, "metadata": { "extensions": [ ".rs" ] } },
            "format:dotnet-format": { "options": { "args": [ "Workspace.slnx", "--no-restore" ] }, "dependsOn": [ "...", "restore" ], "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/format-dotnet-format.binlog" ] },
            "typecheck:tsc": {
                "command": "tsc --pretty false",
                "inputs": [ "typescript", "^default", "{workspaceRoot}/**/*.{ts,json}" ]
            },
            "typecheck:ty": { "inputs": [ "python", "pythonFiles" ], "options": { "env": { "TY_UV": "1", "UV_LOCKED": "1" } } },
            "typecheck:mypy": { "inputs": [ "python", "pythonFiles" ] },
            "typecheck:javac": {
                "command": "fd --hidden --extension java --exec-batch javac -Xlint:all,-path -Werror -proc:none -d .cache/javac -cp \"$(fd --type f --full-path --glob '**/lib/*.jar' --absolute-path \"$GHIDRA_INSTALL_DIR/Ghidra\" | paste -sd: -)\"",
                "inputs": [ "javaFiles", { "externalDependencies": [] }, { "env": "JAVA_HOME" }, { "env": "GHIDRA_INSTALL_DIR" } ],
                "outputs": [ "{workspaceRoot}/.cache/javac" ]
            },
            "typecheck": { "dependsOn": [ "typecheck:*" ] },
            "check": { "dependsOn": [ "lint", "typecheck" ] },
            "infra": {
                "command": "doppler run --project agent-runtime --config dev --only-secrets GITHUB_TOKEN --no-fallback --attempts 1 -- node infra/main.ts repository",
                "parallelism": false,
                "configurations": { "preview": { "args": "preview" }, "up": { "args": "up" }, "refresh": { "args": "refresh" } }
            },
            "hosting": { "command": "doppler run --project agent-runtime --config dev --only-secrets CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID,OWNER_EMAIL --no-exit-on-missing-only-secrets --no-fallback --attempts 1 -- node infra/main.ts hosting", "parallelism": false },
            "clean": { "command": "node eng/typescript/cleanup/main.ts", "parallelism": false },
            "docker": { "command": "mise daemons start docker" },
            "upgrade": { "command": "node eng/typescript/upgrade/main.ts", "dependsOn": [ "upgrade:*", { "projects": [ "tag:language:rust" ], "target": "upgrade:cargo" }, { "projects": [ "tag:build:swiftpm" ], "target": "upgrade" } ] },
            "upgrade:actions": { "command": "actions-up --yes --style preserve --min-age 0" },
            "upgrade:docker": { "command": "mise run docker:update" },
            "upgrade:dotnet": { "command": "dotnet run --project eng/dotnet/Rasm.Upgrade -- Directory.Packages.props" },
            "upgrade:python": { "executor": "nx:run-commands", "options": { "commands": [ "pixi update", "pixi run --locked -e hdf5 pixi run --locked -e default uv sync --upgrade" ], "parallel": false } },
            "upgrade:rust": { "executor": "nx:run-commands", "options": { "commands": [ "cargo upgrade --incompatible", "cargo update", "tombi format Cargo.toml" ], "parallel": false } },
            "upgrade:swift": { "command": "node eng/typescript/upgrade/swift.ts", "dependsOn": [ "grammar" ] },
            "upgrade:xcode": {
                "dependsOn": [ "upgrade:swift" ],
                "executor": "nx:run-commands",
                "options": {
                    "commands": [
                        "rm -f Workspace.xcworkspace/xcshareddata/swiftpm/Package.resolved .cache/xcode/Workspace/SourcePackages/workspace-state.json",
                        "xcodebuild -resolvePackageDependencies -workspace Workspace.xcworkspace -scheme \"$(yq -p xml -oy '[.Workspace.FileRef] | flatten | .[0].\"+@location\" | sub(\".*/(.*)\\.xcodeproj\", \"${1}\")' Workspace.xcworkspace/contents.xcworkspacedata)\" -derivedDataPath .cache/xcode/Workspace"
                    ],
                    "parallel": false
                }
            },
            "upgrade:typescript": {
                "executor": "nx:run-commands",
                "parallelism": false,
                "options": { "commands": [ "ncu --workspaces --target newest --upgrade --install never --reject typescript,tree-sitter-swift", "node eng/typescript/upgrade/typescript.ts", "pnpm install" ], "parallel": false }
            }
        }
    }
}
