<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="local" value=".artifacts/nuget" />
    </packageSources>
    <!-- Every NuGet client restores into one workspace folder, the setup action caches it keyed on the files that decide the package set -->
    <config>
        <add key="globalPackagesFolder" value=".cache/nuget/packages" />
    </config>
    <disabledPackageSources>
        <clear />
    </disabledPackageSources>
    <!-- Rasm.* ids restore from the local feed, every other id from nuget.org -->
    <packageSourceMapping>
        <clear />
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="local">
            <package pattern="Rasm.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
