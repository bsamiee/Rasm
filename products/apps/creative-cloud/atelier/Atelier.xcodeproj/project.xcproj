{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "app.xcconfig" },
    { "name": "Release", "file": "app.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "../../../..",
    },
  ],
  "files": [
    { "path": "../../../../.artifacts/vite/@rasm/atelier/server", "target-membership": [ "Atelier/copy/Embed Server" ] },
    { "path": "../../../../.artifacts/vite/@rasm/atelier/tsc", "target-membership": [ { "build-phase": "Atelier/copy/Embed Server", "code-sign-on-copy": true } ] },
    { "path": "../../../../.artifacts/vite/@rasm/atelier/typescript/lib.d.ts", "target-membership": [ "Atelier/resources" ] },
    { "path": "<PROJECT>/../../../../.config/app.xcconfig" },
    { "path": "AppIcon.icon", "target-membership": [ "Atelier/resources" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Atelier.app", "id": "DF819D1F3089FBAF00B8A072", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Atelier",
      "id": "DF819D1E3089FBAF00B8A072",
      "product": "Products/Atelier.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Server",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        }, {
          "kind": "script",
          "name": "Sign Server",
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(CONTENTS_FOLDER_PATH)/Helpers/server",
            "$(SRCROOT)/$(CODE_SIGN_ENTITLEMENTS)",
          ],
          "output-paths": [
            "$(DERIVED_FILE_DIR)/server.entitlements",
            "$(TARGET_BUILD_DIR)/$(CONTENTS_FOLDER_PATH)/Library/LaunchAgents/$(PRODUCT_BUNDLE_IDENTIFIER).server.plist",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -eu",
            "label=\"$PRODUCT_BUNDLE_IDENTIFIER.server\"",
            "plutil -convert xml1 -o \"$SCRIPT_OUTPUT_FILE_0\" \"$SCRIPT_INPUT_FILE_1\"",
            "plutil -insert 'com\\.apple\\.security\\.cs\\.allow-jit' -bool YES \"$SCRIPT_OUTPUT_FILE_0\"",
            "codesign --force --sign \"$EXPANDED_CODE_SIGN_IDENTITY\" --identifier \"$label\" --options runtime --entitlements \"$SCRIPT_OUTPUT_FILE_0\" \"$SCRIPT_INPUT_FILE_0\"",
            "mkdir -p \"${SCRIPT_OUTPUT_FILE_1%/*}\"",
            "printf '{\"Label\":\"%s\",\"ProcessType\":\"Interactive\",\"KeepAlive\":true,\"ExitTimeOut\":30,\"Sockets\":{\"Listeners\":{\"SockNodeName\":\"localhost\",\"SockServiceName\":7490}},\"BundleProgram\":\"Contents/Helpers/server\",\"SpawnConstraint\":{\"signing-identifier\":\"%s\",\"team-identifier\":\"%s\"}}' \"$label\" \"$label\" \"$DEVELOPMENT_TEAM\" | plutil -convert xml1 -o \"$SCRIPT_OUTPUT_FILE_1\" -",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Link Compiler Library",
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/lib.d.ts",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(CONTENTS_FOLDER_PATH)/Helpers/lib.d.ts",
          ],
          "shell": "/bin/sh",
          "script": "ln -sfh ../Resources/lib.d.ts \"$SCRIPT_OUTPUT_FILE_0\"",
        },
      ],
      "package-product-members": [
        {
          "package": "..",
          "product-name": "Atelier",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "AUTOMATION_APPLE_EVENTS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Atelier.entitlements",
        "INFOPLIST_FILE": "Info.plist",
        "INFOPLIST_KEY_LSBackgroundOnly": "YES",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Atelier runs scripting commands in Adobe apps when an MCP client requests them.",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.rasm.atelier",
      },
    },
  ],
  "build-settings": {
    "MARKETING_VERSION": "0.1.0",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
