{
    "name": "@rasm/nx-playwright",
    "version": "0.1.0",
    "description": "Nx plugin inferring a Playwright test target per Playwright configuration, depending on Nx tasks its webServer rows start",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "products/developer/nx/playwright"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "imports": {
        "#/*.json": "./*.json",
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./plugin.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*.json": "./*.json",
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/plugin.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-distribution": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "@playwright/test": "catalog:peers",
        "nx": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
