{
    // --- [FILES] -----------------------------------------------------------------------

    // --- [ASSOCIATIONS]

    "files.associations": {
        "*.aepx": "xml",
        "*.entitlements": "xml",
        "*.ghx": "xml",
        "*.globalconfig": "properties",
        "*.gltf": "json",
        "*.cppm": "cpp",
        "*.idms": "xml",
        "*.ips": "jsonl",
        "*.ixx": "cpp",
        "*.rhw": "xml",
        "*.rui": "xml",
        "*.uplugin": "json",
        "*.uproject": "json",
        "*.xcscheme": "xml",
        "*.xfdf": "xml",
        "*.xmp": "xml",
        "Package.resolved": "json",
        "pixi.lock": "yaml",
        "project.xcproj": "jsonc"
    },

    // --- [ICONS]

    "material-icon-theme.files.associations": {
        "*.entitlements": "xml",
        "*.gh": "3d",
        "*.ghz": "3d",
        "*.globalconfig": "editorconfig",
        "*.ips": "log",
        "*.uasset": "3d",
        "*.umap": "3d",
        "*.xcconfig": "settings",
        "Package.resolved": "lock",
        "project.xcproj": "swift"
    },

    // --- [NESTING]

    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.csproj": "AnalyzerReleases.*.md, packages*.lock.json",
        "*.py": "${capture}.py.lock",
        ".clang-tidy": ".clang-format, gersemi.yaml",
        ".gitignore": ".gitattributes, .gitmodules",
        "Cargo.toml": "build.rs, Cargo.lock, rust-toolchain.toml",
        "CLAUDE.md": "AGENTS.md",
        "clippy.toml": "nextest.toml, rustfmt.toml",
        "CMakeLists.txt": "*.cmake, CMakePresets.json, vcpkg.json",
        "Directory.Build.props": "Directory.Build.targets, Directory.Packages.props, global.json, NuGet.config, Workspace.slnx",
        "hk.pkl": ".globalconfig, jscpd.json, knip.json, pmd.xml, shellcheckrc, squawk.toml, yamllint.yaml",
        "Info.plist": "*.entitlements",
        "mise.toml": "mise.lock",
        "nx.json": ".editorconfig, sgconfig.yml",
        "package.json": "*.config.ts, .oxfmtrc.json, .oxlintrc.json, executors.json, pnpm-lock.yaml, pnpm-workspace.yaml, tsconfig*.json",
        "Package.swift": "Package.resolved, Xcode.xcconfig",
        "pyproject.toml": "hatch_build.py, pixi.lock, uv.lock",
        "README.md": "LICENSE, TODO*.md",
        "swiftlint.yml": "swift-format.json"
    },

    // --- [WATCHING]

    "files.watcherExclude": {
        ".artifacts": true,
        ".cache": true,
        ".cargo/rustc-source": true,
        ".nx": true,
        ".pixi": true,
        "docs/research": true,
        "**/.archive/**": true,
        "**/.build/**": true,
        "**/.cloudflare/**": true,
        "**/.mypy_cache/**": true,
        "**/.swiftpm/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/__traces__/**": true,
        "**/coverage/**": true,
        "**/dist/**": true,
        "**/node_modules/**": true,
        "**/xcuserdata/**": true
    },

    // --- [WORKBENCH] -------------------------------------------------------------------

    // --- [EDITOR]

    "chat.disableAIFeatures": true,
    "problems.showCurrentInStatus": true,

    // --- [SOURCE_CONTROL]

    "git.autoRepositoryDetection": false,

    // --- [VISIBILITY]

    "explorer.compactFolders": false,
    "files.exclude": {
        ".artifacts": true,
        ".cache": true,
        ".cargo/rustc-source": true,
        ".nx": true,
        ".pixi": true,
        "**/.build": true,
        "**/.cloudflare": true,
        "**/.swiftpm": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/xcuserdata": true
    },
    "search.experimental.useIgnoreFilesInFindFiles": true,
    "search.followSymlinks": false,

    // --- [CLANGD] ----------------------------------------------------------------------

    "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/.artifacts/cmake/default", "--clang-tidy=false", "--fallback-style=none"],

    // --- [CMAKE] -----------------------------------------------------------------------

    "cmake.configureOnEdit": false,
    "cmake.configureOnOpen": false,
    "cmake.sourceDirectory": "${workspaceFolder}/tools/ast-grep/grammars",

    // --- [DOTNET] ----------------------------------------------------------------------

    "csharp.suppressBuildAssetsNotification": true,
    "dotnet.codeLens.enableReferencesCodeLens": false,
    "dotnet.defaultSolution": "Workspace.slnx",
    "dotnet.diagnostics.reportInformationAsHint": false,
    "dotnet.projects.enableAutomaticRestore": false,
    "dotnet.server.useServerGC": false,

    // --- [ESLINT] ----------------------------------------------------------------------

    "eslint.validate": ["json"],

    // --- [JAVA] ------------------------------------------------------------------------

    "java.configuration.runtimes": [{ "default": true, "name": "JavaSE-27", "path": "${JAVA_HOME}" }],
    "java.import.exclusions": ["**/.cache/**", "**/.metadata/**", "**/archetype-resources/**", "**/META-INF/maven/**", "**/node_modules/**"],
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": false,
    "java.project.referencedLibraries": ["${GHIDRA_INSTALL_DIR}/Ghidra/**/lib/*.jar"],
    "java.project.resourceFilters": ["node_modules", "research", "rustc-source", "\\.(artifacts|build|cache|cloudflare|git|pixi|swiftpm|venv)"],
    "java.project.sourcePaths": [".claude/skills/use-ghidra/scripts"],

    // --- [JSON] ------------------------------------------------------------------------

    "json.schemas": [{ "fileMatch": ["**/*.xcodeproj/project.xcproj"], "schema": { "allowTrailingCommas": true } }],

    // --- [MISE] ------------------------------------------------------------------------

    "mise.enableCodeLens": false,
    "mise.enableConfigDiagnostics": false,
    "mise.notifyDaemonFailures": false,
    "mise.showDaemonsInStatusBar": false,

    // --- [PYTHON] ----------------------------------------------------------------------

    "ruff.configurationPreference": "filesystemFirst",
    "ty.experimental.useUv": "on",

    // --- [RUST] ------------------------------------------------------------------------

    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.checkOnSave": false,
    "rust-analyzer.rustc.source": "discover",
    "rust-analyzer.rustfmt.extraArgs": ["--config-path", "${workspaceFolder}/.config/rustfmt.toml"],

    // --- [SHELL] -----------------------------------------------------------------------

    "bashIde.backgroundAnalysisIgnore": ["**/.artifacts/**", "**/.cache/**", "**/.git/**", "**/.pixi/**", "**/.venv/**", "**/node_modules/**", "assets/**"],

    // --- [TYPESCRIPT] ------------------------------------------------------------------

    "css.lint.unknownAtRules": "ignore",
    "js/ts.experimental.useTsgo": true,
    "js/ts.trace.server": "off",
    "js/ts.tsdk.path": "./node_modules/@typescript/native",
    "js/ts.tsserver.automaticTypeAcquisition.enabled": false,

    // --- [YAML] ------------------------------------------------------------------------

    "yaml.format.enable": false
}
