    "nx": {
        "targets": {
            "restore": {
                "options": { "args": [ "Workspace.slnx" ] },
                "inputs": [ "{workspaceRoot}/Workspace.slnx", "{workspaceRoot}/**/*.csproj", "dotnet" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/obj/*/project.assets.json", "{workspaceRoot}/.artifacts/dotnet/obj/*/*.nuget.*", "!{workspaceRoot}/.artifacts/dotnet/obj/*.cs/*", "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/restore.binlog" ]
            },
            "grammar": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [ { "externalDependencies": [ "@tree-sitter-grammars/tree-sitter-xml", "tree-sitter-sqlite3", "tree-sitter-swift" ] }, { "runtime": "tree-sitter --version" } ],
                "outputs": [ "{workspaceRoot}/.cache/ast-grep/xml.so", "{workspaceRoot}/.cache/ast-grep/sql.so", "{workspaceRoot}/.cache/ast-grep/swift.so" ],
                "options": {
                    "commands": [ "tree-sitter build --output .cache/ast-grep/xml.so node_modules/@tree-sitter-grammars/tree-sitter-xml/xml", "tree-sitter build --output .cache/ast-grep/sql.so node_modules/tree-sitter-sqlite3", "tree-sitter build --output .cache/ast-grep/swift.so node_modules/tree-sitter-swift" ],
                    "parallel": false
                }
            },
            "rewrite": { "dependsOn": [ "grammar" ], "parallelism": false },
            "outline": {
                "command": "ast-grep outline --custom-languages allow --outline-rules tools/ast-grep/outline/typescript.yml --outline-rules tools/ast-grep/outline/javascript.yml --outline-rules tools/ast-grep/outline/python.yml --outline-rules tools/ast-grep/outline/java.yml --outline-rules tools/ast-grep/outline/bash.yml --outline-rules tools/ast-grep/outline/rust.yml",
                "options": { "env": { "NO_COLOR": "1" } },
                "dependsOn": [ "grammar" ]
            },
            "lint:ast-grep": {
                "cache": true,
                "dependsOn": [ "grammar" ],
                "inputs": [
                    "pythonFiles",
                    "yamlFiles",
                    "javaFiles",
                    "rustFiles",
                    "{workspaceRoot}/**/*.{bash,bats,cgi,command,env,fcgi,ksh,sh,tmux,tool,zsh}",
                    "{workspaceRoot}/**/*.cs",
                    "{workspaceRoot}/**/*.{cjs,js,mjs,jsx}",
                    "{workspaceRoot}/**/*.{html,htm,xhtml}",
                    "{workspaceRoot}/**/*.{py3,bzl,bazel}",
                    "{workspaceRoot}/**/*.swift",
                    "{workspaceRoot}/**/*.{ts,tsx}",
                    "{workspaceRoot}/**/*.{xml,csproj,props,targets,slnx}",
                    "{workspaceRoot}/**/NuGet.config",
                    "{workspaceRoot}/**/*.sql",
                    { "externalDependencies": [] },
                    { "dependentTasksOutputFiles": "**/*.so" },
                    { "runtime": "ast-grep --version" }
                ]
            },
            "lint:biome": {
                "command": "biome check --error-on-warnings",
                "cache": true,
                "inputs": [ "{workspaceRoot}/.editorconfig", "{workspaceRoot}/**/.{gitignore,ignore}", "{workspaceRoot}/pnpm-workspace.yaml", "{workspaceRoot}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,html,vue,svelte,astro,svg,grit}", { "externalDependencies": [] }, { "runtime": "biome --version" } ]
            },
            "lint:typescript-go": {
                "command": "node tools/typescript-go/main.ts",
                "cache": true,
                "inputs": [ "typescript", "{workspaceRoot}/**/*.{ts,tsx,json}", { "externalDependencies": [ "typescript", "@effect/tsgo", "effect", "@effect/platform-node" ] } ]
            },
            "lint:ruff": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [ "pythonFiles", "{workspaceRoot}/**/*.{pyw,ipynb}", "{workspaceRoot}/**/pyproject.toml", { "externalDependencies": [] }, { "runtime": "ruff --version" } ],
                "options": { "commands": [ "ruff check", "ruff format --check" ], "parallel": false }
            },
            "lint:refurb": { "cache": true, "inputs": [ "python", "pythonFiles", { "runtime": "refurb --version" } ] },
            "lint:deptry": { "command": "deptry libs/python apps", "cache": true, "inputs": [ "python", "pythonFiles", { "runtime": "deptry --version" } ] },
            "lint:yamllint": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamllint --strict", "cache": true, "inputs": [ "yamlFiles", { "externalDependencies": [] }, { "runtime": "yamllint --version" } ] },
            "lint:yamlfmt": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamlfmt -lint", "cache": true, "inputs": [ "yamlFiles", "{workspaceRoot}/.yamlfmt", { "externalDependencies": [] }, { "runtime": "yamlfmt -version" } ] },
            "lint:tombi": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [ "{workspaceRoot}/**/*.toml", { "externalDependencies": [] }, { "runtime": "tombi --version" } ],
                "options": { "commands": [ "tombi lint --error-on-warnings", "tombi format --check" ], "parallel": false }
            },
            "lint:actionlint": {
                "command": "actionlint",
                "cache": true,
                "inputs": [ "{workspaceRoot}/.github/actionlint.yaml", "{workspaceRoot}/.github/workflows/*.{yml,yaml}", "{workspaceRoot}/.github/actions/*/action.{yml,yaml}", { "externalDependencies": [] }, { "runtime": "actionlint --version" }, { "runtime": "shellcheck --version" } ]
            },
            "lint:google-java-format": { "command": "fd --hidden --extension java --exec-batch google-java-format --aosp --dry-run --set-exit-if-changed", "cache": true, "inputs": [ "javaFiles", { "externalDependencies": [] }, { "runtime": "google-java-format --version" } ] },
            "lint:pmd": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [ "javaFiles", "{workspaceRoot}/**/*.{py,swift}", "{workspaceRoot}/pmd.xml", { "externalDependencies": [] }, { "runtime": "pmd --version" } ],
                "outputs": [ "{workspaceRoot}/.cache/pmd/java" ],
                "options": {
                    "commands": [
                        { "command": "fd --hidden --extension java --exec-batch pmd check --rulesets pmd.xml --cache .cache/pmd/java --no-progress", "forwardAllArgs": false },
                        "fd --hidden --extension java --exec-batch pmd cpd --language java",
                        "fd --hidden --extension py --exec-batch pmd cpd --language python",
                        "fd --hidden --extension swift --exec-batch pmd cpd --language swift"
                    ],
                    "args": [ "--minimum-tokens", "100" ],
                    "parallel": false
                }
            },
            "lint:rustfmt": { "command": "cargo fmt --check", "cache": true, "inputs": [ "rustFiles", "{workspaceRoot}/**/Cargo.toml", "{workspaceRoot}/rustfmt.toml", { "externalDependencies": [] }, { "runtime": "rustfmt --version" } ] },
            "lint:dylint": { "dependsOn": [ { "projects": [ "tag:language:rust" ], "target": "lint:dylint" } ] },
            "lint:cargo-modules": { "dependsOn": [ { "projects": [ "tag:language:rust" ], "target": "lint:cargo-modules" } ] },
            "lint:dotnet-format": {
                "options": { "args": [ "Workspace.slnx", "--no-restore", "--verify-no-changes" ] },
                "cache": true,
                "dependsOn": [ "restore", { "projects": [ "tag:language:dotnet" ], "target": "lint", "params": "forward" } ],
                "inputs": [ "dotnet", "{workspaceRoot}/.editorconfig", "{workspaceRoot}/Workspace.slnx", "{workspaceRoot}/**/*.{cs,csproj}" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/lint:dotnet-format.binlog" ]
            },
            "lint": { "dependsOn": [ "lint:*" ] },
            "format": { "dependsOn": [ "format:!(files)", { "projects": [ "tag:language:dotnet" ], "target": "format" } ] },
            "format:files": { "command": "node eng/typescript/format/main.ts" },
            "format:biome": { "command": "biome check --write --error-on-warnings --no-errors-on-unmatched" },
            "format:ruff": { "executor": "nx:run-commands", "options": { "commands": [ "ruff check --fix", "ruff format" ], "parallel": false } },
            "format:yamlfmt": { "command": "fd --hidden --extension yaml --extension yml --strip-cwd-prefix --exec-batch yamlfmt", "configurations": { "files": { "command": "yamlfmt" } } },
            "format:tombi": { "command": "tombi format" },
            "format:google-java-format": { "command": "fd --hidden --extension java --exec-batch google-java-format --aosp --replace", "configurations": { "files": { "command": "google-java-format --aosp --replace" } } },
            "format:swiftlint": { "command": "fd --hidden --extension swift --exec-batch swiftlint lint --fix --quiet", "parallelism": false, "configurations": { "files": { "command": "swiftlint lint --fix --quiet" } } },
            "format:swift-format": { "command": "fd --hidden --extension swift --exec-batch xcrun swift-format format --in-place --parallel", "dependsOn": [ { "target": "format:swiftlint", "params": "forward" } ], "configurations": { "files": { "command": "xcrun swift-format format --in-place --parallel" } } },
            "format:rustfmt": { "command": "cargo fmt", "configurations": { "files": { "command": "rustfmt" } } },
            "format:dotnet-format": { "options": { "args": [ "Workspace.slnx", "--no-restore" ] }, "dependsOn": [ "restore" ], "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/format:dotnet-format.binlog" ] },
            "typecheck:tsc": {
                "command": "tsc --pretty false",
                "cache": true,
                "inputs": [ "typescript", "{workspaceRoot}/**/*.{ts,json}", { "externalDependencies": [ "typescript", "@effect/tsgo" ] } ]
            },
            "typecheck:ty": { "cache": true, "inputs": [ "python", "pythonFiles", { "runtime": "ty --version" } ] },
            "typecheck:mypy": { "cache": true, "inputs": [ "python", "pythonFiles", { "runtime": "mypy --version" } ] },
            "typecheck": { "dependsOn": [ "typecheck:*" ] },
            "check": { "dependsOn": [ "lint", "typecheck" ] },
            "infra": { "command": "doppler run --project rasm --config dev_repo --no-fallback --attempts 1 -- node infra/cli.ts", "parallelism": false, "configurations": { "up": { "args": "up" }, "refresh": { "args": "refresh" } } },
            "clean": { "command": "node eng/typescript/cleanup/main.ts", "parallelism": false },
            "upgrade": { "dependsOn": [ "upgrade:*", { "projects": [ "tag:language:swift" ], "target": "upgrade" } ] },
            "upgrade:mise": { "command": "mise upgrade --local", "parallelism": false },
            "upgrade:dotnet": { "command": "dotnet run --no-build --project eng/dotnet/Rasm.Upgrade -- Directory.Packages.props", "dependsOn": [ { "projects": [ "Rasm.Upgrade" ], "target": "build" } ] },
            "upgrade:python": { "command": "uv sync --upgrade" },
            "upgrade:rust": {
                "executor": "nx:run-commands",
                "options": {
                    "commands": [ "cargo dylint upgrade", "cargo upgrade --incompatible", "cargo update", "tombi format" ],
                    "parallel": false
                }
            },
            "upgrade:typescript": {
                "executor": "nx:run-commands",
                "parallelism": false,
                "options": {
                    "commands": [
                        "ncu --workspaces --target newest --upgrade --install never --reject typescript,tree-sitter-swift",
                        "sd '^(\\s+typescript: )\\S+' \"\\${1}$(curl -fsSL https://raw.githubusercontent.com/Effect-TS/tsgo/@effect/tsgo@$(yq '.catalog[\"@effect/tsgo\"]' pnpm-workspace.yaml)/_packages/tsgo/upstream.json | jq -r .tags.typescript.next)\" pnpm-workspace.yaml",
                        "sd '^(\\s+tree-sitter-swift: github:[^#\\s]+#)\\S+' \"\\${1}$(git ls-remote --tags --refs --sort=-v:refname https://github.com/$(yq '.catalog[\"tree-sitter-swift\"] | sub(\"github:|#.*\", \"\")' pnpm-workspace.yaml) | rg -m1 -or '$1' 'refs/tags/(\\d+\\.\\d+\\.\\d+-with-generated-files)$')\" pnpm-workspace.yaml",
                        "pnpm install",
                        "playwright install chromium"
                    ],
                    "parallel": false
                }
            }
        }
    }
}
