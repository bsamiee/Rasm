{
    "name": "@rasm/hosting",
    "private": true,
    "description": "One web app served the same on edge and server runtimes",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./browser": "./browser.ts",
        "./cloudflare": "./cloudflare.ts",
        "./node": "./node.ts",
        "./server": "./server/index.ts",
        "./vite": "./vite.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "catalog:",
        "@effect/platform-node": "catalog:",
        "cheerio": "catalog:",
        "effect": "catalog:",
        "partial-content": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/test-support": "workspace:*",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "cf": "catalog:",
        "testcontainers": "catalog:",
        "vitest": "catalog:"
    }
}
