{
    "name": "@rasm/cep",
    "version": "0.0.0",
    "private": true,
    "description": "CEP extension manifest, the panel runtime following the host skin and launching a caller link, the swc lowering of ExtendScript, and the Vite builders of CEP extensions and ExtendScript engines",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/cep"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./node": "./node.ts",
        "./panel": "./panel.ts",
        "./vite": "./vite.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/automation": "workspace:*",
        "@rasm/mark": "workspace:*",
        "@swc/wasm": "catalog:",
        "acorn": "catalog:",
        "acorn-walk": "catalog:",
        "cheerio": "catalog:",
        "culori": "catalog:",
        "fast-xml-builder": "catalog:",
        "fast-xml-parser": "catalog:"
    },
    "devDependencies": {
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./node": "./dist/node.js",
            "./panel": "./dist/panel.js",
            "./vite": "./dist/vite.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
