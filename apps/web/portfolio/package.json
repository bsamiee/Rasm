{
    "name": "architectural-portfolio",
    "private": true,
    "description": "Architectural portfolio publishing projects and studies as one server-rendered page, with owner-only editor",
    "type": "module",
    "dependencies": {
        "@effect/atom-react": "catalog:",
        "@effect/platform-browser": "catalog:",
        "@effect/sql-d1": "catalog:",
        "@rasm/hosting": "workspace:*",
        "@rasm/media": "workspace:*",
        "@rasm/ui": "workspace:*",
        "@uppy/core": "catalog:",
        "@uppy/dashboard": "catalog:",
        "@uppy/react": "catalog:",
        "@uppy/xhr-upload": "catalog:",
        "effect": "catalog:",
        "embla-carousel-react": "catalog:",
        "lucide-react": "catalog:",
        "motion": "catalog:",
        "partial-content": "catalog:",
        "pdfjs-dist": "catalog:",
        "react": "catalog:",
        "react-aria-components": "catalog:",
        "react-error-boundary": "catalog:",
        "react-zoom-pan-pinch": "catalog:",
        "tailwindcss": "catalog:",
        "tailwindcss-react-aria-components": "catalog:",
        "validator": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "catalog:",
        "@cloudflare/workers-types": "catalog:",
        "@openai/sites-vite-plugin": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/validator": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "cf": "catalog:",
        "oxc-transform-react": "catalog:",
        "vite": "catalog:"
    },
    "nx": {
        "targets": {
            "db:setup": {
                "command": "cf d1 raw DB-{projectName} --local --persist-to ../../../.cache/cloudflare/apps/web/portfolio --sql @worker/schema.sql",
                "options": {
                    "cwd": "{projectRoot}"
                },
                "parallelism": false
            }
        }
    }
}
