{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "outDir": ".cache/typescript/out/root",
        "tsBuildInfoFile": ".cache/typescript/root.tsbuildinfo",
        "types": ["node"],
        "allowImportingTsExtensions": true
    },
    "include": ["*.config.ts", "tests/typescript/support/vitest.config.ts"],
    "references": [
        // Add one entry per workspace package tsconfig, e.g. { "path": "./libs/typescript/{package}" }
        {
            "path": "./tests/typescript/support"
        }
    ],
    "watchOptions": {
        "excludeDirectories": [
            "**/node_modules",
            "**/.git",
            "**/.nx",
            "**/dist",
            "**/build",
            "**/.next",
            "**/.vite",
            "**/.cache",
            "**/.artifacts",
            "**/.history",
            "**/.venv",
            "**/.vscode",
            "**/.idea"
        ],
        "fallbackPolling": "dynamicPriority",
        "synchronousWatchDirectory": true
    }
}
