{
    "name": "@rasm/typography",
    "version": "0.0.0",
    "private": true,
    "description": "OpenType typesetting, from font faces to composed text",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/graphics/typography"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./shaping": "./shaping/index.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@rasm/search": "workspace:*",
        "fontkit": "catalog:",
        "harfbuzzjs": "catalog:",
        "icu": "catalog:"
    },
    "devDependencies": {
        "@types/fontkit": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js",
            "./shaping": "./dist/shaping/index.js"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
