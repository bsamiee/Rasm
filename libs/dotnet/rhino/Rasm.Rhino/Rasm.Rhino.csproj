<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Foundation for building any Rhino plug-in or app, wrapping RhinoCommon in LanguageExt effects with typed errors</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <MapperlyAbstractionsScope>runtime</MapperlyAbstractionsScope>
    </PropertyGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Microsoft.Win32.SystemEvents" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="LanguageExt.Streaming" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="Riok.Mapperly" PrivateAssets="compile;contentfiles;analyzers;build" />
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="PeterO.Numbers" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="QuikGraph" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Desktop UI">
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="Svg.Model" />
        <PackageReference Include="Svg.Skia" />
    </ItemGroup>

    <ItemGroup Label="Workspace Packages">
        <ProjectReference Include="../../bim/Rasm.Drafting/Rasm.Drafting.csproj" />
        <ProjectReference Include="../../graphics/Rasm.Imaging/Rasm.Imaging.csproj" />
    </ItemGroup>

    <ItemGroup Label="Embedded Resources">
        <EmbeddedResource Include="Render/Queue/rasm_rhino_render.js" />
    </ItemGroup>
</Project>
