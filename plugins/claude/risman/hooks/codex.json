{
    "hooks": {
        "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/command.js\" codex SessionStart", "async": true }] }],
        "PreToolUse": [{ "matcher": "^mcp__", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/command.js\" codex PreToolUse", "timeout": 10 }] }],
        "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/command.js\" codex PostToolUse", "async": true, "timeout": 10 }] }],
        "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/command.js\" codex UserPromptSubmit", "timeout": 10 }] }],
        "Stop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/command.js\" codex Stop", "timeout": 10 }] }],
        "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/command.js\" codex SubagentStop", "timeout": 10 }] }],
        "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/command.js\" codex SessionEnd", "timeout": 3 }] }]
    }
}
