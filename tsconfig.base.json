{
    "$schema": "./node_modules/@typescript/native/schemas/tsconfig.schema.json",
    "compilerOptions": {
        "declaration": true,
        "erasableSyntaxOnly": true,
        "exactOptionalPropertyTypes": true,
        "lib": [ "esnext" ],
        "module": "nodenext",
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "outDir": "${configDir}/dist",
        "plugins": [
            {
                "name": "@effect/language-service",
                "allowedUnstableApis": [ "effect", "@effect" ],
                "allowedExperimentalApis": [ "effect", "@effect" ],
                "barrelImportPackages": [ "effect" ],
                "effectFn": [ "span", "untraced" ],
                "keyPatterns": [ { "target": "service" }, { "target": "custom" }, { "target": "error", "pattern": "identifier" }, { "target": "taggedClass", "pattern": "identifier" } ],
                "diagnosticSeverity": {
                    "anyUnknownInErrorContext": "error",
                    "mapMapErrorToMapBoth": "error",
                    "unsafeEffectTypeAssertion": "error",
                    "extendsNativeError": "error",
                    "asyncFunction": "error",
                    "newPromise": "error",
                    "cryptoRandomUUID": "error",
                    "cryptoRandomUUIDInEffect": "error",
                    "globalDate": "error",
                    "globalDateInEffect": "error",
                    "globalFetch": "error",
                    "globalFetchInEffect": "error",
                    "globalJsonInEffect": "error",
                    "globalRandom": "error",
                    "globalRandomInEffect": "error",
                    "globalTimers": "error",
                    "globalTimersInEffect": "error",
                    "instanceOfSchema": "error",
                    "processEnv": "error",
                    "processEnvInEffect": "error",
                    "schemaSync": "error",
                    "deterministicKeys": "error",
                    "effectDoNotation": "error",
                    "missedPipeableOpportunity": "error",
                    "missingEffectServiceDependency": "error",
                    "nestedEffectGenYield": "error",
                    "newSchemaClass": "error",
                    "preferBarrelImport": "error",
                    "preferSchemaTaggedError": "error",
                    "preferSchemaTypeProperty": "error",
                    "schemaUnionOfLiterals": "error",
                    "serviceNotAsClass": "error",
                    "strictBooleanExpressions": "error",
                    "unnecessaryArrowBlock": "error"
                },
                "overrides": [ { "include": [ "**/*.test.tsx", "**/.storybook/*.stories.tsx", "plugins/function-hooks/hooks/*.ts" ], "options": { "diagnosticSeverity": { "asyncFunction": "off" } } } ]
            }
        ],
        "rewriteRelativeImportExtensions": true,
        "rootDir": "${configDir}",
        "skipLibCheck": true,
        "types": [ "node" ],
        "verbatimModuleSyntax": true
    }
}
