language js(typescript, jsx)

or {
    `await $step` as $hit,
    `for await (const $row of $source) { $body }` as $hit
} where {
    $hit <: not within `Effect.tryPromise($_)` ,
    $hit <: not within `Effect.promise($_)` ,
    $hit <: not within `Effect.tryMapPromise($_)` ,
    register_diagnostic(span=$hit, message="Await in domain flow. Promises convert once at the boundary (Effect.tryPromise/Effect.promise/Effect.tryMapPromise) and the interior composes Effect values. Async iterables drain through Stream.fromAsyncIterable, never a for-await loop.", severity="error")
}
