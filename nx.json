{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "cacheDirectory": ".cache/nx/cache",
    "maxCacheSize": "8GB",
    "useDaemonProcess": false,
    "analytics": false,
    "neverConnectToCloud": true,
    "sync": { "globalGenerators": [ "@rasm/nx-devkit:executor-schemas" ] },
    "plugins": [
        "@rasm/nx-distribution",
        { "plugin": "@rasm/nx-apple", "options": { "trustPackages": true } },
        "@rasm/nx-cargo",
        { "plugin": "@rasm/nx-cmake", "exclude": [ "tools/ast-grep/grammars/**" ], "options": { "launcher": [ "pixi", "run", "--locked", "-e", "cpp" ], "locks": [ "pixi.lock" ] } },
        { "plugin": "@rasm/nx-uv", "exclude": [ ".config/mise/locks/**" ] },
        "@rasm/nx-dotnet",
        "@rasm/nx-docker",
        "@rasm/nx-pulumi",
        "@rasm/nx-typescript",
        "@rasm/nx-vite",
        "@rasm/nx-vitest",
        "@rasm/nx-storybook",
        "@rasm/nx-cloudflare",
        "@rasm/nx-playwright"
    ],
    "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false, "projectsAffectedByDependencyUpdates": "auto" }, "@rasm/nx-devkit": { "outputPath": ".artifacts" } },
    "release": { "projects": [ "tag:npm:public", "tag:release" ], "version": { "conventionalCommits": true }, "changelog": { "workspaceChangelog": { "createRelease": "github", "file": false } }, "git": { "commitMessage": "chore: publish {version}" } }
}
