{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "cacheDirectory": ".cache/nx/cache",
    "maxCacheSize": "8GB",
    "useDaemonProcess": false,
    "analytics": false,
    "neverConnectToCloud": true,
    "sync": { "globalGenerators": [ "@rasm/nx-distribution:executor-schemas" ] },
    "plugins": [
        "@rasm/nx-distribution",
        { "plugin": "@rasm/nx-apple", "options": { "trustPackages": true } },
        "@rasm/nx-cargo",
        { "plugin": "@rasm/nx-cmake", "exclude": [ "tools/ast-grep/grammars/**" ] },
        { "plugin": "@rasm/nx-uv", "exclude": [ ".config/mise/locks/**" ] },
        "@rasm/nx-dotnet",
        "@rasm/nx-docker",
        "@rasm/nx-pulumi",
        { "plugin": "@rasm/nx-typescript", "options": { "compilerPackages": [ "@typescript/native", "@effect/tsgo" ] } },
        "@rasm/nx-vite",
        "@rasm/nx-vitest",
        "@rasm/nx-storybook"
    ],
    "targetDefaults": { "@nx/js:release-publish": { "dependsOn": [ "pack--pnpm" ] } },
    "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": false, "projectsAffectedByDependencyUpdates": "auto" }, "@rasm/nx-distribution": { "outputPath": ".artifacts" } },
    "release": { "projects": [ "tag:release" ], "version": { "conventionalCommits": true }, "changelog": { "workspaceChangelog": { "createRelease": "github", "file": false } }, "git": { "commitMessage": "chore: publish {version}" } }
}
