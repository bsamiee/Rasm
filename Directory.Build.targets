<Project>
    <ItemGroup Label="Implicit Usings" Condition="'$(IsRoslynComponent)' != 'true'">
        <Using Remove="System.Collections.Generic" />
        <Using Include="System.Collections.Frozen;System.Collections.Immutable" />
    </ItemGroup>

    <ItemGroup Label="Package Usings">
        <Using Include="Thinktecture" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Thinktecture.Runtime.Extensions'))" />
        <Using Include="LanguageExt;LanguageExt.Common;LanguageExt.Traits;LanguageExt.UnsafeValueAccess" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Core'))" />
        <Using Include="LanguageExt.Prelude" Static="true" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Core'))" />
        <Using Include="LanguageExt.Pipes" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Streaming'))" />
        <Using Include="LanguageExt.Sys;LanguageExt.Sys.IO;LanguageExt.Sys.Traits;LanguageExt.Sys.Diag" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Sys'))" />
        <Using Include="LanguageExt.Parsec" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'LanguageExt.Parsec'))" />
        <Using Include="NodaTime;NodaTime.Extensions" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'NodaTime'))" />
        <Using Include="NodaTime.Duration" Alias="Duration" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'NodaTime'))" />
        <Using Include="UnitsNet.Length" Alias="Length" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'UnitsNet'))" />
        <Using Include="Microsoft.Extensions.Logging" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Logging')) or @(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Logging.Abstractions'))" />
        <Using Include="Grasshopper2.Types.Numeric" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Grasshopper2'))" />
    </ItemGroup>

    <ItemGroup Label="Analyzer Configuration">
        <AdditionalFiles Include="$(MSBuildThisFileDirectory).config/BannedSymbols.txt" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory).config/BannedSymbols.Library.txt" Condition="'$(IsPackable)' == 'true'" />
    </ItemGroup>

    <ItemGroup Label="Analyzer References" Condition="'$(IsRoslynComponent)' != 'true' and '$(RunAnalyzers)' != 'false'">
        <ProjectReference Include="$(MSBuildThisFileDirectory)apps/roslyn/Rasm.Analyzers.Package/Rasm.Analyzers.Package.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    </ItemGroup>

    <Import Project="apps/roslyn/Rasm.Analyzers.Package/build/Rasm.Analyzers.props" Condition="'$(IsRoslynComponent)' != 'true' and '$(RunAnalyzers)' != 'false'" />

    <PropertyGroup Label="Central Package Management">
        <CentralPackageTransitivePinningEnabled Condition="'$(IsRoslynComponent)' != 'true' and '$(IsPackable)' != 'true'">true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <PropertyGroup Label="Fetched Files">
        <_FetchedStore>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '.cache', 'dotnet', 'fetched'))</_FetchedStore>
    </PropertyGroup>

    <ItemGroup Label="Fetched Files">
        <FetchedResource Update="@(FetchedResource)" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
        <EmbeddedResource Include="@(FetchedResource->'$(_FetchedStore)%(Sha256)')" />
    </ItemGroup>

    <Target Name="FetchResources" BeforeTargets="CoreCompile" Condition="'@(FetchedResource)' != '' and '$(DesignTimeBuild)' != 'true'">
        <DownloadFile SourceUrl="%(FetchedResource.Identity)" DestinationFolder="$(IntermediateOutputPath)" DestinationFileName="%(FetchedResource.Sha256)" Condition="!Exists('$(_FetchedStore)%(FetchedResource.Sha256)')" />
        <VerifyFileHash File="$(IntermediateOutputPath)%(FetchedResource.Sha256)" Hash="%(FetchedResource.Sha256)" Condition="!Exists('$(_FetchedStore)%(FetchedResource.Sha256)')" />
        <Move SourceFiles="$(IntermediateOutputPath)%(FetchedResource.Sha256)" DestinationFiles="$(_FetchedStore)%(FetchedResource.Sha256)" Condition="!Exists('$(_FetchedStore)%(FetchedResource.Sha256)')" />
    </Target>

    <PropertyGroup Label="Documentation Files" Condition="'$(IsPackable)' != 'true'">
        <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    </PropertyGroup>

    <PropertyGroup Label="Runtimes" Condition="'$(UseCurrentRuntimeIdentifier)' == 'true'">
        <RuntimeIdentifiers>osx-arm64;win-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <DefaultItemExcludes Condition="'$(TargetPlatformIdentifier)' == 'Windows'">$(DefaultItemExcludes);**/Mac/**</DefaultItemExcludes>
        <DefaultItemExcludes Condition="'$(TargetPlatformIdentifier)' != 'Windows'">$(DefaultItemExcludes);**/Windows/**</DefaultItemExcludes>
        <_RhinoMajorVersion Condition="'$(PkgRhinoCommon)' != ''">$([System.IO.Path]::GetFileName('$(PkgRhinoCommon)').Split('.')[0])</_RhinoMajorVersion>
        <RhinoInstallPath Condition="'$(RhinoInstallPath)' == '' and '$(_RhinoMajorVersion)' != '' and $([MSBuild]::IsOSPlatform('OSX'))">/Applications/Rhino $(_RhinoMajorVersion).app</RhinoInstallPath>
        <RhinoInstallPath Condition="'$(RhinoInstallPath)' == '' and '$(_RhinoMajorVersion)' != '' and $([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\McNeel\Rhinoceros\$(_RhinoMajorVersion).0\Install', 'InstallPath'))</RhinoInstallPath>
        <RhinoResourcesDir Condition="'$(RhinoInstallPath)' != '' and $([MSBuild]::IsOSPlatform('OSX'))">$([MSBuild]::NormalizeDirectory('$(RhinoInstallPath)', 'Contents', 'Frameworks', 'RhCore.framework', 'Versions', 'Current', 'Resources'))</RhinoResourcesDir>
        <RhinoResourcesDir Condition="'$(RhinoInstallPath)' != '' and $([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::NormalizeDirectory('$(RhinoInstallPath)', 'System', 'netcore'))</RhinoResourcesDir>
        <YakExecutable Condition="'$(RhinoInstallPath)' != '' and $([MSBuild]::IsOSPlatform('OSX'))">$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'Contents', 'Resources', 'bin', 'yak'))</YakExecutable>
        <YakExecutable Condition="'$(RhinoInstallPath)' != '' and $([MSBuild]::IsOSPlatform('Windows'))">$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'System', 'yak.exe'))</YakExecutable>
    </PropertyGroup>

    <ItemGroup Label="Rhino Host" Condition="'$(RhinoHost)' != ''">
        <PackageReference Update="RhinoCommon" ExcludeAssets="runtime" GeneratePathProperty="true" />
        <PackageReference Include="System.Drawing.Common" ExcludeAssets="compile" Condition="'$(TargetPlatformIdentifier)' != 'Windows'" />
        <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" Condition="'$(TargetPlatformIdentifier)' == 'Windows'" />
        <Using Include="Rhino.Geometry" />
        <Using Include="Rhino.Geometry.Interval" Alias="Interval" />
        <RuntimeHostConfigurationOption Include="RhinoInstallPath" Value="$(RhinoInstallPath)" Condition="'$(IsTestingPlatformApplication)' == 'true'" />
    </ItemGroup>

    <Import Project="libs/dotnet/rhino/Rasm.Rhino/buildTransitive/Rasm.Rhino.targets" Condition="'$(RhinoHost)' != ''" />

    <UsingTask TaskName="ReadRhinoHost" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Resources ParameterType="System.String" Required="true" />
            <Packages ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <References ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
            <TargetFramework ParameterType="System.String" Output="true" />
            <Supplied ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Reflection" />
            <Using Namespace="System.Runtime.Serialization.Json" />
            <Using Namespace="System.Xml" />
            <Using Namespace="System.Xml.Linq" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                    XElement Json(string path) => XElement.Load(JsonReaderWriterFactory.CreateJsonReader(File.ReadAllBytes(path), XmlDictionaryReaderQuotas.Max));
                    string runtime = Directory.GetFiles(Resources, "dotnetstart.*.runtimeconfig.json").Single();
                    TargetFramework = Json(runtime).Element("runtimeOptions").Element("tfm").Value;
                    ILookup<string, string> declared = Json(runtime.Replace(".runtimeconfig.json", ".deps.json")).Descendants("assemblyVersion").ToLookup(version => Path.GetFileName(version.Parent.Attribute("item")?.Value ?? version.Parent.Name.LocalName), version => version.Value);
                    string[] api = Directory.GetDirectories(Path.Combine(Resources, "ManagedPlugIns"), "*.rhp").Prepend(Resources).ToArray();
                    Supplied = (Packages ?? Array.Empty<ITaskItem>())
                        .Select(package => (Package: package, Folders: new[] { Resources }))
                        .Concat((References ?? Array.Empty<ITaskItem>()).Select(reference => (Package: reference, Folders: api)))
                        .SelectMany(held => held.Folders
                            .Select(folder => Path.Combine(folder, Path.GetFileName(held.Package.ItemSpec)))
                            .Where(File.Exists)
                            .Take(1)
                            .Select(host => {
                                TaskItem supplied = new TaskItem(held.Package);
                                supplied.SetMetadata("HostFile", host);
                                supplied.SetMetadata("Version", AssemblyName.GetAssemblyName(held.Package.ItemSpec).Version.ToString());
                                supplied.SetMetadata("HostVersion", declared[Path.GetFileName(host)].DefaultIfEmpty(AssemblyName.GetAssemblyName(host).Version.ToString()).First());
                                return (ITaskItem)supplied;
                            }))
                        .ToArray();
                ]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="ResolveRhinoInstallation" AfterTargets="ResolvePackageAssets" Condition="'$(RhinoHost)' != ''">
        <Error Condition="!Exists('$(RhinoResourcesDir)')" Text="Rhino $(_RhinoMajorVersion) install not found at '$(RhinoInstallPath)', install Rhino $(_RhinoMajorVersion) or set RhinoInstallPath" />
        <XmlPeek XmlInputPath="$(RhinoInstallPath)/Contents/Info.plist" Query="/plist/dict/key[.='CFBundleVersion']/following-sibling::*[1]/text()" ProhibitDtd="false" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
            <Output TaskParameter="Result" PropertyName="_RhinoVersion" />
        </XmlPeek>
        <Error Condition="$([MSBuild]::IsOSPlatform('OSX')) and !$([System.String]::Copy('$(_RhinoVersion)').StartsWith('$(_RhinoMajorVersion).'))" Text="$(RhinoInstallPath) contains Rhino $(_RhinoVersion); Rhino $(_RhinoMajorVersion) is required." />
        <XmlPeek XmlInputPath="$(RhinoInstallPath)/Contents/Info.plist" Query="/plist/dict/key[.='LSMinimumSystemVersion']/following-sibling::*[1]/text()" ProhibitDtd="false" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
            <Output TaskParameter="Result" PropertyName="_RhinoMacMinimumVersion" />
        </XmlPeek>
        <ItemGroup>
            <RuntimeHostConfigurationOption Include="RhinoVersion" Value="$(_RhinoVersion)" Condition="'$(IsTestingPlatformApplication)' == 'true' and '$(_RhinoVersion)' != ''" />
            <_RhinoReference Include="@(ResolvedCompileFileDefinitions)" />
            <_RhinoReference Remove="@(RuntimeCopyLocalItems)" MatchOnMetadata="NuGetPackageId" />
        </ItemGroup>
        <ReadRhinoHost Resources="$(RhinoResourcesDir)" Packages="@(RuntimeCopyLocalItems)" References="@(_RhinoReference)">
            <Output TaskParameter="TargetFramework" PropertyName="RhinoTargetFramework" />
            <Output TaskParameter="Supplied" ItemName="_RhinoSupplied" />
        </ReadRhinoHost>
        <Error Condition="$([MSBuild]::VersionGreaterThan($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), $([MSBuild]::GetTargetFrameworkVersion('$(RhinoTargetFramework)'))))" Text="$(MSBuildProjectName) targets $(TargetFramework), newer than the $(RhinoTargetFramework) runtime Rhino $(_RhinoMajorVersion) loads from $(RhinoResourcesDir)" />
    </Target>

    <Target Name="ResolveRhinoMacHost" BeforeTargets="ResolveAssemblyReferences;GetAssemblyAttributes" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(RhinoHost)' != '' and '$(TargetPlatformIdentifier)' != 'Windows'">
        <ItemGroup>
            <_RhinoMacAssembly Include="System.Drawing.Common;Eto.macOS;Microsoft.macOS" />
            <Reference Include="@(_RhinoMacAssembly->'$(RhinoResourcesDir)%(Identity).dll')" Private="false" />
            <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
                <_Parameter1>macos$(_RhinoMacMinimumVersion)</_Parameter1>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <Target Name="ExcludeRhinoHostAssemblies" AfterTargets="ResolvePackageAssets" DependsOnTargets="ResolveRhinoInstallation" Condition="'$(RhinoHost)' != '' and ('$(RhinoProduct)' == 'true' or '$(EnableDynamicLoading)' == 'true')">
        <Error Condition="$([MSBuild]::VersionGreaterThan('%(_RhinoSupplied.Version)', '%(_RhinoSupplied.HostVersion)'))" Text="%(_RhinoSupplied.NuGetPackageId) %(_RhinoSupplied.NuGetPackageVersion) ships %(_RhinoSupplied.Filename) %(_RhinoSupplied.Version), above the %(_RhinoSupplied.HostVersion) Rhino $(_RhinoMajorVersion) loads from $(RhinoResourcesDir)" />
        <ItemGroup>
            <RuntimeCopyLocalItems Remove="@(_RhinoSupplied)" MatchOnMetadata="NuGetPackageId" />
            <NativeCopyLocalItems Remove="@(_RhinoSupplied)" MatchOnMetadata="NuGetPackageId" />
        </ItemGroup>
    </Target>
</Project>
