// --- [OPERATIONS] ----------------------------------------------------------------------

var harness = (function () {
    var realApp = app;
    var realDollar = $;
    var realGlobal = $.global;
    var RealFile = File;
    var RealFolder = Folder;
    var RealWindow = Window;
    var RealBridgeTalk = BridgeTalk;
    var RealFunction = Function;
    var realExecute = executeAction;
    var realOpen = File.prototype.open;
    var ENGINE = new File($.fileName).fsName;
    var BUILTINS = [Object.prototype, Array.prototype, String.prototype, Number.prototype, Boolean.prototype, Function.prototype, Date.prototype, RegExp.prototype, Error.prototype];
    var ENUMERATOR = /^([A-Za-z]\w*)\.([A-Z][A-Z0-9_]*)$/;
    var PATHED = /^[\/~]/;
    var SPECIFIER = /^\/document\[@id=(\d+)\](?:\/layer\[@id=(\d+)\])?$/;
    var LOGGED = /^\d{4}:\d\d:\d\d \d\d:\d\d:\d\d : (.*?) : (.*?) : (.*)$/;
    var REFUSED = ["bringToFront", "showColorPicker", "system", "togglePalettes", "batch"];
    var PROGRESS = ["doProgress", "doForcedProgress", "doProgressTask", "doProgressSegmentTask", "doProgressSubTask"];
    var OPTIONS = ["putCustomOptions", "eraseCustomOptions"];
    var HELD = ["displayDialogs", "playbackDisplayDialogs", "notifiersEnabled"];
    var EVENTS = ["openViewlessDocument", "systemCall", "quit"];
    var PARTS = [["guide", "numberOfGuides"], ["channel", "numberOfChannels"], ["path", "numberOfPaths"]];
    var GRID = 65536;
    function has(owner, key) { return Object.prototype.hasOwnProperty.call(owner, key); }
    function listed(name, list) {
        for (var i = 0; i < list.length; i++) { if (list[i] === name) { return true; } }
        return false;
    }
    function id(name) { return stringIDToTypeID(name); }

    // --- [FILES]
    function read(path, from) {
        var file = new RealFile(path);
        file.encoding = "UTF-8";
        if (!file.exists || !file.open("r")) { return ""; }
        file.seek(from || 0);
        var text = file.read();
        file.close();
        return text;
    }
    function write(path, text) {
        var file = new RealFile(path);
        file.encoding = "UTF-8";
        if (!file.open("w")) { throw new Error("cannot write " + path); }
        file.write(text);
        file.close();
    }
    function ensured(folder) {
        if (folder !== null && !folder.exists) { ensured(folder.parent); folder.create(); }
    }

    // --- [DESCRIPTORS]
    function converted(value) {
        var descriptor = new ActionDescriptor();
        descriptor.putObject(id("object"), id("object"), value);
        return realExecute(id("convertJSONdescriptor"), descriptor, DialogModes.NO).getString(id("json"));
    }
    function descriptorOf(text) {
        var descriptor = new ActionDescriptor();
        descriptor.putString(id("json"), text);
        return realExecute(id("convertJSONdescriptor"), descriptor, DialogModes.NO).getObjectValue(id("object"));
    }
    function action(value) {
        var kind = value.typename;
        if (kind === "ActionDescriptor") { return parsedJson(converted(value)); }
        if (kind !== "ActionList" && kind !== "ActionReference") { return null; }
        var wrapper = new ActionDescriptor();
        if (kind === "ActionList") { wrapper.putList(id("list"), value); } else { wrapper.putReference(id("null"), value); }
        var whole = parsedJson(converted(wrapper));
        return kind === "ActionList" ? whole.list : whole["null"];
    }

    // --- [CODEC]
    function exponent(value) {
        var mantissa = Math.abs(value);
        var power = 0;
        while (mantissa >= 9007199254740992) { mantissa /= 2; power += 1; }
        while (mantissa !== Math.floor(mantissa)) { mantissa *= 2; power -= 1; }
        return (value < 0 ? "-" : "") + String(mantissa) + "p" + power;
    }
    function quote(text) {
        var out = '"';
        for (var i = 0; i < text.length; i++) {
            var code = text.charCodeAt(i);
            var ch = text.charAt(i);
            if (ch === '"' || ch === "\\") { out += "\\" + ch; } else if (code < 32 || code > 126) { out += "\\u" + ("000" + code.toString(16)).slice(-4); } else { out += ch; }
        }
        return out + '"';
    }
    function tag(text) { return '{"$":' + quote(text) + "}"; }
    function number(value) {
        if (isNaN(value)) { return tag("NaN"); }
        if (!isFinite(value)) { return tag(value > 0 ? "Infinity" : "-Infinity"); }
        if (value === 0 && 1 / value < 0) { return tag("-0"); }
        return Number(String(value)) === value ? String(value) : tag(exponent(value));
    }
    function iso(date) {
        function padded(count, width) { return ("000" + count).slice(-width); }
        return isNaN(date.getTime()) ? "NaN" : padded(date.getUTCFullYear(), 4) + "-" + padded(date.getUTCMonth() + 1, 2) + "-" + padded(date.getUTCDate(), 2) + "T" + padded(date.getUTCHours(), 2) + ":" + padded(date.getUTCMinutes(), 2) + ":" + padded(date.getUTCSeconds(), 2) + "." + padded(date.getUTCMilliseconds(), 3) + "Z";
    }
    function parsed(text) {
        var parts = /^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(?:\.(\d{1,3}))?Z$/.exec(text);
        return parts ? new Date(Date.UTC(Number(parts[1]), Number(parts[2]) - 1, Number(parts[3]), Number(parts[4]), Number(parts[5]), Number(parts[6]), Number(parts[7] || 0))) : new Date(NaN);
    }
    function enumerator(value) {
        var parts = ENUMERATOR.exec(String(value));
        return parts && realGlobal[parts[1]] !== undefined && realGlobal[parts[1]] !== null && realGlobal[parts[1]][parts[2]] == value ? "enum:" + parts[1] + "." + parts[2] : null;
    }
    function specifier(value) {
        try {
            if (value.typename === "Document") { return "object:/document[@id=" + value.id + "]"; }
            if (value.typename !== "ArtLayer" && value.typename !== "LayerSet") { return null; }
            var owner = value.parent;
            while (owner.typename !== "Document") { owner = owner.parent; }
            return "object:/document[@id=" + owner.id + "]/layer[@id=" + value.id + "]";
        } catch (error) { return null; }
    }
    function named(value) { return enumerator(value) || specifier(value); }
    function special(value) {
        if (value instanceof Date) { return { $: "date:" + iso(value) }; }
        if (value instanceof UnitValue) { return { value: value.value, type: value.type }; }
        return action(value);
    }
    function json(value) {
        if (value === undefined) { return tag("undefined"); }
        if (value === null) { return "null"; }
        var kind = typeof value;
        if (kind === "number") { return number(value); }
        if (kind === "boolean") { return String(value); }
        if (kind === "string") { return quote(value); }
        if (kind === "function") { return '"<function>"'; }
        var host = named(value);
        if (host !== null) { return tag(host); }
        if (value instanceof Array) {
            var items = [];
            for (var i = 0; i < value.length; i++) { items.push(json(value[i])); }
            return "[" + items.join(",") + "]";
        }
        var plain = special(value);
        if (plain !== null) { return json(plain); }
        if (value.constructor === Object) {
            var parts = [];
            for (var key in value) { if (has(value, key)) { parts.push(quote(key) + ":" + json(value[key])); } }
            return "{" + parts.join(",") + "}";
        }
        return quote(String(value));
    }
    function parsedJson(text) { return eval("(" + text + ")"); }
    function kept(value) { return value === undefined ? { $: "undefined" } : parsedJson(json(value)); }
    function resolve(path) {
        var parts = SPECIFIER.exec(path);
        if (!parts) { throw new Error("object:" + path + " names no document or layer"); }
        var doc = null;
        for (var i = 0; i < realApp.documents.length && doc === null; i++) { if (realApp.documents[i].id === Number(parts[1])) { doc = realApp.documents[i]; } }
        if (doc === null || parts[2] === undefined || parts[2] === "") { return doc; }
        function found(list) {
            for (var j = 0; j < list.length; j++) {
                if (list[j].id === Number(parts[2])) { return list[j]; }
                if (list[j].typename === "LayerSet") { var inner = found(list[j].layers); if (inner !== null) { return inner; } }
            }
            return null;
        }
        return found(doc.layers);
    }
    function revive(value) {
        if (value instanceof Array) {
            var list = [];
            for (var i = 0; i < value.length; i++) { list.push(revive(value[i])); }
            return list;
        }
        if (value === null || typeof value !== "object") { return value; }
        var count = 0;
        for (var probe in value) { if (has(value, probe)) { count += 1; } }
        if (count === 1 && has(value, "$")) {
            var text = String(value.$);
            var numbers = { "undefined": undefined, "NaN": NaN, "Infinity": Infinity, "-Infinity": -Infinity, "-0": -0 };
            var scaled = /^(-?\d+)p(-?\d+)$/.exec(text);
            var dated = /^date:(.+)$/.exec(text);
            var enumerated = /^enum:([^.]+)\.(.+)$/.exec(text);
            if (has(numbers, text)) { return numbers[text]; }
            if (scaled) { return Number(scaled[1]) * Math.pow(2, Math.ceil(Number(scaled[2]) / 2)) * Math.pow(2, Math.floor(Number(scaled[2]) / 2)); }
            if (dated) { return parsed(dated[1]); }
            if (enumerated) {
                var held;
                try { held = realGlobal[enumerated[1]][enumerated[2]]; } catch (missing) { held = undefined; }
                if (held === undefined) { throw new Error(text + " names no enumerator"); }
                return held;
            }
            if (text.indexOf("object:") === 0) { return resolve(text.slice(7)); }
            return text;
        }
        var object = {};
        for (var key in value) { if (has(value, key)) { object[key] = revive(value[key]); } }
        return object;
    }

    // --- [SCRIPTUI]
    function next(queue, fallback) { return queue.length ? queue.shift() : fallback; }
    function controls(root) {
        var rows = [];
        function walk(control) {
            var children = control.children || [];
            for (var i = 0; i < children.length; i++) { rows.push(children[i]); walk(children[i]); }
        }
        walk(root);
        return rows;
    }
    function nameOf(control) { return control.properties && control.properties.name !== undefined ? String(control.properties.name) : ""; }
    function control(root, key) {
        var rows = controls(root);
        for (var i = 0; i < rows.length; i++) { if (nameOf(rows[i]) === key || rows[i].text === key) { return rows[i]; } }
        throw new Error("no control " + key + " in " + root.text);
    }
    function tree(root) {
        var rows = controls(root);
        var out = [];
        for (var i = 0; i < rows.length; i++) { out.push({ type: rows[i].type, text: rows[i].text, name: nameOf(rows[i]), value: typeof rows[i].value === "boolean" || typeof rows[i].value === "number" ? rows[i].value : null }); }
        return out;
    }
    function shown(session, root) {
        var answer = next(session.windows, {});
        var fields = answer.fields || {};
        var presses = answer.presses || [];
        var result = answer.answer === undefined ? 1 : answer.answer;
        for (var key in fields) {
            if (!has(fields, key)) { continue; }
            var held = control(root, key);
            if (typeof held.value === "boolean" || typeof held.value === "number") { held.value = fields[key]; } else { held.text = String(fields[key]); }
            if (typeof held.onChange === "function") { held.onChange.call(held); }
        }
        for (var i = 0; i < presses.length; i++) {
            var pressed = control(root, presses[i]);
            pressed.notify("onClick");
            result = nameOf(pressed) === "cancel" ? 2 : 1;
        }
        session.record.windows.push({ title: root.text, type: root.type, tree: tree(root) });
        return result;
    }
    function windowed(session) {
        function Window(type, title, bounds, properties) {
            var made = arguments.length < 2 ? new RealWindow(type) : arguments.length < 3 ? new RealWindow(type, title) : arguments.length < 4 ? new RealWindow(type, title, bounds) : new RealWindow(type, title, bounds, properties);
            session.created.push(made);
            made.show = function () { return shown(session, made); };
            return made;
        }
        Window.prototype = RealWindow.prototype;
        Window.alert = function (message, title) { session.record.alerts.push(title === undefined ? { text: String(message) } : { text: String(message), title: String(title) }); };
        Window.confirm = function (message) { session.record.confirms.push(String(message)); return next(session.confirms, true); };
        Window.prompt = function (message, value) { session.record.prompts.push(String(message)); return next(session.prompts, value); };
        Window.find = function () { return RealWindow.find.apply(RealWindow, arguments); };
        Window.update = function () { return RealWindow.update.apply(RealWindow, arguments); };
        return Window;
    }
    function picked(session, kind, Kind, many) {
        session.record.files.push(kind);
        var answer = next(session.files, null);
        if (answer === null) { return null; }
        var made = new Kind(answer);
        return many ? [made] : made;
    }

    // --- [SHADOWS]
    function statics(fake, real, own) {
        var callable = function () {};
        var lists = [real.reflect.properties, real.reflect.methods];
        for (var l = 0; l < lists.length; l++) {
            for (var i = 0; i < lists[l].length; i++) {
                var name = lists[l][i].name;
                if (name in callable || has(own, name)) { continue; }
                if (l === 1) {
                    fake[name] = (function (method) { return function () { return real[method].apply(real, arguments); }; })(name);
                } else {
                    try { fake[name] = real[name]; } catch (error) { continue; }
                }
            }
        }
        for (var key in own) { if (has(own, key)) { fake[key] = own[key]; } }
        return fake;
    }
    function refusing(session, name) { return function () { session.record.activations.push(name); }; }
    function moved(session, Kind, path) {
        var made = arguments.length < 3 ? new Kind() : new Kind(path);
        var name = made.fsName;
        if (made.exists || name === session.folder || name.indexOf(session.folder + "/") === 0) { return made; }
        var inside = new Kind(session.folder + "/outside" + name);
        ensured(inside.parent);
        return inside;
    }
    function rooted(session, Kind) {
        function Shadow(path) { return arguments.length ? moved(session, Kind, path) : moved(session, Kind); }
        Shadow.prototype = Kind.prototype;
        statics(Shadow, Kind, {});
        if (Kind === RealFolder) { Shadow.watch("current", function (key, previous, next) { RealFolder.current = next; return RealFolder.current; }); }
        return Shadow;
    }
    function acted(session) {
        return function (event, descriptor, mode) {
            var name = typeIDToStringID(event);
            if (listed(name, EVENTS)) { session.record.activations.push("executeAction " + name); return new ActionDescriptor(); }
            if (mode !== undefined && mode !== DialogModes.NO) { session.record.activations.push("executeAction " + name + " " + String(mode) + " sent as DialogModes.NO"); }
            var result = realExecute(event, descriptor === undefined ? new ActionDescriptor() : descriptor, DialogModes.NO);
            session.refresh();
            return result;
        };
    }
    function built(session) {
        function Shadow() {
            var names = [];
            for (var i = 0; i < arguments.length - 1; i++) { names.push(arguments[i]); }
            return session.evaluate("(function (" + names.join(",") + ") {\n" + (arguments.length ? arguments[arguments.length - 1] : "") + "\n})");
        }
        Shadow.prototype = RealFunction.prototype;
        return Shadow;
    }
    function fakeBridgeTalk(session) {
        function BridgeTalk() {}
        BridgeTalk.prototype.send = function () { session.record.activations.push("BridgeTalk.send " + String(this.target)); return false; };
        return statics(BridgeTalk, RealBridgeTalk, { launch: refusing(session, "BridgeTalk.launch"), bringToFront: refusing(session, "BridgeTalk.bringToFront") });
    }
    function fakeDocuments(session, real) {
        var list = { typename: real.typename, parent: real.parent };
        function sync() {
            for (var i = 0; i < list.length; i++) { delete list[i]; }
            list.length = real.length;
            for (var j = 0; j < real.length; j++) { list[j] = real[j]; }
        }
        list.add = function () { var made = real.add.apply(real, arguments); session.refresh(); return made; };
        list.getByName = function (name) { return real.getByName(name); };
        list.sync = sync;
        sync();
        return list;
    }
    function optioned(session, method) {
        return function (key, descriptor, persistent) {
            if (!has(session.options, key)) {
                var prior = null;
                try { prior = realApp.getCustomOptions(key); } catch (absent) { prior = null; }
                session.options[key] = { prior: prior, persistent: false };
            }
            if (persistent === true) { session.options[key].persistent = true; }
            return realApp[method].apply(realApp, arguments);
        };
    }
    function fakeApp(session, found, executed) {
        var fake = {};
        var writable = [];
        var documents = fakeDocuments(session, realApp.documents);
        function held(key, previous, next) {
            session.record.writes.push({ member: key, before: kept(previous), after: kept(next) });
            session.record.activations.push(key + " " + String(next) + " held at " + String(previous));
            return previous;
        }
        function forwarded(key, previous, next) {
            realApp[key] = next;
            session.refresh(key);
            return realApp[key];
        }
        function refresh(except) {
            for (var i = 0; i < writable.length; i++) {
                if (writable[i] === except) { continue; }
                fake.unwatch(writable[i]);
                try { fake[writable[i]] = realApp[writable[i]]; } catch (error) { delete fake[writable[i]]; }
                fake.watch(writable[i], listed(writable[i], HELD) ? held : forwarded);
            }
            documents.sync();
        }
        function progressing(name) {
            return function () {
                session.record.activations.push(name);
                return session.evaluate(String(arguments[arguments.length - 1]));
            };
        }
        var own = {
            documents: documents,
            executeAction: executed,
            open: function () { var made = realApp.open.apply(realApp, arguments); refresh(); return made; },
            openDialog: function () { return picked(session, "open", RealFile, true); },
            updateProgress: function () { return true; },
            changeProgressText: function () {}
        };
        var r;
        for (r = 0; r < REFUSED.length; r++) { if (has(found.methods, REFUSED[r])) { own[REFUSED[r]] = refusing(session, REFUSED[r]); } }
        for (r = 0; r < PROGRESS.length; r++) { if (has(found.methods, PROGRESS[r])) { own[PROGRESS[r]] = progressing(PROGRESS[r]); } }
        for (r = 0; r < OPTIONS.length; r++) { if (has(found.methods, OPTIONS[r])) { own[OPTIONS[r]] = optioned(session, OPTIONS[r]); } }
        for (var name in found.properties) {
            if (!has(found.properties, name) || name === "__proto__" || has(own, name)) { continue; }
            if (found.properties[name] === "readwrite") { writable.push(name); continue; }
            try { fake[name] = realApp[name]; } catch (error) { continue; }
        }
        for (var method in found.methods) {
            if (!has(found.methods, method) || has(own, method)) { continue; }
            fake[method] = (function (called) { return function () { var result = realApp[called].apply(realApp, arguments); refresh(); return result; }; })(method);
        }
        for (var key in own) { if (has(own, key)) { fake[key] = own[key]; } }
        session.refresh = refresh;
        refresh();
        return fake;
    }
    function scope(session, found, item) {
        function printed(text) { session.record.console.push(String(text)); }
        var global = {};
        var properties = realGlobal.reflect.properties;
        for (var p = 0; p < properties.length; p++) {
            if (properties[p].name !== "__proto__") { try { global[properties[p].name] = realGlobal[properties[p].name]; } catch (unread) { continue; } }
        }
        var executed = acted(session);
        var Fake = windowed(session);
        var shadows = { Window: Fake, alert: Fake.alert, confirm: Fake.confirm, prompt: Fake.prompt, BridgeTalk: fakeBridgeTalk(session), executeAction: executed, Function: built(session), File: rooted(session, RealFile), Folder: rooted(session, RealFolder) };
        shadows.app = fakeApp(session, found, executed);
        shadows.$ = statics({}, realDollar, { write: printed, writeln: printed, global: global, fileName: item._tag === "Probe" || item.source === undefined ? "" : item.source.script, evalFile: function (file) { return session.evaluate(read(file instanceof RealFile ? file.fsName : String(file))); } });
        var names = [];
        var values = [];
        for (var key in shadows) {
            if (!has(shadows, key)) { continue; }
            global[key] = shadows[key];
            names.push(key);
            values.push(shadows[key]);
        }
        var scoped = RealFunction.apply(null, names.concat(["doc", "made", "harnessCase", "harnessSource", "return eval(harnessSource);"]));
        var context = [undefined, {}, null];
        session.shadows = shadows;
        session.evaluate = function (code, doc, made, held) {
            if (arguments.length > 1) { context = [doc, made, held]; }
            return scoped.apply(global, values.concat(context, [code]));
        };
    }
    function shadowed(session) {
        function executed() { session.record.activations.push("execute " + this.fsName); return true; }
        function opening(mode) {
            var name = this.fsName;
            if (/^[wae]/.test(String(mode)) && name.indexOf(session.folder + "/") !== 0) {
                this.changePath(session.folder + "/outside" + name);
                ensured(this.parent);
            }
            return realOpen.apply(this, arguments);
        }
        var rows = [
            [RealFile, "openDialog", function (prompt, filter, many) { return picked(session, "open", RealFile, many === true); }],
            [RealFile, "saveDialog", function () { return picked(session, "save", RealFile, false); }],
            [RealFolder, "selectDialog", function () { return picked(session, "folder", RealFolder, false); }],
            [RealFile.prototype, "openDlg", function (prompt, filter, many) { return picked(session, "open", RealFile, many === true); }],
            [RealFile.prototype, "saveDlg", function () { return picked(session, "save", RealFile, false); }],
            [RealFolder.prototype, "selectDlg", function () { return picked(session, "folder", RealFolder, false); }],
            [RealFile.prototype, "execute", executed],
            [RealFolder.prototype, "execute", executed],
            [RealFile.prototype, "open", opening]
        ];
        var held = [];
        for (var i = 0; i < rows.length; i++) {
            held.push(rows[i][0][rows[i][1]]);
            rows[i][0][rows[i][1]] = rows[i][2];
        }
        return function () { for (var j = 0; j < rows.length; j++) { rows[j][0][rows[j][1]] = held[j]; } };
    }

    // --- [STATE]
    function described(reference) {
        var descriptor = executeActionGet(reference);
        return wholeOf(descriptor, parsedJson(converted(descriptor)));
    }
    function wholeOf(descriptor, whole) {
        var text = {};
        for (var key in whole) { if (has(whole, key) && key !== "_obj") { text[key] = json(whole[key]); } }
        return { descriptor: descriptor, whole: whole, text: text };
    }
    function application() {
        var reference = new ActionReference();
        reference.putEnumerated(id("application"), id("ordinal"), id("targetEnum"));
        return described(reference);
    }
    function treeOf(doc) {
        var reference = new ActionReference();
        reference.putProperty(id("property"), id("json"));
        reference.putIdentifier(id("document"), doc);
        var descriptor = new ActionDescriptor();
        descriptor.putReference(id("null"), reference);
        descriptor.putBoolean(id("getPathData"), true);
        var answer = realExecute(id("get"), descriptor, DialogModes.NO);
        return wholeOf(answer, parsedJson(answer.getString(id("json"))));
    }
    function layersOf(doc) {
        var ids = [];
        function walk(list) {
            for (var i = 0; i < list.length; i++) {
                ids.push(list[i].id);
                if (list[i].typename === "LayerSet") { walk(list[i].layers); }
            }
