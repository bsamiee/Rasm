{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "cacheDirectory": ".cache/nx/cache",
    "neverConnectToCloud": true,
    "useDaemonProcess": false,
    "namedInputs": {
        "production": [ "default", "!{projectRoot}/**/*.{spec,test,bench}.{ts,tsx,mts,cts}" ],
        "dotnet": [ "{workspaceRoot}/{global.json,NuGet.config,Directory.Build.props,Directory.Build.rsp,Directory.Build.targets,Directory.Packages.props}", { "externalDependencies": [] }, { "env": "NUGET_PACKAGES" }, { "runtime": "dotnet --version" } ],
        "python": [ "{workspaceRoot}/pyproject.toml", "{workspaceRoot}/uv.lock", { "externalDependencies": [] }, { "runtime": "uv --version" }, { "runtime": "python --version" } ],
        "vite": [ "{workspaceRoot}/vite.config.ts", { "externalDependencies": [ "vite", "effect" ] } ],
        "typescript": [ "{workspaceRoot}/tsconfig.base.json", { "json": "{workspaceRoot}/package.json", "fields": [ "type", "imports" ] }, { "runtime": "node --version" } ],
        "rust": [ "{workspaceRoot}/{Cargo.toml,Cargo.lock,rust-toolchain.toml,.cargo/config.toml}", { "externalDependencies": [] }, { "runtime": "rustc --version" } ],
        "pythonFiles": [ "{workspaceRoot}/**/*.{py,pyi}" ],
        "rustFiles": [ "{workspaceRoot}/**/*.rs" ],
        "lintLibrary": [ "{projectRoot}/**/*.rs", "!{projectRoot}/examples/**/*", "!{projectRoot}/tests/**/*", "{projectRoot}/Cargo.toml" ],
        "yamlFiles": [ "{workspaceRoot}/**/*.{yml,yaml}", "!{workspaceRoot}/pnpm-lock.yaml" ],
        "javaFiles": [ "{workspaceRoot}/**/*.java" ]
    },
    "targetDefaults": {
        "build{,:*}": [
            { "cache": true },
            { "filter": { "plugin": "@nx/dotnet" }, "dependsOn": [ "...", { "projects": [ "rasm" ], "target": "restore" } ] },
            { "filter": { "projects": [ "tag:host:rhino" ] }, "cache": false },
            {
                "filter": { "projects": [ "tag:output:rhp" ] },
                "dependsOn": [ { "projects": [ "rasm" ], "target": "restore" } ],
                "options": { "args": [ "--no-restore" ] },
                "configurations": { "debug": { "args": [ "--no-restore", "--configuration", "Debug" ] }, "release": { "args": [ "--no-restore", "--configuration", "Release" ] } }
            },
            {
                "filter": { "projects": [ "tag:language:dotnet" ] },
                "command": "doppler run --project rasm --config dev_repo --no-fallback --attempts 1 -- dotnet build \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$NX_TASK_TARGET_TARGET.binlog\"",
                "inputs": [ "...", "dotnet", { "runtime": "doppler --version" } ],
                "parallelism": false
            },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "cache": false,
                "options": {
                    "cwd": "{projectRoot}",
                    "commands": [
                        "xcodebuild -scheme {projectName} -destination platform=macOS -derivedDataPath $NX_WORKSPACE_ROOT/.cache/xcode/{projectRoot} -disableAutomaticPackageResolution build LM_SKIP_METADATA_EXTRACTION=YES",
                        { "command": "xcode-build-server config -scheme {projectName} --build_root $NX_WORKSPACE_ROOT/.cache/xcode/{projectRoot}", "forwardAllArgs": false }
                    ],
                    "parallel": false
                },
                "configurations": { "ci": { "args": [ "CODE_SIGN_STYLE=Manual", "CODE_SIGN_IDENTITY=-", "DEVELOPMENT_TEAM=", "COMPILER_INDEX_STORE_ENABLE=NO" ] } },
                "outputs": [ "{workspaceRoot}/.cache/xcode/{projectRoot}/Build" ]
            },
            {
                "filter": { "projects": [ "tag:build:swiftpm" ] },
                "command": "swift build --package-path {projectRoot} --scratch-path $NX_WORKSPACE_ROOT/.cache/swiftpm/build/{projectRoot} --disable-automatic-resolution",
                "cache": false,
                "outputs": [ "{workspaceRoot}/.cache/swiftpm/build/{projectRoot}/debug" ]
            },
            { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo build --locked --package {projectName}", "inputs": [ "default", "^default", "rust" ], "parallelism": false },
            { "filter": { "projects": [ "tag:language:typescript" ] }, "inputs": [ "production", "^production", "typescript" ] },
            { "filter": { "projects": [ "tag:bundler:vite" ] }, "command": "vite build", "options": { "cwd": "{projectRoot}" }, "inputs": [ "...", "vite" ], "outputs": [ "{projectRoot}/dist" ] },
            { "filter": { "projects": [ "tag:output:cloudflare" ] }, "outputs": [ "...", "{projectRoot}/.cloudflare/output" ] },
            { "filter": { "projects": [ "tag:host:uxp" ] }, "command": "vite build --config uxp.config.ts", "options": { "cwd": "{projectRoot}" }, "inputs": [ "...", "vite" ], "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ] },
            { "filter": { "projects": [ "tag:host:extendscript" ] }, "command": "swc {projectRoot} -d .artifacts --out-file-extension jsx --ignore '**/node_modules/**'", "inputs": [ "...", { "externalDependencies": [ "@swc/core", "@swc/cli" ] } ], "outputs": [ "{workspaceRoot}/.artifacts/{projectRoot}" ] }
        ],
        "pack": [
            { "cache": true },
            {
                "filter": { "projects": [ "tag:host:rhino" ] },
                "cache": false,
                "command": "dotnet publish --no-build --configuration Release \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$NX_TASK_TARGET_TARGET.binlog\"",
                "options": { "cwd": "{projectRoot}" },
                "dependsOn": [ "build:release" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/publish/{projectName}/release*", "{workspaceRoot}/.artifacts/dotnet/obj/{projectName}/release*/PublishOutputs.*.txt", "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/pack.binlog" ]
            },
            { "filter": { "projects": [ "tag:host:blender" ] }, "inputs": [ "...", "default", "python", { "runtime": "\"$BLENDER_PATH\" --version" }, "{workspaceRoot}/eng/python/fitout/**/*.py", { "runtime": "pip --version" }, { "runtime": "resvg --version" } ] }
        ],
        "install": [
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "{projectRoot}",
                    "commands": [
                        "rm -rf $NX_WORKSPACE_ROOT/.artifacts/{projectRoot}/install",
                        "xcodebuild -scheme {projectName} -configuration Release -destination platform=macOS -derivedDataPath $NX_WORKSPACE_ROOT/.cache/xcode/{projectRoot} -disableAutomaticPackageResolution install DSTROOT=$NX_WORKSPACE_ROOT/.artifacts/{projectRoot}/install ARCHS=arm64 LM_SKIP_METADATA_EXTRACTION=YES",
                        "sudo ditto $NX_WORKSPACE_ROOT/.artifacts/{projectRoot}/install /"
                    ],
                    "parallel": false
                },
                "parallelism": false,
                "outputs": [ "{workspaceRoot}/.cache/xcode/{projectRoot}/Build", "{workspaceRoot}/.artifacts/{projectRoot}/install" ]
            },
            {
                "filter": { "projects": [ "tag:host:rhino" ] },
                "command": "dotnet msbuild -target:InstallYakPackage -property:Configuration=Release \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$NX_TASK_TARGET_TARGET.binlog\"",
                "options": { "cwd": "{projectRoot}" },
                "dependsOn": [ "pack" ],
                "parallelism": false,
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/install.binlog" ]
            },
            { "filter": { "projects": [ "tag:host:blender" ] }, "dependsOn": [ "pack" ], "parallelism": false },
            { "filter": { "projects": [ "tag:host:uxp" ] }, "command": "node eng/typescript/uxp/main.ts .artifacts/{projectRoot}", "dependsOn": [ "build" ], "parallelism": false }
        ],
        "install:cargo": { "command": "cargo install --locked --profile dist --path {projectRoot}", "parallelism": false },
        "{install,upgrade}": [
            { "filter": { "projects": [ "tag:language:rust" ] }, "options": { "binary": "{projectName}" }, "dependsOn": [ "install:cargo" ] },
            {
                "filter": { "projects": [ "rasm", "tag:language:rust" ] },
                "command": "yq -p toml -oy '.bootstrap.macos.launchd.agents | to_entries | .[] | select(\"{args.binary}\" == \"\" or (.value.args | any_c(. == \"{args.binary}\"))) | .key' mise.toml | xargs -I @ launchctl kickstart -k gui/$(id -u)/dev.mise.@"
            }
        ],
        "upgrade": [
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "{projectRoot}",
                    "commands": [
                        "rm -f {projectName}.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved $NX_WORKSPACE_ROOT/.cache/xcode/{projectRoot}/SourcePackages/workspace-state.json",
                        "xcodebuild -resolvePackageDependencies -scheme {projectName} -derivedDataPath $NX_WORKSPACE_ROOT/.cache/xcode/{projectRoot}"
                    ],
                    "parallel": false
                }
            },
            { "filter": { "projects": [ "tag:build:swiftpm" ] }, "command": "swift package --package-path {projectRoot} --scratch-path $NX_WORKSPACE_ROOT/.cache/swiftpm/build/{projectRoot} update" }
        ],
        "lint": [ { "filter": { "projects": [ "tag:language:swift" ] }, "executor": "nx:noop", "dependsOn": [ "lint:*" ] } ],
        "lint:swift-format": { "command": "xcrun swift-format lint --strict --parallel --recursive {projectRoot}", "cache": true, "inputs": [ "default", "{workspaceRoot}/.swift-format", { "externalDependencies": [] }, { "runtime": "xcodebuild -version" } ] },
        "lint:swiftlint": [
            {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [ "default", "{workspaceRoot}/.swiftlint.yml", { "externalDependencies": [] }, { "runtime": "swiftlint version" } ],
                "options": { "commands": [ "swiftlint lint --quiet {projectRoot}" ], "parallel": false }
            },
            {
                "filter": { "projects": [ "tag:build:xcode" ] },
                "dependsOn": [ "build" ],
                "inputs": [ "...", "^default", "{workspaceRoot}/Xcode.xcconfig", { "runtime": "xcodebuild -version" } ],
                "options": {
                    "commands": [
                        "swiftlint lint --quiet {projectRoot}",
                        "xcodebuild -project {projectRoot}/{projectName}.xcodeproj -scheme {projectName} -destination platform=macOS -derivedDataPath .cache/xcode/{projectRoot} -disableAutomaticPackageResolution -showBuildSettingsForIndex -json | jq '[.[] | to_entries[] | select(.value.swiftASTCommandArguments) | {file: .key, arguments: .value.swiftASTCommandArguments}]' > .cache/xcode/{projectRoot}/compile_commands.json",
                        "swiftlint analyze --quiet --compile-commands .cache/xcode/{projectRoot}/compile_commands.json {projectRoot}"
                    ]
                }
            }
        ],
        "lint:cargo-modules": [ { "filter": { "projects": [ "tag:language:rust" ] }, "command": "cargo modules orphans --deny --package {projectName}", "cache": true, "parallelism": false, "inputs": [ "default", "rust", { "runtime": "cargo modules --version" } ] } ],
        "lint:dylint": [
            {
                "filter": { "projects": [ "tag:language:rust" ] },
                "command": "cargo dylint --all --no-deps --package {projectName} -- --locked",
                "cache": true,
                "parallelism": false,
                "inputs": [ "default", "^default", "rust", { "input": "lintLibrary", "projects": "tag:host:dylint" }, { "runtime": "cargo dylint --version" } ]
            }
        ],
        "serve": [ { "filter": { "projects": [ "tag:bundler:vite" ] }, "command": "vite", "options": { "cwd": "{projectRoot}" }, "continuous": true } ],
        "restore{,:*.cs}": { "command": "dotnet restore \"-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$NX_TASK_TARGET_TARGET.binlog\"", "cache": true, "parallelism": false },
        "run:*.cs": { "command": "dotnet run" },
        "{format,lint}:{dotnet-format,*.cs}": { "command": "dotnet format --binarylog \"$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$NX_TASK_TARGET_TARGET.binlog\"", "parallelism": false },
        "typecheck": [
            { "filter": { "projects": [ "tag:language:dotnet" ] }, "executor": "nx:noop", "dependsOn": [ "build" ] },
            {
                "filter": { "projects": [ "tag:language:typescript" ] },
                "command": "tsc --pretty false",
                "cache": true,
                "inputs": [ "default", "^default", "typescript", { "externalDependencies": [ "typescript" ] } ],
                "options": { "cwd": "{projectRoot}" }
            },
            {
                "filter": { "projects": [ "tag:language:rust" ] },
                "command": "cargo clippy --locked --no-deps --package {projectName}",
                "cache": true,
                "inputs": [ "default", "^default", "rust", "{workspaceRoot}/clippy.toml" ],
                "parallelism": false
            }
        ],
        "test": [
            { "cache": true },
            {
                "filter": { "projects": [ "tag:language:dotnet" ] },
                "options": { "args": [ "...", "-bl:$NX_WORKSPACE_ROOT/.artifacts/dotnet/binlog/$NX_TASK_TARGET_PROJECT/$NX_TASK_TARGET_TARGET.binlog" ] },
                "inputs": [ "...", "dotnet" ],
                "outputs": [ "{workspaceRoot}/.artifacts/dotnet/coverage/{projectName}", "{workspaceRoot}/.artifacts/dotnet/binlog/{projectName}/test-dotnet-test.binlog" ]
            },
            {
                "filter": { "projects": [ "tag:language:python" ] },
                "inputs": [ "...", "default", "^default", "python", "{workspaceRoot}/tests/python/{conftest.py,support/**/*.py}" ],
                "outputs": [ "{workspaceRoot}/.artifacts/python/coverage/data/.coverage.{projectName}" ],
                "options": { "env": { "COVERAGE_FILE": ".artifacts/python/coverage/data/.coverage.{projectName}" } }
            },
            {
                "filter": { "projects": [ "tag:language:typescript" ], "plugin": "@nx/vitest" },
                "inputs": [ "...", "typescript", "{workspaceRoot}/vitest.config.ts", { "externalDependencies": [ "effect", "@effect/platform-node", "@effect/vitest", "yaml" ] } ],
                "outputs": [ "{workspaceRoot}/.artifacts/typescript/coverage/{projectName}" ]
            },
            {
                "filter": { "projects": [ "tag:language:rust" ] },
                "command": "cargo nextest run --locked --package {projectName}",
                "inputs": [ "default", "^default", "rust", "{workspaceRoot}/.config/nextest.toml", { "runtime": "cargo nextest --version" } ],
                "outputs": [],
                "parallelism": false
            },
            { "filter": { "projects": [ "tag:host:dylint" ] }, "inputs": [ "...", { "runtime": "cargo dylint --version" } ] },
            {
                "filter": { "projects": [ "tag:build:swiftpm" ] },
                "command": "swift test --package-path {projectRoot} --scratch-path $NX_WORKSPACE_ROOT/.cache/swiftpm/build/{projectRoot} --disable-automatic-resolution",
                "inputs": [ "default", "^default", { "externalDependencies": [] }, { "runtime": "xcodebuild -version" } ],
                "outputs": []
            }
        ],
        "coverage": {
            "command": "cargo llvm-cov nextest --locked --package {projectName} --branch --html --output-dir .artifacts/rust/coverage/{projectName}",
            "cache": true,
            "inputs": [ "default", "^default", "rust", "{workspaceRoot}/.config/nextest.toml", { "runtime": "cargo llvm-cov --version" }, { "runtime": "cargo nextest --version" } ],
            "outputs": [ "{workspaceRoot}/.artifacts/rust/coverage/{projectName}" ],
            "parallelism": false
        },
        "check": [ { "filter": { "projects": [ "tag:language:*" ] }, "executor": "nx:noop", "dependsOn": [ "typecheck", "test" ] }, { "filter": { "projects": [ "tag:language:swift" ] }, "dependsOn": [ "...", { "target": "build", "params": "forward" }, "lint" ] } ]
    },
    "plugins": [
        { "plugin": "@nx/vitest", "include": [ "**/vitest.config.ts" ], "exclude": [ "vitest.config.ts" ], "options": { "testMode": "run" } },
        { "plugin": "@nx/playwright/plugin" },
        { "plugin": "@nx/dotnet", "options": { "clean": false, "pack": false, "publish": false, "restore": false, "run": false, "watch": false } },
        { "plugin": "./tools/nx/workspace.ts" }
    ]
}
