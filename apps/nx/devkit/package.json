{
    "name": "@rasm/nx-devkit",
    "version": "0.1.0",
    "private": true,
    "description": "Model every @rasm/nx-* plugin declares itself on: a plugin states its files, options, cached reads, and projects, and gets createNodes, createDependencies, verb targets, executors, and release steps built over Nx's own members",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/devkit"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./plugin.ts",
        "./project": "./project.ts",
        "./executor": "./executor.ts",
        "./process": "./process.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json",
        "./generators.json": "./generators.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json", "generators.json", "generators/*/schema.json" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@nx/js": "catalog:",
        "effect": "catalog:",
        "signal-exit": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "exports": {
            ".": "./dist/plugin.js",
            "./project": "./dist/project.js",
            "./executor": "./dist/executor.js",
            "./process": "./dist/process.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json",
            "./generators.json": "./generators.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    },
    "executors": "./executors.json",
    "generators": "./generators.json"
}
