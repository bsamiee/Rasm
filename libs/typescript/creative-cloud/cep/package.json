{
    "name": "@rasm/cep",
    "version": "0.1.0",
    "private": true,
    "description": "CEP extension manifest, the panel runtime following the host skin, launching a caller link under the extension's link identity, calls into the host script, reads of image files the host script wrote, and the Vite builder of CEP extensions",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/cep"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": [
        "panel.*"
    ],
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./index.ts",
        "./panel": "./panel.ts",
        "./vite": "./vite.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            ".": "./dist/index.js",
            "./panel": "./dist/panel.js",
            "./vite": "./dist/vite.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@rasm/extendscript": "workspace:*",
        "@rasm/mcp": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/telemetry": "workspace:*",
        "cheerio": "catalog:",
        "core-js": "catalog:",
        "culori": "catalog:",
        "fast-xml-builder": "catalog:",
        "fast-xml-parser": "catalog:"
    },
    "devDependencies": {
        "@types/culori": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers",
        "vite": "catalog:peers"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=27"
    }
}
