{
    "name": "@rasm/test-atelier",
    "private": true,
    "description": "@rasm/atelier suites over its built server, driven over MCP against a fake application server",
    "os": [
        "darwin"
    ],
    "type": "module",
    "devDependencies": {
        "@effect/platform-node": "catalog:",
        "@effect/vitest": "catalog:",
        "@rasm/applications": "workspace:*",
        "@rasm/testing": "workspace:*",
        "@types/node": "catalog:",
        "acorn": "catalog:",
        "effect": "catalog:",
        "plist": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "nx": {
        "implicitDependencies": [
            "@rasm/atelier"
        ],
        "targets": {
            "test--vitest": {
                "dependsOn": [
                    "...",
                    {
                        "projects": [
                            "@rasm/atelier"
                        ],
                        "target": "build--vite"
                    }
                ]
            }
        }
    }
}
