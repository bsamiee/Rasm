<Project>
    <PropertyGroup Label="Rhino Host">
        <RhinoHost>true</RhinoHost>
    </PropertyGroup>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup Label="Rhino Libraries">
        <TargetFramework />
        <TargetFrameworks>$(RhinoTargetFramework);$(RhinoTargetFramework)-windows</TargetFrameworks>
        <UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier>
    </PropertyGroup>
</Project>
