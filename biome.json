{
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": { "ignoreUnknown": true, "includes": [ "**", "!!assets", "!!.claude/workflows", "!!**/indesign-uxp-types/**/*.ts", "!!**/*.{md,yml,yaml}", "!**/*.xcassets", "!**/*.icon", "!**/*.svg" ] },
    "formatter": { "useEditorconfig": true, "lineWidth": 320 },
    "javascript": { "formatter": { "quoteStyle": "single" }, "resolver": { "experimentalPnpmCatalogs": true } },
    "json": { "formatter": { "expand": "auto", "delimiterSpacing": true } },
    "css": { "parser": { "tailwindDirectives": true } },
    "assist": { "actions": { "source": { "useSortedAttributes": "on", "useSortedPackageJson": "on", "useSortedProperties": "on" } } },
    "linter": {
        "domains": { "project": "all", "react": "none", "test": "all", "types": "all" },
        "rules": {
            "a11y": "error",
            "complexity": "error",
            "correctness": "error",
            "performance": "error",
            "security": "error",
            "style": "error",
            "suspicious": "error",
            "nursery": {
                "noBaseToString": "error",
                "noBunModules": "error",
                "noExtendNative": "error",
                "noFloatingPromises": "error",
                "noImpliedEval": "error",
                "noInvalidFileInputAccept": "error",
                "noInvalidPropertyInitValue": "error",
                "noJsonUnsafeValues": "error",
                "noMeaninglessVoidOperator": "error",
                "noMisplacedListElements": "error",
                "noMisusedPromises": "error",
                "noNegationInEqualityCheck": "error",
                "noNonScalableViewport": "error",
                "noObsoleteTags": "error",
                "noPathConcat": "error",
                "noReactObjectTypeAsDefaultProp": "error",
                "noRestrictedDependencies": "error",
                "noReturnInFinally": "error",
                "noSelfImport": "error",
                "noTailwindArbitraryValue": "error",
                "noTailwindRawColors": "error",
                "noThisOutsideOfClass": "error",
                "noUnmodifiedLoopCondition": "error",
                "noUnsafeIframeSandbox": "error",
                "noUnsafeTypeAssertion": "error",
                "noUselessCall": "error",
                "noUselessTypeConversion": "error",
                "noXorAsExponentiation": "error",
                "useAwaitThenable": "error",
                "useBetterDomTraversing": "error",
                "useConsistentFunctionStyle": "error",
                "useConsistentObjectKeys": "error",
                "useControlLabel": "error",
                "useDisposables": "error",
                "useExhaustiveSwitchCases": "error",
                "useFlatMathMinMax": "error",
                "useIncludes": "error",
                "useModernMathApis": "error",
                "useNamedLayer": "error",
                "useNullishCoalescing": "error",
                "usePromiseRejectErrors": "error",
                "useReactCompiler": "error",
                "useRegexpExec": "error",
                "useStringStartsEndsWith": "error",
                "useTailwindSortedClasses": "error",
                "useValidTestTitle": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": [ "**" ],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 20 } },
                        "noExcessiveLinesPerFunction": "off",
                        "noExcessiveNestedCallbacks": { "level": "error", "options": { "max": 3 } },
                        "noForEach": "off",
                        "useMaxParams": { "level": "error", "options": { "max": 10 } }
                    },
                    "correctness": {
                        "noNodejsModules": "off",
                        "noReactNativeRawText": "off",
                        "noSolidDestructuredProps": "off",
                        "noUndeclaredVariables": "off",
                        "noUnknownFunction": { "level": "error", "options": { "ignore": [ "theme" ] } },
                        "noUnresolvedImports": "off",
                        "noUnusedFunctionParameters": { "level": "error", "options": { "ignoreRestSiblings": false } },
                        "useQwikValidLexicalScope": "off"
                    },
                    "performance": { "noImgElement": "off", "noJsxPropsBind": "off", "useSolidForComponent": "off" },
                    "security": { "noSecrets": "off" },
                    "style": {
                        "noExcessiveClassesPerFile": "off",
                        "noExcessiveLinesPerFile": "off",
                        "noJsxLiterals": "off",
                        "noParameterAssign": { "level": "error", "options": { "propertyAssignment": "deny" } },
                        "noRestrictedGlobals": {
                            "level": "error",
                            "options": {
                                "deniedGlobals": {
                                    "Buffer": "Import `Buffer` from `node:buffer`, so the load graph sees the host module",
                                    "clearImmediate": "Import `clearImmediate` from `node:timers`, so the load graph sees the host module",
                                    "global": "Use `globalThis`",
                                    "setImmediate": "Import `setImmediate` from `node:timers`, so the load graph sees the host module"
                                }
                            }
                        },
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "@effect/platform-node": "Import the module subpath (`@effect/platform-node/NodeRuntime`), the package entry evaluates every Node service module",
                                    "smol-toml": "Parse TOML through `Toml.parse` from `effect/encoding`",
                                    "yaml": { "importNames": [ "parse" ], "message": "Parse YAML through `Yaml.parse` from `effect/encoding`" }
                                }
                            }
                        },
                        "noTernary": "off",
                        "useConsistentMemberAccessibility": { "level": "error", "options": { "accessibility": "none" } },
                        "useDomQuerySelector": "off",
                        "useExportType": { "level": "error", "options": { "style": "inlineType" } },
                        "useNamingConvention": "off",
                        "useReadonlyClassProperties": { "level": "error", "options": { "checkAllProperties": true } },
                        "useThisInClassMethods": { "level": "error", "options": { "ignoreOverrideMethods": true } }
                    },
                    "suspicious": {
                        "noBitwiseOperators": { "level": "error", "options": { "allow": [ "&" ] } },
                        "noLeakedRender": "off",
                        "noReactSpecificProps": "off",
                        "noShadowRestrictedNames": "off",
                        "noUnknownAttribute": { "level": "error", "options": { "ignore": [ "precedence" ] } },
                        "useBaseline": { "level": "error", "options": { "available": "newly" } },
                        "useIterableCallbackReturn": { "level": "error", "options": { "checkForEach": false } }
                    }
                }
            }
        },
        { "includes": [ "**/*.tsx" ], "linter": { "domains": { "react": "all" } } },
        { "includes": [ "**/index.ts" ], "linter": { "rules": { "performance": { "noBarrelFile": "off" } } } },
        { "includes": [ "**/*.config.ts", "**/server/worker.ts", "tools/nx/release.ts", "**/.storybook/*.{ts,tsx}", "tools/ast-grep/grammars/*/grammar.js" ], "linter": { "rules": { "style": { "noDefaultExport": "off" } } } },
        {
            "includes": [ "**/*.config.ts" ],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "@effect/platform-node": "Import the module subpath (`@effect/platform-node/NodeRuntime`), the package entry evaluates every Node service module",
                                    "smol-toml": "Parse TOML through `Toml.parse` from `effect/encoding`",
                                    "yaml": { "importNames": [ "parse" ], "message": "Parse YAML through `Yaml.parse` from `effect/encoding`" }
                                },
                                "patterns": [ { "group": [ "**/package.json", "#/package.json" ], "message": "Build helpers read the project manifest from the directory they take" } ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": [ "libs/typescript/creative-cloud/extendscript/**", "libs/typescript/creative-cloud/{aftereffects,illustrator}/extendscript.ts", "tools/harnesses/extendscript.ts", "tools/harnesses/{illustrator,indesign,photoshop}/engine.ts" ],
            "linter": {
                "rules": {
                    "nursery": { "useIncludes": "off", "useModernMathApis": "off", "useStringStartsEndsWith": "off" },
                    "style": { "noDefaultExport": "off", "useAtIndex": "off", "useNamedCaptureGroup": "off", "useNumberNamespace": "off", "useUnicodeRegex": "off" },
                    "suspicious": { "noForIn": "off", "noGlobalIsFinite": "off", "noGlobalIsNan": "off", "noPrototypeBuiltins": "off", "useGuardForIn": "off", "useIsArray": "off" }
                }
            }
        },
        {
            "includes": [ "tools/harnesses/extendscript.ts", "tools/harnesses/{illustrator,indesign,photoshop}/engine.ts" ],
            "linter": {
                "rules": {
                    "complexity": { "noArguments": "off", "noExcessiveCognitiveComplexity": "off", "useArrowFunction": "off" },
                    "style": { "noContinue": "off", "noMagicNumbers": "off", "noNestedTernary": "off", "noParameterAssign": "off", "useErrorCause": "off", "useForOf": "off", "useSpreadOverApply": "off" },
                    "nursery": { "noImpliedEval": "off", "noUselessCall": "off" },
                    "security": { "noGlobalEval": "off" },
                    "suspicious": { "noDoubleEquals": "off", "noEmptyBlockStatements": "off", "noShadow": "off" }
                }
            }
        },
        { "includes": [ "**/.storybook/*.stories.tsx" ], "linter": { "rules": { "style": { "useComponentExportOnlyModules": "off" } } } },
        { "includes": [ "tests/typescript/support/playwright.ts" ], "linter": { "rules": { "style": { "useConsistentTestIt": "off" } } } },
        { "includes": [ "plugins/function-hooks/hooks/**" ], "linter": { "rules": { "correctness": { "noUndeclaredDependencies": "off" } } } },
        { "includes": [ "biome.json", "nx.json", "package.json" ], "json": { "formatter": { "expand": "never" } } }
    ]
}
