<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
    <Import Project="$(MSBuildThisFileDirectory)../../../libs/dotnet/rhino/Rasm.Grasshopper/buildTransitive/Rasm.Grasshopper.targets" />

    <PropertyGroup Label="Rhino Plug-In" Condition="'$(TargetExt)' == '.rhp'">
        <_PlugInAssetDir>$(IntermediateOutputPath)PlugInAssets/</_PlugInAssetDir>
        <_PlugInMark>icons/mark.svg</_PlugInMark>
        <_PlugInPackageIcon>$(_PlugInAssetDir)icon.png</_PlugInPackageIcon>
        <_PlugInIcon>PlugIn.ico</_PlugInIcon>
        <_PlugInIconPngFrame>256</_PlugInIconPngFrame>
        <_PlugInRui>$(IntermediateOutputPath)$(TargetName).rui</_PlugInRui>
        <_PlugInRuiReferences>$(IntermediateOutputPath)$(TargetName).rui.rsp</_PlugInRuiReferences>
        <_PlugInRuiStamp>$(IntermediateOutputPath)$(TargetName).rui.stamp</_PlugInRuiStamp>
        <PlugInBody>lib/$(TargetName).dll</PlugInBody>
        <PlugInShell>$(_PlugInAssetDir)$(TargetFileName)</PlugInShell>
    </PropertyGroup>

    <ItemGroup Label="Rhino Plug-In" Condition="'$(TargetExt)' == '.rhp'">
        <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute"><_Parameter1>$(PlugInId)</_Parameter1></AssemblyAttribute>
        <ProjectReference Include="$(MSBuildThisFileDirectory)../../../libs/dotnet/rhino/Rasm.Rhino.Rui/Rasm.Rhino.Rui.csproj" OutputItemType="RuiWriter" ReferenceOutputAssembly="false" Private="false" />
        <PlugInDescription Include="Organization" Exclude="@(PlugInDescription)" Value="$(Authors)" />
        <PlugInDescription Include="WebSite" Exclude="@(PlugInDescription)" Value="$(PackageProjectUrl)" />
        <None Update="manifest.yml" CopyToPublishDirectory="PreserveNewest" />
        <None Include="@(IntermediateAssembly)" TargetPath="$(PlugInBody)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
        <_PlugInIconFrame Include="$(_PlugInIconPngFrame);48;32;24;16" />
        <_PlugInRaster Include="@(_PlugInIconFrame->'$(_PlugInAssetDir)%(Identity).png')" />
    </ItemGroup>

    <Target Name="AddPlugInDescriptions" AfterTargets="GetAssemblyAttributes" Condition="'$(TargetExt)' == '.rhp'">
        <ItemGroup>
            <AssemblyAttribute Include="@(PlugInDescription->'Rhino.PlugIns.PlugInDescriptionAttribute')" RemoveMetadata="Value">
                <_Parameter1>Rhino.PlugIns.DescriptionType.%(PlugInDescription.Identity)</_Parameter1>
                <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
                <_Parameter2>%(PlugInDescription.Value)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInIcon" BeforeTargets="AssignTargetPaths" DependsOnTargets="WriteIconTones" Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetExt)' == '.rhp'" Inputs="$(MSBuildAllProjects);$(_PlugInMark);$(_IconDir)plugin.css" Outputs="$(_PlugInAssetDir)$(_PlugInIcon);$(_PlugInPackageIcon);@(_PlugInRaster)">
        <Error Condition="!Exists('$(_PlugInMark)')" Text="$(MSBuildProjectName) mark $(_PlugInMark) is missing" />
        <MakeDir Directories="$(_PlugInAssetDir)" />
        <Exec Command="resvg -w %(_PlugInRaster.Filename) --stylesheet &quot;$(_IconDir)plugin.css&quot; &quot;$(_PlugInMark)&quot; &quot;%(_PlugInRaster.FullPath)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="resvg -w 64 --stylesheet &quot;$(_IconDir)plugin.css&quot; &quot;$(_PlugInMark)&quot; &quot;$(_PlugInPackageIcon)&quot;" LogStandardErrorAsError="true" />
        <Exec Command="magick @(_PlugInRaster->'&quot;%(Filename)%(Extension)&quot;', ' ') -define icon:png-compression-size=$(_PlugInIconPngFrame) &quot;$(_PlugInIcon)&quot;" WorkingDirectory="$(_PlugInAssetDir)" />
        <ItemGroup>
            <None Include="$(_PlugInPackageIcon)" CopyToPublishDirectory="PreserveNewest" />
            <PlugInDescription Include="Icon" Value="$(_PlugInIcon)" />
            <FileWrites Include="$(_PlugInAssetDir)$(_PlugInIcon);$(_PlugInPackageIcon);@(_PlugInRaster)" />
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInShell" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetExt)' == '.rhp'" Inputs="@(IntermediateAssembly);@(ReferencePath);@(Analyzer);@(EditorConfigFiles);$(GeneratedAssemblyInfoFile);$(_PlugInAssetDir)$(_PlugInIcon);$(MSBuildAllProjects)" Outputs="$(PlugInShell)">
        <Csc Sources="$(GeneratedAssemblyInfoFile);$(TargetFrameworkMonikerAssemblyAttributesPath)" References="@(ReferencePath);@(IntermediateAssembly)" Analyzers="@(Analyzer)" AnalyzerConfigFiles="@(EditorConfigFiles)" Resources="$(_PlugInAssetDir)$(_PlugInIcon)" OutputAssembly="$(PlugInShell)" TargetType="Library" LangVersion="$(LangVersion)" Nullable="$(Nullable)" Deterministic="true" Optimize="true" NoConfig="true" NoStandardLib="true" NoLogo="true" DisabledWarnings="$(NoWarn)" TreatWarningsAsErrors="$(TreatWarningsAsErrors)" ToolExe="$(CscToolExe)" ToolPath="$(CscToolPath)" UseSharedCompilation="$(UseSharedCompilation)" />
        <ItemGroup>
            <FileWrites Include="$(PlugInShell)" />
            <ContentWithTargetPath Include="$(PlugInShell)" TargetPath="$(TargetFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <Target Name="BuildPlugInRui" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(TargetExt)' == '.rhp'" Inputs="@(IntermediateAssembly);@(ReferenceCopyLocalPaths);@(ReferencePath);@(RuiWriter);$(MSBuildAllProjects)" Outputs="$(_PlugInRuiStamp)">
        <WriteLinesToFile File="$(_PlugInRuiReferences)" Lines="@(ReferenceCopyLocalPaths->WithMetadataValue('Extension', '.dll')->'%(FullPath)');@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(RuiWriter->'%(FullPath)')&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$(_PlugInRui)&quot; &quot;@$(_PlugInRuiReferences)&quot;" EnvironmentVariables="DOTNET_DbgEnableMiniDump=1;DOTNET_DbgMiniDumpType=1;DOTNET_DbgMiniDumpName=$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(TargetName).rui.%25p.dmp'));DOTNET_EnableCrashReport=1" StandardOutputImportance="low" LogStandardErrorAsError="true" />
        <Touch Files="$(_PlugInRuiStamp)" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(_PlugInRui);$(_PlugInRuiReferences);$(_PlugInRuiStamp)" />
            <ContentWithTargetPath Include="$(_PlugInRui)" TargetPath="$(TargetName).rui" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(_PlugInRui)')" />
        </ItemGroup>
    </Target>

    <Target Name="PrepareYakPackage" AfterTargets="Publish" Condition="'$(TargetExt)' == '.rhp'">
        <PropertyGroup>
            <_YakPublishDir>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</_YakPublishDir>
            <_YakArtifactsPublishDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsPath)', '$(ArtifactsPublishOutputName)', '$(ArtifactsProjectName)', '$(ArtifactsPivots)'))</_YakArtifactsPublishDir>
        </PropertyGroup>
        <ItemGroup>
            <_YakPublished Include="@(ResolvedFileToPublish->'$(_YakPublishDir)%(RelativePath)')" />
            <_YakExtra Include="$(_YakPublishDir)**/*" Exclude="@(_YakPublished)" />
        </ItemGroup>
        <Error Condition="'@(_YakExtra)' != '' and '$(_YakPublishDir)' != '$(_YakArtifactsPublishDir)'" Text="Publish directory $(_YakPublishDir) holds files outside the current publish, which Yak packaging would pack: @(_YakExtra). Publish to an empty directory." />
        <Delete Files="@(_YakExtra)" />
    </Target>

</Project>
