<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>RhinoCommon wrapped in LanguageExt effects with typed errors for Rhino plug-ins and apps</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <MapperlyAbstractionsScope>runtime</MapperlyAbstractionsScope>
    </PropertyGroup>

    <ItemGroup Label="Rhino">
        <PackageReference Include="Microsoft.Win32.SystemEvents" />
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="LanguageExt.Streaming" />
        <PackageReference Include="Microsoft.VisualStudio.Threading" />
        <PackageReference Include="Mono.Unix" />
        <PackageReference Include="NodaTime" />
        <PackageReference Include="Riok.Mapperly" PrivateAssets="compile;contentfiles;analyzers;build" />
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Json" />
        <PackageReference Include="UUIDNext" />
    </ItemGroup>

    <ItemGroup Label="Quantities">
        <PackageReference Include="UnitsNet" />
    </ItemGroup>

    <ItemGroup Label="Mathematics">
        <PackageReference Include="MathNet.Numerics" />
        <PackageReference Include="PeterO.Numbers" />
    </ItemGroup>

    <ItemGroup Label="Algorithms and Data Structures">
        <PackageReference Include="QuikGraph" />
    </ItemGroup>

    <ItemGroup Label="Geospatial">
        <PackageReference Include="NetTopologySuite" />
    </ItemGroup>

    <ItemGroup Label="Color">
        <PackageReference Include="Wacton.Unicolour" />
    </ItemGroup>

    <ItemGroup Label="Desktop UI">
        <PackageReference Include="SkiaSharp" />
    </ItemGroup>

    <ItemGroup Label="Application Hosting">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    </ItemGroup>

    <ItemGroup Label="Workspace Packages">
        <ProjectReference Include="../../bim/Rasm.Drafting/Rasm.Drafting.csproj" />
        <ProjectReference Include="../../ui/Rasm.UI/Rasm.UI.csproj" />
    </ItemGroup>

    <ItemGroup Label="Workspace Sources">
        <Compile Include="../../Invariant.cs" />
        <Compile Include="../../LanguageJson.cs" />
        <Compile Include="../../ValidationResults.cs" />
    </ItemGroup>
</Project>
