{
    "name": "@rasm/indesign",
    "version": "0.1.0",
    "private": true,
    "description": "InDesign object model for UXP plugins and scripts, with dialog-free do script runs, guarded reads and writes, search, rendering, and typesetting",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/creative-cloud/indesign"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts"
    ],
    "type": "module",
    "sideEffects": false,
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./script": "./script.ts",
        "./typesetting": "./typesetting.ts",
        "./value": "./value.ts",
        "./views": "./views.ts",
        "./uxp/dom": "./uxp/dom.ts",
        "./uxp/operations": "./uxp/operations.ts",
        "./uxp/source": "./uxp/source.ts",
        "./uxp/settings": "./uxp/settings.ts",
        "./uxp/typesetting": "./uxp/typesetting.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "imports": {
            "#/*": "./dist/*.js"
        },
        "exports": {
            "./script": "./dist/script.js",
            "./typesetting": "./dist/typesetting.js",
            "./value": "./dist/value.js",
            "./views": "./dist/views.js",
            "./uxp/dom": "./dist/uxp/dom.js",
            "./uxp/operations": "./dist/uxp/operations.js",
            "./uxp/source": "./dist/uxp/source.js",
            "./uxp/settings": "./dist/uxp/settings.js",
            "./uxp/typesetting": "./dist/uxp/typesetting.js",
            "./package.json": "./package.json"
        },
        "access": "public"
    },
    "dependencies": {
        "@rasm/applications": "workspace:*",
        "@rasm/object-model": "workspace:*",
        "@rasm/search": "workspace:*",
        "@rasm/typography": "workspace:*",
        "@rasm/uxp": "workspace:*",
        "parse5": "catalog:"
    },
    "devDependencies": {
        "@adobe-uxp-types/uxp": "catalog:",
        "@types/node": "catalog:",
        "effect": "catalog:",
        "indesign-uxp-types": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "engines": {
        "node": ">=27"
    }
}
