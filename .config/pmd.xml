<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="rasm" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>Java rules</description>

    <!-- [BEST_PRACTICES] -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="UnusedFormalParameter" />
    </rule>
    <rule ref="category/java/bestpractices.xml/UnusedFormalParameter">
        <properties>
            <property name="checkAll" value="true" />
        </properties>
    </rule>

    <!-- [CODE_STYLE] -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="AtLeastOneConstructor" />
        <exclude name="CommentDefaultAccessModifier" />
        <exclude name="LocalVariableCouldBeFinal" />
        <exclude name="LocalVariableDeclarationShouldBeAtStartOfBlock" />
        <exclude name="LongVariable" />
        <exclude name="MethodArgumentCouldBeFinal" />
        <exclude name="NoPackage" />
        <exclude name="OnlyOneReturn" />
        <exclude name="ShortClassName" />
        <exclude name="ShortMethodName" />
        <exclude name="ShortVariable" />
    </rule>

    <!-- [DESIGN] -->
    <rule ref="category/java/design.xml">
        <exclude name="AvoidDeeplyNestedIfStmts" />
        <exclude name="CognitiveComplexity" />
        <exclude name="CouplingBetweenObjects" />
        <exclude name="CyclomaticComplexity" />
        <exclude name="ExcessiveImports" />
        <exclude name="ExcessivePublicCount" />
        <exclude name="GodClass" />
        <exclude name="LawOfDemeter" />
        <exclude name="LoosePackageCoupling" />
        <exclude name="NcssCount" />
        <exclude name="NPathComplexity" />
        <exclude name="SignatureDeclareThrowsException" />
        <exclude name="SwitchDensity" />
        <exclude name="TooManyFields" />
        <exclude name="TooManyMethods" />
    </rule>

    <!-- [ERROR_PRONE] -->
    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidAccessibilityAlteration" />
        <exclude name="AvoidCatchingGenericException" />
        <exclude name="EmptyCatchBlock" />
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidAccessibilityAlteration">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::MethodDeclaration[@Name = 'run'][ancestor::ClassDeclaration[@SimpleName = 'Headers']]" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidCatchingGenericException">
        <properties>
            <property name="violationSuppressXPath" value="./ancestor::TryStatement[1]/Block//MethodCall[pmd-java:matchesSig('ghidra.app.script.GhidraScript#runScript(java.lang.String,java.lang.String[],ghidra.app.script.GhidraState)')]" />
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/EmptyCatchBlock">
        <properties>
            <property name="allowExceptionNameRegex" value="^$" />
        </properties>
    </rule>

    <!-- [GHIDRA] -->
    <rule name="UncheckedDecompilerOpen" language="java" message="Decompiler program open result unchecked" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>`DecompilerCallback` discards false from `DecompInterface.openProgram`, open program in configurer and fail with `getLastMessage`</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//ExpressionStatement/MethodCall[pmd-java:matchesSig('ghidra.app.decompiler.DecompInterface#openProgram(_)')]
| //ConstructorCall[pmd-java:typeIs('ghidra.app.decompiler.parallel.DecompilerCallback')][not(ArgumentList//MethodCall[pmd-java:matchesSig('ghidra.app.decompiler.DecompInterface#openProgram(_)')])]
]]>
                </value>
            </property>
        </properties>
    </rule>

    <!-- [MULTITHREADING] -->
    <rule ref="category/java/multithreading.xml" />

    <!-- [PERFORMANCE] -->
    <rule ref="category/java/performance.xml" />
    <rule name="RecompiledConstantRegex" language="java" message="Constant regex recompiles on each evaluation" class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Reuse a static final Pattern for repeated matching and replacement</description>
        <priority>1</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//MethodCall[
    (@MethodName = ('compile', 'matches') and pmd-java:matchesSig('java.util.regex.Pattern#_(_*)'))
    or (@MethodName = ('matches', 'replaceAll', 'replaceFirst')
        and pmd-java:matchesSig('java.lang.String#_(_*)'))
][
    ArgumentList/*[1][@CompileTimeConstant = true()]
][
    not(@MethodName = 'compile') or not(ArgumentList/*[2][@CompileTimeConstant = false()])
][
    ancestor::*[
        pmd-java:nodeIs('ExecutableDeclaration') or self::CompactConstructorDeclaration
        or self::LambdaExpression or self::Initializer or self::FieldDeclaration or self::EnumConstant
    ][1][not(self::Initializer[@Static = true()] or self::FieldDeclaration[@Static = true()] or self::EnumConstant)]
]
]]>
                </value>
            </property>
        </properties>
    </rule>

    <!-- [SECURITY] -->
    <rule ref="category/java/security.xml" />
</ruleset>
