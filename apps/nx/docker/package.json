{
    "name": "@rasm/nx-docker",
    "version": "0.0.0",
    "description": "Nx plugin inferring Compose projects, their checks, image builds, service starts, and image tag upgrades from docker compose's own output",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/docker"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./plugins/project-graph.ts",
        "./package.json": "./package.json",
        "./executors.json": "./executors.json"
    },
    "files": [ "dist", "executors.json", "executors/*/schema.json" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugins/project-graph.js",
            "./package.json": "./package.json",
            "./executors.json": "./executors.json"
        }
    },
    "executors": "./executors.json"
}
