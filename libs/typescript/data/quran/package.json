{
    "name": "@rasm/quran",
    "version": "0.0.0",
    "private": true,
    "description": "Quran text from CSV or a mushaf, selected by surah or division a riwayah counts, ayah marks set against a face",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "libs/typescript/data/quran"
    },
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./index.ts"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@quran.ws/text": "catalog:",
        "@rasm/search": "workspace:*",
        "@rasm/typography": "workspace:*",
        "quran-meta": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "effect": "catalog:"
    },
    "peerDependencies": {
        "effect": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/index.js"
        }
    }
}
