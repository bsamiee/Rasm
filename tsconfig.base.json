{
    "$schema": "./node_modules/@typescript/native/schemas/tsconfig.schema.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "${configDir}/dist",
        "sourceMap": true,
        "lib": ["esnext"],
        "target": "esnext",
        "module": "nodenext",
        "exactOptionalPropertyTypes": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "@effect/language-service",
                "allowedUnstableApis": ["effect", "@effect"],
                "allowedExperimentalApis": ["effect", "@effect"],
                "barrelImportPackages": ["effect"],
                "effectFn": ["span", "untraced"],
                "ignoreEffectSuggestionsInTscExitCode": false,
                "keyPatterns": [{ "target": "service" }, { "target": "custom" }, { "target": "error", "pattern": "identifier" }, { "target": "taggedClass", "pattern": "identifier" }],
                "diagnosticSeverity": {
                    "anyUnknownInErrorContext": "error",
                    "catchUnfailableEffect": "error",
                    "mapMapErrorToMapBoth": "error",
                    "unsafeEffectTypeAssertion": "error",
                    "extendsNativeError": "error",
                    "asyncFunction": "error",
                    "newPromise": "error",
                    "cryptoRandomUUID": "error",
                    "cryptoRandomUUIDInEffect": "error",
                    "globalConsole": "error",
                    "globalConsoleInEffect": "error",
                    "globalDate": "error",
                    "globalDateInEffect": "error",
                    "globalFetch": "error",
                    "globalFetchInEffect": "error",
                    "globalJsonInEffect": "error",
                    "globalRandom": "error",
                    "globalRandomInEffect": "error",
                    "globalTimers": "error",
                    "globalTimersInEffect": "error",
                    "processEnv": "error",
                    "processEnvInEffect": "error",
                    "instanceOfSchema": "error",
                    "schemaSync": "error",
                    "deterministicKeys": "error",
                    "effectDoNotation": "error",
                    "effectTryWithoutCatch": "error",
                    "forLoopPushToForEach": "error",
                    "missedPipeableOpportunity": "error",
                    "missingEffectServiceDependency": "error",
                    "nestedEffectGenYield": "error",
                    "newSchemaClass": "error",
                    "preferBarrelImport": "error",
                    "preferSchemaTaggedError": "error",
                    "provideMergeAllToArray": "error",
                    "schemaUnionOfLiterals": "error",
                    "serviceNotAsClass": "error",
                    "strictBooleanExpressions": "error",
                    "typeUnionToSchemaUnion": "error",
                    "unnecessaryArrowBlock": "error",
                    "unnecessaryFailYieldableError": "error"
                },
                "overrides": [
                    { "include": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.stories.tsx"], "options": { "diagnosticSeverity": { "asyncFunction": "off" } } },
                    { "include": ["libs/typescript/ai/policy/claude/*.ts"], "options": { "diagnosticSeverity": { "effectFnOpportunity": "off" } } }
                ]
            }
        ]
    }
}
