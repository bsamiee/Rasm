<Project>
    <PropertyGroup Label="Workspace">
        <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
        <ArtifactsPath>$([MSBuild]::NormalizePath('$(RepoRoot)', '.artifacts', 'dotnet'))</ArtifactsPath>
        <LibsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'libs'))</LibsRoot>
        <ToolsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'tools'))</ToolsRoot>
        <TestsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'tests'))</TestsRoot>
        <AppsRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'apps'))</AppsRoot>
        <CatalogRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'eng', 'dotnet'))</CatalogRoot>
    </PropertyGroup>

    <PropertyGroup Label="Project Classification">
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(LibsRoot)'))">libs</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(ToolsRoot)'))">tools</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(TestsRoot)'))">tests</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(AppsRoot)'))">apps</ProjectRole>
        <ProjectRole Condition="$(MSBuildProjectDirectory.StartsWith('$(CatalogRoot)'))">catalog</ProjectRole>
    </PropertyGroup>

    <PropertyGroup Label="Package Catalog" Condition="'$(ProjectRole)' == 'catalog'">
        <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <PropertyGroup Label="Build Defaults">
        <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <NuGetAudit>false</NuGetAudit>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Label="Continuous Integration" Condition="'$(CI)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Label="Workspace Analyzers">
        <PackageReference Include="ErrorProne.NET.CoreAnalyzers"               PrivateAssets="all" />
        <PackageReference Include="Meziantou.Analyzer"                         PrivateAssets="all" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Roslynator.Analyzers"                       PrivateAssets="all" />
        <PackageReference Include="Thinktecture.Runtime.Extensions.Analyzers"  PrivateAssets="all" />
    </ItemGroup>
</Project>
