<Project>
    <Target Name="ReadInstallation" Returns="@(RhinoInstallation)">
        <Exec Command="osascript -l JavaScript -e &quot;ObjC.import('AppKit'); \$.NSWorkspace.sharedWorkspace.URLForApplicationWithBundleIdentifier('com.mcneel.rhinoceros.$(RhinoMajorVersion)').path?.js ?? ''&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low" Condition="'$(RhinoInstallPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">
            <Output TaskParameter="ConsoleOutput" PropertyName="RhinoInstallPath" />
        </Exec>
        <PropertyGroup>
            <RhinoInstallPath Condition="'$(RhinoInstallPath)' == ''">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SOFTWARE\McNeel\Rhinoceros\$(RhinoMajorVersion).0\Install', 'InstallPath'))</RhinoInstallPath>
        </PropertyGroup>
        <Error Condition="'$(RhinoInstallPath)' == ''" Text="Rhino $(RhinoMajorVersion) install not found, install Rhino $(RhinoMajorVersion) or set RhinoInstallPath" />
        <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
            <_ResourcesDir>$([MSBuild]::NormalizeDirectory('$(RhinoInstallPath)', 'Contents', 'Frameworks', 'RhCore.framework', 'Versions', 'Current', 'Resources'))</_ResourcesDir>
            <_YakExecutable>$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'Contents', 'Resources', 'bin', 'yak'))</_YakExecutable>
        </PropertyGroup>
        <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
            <_ResourcesDir>$([MSBuild]::NormalizeDirectory('$(RhinoInstallPath)', 'System', 'netcore'))</_ResourcesDir>
            <_YakExecutable>$([MSBuild]::NormalizePath('$(RhinoInstallPath)', 'System', 'yak.exe'))</_YakExecutable>
        </PropertyGroup>
        <ItemGroup>
            <_RuntimeConfig Include="$(_ResourcesDir)dotnetstart.*.runtimeconfig.json" />
        </ItemGroup>
        <Exec Command="jq -r .runtimeOptions.tfm &quot;@(_RuntimeConfig)&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_TargetFramework" />
        </Exec>
        <XmlPeek XmlInputPath="$(RhinoInstallPath)/Contents/Info.plist" Query="/plist/dict/key[.='LSMinimumSystemVersion']/following-sibling::*[1]/text()" ProhibitDtd="false" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
            <Output TaskParameter="Result" PropertyName="_MacMinimumVersion" />
        </XmlPeek>
        <ItemGroup>
            <RhinoInstallation Include="$(RhinoInstallPath)" ResourcesDir="$(_ResourcesDir)" YakExecutable="$(_YakExecutable)" TargetFramework="$(_TargetFramework)" MacMinimumVersion="$(_MacMinimumVersion)" />
        </ItemGroup>
    </Target>

    <Target Name="ReadDeclaredAssemblies" DependsOnTargets="ReadInstallation" Returns="@(RhinoDeclaredAssembly)">
        <ItemGroup>
            <_Dependencies Include="$(_ResourcesDir)dotnetstart.*.deps.json" />
        </ItemGroup>
        <Exec Command="jq -r &quot;[.targets[][].runtime // {} | to_entries[] | select(.value.assemblyVersion) | (.key | split(\&quot;/\&quot;)[-1] | rtrimstr(\&quot;.dll\&quot;)) + \&quot;=\&quot; + .value.assemblyVersion] | unique[]&quot; &quot;@(_Dependencies)&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" ItemName="_Declaration" />
        </Exec>
        <ItemGroup>
            <RhinoDeclaredAssembly Include="@(_Declaration)" Name="$([System.String]::Copy('%(Identity)').Split('=')[0])" Version="$([System.String]::Copy('%(Identity)').Split('=')[1])" />
        </ItemGroup>
    </Target>
</Project>
