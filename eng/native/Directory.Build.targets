<Project>
    <PropertyGroup>
        <VersionManifest>$(MSBuildThisFileDirectory)$(NativeLibraryName)/$([MSBuild]::ValueOrDefault('$(VersionManifestFileName)', 'vcpkg.json'))</VersionManifest>
        <CentralPackagesPath>$(RepositoryRoot)Directory.Packages.props</CentralPackagesPath>
        <!-- The manifest owns the version, this file reads the project's VersionManifestFileName and imports before the SDK reads Version -->
        <_ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(VersionManifest)')), '(?&lt;="version-string": ")[^"]+').Value)</_ManifestVersion>
        <Version Condition="'$(_ManifestVersion)' != ''">$(_ManifestVersion)</Version>
    </PropertyGroup>

    <ItemGroup Condition="'$(IncludeBuildOutput)' == 'false'">
        <None Include="$(StageRoot)runtimes/**" Pack="true" PackagePath="runtimes/" />
        <!-- contentFiles with copyToOutput keeps the staged tree in consumer output where RID-specific publish flattens runtimes native assets -->
        <None Include="$(StageRoot)contentFiles/**" Pack="true" PackagePath="contentFiles/any/any/" PackageCopyToOutput="true" BuildAction="None" />
        <None Include="$(MSBuildThisFileDirectory)_._" Pack="true" PackagePath="lib/$(TargetFramework)/" />
    </ItemGroup>

    <!-- Generated sources come from the staged tree, hand-written support sources sit beside the project file -->
    <ItemGroup Condition="'$(IncludeBuildOutput)' == 'true'">
        <_StagedSource Include="$(StageRoot)managed/*.cs" />
        <Compile Include="@(_StagedSource);$(MSBuildProjectDirectory)/*.cs" />
    </ItemGroup>

    <Target Name="EnsureManifestVersion" BeforeTargets="GenerateNuspec">
        <Error Condition="'$(_ManifestVersion)' == ''" Text="No version-string in $(VersionManifest), the package version derives from it" />
    </Target>

    <Target Name="EnsureStagedNativeLibraries" BeforeTargets="GenerateNuspec" Condition="'$(IncludeBuildOutput)' == 'false'">
        <Error Condition="!Exists('$(StageRoot)runtimes') and !Exists('$(StageRoot)contentFiles')"
               Text="Nothing staged under $(StageRoot), run the stage target of the $(NativeLibraryName) packaging project first" />
    </Target>

    <Target Name="EnsureStagedManagedSources" BeforeTargets="CoreCompile" Condition="'$(IncludeBuildOutput)' == 'true'">
        <Error Condition="'@(_StagedSource)' == ''" Text="No sources staged under $(StageRoot)managed, run the stage target of the $(NativeLibraryName) packaging project first" />
    </Target>

    <!-- Packages locked to one entry in the root Directory.Packages.props declare that entry as CentralPackageId -->
    <Target Name="EnsureCentralPackageVersionMatch" BeforeTargets="GenerateNuspec" Condition="'$(CentralPackageId)' != ''">
        <PropertyGroup>
            <_CentralPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(CentralPackagesPath)')), '(?&lt;=Include="$(CentralPackageId)"\s+Version=")[^"]+').Value)</_CentralPackageVersion>
        </PropertyGroup>
        <Error Condition="'$(_CentralPackageVersion)' != '$(Version)'"
               Text="Package version $(Version) does not match the $(CentralPackageId) version '$(_CentralPackageVersion)' in Directory.Packages.props" />
    </Target>
</Project>
