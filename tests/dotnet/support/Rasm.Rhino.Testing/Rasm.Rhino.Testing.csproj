<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Microsoft.Testing.Platform test host launcher running a test application inside a Rhino for Mac it starts</Description>
        <IsPackable>true</IsPackable>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
        <NoWarn>$(NoWarn);TPEXP</NoWarn>
        <DefaultItemExcludes>$(DefaultItemExcludes);buildTransitive/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup Label="Testing">
        <PackageReference Include="Microsoft.Testing.Platform" />
    </ItemGroup>

    <ItemGroup Label="Package">
        <None Include="buildTransitive/*" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>
</Project>
