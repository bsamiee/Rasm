{
    "name": "@rasm/automation",
    "private": true,
    "description": "Adobe applications driven from outside the host",
    "sideEffects": false,
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        "./apple-events": "./apple-events.ts",
        "./applications": "./applications.ts",
        "./automation": "./automation.ts",
        "./contract": "./contract.ts",
        "./requests": "./requests.ts"
    },
    "dependencies": {
        "@rasm/search": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:"
    }
}
