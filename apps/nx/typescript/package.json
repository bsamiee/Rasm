{
    "name": "@rasm/nx-typescript",
    "version": "0.0.0",
    "description": "Nx plugin inferring TypeScript type checks and emits, publint package checks, and the package manager upgrade and store prune of the workspace",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/typescript"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#/*": "./*.ts"
    },
    "exports": {
        ".": "./plugin.ts",
        "./package.json": "./package.json"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@nx/devkit": "catalog:",
        "@rasm/nx-devkit": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@typescript/native": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "@typescript/native": "catalog:peers",
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugin.js",
            "./package.json": "./package.json"
        },
        "imports": {
            "#/*": "./dist/*.js"
        }
    }
}
