{
    "name": "@rasm/nx-pulumi",
    "version": "0.1.0",
    "description": "Nx plugin running each Pulumi Automation API program, a package depending on @pulumi/pulumi with one bin, as the install and deploy targets of its own project and of each package depending on it",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bsamiee/Rasm.git",
        "directory": "apps/nx/pulumi"
    },
    "license": "MIT",
    "type": "module",
    "imports": {
        "#package": "./package.json"
    },
    "exports": {
        ".": "./plugin.ts",
        "./package.json": "./package.json"
    },
    "files": [ "dist" ],
    "dependencies": {
        "@effect/platform-node": "catalog:",
        "@nx/devkit": "catalog:",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "nx": "catalog:"
    },
    "peerDependencies": {
        "nx": "catalog:peers"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./dist/plugin.js",
            "./package.json": "./package.json"
        }
    }
}
