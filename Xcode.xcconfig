// --- [BUILD] ---------------------------------------------------------------------------

// --- [BUILD_OPTIONS]

ALWAYS_SEARCH_USER_PATHS = NO
COMPILATION_CACHE_ENABLE_CACHING = YES
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym
ENABLE_DEBUG_DYLIB = NO
LM_SKIP_METADATA_EXTRACTION = YES

// --- [WARNINGS]

GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// --- [LINKING]

DEAD_CODE_STRIPPING = YES
LD_RUNPATH_SEARCH_PATHS = @executable_path/../Frameworks
OTHER_LDFLAGS = -Xlinker -fatal_warnings

// --- [PACKAGING]

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = © Bardia Samiee
PRODUCT_NAME = $(TARGET_NAME)

// --- [VERSIONING]

CURRENT_PROJECT_VERSION = $(MARKETING_VERSION)
VERSIONING_SYSTEM = apple-generic

// --- [DEPLOYMENT]

COPY_PHASE_STRIP = NO
MACOSX_DEPLOYMENT_TARGET = 27.0

// --- [SIGNING] -------------------------------------------------------------------------

// --- [IDENTITY]

CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = BBXB9R367P

// --- [HARDENING]

ENABLE_ENHANCED_SECURITY = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_POINTER_AUTHENTICATION = NO

// --- [SPARKLE] -------------------------------------------------------------------------

SPARKLE_FEED_URL = https:/$()/updates.parametric-arsenal.cloud/$(PRODUCT_NAME)/appcast.xml
SPARKLE_PUBLIC_KEY = G+D8EhYh31mwjGKL88W2ft9PRIPMSgt6t8zV6lIBa3Y=
